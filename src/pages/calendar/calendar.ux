<template>
  <div class="month-mask" onswipe="handleSwipe">
    <div class="month-back-hit" onclick="goHome"><text class="month-back">‹</text></div>
    <text class="month-page-title">今日日历</text>
    <div class="header-line"></div>
    <text class="month-title">{{calendarTitle}}</text>
    <input class="month-prev" type="button" value="上月" onclick="previousMonth" />
    <input class="month-next" type="button" value="下月" onclick="nextMonth" />
    <text class="month-week-cell" style="left: 12px;">日</text>
    <text class="month-week-cell" style="left: 56px;">一</text>
    <text class="month-week-cell" style="left: 100px;">二</text>
    <text class="month-week-cell" style="left: 144px;">三</text>
    <text class="month-week-cell" style="left: 188px;">四</text>
    <text class="month-week-cell" style="left: 232px;">五</text>
    <text class="month-week-cell" style="left: 276px;">六</text>
    <text class="month-cell" style="left: 12px; top: 130px; color: {{calColor0}};">{{calCell0}}</text>
<text class="month-cell" style="left: 56px; top: 130px; color: {{calColor1}};">{{calCell1}}</text>
<text class="month-cell" style="left: 100px; top: 130px; color: {{calColor2}};">{{calCell2}}</text>
<text class="month-cell" style="left: 144px; top: 130px; color: {{calColor3}};">{{calCell3}}</text>
<text class="month-cell" style="left: 188px; top: 130px; color: {{calColor4}};">{{calCell4}}</text>
<text class="month-cell" style="left: 232px; top: 130px; color: {{calColor5}};">{{calCell5}}</text>
<text class="month-cell" style="left: 276px; top: 130px; color: {{calColor6}};">{{calCell6}}</text>
<text class="month-cell" style="left: 12px; top: 169px; color: {{calColor7}};">{{calCell7}}</text>
<text class="month-cell" style="left: 56px; top: 169px; color: {{calColor8}};">{{calCell8}}</text>
<text class="month-cell" style="left: 100px; top: 169px; color: {{calColor9}};">{{calCell9}}</text>
<text class="month-cell" style="left: 144px; top: 169px; color: {{calColor10}};">{{calCell10}}</text>
<text class="month-cell" style="left: 188px; top: 169px; color: {{calColor11}};">{{calCell11}}</text>
<text class="month-cell" style="left: 232px; top: 169px; color: {{calColor12}};">{{calCell12}}</text>
<text class="month-cell" style="left: 276px; top: 169px; color: {{calColor13}};">{{calCell13}}</text>
<text class="month-cell" style="left: 12px; top: 208px; color: {{calColor14}};">{{calCell14}}</text>
<text class="month-cell" style="left: 56px; top: 208px; color: {{calColor15}};">{{calCell15}}</text>
<text class="month-cell" style="left: 100px; top: 208px; color: {{calColor16}};">{{calCell16}}</text>
<text class="month-cell" style="left: 144px; top: 208px; color: {{calColor17}};">{{calCell17}}</text>
<text class="month-cell" style="left: 188px; top: 208px; color: {{calColor18}};">{{calCell18}}</text>
<text class="month-cell" style="left: 232px; top: 208px; color: {{calColor19}};">{{calCell19}}</text>
<text class="month-cell" style="left: 276px; top: 208px; color: {{calColor20}};">{{calCell20}}</text>
<text class="month-cell" style="left: 12px; top: 247px; color: {{calColor21}};">{{calCell21}}</text>
<text class="month-cell" style="left: 56px; top: 247px; color: {{calColor22}};">{{calCell22}}</text>
<text class="month-cell" style="left: 100px; top: 247px; color: {{calColor23}};">{{calCell23}}</text>
<text class="month-cell" style="left: 144px; top: 247px; color: {{calColor24}};">{{calCell24}}</text>
<text class="month-cell" style="left: 188px; top: 247px; color: {{calColor25}};">{{calCell25}}</text>
<text class="month-cell" style="left: 232px; top: 247px; color: {{calColor26}};">{{calCell26}}</text>
<text class="month-cell" style="left: 276px; top: 247px; color: {{calColor27}};">{{calCell27}}</text>
<text class="month-cell" style="left: 12px; top: 286px; color: {{calColor28}};">{{calCell28}}</text>
<text class="month-cell" style="left: 56px; top: 286px; color: {{calColor29}};">{{calCell29}}</text>
<text class="month-cell" style="left: 100px; top: 286px; color: {{calColor30}};">{{calCell30}}</text>
<text class="month-cell" style="left: 144px; top: 286px; color: {{calColor31}};">{{calCell31}}</text>
<text class="month-cell" style="left: 188px; top: 286px; color: {{calColor32}};">{{calCell32}}</text>
<text class="month-cell" style="left: 232px; top: 286px; color: {{calColor33}};">{{calCell33}}</text>
<text class="month-cell" style="left: 276px; top: 286px; color: {{calColor34}};">{{calCell34}}</text>
<text class="month-cell" style="left: 12px; top: 325px; color: {{calColor35}};">{{calCell35}}</text>
<text class="month-cell" style="left: 56px; top: 325px; color: {{calColor36}};">{{calCell36}}</text>
<text class="month-cell" style="left: 100px; top: 325px; color: {{calColor37}};">{{calCell37}}</text>
<text class="month-cell" style="left: 144px; top: 325px; color: {{calColor38}};">{{calCell38}}</text>
<text class="month-cell" style="left: 188px; top: 325px; color: {{calColor39}};">{{calCell39}}</text>
<text class="month-cell" style="left: 232px; top: 325px; color: {{calColor40}};">{{calCell40}}</text>
<text class="month-cell" style="left: 276px; top: 325px; color: {{calColor41}};">{{calCell41}}</text>
    <text class="month-info">{{calendarInfo}}</text>
    <input class="month-current" type="button" value="回到本月" onclick="currentMonth" />
    <input class="month-close" type="button" value="返回主页" onclick="goHome" />
  </div>
</template>

<script>
import router from '@system.router'
import { dayInfo } from '../../common/utils/date.js'
import { isLegalHoliday, monthHolidayText } from '../../common/utils/holiday.js'

const today = dayInfo(new Date())

export default {
  // AIoT/Vela 页面数据必须放在 private 中，顶层属性不会被当作模板数据源
  private: {
    calendarYear: today.year,
    calendarMonth: today.month,
    calendarTitle: '',
    calendarInfo: '',
    calCell0: '', calColor0: '#2b2723',
    calCell1: '', calColor1: '#2b2723',
    calCell2: '', calColor2: '#2b2723',
    calCell3: '', calColor3: '#2b2723',
    calCell4: '', calColor4: '#2b2723',
    calCell5: '', calColor5: '#2b2723',
    calCell6: '', calColor6: '#2b2723',
    calCell7: '', calColor7: '#2b2723',
    calCell8: '', calColor8: '#2b2723',
    calCell9: '', calColor9: '#2b2723',
    calCell10: '', calColor10: '#2b2723',
    calCell11: '', calColor11: '#2b2723',
    calCell12: '', calColor12: '#2b2723',
    calCell13: '', calColor13: '#2b2723',
    calCell14: '', calColor14: '#2b2723',
    calCell15: '', calColor15: '#2b2723',
    calCell16: '', calColor16: '#2b2723',
    calCell17: '', calColor17: '#2b2723',
    calCell18: '', calColor18: '#2b2723',
    calCell19: '', calColor19: '#2b2723',
    calCell20: '', calColor20: '#2b2723',
    calCell21: '', calColor21: '#2b2723',
    calCell22: '', calColor22: '#2b2723',
    calCell23: '', calColor23: '#2b2723',
    calCell24: '', calColor24: '#2b2723',
    calCell25: '', calColor25: '#2b2723',
    calCell26: '', calColor26: '#2b2723',
    calCell27: '', calColor27: '#2b2723',
    calCell28: '', calColor28: '#2b2723',
    calCell29: '', calColor29: '#2b2723',
    calCell30: '', calColor30: '#2b2723',
    calCell31: '', calColor31: '#2b2723',
    calCell32: '', calColor32: '#2b2723',
    calCell33: '', calColor33: '#2b2723',
    calCell34: '', calColor34: '#2b2723',
    calCell35: '', calColor35: '#2b2723',
    calCell36: '', calColor36: '#2b2723',
    calCell37: '', calColor37: '#2b2723',
    calCell38: '', calColor38: '#2b2723',
    calCell39: '', calColor39: '#2b2723',
    calCell40: '', calColor40: '#2b2723',
    calCell41: '', calColor41: '#2b2723',
  },


  onInit() {
    this.renderCalendar()
  },

  previousMonth() {
    this.calendarMonth -= 1
    if (this.calendarMonth < 1) { this.calendarMonth = 12; this.calendarYear -= 1 }
    this.renderCalendar()
  },

  nextMonth() {
    this.calendarMonth += 1
    if (this.calendarMonth > 12) { this.calendarMonth = 1; this.calendarYear += 1 }
    this.renderCalendar()
  },

  currentMonth() {
    this.calendarYear = today.year
    this.calendarMonth = today.month
    this.renderCalendar()
  },

  renderCalendar() {
    const y = this.calendarYear
    const m = this.calendarMonth
    const first = new Date(y, m - 1, 1).getDay()
    const days = new Date(y, m, 0).getDate()
    this.calendarTitle = y + '年 ' + m + '月'
    this.calendarInfo = '本月 ' + days + ' 天 · 今日 ' + today.label
    const holidayText = monthHolidayText(y, m)
    if (holidayText) this.calendarInfo = '本月 ' + days + ' 天 · ' + holidayText
    for (let i = 0; i < 42; i++) {
      const d = i - first + 1
      const inMonth = d > 0 && d <= days
      this['calCell' + i] = inMonth ? String(d) : ''
      let color = '#d8d2c6'
      if (inMonth) {
        const isToday = y === today.year && m === today.month && d === today.date
        const dow = (i % 7)
        const isWeekend = dow === 0 || dow === 6
        const holiday = isLegalHoliday(y, m, d)
        if (isToday) color = '#a83b2d'
        else if (holiday) color = '#c0392b'
        else if (isWeekend) color = '#3f7d46'
        else color = '#2b2723'
      }
      this['calColor' + i] = color
    }
  },

  goHome() {
    router.replace({ uri: 'pages/index' })
  },

  // 1.8.17：右滑返回上一级（日历页上一级为主页）
  handleSwipe(event) {
    if (event && event.direction === 'right') this.goHome()
  }
}
</script>

<style>
/* 1.8.18 设计令牌：bg #f2eee5 / card #fffdf8 / 主文字 #2b2723 / 次要 #7b7268 / 提示 #9a9186 / 品牌红 #a83b2d / 分割线 #ece3d6 */
.month-mask { position: absolute; left: 0; top: 0; width: 336px; height: 480px; background-color: #f2eee5; }
/* 回退箭头透明命中层加宽至 64px（规避左缘触摸死区，视觉不变） */
.month-back-hit { position: absolute; left: 10px; top: 10px; width: 64px; height: 40px; }
.month-back { width: 40px; height: 40px; line-height: 40px; color: #2b2723; font-size: 26px; text-align: center; }
.month-page-title { position: absolute; left: 56px; top: 17px; width: 160px; height: 22px; line-height: 22px; color: #2b2723; font-size: 18px; font-weight: bold; }
.header-line { position: absolute; left: 16px; top: 56px; width: 304px; height: 1px; background-color: #ece3d6; }
.month-title { position: absolute; left: 76px; top: 66px; width: 184px; height: 24px; line-height: 24px; font-size: 17px; font-weight: bold; color: #2b2723; text-align: center; }
.month-prev, .month-next { position: absolute; top: 62px; width: 56px; height: 32px; border-width: 1px; border-color: #ece3d6; border-radius: 6px; background-color: #fffdf8; color: #574e45; font-size: 14px; }
.month-prev { left: 16px; } .month-next { left: 264px; }
.month-week-cell { position: absolute; top: 104px; width: 42px; height: 18px; line-height: 18px; font-size: 13px; color: #9a9186; text-align: center; }
.month-cell { position: absolute; width: 42px; height: 36px; line-height: 36px; font-size: 20px; text-align: center; }
.month-info { position: absolute; left: 12px; top: 368px; width: 312px; height: 18px; line-height: 18px; font-size: 13px; color: #7b7268; text-align: center; }
.month-current { position: absolute; left: 18px; top: 416px; width: 140px; height: 42px; border-radius: 6px; background-color: #a83b2d; color: #fffaf2; font-size: 16px; font-weight: bold; }
.month-close { position: absolute; left: 178px; top: 416px; width: 140px; height: 42px; border-width: 1px; border-color: #a83b2d; border-radius: 6px; background-color: #fffdf8; color: #a83b2d; font-size: 16px; font-weight: bold; }
</style>
