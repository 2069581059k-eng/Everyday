<template>
  <div class="fav-mask" onswipe="handleSwipe">
    <div class="fav-panel">
      <div class="fav-list-view" show="{{listVisible}}">
        <div class="fav-filter-bar">
          <input class="fav-filter-btn ff-all" show="{{filterMode !== 0}}" value="全部" onclick="setFilterAll" />
          <input class="fav-filter-btn ff-all ff-on" show="{{filterMode === 0}}" value="全部" onclick="setFilterAll" />
          <input class="fav-filter-btn ff-quote" show="{{filterMode !== 1}}" value="一言" onclick="setFilterQuote" />
          <input class="fav-filter-btn ff-quote ff-on" show="{{filterMode === 1}}" value="一言" onclick="setFilterQuote" />
          <input class="fav-filter-btn ff-fortune" show="{{filterMode !== 2}}" value="抽签" onclick="setFilterFortune" />
          <input class="fav-filter-btn ff-fortune ff-on" show="{{filterMode === 2}}" value="抽签" onclick="setFilterFortune" />
          <input class="fav-filter-btn ff-know" show="{{filterMode !== 3}}" value="知识" onclick="setFilterKnowledge" />
          <input class="fav-filter-btn ff-know ff-on" show="{{filterMode === 3}}" value="知识" onclick="setFilterKnowledge" />
        </div>

        <div class="fav-slot" show="{{slotVisible1}}" onclick="openDetail(0)">
          <text class="fav-slot-badge">{{slotBadge1}}</text>
          <text class="fav-slot-text">{{slotText1}}</text>
          <image class="fav-slot-heart" src="/common/assets/ic-heart-on.png" />
        </div>
        <div class="fav-slot fav-slot-2" show="{{slotVisible2}}" onclick="openDetail(1)">
          <text class="fav-slot-badge">{{slotBadge2}}</text>
          <text class="fav-slot-text">{{slotText2}}</text>
          <image class="fav-slot-heart" src="/common/assets/ic-heart-on.png" />
        </div>
        <div class="fav-slot fav-slot-3" show="{{slotVisible3}}" onclick="openDetail(2)">
          <text class="fav-slot-badge">{{slotBadge3}}</text>
          <text class="fav-slot-text">{{slotText3}}</text>
          <image class="fav-slot-heart" src="/common/assets/ic-heart-on.png" />
        </div>
        <div class="fav-slot fav-slot-4" show="{{slotVisible4}}" onclick="openDetail(3)">
          <text class="fav-slot-badge">{{slotBadge4}}</text>
          <text class="fav-slot-text">{{slotText4}}</text>
          <image class="fav-slot-heart" src="/common/assets/ic-heart-on.png" />
        </div>

        <text class="fav-filter-empty" show="{{filterEmptyVisible}}">该类型还没有收藏</text>

        <div class="fav-pager">
          <input class="fav-page-btn fav-prev" type="button" value="上一页" onclick="prevPage" disabled="{{prevDisabled}}" />
          <text class="fav-page-label">{{pageLabel}}</text>
          <input class="fav-page-btn fav-next" type="button" value="下一页" onclick="nextPage" disabled="{{nextDisabled}}" />
        </div>
      </div>

      <div class="fav-empty" show="{{emptyVisible}}">
        <image class="fav-empty-ill" src="/common/assets/ill-bamboo.png" />
        <text class="fav-empty-title">还没有收藏内容</text>
        <text class="fav-empty-hint">在首页或知识大全点亮爱心即可收藏</text>
        <input class="fav-empty-home" type="button" value="返回主页" onclick="goHome" />
      </div>

      <div class="fav-detail-view" show="{{detailVisible}}">
        <text class="fav-detail-kicker">{{detailBadge}}</text>

        <div class="fav-detail-center" show="{{!detailHasBody}}">
          <text class="fav-center-text">{{detailText}}</text>
          <text class="fav-center-sub">— {{detailSub}}</text>
        </div>

        <div class="fav-detail-doc" show="{{detailHasBody}}">
          <text class="fav-detail-text">{{detailText}}</text>
          <text class="fav-detail-sub">{{detailSub}}</text>

          <div class="fav-detail-box" onclick="nextDetailChunk">
            <text class="fav-detail-body">{{detailBody}}</text>
            <text class="fav-detail-page" show="{{detailNextVisible}}">{{detailPageText}}</text>
          </div>
        </div>

        <div class="fav-detail-actions">
          <input class="fav-remove-btn" type="button" value="取消收藏 ♥" onclick="removeFavorite" />
          <input class="fav-back-btn" type="button" value="返回列表" onclick="backToList" />
        </div>
      </div>
    </div>

    <div class="fav-back-hit" onclick="handleBack"><text class="fav-back">‹</text></div>
    <text class="fav-title">收藏室</text>
    <text class="fav-count">{{countText}}</text>
    <div class="header-line"></div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'
import { FAVORITES_KEY } from '../../common/utils/favorites.js'

const PAGE_SIZE = 4
// 1.8.19：正文框扩至 h226（body h186，16px/22lh×8 行×18 字=144 字容量），分页粒度 120 保持安全余量
const CHUNK_CHARS = 120

let favoritesItems = []
let filteredItems = []
let pageIndex = 0
let detailIndex = -1
let detailChunks = []
let detailChunkIndex = 0

// 类型筛选：0=全部 1=DAILY NOTE 2=抽签 3=知识（知识类合并五类题目分类）
function applyFilter(mode) {
  if (mode === 1) filteredItems = favoritesItems.filter(function (item) { return item.type === 'DAILY NOTE' })
  else if (mode === 2) filteredItems = favoritesItems.filter(function (item) { return item.type === '抽签' })
  else if (mode === 3) filteredItems = favoritesItems.filter(function (item) { return item.type !== 'DAILY NOTE' && item.type !== '抽签' })
  else filteredItems = favoritesItems.slice()
}

// 1.8.19：详情正文清洗——①剥离开头「答案：」前缀（答题类存档与旧版阅读类存档均有）；
// ②旧版阅读类存档正文首行重复标题（「答案：标题\n解析：正文」结构），剥到正文本体；
// ③剥离后若仍以「解析：」开头一并去掉
function cleanDetailBody(detail, title) {
  let body = String(detail || '').replace(/^答案[:：]\s*/, '')
  if (title && body.indexOf(title) === 0) body = body.slice(title.length).replace(/^[\s\n]+/, '')
  return body.replace(/^解析[:：]\s*/, '')
}

export default {
  // AIoT/Vela 页面数据必须放在 private 中，顶层属性不会被当作模板数据源
  private: {
    stateReady: false,
    listVisible: false,
    emptyVisible: false,
    detailVisible: false,
    filterMode: 0,
    filterEmptyVisible: false,
    countText: '',
    pageLabel: '',
    prevDisabled: true,
    nextDisabled: true,
    slotVisible1: false,
    slotVisible2: false,
    slotVisible3: false,
    slotVisible4: false,
    slotBadge1: '',
    slotBadge2: '',
    slotBadge3: '',
    slotBadge4: '',
    slotText1: '',
    slotText2: '',
    slotText3: '',
    slotText4: '',
    detailBadge: '',
    detailText: '',
    detailSub: '',
    detailHasBody: false,
    detailBody: '',
    detailNextVisible: false,
    detailPageText: '',
  },

  onInit() {
    this.setAwake(true)
    const page = this
    const finishLoad = function () {
      page.stateReady = true
      page.renderList()
    }
    try {
      storage.get({
        key: FAVORITES_KEY,
        default: '',
        success(data) {
          if (data) try {
            const saved = JSON.parse(data)
            if (saved && Array.isArray(saved.items)) favoritesItems = saved.items
          } catch (error) {
            console.log('收藏室存档解析失败: ' + error)
          }
          finishLoad()
        },
        fail() { finishLoad() }
      })
    } catch (error) { finishLoad() }
  },

  onShow() { this.setAwake(true) },
  onHide() { this.setAwake(false) },
  onDestroy() { this.setAwake(false) },

  setAwake(enabled) {
    try {
      brightness.setKeepScreenOn({
        keepScreenOn: enabled,
        success() {},
        fail(data, code) { console.log('keepScreenOn failed: ' + code) }
      })
    } catch (error) {}
  },

  saveFavorites() {
    try {
      storage.set({
        key: FAVORITES_KEY,
        value: JSON.stringify({ items: favoritesItems }),
        fail(data, code) { console.log('收藏室存档保存失败: ' + code) }
      })
    } catch (error) { console.log('存储模块不可用: ' + error) }
  },

  previewText(text) {
    const chars = Array.from(String(text || ''))
    return chars.length > 28 ? chars.slice(0, 27).join('') + '…' : chars.join('')
  },

  renderList() {
    const total = favoritesItems.length
    this.detailVisible = false
    this.emptyVisible = total === 0
    this.listVisible = total > 0
    this.countText = '共 ' + total + ' 条'
    if (total === 0) return

    applyFilter(this.filterMode)
    const shown = filteredItems.length
    this.filterEmptyVisible = shown === 0
    const pages = Math.max(1, Math.ceil(shown / PAGE_SIZE))
    if (pageIndex >= pages) pageIndex = pages - 1
    if (pageIndex < 0) pageIndex = 0
    this.pageLabel = (pageIndex + 1) + ' / ' + pages
    this.prevDisabled = pageIndex <= 0
    this.nextDisabled = pageIndex >= pages - 1

    const start = pageIndex * PAGE_SIZE
    for (let i = 0; i < PAGE_SIZE; i++) {
      const item = filteredItems[start + i]
      const badge = item ? item.type : ''
      const text = item ? this.previewText(item.text) : ''
      const visible = !!item
      if (i === 0) { this.slotVisible1 = visible; this.slotBadge1 = badge; this.slotText1 = text }
      if (i === 1) { this.slotVisible2 = visible; this.slotBadge2 = badge; this.slotText2 = text }
      if (i === 2) { this.slotVisible3 = visible; this.slotBadge3 = badge; this.slotText3 = text }
      if (i === 3) { this.slotVisible4 = visible; this.slotBadge4 = badge; this.slotText4 = text }
    }
  },

  setFilter(mode) {
    this.filterMode = mode
    pageIndex = 0
    this.renderList()
    this.pulse('short')
  },

  setFilterAll() { this.setFilter(0) },
  setFilterQuote() { this.setFilter(1) },
  setFilterFortune() { this.setFilter(2) },
  setFilterKnowledge() { this.setFilter(3) },

  prevPage() {
    if (pageIndex <= 0) return
    pageIndex -= 1
    this.renderList()
    this.pulse('short')
  },

  nextPage() {
    pageIndex += 1
    this.renderList()
    this.pulse('short')
  },

  openDetail(slot) {
    const itemIndex = pageIndex * PAGE_SIZE + slot
    if (itemIndex >= filteredItems.length) return
    detailIndex = itemIndex
    this.renderDetail()
    this.pulse('short')
  },

  renderDetail() {
    const item = filteredItems[detailIndex]
    if (!item) { this.renderList(); return }
    this.listVisible = false
    this.emptyVisible = false
    this.detailVisible = true
    this.detailBadge = item.type
    this.detailText = item.text
    // 1.8.19：知识类「分类 · 已收录」副标题与角标重复（鬼故事同一界面出现两次），隐藏；兼容旧存档
    this.detailSub = / · 已收录$/.test(item.sub || '') ? '' : item.sub
    detailChunks = []
    const chars = Array.from(cleanDetailBody(item.detail, item.text))
    for (let i = 0; i < chars.length; i += CHUNK_CHARS) detailChunks.push(chars.slice(i, i + CHUNK_CHARS).join(''))
    // 1.8.17：无正文类型（每日一言等）走居中大字布局，不渲染正文框
    this.detailHasBody = chars.length > 0
    if (!this.detailHasBody) detailChunks = ['']
    detailChunkIndex = 0
    this.renderDetailChunk()
  },

  renderDetailChunk() {
    this.detailBody = detailChunks[detailChunkIndex] || ''
    this.detailNextVisible = detailChunks.length > 1
    this.detailPageText = (detailChunkIndex + 1) + '/' + detailChunks.length
  },

  nextDetailChunk() {
    detailChunkIndex = (detailChunkIndex + 1) % detailChunks.length
    this.renderDetailChunk()
  },

  removeFavorite() {
    // detailIndex 为筛选列表索引：按 id 映射回全量列表删除（筛选状态下删除正确条目）
    const item = filteredItems[detailIndex]
    if (!item) return
    const id = item.id
    for (let i = 0; i < favoritesItems.length; i++) {
      if (favoritesItems[i].id === id) { favoritesItems.splice(i, 1); break }
    }
    detailIndex = -1
    this.saveFavorites()
    this.renderList()
    this.pulse('short')
  },

  backToList() {
    this.renderList()
    this.pulse('short')
  },

  goHome() {
    router.replace({ uri: 'pages/index' })
  },

  // 顶部回退箭头：详情中返回列表，列表/空态返回主页（与右滑一致）
  handleBack() {
    if (this.detailVisible) { this.backToList(); return }
    this.goHome()
  },

  // 1.8.17：右滑返回上一级——详情中返回列表，列表/空态返回主页
  handleSwipe(event) {
    if (!event || event.direction !== 'right') return
    if (this.detailVisible) { this.backToList(); return }
    this.goHome()
  },

  pulse(mode) {
    try { vibrator.vibrate({ mode: mode }) } catch (error) {}
  }
}
</script>

<style>
/* 1.8.18 设计令牌：bg #f2eee5 / card #fffdf8 / 主文字 #2b2723 / 次要 #7b7268 / 提示 #9a9186 / 品牌红 #a83b2d / 分割线 #ece3d6 */
.fav-mask { position: absolute; left: 0; top: 0; width: 336px; height: 480px; background-color: #f2eee5; }
/* 回退箭头透明命中层加宽至 64px：模拟器左缘 x<40 为触摸抖动死区（真机边缘手势同风险），保证箭头可点、视觉不变 */
.fav-back-hit { position: absolute; left: 10px; top: 10px; width: 64px; height: 40px; }
.fav-back { width: 40px; height: 40px; line-height: 40px; color: #2b2723; font-size: 26px; text-align: center; }
.fav-title { position: absolute; left: 56px; top: 17px; width: 120px; height: 22px; line-height: 22px; color: #2b2723; font-size: 18px; font-weight: bold; }
.fav-count { position: absolute; left: 196px; top: 20px; width: 124px; height: 16px; line-height: 16px; color: #9a9186; font-size: 12px; text-align: right; }
.header-line { position: absolute; left: 16px; top: 56px; width: 304px; height: 1px; background-color: #ece3d6; }

/* 面板整体下沉到头部之下（top 56px，高度 412px）：与回退箭头零重叠，杜绝全屏面板吞掉头部触摸（1.8.18 收藏室箭头失效事故的根因修复，子元素整体上移 44px 保持绝对视觉不变） */
.fav-panel { position: absolute; left: 12px; top: 56px; width: 312px; height: 412px; }
.fav-list-view { position: absolute; left: 0; top: 0; width: 312px; height: 412px; }

/* 分类筛选栏（固定槽位双份 show 切换激活态，Vela 不支持动态 class） */
.fav-filter-bar { position: absolute; left: 0; top: 8px; width: 312px; height: 30px; }
.fav-filter-btn { position: absolute; top: 0; width: 70px; height: 30px; border-width: 1px; border-color: #ece3d6; border-radius: 6px; background-color: #fffdf8; color: #7b7268; font-size: 13px; }
.ff-all { left: 4px; }
.ff-quote { left: 82px; }
.ff-fortune { left: 160px; }
.ff-know { left: 238px; }
.ff-on { border-color: #a83b2d; background-color: #a83b2d; color: #fffaf2; font-weight: bold; }

/* 收藏条目卡片（每页 4 条固定槽位） */
.fav-slot { position: absolute; left: 0; top: 50px; width: 312px; height: 64px; border-width: 1px; border-color: #ece3d6; border-radius: 8px; background-color: #fffdf8; }
.fav-slot-2 { top: 122px; }
.fav-slot-3 { top: 194px; }
.fav-slot-4 { top: 266px; }
.fav-slot-badge { position: absolute; left: 12px; top: 9px; width: 180px; height: 14px; line-height: 14px; color: #a83b2d; font-size: 11px; font-weight: bold; letter-spacing: 1px; }
.fav-slot-text { position: absolute; left: 12px; top: 27px; width: 252px; height: 32px; color: #2b2723; font-size: 14px; line-height: 17px; }
.fav-slot-heart { position: absolute; left: 280px; top: 22px; width: 20px; height: 20px; }
.fav-filter-empty { position: absolute; left: 0; top: 166px; width: 312px; height: 20px; line-height: 20px; color: #7b7268; font-size: 14px; text-align: center; }

/* 底部分页栏 */
.fav-pager { position: absolute; left: 16px; top: 352px; width: 280px; height: 44px; }
.fav-page-btn { position: absolute; top: 0; width: 86px; height: 44px; border-width: 1px; border-color: #ece3d6; border-radius: 6px; background-color: #fffdf8; color: #574e45; font-size: 14px; font-weight: bold; }
.fav-prev { left: 0; }
.fav-next { left: 194px; }
.fav-page-label { position: absolute; left: 86px; top: 0; width: 108px; height: 44px; line-height: 44px; color: #9a9186; font-size: 13px; text-align: center; }

/* 空状态 */
.fav-empty { position: absolute; left: 0; top: 0; width: 312px; height: 412px; }
.fav-empty-ill { position: absolute; left: 96px; top: 52px; width: 120px; height: 110px; }
.fav-empty-title { position: absolute; left: 16px; top: 182px; width: 280px; height: 24px; line-height: 24px; color: #2b2723; font-size: 18px; font-weight: bold; text-align: center; }
.fav-empty-hint { position: absolute; left: 16px; top: 212px; width: 280px; height: 18px; line-height: 18px; color: #9a9186; font-size: 13px; text-align: center; }
.fav-empty-home { position: absolute; left: 76px; top: 266px; width: 160px; height: 44px; border-radius: 6px; background-color: #a83b2d; color: #fffaf2; font-size: 16px; font-weight: bold; }

/* 详情视图（1.8.19 重排：副标题让位、正文框扩容至 226px，「继续」按钮移除改点击正文翻页） */
.fav-detail-view { position: absolute; left: 0; top: 0; width: 312px; height: 412px; }
.fav-detail-kicker { position: absolute; left: 8px; top: 8px; width: 200px; height: 18px; line-height: 18px; color: #a83b2d; font-size: 13px; font-weight: bold; letter-spacing: 2px; }
.fav-detail-doc { position: absolute; left: 0; top: 0; width: 312px; height: 412px; }
.fav-detail-text { position: absolute; left: 8px; top: 30px; width: 296px; height: 54px; color: #2b2723; font-size: 19px; font-weight: bold; line-height: 25px; }
.fav-detail-sub { position: absolute; left: 8px; top: 86px; width: 296px; height: 14px; line-height: 14px; color: #9a9186; font-size: 12px; }
.fav-detail-box { position: absolute; left: 0; top: 108px; width: 312px; height: 226px; border-width: 1px; border-color: #ece3d6; border-radius: 8px; background-color: #fffdf8; }
.fav-detail-body { position: absolute; left: 12px; top: 12px; width: 288px; height: 186px; color: #2b2723; font-size: 16px; line-height: 22px; }
.fav-detail-page { position: absolute; left: 12px; top: 202px; width: 288px; height: 14px; line-height: 14px; color: #9a9186; font-size: 11px; text-align: right; }

.fav-detail-center { position: absolute; left: 0; top: 0; width: 312px; height: 412px; }
.fav-center-text { position: absolute; left: 20px; top: 96px; width: 272px; height: 130px; color: #2b2723; font-size: 21px; font-weight: bold; line-height: 30px; text-align: center; }
.fav-center-sub { position: absolute; left: 20px; top: 238px; width: 272px; height: 18px; line-height: 18px; color: #9a9186; font-size: 13px; text-align: center; }

.fav-detail-actions { position: absolute; left: 16px; top: 352px; width: 280px; height: 44px; }
.fav-remove-btn { position: absolute; left: 0; top: 0; width: 136px; height: 44px; border-width: 1px; border-color: #a83b2d; border-radius: 6px; background-color: #fffdf8; color: #a83b2d; font-size: 15px; font-weight: bold; }
.fav-back-btn { position: absolute; left: 152px; top: 0; width: 128px; height: 44px; border-radius: 6px; background-color: #a83b2d; color: #fffaf2; font-size: 15px; font-weight: bold; }
</style>
