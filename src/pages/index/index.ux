<template>
  <div class="page" onswipe="handleSwipe">
    <text class="brand">每日一言</text>

    <div class="stat-row">
      <text class="stat-text">连续 {{streakText}} 天</text>
      <text class="date-text">{{dateText}}</text>
      <text class="star-text">灵光 {{starsText}}</text>
    </div>

    <div class="cover-card" show="{{coverVisible}}">
      <div class="cover-month-bar">
        <text class="cover-month">{{monthYearText}}</text>
      </div>
      <text class="cover-day">{{dayText}}</text>
      <text class="cover-weekday">{{weekdayText}}</text>
      <div class="paper-line"></div>
      <input class="draw-button" type="button" value="翻开今日一签" onclick="revealToday" disabled="{{!stateReady}}" />
    </div>

    <div class="quote-card" show="{{quoteVisible}}">
      <div class="quote-accent"></div>
      <text class="quote-kicker">每日一言 · {{quoteNote}}</text>
      <text class="fortune-stamp">{{fortuneLevel}}</text>
      <input class="favorite-button" type="button" value="{{favoriteText}}" onclick="toggleFavorite" />
      <text class="quote-text">{{quoteText}}</text>
      <text class="quote-source">— {{quoteSource}}</text>
      <text class="fortune-tip">{{fortuneTip}}</text>
    </div>

    <div class="feature-row" show="{{quoteVisible}}">
      <div class="calendar-card" onclick="openCalendar">
        <text class="feature-title">今日日历</text>
        <text class="calendar-day">{{dayText}}</text>
        <text class="calendar-month">{{monthShortText}} {{weekdayText}}</text>
        <text class="feature-go">月历 ›</text>
      </div>

      <div class="astro-card" onclick="openZodiac">
        <text class="feature-title">趣味星象</text>
        <text class="zodiac-name-short">{{zodiacName}}</text>
        <text class="feature-go">详情 ›</text>
      </div>
    </div>

    <div class="quote-actions" show="{{quoteVisible}}">
      <input class="action-button action-primary" type="button" value="知识大全" onclick="startQuiz" />
      <input class="action-button action-secondary" type="button" value="换一句" onclick="drawAnother" />
    </div>

    <div class="quiz-mask" show="{{quizVisible}}">
      <div class="quiz-panel">
        <text class="quiz-kicker">知识大全</text>
        <text class="quiz-count">{{quizCategory}} · {{quizPos}} / {{quizTotal}}</text>

        <div class="quiz-question-box">
          <text class="quiz-question">{{riddleQuestion}}</text>
        </div>

        <input class="quiz-reveal-btn" show="{{!answerVisible}}" type="button" value="{{revealLabel}}" onclick="revealAnswer" />

        <div class="quiz-answer-box" show="{{answerVisible}}">
          <text class="quiz-answer-label">{{answerLabel}}</text>
          <text class="quiz-answer-text">{{riddleAnswer}}</text>
          <text class="quiz-explain">{{riddleExplain}}</text>
          <input class="detail-next" show="{{detailTotal > 1}}" type="button" value="{{detailLabel}}" onclick="nextDetail" />
        </div>

        <div class="quiz-actionbar">
          <input class="quiz-nav-btn quiz-prev" type="button" value="{{prevLabel}}" onclick="prevQuestion" disabled="{{prevDisabled}}" />
          <input class="quiz-nav-btn quiz-cancel" type="button" value="返回今日" onclick="closeQuiz" />
          <input class="quiz-nav-btn quiz-next" type="button" value="{{nextLabel}}" onclick="nextQuestion" disabled="{{nextDisabled}}" />
        </div>
      </div>
    </div>
    <div class="month-mask" show="{{calendarVisible}}">
      <text class="month-title">{{calendarTitle}}</text>
      <input class="month-prev" type="button" value="上月" onclick="previousMonth" />
      <input class="month-next" type="button" value="下月" onclick="nextMonth" />
      <text class="month-week-cell" style="left: 12px;">日</text>
      <text class="month-week-cell" style="left: 56px;">一</text>
      <text class="month-week-cell" style="left: 100px;">二</text>
      <text class="month-week-cell" style="left: 144px;">三</text>
      <text class="month-week-cell" style="left: 188px;">四</text>
      <text class="month-week-cell" style="left: 232px;">五</text>
      <text class="month-week-cell" style="left: 276px;">六</text>
      <text class="month-cell" style="left: 12px; top: 130px; color: {{calToday0 ? '#a83b2d' : '#383029'}};">{{calCell0}}</text>
<text class="month-cell" style="left: 56px; top: 130px; color: {{calToday1 ? '#a83b2d' : '#383029'}};">{{calCell1}}</text>
<text class="month-cell" style="left: 100px; top: 130px; color: {{calToday2 ? '#a83b2d' : '#383029'}};">{{calCell2}}</text>
<text class="month-cell" style="left: 144px; top: 130px; color: {{calToday3 ? '#a83b2d' : '#383029'}};">{{calCell3}}</text>
<text class="month-cell" style="left: 188px; top: 130px; color: {{calToday4 ? '#a83b2d' : '#383029'}};">{{calCell4}}</text>
<text class="month-cell" style="left: 232px; top: 130px; color: {{calToday5 ? '#a83b2d' : '#383029'}};">{{calCell5}}</text>
<text class="month-cell" style="left: 276px; top: 130px; color: {{calToday6 ? '#a83b2d' : '#383029'}};">{{calCell6}}</text>
<text class="month-cell" style="left: 12px; top: 169px; color: {{calToday7 ? '#a83b2d' : '#383029'}};">{{calCell7}}</text>
<text class="month-cell" style="left: 56px; top: 169px; color: {{calToday8 ? '#a83b2d' : '#383029'}};">{{calCell8}}</text>
<text class="month-cell" style="left: 100px; top: 169px; color: {{calToday9 ? '#a83b2d' : '#383029'}};">{{calCell9}}</text>
<text class="month-cell" style="left: 144px; top: 169px; color: {{calToday10 ? '#a83b2d' : '#383029'}};">{{calCell10}}</text>
<text class="month-cell" style="left: 188px; top: 169px; color: {{calToday11 ? '#a83b2d' : '#383029'}};">{{calCell11}}</text>
<text class="month-cell" style="left: 232px; top: 169px; color: {{calToday12 ? '#a83b2d' : '#383029'}};">{{calCell12}}</text>
<text class="month-cell" style="left: 276px; top: 169px; color: {{calToday13 ? '#a83b2d' : '#383029'}};">{{calCell13}}</text>
<text class="month-cell" style="left: 12px; top: 208px; color: {{calToday14 ? '#a83b2d' : '#383029'}};">{{calCell14}}</text>
<text class="month-cell" style="left: 56px; top: 208px; color: {{calToday15 ? '#a83b2d' : '#383029'}};">{{calCell15}}</text>
<text class="month-cell" style="left: 100px; top: 208px; color: {{calToday16 ? '#a83b2d' : '#383029'}};">{{calCell16}}</text>
<text class="month-cell" style="left: 144px; top: 208px; color: {{calToday17 ? '#a83b2d' : '#383029'}};">{{calCell17}}</text>
<text class="month-cell" style="left: 188px; top: 208px; color: {{calToday18 ? '#a83b2d' : '#383029'}};">{{calCell18}}</text>
<text class="month-cell" style="left: 232px; top: 208px; color: {{calToday19 ? '#a83b2d' : '#383029'}};">{{calCell19}}</text>
<text class="month-cell" style="left: 276px; top: 208px; color: {{calToday20 ? '#a83b2d' : '#383029'}};">{{calCell20}}</text>
<text class="month-cell" style="left: 12px; top: 247px; color: {{calToday21 ? '#a83b2d' : '#383029'}};">{{calCell21}}</text>
<text class="month-cell" style="left: 56px; top: 247px; color: {{calToday22 ? '#a83b2d' : '#383029'}};">{{calCell22}}</text>
<text class="month-cell" style="left: 100px; top: 247px; color: {{calToday23 ? '#a83b2d' : '#383029'}};">{{calCell23}}</text>
<text class="month-cell" style="left: 144px; top: 247px; color: {{calToday24 ? '#a83b2d' : '#383029'}};">{{calCell24}}</text>
<text class="month-cell" style="left: 188px; top: 247px; color: {{calToday25 ? '#a83b2d' : '#383029'}};">{{calCell25}}</text>
<text class="month-cell" style="left: 232px; top: 247px; color: {{calToday26 ? '#a83b2d' : '#383029'}};">{{calCell26}}</text>
<text class="month-cell" style="left: 276px; top: 247px; color: {{calToday27 ? '#a83b2d' : '#383029'}};">{{calCell27}}</text>
<text class="month-cell" style="left: 12px; top: 286px; color: {{calToday28 ? '#a83b2d' : '#383029'}};">{{calCell28}}</text>
<text class="month-cell" style="left: 56px; top: 286px; color: {{calToday29 ? '#a83b2d' : '#383029'}};">{{calCell29}}</text>
<text class="month-cell" style="left: 100px; top: 286px; color: {{calToday30 ? '#a83b2d' : '#383029'}};">{{calCell30}}</text>
<text class="month-cell" style="left: 144px; top: 286px; color: {{calToday31 ? '#a83b2d' : '#383029'}};">{{calCell31}}</text>
<text class="month-cell" style="left: 188px; top: 286px; color: {{calToday32 ? '#a83b2d' : '#383029'}};">{{calCell32}}</text>
<text class="month-cell" style="left: 232px; top: 286px; color: {{calToday33 ? '#a83b2d' : '#383029'}};">{{calCell33}}</text>
<text class="month-cell" style="left: 276px; top: 286px; color: {{calToday34 ? '#a83b2d' : '#383029'}};">{{calCell34}}</text>
<text class="month-cell" style="left: 12px; top: 325px; color: {{calToday35 ? '#a83b2d' : '#383029'}};">{{calCell35}}</text>
<text class="month-cell" style="left: 56px; top: 325px; color: {{calToday36 ? '#a83b2d' : '#383029'}};">{{calCell36}}</text>
<text class="month-cell" style="left: 100px; top: 325px; color: {{calToday37 ? '#a83b2d' : '#383029'}};">{{calCell37}}</text>
<text class="month-cell" style="left: 144px; top: 325px; color: {{calToday38 ? '#a83b2d' : '#383029'}};">{{calCell38}}</text>
<text class="month-cell" style="left: 188px; top: 325px; color: {{calToday39 ? '#a83b2d' : '#383029'}};">{{calCell39}}</text>
<text class="month-cell" style="left: 232px; top: 325px; color: {{calToday40 ? '#a83b2d' : '#383029'}};">{{calCell40}}</text>
<text class="month-cell" style="left: 276px; top: 325px; color: {{calToday41 ? '#a83b2d' : '#383029'}};">{{calCell41}}</text>

      <text class="month-info">{{calendarInfo}}</text>
      <input class="month-current" type="button" value="回到本月" onclick="currentMonth" />
      <input class="month-close" type="button" value="返回主页" onclick="closeCalendar" />
    </div>

    <div class="zodiac-mask" show="{{zodiacVisible}}">
      <text class="zodiac-title">趣味星象</text>
      <input class="zodiac-prev" type="button" value="‹" onclick="previousZodiac" />
      <input class="zodiac-next" type="button" value="›" onclick="nextZodiac" />
      <text class="zodiac-name-big">{{zodiacName}}</text>
      <text class="zodiac-range-big">{{zodiacRange}}</text>
      <text class="zodiac-moon">{{moonText}}</text>
      <text class="zodiac-tip">{{astroTip}}</text>
      <input class="zodiac-close" type="button" value="返回主页" onclick="closeZodiac" />
    </div>

    <input class="exit-button" type="button" value="退出" onclick="exitGame" />
  </div>
</template>

<script>
import app from '@system.app'
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'

const STORAGE_KEY = 'daily_quote_state_v1'

const RIDDLES = [
  { question: "迟到理由", category: "冷笑话", answer: "迟到理由", explain: "老师问小明：“今天怎么又迟到？”小明说：“路上有块牌子写着‘前方学校，请慢行’，我觉得做人应该遵守交通规则。”老师沉默了一会儿，把“遵守规则”四个字记在了他的迟到记录旁边。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "半价早餐", category: "冷笑话", answer: "半价早餐", explain: "早餐店写着“第二份半价”。我问老板：“那我只买第二份行不行？”老板看了我三秒：“可以，前提是你先把第一份买了。”我点点头，觉得商业世界果然不允许我钻这么大的空子。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "真的省钱", category: "冷笑话", answer: "真的省钱", explain: "朋友说他这个月特别省钱。我问怎么做到的，他说：“想买的东西先不买，等过几天涨价了，我就更舍不得买了。”我听完肃然起敬——别人等打折，他专门等自己死心。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "菜市场哲学", category: "冷笑话", answer: "菜市场哲学", explain: "我问卖菜的大叔：“这个萝卜甜吗？”大叔说：“萝卜的人生不能只用甜不甜来评价，它脆，它有水分，它还便宜。”我说：“那到底甜不甜？”大叔叹气：“不甜。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "饭量问题", category: "冷笑话", answer: "饭量问题", explain: "同事说自己饭量很小。我看着他面前第三碗饭：“你这叫小？”他说：“每一碗都不大啊。”我第一次意识到，统计口径不同，结论真的可以完全不同。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "诚实面试", category: "冷笑话", answer: "诚实面试", explain: "面试官问：“你最大的缺点是什么？”求职者说：“太诚实。”面试官笑：“我不觉得诚实是缺点。”求职者点头：“我也没问你觉得不觉得。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "雨伞社交", category: "冷笑话", answer: "雨伞社交", explain: "朋友下雨天忘带伞，站在公司门口等。有人问：“等雨停？”他说：“不是，等一个认识我的人带伞经过。”半小时后他成功等到了，只是那个人也忘了带伞。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "精确减肥", category: "冷笑话", answer: "精确减肥", explain: "朋友宣布自己瘦了五斤。我说：“这么厉害？”他把体重秤推过来：“上次穿棉衣称的，这次只穿短袖。”我夸他方法严谨，尤其是对“成果”定义得非常灵活。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "鸡蛋保险", category: "冷笑话", answer: "鸡蛋保险", explain: "买鸡蛋时我问老板：“碎了包赔吗？”老板说：“包。”我放心地提回家，路上摔碎三个。第二天找他，他递给我一个塑料袋：“昨天不是说了吗，碎了包——我给你包起来。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "安静的猫", category: "冷笑话", answer: "安静的猫", explain: "邻居说他家的猫特别安静，从不乱叫。我去他家坐了十分钟，猫确实一声没叫，只一直盯着我。邻居说：“它一般不跟陌生人说话。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "工资保鲜", category: "冷笑话", answer: "工资保鲜", explain: "同事问我工资发下来一般能保存多久。我说：“保存得挺好，刚到账时还是完整的，过两天就只剩一个美好的回忆。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "顺路", category: "冷笑话", answer: "顺路", explain: "朋友问：“你回家顺路带我一程吗？”我说：“顺路啊。”他很高兴上了车。开了十分钟他发现方向完全相反，问我怎么回事。我说：“顺我的路。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "认真听课", category: "冷笑话", answer: "认真听课", explain: "老师问小明：“上课为什么一直盯着窗外？”小明说：“老师您放心，我耳朵一直在教室里。”老师想了想，觉得这孩子至少对器官分工很有概念。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "快速入睡", category: "冷笑话", answer: "快速入睡", explain: "朋友说自己掌握了快速入睡的方法。我问秘诀，他说：“先躺下，再闭眼，然后等。”我问：“这不就是睡觉吗？”他说：“对，重点在于步骤一个都不能少。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "低调有钱", category: "冷笑话", answer: "低调有钱", explain: "有人问老王：“听说你很有钱？”老王摇头：“没有，我只是花钱的时候看起来比较有钱。”这句话听起来谦虚，银行卡听了却想报警。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "水果摊判断", category: "冷笑话", answer: "水果摊判断", explain: "我问老板：“这个西瓜熟吗？”老板拍了拍：“很熟。”我说：“有多熟？”老板说：“你再跟它聊两句，它都能管你叫兄弟。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "稳定工作", category: "冷笑话", answer: "稳定工作", explain: "朋友说自己工作特别稳定。我问：“干多久了？”他说：“每天八小时，稳定得一分不多。”我说的是职业，他理解的是工时，也算没毛病。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "长远规划", category: "冷笑话", answer: "长远规划", explain: "朋友问我有没有五年规划。我说：“有，先把今年活明白。”他说这太短。我反问：“那你五年前规划到今天了吗？”他突然开始研究桌上的纸巾。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "理发要求", category: "冷笑话", answer: "理发要求", explain: "理发师问：“怎么剪？”我说：“剪得让我妈满意。”理发师放下剪刀：“这个业务风险太高，您换个具体标准。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "健身成果", category: "冷笑话", answer: "健身成果", explain: "朋友健身三个月，我问练出腹肌没有。他掀起衣服：“暂时没看到，可能被脂肪保护得比较好。”他说得像文物修复，我一时不知道该不该鼓掌。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "库存不足", category: "冷笑话", answer: "库存不足", explain: "老板问员工：“你怎么一天到晚没精神？”员工说：“精神有，只是库存不多，得省着用。”老板听完让他去仓库盘点，顺便把这个说法也盘明白。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "借钱原则", category: "冷笑话", answer: "借钱原则", explain: "朋友问我能不能借他五百。我说：“原则上不借。”他问：“那特殊情况呢？”我说：“特殊情况下原则更重要。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "考试策略", category: "冷笑话", answer: "考试策略", explain: "考试前同学问小明：“复习了吗？”小明说：“复了。”大家很惊讶。小明补充：“习没习不知道，反正书翻过两遍。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "真实身高", category: "冷笑话", answer: "真实身高", explain: "体检时医生问：“身高多少？”我说：“一米八左右。”医生量完：“一米七三。”我说：“您这个尺子比较严格。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "充分休息", category: "冷笑话", answer: "充分休息", explain: "周末朋友问我做了什么。我说：“充分休息。”他问具体点。我说：“从床的左边睡到右边，又从右边睡回左边，完成了全方位恢复。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "会做饭", category: "冷笑话", answer: "会做饭", explain: "朋友说自己会做饭。我让他露一手，他进厨房半小时，端出一盘切好的黄瓜。我说：“这也叫做饭？”他说：“饭还在电饭锅里，我负责做菜。”逻辑严丝合缝。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "坚持早起", category: "冷笑话", answer: "坚持早起", explain: "朋友说自己坚持早起已经两个月。我问几点起。他说：“九点。”我说这也算早？他说：“对我以前十一点起床的人生来说，这是跨越式发展。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "省电妙招", category: "冷笑话", answer: "省电妙招", explain: "妈妈问：“你怎么又不开灯？”我说：“省电。”妈妈说：“可你白天也不开窗帘。”我说：“那是省太阳。”妈妈决定不继续追问能源政策。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "买一送一", category: "冷笑话", answer: "买一送一", explain: "商店写“买一送一”。我买了一个杯子，店员又给我一个。我问：“能不能送现金？”店员说：“我们送的是同款。”我说：“那你们这个活动限制还挺多。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "狗的态度", category: "冷笑话", answer: "狗的态度", explain: "朋友问我家狗认不认生。我说：“认。”他刚进门，狗冲过来闻了闻，然后趴回去了。朋友说：“它认识我？”我说：“不是，它确认你确实是生人。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "家庭地位", category: "冷笑话", answer: "家庭地位", explain: "有人问老王在家里有没有话语权。老王说：“当然有，我负责说‘好的’‘行’‘知道了’和‘马上’。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "新鲜空气", category: "冷笑话", answer: "新鲜空气", explain: "同事说办公室空气不好，出去透气。十分钟后我看见他蹲在楼下吃烤串。我问：“这叫透气？”他说：“烟是烟，气是气，至少我出来了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "迟到补偿", category: "冷笑话", answer: "迟到补偿", explain: "员工迟到二十分钟，老板问怎么补偿。他说：“我晚上晚走二十分钟。”老板点头。下班时他坐着没动，二十分钟后起身：“补偿完毕。”老板忽然觉得协议需要写得更细。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "有始有终", category: "冷笑话", answer: "有始有终", explain: "朋友夸我做事有始有终。我说：“那当然，我每次减肥都从第一天开始，并且都能坚持到结束。”他问什么时候结束。我说：“通常第二天。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "成熟水果", category: "冷笑话", answer: "成熟水果", explain: "我问水果店老板：“香蕉熟了吗？”老板说：“熟了。”我拿起一根还有点青。他解释：“它只是性格比较内向，不太表现出来。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "适量运动", category: "冷笑话", answer: "适量运动", explain: "医生建议我每天适量运动。我问：“多少算适量？”医生说：“微微出汗。”于是我夏天在阳台站了十分钟，完成得非常轻松。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "午休管理", category: "冷笑话", answer: "午休管理", explain: "领导说：“午休不要睡太久，二十分钟最好。”同事问我睡多久。我说：“我严格控制在二十分钟左右。”他问：“左右多少？”我说：“左两小时，右两小时。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "开会重点", category: "冷笑话", answer: "开会重点", explain: "会议快结束时领导问：“大家还有补充吗？”全场安静。领导一说“那今天就到这里”，突然有三个人想起了重要问题。可见记忆力和下班时间存在显著相关性。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "学会拒绝", category: "冷笑话", answer: "学会拒绝", explain: "朋友说做人要学会拒绝。我说：“有道理。”他说：“那借我两百。”我说：“不借。”他沉默几秒：“你学得也太快了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "鸡汤无效", category: "冷笑话", answer: "鸡汤无效", explain: "朋友安慰我：“失败是成功之母。”我问：“那成功的父亲是谁？”他想了半天，说：“可能是努力。”我说：“那我这边家庭关系挺复杂。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "最后一块", category: "冷笑话", answer: "最后一块", explain: "桌上只剩最后一块蛋糕，大家都说“不吃了”。我客气地问了三遍，没人动。我刚夹起来，四个人同时说：“你真吃啊？”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "节约纸巾", category: "冷笑话", answer: "节约纸巾", explain: "朋友吃辣得满头汗，我递纸巾。他摆手说：“不用，我在节约。”一分钟后他直接拿袖子擦。我忽然明白，有些节约只是把成本转移给洗衣机——不对，应该说转移给衣服。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "排队艺术", category: "冷笑话", answer: "排队艺术", explain: "有人插队，被后面大爷提醒：“年轻人，要排队。”那人说：“我就问一句。”大爷点头：“那你排到前面去问完，再回来从后面继续排。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "精准导航", category: "冷笑话", answer: "精准导航", explain: "朋友方向感很差，却坚持给我指路。“前面左转。”我问：“你确定？”他说：“不确定，但总不能一直直走吧。”这次导航充分体现了参与感。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "普通话水平", category: "冷笑话", answer: "普通话水平", explain: "朋友说自己普通话很标准。我让他说句绕口令。他想了想：“算了，普通话不普通的时候我就不说了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "不挑食", category: "冷笑话", answer: "不挑食", explain: "有人说自己从不挑食。我看他把香菜、葱、姜、蒜全挑出来：“这叫不挑？”他说：“我不是挑食，我是在整理食材。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "烧烤逻辑", category: "冷笑话", answer: "烧烤逻辑", explain: "朋友吃烧烤时说：“我只吃素。”然后点了烤韭菜、烤茄子、烤馒头片，还让老板多刷油。我问：“这样健康吗？”他说：“至少动物听了很欣慰。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "雨天计划", category: "冷笑话", answer: "雨天计划", explain: "天气预报说今天有雨，我特意带了伞。结果一天没下。第二天我不带伞，大雨。看来天气预报最大的作用，是测试我到底有多配合。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "早睡计划", category: "冷笑话", answer: "早睡计划", explain: "我决定十一点前睡觉，于是十点半开始刷牙，十点四十上床，十点五十关灯，十一点准时想起还有一堆事没做。计划执行得非常准时，睡觉除外。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "会聊天", category: "冷笑话", answer: "会聊天", explain: "朋友夸我会聊天。我问：“哪里会？”他说：“你每次把天聊死之后，都能很自然地换一个新的话题。”我第一次知道这也算技能。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "客气一下", category: "冷笑话", answer: "客气一下", explain: "去朋友家吃饭，他妈妈说：“粗茶淡饭，别嫌弃。”我一看八菜一汤，赶紧说：“阿姨您太客气了。”她说：“不是客气，后面还有六个菜没上。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "体重秘密", category: "冷笑话", answer: "体重秘密", explain: "朋友问我体重多少。我说：“这是隐私。”他说：“那你至少告诉我范围。”我说：“在秤能承受的范围内。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "闹钟关系", category: "冷笑话", answer: "闹钟关系", explain: "我设置了六个闹钟，朋友问是不是怕起不来。我说：“不是，我想给自己六次重新选择人生的机会。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "回头客", category: "冷笑话", answer: "回头客", explain: "饭店老板说：“我们这儿回头客特别多。”我问是不是味道好。他指了指门口：“主要是很多人走出去才发现伞忘拿了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "买菜砍价", category: "冷笑话", answer: "买菜砍价", explain: "我问老板：“便宜点吧。”老板说：“已经最低了。”我说：“那再低一点。”老板想了想，把菜篮放到地上：“现在够低了吗？”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "天气太热", category: "冷笑话", answer: "天气太热", explain: "朋友说今天热得不想动。我说：“那你昨天为什么也不动？”他说：“昨天是在为今天提前适应。”我问他明天如果降温呢，他说：“那就开始恢复性休息。”看来天气只是理由，休息才是长期规划。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "勤俭持家", category: "冷笑话", answer: "勤俭持家", explain: "老王说自己特别勤俭持家。我问他怎么体现。他说：“家里所有想买贵东西的人，我都劝她们再想想。”我问：“包括你自己吗？”他沉默了。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "口味清淡", category: "冷笑话", answer: "口味清淡", explain: "朋友说自己吃得很清淡。我看他往面里加第三勺辣椒：“这叫清淡？”他说：“汤还是透明的。”我问那辣椒算什么，他说：“配色。”这顿饭的清淡主要体现在语言描述上。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "一视同仁", category: "冷笑话", answer: "一视同仁", explain: "老板说：“我们对所有员工一视同仁。”员工问：“那为什么老张能早退？”老板说：“因为他今天请假。”确实一视同仁，条件不同而已。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "学习计划", category: "冷笑话", answer: "学习计划", explain: "小明给自己列了学习计划：第一天制定计划，第二天优化计划，第三天重新制定更科学的计划。一个星期后计划已经非常完善，学习还没开始。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "有氧运动", category: "冷笑话", answer: "有氧运动", explain: "朋友说他每天都做有氧运动。我问跑步还是游泳。他说：“叹气。”我说这也算？他说：“每次叹完都要重新吸一大口氧。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "生活仪式感", category: "冷笑话", answer: "生活仪式感", explain: "朋友说生活需要仪式感，于是泡面时先摆好餐垫、餐具和小花瓶。我问：“有必要吗？”他说：“味道不一定升级，但心情要先摆盘。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "社交距离", category: "冷笑话", answer: "社交距离", explain: "同事说自己很注重社交距离。我看他午休一个人坐最角落：“这么讲究？”他说：“不是，我旁边没人愿意坐。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "绝不熬夜", category: "冷笑话", answer: "绝不熬夜", explain: "朋友发誓以后绝不熬夜。我凌晨一点看到他还在线，问怎么回事。他说：“我已经决定不睡了，这样就不算熬夜。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "学霸秘诀", category: "冷笑话", answer: "学霸秘诀", explain: "我问学霸：“考试前紧张吗？”他说：“不紧张。”我问秘诀。他说：“不会的题紧张也不会，会的题不紧张也会。”我觉得有道理，但分数并没有因此上涨。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "聪明购物", category: "冷笑话", answer: "聪明购物", explain: "朋友买东西只挑“限时优惠”。我问是不是省很多。他说：“不一定，但看到倒计时就有一种自己正在做重大决策的感觉。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "不浪费食物", category: "冷笑话", answer: "不浪费食物", explain: "妈妈教育我不要浪费食物。我认真点头，把剩下的半碗饭吃完。妈妈满意地问：“懂了吗？”我说：“懂了，下次一开始就少盛一点。”她沉默了一会儿，觉得也对。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "开窗通风", category: "冷笑话", answer: "开窗通风", explain: "朋友感冒了，医生让他多开窗通风。第二天他说更严重了。我问为什么。他说：“昨晚零下五度，我通了一整晚。”医生说的是空气，他执行成了耐寒训练。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "贵有贵的道理", category: "冷笑话", answer: "贵有贵的道理", explain: "商场里一件衣服特别贵，朋友说：“贵有贵的道理。”我问什么道理。他看了半天吊牌：“道理可能印在价格里，我没看懂。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "友谊考验", category: "冷笑话", answer: "友谊考验", explain: "朋友说：“真正的朋友会在你困难时伸出援手。”我点头：“那你先借我五百。”他说：“我主要负责理论支持。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "作息规律", category: "冷笑话", answer: "作息规律", explain: "同事说自己作息特别规律。我问几点睡。他说：“每天都在该睡的时候没睡，该起的时候没起。”确实规律，而且几十年如一日。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "数学天赋", category: "冷笑话", answer: "数学天赋", explain: "老师问：“一斤棉花和一斤铁哪个重？”小明说：“铁重。”老师摇头。小明不服：“那您让它们分别砸脚上试试。”这孩子把质量问题成功升级成了体验问题。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "遗忘烦恼", category: "冷笑话", answer: "遗忘烦恼", explain: "朋友说自己有个优点：不记仇。我问：“真的？”他说：“当然，我连昨天谁惹我都忘了。”我刚夸他豁达，他又补了一句：“但名字我写在本子上了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "早到十分钟", category: "冷笑话", answer: "早到十分钟", explain: "领导要求大家提前十分钟到公司。第二天老王提前十分钟坐在楼下长椅上。领导问为什么不上楼，他说：“我提前到了，至于上班，还是按原时间。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "懂得变通", category: "冷笑话", answer: "懂得变通", explain: "朋友说做人要懂得变通。后来下雨了，我让他撑伞，他说：“我没有伞。”我说：“那怎么办？”他迅速站到别人伞下面：“你看，这就叫变通。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "节约时间", category: "冷笑话", answer: "节约时间", explain: "同事为了节约时间，中午边吃饭边工作。结果文件弄错，下午重做两小时。他总结：“虽然没节约成功，但至少目标很明确。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "好客", category: "冷笑话", answer: "好客", explain: "朋友第一次来我家，我说：“别客气，当自己家。”他点点头，脱鞋、躺沙发、问冰箱里有什么。我赶紧补充：“礼貌上当自己家，不是真当。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "情绪稳定", category: "冷笑话", answer: "情绪稳定", explain: "朋友夸我情绪稳定。我说：“当然，开心时笑，难过时哭，生气时不说话。”他说：“那很正常啊。”我说：“对，稳定地正常。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "认真减肥", category: "冷笑话", answer: "认真减肥", explain: "我决定晚饭少吃，于是只盛半碗饭。吃完觉得没饱，又盛了半碗。这样一来，我心理上确实只吃了两次半碗。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "公交让座", category: "冷笑话", answer: "公交让座", explain: "公交上我给一位大爷让座，大爷摆手：“不用，我下一站就下。”我刚坐回去，司机广播：“下一站还有十二分钟。”大爷看了我一眼：“年轻人，你坐吧，我突然觉得站着也挺好。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "方便记账", category: "冷笑话", answer: "方便记账", explain: "朋友说自己开始记账了。我问效果如何。他说：“非常明显，以前是不知道钱去哪了，现在是清清楚楚地看着它去哪了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "压岁钱管理", category: "冷笑话", answer: "压岁钱管理", explain: "小时候妈妈总说：“压岁钱我先帮你保管。”长大后我问那笔钱还在吗。妈妈说：“当然在，已经以饭、衣服、学费等不同形态陪你很多年了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "冰箱减肥法", category: "冷笑话", answer: "冰箱减肥法", explain: "朋友说减肥第一步是把零食都放远一点。他把薯片塞进冰箱最上层。我问：“这就有效？”他说：“有，我每次拿之前至少得踮一次脚。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "演技", category: "冷笑话", answer: "演技", explain: "同事问我会不会演戏。我说不会。他说：“可你每天开会时那种‘我完全听懂了’的表情很自然。”我承认，原来我早有代表作。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "叫醒服务", category: "冷笑话", answer: "叫醒服务", explain: "酒店前台问我要不要叫醒服务。我说要，早上七点。第二天七点电话准时响起，我迷迷糊糊接起来，对方说：“先生，七点了。”我说：“知道了。”然后继续睡。服务没问题，用户拒绝启动。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "游泳计划", category: "冷笑话", answer: "游泳计划", explain: "朋友办了游泳卡，我问学会了吗。他说：“还没，但已经学会在更衣室里把自己收拾得像会游泳的人了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "菜单选择", category: "冷笑话", answer: "菜单选择", explain: "服务员递来菜单问吃什么，我看了半天说：“随便。”朋友说：“那我点。”我立刻补充：“除了这几个、那几个、还有你刚才看的那个。”随便的范围瞬间变得非常具体。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "熟人优惠", category: "冷笑话", answer: "熟人优惠", explain: "我问店老板：“熟人能便宜点吗？”老板说：“能。”我很高兴：“那我们现在认识了吧？”老板点头：“认识了，下次来算熟人。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "效率达人", category: "冷笑话", answer: "效率达人", explain: "同事总说自己追求效率。午饭时我发现他把甜点先吃了。我问：“不按顺序？”他说：“先完成最期待的部分，这叫项目优先级管理。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "礼貌拒绝", category: "冷笑话", answer: "礼貌拒绝", explain: "朋友问：“周末能帮我搬家吗？”我说：“当然可以拒绝。”他愣了：“你这句话是不是少了两个字？”我说：“没有，我只是把选择权完整表达出来。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "会不会修", category: "冷笑话", answer: "会不会修", explain: "家里椅子坏了，爸爸问我会不会修。我说：“会看教程。”爸爸说：“那会不会修？”我想了想：“教程看完之前，我们谁也不知道。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "早餐健康", category: "冷笑话", answer: "早餐健康", explain: "朋友说早餐一定要营养均衡。他左手油条右手豆浆，很认真地解释：“一边是固体，一边是液体，已经很均衡了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "忍住不买", category: "冷笑话", answer: "忍住不买", explain: "逛街时朋友看中一件衣服，强忍着没买。我夸她自制力强。她说：“不是，我在等店员离远一点，好偷偷看第二次价格。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "人生导师", category: "冷笑话", answer: "人生导师", explain: "同事总喜欢给人建议。我问他自己的人生问题解决了吗。他说：“没有，所以才有空研究你们的。”我说这不矛盾吗？他很坦然：“自己的人生太难，研究别人的比较有成就感。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "退休理想", category: "冷笑话", answer: "退休理想", explain: "朋友问我的人生理想。我说：“退休。”他说：“你才二十多。”我说：“理想当然要有距离感，不然叫近期目标。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "打包剩菜", category: "冷笑话", answer: "打包剩菜", explain: "服务员问剩菜要不要打包。我说：“要。”朋友说：“你不是刚说吃不下了吗？”我说：“现在吃不下，回家看到它就不一定了。”胃也需要换个办公地点。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "身材管理", category: "冷笑话", answer: "身材管理", explain: "朋友说自己开始管理身材了。我问怎么管理。他说：“每天照镜子检查一下，确认身材还在。”我问有没有改善计划，他说：“暂时先做资产盘点。”听起来不像减肥，像年终审计。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "零钱问题", category: "冷笑话", answer: "零钱问题", explain: "买东西时老板问：“有零钱吗？”我说：“有，但我也挺喜欢它们的。”老板叹了口气，还是找开了。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "周末早起", category: "冷笑话", answer: "周末早起", explain: "工作日闹钟响三次我都起不来，周末没有闹钟却六点醒。躺在床上我终于明白，身体不是不会早起，它只是会挑日子跟我作对。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "吃苦", category: "冷笑话", answer: "吃苦", explain: "长辈劝我：“年轻人要能吃苦。”我点了一杯苦咖啡，认真喝完。长辈说不是这个意思。我说：“那您下次说具体点，苦的种类太多了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "排毒", category: "冷笑话", answer: "排毒", explain: "朋友买了杯昂贵果汁，说是“排毒”。我问排什么毒。他说：“不知道，但喝完钱包轻了很多，可能先排的是钱。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "整理房间", category: "冷笑话", answer: "整理房间", explain: "我花了一下午整理房间，把桌上的东西全塞进抽屉。朋友说这不叫整理。我说：“表面整齐也是一种结果导向。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "备用方案", category: "冷笑话", answer: "备用方案", explain: "同事做任何事都有备用方案。我问他迟到怎么办。他说：“第一方案解释堵车，第二方案解释闹钟，第三方案直接请假。”准备确实充分。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "公平分蛋糕", category: "冷笑话", answer: "公平分蛋糕", explain: "两个人分蛋糕，一个负责切，一个负责先选。切的人拿尺子量了三遍。世界和平有时候并不靠信任，而是靠制度设计。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "越来越年轻", category: "冷笑话", answer: "越来越年轻", explain: "阿姨说自己最近越来越年轻。我问怎么看出来的。她说：“以前别人叫阿姨我生气，现在别人叫奶奶我才生气。”标准确实年轻了。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "选择困难", category: "冷笑话", answer: "选择困难", explain: "朋友点饮料纠结半小时。我说：“随便选一个不就行了？”他说：“如果能随便选，我还会在这里纠结吗？”这句话把问题讲得毫无进展但非常准确。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "老板请客", category: "冷笑话", answer: "老板请客", explain: "老板说晚上请大家吃饭，全办公室欢呼。下班前他补充：“公司食堂，刷自己的卡。”原来“请大家吃饭”里的“请”是邀请，不是付款。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "别太客气", category: "冷笑话", answer: "别太客气", explain: "朋友来我家，我说：“想吃什么自己拿，别客气。”他打开冰箱看了五分钟：“你这句话对库存要求有点高。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "睡前喝水", category: "冷笑话", answer: "睡前喝水", explain: "朋友说睡前不能喝太多水，会影响睡眠。我说：“我不怕。”他说：“你不起夜？”我说：“我懒，能忍到早上。”这是意志力还是懒，我至今没分清。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "走路算运动", category: "冷笑话", answer: "走路算运动", explain: "朋友问我今天运动了吗。我说走了一万步。他很惊讶。我补充：“主要是商场找不到出口。”目标虽然偏了，步数倒是完成了。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "旅游攻略", category: "冷笑话", answer: "旅游攻略", explain: "我做旅游攻略特别认真，景点、餐厅、路线全排得很满。真正出发后第一天就睡到中午。后来攻略最大的作用，是让我知道自己错过了多少安排。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "拍照技巧", category: "冷笑话", answer: "拍照技巧", explain: "朋友让我帮他拍得瘦一点。我后退十米拍了一张。他看完说：“是瘦了，但人也快没了。”后来他要求我重新拍一张，我只好往前走五米。照片里的他终于恢复了正常体积，也恢复了不满意。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "停车技术", category: "冷笑话", answer: "停车技术", explain: "朋友说自己停车技术很好。我看他倒了五次才进车位。他解释：“我不是停不进去，我是在给旁边的人展示全过程。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "外卖备注", category: "冷笑话", answer: "外卖备注", explain: "点餐时我备注“不要香菜，谢谢”。送来后满满一盒香菜。我联系客服，对方说：“后厨可能只看到了‘香菜，谢谢’。”从此我懂了，礼貌也要放对位置。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "长寿秘诀", category: "冷笑话", answer: "长寿秘诀", explain: "有人问百岁老人长寿秘诀。老人说：“少和人争论。”那人说：“不可能这么简单。”老人点头：“你说得对。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "不生气", category: "冷笑话", answer: "不生气", explain: "朋友说他最近学会了不生气。我问怎么学的。他说：“生气之前先想想值不值得，想完发现更气，但至少多了一个步骤。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "立刻行动", category: "冷笑话", answer: "立刻行动", explain: "我看了一本书，说“想到就立刻行动”。于是我立刻把书合上去吃夜宵。思想落实得非常迅速，只是方向可能和作者预期不同。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "省事婚礼", category: "冷笑话", answer: "省事婚礼", explain: "朋友结婚前说想办得简单点。我问多简单。他说：“最好我出席一下就行，其他人帮忙完成。”我说这不叫简单，这叫授权。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "借伞", category: "冷笑话", answer: "借伞", explain: "朋友借我伞，叮嘱一定还。我问：“你怕我不还？”他说：“不是，我怕下次下雨的时候想起来你还没还。”这才是真正的风险管理。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "叫外号", category: "冷笑话", answer: "叫外号", explain: "同学给小胖起外号，小胖很生气：“别老拿体型开玩笑。”大家答应了。第二天改叫他“小圆满”。小胖说：“你们是不是只换了包装？”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "练字", category: "冷笑话", answer: "练字", explain: "我决定练字，每天抄一句名言。一个月后字没变好，倒是积累了三十句很适合劝别人的话。朋友说至少没白练。我想想也对，字没进步，道理倒是越来越多，只是不一定轮得到自己用。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "记忆训练", category: "冷笑话", answer: "记忆训练", explain: "朋友买了本《如何提高记忆力》，问我效果如何。我问：“你买过这本？”他说：“对啊。”我说：“你上个月已经问过我同样的问题了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "衣服缩水", category: "冷笑话", answer: "衣服缩水", explain: "我抱怨衣服洗完缩水。妈妈看了我一眼：“有没有可能是你长宽了？”这个回答不科学地伤人，但很难反驳。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "饭后百步", category: "冷笑话", answer: "饭后百步", explain: "朋友牢记“饭后百步走，活到九十九”，每次吃完就去走。我问：“真走一百步？”他说：“差不多，走到沙发那儿就坐下，剩下的明天补。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "心宽体胖", category: "冷笑话", answer: "心宽体胖", explain: "朋友安慰我：“心宽体胖是福气。”我说：“那我这福气是不是太具体地体现在腰围上了？”朋友安慰我说福气多点不好吗。我低头看了看腰带：“福气再多一点，裤子可能先承受不住。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "熟能生巧", category: "冷笑话", answer: "熟能生巧", explain: "老师说：“熟能生巧。”小明问：“那我天天迟到，能生出什么巧？”老师说：“能巧妙地避开早读。”全班笑了，老师自己没笑。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "认真打扫", category: "冷笑话", answer: "认真打扫", explain: "朋友来家里说我收拾得真干净。我谦虚地说：“没有，只是把乱的地方都关上门了。”家居美学里，柜门是一项伟大发明。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "预约挂号", category: "冷笑话", answer: "预约挂号", explain: "我去看医生，前面的人说：“大夫，我最近总觉得自己像透明人。”医生低头看单子：“下一位。”那人更难受了。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "理想体重", category: "冷笑话", answer: "理想体重", explain: "朋友问我的理想体重是多少。我说：“看起来不像需要讨论体重的那个体重。”这是一个没有数字却非常明确的目标。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "自律", category: "冷笑话", answer: "自律", explain: "同事说：“真正自律的人不用别人提醒。”第二天他让我提醒他晚上跑步。我问：“这不是矛盾吗？”他说：“我自律地安排了提醒。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "饭前拍照", category: "冷笑话", answer: "饭前拍照", explain: "朋友每次吃饭都先拍照。我问：“不饿吗？”他说：“饿，但照片比饭保质期长。”等他拍完，饭也差不多进入另一个保质阶段了。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "会看人", category: "冷笑话", answer: "会看人", explain: "朋友说自己特别会看人。我问：“你看我怎么样？”他盯了半天说：“今天气色不错。”我说：“这叫看脸。”他说：“脸也是人重要的一部分。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "做自己", category: "冷笑话", answer: "做自己", explain: "朋友劝我：“别在意别人眼光，做自己。”我第二天上班迟到，他问为什么。我说：“我在做自己。”他说：“做自己也要先打卡。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "有计划地乱", category: "冷笑话", answer: "有计划地乱", explain: "室友说他的桌子不是乱，是“有自己的秩序”。我问他剪刀在哪。他翻了二十分钟：“秩序今天可能休假。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "守时", category: "冷笑话", answer: "守时", explain: "朋友约我三点见面，三点半才来。我说：“你不是最守时吗？”他说：“我一直守着时间，看着它从三点走到三点半。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "擅长沟通", category: "冷笑话", answer: "擅长沟通", explain: "同事简历写“擅长沟通”。开会时别人问意见，他说：“都行。”散会后他跟我讲了四十分钟真正意见。技能确实有，只是选择性上线。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "父母眼里的瘦", category: "冷笑话", answer: "父母眼里的瘦", explain: "在外面别人说我胖，回家我妈说：“哪胖了，没吃饱吧？”我终于明白，母爱不仅有温度，还有自己的计量标准。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "绕口令", category: "冷笑话", answer: "绕口令", explain: "朋友说：“你能一口气说十遍‘红鲤鱼绿鲤鱼’吗？”我说：“不能。”他说：“你都没试。”我说：“我对自己的能力有清醒认识，这也是一种本事。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "买书的快乐", category: "冷笑话", answer: "买书的快乐", explain: "我很喜欢买书，朋友问是不是爱学习。我说：“不是，买书那一刻会有一种知识已经到账的错觉。”真正看书是另一项业务。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "公平竞争", category: "冷笑话", answer: "公平竞争", explain: "朋友和我比赛谁先吃完一碗面。他吃到一半我把筷子放下，说认输。他很得意。后来发现我那碗是他的。竞争有时候输赢不重要，锅里剩什么更重要。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "早饭要吃好", category: "冷笑话", answer: "早饭要吃好", explain: "妈妈说“早饭要吃好”，我认真点了一桌。她看账单后说：“我说的是营养好，不是价格好。”中文里一个“好”字，预算差距可以很大。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "休息一下", category: "冷笑话", answer: "休息一下", explain: "我工作累了说“休息五分钟”，结果一刷短视频过去四十分钟。朋友问我怎么回事。我说：“五分钟是开始时间，不是持续时间。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "成年人的自由", category: "冷笑话", answer: "成年人的自由", explain: "小时候以为长大就能想买什么买什么。长大后发现确实可以，只是在付款之前会先问自己三遍：“真的需要吗？”然后把东西放回去。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "饭局礼貌", category: "冷笑话", answer: "饭局礼貌", explain: "有人夹最后一块肉前问：“有人吃吗？”全桌都说不吃。他刚夹走，旁边的人叹气：“我还以为你就是客气一下。”礼貌和诚实有时只隔一块肉。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "应急能力", category: "冷笑话", answer: "应急能力", explain: "领导问：“遇到突发情况你怎么办？”同事说：“先保持冷静。”领导问：“然后呢？”同事说：“然后找一个比我更懂的人。”这回答朴素得让人无法批评。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "洗澡唱歌", category: "冷笑话", answer: "洗澡唱歌", explain: "朋友洗澡特别爱唱歌。我问是不是热爱音乐。他说：“不是，主要是浴室里没有人能中途离场。”我说邻居能听见。他想了想：“那更好，至少有观众，只是他们没有退票渠道。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "喝热水", category: "冷笑话", answer: "喝热水", explain: "我说嗓子不舒服，朋友递来一杯热水。我问：“热水真能解决一切吗？”他说：“不能，但至少递热水的人不用再想别的办法。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "不浪费时间", category: "冷笑话", answer: "不浪费时间", explain: "朋友说人生苦短，不要浪费时间。说完他躺床上发呆两小时。我问：“这不算浪费？”他说：“这是主动使用，不是被动浪费。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "饭量升级", category: "冷笑话", answer: "饭量升级", explain: "小时候吃两碗饭，家里夸“正在长身体”。长大后吃两碗饭，朋友说“控制一下”。原来碗没变，评价体系变了。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "低成本旅行", category: "冷笑话", answer: "低成本旅行", explain: "朋友说他今年去了很多地方。我很羡慕，问去了哪。他拿出一本地图册，指着上面一圈圈红笔：“这里、这里，还有这里，精神上基本都到了。”我说：“那住宿费省了不少。”他说：“主要是连门都没出。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "免单条件", category: "冷笑话", answer: "免单条件", explain: "餐厅写着“猜中老板年龄即可免单”。我问老板：“您今年十八？”老板笑得很开心：“猜错了，但这顿我给你打九折。”夸人虽然没免单，也算产生经济价值。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "一起努力", category: "冷笑话", answer: "一起努力", explain: "朋友对我说：“新的一年一起努力！”我问：“努力什么？”他说：“先努力把去年没完成的事重新列进今年计划。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "问路高手", category: "冷笑话", answer: "问路高手", explain: "我向路边大爷问：“去火车站怎么走？”大爷指着前面：“一直走，看到一个大十字路口就再问别人。”这是我听过最诚实的分段导航。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "不吃宵夜", category: "冷笑话", answer: "不吃宵夜", explain: "朋友发誓晚上八点以后不吃东西。九点我看到他端着一碗面。他解释：“这是明天的早餐，我只是提前吃。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "借口质量", category: "冷笑话", answer: "借口质量", explain: "老师问：“作业怎么没带？”小明说：“我写完了，但是忘在家里。”老师说：“这个借口太老了。”小明点头：“所以我一直在坚持传统。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "成年礼物", category: "冷笑话", answer: "成年礼物", explain: "小时候生日最期待礼物，长大后朋友问想要什么，我说：“给我一个没人安排事情的下午。”他愣了：“这怎么买？”我说：“所以才珍贵。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "正确废话", category: "冷笑话", answer: "正确废话", explain: "朋友说：“只要你每天进步一点，一年后就会进步很多。”我说：“这句话很有道理。”他又说：“如果每天退步一点，一年后也会退步很多。”我说：“你今天的信息密度很稳定。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "美容觉", category: "冷笑话", answer: "美容觉", explain: "朋友十点就准备睡，说要睡美容觉。我问：“真有效吗？”他说：“至少睡着以后看不到自己的黑眼圈。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "无效运动", category: "冷笑话", answer: "无效运动", explain: "我每天都坚持做深蹲。朋友问一天多少个。我说：“一个，蹲下找东西的时候顺便算上。”朋友说这叫生活动作，我说凡事要善于统计。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "极简生活", category: "冷笑话", answer: "极简生活", explain: "朋友说自己追求极简生活。我去他家一看，东西确实少。我问怎么做到的。他说：“都放父母家了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "赶时间", category: "冷笑话", answer: "赶时间", explain: "我跟朋友说“快点，来不及了”。他立刻跑起来。我问：“你知道去哪吗？”他说：“不知道，但先制造一种很赶时间的气氛。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "咸淡适中", category: "冷笑话", answer: "咸淡适中", explain: "朋友做汤问我咸不咸。我尝了一口说：“咸。”他加水后又问，我说：“淡。”他叹气：“那你到底想怎样？”我说：“我只是如实汇报，不负责配方。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "随缘减肥", category: "冷笑话", answer: "随缘减肥", explain: "朋友说自己减肥主打一个随缘。我问什么意思。他说：“有菜吃菜，有肉吃肉，有蛋糕就先不谈减肥。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "计划赶不上变化", category: "冷笑话", answer: "计划赶不上变化", explain: "我早上列了十项计划，晚上完成一项。朋友安慰我：“计划赶不上变化。”我说：“今天不是变化太快，是我太慢。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "优先级", category: "冷笑话", answer: "优先级", explain: "朋友问：“工作和休息哪个重要？”我说：“工作重要。”他很惊讶。我补充：“因为不工作就没理由说自己需要休息。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "记性不错", category: "冷笑话", answer: "记性不错", explain: "我爸说我小时候记性特别好。我问：“现在呢？”他说：“现在也不错，就是你总忘了自己记性不错。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "不占便宜", category: "冷笑话", answer: "不占便宜", explain: "摊主说：“买三斤送半斤。”我说：“我不占便宜，就买半斤送的那部分。”摊主说：“你不是不占便宜，你是想只占便宜。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "认真洗脸", category: "冷笑话", answer: "认真洗脸", explain: "朋友说他每天早晚都认真洗脸。我问皮肤变好了吗。他说：“不知道，但毛巾越来越有参与感。”我问他有没有换护肤方法。他说暂时没有，“先把脸每天确认一遍，至少不会丢。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "梦想与现实", category: "冷笑话", answer: "梦想与现实", explain: "我小时候梦想当宇航员，后来发现怕高；想当运动员，发现怕累；最后决定当普通人。这个岗位竞争最激烈，但我坚持下来了。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "免费试吃", category: "冷笑话", answer: "免费试吃", explain: "超市有免费试吃，我吃完问工作人员：“还能再试一次吗？”他说：“可以，但第二次就不是试了，是确认。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "合适鞋码", category: "冷笑话", answer: "合适鞋码", explain: "买鞋时店员问：“这双合脚吗？”我走了两步说：“挺合。”他问：“哪里合？”我说：“两只脚都成功放进去了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "喝汤学问", category: "冷笑话", answer: "喝汤学问", explain: "朋友喝汤前吹半天。我问：“怕烫？”他说：“不是，我想让汤先知道我很谨慎。”我说汤又不知道。他很认真：“所以我要通过持续吹气建立沟通。”这碗汤最后凉得非常有安全感。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "早点回家", category: "冷笑话", answer: "早点回家", explain: "妈妈问我：“今天能早点回家吗？”我说：“能。”她问几点。我说：“比明天早。”妈妈决定自己规定具体时间。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "一句鼓励", category: "冷笑话", answer: "一句鼓励", explain: "朋友跑步跑不动，我在旁边喊：“坚持就是胜利！”他停下来问：“那我现在坚持不跑算不算胜利？”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "人生选择题", category: "冷笑话", answer: "人生选择题", explain: "朋友问：“人生如果可以重来，你还会选现在这条路吗？”我说：“先告诉我其他选项和工资。”浪漫问题瞬间变成了职业咨询。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "很会照顾人", category: "冷笑话", answer: "很会照顾人", explain: "同事说自己特别会照顾人。聚餐时我发现他一直给别人夹菜。我正感动，他说：“我只是想把自己不吃的都处理掉。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "周末安排", category: "冷笑话", answer: "周末安排", explain: "朋友问周末安排。我说：“上午休息，下午放松，晚上调整状态。”他问：“那跟躺一天有什么区别？”我说：“听起来更有计划。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "吃饭速度", category: "冷笑话", answer: "吃饭速度", explain: "朋友吃饭特别快。我问是不是饿。他说：“不是，我怕菜凉。”我说：“那慢点也行。”他说：“不，我选择追上温度。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "不怕困难", category: "冷笑话", answer: "不怕困难", explain: "老板问：“遇到困难怕不怕？”员工说：“不怕。”老板很满意。员工补充：“我一般绕开。”老板问那算什么本事。他说：“我不怕它，是因为我根本不跟它正面接触。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "喝水目标", category: "冷笑话", answer: "喝水目标", explain: "朋友给自己定了每天八杯水的目标。晚上我问完成没。他说：“完成了，四杯水，四杯茶，杯数刚好。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "会省事", category: "冷笑话", answer: "会省事", explain: "妈妈让我把房间打扫干净。我把地上的衣服全抱到床上。妈妈问：“这叫打扫？”我说：“至少地面问题已经解决。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "灵活工作", category: "冷笑话", answer: "灵活工作", explain: "同事说自己工作方式很灵活。我看他上午很忙，下午发呆。他解释：“上午把下午该做的提前做了，下午就灵活了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "学会放下", category: "冷笑话", answer: "学会放下", explain: "朋友劝我做人要学会放下。我看了看手里的零食，放到桌上。三秒后又拿起来：“这个道理我暂时理解不了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "压价成功", category: "冷笑话", answer: "压价成功", explain: "我买菜砍价十分钟，老板终于便宜一块钱。回家路上我突然发现，为了省这一块，我多站了十分钟。胜利感和效率感只能选一个。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "站着说话不腰疼", category: "冷笑话", answer: "站着说话不腰疼", explain: "朋友站着劝我：“年轻人别总坐着，对腰不好。”我抬头看他：“你站着说话确实不腰疼。”他听完坐到了我旁边，说：“现在能聊了吗？”我说：“可以，至少我们在同一个疼痛理论水平线上。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "下次一定", category: "冷笑话", answer: "下次一定", explain: "朋友借书半年没还，每次都说“下次一定”。后来我问他到底哪次。他说：“等出现一个不叫‘这次’的下次。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "晚饭少吃", category: "冷笑话", answer: "晚饭少吃", explain: "医生说晚饭少吃点。我把原来的一大碗换成两个小碗。视觉上确实少了，每个碗都不大。朋友说总量没变。我说：“可每次端起来都只有一小碗，心理负担确实减半了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "会安排时间", category: "冷笑话", answer: "会安排时间", explain: "朋友说他特别会安排时间。我问秘诀。他说：“把必须做的排前面，想做的排后面。”我问执行呢？他说：“执行时反过来。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "不给自己压力", category: "冷笑话", answer: "不给自己压力", explain: "朋友说：“别给自己太大压力。”于是我把明天的事推到后天。压力没有消失，只是换了个日期等我。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "爱好广泛", category: "冷笑话", answer: "爱好广泛", explain: "简历上有人写“爱好广泛”。面试官问具体爱好，他说：“吃饭、睡觉、散步、发呆。”面试官点头：“确实覆盖一天大部分时间。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "心态年轻", category: "冷笑话", answer: "心态年轻", explain: "阿姨说自己心态很年轻。我问怎么看出来的。她说：“每次别人叫我姐姐，我都愿意相信。”我问如果有人叫阿姨呢。她说：“听力会暂时变差。”这套青春管理主要依靠选择性接收。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "天气不错", category: "冷笑话", answer: "天气不错", explain: "朋友出门前说：“今天天气不错。”刚走十分钟就下雨。我问他怎么看。他说：“我说的是刚才。”我说这评价保质期也太短了。他撑开伞：“天气和人一样，十分钟足够改变态度。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "好消息坏消息", category: "冷笑话", answer: "好消息坏消息", explain: "医生说：“有一个好消息和一个坏消息。”病人紧张：“先说坏的。”医生说：“你记性可能不太好。”病人问：“那好消息呢？”医生说：“什么好消息？”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "旅行纪念", category: "冷笑话", answer: "旅行纪念", explain: "朋友每次旅行都买纪念品。后来家里堆满小东西。他说：“看见它们就想起旅途。”我说：“也会想起行李超重。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "不用闹钟", category: "冷笑话", answer: "不用闹钟", explain: "朋友说自己已经练到不用闹钟也能准时醒。我问几点醒。他说：“自然醒，时间特别准——每次都在该起床之后。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "理性消费", category: "冷笑话", answer: "理性消费", explain: "我进商场前告诉自己要理性消费。两小时后拎着三袋东西出来。朋友问：“理性呢？”我说：“每一件我都认真想过三秒。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "简历美化", category: "冷笑话", answer: "简历美化", explain: "朋友问我“经常帮家里倒垃圾”怎么写进简历。我说：“负责家庭废弃物转运与终端交付。”他沉默片刻，突然对自己肃然起敬。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "不挑座位", category: "冷笑话", answer: "不挑座位", explain: "朋友说他坐车从不挑座位。我问：“这么随和？”他说：“因为一般轮不到我挑。”他说站着也算一个位置，只是没有编号。我突然觉得他的随和主要来自没有选择权。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "保证新鲜", category: "冷笑话", answer: "保证新鲜", explain: "卖鱼的大叔说：“绝对新鲜。”我问：“有多新鲜？”他拍着鱼：“你再问两句，它可能都嫌你烦。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "别饿着", category: "冷笑话", answer: "别饿着", explain: "妈妈总说：“减肥归减肥，别饿着。”我严格执行：一边减肥，一边保证自己从不饿。结果两个目标里只有后一个完成得特别好。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "会听劝", category: "冷笑话", answer: "会听劝", explain: "朋友劝我少吃甜食，我点头答应。五分钟后我又拿了一块蛋糕。他问：“你不是听劝了吗？”我说：“听了，没说照做。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "劳动最光荣", category: "冷笑话", answer: "劳动最光荣", explain: "老师说：“劳动最光荣。”小明回家把弟弟叫来替自己扫地。妈妈问：“你怎么不劳动？”小明说：“我在创造劳动岗位。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "惜字如金", category: "冷笑话", answer: "惜字如金", explain: "朋友说自己惜字如金。别人发一大段消息，他永远只回“嗯”。我问：“这叫惜字如金？”他说：“金贵的东西当然不能一次花太多。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "手气不错", category: "冷笑话", answer: "手气不错", explain: "朋友抽奖中了“谢谢参与”，还挺开心。我问：“这也算手气不错？”他说：“至少人家谢谢我了，没白来。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "错峰出行", category: "冷笑话", answer: "错峰出行", explain: "朋友说自己喜欢错峰出行。我问怎么错。他说：“大家上班时我睡觉，大家下班时我还在加班。”峰是错开了，快乐也错开了。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "味道合适", category: "冷笑话", answer: "味道合适", explain: "我问厨师：“这个菜辣吗？”他说：“看个人。”我说：“那对你呢？”他说：“我不吃辣，所以不知道。”这回答把风险完整交给了消费者。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "读书破万卷", category: "冷笑话", answer: "读书破万卷", explain: "朋友说“读书破万卷”。我问他读多少了。他说：“书没读破，快递包装倒拆破不少。”我说这不能算读书。他说：“至少‘破’这个字我完成得非常彻底。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "边走边想", category: "冷笑话", answer: "边走边想", explain: "朋友遇到难题喜欢出去走走。我问有用吗。他说：“有，走远以后暂时看不到问题，心情会好一点。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "幸福秘诀", category: "冷笑话", answer: "幸福秘诀", explain: "有人问朋友幸福秘诀。他说：“降低期待。”我问能多低。他想了想：“今天别下雨，饭别太咸，下班别太晚。”这已经是很成熟的愿望清单。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "早睡失败", category: "冷笑话", answer: "早睡失败", explain: "我晚上十点躺下，朋友说：“今天这么早？”我说：“准备早睡。”十二点他又看到我还醒着。我说：“准备工作做得比较久。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "发型重要", category: "冷笑话", answer: "发型重要", explain: "朋友理发回来问我好不好看。我盯了半天说：“很精神。”他说：“那就是不好看？”我说：“我已经用了最安全的形容词。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "不爱占座", category: "冷笑话", answer: "不爱占座", explain: "同事吃饭时从不提前占座。我问：“这么有素质？”他说：“我一般让别人先占，我再坐他们旁边。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "梦想工作", category: "冷笑话", answer: "梦想工作", explain: "朋友问我理想工作是什么。我说：“钱多、事少、离家近。”他说：“还有吗？”我说：“如果能不上班就更接近理想了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "睡眠质量", category: "冷笑话", answer: "睡眠质量", explain: "我问朋友睡眠质量怎么样。他说：“质量很好，就是数量不够。”这大概像一块特别好吃但只有一口的蛋糕。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "预防迟到", category: "冷笑话", answer: "预防迟到", explain: "我为了防止迟到，把闹钟提前半小时。结果醒来一看时间还早，放心睡回去，最后比平时迟到得更有安全感。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "跑步装备", category: "冷笑话", answer: "跑步装备", explain: "朋友买齐跑鞋、运动服、水壶、腰包。我问开始跑了吗。他说：“装备已经到位，身体还在等通知。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "少说多做", category: "冷笑话", answer: "少说多做", explain: "领导强调“少说多做”。同事一整天一句话没说。领导问工作进展，他摊手：“您昨天主要强调了前半句。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "很会养生", category: "冷笑话", answer: "很会养生", explain: "朋友说自己特别会养生，晚上泡脚、喝热水、早睡。我问几点睡。他说：“泡完脚喝完水，通常一点半。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "够朋友", category: "冷笑话", answer: "够朋友", explain: "朋友说：“有福同享，有难同当。”吃饭结账时我看向他。他补充：“账单属于经济问题，不在这句话范围内。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "爱干净", category: "冷笑话", answer: "爱干净", explain: "室友说自己特别爱干净。我看他桌上乱成一团。他说：“我爱的是干净，不代表我拥有它。”我说那你为什么不去拥有一下。他看着桌面：“感情可以单向，爱干净也一样。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "聪明办法", category: "冷笑话", answer: "聪明办法", explain: "朋友告诉我：“解决不了问题，就解决提出问题的人。”我说这听起来很危险。他赶紧解释：“比如有人问今天谁洗碗，我就去洗，这样问题就没人问了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "不做选择", category: "冷笑话", answer: "不做选择", explain: "菜单太长，我让朋友帮我选。他说：“你想吃什么？”我说：“不知道。”他说：“那随便。”我说：“随便又不知道。”我们成功把选择困难升级成团队项目。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "保持距离", category: "冷笑话", answer: "保持距离", explain: "我问朋友怎么跟讨厌的人相处。他说：“保持距离。”我说：“如果是同事呢？”他说：“那就保持礼貌距离。”成熟的人不是没情绪，是会给情绪留工位。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "慢慢来", category: "冷笑话", answer: "慢慢来", explain: "朋友劝我：“凡事慢慢来。”我说：“那工资也慢慢花？”他说：“这个最好快点存。”看来哲学到了钱这里会自动细化。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "很有耐心", category: "冷笑话", answer: "很有耐心", explain: "别人夸我排队很有耐心。我说：“不是，我已经排了这么久，现在走更亏。”沉没成本有时看起来很像美德。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "万事开头难", category: "冷笑话", answer: "万事开头难", explain: "朋友说“万事开头难”，所以他每次遇到新任务都先不开始。他觉得只要不开头，就暂时没有难的部分。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "安全感", category: "冷笑话", answer: "安全感", explain: "朋友说钱包里放现金很有安全感。我问放多少。他说：“二十。”我说这够干嘛。他说：“够我确认钱包没丢。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "不怕输", category: "冷笑话", answer: "不怕输", explain: "朋友下棋总输，却从不沮丧。我问心态怎么这么好。他说：“输习惯以后，每次开局都没有心理负担。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "保持童心", category: "冷笑话", answer: "保持童心", explain: "朋友说人要保持童心。我点了份儿童套餐。他说不是这个意思。我说：“至少我的行动比你的概念具体。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "懂礼貌", category: "冷笑话", answer: "懂礼貌", explain: "小朋友进门没叫人，妈妈提醒：“要有礼貌。”小朋友转身重新出去，再进来大声说：“打扰了，我又进来了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "公平的秤", category: "冷笑话", answer: "公平的秤", explain: "我站上体重秤觉得数字不对，换个方向再站一次。朋友问：“这样有用？”我说：“给它一次重新考虑的机会。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "适可而止", category: "冷笑话", answer: "适可而止", explain: "朋友吃自助餐前说：“一定要适可而止。”两小时后扶墙出来。我问：“止在哪？”他说：“止在走不动的时候。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "状态很好", category: "冷笑话", answer: "状态很好", explain: "朋友问我最近状态怎么样。我说：“挺稳定的。”他说：“看你每天都很累啊。”我说：“对，稳定地累。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "会算账", category: "冷笑话", answer: "会算账", explain: "朋友点餐时算得特别细。我夸他会过日子。他说：“不是，我只是想知道这顿饭到底是谁吃得最贵。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "道理都懂", category: "冷笑话", answer: "道理都懂", explain: "朋友说：“你别想太多。”我说：“道理我都懂。”他说：“那你还想？”我说：“懂道理和停止思考，是两个部门。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "排队买奶茶", category: "冷笑话", answer: "排队买奶茶", explain: "朋友排了四十分钟买奶茶。我问值不值。他喝了一口：“味道一般。”我说那为什么不走？他说：“排到二十分钟时就已经舍不得走了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "朋友圈摄影", category: "冷笑话", answer: "朋友圈摄影", explain: "朋友吃饭前拍十分钟照片。我问：“凉了怎么办？”他说：“照片是热的就行。”我第一次见到把温度优先级交给照片的人。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "走捷径", category: "冷笑话", answer: "走捷径", explain: "朋友说他特别会走捷径。结果我们在小区绕了三圈。我问：“这叫捷径？”他说：“至少每条路都比大路窄。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "抗压能力", category: "冷笑话", answer: "抗压能力", explain: "面试官问：“抗压能力怎么样？”应聘者说：“很好。”面试官问：“怎么证明？”他说：“我房贷还没还完，人还坐这儿。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "临时抱佛脚", category: "冷笑话", answer: "临时抱佛脚", explain: "考试前一晚同学疯狂复习。我问：“平时怎么不看？”他说：“平时离考试远，知识没有紧迫感。”我说知识也不会因为临近考试就跑得更快。他说：“但我会，至少翻书速度快多了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "很会做人", category: "冷笑话", answer: "很会做人", explain: "同事夸老王会做人。我问具体表现。他说：“谁请客他都去，谁借钱他都没空。”确实把人情世故掌握得很有方向。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "饭后甜点", category: "冷笑话", answer: "饭后甜点", explain: "朋友说吃不下了。我问：“那蛋糕呢？”他立刻坐直：“甜点是另一个胃。”我不知道人体结构什么时候新增了这个部门。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "锻炼计划", category: "冷笑话", answer: "锻炼计划", explain: "朋友制定了晨跑计划。我问执行得怎样。他说：“每天早上醒来都会认真考虑一下要不要跑。”考虑环节已经非常稳定。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "记账成果", category: "冷笑话", answer: "记账成果", explain: "我坚持记账一个月，终于知道钱花哪去了。朋友问：“然后呢？”我说：“然后更心疼了。”以前月底只是穷，现在还能精确指出哪顿饭、哪杯饮料参与了这个结果。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "万无一失", category: "冷笑话", answer: "万无一失", explain: "朋友做事特别谨慎，每次出门都检查三遍门锁。我问：“这样就万无一失？”他说：“不，但至少忘了什么时可以更有依据地怀疑自己。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "有缘再见", category: "冷笑话", answer: "有缘再见", explain: "朋友离开时说“有缘再见”。第二天在公司又见面了。我说：“这么有缘？”他说：“不是，公司规定必须来。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "口头减肥", category: "冷笑话", answer: "口头减肥", explain: "朋友每天都说要减肥。我问什么时候开始。他说：“我一直在语言层面坚持。”我说身体层面呢。他沉默几秒：“身体暂时还没收到正式通知。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "生日愿望", category: "冷笑话", answer: "生日愿望", explain: "朋友生日许愿许了很久。我问：“这么多愿望？”他说：“不是，我在考虑哪个愿望比较不浪费一次机会。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "别往心里去", category: "冷笑话", answer: "别往心里去", explain: "朋友安慰我：“别人说什么别往心里去。”我问：“放哪？”他说：“先放耳朵里，过会儿从另一边出去。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "有空运动", category: "冷笑话", answer: "有空运动", explain: "朋友问我什么时候运动。我说：“有空的时候。”他问：“那你什么时候有空？”我说：“运动以外的时间。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "会过日子", category: "冷笑话", answer: "会过日子", explain: "朋友说他特别会过日子。我问秘诀。他说：“贵的东西先不看，省得喜欢上。”这是我听过最直接的消费防控。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "随身带伞", category: "冷笑话", answer: "随身带伞", explain: "朋友一年四季都带伞。我问是不是特别谨慎。他说：“不是，我之前买了把很贵的伞，不带着总觉得亏。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "大度", category: "冷笑话", answer: "大度", explain: "朋友说自己很大度。我问：“别人得罪你怎么办？”他说：“我一般都原谅。”我说：“真好。”他补充：“但我会记下来。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "今天一定", category: "冷笑话", answer: "今天一定", explain: "我对自己说：“今天一定把事情做完。”晚上朋友问做完没有。我说：“‘今天一定’这句话我已经完成了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "生活经验", category: "冷笑话", answer: "生活经验", explain: "妈妈说：“吃一堑长一智。”我问：“那我怎么总在同一个坑里摔？”妈妈说：“说明你对这个坑很忠诚。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "很有主见", category: "冷笑话", answer: "很有主见", explain: "朋友说自己特别有主见。点菜时服务员问吃什么，他转头问我：“你觉得呢？”我问：“主见呢？”他说：“主见决定参考谁。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "以退为进", category: "冷笑话", answer: "以退为进", explain: "朋友下棋总往后退。我问：“这是战术？”他说：“对，以退为进。”我问什么时候进。他说：“等对方不注意。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "心态平和", category: "冷笑话", answer: "心态平和", explain: "朋友说自己现在心态很平和。我问怎么练的。他说：“把所有能让我生气的人都静音了。”我说现实里遇到怎么办。他说：“现实不能静音，所以我尽量少出门。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "朋友很多", category: "冷笑话", answer: "朋友很多", explain: "有人说老王朋友特别多。我问：“多少？”他说：“欠他钱的就有十几个。”社交圈确实很广。我问这些算朋友吗。他说：“至少逢年过节我一发消息，他们都特别紧张。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "健康饮食", category: "冷笑话", answer: "健康饮食", explain: "朋友说最近只吃健康食品。我看他拿着一包饼干。他解释：“我吃的时候心情很健康。”我问饼干哪里健康。他说：“包装上有麦穗，看起来很接近大自然。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "衣柜哲学", category: "冷笑话", answer: "衣柜哲学", explain: "朋友说自己没衣服穿。我看她衣柜塞得满满的。她说：“那些是‘有衣服’，不是‘有今天想穿的衣服’。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "优雅吃面", category: "冷笑话", answer: "优雅吃面", explain: "朋友说吃面要优雅，不能吸得太响。于是他夹起一根面，吹了半天，最后还是掉回碗里。优雅成功了，进食失败了。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "新年目标", category: "冷笑话", answer: "新年目标", explain: "我问朋友今年目标是什么。他说：“把去年的目标完成。”我问去年目标呢？他说：“完成前年的。”传承做得很好。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "购物理智", category: "冷笑话", answer: "购物理智", explain: "朋友买东西前总问自己三个问题：需要吗？常用吗？值得吗？我问有用吗。他说：“有，问完以后买得更有仪式感。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "比昨天好", category: "冷笑话", answer: "比昨天好", explain: "朋友说每天都要比昨天更好。我问今天哪里更好。他想了想：“今天比昨天少说了一句这句话。”我说这进步有点小。他点头：“小没关系，关键是非常容易坚持。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "饮食规律", category: "冷笑话", answer: "饮食规律", explain: "同事说自己饮食很规律。我问：“三餐准时？”他说：“不是，饿了就吃，吃了就不饿，非常规律。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "时间管理大师", category: "冷笑话", answer: "时间管理大师", explain: "朋友给自己安排了八小时睡眠、八小时工作、八小时生活。我问通勤呢。他说：“那属于对计划的现实修正。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "雨天浪漫", category: "冷笑话", answer: "雨天浪漫", explain: "朋友说喜欢雨天，觉得浪漫。真下雨时他站在屋檐下抱怨鞋湿了。我说：“浪漫呢？”他说：“浪漫最好隔着窗户看。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "成熟表现", category: "冷笑话", answer: "成熟表现", explain: "小时候摔倒先看膝盖，长大后摔倒先看周围有没有人。身体疼是一回事，尊严也有自己的急救顺序。如果周围有人，还得再补一个动作：假装只是蹲下系鞋带。成年人连摔跤都讲究善后。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "认真休假", category: "冷笑话", answer: "认真休假", explain: "同事休假前列了很多计划：看书、运动、整理房间。休假结束我问完成多少。他说：“完成了最重要的——休假。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "多吃蔬菜", category: "冷笑话", answer: "多吃蔬菜", explain: "医生让我多吃蔬菜。我点了份薯条。朋友说土豆不算。我说：“它出身是蔬菜啊。”医生说重点不是户籍。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "特别专一", category: "冷笑话", answer: "特别专一", explain: "朋友说自己很专一。我问：“怎么体现？”他说：“每次拖延都拖同一件事，不轻易换目标。”我说这听起来不像优点。他说：“至少拖延对象很稳定，不轻易变心。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "不随便承诺", category: "冷笑话", answer: "不随便承诺", explain: "朋友说他从不随便承诺。我问：“那你能保证吗？”他说：“不能。”确实贯彻得非常彻底。我说那你至少答应明天吃饭吧。他摇头：“明天的胃口，今天不能越权决定。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "不焦虑", category: "冷笑话", answer: "不焦虑", explain: "朋友问我怎么做到不焦虑。我说：“我没做到。”他说：“那你为什么看起来这么平静？”我说：“焦虑累了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "饭前洗手", category: "冷笑话", answer: "饭前洗手", explain: "小朋友吃饭前没洗手，妈妈提醒他。他跑去冲了一下回来。妈妈问：“洗干净了吗？”他说：“水碰过了，剩下看缘分。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "爱读说明书", category: "冷笑话", answer: "爱读说明书", explain: "朋友买东西从来不看说明。我问为什么。他说：“先自己研究，实在不会再看，这样更有探索感。”也更有返工感。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "门口等人", category: "冷笑话", answer: "门口等人", explain: "朋友说五分钟到，我在门口等了二十分钟。他终于出现，说：“你看，我说的是五分钟‘起步’，不是五分钟‘到达’。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "体面", category: "冷笑话", answer: "体面", explain: "朋友摔了一跤，第一反应不是喊疼，而是迅速站起来环顾四周。确定没人看见后，他才开始认真疼。朋友问如果真摔伤怎么办。他说：“那也得先确认有没有熟人，再决定疼到什么程度。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "知足常乐", category: "冷笑话", answer: "知足常乐", explain: "朋友说知足常乐。我问：“那你为什么还想涨工资？”他说：“知足是心态，涨工资是客观需求。”我问这不是贪心吗。他说：“不是，知足负责情绪，涨工资负责生活，两个部门互不干涉。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "努力一点", category: "冷笑话", answer: "努力一点", explain: "老板鼓励员工：“再努力一点。”员工问：“努力到什么程度？”老板说：“达到目标。”员工说：“那目标能不能也努力靠近我一点？”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "不浪费感情", category: "冷笑话", answer: "不浪费感情", explain: "朋友说：“别把感情浪费在不值得的人身上。”我问：“那浪费在零食上行吗？”他说：“至少零食会给你明确反馈。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "方向正确", category: "冷笑话", answer: "方向正确", explain: "朋友走错路后很淡定：“没关系，方向不重要，走起来最重要。”我说：“那我们什么时候到？”他说：“这个问题开始让方向变重要了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "认真道歉", category: "冷笑话", answer: "认真道歉", explain: "朋友迟到后说：“对不起，我真的不是故意的。”我问：“那为什么每次都迟到？”他说：“因为每次都不是故意，属于稳定发挥。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "选择简单", category: "冷笑话", answer: "选择简单", explain: "餐厅菜单有几十道菜，我看得头大。朋友说：“简单，选最贵的。”我问：“这哪里简单？”他说：“至少不用比较太久。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "饭桌诚实", category: "冷笑话", answer: "饭桌诚实", explain: "朋友问我：“这菜是我第一次做，怎么样？”我说：“很有成长空间。”他问：“好吃吗？”我说：“你看，我刚才已经用了最积极的表达。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "有梦想", category: "冷笑话", answer: "有梦想", explain: "朋友说人一定要有梦想。我说：“我有。”他问是什么。我说：“有一天能自然醒，不看时间，也没人催。”他说这梦想很朴素。我说朴素不代表容易。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "自己动手", category: "冷笑话", answer: "自己动手", explain: "妈妈说：“自己的事情自己做。”我点头，把要搬的箱子分成两半，然后分别请两个人帮忙。妈妈说我对“自己做”的理解很有创造性。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "合理消费", category: "冷笑话", answer: "合理消费", explain: "朋友买了件很贵的外套，我问值吗。他说：“只要穿得次数足够多，每次成本就会下降。”我说：“那你准备穿多久？”他说：“穿到它自己回本。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "早到的价值", category: "冷笑话", answer: "早到的价值", explain: "我第一次提前半小时到约会地点，朋友却迟到半小时。我坐了一小时后明白：早到和迟到可以共同创造双倍等待。", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "大人不记小人过", category: "冷笑话", answer: "大人不记小人过", explain: "朋友跟我吵完架说：“大人不记小人过。”我说：“那你是大人还是小人？”他想了想：“这句话突然不方便用了。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "最短距离", category: "冷笑话", answer: "最短距离", explain: "朋友说两点之间直线最短，非要抄近路穿小巷。十分钟后我们迷路。我说：“直线呢？”他说：“理论是直的，巷子不是。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "总结经验", category: "冷笑话", answer: "总结经验", explain: "我做错事后认真总结经验。朋友问：“下次不会再犯了吧？”我说：“至少下次犯的时候，我会更熟练地总结。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "适度消费", category: "冷笑话", answer: "适度消费", explain: "朋友劝我消费要适度。我问：“什么叫适度？”他说：“买完不后悔。”我说：“那我每次都挺适度，我一般是第二天才后悔。”", source: "米环综合内容库 V2", displayMode: "card" },
  { question: "四楼的住户", category: "鬼故事", answer: "四楼的住户", explain: "我刚搬进老公寓时，房东特意说四楼尽头那间屋长期空着，水电都停了。第三晚，我半夜听见上面有拖椅子的声音，第二天便问物业。物业翻出住户表，皱眉说这栋楼没有四楼，电梯从三楼直接到五楼。我回家时特意看了楼梯，三楼上方的转角处，却多了一块掉漆的“4”字门牌。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "没有寄出的明信片", category: "鬼故事", answer: "没有寄出的明信片", explain: "旅行结束后，我在行李夹层里发现一张明信片，背面是我的笔迹：“别坐明天上午九点那班车。”我确定自己没写过。第二天我故意改乘下午的车，途中看到新闻，上午那班车因山体滑坡停运。晚上回酒店，我又在枕头下找到第二张明信片，上面只有一句：“你为什么不听下一张？”", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "相框里的空位", category: "鬼故事", answer: "相框里的空位", explain: "奶奶去世后，家里把她的遗照放在客厅。几天后我发现照片右侧多出一小块空白，像原本有人站在那里被擦掉。之后每过一周，空白都会扩大一点，直到某天整张照片只剩背景。我刚想换一张新的，手机相册里所有奶奶的照片也一起消失了。只有最后一张家庭合照中，她原来的位置上，多了一个模糊的人影，正看着我。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "凌晨两点的理发店", category: "鬼故事", answer: "凌晨两点的理发店", explain: "夜班回家时，我经过一家从未见过的理发店，里面亮着暖黄灯。老板招手问我要不要剪头发，我太累就坐下了。剪完他没收钱，只说：“下次别这么晚回来。”第二天我再经过，那是一间封死多年的空铺。邻居说十年前有个理发师凌晨被害，死前给最后一个客人剪了头发。我摸了摸后颈，发现昨天剪下来的头发又长回了原来的长度。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "候诊室的第七码", category: "鬼故事", answer: "候诊室的第七码", explain: "医院夜里急诊人不多，我拿到号码A106，前面只剩两个人。广播却连续叫A107、A108、A109。护士说系统偶尔跳号，让我等等。半小时后，屏幕终于出现A106，但叫号声音来自走廊尽头已经封闭的旧诊室。我推门前看见墙上的拆迁告示：这间诊室七年前发生火灾，最后一位登记病人的号码正是A106。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "回程票", category: "鬼故事", answer: "回程票", explain: "我在火车站捡到一张旧车票，出发站和目的地正好与我相反，日期却是当天。奇怪的是，乘客姓名栏写着我的名字。我把票交给工作人员，对方看了一眼说那种票早已停用。晚上到家，我在外套口袋里又摸到那张票，背面多了一行手写字：“去程已经完成，别错过回程。”", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "多出来的一把伞", category: "鬼故事", answer: "多出来的一把伞", explain: "公司下班时突然下雨，我们五个人把伞都放在门口晾着。第二天保洁说有六把伞，问哪把不是我们的。多出的那把黑伞很旧，没人认领。下午突然下起大雨，黑伞却不见了。保安调监控，只看到门口五个人依次拿伞离开，最后画面里又有一把伞自己撑开，慢慢移出大门。更奇怪的是，第二天门卫桌上多了一张已经发霉的访客证，照片上的人正撑着那把黑伞。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "夜里的自习室", category: "鬼故事", answer: "夜里的自习室", explain: "考研期间我常在教学楼待到闭馆。某晚十一点，我发现三楼一间自习室还亮着灯，里面坐满学生，却没有翻书声。我以为是集体备考，推门进去后所有人同时抬头，桌上摊开的全是同一本旧校刊。保安后来告诉我，那间教室十年前就封了。那期校刊最后一页，是当年火灾遇难学生名单，我的名字被人用红笔添在了最下面。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "倒着走的钟", category: "鬼故事", answer: "倒着走的钟", explain: "外公留下的座钟一直很准，直到搬到我家后，每逢凌晨一点就开始倒走。起初只倒几分钟，后来倒得越来越久。某晚我盯着它从1:00退到0:17，客厅里忽然出现小时候的家具，连墙纸都变回旧样子。钟继续倒，我听见已经去世多年的外公在厨房喊我的乳名。我慌忙拨正指针，屋子恢复了。第二天座钟停在0:16，再也没有动过。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "第二个门牌", category: "鬼故事", answer: "第二个门牌", explain: "我住602，隔壁是604，中间从来没有603。某晚回家时，走廊中间突然多了一扇门，上面写着603。门缝里传出电视声和饭菜香，我忍不住敲了两下。里面有人问：“谁？”声音竟和我一模一样。我没敢回答，转身回602。第二天603消失了，但我家门牌变成了603，而隔壁邻居坚持说这里从来没有602。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "旧电影院的最后一排", category: "鬼故事", answer: "旧电影院的最后一排", explain: "朋友送我一张老电影院的纪念票，我晚上去看复映。最后一排只有我一个人，可影片开始后旁边座椅总会轻轻下沉。我换了位置，那股重量也跟着换。散场开灯时，工作人员看见我的票脸色变了：这张票属于二十年前最后一场放映，当时最后一排发生坍塌，唯一没找到遗体的观众座位号，正是我手里的号码。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "被借走的名字", category: "鬼故事", answer: "被借走的名字", explain: "村里老人说，晚上听到有人在屋外叫全名不要答应。我一直不信。回老家那晚，院外有人连续叫了三次我的名字，声音像母亲。我没出声。第二天母亲问我为什么半夜在窗外喊她。我说我一直在房里。她愣住，低声说：“可昨晚那个声音叫的是我的名字，用的是你的声音。”", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "雨夜的出租车", category: "鬼故事", answer: "雨夜的出租车", explain: "大雨里我拦到一辆旧出租车，司机一路沉默，只在后视镜里看我。快到家时他说：“你住这里很多年了吧？”我点头。他忽然说：“十年前我也送过你一次。”我笑他认错人，因为十年前我还在外地。司机没解释，只递给我一张泛黄的失物登记单，上面写着十年前有人把“儿童红色雨鞋一双”落在车里，联系人姓名正是我母亲。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "空房里的体温", category: "鬼故事", answer: "空房里的体温", explain: "宾馆前台说隔壁房正在装修，不会有人住。半夜我却听见隔壁有人咳嗽，还不断拖动椅子。打电话投诉后，经理带人打开隔壁，里面只有水泥地和裸墙。正要离开时，维修工手里的测温仪突然报警：房间中央有一块人体大小的区域，温度正从36度慢慢下降。离开前，测温仪又在门口捕捉到第二块热源，温度正好36.5度，像有什么东西刚走到我们身后。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "回家的鞋印", category: "鬼故事", answer: "回家的鞋印", explain: "雪夜回家时，我发现门口有一排湿鞋印，从楼梯一路进了我的客厅。屋里没有人，门锁也没有破坏。我顺着鞋印走到卧室，发现它们停在床边。第二天早上鞋印消失了，我松了口气。直到穿鞋出门时才发现，自己的鞋底全是湿泥，而昨晚我回家前明明换过一双干净的新鞋。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "老井里的回声", category: "鬼故事", answer: "老井里的回声", explain: "小时候村里有口封死的井，老人不让孩子靠近。多年后我回去，井盖已经裂开。我对着缝隙喊了一声名字，下面很久没有回音。正准备走时，井里传来一个小孩的声音，也喊了我的名字。那声音和我小时候一模一样。第二天叔叔告诉我，我五岁时曾经掉进过那口井，可被救上来后我坚持说“井底还有一个我”。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "午夜校车", category: "鬼故事", answer: "午夜校车", explain: "加班回家，我在学校门口看见一辆黄色校车停着。司机问我要不要搭一程，说正好经过我住的小区。我上车后发现座位上全是空书包，没有孩子。行驶十分钟，司机突然问：“你是家长还是学生？”我说都不是。他脸色一变，猛踩刹车让我下车。第二天新闻里提到，这辆校车的车牌属于十二年前失事的一辆车，而事故名单上没有成年人乘客。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "墙后的房间", category: "鬼故事", answer: "墙后的房间", explain: "租房时我总觉得卧室比户型图小一点。搬家具时，衣柜后面传来空洞回声。我请人拆开一块薄墙板，后面竟藏着一间没有门窗的小房间，只有一把椅子和一张桌子。桌上放着一本日记，最后几页记录的全是我过去一个月每天几点出门、几点回家。最后一行写着：“明天他会发现这里。”", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "不亮的路灯", category: "鬼故事", answer: "不亮的路灯", explain: "小区里有盏路灯坏了很久，每次经过那段黑暗，我都觉得身后多了脚步声。一天我故意停下，脚步也停；我转身，什么都没有。第二天物业修好了灯，我终于安心。可当晚走到那里时，所有灯都亮着，只有我的影子没有出现在地上。身后却多了一道影子，正做着与我完全不同的动作。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "海边的第十三间木屋", category: "鬼故事", answer: "海边的第十三间木屋", explain: "海边度假村只有十二间木屋，我订的是11号。半夜散步回来时，12号后面多了一间写着13号的小屋，门开着，里面传出收音机声。我站在门口看了一眼，墙上挂着一张合照，照片里有十几名游客，其中一个就是我。第二天13号屋消失，工作人员翻旧档案说，二十年前海啸冲走过一批游客，合影从未找到。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "只差一分钟", category: "鬼故事", answer: "只差一分钟", explain: "我每天凌晨都会被楼上拖椅子的声音吵醒，时间永远是2:16。投诉几次无果后，我搬上去敲门，才知道那套房一直没人住。物业查监控发现，每晚2:15我都会从自己家出来，走上楼梯，2:17又回房。只有2:16那一分钟，所有摄像头都会同时雪花。可我对出门毫无记忆。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "借宿的老人", category: "鬼故事", answer: "借宿的老人", explain: "暴雪封路，我在山里一户老人家借宿。老人给我热汤，却反复叮嘱夜里不要开后门。凌晨我听见后门有人敲，声音正是老人：“快开门，我忘带钥匙了。”我回头一看，客厅里的老人还坐在火炉旁，背对着我。炉火映在墙上，却只有我的影子，没有他的。天亮后我才发现，火炉旁一直摆着两只茶杯，其中一只杯沿有刚喝过的水痕。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "旧书里的地址", category: "鬼故事", answer: "旧书里的地址", explain: "我在二手书店买了一本绝版小说，扉页写着一个地址，正好是我小时候住过的老房子。翻到中间夹着一张便签：“如果你看到这里，别翻最后一页。”我当然还是翻了。最后一页没有正文，只有一张泛黄照片，拍的是小时候的我坐在老房子窗前，身后站着一个看不清脸的人，而我从未见过这张照片。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "无人看守的收费站", category: "鬼故事", answer: "无人看守的收费站", explain: "深夜自驾经过一条旧国道，前方突然出现收费站，窗口里坐着戴帽子的工作人员。他收了钱，只说：“前面第三个路口别停。”开出十公里后我才想起，这条公路早已取消收费。第二天我查旧新闻，那座收费站十五年前发生过事故，值夜班的收费员去世。事故地点恰好在第三个路口。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "被涂掉的名字", category: "鬼故事", answer: "被涂掉的名字", explain: "学校旧档案室有一本历届毕业生名册，我无意中发现父亲年轻时那一届，很多名字都还清晰，只有父亲的名字被黑墨完全涂掉。我问他原因，他沉默很久，说自己那年根本没有毕业，因为高三时出了事故。可我再看名册，黑墨旁慢慢渗出另一行小字：“不是他活下来的。”", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "十二点后的菜市场", category: "鬼故事", answer: "十二点后的菜市场", explain: "老城区有条菜市场，白天很热闹。一次夜里十二点多，我抄近路经过，发现摊位竟全开着，摊主们低头卖菜，却没人说话。我买了一个苹果，摊主只看着我不收钱。第二天我拿苹果给邻居看，老人脸色发白，说这片市场三十年前就搬迁了。我低头时，手里的苹果已经干瘪发黑，像放了几十年。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "桥上的乘客", category: "鬼故事", answer: "桥上的乘客", explain: "末班公交过桥时，司机突然靠边停车，打开后门。车上明明只有我一个乘客，却有人踩着台阶上车，空座位随即轻轻下陷。司机一句话不说，继续开。下车时我问他刚才是谁，他只说：“这座桥以前有个站，后来事故多就撤了。可有些乘客不知道。”我下车后回头看，空座位上留下了一小片湿水印，像有人刚从雨里坐过。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "照片里的人越来越近", category: "鬼故事", answer: "照片里的人越来越近", explain: "我买了台老式拍立得相机，第一张拍客厅时，角落里多了个模糊人影。我以为胶片问题，第二天又拍一张，人影站到了沙发旁。第三张，它已经在我身后。那晚我把相机扔掉。第二天垃圾桶里却多出一张新的照片，画面是我熟睡的脸，人影的位置已经看不见了，因为拍摄距离太近。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "祖屋的空床", category: "鬼故事", answer: "祖屋的空床", explain: "老家祖屋有一张从没人睡的木床，奶奶说那是“留给没回来的人”。她去世后我们准备拆房，工人把床搬开，下面竟压着一双崭新的布鞋，鞋底还有湿泥。叔叔看到后脸色惨白，说那尺寸和他哥哥失踪那年穿的一样。当天夜里，空房里第一次传出了床板翻身的声音。我们最终没拆那张床，第二年回来时，床边多了一双比旧布鞋更小的新鞋。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "广播里的名字", category: "鬼故事", answer: "广播里的名字", explain: "高中宿舍熄灯后，校园广播偶尔会突然响起一个女声，逐个念学生名字。学长说听见自己名字千万别答应。某晚它念到我，我紧张得不敢出声。广播停了很久，忽然又说：“没人回答，那就按缺席处理。”第二天早操点名时，班主任翻遍花名册，疑惑地问同学们：“你们班以前有这个人吗？”然后指向了我的座位。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "雪山上的红衣人", category: "鬼故事", answer: "雪山上的红衣人", explain: "登山队在雪坡上总能看到一个穿红衣的人，距离我们大约两百米，无论快走慢走都保持不变。向导说别追。傍晚扎营时红衣人消失了，大家才松气。夜里我起来上厕所，发现营地外多了一顶红色帐篷。第二天向导脸色发白：这条线路十年前有位失踪登山者，最后穿的正是红色冲锋衣，而他的帐篷从未找到。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "旅馆里的旧电话", category: "鬼故事", answer: "旅馆里的旧电话", explain: "乡镇旅馆房间有一部不能拨号的老电话。凌晨三点它突然响，我接起后听见一个女人急促地说：“快离开305，天花板要塌。”我住的正是305。我慌忙冲到走廊，几秒后房内真的传来巨响。前台上楼后却盯着那部电话发愣，说这栋楼十年前改造时电话线路就全部拆了。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "只卖一张票的戏院", category: "鬼故事", answer: "只卖一张票的戏院", explain: "小城有家老戏院复业，我去买票时售票员只给我一张，整场却坐满了人。奇怪的是，观众都穿着旧式衣服，演出结束也没人鼓掌。我走出门再回头，戏院铁门上贴着封条。附近老人说那里四十年前发生火灾，从此停业。我手里的票根日期，正是火灾那一天。离开时我发现票根背面印着一句极小的字：‘本场观众人数，一人。’", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "河岸的脚印", category: "鬼故事", answer: "河岸的脚印", explain: "清晨我沿河跑步，看见一串赤脚印从水里走上岸，穿过草地，最后停在一棵树前。树下什么也没有。第二天脚印又出现，这次比前一天多走了十几米。连续一周后，它们终于走到我家楼下。第八天清晨，我打开门，地垫上有一双湿脚印，方向朝屋里。我那天没有回头去看床边，因为湿脚印到那里之后，多出了一对朝向我枕头的脚尖。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "少一个人的合影", category: "鬼故事", answer: "少一个人的合影", explain: "公司团建拍了一张十五人合照，洗出来却只有十四个人。大家数了半天，发现少的是站最边上的新同事。可当我们去找他时，人事说公司从来没有这个名字。更奇怪的是，我们每个人都清楚记得他一起吃饭、坐车、聊天。第二天合照又少了一个人，而这一次，大家已经想不起少的是谁。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "十年前的早餐", category: "鬼故事", answer: "十年前的早餐", explain: "我住进一家老民宿，老板早晨端来豆浆和包子，说是“老规矩”。吃完我看到墙上挂着一张十年前的新闻剪报：这家民宿曾因煤气事故关闭，老板夫妇当场死亡。照片里的老板正是刚给我送早餐的人。我冲下楼，前台空无一人，桌上只有一本登记簿，我的名字写在十年前事故当天的住客名单最后一行。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "不会停的电梯", category: "鬼故事", answer: "不会停的电梯", explain: "办公楼电梯晚上总在17层停一下，可公司只租到16层。我加班时独自乘梯，门果然在17层打开。外面是一条昏暗走廊，墙上挂着我们公司的旧标志。我没出去，门快关时看见尽头会议室里坐着一群人，其中有人抬头，竟是年轻十岁的老板。第二天我问17层是什么，物业说那层十年前装修时曾发生火灾，之后一直封闭。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "海雾里的灯塔", category: "鬼故事", answer: "海雾里的灯塔", explain: "渔村老人说，浓雾夜如果看见海上有两座灯塔，千万别朝第二座开。一次返航时雾特别大，我果然看见两束灯光。同行新人觉得第二束更近，执意调整方向。开了十分钟，海面突然平静得像玻璃，所有仪表都失灵。远处灯塔下站着很多人影。船长猛地掉头，第二束光瞬间消失。第二天我们才知道，那方向根本没有岛。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "最后一趟缆车", category: "鬼故事", answer: "最后一趟缆车", explain: "山景区闭园前，我赶上最后一趟缆车。对面车厢里坐着一个穿旧制服的人，一路盯着我。到站后工作人员问我为什么坐了停运线路，我说刚才明明有人值班。对方脸色变了，带我看墙上的纪念照片：十五年前缆车事故中去世的操作员，就是刚才对面那个人。照片旁写着一句“最后一次值班仍坚持送完最后一名游客”。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "楼道里的婴儿车", category: "鬼故事", answer: "楼道里的婴儿车", explain: "新小区走廊里每天夜里都会出现一辆空婴儿车，早上又消失。住户以为是谁乱放，装了监控。录像里车子凌晨一点从消防门后自己滑出来，在每户门前停几秒，最后停在我家。那晚我没敢开门。第二天物业查户型图才发现，消防门后不是楼梯，而是一面承重墙。监控最后一帧里，婴儿车遮阳棚自己缓缓掀开，里面似乎坐着一个模糊的小影子。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "不会融化的雪人", category: "鬼故事", answer: "不会融化的雪人", explain: "小区孩子堆了个雪人，几天升温后周围积雪全化了，只有它还完好。保安觉得奇怪，晚上把它推倒，里面露出一件旧校服。第二天警方来调查，却只找到几块普通石头。更怪的是，当晚雪人又出现在原处，比之前高了一点，脖子上围着保安昨天戴过的围巾。保安第二天没来上班，他说夜里有人在窗外轻轻问他：“围巾还暖吗？”", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "纸上的脚步", category: "鬼故事", answer: "纸上的脚步", explain: "旧宅地板每晚都有脚步声，从门口走到书桌前。我铺了一层白纸想看脚印。夜里声音照常响起，第二天纸上没有任何脚印，却多了一行一行的字，像有人边走边写：“第一步，回来。第二步，找门。第三步，找到你。”最后一句正停在我的枕头旁。我把那些纸全部烧掉，灰烬里却留下三个完整字：‘第四步。’", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "墙上的身高线", category: "鬼故事", answer: "墙上的身高线", explain: "租来的老房子墙上有一排孩子量身高的刻痕，年份从1998到2005。奇怪的是，最高那条旁边写着我的名字。房东说前租客没有孩子。半夜我听见墙边有铅笔划动声，第二天多了一条新刻痕，年份是今天，位置比我当前身高高出十厘米。第二晚新的刻痕又高了一厘米，像墙上的那个‘我’还在继续长大。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "废站台", category: "鬼故事", answer: "废站台", explain: "列车临时停在一个没有站名的旧站台，广播要求所有人留在车内。我透过窗看见站台上站满背对列车的人。几分钟后，有一个人转过身，竟和我长得一模一样。他抬手指向车门。车门没有打开，列车很快启动。回到正常线路后，我发现座位下多了一张车票，乘客姓名是我，终点站写着刚才那个无名站。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "凌晨的药店", category: "鬼故事", answer: "凌晨的药店", explain: "母亲半夜发烧，我下楼找药，街角居然有家从没见过的药店亮着灯。店员给我药却不收钱，只说：“这次赶上了。”第二天母亲退烧，我想去道谢，却发现那里是一堵旧墙。邻居说二十年前这里确实有药店，老板曾在夜里救过一个高烧的孩子，可自己随后突发心脏病去世。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "门缝里的光", category: "鬼故事", answer: "门缝里的光", explain: "我住的地下室没有邻居，可墙角每天凌晨都会透出一条暖黄色门缝光。我以为是外面路灯反射，后来贴近才听见里面有人吃饭、说笑。某晚光缝忽然变宽，我从缝里看到一间旧客厅，一家人正围桌吃饭。桌边空着一把椅子，椅背上挂着我的外套。第二天墙面重新刷白，可到了凌晨，那条光仍从同一个位置慢慢亮起。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "看不见的房客", category: "鬼故事", answer: "看不见的房客", explain: "合租屋里总有人半夜使用厨房，锅碗会被移动，冰箱里的食物也会少。我们三个都以为是彼此，便在群里约定夜里不进厨房。第二天早上桌上多了第四副碗筷，还有一张纸条：“谢谢你们终于给我留位置。”房东看见纸条后，立即退了押金让我们搬走，却不肯解释原因。第二天清晨第四副碗筷不见了，取而代之的是浴室里一条还在滴水的陌生毛巾。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "墓园里的风铃", category: "鬼故事", answer: "墓园里的风铃", explain: "扫墓时我发现旁边一座无名墓碑挂着一串风铃，周围完全没风，它却一直响。回去后那声音像跟着我，晚上总从阳台传来。第三天我在阳台花盆里找到同样一串风铃，上面多了一块木牌，刻着我家的门牌号。再去墓园时，无名碑已经有了名字——不是我的，却是我刚出生的侄子。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "借来的外套", category: "鬼故事", answer: "借来的外套", explain: "下雨天我在单位衣帽架拿错一件黑外套，穿回家才发现口袋里有一把老式钥匙和一张医院收据。第二天我把衣服带回去，却没人认领。行政说那款工服十年前就停用了。收据上的患者姓名是曾在这里工作的老员工，而收据日期，正是他失踪前一天。当天晚上，那把钥匙自己出现在我办公桌抽屉里。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "只亮一格的楼层灯", category: "鬼故事", answer: "只亮一格的楼层灯", explain: "老小区楼梯灯坏了，只有五楼那盏每晚亮着。五楼住户却早搬空。我半夜回家时看到一个人站在灯下，背对着我。我走近一步，灯就灭一层，像那人正往上走。等我到自家七楼，最后一盏灯熄灭，门内却传来钥匙转动声。可钥匙明明还握在我手里。我开门后屋里没人，唯独门口鞋柜上多了一双沾灰的旧皮鞋。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "失物招领处", category: "鬼故事", answer: "失物招领处", explain: "车站失物招领处下班前只剩我值班。九点多，一个老人来问有没有捡到黑色手提包。我查了登记，没有。他却指着柜子最里面说：“就在那里。”我取下来，发现包上挂着十年前的失物牌，领取人姓名正是老人。抬头时窗口外已经没人。第二天同事看见登记表脸色一变，说十年前来认这个包的人，在回家途中就去世了。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "总少一层的楼梯", category: "鬼故事", answer: "总少一层的楼梯", explain: "我住九楼，停电时只能走楼梯。第一次从一楼数到家，我只走了八层；第二次认真数，还是八层。我怀疑楼层标牌有问题，白天重新数却正常。第三晚停电，我故意在每个平台做记号，走到第八个平台时门牌已经是9楼。可往下看，下面不是八层楼梯，而是一片黑得看不到底的楼梯井，远处还有人在继续往上数数。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "雨衣", category: "鬼故事", answer: "雨衣", explain: "连续几天大雨，楼下衣架上总挂着一件黄色儿童雨衣。没人认领，物业便收进储物间。第二天雨衣又回到原处，而且滴着水。保安调监控，只看到凌晨门自己打开，雨衣像被什么撑起来一样晃进大厅。老人说这栋楼建成前是条河，二十多年前曾有个孩子在暴雨里失踪，最后只找到一件黄色雨衣。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "停在门外的钟声", category: "鬼故事", answer: "停在门外的钟声", explain: "搬到乡下后，我每晚十二点都会听见院门外有三声钟响。村里根本没有钟楼。第五晚我忍不住开门，外面什么都没有，只有门槛前放着一只生锈的小铜铃。第二天隔壁老人看到它立刻让我扔远，说过去村里送葬时，走在最前面的人会摇这种铃。那晚十二点，钟声没再从门外响，而是从我卧室床下响了三声。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "电影院厕所", category: "鬼故事", answer: "电影院厕所", explain: "老影院散场后我去洗手间，里面只有三个隔间。最里面一直有人轻轻哼歌，我等了很久不见出来。保洁进来时奇怪地问我在等谁，我指向最里面，她却说这里从来只有两个隔间。转头再看，第三扇门真的不见了。可镜子里，原本第三个隔间的位置还清楚映着一扇半开的门，里面有人正从缝里看我。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "旧货市场的镜子", category: "鬼故事", answer: "旧货市场的镜子", explain: "我在旧货市场买了一面雕花镜，摊主提醒晚上不要蒙布。我以为是怕潮。回家第一晚，我睡前顺手盖住镜面，半夜被布摩擦声吵醒。镜子上的布从里面一点点鼓起，像有人在另一侧推。我猛地扯下布，镜中房间空无一人。可现实里，我身后的卧室门已经打开了，而镜子里的门仍然关着。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "第六把椅子", category: "鬼故事", answer: "第六把椅子", explain: "家里聚餐明明只有五个人，奶奶却坚持摆六把椅子。她说别问，吃完再收。饭到一半，第六把椅子突然轻轻向后挪了一点，桌上的空碗里多出半勺汤。所有人都假装没看见。饭后我问父亲，他沉默很久，说奶奶有个哥哥年轻时失踪，每年同一天回家吃饭，只是“不能让他知道我们看得见”。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "没有潮水的脚印", category: "鬼故事", answer: "没有潮水的脚印", explain: "海边退潮后，我看见一串脚印从沙滩深处一直走向海里，方向很奇怪——像有人从岸上倒退着走进水中。第二天同一时间，脚印又出现，但起点离我的民宿近了一些。连续四天后，脚印从民宿门口开始。第五天清晨，我打开房门，屋内地板上也出现了湿脚印，它们从我的床边一路走向海边。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "错号病房", category: "鬼故事", answer: "错号病房", explain: "医院陪护时，护士让我千万别进走廊尽头的312，因为那里在消毒。半夜我听见312里有人喊我父亲的名字。推门后，里面坐着一个年轻版的父亲，正抱着婴儿时期的我。下一秒灯闪了一下，病房空了。第二天我问父亲，他说我出生那年确实住过312，但那家旧医院早拆了，这栋新楼的312其实是储物间。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "公交终点站", category: "鬼故事", answer: "公交终点站", explain: "我睡过站醒来时，公交已经停在一片陌生空地。司机不在，车门却开着。远处站牌写着一个我从没见过的站名，下面贴满泛黄的寻人启事。我下车看了一眼，最上面那张竟是我的照片。正愣神时车门突然关闭，司机从后视镜里出现，冲我大喊：“谁让你下车的？”下一秒整辆车开走，只剩我和那块站牌。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "门后的录像带", category: "鬼故事", answer: "门后的录像带", explain: "整理父母老房子时，我在门后夹层发现一盘没有标签的录像带。找机器播放后，画面拍的是同一套房子，时间似乎是二十年前。镜头一直对着我现在站的位置。录像最后，年轻的母亲走进画面，冲镜头说：“如果你是长大后的他，看完别回头。”我当时站在空房里，身后却传来很轻的一声关门。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "夜班售票员", category: "鬼故事", answer: "夜班售票员", explain: "凌晨火车站只开一个窗口，我排队时前面没人，售票员却一直在和看不见的人对话：“一张单程？还是原来的地方？”轮到我，她抬头看见我后脸色发白，说这个窗口已经停用多年，她只是来清点旧设备。可我明明刚看到她卖票。第二天我在垃圾桶里捡到一张旧车票，出票人姓名就是她，日期是她退休前最后一天。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "会移动的照片墙", category: "鬼故事", answer: "会移动的照片墙", explain: "公司走廊挂着历年团队照片。我发现最早那张合照里，角落站着一个陌生女人。第二周再看，她已经换到中间。后来每张照片里都有她，而且越来越靠近镜头。某天新拍的团队照打印出来，她就站在我旁边。我问摄影师是不是后期加的，他却指着原始照片说：“她当时就站在你身边，你没看见吗？”", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "山村邮差", category: "鬼故事", answer: "山村邮差", explain: "去山村旅游时，我遇到一个背旧邮包的老人，问我是不是住在城里某个地址。我说是。他递给我一封没有邮票的信，说“终于找到你了”。信是爷爷写的，日期在他去世前一天，内容只有一句：“如果邮差找到你，说明我没来得及亲自说。”我抬头想追问，老人已经走进雾里。村民说这里二十年前就没有邮差了。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "废弃水塔", category: "鬼故事", answer: "废弃水塔", explain: "小时候我们总听见废弃水塔里有人唱歌，成年人说是风声。多年后回村，我和朋友爬进去，墙上竟刻满孩子名字，其中几个是我儿时玩伴。最下面新刻了一行，是我的名字和当天日期。我们慌忙离开。第二天朋友打电话问我昨晚为什么一个人又回了水塔。我说没有，他却发来照片：月光下确实有个“我”站在塔顶唱歌。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "只开一夜的花店", category: "鬼故事", answer: "只开一夜的花店", explain: "母亲生日那晚，平时关门的街角忽然开了家花店。老板推荐一束白色小花，说“她会认得”。母亲看到花后当场愣住，说这是外婆年轻时最喜欢的品种，本地早已没有人种。第二天我去找花店，店面却是一间废弃仓库。隔壁老人说几十年前那里确实开过花店，老板正是外婆最好的朋友。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "倒影先走一步", category: "鬼故事", answer: "倒影先走一步", explain: "我在地铁站玻璃前等车，忽然发现倒影中的自己提前转头看向右侧。现实中的我还没动。几秒后右边有人快速跑来，撞翻了旁边的广告架。我躲开后心里发毛。第二天同一时间，倒影又先抬手做了个“别上车”的动作。我犹豫着没上，那班车后来临时故障停在隧道里。第三天，倒影没有出现。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "空白的墓碑", category: "鬼故事", answer: "空白的墓碑", explain: "清明扫墓时，我看到祖坟旁多了一块新墓碑，没有姓名，只有出生日期，竟和我的完全一致。我问家里人，都说没见过。第二年再去，碑上多了死亡年份，但月份和日期仍空着。第三年，月份出现了。家里人仍坚持什么都看不到。直到今年，我站在碑前，看见日期的位置正一点点渗出墨色。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "楼上搬家", category: "鬼故事", answer: "楼上搬家", explain: "我住顶楼，却连续三晚听见楼上拖家具。物业查了楼顶平台，什么都没有。第四晚声音更大，像有人把柜子一件件搬走。第二天早上，我发现天花板上出现一道长方形浅色痕迹，像原本那里摆过一只柜子。更怪的是，我客厅里少了一张旧椅子，而楼顶平台中央，正摆着那张椅子。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "重复的婚礼", category: "鬼故事", answer: "重复的婚礼", explain: "出差住酒店时，楼下宴会厅整晚有人办婚礼。第二天早上我问前台新人是谁，前台说酒店昨晚没有宴席。晚上同一时间，楼下又响起同样的婚礼音乐。我偷偷去看，发现舞台上的新郎新娘还是昨天那对，宾客动作也完全一样。第三晚我在人群中看见了自己，穿着礼服，正坐在离舞台最近的位置。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "储物柜里的雨声", category: "鬼故事", answer: "储物柜里的雨声", explain: "学校体育馆有个长期上锁的储物柜，雨天时里面会传来滴水声。一次我帮老师找器材，误拿钥匙打开它。柜子里面不是墙板，而是一条昏暗走廊，尽头下着大雨。我正想靠近，走廊里有个学生冲我跑来，喊“别关门”。我吓得立刻锁上。第二天老师说，十年前有个学生雨天在体育馆失踪，最后就是在这排柜子附近被看见。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "旧钟表铺", category: "鬼故事", answer: "旧钟表铺", explain: "街角钟表铺老板总在关门前把所有钟调慢一分钟。我问原因，他说“留一点给来不及的人”。后来某晚我路过，店里所有钟突然一起响了。老板脸色大变，把我推出门外。第二天铺子贴了白花，老板昨夜突发疾病去世。奇怪的是，橱窗里那只最大的钟，比标准时间慢一分钟，却仍然在走。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "船上的空床", category: "鬼故事", answer: "船上的空床", explain: "渡轮夜航，我的四人舱只住了三个人。半夜上铺床板不断响，像有人翻身。室友也听见了，却没人敢说。清晨服务员查房，看到空床后脸色不对，说这张床昨晚其实已经售出，乘客上船前在码头突发疾病没能登船。我们收拾行李时，空床枕头上却有一张用过的船票。到港后那张船票被工作人员收走，可当晚它又夹在了我的护照里。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "老人院的窗", category: "鬼故事", answer: "老人院的窗", explain: "去养老院看亲戚时，我发现走廊尽头有扇窗总被厚帘遮住。老人们说别打开。午后我好奇掀开一点，窗外竟不是院子，而是一条老街，行人穿着几十年前的衣服。一个年轻女人突然抬头看我，长得和我奶奶年轻时一模一样。她朝我挥手，嘴型像在说：“你怎么这么快就来了？”", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "课桌里的作业本", category: "鬼故事", answer: "课桌里的作业本", explain: "新学期我分到一张旧课桌，抽屉深处夹着一本发黄作业本，姓名和我完全一样。翻开后题目、笔迹都像我自己写的，只是日期早了二十年。最后一页写着：“今天老师会换座位，不要坐靠窗第三排。”我没当回事。下午真的换座，我被安排到那里。窗外立刻有人轻轻敲了三下玻璃，可教室在五楼。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "陌生的家门", category: "鬼故事", answer: "陌生的家门", explain: "出差一个月回家，我发现门锁、门牌都没变，钥匙也能打开，可屋里家具摆设完全不同。一个陌生家庭惊恐地看着我，说他们在这里住了十年。我报出邻居姓名，他们都说不认识。慌乱中我跑到楼下，整栋楼外观也变了。直到电梯再次打开，里面站着“原本的邻居”，焦急地问我刚才去哪儿了。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "洗衣房的号码", category: "鬼故事", answer: "洗衣房的号码", explain: "公寓公共洗衣房里机器编号从1到8，唯独没有4号。管理员说坏了拆掉了。某晚我下去收衣服，墙角却多了一台标着4的旧机器，里面正缓慢转着一件白衬衫。我拔掉插头，滚筒仍不停。第二天那台机器消失，我自己的白衬衫却少了一件。晚上衣柜里传来滚筒转动般的闷响。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "凌晨的动物园", category: "鬼故事", answer: "凌晨的动物园", explain: "我在动物园做夜间巡逻。凌晨两点，猴山附近传来广播：“请游客不要投喂动物。”园里明明已经清场。我赶过去，看到围栏外站着一排背对我的游客，动作一模一样。灯光闪了一下，他们全不见了，只剩地上散着几十张旧门票。票面年份是二十五年前，而那一年园里曾发生严重踩踏事故。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "关不上的窗", category: "鬼故事", answer: "关不上的窗", explain: "老房卧室窗户每天夜里都会自己打开一条缝，哪怕用插销锁死也一样。我以为木框变形，直到某天用钉子彻底封住。半夜窗外传来轻轻的敲击声，持续很久。第二天钉子都还在，玻璃内侧却出现五个清晰指印，像有人从屋里往外按过。从那以后我不再封窗，只是每晚睡前会确认玻璃上有没有新的内侧指印。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "桥洞下的歌声", category: "鬼故事", answer: "桥洞下的歌声", explain: "跑步时我总经过一座老桥，每到傍晚桥洞下会传来女人唱歌。我以为有人练声，直到一次雨后河水暴涨，桥洞完全被淹，歌声却更清楚。附近老人说几十年前有戏班坐船经过这里翻船，只有唱旦角的女孩没找到遗体。那晚回家，我发现鞋底沾着几片湿漉漉的戏服亮片。第二天那几片亮片已经干了，却怎么也从鞋底撕不下来。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "不会凋谢的花圈", category: "鬼故事", answer: "不会凋谢的花圈", explain: "殡仪馆外有个花圈摆了很久，雨淋日晒都像新的一样。保安嫌碍事，夜里把它扔进垃圾车。第二天花圈又回到原地，挽联上的名字却换成了保安。大家以为恶作剧，赶紧撕掉。三天后保安辞职离开，临走前说他每天夜里都梦见有人问：“名字写错了吗？”保安辞职后，花圈上的名字重新变回空白，像是在等下一个人。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "零号储物柜", category: "鬼故事", answer: "零号储物柜", explain: "车站寄存柜从1号开始，我却在角落看到一个“0号”。柜门没锁，里面放着一只旧皮箱。箱子标签上是我的姓名和当天车次。我吓得关上柜门去找工作人员，回来时0号柜不见了。上车后，我发现行李架上多出那只皮箱。打开后里面只有一张纸：‘你把自己的东西忘在未来了。’", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "没有月亮的照片", category: "鬼故事", answer: "没有月亮的照片", explain: "摄影社去郊外拍满月，所有人相机里都拍到又大又亮的月亮，只有我的照片天空一片黑。我以为设置错误，可下一张更怪：画面里月亮出现在地面上，像一扇白色圆门。第三张，门里站着一个人。第四张，那个人已经走出来了。现实天空中的月亮仍好端端挂着，我却不敢再按快门。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "山洞里的编号", category: "鬼故事", answer: "山洞里的编号", explain: "景区溶洞路线很短，墙上每百米有编号。我走到“800米”后，本该看到出口，却出现“900米”“1000米”。游客越来越少，灯也越来越暗。走到“1600米”时，只剩我一个人。前方墙上写着“欢迎返回入口”，我松了口气，却发现出口外不是景区，而是我小时候住过的老家院子。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "菜摊上的旧硬币", category: "鬼故事", answer: "菜摊上的旧硬币", explain: "早市买菜时，摊主找给我一枚很旧的硬币。我随手放进口袋。回家后父亲看到大惊，说这是他小时候那个年代的硬币，早不能流通。第二天我想去问摊主，却发现那个摊位空着。旁边人说这里十几年没人摆摊，因为以前有位老太太在此去世。更巧的是，父亲小时候经常在她那儿买菜。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "深夜的阅览室", category: "鬼故事", answer: "深夜的阅览室", explain: "图书馆闭馆前我躲在角落看书，不知不觉睡着。醒来已经凌晨，楼里却还有翻书声。我循声找到旧阅览室，里面坐满低头读书的人。管理员巡夜发现我后把我拉走，问我怎么进去的，因为那间阅览室十年前就封了。我回头看玻璃门，里面一个人抬起脸，正是失踪多年的前任管理员。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "舞台下面的掌声", category: "鬼故事", answer: "舞台下面的掌声", explain: "学校礼堂排练时，每当台上没人，舞台下面却会传来几下掌声。老师说可能是木结构热胀冷缩。正式演出那天，节目结束后全场安静了一秒，地板下先响起整齐掌声，随后观众才开始鼓掌。拆修时工人在舞台下发现一排旧座椅，朝向舞台，椅背上落满灰，只有中间几把像刚有人坐过。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "缝纫店的尺子", category: "鬼故事", answer: "缝纫店的尺子", explain: "我去老街改裤脚，店里的老太太量完尺寸说：“和你小时候一样。”我笑她认错人。她从抽屉取出一本旧记录，二十年前同一天竟有一个与我同名的人来改校服，尺寸、住址都和我小时候相符。可我从没来过这个城市。离开时她追出来说：“上次你也说没来过。”母亲后来告诉我，爷爷年轻时确实常在那条老街做衣服，只是那家店早在我出生前就拆了。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "夜班诊所", category: "鬼故事", answer: "夜班诊所", explain: "旅行时胃疼，我在偏僻街区看到一家小诊所还亮着灯。医生给我开了药，叮嘱天亮前别回头看招牌。症状很快缓解，我忍不住还是回头，招牌竟写着“临终关怀”。第二天我再找，那里只有一片空地。附近居民说从前有个老医生夜里免费给人看病，去世后诊所就拆了。我回酒店后发现药袋上没有药名，只有一行小字：‘这次不用留下。’", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "门票上的座位", category: "鬼故事", answer: "门票上的座位", explain: "游乐园检票员看我的票时愣了一下，说这种票是旧版纪念票，不能入园。我坚持说刚从售票机取的。票面却印着二十年前的日期和一个已经拆除的摩天轮项目。更怪的是，背面写着座位号17。我父亲看到票后脸色发白，说二十年前他曾和一个失踪的朋友坐过那座摩天轮，朋友当时坐的就是17号。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "厨房里的第二套餐具", category: "鬼故事", answer: "厨房里的第二套餐具", explain: "独居后我总觉得餐具变少，便每天数一遍：四个碗、四双筷子。某天早上却变成五套，而且第五套明显更旧。我把它扔掉，第二天又出现。第三次扔掉后，我半夜被碗筷碰撞声吵醒。厨房灯亮着，桌上摆好两份饭，一份在我常坐的位置，另一份前面的椅子慢慢被拉开。椅子停稳后，空碗里忽然传来轻轻的一声筷子碰瓷声，我再没敢进厨房。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "站台尽头的孩子", category: "鬼故事", answer: "站台尽头的孩子", explain: "末班地铁站台尽头总有个小孩蹲着玩玻璃弹珠。工作人员说别靠近，因为那里是非开放区域。我有次看到一颗弹珠滚到脚边，顺手捡起。小孩抬头冲我笑，却没过来拿。回家后弹珠一直在口袋里发凉。第二天新闻资料告诉我，这座站建设时曾有儿童误入工地失踪，而照片里的孩子穿着和昨晚一模一样的衣服。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "雨棚下的老人", category: "鬼故事", answer: "雨棚下的老人", explain: "暴雨时我躲进公交站雨棚，旁边坐着个老人。他说这趟车慢，让我别着急。我们聊了很久，车终于来时老人却没上。我回头问他，雨棚已经空了。司机听我描述后说，以前这里常有个老人等同一班车，几年前在过马路时出了事故。更怪的是，我坐下后发现裤兜里多了一张老人票，正好抵一次车费。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "一模一样的钥匙", category: "鬼故事", answer: "一模一样的钥匙", explain: "我搬家后发现新房钥匙和老家祖屋的旧钥匙几乎一模一样。好奇之下拿祖屋钥匙试新房门，竟然也能打开。门后却不是我的客厅，而是几十年前的祖屋堂屋，里面有人正在办白事。棺材旁一个小孩转头看我，长得像小时候的父亲。我立刻关门，再用新钥匙打开，一切恢复正常。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "错位的影子戏", category: "鬼故事", answer: "错位的影子戏", explain: "小镇庙会有皮影戏，我站在人群最后。台上角色演到一半，幕布上忽然多出一个现代人的影子，动作和我完全同步。我抬手，它也抬手。可下一秒它没有跟我放下，而是继续往幕布里面走，最后消失在戏里。散场回家，我发现路灯下自己的影子少了一块，像有人从边缘剪走了一个人形。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "冰柜里的铃声", category: "鬼故事", answer: "冰柜里的铃声", explain: "小卖部停业前清理旧冰柜，老板说最下面有个夹层怎么也打不开。晚上他打电话叫我过去，说夹层里一直有电话铃声。我们撬开后里面只有一个生锈的儿童玩具电话。老板看到后脸色惨白，说这是他弟弟小时候的玩具，而弟弟几十年前在河边失踪。就在这时，玩具电话响了，听筒里传来一个孩子问：“哥，你怎么还没来接我？”", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "落灰的钢琴", category: "鬼故事", answer: "落灰的钢琴", explain: "学校音乐教室里有架多年不用的钢琴，琴盖上厚厚一层灰。新来的老师晚上练琴时，发现最高音区有几个键总会自动和声。她以为机械故障，拆开后里面卡着一张旧照片，是以前学校合唱团。照片中站在钢琴旁的女孩，手正按着那几个键。照片背面写着：“最后一次排练，缺席一人。”", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "只对我开的门", category: "鬼故事", answer: "只对我开的门", explain: "博物馆闭馆前，我在展厅尽头看到一扇工作人员通道门自己打开。里面不是储藏室，而是一条布置成旧时代街景的巷子。我以为是沉浸式展区，走进去几步，却听到身后工作人员惊叫。回头时门正在变窄。他们把我拉出来后说，那面墙从来没有门。监控里我只是站在墙前，然后半个身体慢慢“走进了墙里”。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "风雪中的旅店", category: "鬼故事", answer: "风雪中的旅店", explain: "暴雪困山，我好不容易找到一间旅店。老板给我热汤和房间，还说早上雪停就走。半夜我听见走廊有人争吵，声音像来自很远的年代。第二天醒来，旅店破败不堪，床单积满灰。救援人员找到我时说这里十多年前就因雪崩废弃。我口袋里却有一张昨晚老板开的收据，墨迹还是新的。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "只写一半的家书", category: "鬼故事", answer: "只写一半的家书", explain: "整理爷爷遗物时，我找到一封没写完的信，开头是给奶奶的，写到“今晚我会从南门回来”就断了。爷爷年轻时曾在那晚失踪三天，回来后什么都不记得。我把信放回去，第二天最后多了一行字：“我回来了，但门里的人不是她。”再问奶奶，她只说爷爷失踪回来后，有很长时间都不敢从南门进家。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "河灯", category: "鬼故事", answer: "河灯", explain: "中元节村里放河灯，老人说千万别捡逆流漂来的。我偏偏看到一盏灯逆着水流慢慢靠岸，上面写着我的姓。我没有碰，灯却自己停在脚边。第二天父亲告诉我，我们家以前有个没找到遗体的远房叔公，和我同姓同名。夜里我梦见有人站在河中央问：“灯都送到门口了，怎么不接我回去？”", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "旅馆的旧登记", category: "鬼故事", answer: "旅馆的旧登记", explain: "入住小旅馆时，老板看了我的身份证很久，忽然翻出一本旧登记簿。十五年前同一天，有个同名同生日的人住过同一间房，签名和我很像。老板说那人第二天没退房，人也找不到。我笑说巧合。进房后，衣柜里挂着一件旧外套，口袋里有一张十五年前的车票，而票背面写着我现在的地址。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "夜里的澡堂", category: "鬼故事", answer: "夜里的澡堂", explain: "老式澡堂晚上十点关门，我有次睡过头，被管理员叫醒。出去时听见男池里还有很多水声和聊天声，我提醒管理员里面有人。他脸色一白，立刻关灯拉我走。第二天他才说，那片旧浴池十年前曾因锅炉事故封过一段时间，从那以后逢事故日期，闭馆后总会重新响起洗澡声。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "仓库里的第九排", category: "鬼故事", answer: "仓库里的第九排", explain: "仓库货架只有八排，盘点时系统却总显示“第九排库存异常”。夜班同事说别管。一次我顺着地面编号找，最里面竟真多出一条狭窄通道，两边货架全是落灰纸箱。每个箱子都贴着员工姓名。最里面那只写着我的名字和当天日期。我没敢打开。第二天第九排消失，系统里却显示那只箱子已被“领用”。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "老剧院化妆镜", category: "鬼故事", answer: "老剧院化妆镜", explain: "剧团借用一座老剧院排练，后台化妆镜每到深夜会多出一个反光位置，像有人坐在空椅上。我以为灯影问题，直到一次镜中那个人慢慢抬起手，替我擦掉脸上的一处妆。我现实里没动，脸上却真的少了一块颜色。老师傅说以前有位演员演出前失踪，最后被看到的地方就是这面镜子前。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "回收站的玩具熊", category: "鬼故事", answer: "回收站的玩具熊", explain: "小区垃圾房里有只旧玩具熊，保洁扔掉很多次，它总会回到同一个纸箱上。孩子们给它取了名字。某天一个小女孩把它抱回家，第二天家长慌张地送回来，说孩子半夜一直和“熊里的姐姐”说话。保洁拆开玩具，里面没有电池，却塞着一张多年前小区失踪女孩的照片。玩具熊被重新缝好后，第二天胸口位置却自己鼓出了一张新的小纸条。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "上锁的天台门", category: "鬼故事", answer: "上锁的天台门", explain: "学校天台门常年上锁，钥匙由保安保管。可每逢期末，门缝下会出现粉笔灰脚印，从天台一路走到楼梯。一次保安跟着脚印开门，天台空无一人，只有护栏上放着一本旧练习册。扉页姓名属于十多年前一名坠楼学生。最末一页新写着一句：“今年还有人没交卷。”那句新字第二天被擦掉了，但老师点名时真的发现少了一个没人记得姓名的座位。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "最后一个包间", category: "鬼故事", answer: "最后一个包间", explain: "饭店老板说最里面的包间从不接待客人，因为“门锁坏了”。我半夜收工时却听见里面有人碰杯、说笑。推门一看，桌上摆满热菜，十几个人正背对我坐着。转身叫老板，再回来时房间空了，桌面落满灰。老板脸色很差，说那是十年前一场婚宴的包间，当晚所有客人都因一氧化碳事故被送医。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "山路加油站", category: "鬼故事", answer: "山路加油站", explain: "深夜开车油量见底，我在山路边看到一家亮灯加油站。老人给我加满油，却不要钱，只让我“下坡别踩刹车太久”。第二天我回去道谢，那里只有废墟。附近修车师傅说那站二十年前就关了，老板当年常提醒司机同一句话。那天夜里正因这句话，我避开了长下坡刹车过热。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "旧校医室", category: "鬼故事", answer: "旧校医室", explain: "体育课扭伤脚，我误进一间很旧的校医室。里面一位女医生给我包扎，叫我休息半小时。回班后老师惊讶地问我去哪儿了，因为学校校医室正在另一栋楼。我带同学回去找，那扇门变成一面墙。墙上挂着旧校史照片，照片里的校医正是刚才给我包扎的人，而她早在学校搬迁前就去世了。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "只有一站的电车", category: "鬼故事", answer: "只有一站的电车", explain: "旅游城市有条复古电车线，我在终点附近误上了一辆空车。司机说只坐一站。车开进雾里后，窗外街景突然变成几十年前的模样，路边人都穿旧衣服。到站时司机催我快下。我回头问这是哪，他只说：“你还没到该坐第二站的时候。”雾散后，我站在原来的街口，手里多了一枚停用多年的车票。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "空教室的粉笔字", category: "鬼故事", answer: "空教室的粉笔字", explain: "值日结束后我锁好教室，第二天黑板上却多了一道题，字迹不是班里任何人。老师擦掉，第三天又出现，题目越来越长。数学老师算了半天，发现答案是一个日期。那天恰好是学校旧教学楼拆除事故的周年。到了晚上，黑板上自己多出最后一句：“这次答案还会一样吗？”", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "海岛民宿的钟", category: "鬼故事", answer: "海岛民宿的钟", explain: "海岛民宿每间房都有一只旧挂钟，唯独我的房间指针永远停在4:12。老板说坏了。凌晨4:12我被潮声惊醒，发现窗外海水已经漫到二楼。慌忙叫醒其他住客时，潮水却突然退了。老板看到钟脸色发白，说几十年前这栋房子遭过海啸，海水冲进屋的时间正是4:12。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "走失广播", category: "鬼故事", answer: "走失广播", explain: "商场闭店后，广播突然播放走失儿童寻人启事，名字、年龄都很模糊，只说“穿红鞋”。保安在监控里看不到孩子。第二晚广播又响，补充“已经找到一楼”。第三晚说“已经找到二楼”。商场一共四层。第四晚广播沉默很久，最后说：“已经找到保安室。”当时值班的我低头一看，门外正停着一双小小的红鞋。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "夜里的裁缝铺", category: "鬼故事", answer: "夜里的裁缝铺", explain: "旧街裁缝铺晚上总亮着一盏灯。一次路过时老人叫住我，说裤脚太长，免费替我改。我回家才发现口袋里多了一张旧布票。第二天再去，铺子铁门锈死，邻居说裁缝师傅五年前已经去世。我低头看裤脚，针脚细密整齐，内侧还绣着一个我爷爷年轻时常用的名字。回家后我翻旧相册，竟在爷爷年轻时的合照角落看到了那位裁缝师傅。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "不会干的墨水", category: "鬼故事", answer: "不会干的墨水", explain: "档案馆有份百年前的手稿，工作人员说最后一页墨迹始终像刚写的一样。我夜班整理时，看见字迹真的在慢慢延伸。新写出的内容记录的是我当天的动作：“他在23点47分翻到此页。”我吓得合上。再打开，最后一句变成：“他以为合上就看不见我继续写。”我离开前把手稿锁进柜里，第二天柜门内侧也出现了一句湿漉漉的新墨迹。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "借宿寺庙", category: "鬼故事", answer: "借宿寺庙", explain: "徒步遇暴雨，我在山寺借宿。老僧安排一间偏房，只叮嘱夜里听到木鱼声不要数。我半夜还是忍不住数，敲了四十九下后停了。几秒后房门外响起第五十下，接着有人低声说：“少一个。”第二天问老僧，他脸色变了，说寺里夜课只敲四十八下，四十九和五十都不是给活人听的。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "电影院停电", category: "鬼故事", answer: "电影院停电", explain: "电影放到一半突然全场停电，观众都抱怨。黑暗里银幕却继续亮着，画面不是电影，而是正在放映厅里的我们。镜头从后排缓缓推进，最后停在我座位旁。那里现实中没有人，画面里却坐着一个穿旧制服的售票员。灯恢复后工作人员说，这家影院早年确实有位售票员死在停电事故中。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "木箱里的海风", category: "鬼故事", answer: "木箱里的海风", explain: "搬家工人从旧仓库抬出一个封死木箱，里面不断传出海浪声。仓库离海几百公里。我忍不住撬开一条缝，立刻有咸湿冷风吹出，地面还渗出海水。老板赶来迅速钉死箱子，说这是祖父留下的，从一艘失事货船上捞回。夜里我梦见自己站在甲板，脚边正摆着那个木箱，而箱子里传来我的敲门声。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "旧照片馆", category: "鬼故事", answer: "旧照片馆", explain: "景区有家老照片馆，老板给游客拍复古照。我和朋友拍完等冲洗，照片里却多了一位陌生老人站在我们身后。老板看到后不肯收钱，只让我们立刻离开。后来我查到，这间照相馆的前任老板几十年前失踪，唯一留下的照片里，他穿的衣服和我们照片中的老人一模一样。几天后照片边缘开始发黄，只有那个老人越来越清晰，像正从过去里走近。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "没有钟的钟声", category: "鬼故事", answer: "没有钟的钟声", explain: "新办公室每天中午十二点会响三下钟声，可整层楼没有钟。我问老员工，他只说习惯就好。某天钟声响了四下，所有老员工同时站起来往外走。我没反应过来，几分钟后天花板水管爆裂，会议室被淹。事后有人告诉我，第四声只有“该离开的人”才会听到。从那以后，只要多响一声，整层楼的人都会默契地先离开再问原因。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "雪夜收费亭", category: "鬼故事", answer: "雪夜收费亭", explain: "暴雪中公路封闭，我却在旧收费亭看到有人招手。老人递给我一杯热水，劝我别继续走。我在亭里睡了半夜，醒来救援车正敲窗。工作人员说这座亭子十年前就废弃，里面根本不通电。他们问我水从哪来的，我看向杯子，杯底刻着一名旧收费员的名字。杯子带回家后无论放多久都不会结冰，哪怕窗外温度低到零下十几度。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "废弃泳池", category: "鬼故事", answer: "废弃泳池", explain: "学校旧泳池排空多年，夜里却常传来水声。几个学生打赌进去看，发现池底干燥，中央却有一圈不断扩散的“水波纹”，像有透明水面。有人丢下一枚硬币，硬币竟悬在半空后缓慢下沉，最后消失。第二天池底多出一串湿脚印，从中央走上梯子，一直通到更衣室。保安后来在更衣室地面找到那枚硬币，表面却像在水里泡了几十年。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "地下室的自行车", category: "鬼故事", answer: "地下室的自行车", explain: "公寓地下室角落停着一辆锈迹斑斑的儿童自行车，车轮每晚会自己转。物业几次搬走，第二天又回来。某夜保安跟着车轮留下的湿泥痕迹，找到一面封死的墙。拆开后里面是旧防空洞，地上散着几只儿童鞋。那辆自行车却不见了，第二天出现在小区门口，车篮里放着一束新鲜野花。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "过期的电影票", category: "鬼故事", answer: "过期的电影票", explain: "我在旧书里夹到两张过期二十年的电影票。好奇去电影院问，经理说当年那场放映因火灾取消。我回家把票放桌上，半夜却发现其中一张撕成了已检票状态。第二天另一张也少了一半。晚上十一点，客厅墙上忽然出现投影般的光，画面里有人在黑暗影院里冲我挥手，手里拿着剩下半张票。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "封闭的诊室门", category: "鬼故事", answer: "封闭的诊室门", explain: "医院五楼有间门上写着“维修中”的诊室，病人都绕着走。某晚我陪家人检查，护士让我在走廊等。我听见那间屋有人叫我的名字，推门进去，一位医生正翻我的病历，病历上却是几十年后的年龄。他抬头说：“来早了。”我转身再开门，外面护士惊讶地问我为什么一直对着墙站。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "老年公寓的晚餐", category: "鬼故事", answer: "老年公寓的晚餐", explain: "志愿活动时，我负责给老人送饭。工作人员强调402长期空置，不用送。可每晚402门口都会出现吃干净的饭盒。第三天我敲门，里面传来苍老声音：“今天怎么没汤？”管理员赶来后脸色惨白，说原402住户去世前最后一句话就是抱怨当天没有汤。第二天饭车上莫名多了一碗热汤，标签写着402。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "山顶照相亭", category: "鬼故事", answer: "山顶照相亭", explain: "景区山顶有个自动照相亭，游客站进去会打印纪念照。我拍完后照片背景里多了一排陌生人，他们站在悬崖边看镜头。我回头现实中没人。服务员说机器坏了很久，今天根本没通电。更怪的是，照片背面印着几十年前一次山难日期，而那次失踪游客人数，正好和背景里的人数一致。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "荒废温泉", category: "鬼故事", answer: "荒废温泉", explain: "朋友带我去一处“没人知道的野温泉”。水很暖，岸边还放着几双整齐拖鞋。我们泡到天黑，远处忽然有人提醒快走，说“晚上这池子要关”。第二天问当地人，他们说那片温泉十年前地震后就干涸了。我们再去时，只看到一个满是落叶的空坑，昨晚穿过的拖鞋却还整齐摆在边上。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "只剩一半的影子", category: "鬼故事", answer: "只剩一半的影子", explain: "下班路上我发现影子左半边总比右边淡。几天后左半边完全消失，身体却没异常。某晚路灯下，我看到另一个只有左半边的影子从墙角走来，慢慢贴到我脚边。两块影子刚好拼完整。下一秒，我身体忽然无法动弹，而地上的完整影子却自己向前走了。我追了几步，自己的身体却像被钉在原地，只能看着它拐进黑暗。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "地下商场", category: "鬼故事", answer: "地下商场", explain: "我在地铁站迷路，误进一条没见过的通道，尽头居然是热闹商场。店铺全用旧式招牌，顾客没人说话。我买了瓶水，店员递来找零，我才发现是早停用的纸币。原路返回后通道消失。第二天站务员听我描述后说，这里几十年前确实规划过地下商场，但施工时塌方，项目从未开放。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "消失的床位", category: "鬼故事", answer: "消失的床位", explain: "医院病房原本六张床，我陪父亲住院几天，一直记得靠窗有七号床，住着个沉默老人。出院时我想跟他告别，却发现那里只是储物柜。护士说病房从来没有七号床。我翻自己每天拍的照片，画面里父亲旁边确实没有床，但窗玻璃反光中，总能看见那个老人坐在那里。出院那天，窗玻璃上的老人第一次没有坐着，而是站在父亲身后向我们挥手。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "半夜的面馆", category: "鬼故事", answer: "半夜的面馆", explain: "出差回酒店太晚，我在巷口看到一家面馆还营业。老板做了一碗面，说“夜路长，吃完再走”。结账时他摆手不收。第二天同事带我去找，巷口只有一间封闭老铺。旁边老人说以前这里有个面馆，老板十年前夜里救过一名迷路旅客，自己却在回家路上遇事故。我低头看口袋，里面多了一张写着“已付”的旧饭票。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "山谷里的回声", category: "鬼故事", answer: "山谷里的回声", explain: "徒步经过一条狭窄山谷，队友喊名字时回声总会重复两遍。只有我喊时，第二遍回声会换成一句“别回来”。大家以为听错。返程经过同一处，我故意不出声，山谷里却先响起我的声音喊了自己名字，随后两道回声一前一后回答：“回来了。”“别回来。”队友都说只听到普通回声，只有我听见最后那句越来越像自己的声音。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "画廊中的空画框", category: "鬼故事", answer: "画廊中的空画框", explain: "小画廊有个一直空着的画框，标签写“未完成”。馆员说别碰。我站在前面久了，空白画布上慢慢出现一间房，布置和我卧室一样。接着床上出现一个熟睡的人。我后退时，画里的人突然睁眼看向画框外。第二天我回家发现卧室墙上多了一个同尺寸空画框。我把家里的画框拆下扔掉，第二天床头却多了一幅已经画完的‘卧室内部’。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "不会熄灭的蜡烛", category: "鬼故事", answer: "不会熄灭的蜡烛", explain: "祖母葬礼后，灵堂一支蜡烛怎么吹都不灭。家人说别管，让它自己烧完。整夜过去，蜡烛长度一点没变。第二天远房叔叔赶到，一进门蜡烛立刻熄灭。大家都松了口气，只有叔叔脸色苍白。他说祖母生前最后一次给他打电话，他没有接。叔叔后来独自坐在灵堂很久，天亮前那支蜡烛又短了正常的一截。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "旧旅社的钥匙牌", category: "鬼故事", answer: "旧旅社的钥匙牌", explain: "我在古镇住旅社，前台给我203钥匙。半夜钥匙牌自己从桌边掉下，翻过来竟变成“302”。我以为看花眼，再翻又是203。第二天退房时老板说楼上从来没有三层。临走前我抬头看外墙，却清楚看到三楼一扇窗后有人拿着同样的钥匙牌朝我晃。我没有上楼确认三层，因为那扇窗后的‘我’已经把手指放在嘴边示意安静。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "停电的面包店", category: "鬼故事", answer: "停电的面包店", explain: "小区停电夜，街口面包店却亮着灯。我进去买早餐，店员说只收现金。第二天整个街区来电，我发现那家店已经关门多年。更奇怪的是，买回来的面包一直保持温热。奶奶看到包装袋后说，年轻时她常买这家店，老板曾在火灾中去世。袋子上的印章日期正是火灾前一天。母亲吃了一口面包后忽然说，这味道和她小时候外婆买回家的一模一样。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "消失的斑马线", category: "鬼故事", answer: "消失的斑马线", explain: "我每天走同一条路上班。某晚加班回家，前方多了一条斑马线，路对面站着十几个人，绿灯亮后却没人动。只有一个小孩向我招手。我刚要过街，身后司机猛按喇叭——现实路口根本没有斑马线，前方是一段隔离带。第二天听附近老人说，多年前那里确实有人行横道，后来因事故频发被取消。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "阁楼里的婴儿床", category: "鬼故事", answer: "阁楼里的婴儿床", explain: "买下老房后我在阁楼发现一张婴儿床，床头刻着一个陌生名字。房契显示前房主从未有孩子。我把床搬去仓库，晚上却听见楼上有摇床声。第二天婴儿床又回到阁楼，床头多刻了一行小字，是我的姓。妻子当时已经怀孕三个月，但我们还没告诉任何人。孩子出生后，我们再上阁楼，那张床已经不见，只剩地板上一圈新鲜摇痕。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "雨中的站牌", category: "鬼故事", answer: "雨中的站牌", explain: "暴雨夜我躲在一个旧站牌下，发现线路表上有一班“00:00”的公交。午夜整，一辆没开灯的车真的停下。司机问我去哪，我报了小区名，他摇头：“这趟只送不接。”我没敢上。车开走后站牌也消失。第二天我查旧新闻，那条线路十年前因事故停运，而事故发生时间正是午夜。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "木桥下的孩子", category: "鬼故事", answer: "木桥下的孩子", explain: "乡下木桥下总能听见孩子数数，数到九就重新开始。村民说没人知道为什么。一次我在桥上等，声音终于数到了十，桥板下立刻传来猛烈敲击。我吓得跑开。第二天村里人在桥墩旁发现一只旧铁盒，里面有十枚玻璃弹珠和一张合照，照片上九个孩子站着，最右边留着一个空位。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "旧裁缝的量尺", category: "鬼故事", answer: "旧裁缝的量尺", explain: "母亲留下的一把旧量尺每年生日都会多一条铅笔线，刚好是我的身高。成年后我以为不会再变，可今年那条线突然比我高了半头。我笑着以为木尺受潮。夜里我听见衣柜里有人拉尺子的声音，打开后里面挂着一套从没见过的黑色西装，尺寸正好对应那条新刻度。第二天西装口袋里出现一张请柬，日期是我完全没有安排过的未来某一天。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "照片上的日期", category: "鬼故事", answer: "照片上的日期", explain: "我买了一台一次成像相机，拍出的照片右下角总自动出现日期。某天照片日期突然变成三天后，画面里家门口堆着白花。我又拍几张，日期都一样。我把相机锁起来。三天后没有任何事故，直到晚上邻居敲门说送错了花圈，地址正是我家。相机从柜里掉出一张新照片，日期改成了明天。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "无人便利店", category: "鬼故事", answer: "无人便利店", explain: "深夜山路旁有家小便利店，老板坐在角落打盹。我买水时他提醒：“前面别走老路，桥断了。”绕行后我安全到镇上。第二天当地人说那段路昨晚确实塌桥，但附近根本没有便利店。我带他们回去，只找到一块长满草的地基，墙角还摆着我昨晚买水时拿过的同款玻璃瓶。玻璃瓶底刻着一个名字，正是当地人所说那位已故店主。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "四个人的脚步", category: "鬼故事", answer: "四个人的脚步", explain: "夜班下班时我们三个人一起走地下通道，却一直听见四组脚步声。大家停下，第四组也停。我们故意分开走，声音仍保持四组。走出通道后只剩三组，我松了口气。第二天同事却问：“昨晚跟你们一起出来的那个戴帽子的人是谁？”我们三人都没看见第四个人。第二天再经过通道时，我数到的脚步只有三组，可同事坚持说我们仍是四个人。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "缆车站的广播", category: "鬼故事", answer: "缆车站的广播", explain: "高山缆车停运后，广播突然响起：“最后一位游客请下车。”工作人员互相确认，所有车厢都空了。几分钟后，一只车厢缓缓停在站台，门自己打开，座椅上只有一只老式登山包。负责人看到包后脸色发白，说那属于多年前失踪的一名救援队员，当年就是在最后一班缆车后失去联系。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "无人接听的房间", category: "鬼故事", answer: "无人接听的房间", explain: "酒店夜班前台不断接到707房电话，听筒里只有呼吸声。系统显示707未入住。我带保安上楼，发现那扇门被消防封条封着。经理说707三年前失火后一直停用。我们正准备离开，前台同事从对讲机里惊叫：“707又打来了，而且这次说你们已经站在门外。”我们没敢开门，电话里的声音却继续说：“别进来，我也出不去。”", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "白天不存在的巷子", category: "鬼故事", answer: "白天不存在的巷子", explain: "我下夜班抄近路，发现两栋楼之间多了一条窄巷，能少走十分钟。巷子里挂着旧灯笼，尽头直接通到我家附近。第二天白天想再走，却只看到一堵墙。连续几晚它都出现，直到某次我在巷中遇到迎面走来的自己。对方脸色惨白地说：“别再走这条路，我那边已经没有出口了。”", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "老电影院的售票窗", category: "鬼故事", answer: "老电影院的售票窗", explain: "拆迁前我去拍一座废弃电影院，售票窗里忽然伸出一只手，递给我一张票。我吓得后退，再看窗口空无一人。票上写着当天日期和“最后一场”。晚上我回家发现票少了一角，像被检过。第二天施工队拆到放映厅时，发现最后一排有一张座椅干净得没有灰，扶手上夹着缺失的那一角票根。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "海岛上的门", category: "鬼故事", answer: "海岛上的门", explain: "无人岛调查时，我们在树林里发现一扇单独立着的木门，前后都没有墙。队长警告不要打开。夜里我听见门后传来母亲的声音，还是忍不住拉开。门里是我家厨房，母亲正背对着我做饭。我还没迈步，队友一把关门把我拖走。第二天卫星图上那片树林中央多了一个和我家户型一样大的空白区域。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "无人收割的麦田", category: "鬼故事", answer: "无人收割的麦田", explain: "村外一片废弃麦田每年都会在同一天被整齐割出一条小路，没人知道是谁做的。老人说别走进去。我年轻气盛沿小路走到尽头，看见一张旧木桌，桌上摆着四副碗筷，其中一副写着我的名字。回头时身后的麦子已经重新合拢，只剩远处有人敲碗叫我吃饭。我最终沿着另一条路逃出麦田，回头时桌边的第四把椅子已经被拉开。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "旧戏服", category: "鬼故事", answer: "旧戏服", explain: "剧团仓库有套没人敢穿的旧戏服，传说属于早年失踪的名角。新演员不信，偷偷穿上拍照。第二天她嗓音突然变得和旧录音里的名角极像，还会唱从没学过的段落。第三天谢幕后，她没有回后台，而是沿着几十年前剧院的旧出口走进一面墙。墙上只剩那套戏服，整整齐齐挂着。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "公交卡余额", category: "鬼故事", answer: "公交卡余额", explain: "我捡到一张旧公交卡，想着交给司机。上车刷卡时机器竟提示“余额：1次”。司机看到卡面后让我立刻别再刷，说这种卡十年前就停用了。回家后卡片自己出现在桌上，余额变成“0次”。第二天我想扔掉，背面却多出一行小字：“已乘完最后一程。”我把卡剪断后，断口里夹着一张极小的旧乘车照片，照片上正是我。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "河堤上的红灯", category: "鬼故事", answer: "河堤上的红灯", explain: "夜跑时我总看到河对岸有一盏红灯跟着我移动，速度和我完全一致。起初以为是自行车灯，后来我停下，它也停；我往回跑，它也往回。某晚红灯突然穿过河面朝我靠近。我吓得跑回家。第二天新闻说河对岸根本没有步道，那一带十年前就因塌岸封闭，而塌岸事故中曾失踪一名夜跑者。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "墓地管理员的茶", category: "鬼故事", answer: "墓地管理员的茶", explain: "雨天扫墓时我迷路，一位老人把我叫进管理屋喝茶，还告诉我祖坟在东侧第三排。找到后我想回去道谢，却看见管理屋门锁锈死。真正的管理员说那间屋已经废弃多年，上一任管理员就葬在东侧第三排。我回头看手里还冒热气的茶杯，杯底刻着老人的姓。回家后杯子不见了，第二年扫墓时却摆在老人墓碑前，里面盛着新茶。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "只有雨天出现的站台", category: "鬼故事", answer: "只有雨天出现的站台", explain: "我每天坐同一趟火车，只有下大雨时，窗外会掠过一个地图上没有的小站。站牌上没有站名，只有一排撑黑伞的人。第三次经过时，一个人抬头冲我挥手，我认出那是去世多年的舅舅。下一站下车后，我发现座位上多了一把湿伞，伞柄上刻着舅舅年轻时的名字。从那以后每逢大雨，我都会刻意闭上眼睛，直到列车完全通过那一段。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "老宿舍的床号", category: "鬼故事", answer: "老宿舍的床号", explain: "学校翻修旧宿舍，我帮忙搬家具时发现一张标着“0号床”的铁架床。名单里从来没有0号。我问管理员，他脸色一沉，让我别动。晚上那张床自己从仓库移到走廊，床板上铺着干净被褥。第二天宿舍入住名单多了一行：“0号床，已入住”，姓名栏写着一个二十年前失踪学生的名字。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "反锁的更衣室", category: "鬼故事", answer: "反锁的更衣室", explain: "游泳馆闭馆后我发现女更衣室最里面一格始终反锁，里面还有水滴声。保洁说那格早坏了。某晚锁突然自己弹开，我推门只看到一面雾气镜子。镜上慢慢出现一个手写日期，正是十年前溺水事故那天。接着镜中多出一个穿泳衣的人影，而现实狭小隔间里只有我。第二天镜子被拆走，墙后竟发现另一面更旧的镜子，表面还有同样的日期。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "长廊里的咳嗽声", category: "鬼故事", answer: "长廊里的咳嗽声", explain: "老医院夜里有条长廊始终比别处冷，护士说别一个人走。某晚我经过时身后传来咳嗽声，像有人隔几步跟着。我加快脚步，咳嗽也加快。到尽头安全门前，它忽然停了。第二天护士长看监控说，画面里只有我一个人，但我每咳一声，身后的消防门都会自己开一点。我确定那晚根本没咳嗽。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "没有房号的客房", category: "鬼故事", answer: "没有房号的客房", explain: "民宿老板给我的钥匙没有房号，只说二楼最里面。上楼后我找到一扇没挂牌的门，房间干净但陈设很旧。半夜有人在门外轻声问：“你还住得惯吗？”我没开门。第二天老板看见钥匙脸色发白，说这不是现在使用的钥匙，而是他父亲那代留下的。二楼最里面原本有间房，十年前翻修时已经拆掉。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "失踪的路口", category: "鬼故事", answer: "失踪的路口", explain: "开车回家时导航路线我很熟，可那晚前方突然多出一个红绿灯路口。红灯时间特别长，四周也没有其他车。变绿后我刚要走，后排忽然传来一句“别过”。我猛踩刹车。下一秒，一辆失控货车从横向黑暗里冲过去。等我缓过神，那个路口和红绿灯都消失了，后排座位上却多了一张儿童安全座椅。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "祖父的收音机", category: "鬼故事", answer: "祖父的收音机", explain: "祖父留下的旧收音机多年收不到台，只有每逢雷雨会突然播出天气预报。奇怪的是，预报内容总是第二天。一次播音员最后加了一句：“请北街三号住户夜间远离窗户。”那正是我家地址。第二晚暴风刮断树枝砸碎卧室窗户。我躲过后再开收音机，播音员轻声说：“收到就好。”", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "回不去的楼梯口", category: "鬼故事", answer: "回不去的楼梯口", explain: "商场停电，我顺着安全楼梯下楼。楼层牌从6、5、4一路正常，到3楼后却又出现一个“4”。我以为走错，继续下，又是3、4、3、4。走了十几分钟，远处终于有人喊我名字。我追过去，看见朋友站在3楼门口，而他身后另一个我正背对着我们继续下楼。朋友说他当时只看到我一个人，可那串向下的脚步声又持续了很久。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "木柜里的戏票", category: "鬼故事", answer: "木柜里的戏票", explain: "拆祖屋时从木柜夹层找到两张旧戏票，日期是父母结婚前一年。母亲看到后愣住，说当年本来和一个朋友约好去看戏，对方当天失踪。票一直只有一张，另一张从没出现过。我翻到背面，第二张票用铅笔写着：“她没来，所以我去找她了。”署名正是失踪朋友。母亲看完那句话后把两张票都烧了，火灭后灰里却留下完整的座位号。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "凌晨的果园", category: "鬼故事", answer: "凌晨的果园", explain: "果园看守说夜里听见有人摘果不要管，因为树下没人。新来的工人不信，半夜循声过去，看到一棵树下站着许多人，动作整齐地伸手摘果。手电照过去，人影瞬间不见，只剩地上摆着一排腐烂果子。第二天老板说那块地以前是旧村墓地，果园扩建时曾迁过坟。第二天那棵树上少了一个果子，地上却多了一只小小的旧布鞋。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "最后一张餐券", category: "鬼故事", answer: "最后一张餐券", explain: "单位食堂改版前清理旧票柜，我捡到一张几十年前的纸质餐券。午饭时开玩笑递给师傅，师傅竟真的给我打了一份从没见过的老式菜。吃完再去找，那位师傅不在。食堂经理看到餐券后说，照片墙上有个早年因病去世的老厨师，最后一天上班就是这种餐券停用的日子。那天下午，照片墙里老厨师的手上多了一只我刚用过的饭碗。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "雨夜的旧车站", category: "鬼故事", answer: "雨夜的旧车站", explain: "大雨把我困在郊外，我躲进一座废弃车站候车室。里面有几个人安静坐着，没人说话。午夜时远处传来汽笛，所有人同时起身往站台走。我觉得不对没跟。第二天醒来，候车室空空荡荡，墙上有块纪念碑：几十年前一场列车事故中，最后一批等车旅客在此遇难。我离开前数了数长椅，一共八个人的位置，而纪念碑上的遇难者也是八名。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "高架桥下的电话亭", category: "鬼故事", answer: "高架桥下的电话亭", explain: "高架桥下有个废弃电话亭，电话线早被拆了。某晚下雨，我进去躲雨，电话突然响起。接起后是父亲年轻时的声音：“别站那里，往左三步。”我下意识照做，下一秒一块广告牌从上方掉下来砸中原位。回家问父亲，他说几十年前也在同一地点接过一通“未来的电话”。父亲听完后没有惊讶，只问我电话里有没有一句他当年没听清的话。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "旧公园的旋转木马", category: "鬼故事", answer: "旧公园的旋转木马", explain: "废弃公园夜里偶尔会传来旋转木马音乐。年轻人翻墙进去拍照，看到木马真的在转，却没有电。中央最里面一匹白马背上坐着个小孩。灯光闪过后小孩消失，木马停下。第二天照片里却多了一个空座，而拍照的人数少了一人。剩下的人都说记不起究竟是谁一起进去的。更诡异的是，第二天大家翻通讯录时都发现联系人总数也少了一个。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "被借走的声音", category: "鬼故事", answer: "被借走的声音", explain: "我感冒失声三天，第四天夜里突然听见客厅有人用我的声音说话。走出去却没人，声音从关闭的储物柜里传来，一遍遍重复我白天没能说出的句子。第二天嗓子恢复了，柜子也安静了。可从那以后，每当我独自在家，偶尔会听到里面有人用我的声音说一些我从没想过的话。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "空屋的门垫", category: "鬼故事", answer: "空屋的门垫", explain: "对门房子空了半年，门口却总有一块干净门垫。物业拿走几次，第二天又出现。某晚我回家踩到自己门垫有点湿，低头一看，它变成了对门那块。抬头时对门门缝正慢慢打开。第二天门垫又回原位，而我的门内侧多了一串陌生鞋印，正好从门口走到床边。物业来检查时说鞋印只有进去的，没有出来的，而我整晚没有离开卧室。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "旧商场的扶梯", category: "鬼故事", answer: "旧商场的扶梯", explain: "已经停业的商场准备拆除，我跟朋友进去探险。一部断电扶梯突然自己向上运行，我们没敢乘。几分钟后扶梯上缓缓出现几个人影，像从地下被送上来。他们穿着十多年前流行的衣服。物业老人后来告诉我们，这部扶梯曾发生过严重事故，停业前最后一天也曾在断电后自行启动。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "高山上的客栈", category: "鬼故事", answer: "高山上的客栈", explain: "徒步时迷雾太大，我在山腰找到一家小客栈。老板说房钱明早再结。夜里走廊总有人拖着沉重行李经过。第二天醒来客栈变成一片倒塌木屋。救援队说这里十年前山体滑坡后就无人居住。我背包外侧却挂着一张木制房牌，刻着“7号房，已退房”。木牌背面还有一行字：‘下次别等到雪更大时再来。’", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "只在照片里开的门", category: "鬼故事", answer: "只在照片里开的门", explain: "老宅客厅墙上没有门，可每次拍照，照片右侧都会出现一扇木门。起初关着，后来每张照片里都开得更大。最后一次拍时，门内站着一个背影。我决定不再拍。几天后朋友来家里，指着墙问：“你什么时候装了这扇门？”我转头看，现实墙面上终于出现了照片里的门。门把手冰得像刚从室外拿回来，门缝里却吹出我小时候老家的饭菜味。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "结冰的湖面", category: "鬼故事", answer: "结冰的湖面", explain: "冬季湖面封冻，管理员禁止游客上冰。我远远看见冰中央有个人影挥手，以为有人被困，赶紧报警。救援队赶到后说冰面没有任何脚印，也没人。回看我拍的视频，人影确实存在，但它不是站在冰上，而像站在冰层下面，隔着透明冰面向上挥手。救援队离开前在冰面内侧发现五个手掌印，方向全部朝上。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "旧医院的自动门", category: "鬼故事", answer: "旧医院的自动门", explain: "医院后门自动门晚上总会无故打开。维修人员检查感应器没问题。某次夜班我站在门边，门忽然打开，却没人进出，地上只多了一串湿脚印通向急诊室。护士长看到脚印后沉默很久，说很多年前有个重伤病人就是从这扇门被推进来，外面当时下着大雨。脚印最后停在一间空病房门口，病床号码正是当年那位病人的。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "祭桌上的第四杯茶", category: "鬼故事", answer: "祭桌上的第四杯茶", explain: "清明家祭时只摆三位先人的牌位，爷爷却每年放四杯茶。我小时候问，他只说“还有一个没找到”。爷爷去世后我们少放了一杯，半夜祭桌传来瓷杯碰撞声。早上桌上四杯茶整整齐齐，其中多出的那杯已经凉透，杯底压着一张几十年前的失踪人口启事。那张启事上的失踪日期，正好就是家里每年摆第四杯茶的那一天。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "站错方向的人群", category: "鬼故事", answer: "站错方向的人群", explain: "地铁末班车停站时，我发现对面站台站满人，却全部背对轨道，面向墙壁。同行朋友催我别看。列车启动后，对面所有人同时转身，脸全被白色口罩遮住。下一站工作人员说对向线路今晚早已停运，不可能有人。朋友却低声问我：“你刚才有没有看到其中一个人没戴口罩？”我想起那张脸正是我自己。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "没烧完的纸条", category: "鬼故事", answer: "没烧完的纸条", explain: "搬家前我把一些旧纸条烧掉，其中一张写着小时候一个不存在的“朋友”名字。纸条怎么都点不着，我只好扔进垃圾桶。第二天它完整地放在桌上，背面多了一句：“你终于想起我了。”我问母亲，她沉默很久，说我小时候确实常和一个看不见的人说话，搬家后才慢慢忘记。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "废楼里的灯", category: "鬼故事", answer: "废楼里的灯", explain: "每天夜里，对面废弃办公楼只有顶层一盏灯亮。某晚我拿望远镜看，灯下有人坐着工作。第二天我去现场，顶层空无一物，窗户也被木板封死。回家再看，那盏灯又亮了，这次桌旁多了一把椅子，椅背上挂着和我当天一模一样的外套。第二晚顶层那把椅子已经转过来，椅子上坐着一个低头看文件的人。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "夜市最后一个摊位", category: "鬼故事", answer: "夜市最后一个摊位", explain: "夜市快收摊时，我发现最里面还有个从没见过的小摊，卖各种旧玩具。摊主让我免费挑一个。我选了个木陀螺，回家后它每晚十二点自己转。第三夜陀螺停下，尖端指向床底。我弯腰看，下面摆着更多旧玩具，和摊位上的一模一样，而我从没买过它们。我把那些玩具全部丢掉后，第二天木陀螺仍在餐桌中央慢慢旋转。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "博物馆里的脚步声", category: "鬼故事", answer: "博物馆里的脚步声", explain: "博物馆闭馆后我负责巡展，古代鞋履展柜旁总有脚步声。一次我停下来数，脚步从展柜内开始，一步步走向我。玻璃里面那双旧鞋的位置也真的在变化。第二天策展人说别再靠近，因为这双鞋出土时，墓主人双脚仍穿着它，但棺内没有发现身体其他部分。那以后每次巡夜，我都会先确认展柜里的鞋尖是不是还朝着原来的方向。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "无人村的电视声", category: "鬼故事", answer: "无人村的电视声", explain: "徒步误入一座废弃村庄，房屋都落满灰，只有一户传出电视声。推门进去，老电视正在播新闻，日期是二十年前。画面突然切到现场采访，记者站的位置正是我所在村口。镜头后方，一个年轻的我从路边走过。我还没反应过来，电视里记者转头看向镜头外，说：“他又回来了。”", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "不会退色的车票", category: "鬼故事", answer: "不会退色的车票", explain: "父亲钱包里一直夹着一张四十年前的长途车票，纸都发黄了，唯独座位号鲜红。我问原因，他说当年那班车途中出事，他临时换车才躲过。父亲去世后，我收起车票。几个月后准备坐长途车时，发现票上座位号变成了我当天买的号码。我立刻改签。当天原车在高速上发生严重故障。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "空房的暖气", category: "鬼故事", answer: "空房的暖气", explain: "冬天整栋楼供暖故障，唯独楼上一间空房温度很高。维修工进去检查，发现暖气管根本没接通，屋里却有明显人体热气。墙上还有一片结露区域，形状像坐着的人。第二天房东说那间房原租户冬天去世，邻居发现时暖气正坏着。维修结束后那块人形结露消失了，但玻璃上多了一句手指写出的‘好冷’。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "逆流的小船", category: "鬼故事", answer: "逆流的小船", explain: "河边夜钓时我看到一艘无灯小船逆流而上，船头站着个人，一动不动。朋友说别照手电。我偏偏照过去，船上空无一人，只有一件湿衣服挂着。几秒后手电光照到水面，水下却有个人影正跟着船走。船经过我们面前时，鱼线全同时绷紧，像河里有人抓住了线。我们当晚立刻收杆离开，第二天却在岸边发现一条从水里拖出的长长湿痕。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "废校广播操", category: "鬼故事", answer: "废校广播操", explain: "废弃小学每到早上八点会响广播操音乐，附近居民早习惯了。施工队进场拆楼那天，音乐照常响起，空操场上扬起一排排灰尘脚印，像有很多孩子在原地踏步。音乐结束后，灰尘里只剩一串脚印没散，径直走向已经封死的旧教室。施工队最终没有拆那间旧教室，因为门后不断传来整齐的报数声。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "凌晨的花轿", category: "鬼故事", answer: "凌晨的花轿", explain: "回乡参加婚礼，老人提醒夜里听见唢呐别开门。凌晨两点，巷子果然传来喜乐声。我从窗缝看见一顶红花轿缓慢经过，却没有抬轿人。花轿到我家门口停住，帘子掀开一角。第二天长辈告诉我，祖辈里有位新娘在成亲途中失踪，出事地点就在这条巷子。花轿离开后，门槛上落下一只红色绣鞋，第二天却怎么也找不到了。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "雾中的学校", category: "鬼故事", answer: "雾中的学校", explain: "清晨大雾，我骑车上班，熟悉路口旁突然出现一所旧学校。操场上孩子们正在做操，校门写着我母亲小学时的校名。雾散后学校消失，只剩一片住宅区。母亲听我描述后说，那所学校几十年前拆了，而我看到的领操老师，是她小时候意外去世的班主任。母亲听完只说了一句：“她以前也最喜欢站在校门口送我们回家。”", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "开错的信箱", category: "鬼故事", answer: "开错的信箱", explain: "老楼一层信箱编号从101到108，我家是106。某天却多出一个“106B”，里面塞着几封写给我的信，邮戳年份分别是未来三年。第一封提醒我别去某次聚会，我没在意，那天果然遇到意外受伤。第二封我不敢拆。几天后再看，106B信箱消失，未拆的信却已经放进我家抽屉。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "不会合上的棺盖", category: "鬼故事", answer: "不会合上的棺盖", explain: "村里办白事时，一口旧棺材怎么都合不上盖，木匠检查尺寸完全正常。老人们沉默着把棺盖重新抬开，里面除了逝者遗物，还多了一双没人认识的鞋。把鞋取出后棺盖立刻合上。当天夜里，院门外传来赤脚走路声，绕着灵堂走了一圈才离开。第二天院门外真的留下了一圈赤脚印，最小的一双停在棺材旁。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "重复入住", category: "鬼故事", answer: "重复入住", explain: "酒店前台说我已经入住过一次，因为系统里上午就有同名同证件记录，还领取了房卡。我那时明明还在飞机上。监控调出来后，上午确实有一个和我长得一模一样的人办理入住。他进了房间后再没出来。我们打开那间房，里面空无一人，床上却放着我的行李箱，而我的真正行李还在手边。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "井盖下的广播", category: "鬼故事", answer: "井盖下的广播", explain: "小区路边一只井盖下面经常传出模糊广播声，像旧时代的新闻。维修工下去检查，只是普通排水井。某晚声音突然清晰，播报某年某月某日暴雨导致区域积水。日期正是第二天。物业紧急疏通管道，次日真的暴雨，却避免了严重积水。雨停后井盖下再也没有声音，只留下一台早停产多年的袖珍收音机。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "没有司机的末班车", category: "鬼故事", answer: "没有司机的末班车", explain: "凌晨我错过公交，却看到一辆同线路旧车缓缓停下。车门打开，驾驶位没人，车厢灯却亮着。我不敢上，车内广播突然叫出我的名字，说“请尽快乘车”。我后退几步，车门关闭离开。第二天交通公司查询车牌，告诉我那辆车十年前已经报废，最后一次运行正是末班车途中发生事故。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "餐厅里的预留位", category: "鬼故事", answer: "餐厅里的预留位", explain: "旅游时走进一家小餐馆，服务员说只剩一个“预留位”。桌上已经摆好我的姓氏牌。我问是谁预订，对方却说“每年这个日子都有人留”。吃到一半，隔壁老人认出我的脸，问我是不是某位故人的孩子。原来父亲年轻时每年这天都会来这里等一个失踪的朋友，直到去世前一年才停止。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "走廊尽头的雨", category: "鬼故事", answer: "走廊尽头的雨", explain: "写字楼夜里空调停了，走廊尽头却一直有雨声。我走过去，发现消防门缝下面渗进水。推门后不是楼梯，而是一条正在下暴雨的旧街。街上有人撑伞匆匆走过，没人注意我。门快自动关闭时，一个老人突然回头喊：“别让门关！”我吓得退开。第二天消防门后仍是正常楼梯，门外地面却留着一把湿伞。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "外婆的缝纫声", category: "鬼故事", answer: "外婆的缝纫声", explain: "外婆去世后，老屋夜里仍会响起缝纫机声音。家人说是木头热胀冷缩。一次我在声音响起时推门，缝纫机脚踏板正在自己上下动，桌上多了一件没见过的婴儿衣服。几个月后姐姐怀孕，孩子出生那天穿的第一件衣服尺寸，竟和那件一模一样。孩子出生后那件衣服忽然不见，等我们找到时已经整齐放在婴儿床上。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "地下停车场的B4", category: "鬼故事", answer: "地下停车场的B4", explain: "商场停车场只到B3，可我开车找出口时指示牌忽然出现“B4”。拐下去后整层空荡，停着许多老旧车辆。最里面有一辆和我父亲年轻时开的车一模一样。我正要靠近，广播突然催促“B4即将封闭”。我赶紧返回。第二天物业说没有B4，但父亲听到描述后告诉我，那辆旧车几十年前事故后就报废了。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "山中废屋的火炉", category: "鬼故事", answer: "山中废屋的火炉", explain: "冬季徒步迷路，我和朋友躲进一间废屋。屋里冷得厉害，火炉却有余温。我们添柴取暖，半夜听见屋外有人绕圈踩雪。天亮离开时，救援队说这片山里没有可住的房屋。我们回头望去，原地只有烧黑的地基。朋友口袋里却装着昨晚从炉边捡起的一盒火柴，盒面印着四十年前的商标。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "第零排座位", category: "鬼故事", answer: "第零排座位", explain: "剧院检票时工作人员发现我的票写着“0排8座”，说系统不可能出票。我坚持是正规渠道买的，经理便让我坐第一排临时位。演出中途，舞台前方地板突然缓缓下沉，露出一排隐藏座椅，正好标着0排。8座上坐着一个穿旧礼服的人，转头冲我微笑。下一秒灯光切换，那排座位又消失了。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "画室里的未完成肖像", category: "鬼故事", answer: "画室里的未完成肖像", explain: "美术学院仓库有一幅未完成肖像，只有身体没有脸。学生们传说谁在夜里看它，第二天脸部会多出一点。新生不信，连续几晚去观察，果然眉眼越来越清晰。到第七天，画上的脸已经和他一模一样。当天早课他没出现，仓库里只多了一件他常穿的外套，而画中人物第一次露出了完整双手。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "清晨四点的菜鸟叫", category: "鬼故事", answer: "清晨四点的菜鸟叫", explain: "回老家住的第一晚，我凌晨四点被一阵鸡叫吵醒，可院子里早就不养鸡了。父亲说可能是邻居家的。第二天同一时间又响，我循声走到废弃鸡舍，里面空空的，地上却有一串小孩脚印。奶奶看到后沉默很久，说我叔叔小时候失踪那天，也是凌晨四点去鸡舍喂鸡，此后再没回来。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "会变号码的门牌", category: "鬼故事", answer: "会变号码的门牌", explain: "我租的房子是508，住了半年一直正常。某晚回家时门牌变成了“580”，我以为有人恶作剧，掰正后进屋。第二天它变成“805”，第三天又是“085”。我把三个号码记下来，朋友随手一排，发现正好组成我出生年月日的一部分。第四晚门牌没有再变，只多了一行小字：“最后一组在里面。”", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "旧码头的行李箱", category: "鬼故事", answer: "旧码头的行李箱", explain: "海边旧码头早已停用，我散步时却看到一只皮箱独自放在长椅上。箱子没有锁，里面只有几件旧衣服和一本船员证，照片上的人和我父亲年轻时极像。回家问父亲，他看完沉默很久，说那是他失踪多年的哥哥。第二天我带他去码头，皮箱已经不见，只留下长椅上一圈湿痕，像刚有人从海里坐下。", source: "米环综合内容库 V2", displayMode: "story" },
  { question: "提早放工回家的小李，一进卧室，看見隔壁的小刘与自己老婆睡在床上，但小李却毫不动怒，为什么？", category: "脑筋急转弯", answer: "小刘是女的", explain: "因为小刘是女的", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "为什么一只青蛙在水里游不过一只狗？", category: "脑筋急转弯", answer: "比赛中禁止用蛙泳。", explain: "因为比赛中禁止用蛙泳。", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "放烟火时为什么不会射到星星？", category: "脑筋急转弯", answer: "星星会闪", explain: "因为星星会闪", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "一架飞机坐满了人，从万米高空落下坠毁，为什么却一个伤者也没有？", category: "脑筋急转弯", answer: "没有伤者，都摔死了", explain: "没有伤者，都摔死了", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "有爷俩，娘俩和兄妹俩，只有6个烧饼，但却每人分得了两个，这是为什么？", category: "脑筋急转弯", answer: "他们只有三个人：母亲", explain: "他们只有三个人：母亲，儿子，舅舅", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "早上，玲玲到刘大妈那儿买茶叶蛋，手上的钱正好买2个，刘大妈却不卖给她，这是怎么回事？", category: "脑筋急转弯", answer: "茶叶蛋还没有煮好", explain: "茶叶蛋还没有煮好", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "先有男人，还是先有女人", category: "脑筋急转弯", answer: "先有男人", explain: "先有男人，因为男人是先生的，所以叫先生", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "空着肚子能吃几个鸡蛋？", category: "脑筋急转弯", answer: "一个", explain: "一个，因为再吃的时候就不是空着肚子了", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "中国人为什么人口这么多？", category: "脑筋急转弯", answer: "汉(和)人在一起.", explain: "因为汉(和)人在一起.", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "文劭乘电梯上12楼，中间没有停，用了60秒；下楼时也没有停，却用了５分钟，为什么呢？", category: "脑筋急转弯", answer: "下楼没有做楼梯.", explain: "下楼没有做楼梯.", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "小李昨天在客户面前骂总经理是笨蛋，结果小李被开除了，为什么？", category: "脑筋急转弯", answer: "小李泄露了公司的最高机密", explain: "因为小李泄露了公司的最高机密", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "观音大士为什么要坐在金童玉女的中间而不坐在旁边呢？", category: "脑筋急转弯", answer: "他怕他们谈恋爱.", explain: "因为他怕他们谈恋爱.", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "蓝色的笔能写出红字吗？", category: "脑筋急转弯", answer: "写个红字当然可以", explain: "写个红字当然可以", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "好马不吃回头草是什么意思？", category: "脑筋急转弯", answer: "后面没有草可吃了", explain: "后面没有草可吃了", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "老詹养了一只狗，并且从來不帮狗洗澡，为什么狗不会生跳蚤呢？", category: "脑筋急转弯", answer: "狗只会生小狗", explain: "因为狗只会生小狗", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "小男孩和小女孩在一起不能玩什么游戏？", category: "脑筋急转弯", answer: "不能玩猜拳(两小无猜0", explain: "不能玩猜拳(两小无猜0", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "一只羊碰到一头老虎，非但不怕，而且还把那头老虎给吃了，这是怎么回事？", category: "脑筋急转弯", answer: "那是只纸考虎", explain: "那是只纸考虎", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "一个司机飞快的从山上冲下来,却没有撞伤人,为什么", category: "脑筋急转弯", answer: "司机并没有开车", explain: "司机并没有开车", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "为什么有人说：“情人眼里出西施”？", category: "脑筋急转弯", answer: "爱情使人盲目", explain: "因为爱情使人盲目", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "何谓「数大就是美」？", category: "脑筋急转弯", answer: "支票上的数大就是美.", explain: "支票上的数大就是美.", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "同事们在小张家喝酒、聊天，酒过三巡后，为什么大家都知道小张喝醉了？", category: "脑筋急转弯", answer: "因為小张正在穿鞋子，准备回家", explain: "因為小张正在穿鞋子，准备回家", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "你有一艘船，船上有十五位船员，六十位乘客，三百吨货物。你能根据上面的提示，算出船主的年龄吗", category: "脑筋急转弯", answer: "你就是船主年龄还需要算吗?", explain: "你就是船主年龄还需要算吗?", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "印度人为什么用手抓饭吃？", category: "脑筋急转弯", answer: "手比脚干净", explain: "因为手比脚干净", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "小王中午时候去开会，为什么半个人影也没看到？", category: "脑筋急转弯", answer: "影子是没有半个的。", explain: "影子是没有半个的。", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "為什么男人和女人会分手？", category: "脑筋急转弯", answer: "男女有「別」", explain: "因为男女有「別」", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "早上八点整，北上，南下两列火车都准时通过同一条单线铁轨，为什么没有相撞呢？", category: "脑筋急转弯", answer: "日期不一样.", explain: "因为日期不一样.", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "娇娇的爸爸在一次难度很大的考试中非常从容，为什么？", category: "脑筋急转弯", answer: "他是监考老师.", explain: "他是监考老师.", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "老张是出了名的拳手，为什么一戴上拳击手套反而让对手三下两下打下台去了？", category: "脑筋急转弯", answer: "他是划酒拳的高手", explain: "他是划酒拳的高手", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "小明点了一份全熟的牛排，但是为什么一切下去居然流出血来？", category: "脑筋急转弯", answer: "不小心切到手了.", explain: "因为不小心切到手了.", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "尼克的法语不好，他去法国旅游时吃苦头了吗？", category: "脑筋急转弯", answer: "没有吃苦头的是法国人.", explain: "没有吃苦头的是法国人.", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "一个招牌突然由高处掉落,砸向并排行走的五个人,为什么只有三个人受伤", category: "脑筋急转弯", answer: "帮当劳M的招牌", explain: "因为帮当劳M的招牌", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "什么时候最好还是要高高举起你的双手好些", category: "脑筋急转弯", answer: "当人用手枪指着你的头的时候", explain: "当人用手枪指着你的头的时候", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "阿美在事业并没有什么成就，为什么也有女强人的外号？", category: "脑筋急转弯", answer: "她常常强人所难", explain: "因为她常常强人所难", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "小张被关在一间没有上锁的房里，可是他使出吃奶的力气也不能把门拉开，这是为什么？", category: "脑筋急转弯", answer: "推开就可以了", explain: "推开就可以了", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "为什么大雁秋天要飞到南方去？", category: "脑筋急转弯", answer: "走太慢了", explain: "因为走太慢了", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "小明家很富裕,可他想买玩具时却从不向母亲要一分钱,为什么", category: "脑筋急转弯", answer: "一分钱买不到玩具", explain: "因为一分钱买不到玩具", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "华先生有个本领，那就是能让见到他的人，都会自动手心朝上。这是怎么回事？", category: "脑筋急转弯", answer: "他是个中医", explain: "因为他是个中医", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "一个人掉进游泳池里,他的脚却没有湿,为什么", category: "脑筋急转弯", answer: "游泳池中没有水", explain: "游泳池中没有水", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "刚上幼儿园第一天的Rose，从来没学过数学，但老师却称赞她的数学程度是数一数二的，为什么？", category: "脑筋急转弯", answer: "他只会数一数二的。", explain: "因为他只会数一数二的。", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "小王13岁的生日为何点了14根蜡烛", category: "脑筋急转弯", answer: "那晚停电", explain: "那晚停电，有一根是用来照明的。", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "船边挂着软梯，离海面2米，海水每小时上涨半米，几个小时海水能淹没软梯", category: "脑筋急转弯", answer: "水涨船高", explain: "水涨船高，所以永远不会淹没软梯", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "孔子和孟子有什么不同？", category: "脑筋急转弯", answer: "孔子把儿子牵在身边", explain: "孔子把儿子牵在身边，而孟子把儿子放在头上~！", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "有一个人舔冰棒，为什么越舔冰棒越大支", category: "脑筋急转弯", answer: "他在南极舔", explain: "因为他在南极舔", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "小刘是个很普通的人，为什么竟然能一连十几个小时不眨眼", category: "脑筋急转弯", answer: "他已经睡了", explain: "因为他已经睡了", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "平平把鱼放在鱼缸里,不到十分钟鱼都死了,为什么", category: "脑筋急转弯", answer: "鱼缸内没有水", explain: "鱼缸内没有水", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "数个大小形状相同物体并排一起时，有无可能愈接近自己的东西看起来愈小，愈远离的物体看起来愈大", category: "脑筋急转弯", answer: "如使用镜子反射", explain: "如使用镜子反射，便可出现这种情况。", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "有瓶葡萄酒，小王用尽办法都无法拔开瓶盖，结果他不打破酒瓶，也不钻洞，仍然喝到了酒，为什么？", category: "脑筋急转弯", answer: "把软木塞塞到瓶子里", explain: "把软木塞塞到瓶子里", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "为什么闪电总是比雷快？", category: "脑筋急转弯", answer: "雷公说女士优先", explain: "因为雷公说女士优先", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "一条凶猛的眼镜蛇，在一个森林里它为什么不吃人。", category: "脑筋急转弯", answer: "森林里没有人", explain: "因为森林里没有人", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "车子应该靠右行使才对，为什么杨先生靠左行使却没事？", category: "脑筋急转弯", answer: "他正行驶在靠左行驶的国家", explain: "因为他正行驶在靠左行驶的国家", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "有两个人，一个面朝南一个面朝北的站立着，不准回头也不准照镜子，问他们能否看到对方的脸？", category: "脑筋急转弯", answer: "能，他们面对着站着", explain: "能，他们面对着站着", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "小赵买一张奖票,中了一等奖,去领奖却不给", category: "脑筋急转弯", answer: "没有到领奖的日期", explain: "没有到领奖的日期", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "小强在大雨的旷野中奔跑了十分钟，头发却没有湿，为什么？", category: "脑筋急转弯", answer: "小强打着伞", explain: "因为小强打着伞", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "别人跟阿丹说她的衣服怎么没衣扣，她却不在乎，为什么？", category: "脑筋急转弯", answer: "他的衣服只有拉链没有扣子", explain: "因为他的衣服只有拉链没有扣子", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "小陈有一天不小心撞到电线杆，为什么连手也会痛？", category: "脑筋急转弯", answer: "小陈狠狠地揍了电线杆一顿", explain: "因为小陈狠狠地揍了电线杆一顿", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
