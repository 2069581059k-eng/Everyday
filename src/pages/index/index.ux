  { question: "什么人可以一掷千金而面不改色？", category: "脑筋急转弯", answer: "正在逗儿子玩的爸爸.", explain: "正在逗儿子玩的爸爸.", source: "ChineseDatasets / brainteasers" },
  { question: "喝咖啡的时候，你觉得应该先加糖，还是奶精？", category: "脑筋急转弯", answer: "都不是应该先冲咖啡才是.", explain: "都不是应该先冲咖啡才是.", source: "ChineseDatasets / brainteasers" },
  { question: "为什么吃完晚餐后，全家都喜欢坐在电视机前看电视？", category: "脑筋急转弯", answer: "站久了脚会酸.", explain: "因为站久了脚会酸.", source: "ChineseDatasets / brainteasers" },
  { question: "小琪从事美容工作已经很多年了，为什么连个眼影都画不好？", category: "脑筋急转弯", answer: "他是给汽车美容.", explain: "他是给汽车美容.", source: "ChineseDatasets / brainteasers" },
  { question: "为什么女人的衣服总是少一件？", category: "脑筋急转弯", answer: "她穿在身上.", explain: "因为她穿在身上.", source: "ChineseDatasets / brainteasers" },
  { question: "什么人最喜欢日光浴？", category: "脑筋急转弯", answer: "植物人(光合作用).", explain: "植物人(光合作用).", source: "ChineseDatasets / brainteasers" },
  { question: "何谓「数大就是美」？", category: "脑筋急转弯", answer: "支票上的数大就是美.", explain: "支票上的数大就是美.", source: "ChineseDatasets / brainteasers" },
  { question: "小明点了一份全熟的牛排，但是为什么一切下去居然流出血来？", category: "脑筋急转弯", answer: "不小心切到手了.", explain: "因为不小心切到手了.", source: "ChineseDatasets / brainteasers" },
  { question: "早上八点整，北上，南下两列火车都准时通过同一条单线铁轨，为什么没有相撞呢？", category: "脑筋急转弯", answer: "日期不一样.", explain: "因为日期不一样.", source: "ChineseDatasets / brainteasers" },
  { question: "沿着山壁凿成的山路，因坍方而形成一个宽深的大洞，路边却没有警告标志，为什么？", category: "脑筋急转弯", answer: "大洞在山壁上,没有危险.", explain: "因为大洞在山壁上,没有危险.", source: "ChineseDatasets / brainteasers" },
  { question: "电脑与人脑有什么不同？", category: "脑筋急转弯", answer: "电脑可以搬家,而人脑不行.", explain: "电脑可以搬家,而人脑不行.", source: "ChineseDatasets / brainteasers" },
  { question: "糖与醋有什么不同？", category: "脑筋急转弯", answer: "你可以请别人吃糖", explain: "你可以请别人吃糖,但不可以请别人吃醋.", source: "ChineseDatasets / brainteasers" },
  { question: "苹果树上有一个苹果，一只小猴，请问树上有几个苹果，几只猴？", category: "脑筋急转弯", answer: "一个苹果一只猴子也没有", explain: "一个苹果一只猴子也没有,因为去打架去了.", source: "ChineseDatasets / brainteasers" },
  { question: "为什么说当作曲家不需要多大的智慧？", category: "脑筋急转弯", answer: "他只需要认识7个字就行了.", explain: "因为他只需要认识7个字就行了.", source: "ChineseDatasets / brainteasers" },
  { question: "蚂蚁、蜜蜂和蜈蚣，哪一种昆虫最不贪钱？", category: "脑筋急转弯", answer: "蜈蚣(因为无功不受禄)", explain: "蜈蚣(因为无功不受禄)", source: "ChineseDatasets / brainteasers" },
  { question: "小胖上完厕所为什么不洗手？", category: "脑筋急转弯", answer: "没有人规定上完厕所要洗手.", explain: "因为没有人规定上完厕所要洗手.", source: "ChineseDatasets / brainteasers" },
  { question: "文劭乘电梯上12楼，中间没有停，用了60秒；下楼时也没有停，却用了５分钟，为什么呢？", category: "脑筋急转弯", answer: "下楼没有做楼梯.", explain: "下楼没有做楼梯.", source: "ChineseDatasets / brainteasers" },
  { question: "每天早上是公鸡叫太阳起床还是太阳叫公鸡起床", category: "脑筋急转弯", answer: "都不是,是时间叫他们", explain: "都不是,是时间叫他们", source: "ChineseDatasets / brainteasers" },
  { question: "晴朗的天空，为什么没有太阳？？", category: "脑筋急转弯", answer: "晚上当然没有太阳", explain: "晚上当然没有太阳", source: "ChineseDatasets / brainteasers" },
  { question: "在香港生活的人，是不是可以埋葬在广州呢", category: "脑筋急转弯", answer: "活人是不能埋葬的", explain: "活人是不能埋葬的", source: "ChineseDatasets / brainteasers" },
  { question: "电单车时速80公里，向北行驶。有时速20公里的东风，请问电单车的烟，朝那个方向吹？", category: "脑筋急转弯", answer: "电车是没有烟的", explain: "电车是没有烟的", source: "ChineseDatasets / brainteasers" },
  { question: "印度人为什么用手抓饭吃？", category: "脑筋急转弯", answer: "手比脚干净", explain: "因为手比脚干净", source: "ChineseDatasets / brainteasers" },
  { question: "小赵买一张奖票,中了一等奖,去领奖却不给", category: "脑筋急转弯", answer: "没有到领奖的日期", explain: "没有到领奖的日期", source: "ChineseDatasets / brainteasers" },
  { question: "请你把九匹马平均放到十个马圈里，并让每个马圈里的马的数目都相同，怎么分？", category: "脑筋急转弯", answer: "把九匹马放到一个马圈里", explain: "把九匹马放到一个马圈里，然后在这个马圈外再套九个马", source: "ChineseDatasets / brainteasers" },
  { question: "为什么人们要到市场上去？", category: "脑筋急转弯", answer: "市场不能来", explain: "因为市场不能来", source: "ChineseDatasets / brainteasers" },
  { question: "网要什么时候可以提水", category: "脑筋急转弯", answer: "当水变成冰时，用网当然可以提", explain: "当水变成冰时，用网当然可以提", source: "ChineseDatasets / brainteasers" },
  { question: "一架飞机坐满了人，从万米高空落下坠毁，为什么却一个伤者也没有？", category: "脑筋急转弯", answer: "没有伤者，都摔死了", explain: "没有伤者，都摔死了", source: "ChineseDatasets / brainteasers" },
  { question: "别人跟阿丹说她的衣服怎么没衣扣，她却不在乎，为什么？", category: "脑筋急转弯", answer: "他的衣服只有拉链没有扣子", explain: "因为他的衣服只有拉链没有扣子", source: "ChineseDatasets / brainteasers" },
  { question: "小王走路从来脚不沾地，这是为什么", category: "脑筋急转弯", answer: "穿着鞋子", explain: "因为穿着鞋子", source: "ChineseDatasets / brainteasers" },
  { question: "冬冬的爸爸牙齿非常好，可是他经常去口腔医院，为什么", category: "脑筋急转弯", answer: "他是牙科医生", explain: "因为他是牙科医生", source: "ChineseDatasets / brainteasers" },
  { question: "一个警察有个弟弟，但弟弟却否认有个哥哥，为什么？", category: "脑筋急转弯", answer: "哪个警察上全女的", explain: "因为哪个警察上全女的", source: "ChineseDatasets / brainteasers" },
  { question: "为什么两只老虎打架,非要拼个你死我活绝不罢休？", category: "脑筋急转弯", answer: "没有人敢去劝架", explain: "没有人敢去劝架", source: "ChineseDatasets / brainteasers" },
  { question: "为什么游泳比赛中青蛙输给了狗？", category: "脑筋急转弯", answer: "青蛙用蛙泳犯规", explain: "青蛙用蛙泳犯规", source: "ChineseDatasets / brainteasers" },
  { question: "在罗马数字中，零该怎么写？", category: "脑筋急转弯", answer: "罗马数字没有零", explain: "罗马数字没有零", source: "ChineseDatasets / brainteasers" },
  { question: "沙沙声称自己是辨别母鸡年龄的专家，其绝招是用牙齿，为什么？", category: "脑筋急转弯", answer: "把鸡亲口吃了来辨别母鸡的老嫩", explain: "把鸡亲口吃了来辨别母鸡的老嫩", source: "ChineseDatasets / brainteasers" },
  { question: "公共汽车上，两个人正在热烈的交谈，可围观的人却一句话也听不到，这是因为什么？", category: "脑筋急转弯", answer: "这是一对聋哑人", explain: "这是一对聋哑人", source: "ChineseDatasets / brainteasers" },
  { question: "一个人掉到河里，还挣扎了几下，它从河里爬上来，衣服全湿了，头发却没湿，为什么？", category: "脑筋急转弯", answer: "他是光头", explain: "因为他是光头", source: "ChineseDatasets / brainteasers" },
  { question: "一个学生住在学校里，为什么上学还经常迟到？", category: "脑筋急转弯", answer: "家所在的学校不是他上学的学校", explain: "家所在的学校不是他上学的学校", source: "ChineseDatasets / brainteasers" },
  { question: "猪的全身都是宝，用处很大，猪对人类还有什么用处？", category: "脑筋急转弯", answer: "还可以用来骂人", explain: "还可以用来骂人", source: "ChineseDatasets / brainteasers" },
  { question: "为什么女人穿高跟鞋后，就代表她想要结婚了", category: "脑筋急转弯", answer: "穿上高跟鞋", explain: "因为穿上高跟鞋，别人追就跑得慢啊。", source: "ChineseDatasets / brainteasers" },
  { question: "换心手术失败，医生问快要断气的病人有什么遗言要交代，你猜他会说什么？", category: "脑筋急转弯", answer: "你不懂我的心", explain: "其实你不懂我的心", source: "ChineseDatasets / brainteasers" },
  { question: "香港生活的人，是不是可以埋葬在广州呢？", category: "脑筋急转弯", answer: "活人怎么可以埋呢", explain: "活人怎么可以埋呢", source: "ChineseDatasets / brainteasers" },
  { question: "有个人说用牙齿可以判断鸡的年龄，为什么？", category: "脑筋急转弯", answer: "牙可以嚼出肉的老嫩", explain: "牙可以嚼出肉的老嫩", source: "ChineseDatasets / brainteasers" },
  { question: "时钟什么时候不会走？", category: "脑筋急转弯", answer: "时钟本来就不会走", explain: "时钟本来就不会走", source: "ChineseDatasets / brainteasers" },
  { question: "打狗看主人，打虎看什么？", category: "脑筋急转弯", answer: "看你有没有种", explain: "看你有没有种", source: "ChineseDatasets / brainteasers" },
  { question: "在“不，仁，王，O，吾”的“O”位置，应当填写“东，南，西，北，中”的哪个字？", category: "脑筋急转弯", answer: "应该是西", explain: "应该是西！因为前几个字中分别有一、二、三、五", source: "ChineseDatasets / brainteasers" },
  { question: "老大和老幺之间隔着三兄弟，虽是同年同月同日生，却一点也不相象，为什么？", category: "脑筋急转弯", answer: "他们是手指头", explain: "他们是手指头", source: "ChineseDatasets / brainteasers" },
  { question: "亚当和夏娃结婚后最大的遗憾是什么", category: "脑筋急转弯", answer: "没有人来喝喜酒", explain: "没有人来喝喜酒", source: "ChineseDatasets / brainteasers" },
  { question: "一个招牌突然由高处掉落,砸向并排行走的五个人,为什么只有三个人受伤", category: "脑筋急转弯", answer: "帮当劳M的招牌", explain: "因为帮当劳M的招牌", source: "ChineseDatasets / brainteasers" },
  { question: "每对夫妻在生活中都有一个绝对的共同点，那是什么", category: "脑筋急转弯", answer: "就是同年同月同日结婚", explain: "就是同年同月同日结婚", source: "ChineseDatasets / brainteasers" },
  { question: "为什么青蛙可以跳得比树高？", category: "脑筋急转弯", answer: "树根本就不会跳嘛！", explain: "因为树根本就不会跳嘛！", source: "ChineseDatasets / brainteasers" },
  { question: "有一个女孩子穿着泳衣在沙滩上走，为什么在她的身后却没有脚印？", category: "脑筋急转弯", answer: "她是倒着走的。", explain: "因为她是倒着走的。", source: "ChineseDatasets / brainteasers" },
  { question: "有一艘船限载50人，船上已有49人后，再加上一個孕妇上了船，结果船沉入海中，为什么？", category: "脑筋急转弯", answer: "他们坐的是潜水艇", explain: "他们坐的是潜水艇", source: "ChineseDatasets / brainteasers" },
  { question: "一个人被老虎穷追不舍，突然前面有一条大河,他不会游泳，但他却过去了，为什么？", category: "脑筋急转弯", answer: "他是昏过去了", explain: "他是昏过去了", source: "ChineseDatasets / brainteasers" },
  { question: "为什么流氓坐车不用给钱？", category: "脑筋急转弯", answer: "哪是一辆警车", explain: "因为哪是一辆警车", source: "ChineseDatasets / brainteasers" },
  { question: "为什么大家都说小毛吃人肉不吐骨头？", category: "脑筋急转弯", answer: "他吃掉了一个面人。", explain: "因为他吃掉了一个面人。", source: "ChineseDatasets / brainteasers" },
  { question: "为什么蝙蝠会经常倒吊着？", category: "脑筋急转弯", answer: "它胃下垂", explain: "因为它胃下垂", source: "ChineseDatasets / brainteasers" },
  { question: "一条小船要渡３７人，一次只能有７人，几次能渡完？", category: "脑筋急转弯", answer: "六次", explain: "六次，因为每次得回来一个划船的", source: "ChineseDatasets / brainteasers" },
  { question: "一对健康夫妇，为什么生出只有一只右眼的婴儿？", category: "脑筋急转弯", answer: "每个人都只有一只右眼", explain: "每个人都只有一只右眼", source: "ChineseDatasets / brainteasers" },
  { question: "为什么熊冬眠时会睡这么久？", category: "脑筋急转弯", answer: "没有人敢叫它起床", explain: "没有人敢叫它起床", source: "ChineseDatasets / brainteasers" },
  { question: "幼儿园放学了，但却没有一个小朋友从大门出去，是怎么回事呢？", category: "脑筋急转弯", answer: "大门正在检修，请走测门", explain: "大门正在检修，请走测门", source: "ChineseDatasets / brainteasers" },
  { question: "鸡蛋壳有什么用处？", category: "脑筋急转弯", answer: "用来包蛋清和蛋黄", explain: "用来包蛋清和蛋黄", source: "ChineseDatasets / brainteasers" },
  { question: "有一种路虽然四通八达，但就是不能走人，为什么？", category: "脑筋急转弯", answer: "哪是电路", explain: "因为哪是电路", source: "ChineseDatasets / brainteasers" },
  { question: "有一个人只有三根头发，为什么在参加宴会时还要拔掉一根？", category: "脑筋急转弯", answer: "他想中分", explain: "因为他想中分", source: "ChineseDatasets / brainteasers" },
  { question: "有个人说用牙齿可以判断„„", category: "脑筋急转弯", answer: "牙可以嚼出肉的老嫩", explain: "牙可以嚼出肉的老嫩", source: "ChineseDatasets / brainteasers" },
  { question: "一个人掉到河里，，它从河里爬上来，头发却没湿，为什么？", category: "脑筋急转弯", answer: "他是光头", explain: "因为他是光头", source: "ChineseDatasets / brainteasers" },
  { question: "冬天里，不通过加热，如何才能把冰立刻变成水？", category: "脑筋急转弯", answer: "把冰的两点去掉", explain: "把冰的两点去掉", source: "ChineseDatasets / brainteasers" },
  { question: "先有男人，还是先有女人", category: "脑筋急转弯", answer: "先有男人", explain: "先有男人，因为男人是先生的，所以叫先生", source: "ChineseDatasets / brainteasers" },
  { question: "大雁为什么要向南飞", category: "脑筋急转弯", answer: "用脚走太慢了", explain: "因为用脚走太慢了", source: "ChineseDatasets / brainteasers" },
  { question: "印度人为什么用手抓饭？", category: "脑筋急转弯", answer: "手比脚干净", explain: "因为手比脚干净", source: "ChineseDatasets / brainteasers" },
  { question: "在一次考试中，两个学生交了一模一样的考卷，但老师认为他们肯定没有做弊，这是为什么？", category: "脑筋急转弯", answer: "他们交的是白卷", explain: "他们交的是白卷", source: "ChineseDatasets / brainteasers" },
  { question: "孔子和孟子有什么不同？", category: "脑筋急转弯", answer: "孔子把儿子牵在身边", explain: "孔子把儿子牵在身边，而孟子把儿子放在头上~！", source: "ChineseDatasets / brainteasers" },
  { question: "林老生大手术后换了一个人工心脏。病好了后,她的女友却马上提出分手,为什么会这样", category: "脑筋急转弯", answer: "没有真心爱她", explain: "没有真心爱她", source: "ChineseDatasets / brainteasers" },
  { question: "森林中有十只鸟，开枪打死一只，为什么其它九只不飞走？", category: "脑筋急转弯", answer: "它是驼鸟", explain: "因为它是驼鸟", source: "ChineseDatasets / brainteasers" },
  { question: "小华明天考试，他已经把英语背得滚瓜烂熟，第二天考试还是不及格，为什么？", category: "脑筋急转弯", answer: "第二天不是考英语", explain: "第二天不是考英语", source: "ChineseDatasets / brainteasers" },
  { question: "小明知道试卷的答案，为什么还频频看同学的？", category: "脑筋急转弯", answer: "小明是老师", explain: "因为小明是老师", source: "ChineseDatasets / brainteasers" },
  { question: "警察面对两名歹徒，但他只剩下一颗子弹，他对歹徒说：谁动就打谁，结果没动的反而挨子弹，为什么？", category: "脑筋急转弯", answer: "不动的比较好打", explain: "因为不动的比较好打", source: "ChineseDatasets / brainteasers" },
  { question: "电线杆上三只麻雀正在打架，当中一只不小心掉下來，为什么其他两只也跟着掉下來？", category: "脑筋急转弯", answer: "那两只拍手的时候掉了下来", explain: "因为那两只拍手的时候掉了下来", source: "ChineseDatasets / brainteasers" },
  { question: "两个棋友一天共下了9盘棋,在没有和局的情况下他俩赢的次数相同,怎么回事", category: "脑筋急转弯", answer: "9盘不全是他们两个人一起下的", explain: "9盘不全是他们两个人一起下的", source: "ChineseDatasets / brainteasers" },
  { question: "小明正在吹电扇,为什么还是满头大汗？", category: "脑筋急转弯", answer: "他在吹电扇，电扇没有吹他", explain: "他在吹电扇，电扇没有吹他", source: "ChineseDatasets / brainteasers" },
  { question: "为什么自由女神像老站在纽约港？", category: "脑筋急转弯", answer: "她坐不下去", explain: "因为她坐不下去", source: "ChineseDatasets / brainteasers" },
  { question: "胖胖是个颇有名气的跳水运动员，可是有一天，他站在跳台上，却不敢往下跳。这是为什么？", category: "脑筋急转弯", answer: "下面没有水", explain: "因为下面没有水", source: "ChineseDatasets / brainteasers" },
  { question: "小李因工作需要常应酬交际，虽然每天都很早回家，可是老婆还是抱怨不断。为什么？", category: "脑筋急转弯", answer: "他是早上回家", explain: "他是早上回家", source: "ChineseDatasets / brainteasers" },
  { question: "路边电线杆上蹲着一只猴子，司机小李看到就立刻停下车来，请问为什么", category: "脑筋急转弯", answer: "他把猴子屁股当红灯了", explain: "他把猴子屁股当红灯了", source: "ChineseDatasets / brainteasers" },
  { question: "有一条异常凶猛的大眼镜王蛇，但不论如何去激怒它，它都不咬人，为什么？", category: "脑筋急转弯", answer: "它住在一个根本没有人的森林", explain: "因为它住在一个根本没有人的森林", source: "ChineseDatasets / brainteasers" },
  { question: "小李昨天在客户面前骂总经理是笨蛋，结果小李被开除了，为什么？", category: "脑筋急转弯", answer: "小李泄露了公司的最高机密", explain: "因为小李泄露了公司的最高机密", source: "ChineseDatasets / brainteasers" },
  { question: "华先生有个本领，那就是能让见到他的人，都会自动手心朝上。这是怎么回事？", category: "脑筋急转弯", answer: "他是个中医", explain: "因为他是个中医", source: "ChineseDatasets / brainteasers" },
  { question: "三个人共撑一把伞在街上走,却没有淋湿身,为什么", category: "脑筋急转弯", answer: "根本没有下雨", explain: "根本没有下雨", source: "ChineseDatasets / brainteasers" },
  { question: "“只”字加一笔，变成什么字？", category: "脑筋急转弯", answer: "冲（先把“只”立起来）", explain: "冲（先把“只”立起来）", source: "ChineseDatasets / brainteasers" },
  { question: "空着肚子能吃几个鸡蛋？", category: "脑筋急转弯", answer: "一个", explain: "一个，因为再吃的时候就不是空着肚子了", source: "ChineseDatasets / brainteasers" },
  { question: "有一个人，他是你父母生的，但他却不是你的兄弟姐妹，他是谁？", category: "脑筋急转弯", answer: "他就是你自己", explain: "他就是你自己", source: "ChineseDatasets / brainteasers" },
  { question: "你说问别人什么问题是，老是回答“没有”？", category: "脑筋急转弯", answer: "你睡了没有？", explain: "你睡了没有？", source: "ChineseDatasets / brainteasers" },
  { question: "一个人背一个包，刚一出门，就摔死了，为什么？", category: "脑筋急转弯", answer: "他在飞机上", explain: "因为他在飞机上", source: "ChineseDatasets / brainteasers" },
  { question: "船边挂着软梯，离海面2米，海水每小时上涨半米，几个小时海水能淹没软梯", category: "脑筋急转弯", answer: "水涨船高", explain: "水涨船高，所以永远不会淹没软梯", source: "ChineseDatasets / brainteasers" },
  { question: "小明的小猫从来不捉老鼠,这是为什么", category: "脑筋急转弯", answer: "这是玩具猫", explain: "因为这是玩具猫", source: "ChineseDatasets / brainteasers" },
  { question: "一个人空肚子最多能吃几个鸡蛋？", category: "脑筋急转弯", answer: "只能一个", explain: "只能一个。因为吃第二个的时候已经不是空肚子了。", source: "ChineseDatasets / brainteasers" },
  { question: "我不会轻功，反一只脚搭在鸡蛋上，鸡蛋却不会破，这是为什么？", category: "脑筋急转弯", answer: "另一只脚站在地上", explain: "因为另一只脚站在地上", source: "ChineseDatasets / brainteasers" },
  { question: "为什么冬天大雁要飞到南方去？", category: "脑筋急转弯", answer: "它只会飞呀", explain: "因为它只会飞呀", source: "ChineseDatasets / brainteasers" },
  { question: "一个很古老的题目。把大象装进冰箱要几步？", category: "脑筋急转弯", answer: "三步", explain: "三步，先打开冰箱，再把大象放进去，最后把冰箱门关上", source: "ChineseDatasets / brainteasers" },
  { question: "小李说“我前的人是小王”小王说“我前面的人是小李”怎么回事？", category: "脑筋急转弯", answer: "很简单，他们面对面的站着", explain: "很简单，他们面对面的站着", source: "ChineseDatasets / brainteasers" },
  { question: "有一个地方失火，可是却没人打火警电话？", category: "脑筋急转弯", answer: "那个地方就是消防局", explain: "因为那个地方就是消防局", source: "ChineseDatasets / brainteasers" },
  { question: "小立在街上走，前面有个人掉了一块肉和一个钱包，小立为什么捡肉不捡钱包，钱包里有很多钱", category: "脑筋急转弯", answer: "小立是狗", explain: "因为小立是狗", source: "ChineseDatasets / brainteasers" },
  { question: "警察看见有人抢银行却不抓。为什么？", category: "脑筋急转弯", answer: "抢银行的人是在拍电影", explain: "因为抢银行的人是在拍电影", source: "ChineseDatasets / brainteasers" },
  { question: "小刘是个很普通的人，为什么竟然能一连十几个小时不眨眼", category: "脑筋急转弯", answer: "他已经睡了", explain: "因为他已经睡了", source: "ChineseDatasets / brainteasers" },
  { question: "小张被关在一间没有上锁的房里，可是他使出吃奶的力气也不能把门拉开，这是为什么？", category: "脑筋急转弯", answer: "推开就可以了", explain: "推开就可以了", source: "ChineseDatasets / brainteasers" },
  { question: "某人用面条上吊，结果真的死了。为什么？", category: "脑筋急转弯", answer: "他是掉下来摔死的。", explain: "他是掉下来摔死的。", source: "ChineseDatasets / brainteasers" },
  { question: "小红和妈妈去买熟鸡蛋，为什么别人不卖给她？", category: "脑筋急转弯", answer: "那鸡蛋是生的", explain: "因为那鸡蛋是生的", source: "ChineseDatasets / brainteasers" },
  { question: "小明是高的儿子但是小明却不肯喊他爸爸，为什么？", category: "脑筋急转弯", answer: "高是小明的妈妈", explain: "因为高是小明的妈妈", source: "ChineseDatasets / brainteasers" },
  { question: "小明从20楼跳下来，可他一点事都没有，为什么？", category: "脑筋急转弯", answer: "他是往房子里面跳呀。", explain: "他是往房子里面跳呀。", source: "ChineseDatasets / brainteasers" },
  { question: "大雁为什么往南飞？", category: "脑筋急转弯", answer: "飞比走要快。", explain: "因为飞比走要快。", source: "ChineseDatasets / brainteasers" },
  { question: "好马不吃回头草是什么意思？", category: "脑筋急转弯", answer: "后面没有草可吃了", explain: "后面没有草可吃了", source: "ChineseDatasets / brainteasers" },
  { question: "小明的肚子快要涨破了他为什么还要不听的喝水？", category: "脑筋急转弯", answer: "小明掉进河里了，他不会游泳", explain: "因为小明掉进河里了，他不会游泳", source: "ChineseDatasets / brainteasers" },
  { question: "先有鸡还是先有蛋？", category: "脑筋急转弯", answer: "先有蛋", explain: "先有蛋，因为在新华字典里面蛋在鸡的前面", source: "ChineseDatasets / brainteasers" },
  { question: "一个老大爷住在一栋18层的房子了，但他天天都不用电梯？为什么？", category: "脑筋急转弯", answer: "他住一楼", explain: "因为他住一楼", source: "ChineseDatasets / brainteasers" },
  { question: "什么东西不能吃？", category: "脑筋急转弯", answer: "东西本来就不能吃", explain: "东西本来就不能吃，因为东西是方向", source: "ChineseDatasets / brainteasers" },
  { question: "家在北京的老王想去上海，要花多少钱？", category: "脑筋急转弯", answer: "只是想，不用花钱", explain: "只是想，不用花钱", source: "ChineseDatasets / brainteasers" },
  { question: "鱼儿为什么不说话？", category: "脑筋急转弯", answer: "他在水里", explain: "因为他在水里", source: "ChineseDatasets / brainteasers" },
  { question: "小强在大雨的旷野中奔跑了十分钟，头发却没有湿，为什么？", category: "脑筋急转弯", answer: "小强打着伞", explain: "因为小强打着伞", source: "ChineseDatasets / brainteasers" },
  { question: "为什么他在大街上捡了一个钱包而不上交？", category: "脑筋急转弯", answer: "钱包是他自己的", explain: "因为钱包是他自己的", source: "ChineseDatasets / brainteasers" },
  { question: "电线干上有三只鸟在打架，为什么一只鸟掉了下来，另外的二只也掉了下来？", category: "脑筋急转弯", answer: "他们拍手叫好，所以也掉了下来", explain: "因为他们拍手叫好，所以也掉了下来", source: "ChineseDatasets / brainteasers" },
  { question: "一个司机飞快的从山上冲下来,却没有撞伤人,为什么", category: "脑筋急转弯", answer: "司机并没有开车", explain: "司机并没有开车", source: "ChineseDatasets / brainteasers" },
  { question: "飞得最高的是什么", category: "脑筋急转弯", answer: "人，他们飞到过月球", explain: "人，他们飞到过月球", source: "ChineseDatasets / brainteasers" },
  { question: "为什么小王写了一个字，人人都说他写了错字？", category: "脑筋急转弯", answer: "他本身就写了个错字", explain: "因为他本身就写了个错字", source: "ChineseDatasets / brainteasers" },
  { question: "什么鸭子用两只脚走路？", category: "脑筋急转弯", answer: "所有的鸭子都是用两只脚走路", explain: "所有的鸭子都是用两只脚走路", source: "ChineseDatasets / brainteasers" },
  { question: "今天下午到旺角看电影，到了旺角，半个人也看不见，为什么？", category: "脑筋急转弯", answer: "人是没有半个的。", explain: "人是没有半个的。", source: "ChineseDatasets / brainteasers" },
  { question: "网子里怎么装水？", category: "脑筋急转弯", answer: "装冰就可以了。", explain: "装冰就可以了。", source: "ChineseDatasets / brainteasers" },
  { question: "为什么小弟开车遇见交叉道从不停车", category: "脑筋急转弯", answer: "他以前是开火车的。", explain: "因为他以前是开火车的。", source: "ChineseDatasets / brainteasers" },
  { question: "毛说：１０＋４＝２，老师也说对，为什么？", category: "脑筋急转弯", answer: "他是说的时间", explain: "他是说的时间，10点加4点等于两点钟", source: "ChineseDatasets / brainteasers" },
  { question: "按照1、12、1、1、1、2„„规律写，接着该怎么写？", category: "脑筋急转弯", answer: "接下去是1、3、1、4", explain: "接下去是1、3、1、4....这是挂钟打点的声音", source: "ChineseDatasets / brainteasers" },
  { question: "法国人的笑声跟我们有什么不同？", category: "脑筋急转弯", answer: "他们是用法语笑的", explain: "他们是用法语笑的", source: "ChineseDatasets / brainteasers" },
  { question: "70元的牛排，付帐时只付了210元，为什么？", category: "脑筋急转弯", answer: "这是祖孙三人", explain: "这是祖孙三人", source: "ChineseDatasets / brainteasers" },
  { question: "长4米,宽3米,深2米的池塘,有多少立方米泥", category: "脑筋急转弯", answer: "池塘是空的，没有泥。", explain: "池塘是空的，没有泥。", source: "ChineseDatasets / brainteasers" },
  { question: "50块糖分给10个小朋友,数目不同,不可把糖块截断,能不能分", category: "脑筋急转弯", answer: "不能", explain: "不能，因为“1+2+3.....+10”=55", source: "ChineseDatasets / brainteasers" },
  { question: "刚上幼儿园第一天的Rose，从来没学过数学，但老师却称赞她的数学程度是数一数二的，为什么？", category: "脑筋急转弯", answer: "他只会数一数二的。", explain: "因为他只会数一数二的。", source: "ChineseDatasets / brainteasers" },
  { question: "打狗要看主人，打虎要看什么？", category: "脑筋急转弯", answer: "要看你有没有种", explain: "要看你有没有种", source: "ChineseDatasets / brainteasers" },
  { question: "小王中午时候去开会，为什么半个人影也没看到？", category: "脑筋急转弯", answer: "影子是没有半个的。", explain: "影子是没有半个的。", source: "ChineseDatasets / brainteasers" },
  { question: "为什么白羊比黑羊吃得多一些？", category: "脑筋急转弯", answer: "世界上的白羊比黑羊多", explain: "因为世界上的白羊比黑羊多", source: "ChineseDatasets / brainteasers" },
  { question: "一根木头重5吨，从上游到到下游，需船载重为多少的船？", category: "脑筋急转弯", answer: "不用船", explain: "不用船，把木头放在水里就可以从上游运到下游了。", source: "ChineseDatasets / brainteasers" },
  { question: "阿里巴巴与四十大盗的故事是东方夜谭还是西方夜谭？", category: "脑筋急转弯", answer: "都不是，是天方夜谈", explain: "都不是，是天方夜谈", source: "ChineseDatasets / brainteasers" },
  { question: "一场大雨，忙着耕种的农民纷纷躲避，却仍有一个人不走，为什么？", category: "脑筋急转弯", answer: "那是一个稻草人", explain: "那是一个稻草人", source: "ChineseDatasets / brainteasers" },
  { question: "小小的妈妈在洗衣服，但洗了半天，她的衣服还是脏的，为什么？", category: "脑筋急转弯", answer: "她是洗的别人的衣服", explain: "因为她是洗的别人的衣服", source: "ChineseDatasets / brainteasers" },
  { question: "小王13岁的生日为何点了14根蜡烛", category: "脑筋急转弯", answer: "那晚停电", explain: "那晚停电，有一根是用来照明的。", source: "ChineseDatasets / brainteasers" },
  { question: "数个大小形状相同物体并排一起时，有无可能愈接近自己的东西看起来愈小，愈远离的物体看起来愈大", category: "脑筋急转弯", answer: "如使用镜子反射", explain: "如使用镜子反射，便可出现这种情况。", source: "ChineseDatasets / brainteasers" },
  { question: "小明从来没去过美国，他想去美国，至少应花多少钱？", category: "脑筋急转弯", answer: "光想是不用花钱的。", explain: "光想是不用花钱的。", source: "ChineseDatasets / brainteasers" },
  { question: "兔子为什么不吃窝边草？", category: "脑筋急转弯", answer: "如果兔子吃了窝边草的话", explain: "如果兔子吃了窝边草的话，那它的窝就没有可以隐藏的东", source: "ChineseDatasets / brainteasers" },
  { question: "喜剧和悲剧有什么联系？", category: "脑筋急转弯", answer: "喜剧没有人看就成了悲剧", explain: "喜剧没有人看就成了悲剧", source: "ChineseDatasets / brainteasers" },
  { question: "桌子上有12支点燃的蜡烛，先被风吹灭了3根，不久又一阵风吹灭了2根，最后桌子上还剩几根蜡烛？", category: "脑筋急转弯", answer: "5根", explain: "5根，因为没被吹灭的都燃完了。", source: "ChineseDatasets / brainteasers" },
  { question: "马亚买了新音响，电源开了录音带也放了，为什么没有声音呢？", category: "脑筋急转弯", answer: "停电了。", explain: "因为停电了。", source: "ChineseDatasets / brainteasers" },
  { question: "动物园的大象死了，为什么大象管理员哭得那么伤心？", category: "脑筋急转弯", answer: "他想到要挖那么大一个坑", explain: "他想到要挖那么大一个坑，所以就....", source: "ChineseDatasets / brainteasers" },
  { question: "停电的时候,我们点着蜡烛为什么能看电视", category: "脑筋急转弯", answer: "看不了电视节目", explain: "看不了电视节目，但可以看着电视机", source: "ChineseDatasets / brainteasers" },
  { question: "大眼镜蛇王，是一种非常凶猛的毒蛇，但无论如何激怒它，它都不咬人，为什么？", category: "脑筋急转弯", answer: "它在一个没有人的密林里", explain: "因为它在一个没有人的密林里", source: "ChineseDatasets / brainteasers" },
  { question: "邻居老李家的屋顶为什么有时漏雨，有时不漏雨？", category: "脑筋急转弯", answer: "雨天漏雨，晴天不漏雨。", explain: "因为雨天漏雨，晴天不漏雨。", source: "ChineseDatasets / brainteasers" },
  { question: "一个推车的，一个挑担的，同时要过独木桥，一个南来，一个北往，有什么办法让他们同时过？", category: "脑筋急转弯", answer: "南来是往北", explain: "南来是往北，北往也是往北，同时过桥就是。", source: "ChineseDatasets / brainteasers" },
  { question: "为什么一只青蛙在水里游不过一只狗？", category: "脑筋急转弯", answer: "比赛中禁止用蛙泳。", explain: "因为比赛中禁止用蛙泳。", source: "ChineseDatasets / brainteasers" },
  { question: "有一个女生，她可以不洗澡、不换衣服，但她的衣服是世界最貴的，請问他是谁？", category: "脑筋急转弯", answer: "她是自由女神", explain: "她是自由女神", source: "ChineseDatasets / brainteasers" },
  { question: "爱吃零食的小王体重最重时有50公斤，但最轻时只有3公斤，为什么？", category: "脑筋急转弯", answer: "那是他刚出生的时候", explain: "那是他刚出生的时候", source: "ChineseDatasets / brainteasers" },
  { question: "阿美在事业并没有什么成就，为什么也有女强人的外号？", category: "脑筋急转弯", answer: "她常常强人所难", explain: "因为她常常强人所难", source: "ChineseDatasets / brainteasers" },
  { question: "十只鸟，小明开枪打死了一只，其它九只却都没有飞走，为什么", category: "脑筋急转弯", answer: "那是一群驼鸟", explain: "那是一群驼鸟", source: "ChineseDatasets / brainteasers" },
  { question: "在地上有100元钱和一块肉骨头，可是阿明却拣了肉骨头，请问为什么？", category: "脑筋急转弯", answer: "阿明是条狗", explain: "因为阿明是条狗", source: "ChineseDatasets / brainteasers" },
  { question: "“水蛇”“蟒蛇”“青竹蛇”哪一个比较长？", category: "脑筋急转弯", answer: "“青竹蛇”最长", explain: "“青竹蛇”最长，因为它有三个字", source: "ChineseDatasets / brainteasers" },
  { question: "小张把一个鸡蛋扔到一米以外的地方去，鸡蛋却没有破，为什么？", category: "脑筋急转弯", answer: "鸡蛋还没有落地", explain: "鸡蛋还没有落地", source: "ChineseDatasets / brainteasers" },
  { question: "王既不买票有没有月票的为什么可以从起点坐到终点", category: "脑筋急转弯", answer: "他是司机", explain: "因为他是司机", source: "ChineseDatasets / brainteasers" },
  { question: "小明家很富裕,可他想买玩具时却从不向母亲要一分钱,为什么", category: "脑筋急转弯", answer: "一分钱买不到玩具", explain: "因为一分钱买不到玩具", source: "ChineseDatasets / brainteasers" },
  { question: "老王每天都要刮很多遍脸，可脸上还是有胡子为什么？", category: "脑筋急转弯", answer: "他是在替别人刮脸。", explain: "他是在替别人刮脸。", source: "ChineseDatasets / brainteasers" },
  { question: "小张一直朝北走,走着走着他又没有转身可是却走到了正南方,为什么", category: "脑筋急转弯", answer: "他越过北极点在向前走就是南方", explain: "他越过北极点在向前走就是南方", source: "ChineseDatasets / brainteasers" },
  { question: "为什么现代人越来越言而无信", category: "脑筋急转弯", answer: "有了电话", explain: "因为有了电话", source: "ChineseDatasets / brainteasers" },
  { question: "一家业务繁忙的医院却没有病床,为什么", category: "脑筋急转弯", answer: "是家兽医院", explain: "因为是家兽医院", source: "ChineseDatasets / brainteasers" },
  { question: "一个功夫极好的人为什么跳不过他师傅给他画的一个圈", category: "脑筋急转弯", answer: "小圈是绕着这个人的腰画的", explain: "因为小圈是绕着这个人的腰画的", source: "ChineseDatasets / brainteasers" },
  { question: "什么有的果树生长十几年也不接一个苹果", category: "脑筋急转弯", answer: "那不是一颗苹果树", explain: "那不是一颗苹果树", source: "ChineseDatasets / brainteasers" },
  { question: "想从北京到巴黎,要多少钱", category: "脑筋急转弯", answer: "不要钱,因为只是想一想", explain: "不要钱,因为只是想一想", source: "ChineseDatasets / brainteasers" },
  { question: "如何从一半是水,一半是油的缸中取水不取油", category: "脑筋急转弯", answer: "从缸底部打个洞取水", explain: "从缸底部打个洞取水,因为水的比重比油大.", source: "ChineseDatasets / brainteasers" },
  { question: "小红和小李互相吹牛,小红说她可以把整个世界吃下去,小李说了什么胜过了小红", category: "脑筋急转弯", answer: "小李说,我可以把你吃下去", explain: "小李说,我可以把你吃下去", source: "ChineseDatasets / brainteasers" },
  { question: "龟兔又赛跑了,这次兔子没有偷懒、贪玩但是这次兔子还是输了,为什么", category: "脑筋急转弯", answer: "乌龟把终点设在了海里", explain: "乌龟把终点设在了海里", source: "ChineseDatasets / brainteasers" },
  { question: "一个人掉进游泳池里,他的脚却没有湿,为什么", category: "脑筋急转弯", answer: "游泳池中没有水", explain: "游泳池中没有水", source: "ChineseDatasets / brainteasers" },
  { question: "两只长约7cm的红、黑螃蟹赛跑,谁会赢", category: "脑筋急转弯", answer: "黑螃蟹,因为红螃蟹是煮熟了的", explain: "黑螃蟹,因为红螃蟹是煮熟了的", source: "ChineseDatasets / brainteasers" },
  { question: "为什么阿郎穿着全新没破洞的雨衣,却依然弄的全身湿透", category: "脑筋急转弯", answer: "他在太阳底下穿着雨衣走路", explain: "因为他在太阳底下穿着雨衣走路", source: "ChineseDatasets / brainteasers" },
  { question: "平平把鱼放在鱼缸里,不到十分钟鱼都死了,为什么", category: "脑筋急转弯", answer: "鱼缸内没有水", explain: "鱼缸内没有水", source: "ChineseDatasets / brainteasers" },
  { question: "什么交通工具速度越慢越让人恐惧", category: "脑筋急转弯", answer: "正在飞行的飞机", explain: "正在飞行的飞机", source: "ChineseDatasets / brainteasers" },
  { question: "红和绿豆放在一个碟子里,小王为什么一下就把它们分开了", category: "脑筋急转弯", answer: "红豆和绿豆一样只有一颗", explain: "红豆和绿豆一样只有一颗", source: "ChineseDatasets / brainteasers" },
  { question: "王和李都睁一只眼闭一只眼做事,为什么王得表演,李受处分", category: "脑筋急转弯", answer: "王是射击运动员", explain: "因为王是射击运动员,李是仓库保管员", source: "ChineseDatasets / brainteasers" },
  { question: "共汽车上，两个人正在热烈的交谈，可围观的人却一句话也听不到，这是因为什么？", category: "脑筋急转弯", answer: "这是一对聋哑人", explain: "这是一对聋哑人", source: "ChineseDatasets / brainteasers" },
  { question: "有两个人，一个面朝南一个面朝北的站立着，不准回头也不准照镜子，问他们能否看到对方的脸？", category: "脑筋急转弯", answer: "能，他们面对着站着", explain: "能，他们面对着站着", source: "ChineseDatasets / brainteasers" },
  { question: "为什么自由泳比赛中青蛙输给了狗？", category: "脑筋急转弯", answer: "青蛙用蛙泳犯规", explain: "青蛙用蛙泳犯规", source: "ChineseDatasets / brainteasers" },
  { question: "为什么老虎打架,非要拼个你死我活绝不罢休？", category: "脑筋急转弯", answer: "没有人敢去劝架", explain: "没有人敢去劝架", source: "ChineseDatasets / brainteasers" },
  { question: "为什么大雁秋天要飞到南方去？", category: "脑筋急转弯", answer: "走太慢了", explain: "因为走太慢了", source: "ChineseDatasets / brainteasers" },
  { question: "有一种棋只有两种棋子，你知道是什么棋类吗？", category: "脑筋急转弯", answer: "围棋，只有黑棋和白棋", explain: "围棋，只有黑棋和白棋", source: "ChineseDatasets / brainteasers" },
  { question: "阿呆从热气球上掉下来，却没有受伤，为什么？", category: "脑筋急转弯", answer: "热球就在地面上", explain: "因为热球就在地面上", source: "ChineseDatasets / brainteasers" },
  { question: "江河流水归一处（打一字）", category: "脑筋急转弯", answer: "“珂”", explain: "“珂”，因为“江河”两字去“水”后成“工可”，再加", source: "ChineseDatasets / brainteasers" },
  { question: "李哲看起来平平常常，并无什么特别之处，但他却可以连续数小时不眨眼睛，他是怎么做到的呢？", category: "脑筋急转弯", answer: "把眼睛闭上就可以做到了", explain: "把眼睛闭上就可以做到了", source: "ChineseDatasets / brainteasers" },
  { question: "乌龟为什么会突然「一个头两个大」？", category: "脑筋急转弯", answer: "乌龟正在想这个问题", explain: "因为乌龟正在想这个问题", source: "ChineseDatasets / brainteasers" },
  { question: "考试时，小光全部都抄小明的，为什么小明得到一百分，小光却零分呢？", category: "脑筋急转弯", answer: "小光连名字都抄小明的", explain: "因为小光连名字都抄小明的", source: "ChineseDatasets / brainteasers" },
  { question: "小胖为什么吃两个便当？", category: "脑筋急转弯", answer: "三个便当吃不下", explain: "因为三个便当吃不下", source: "ChineseDatasets / brainteasers" },
  { question: "為什么男人和女人会分手？", category: "脑筋急转弯", answer: "男女有「別」", explain: "因为男女有「別」", source: "ChineseDatasets / brainteasers" },
  { question: "废除早自习会造成什么影响？", category: "脑筋急转弯", answer: "让学生和家长可以多赖床半小时", explain: "让学生和家长可以多赖床半小时。", source: "ChineseDatasets / brainteasers" },
  { question: "为什么大家都喜欢坐在电视机前看电视？", category: "脑筋急转弯", answer: "站久了脚会酸。", explain: "因为站久了脚会酸。", source: "ChineseDatasets / brainteasers" },
  { question: "同事们在小张家喝酒、聊天，酒过三巡后，为什么大家都知道小张喝醉了？", category: "脑筋急转弯", answer: "因為小张正在穿鞋子，准备回家", explain: "因為小张正在穿鞋子，准备回家", source: "ChineseDatasets / brainteasers" },
  { question: "天气愈來愈冷，为什么小华不多加件衣服，反而要脫衣服？", category: "脑筋急转弯", answer: "他准备要洗澡了。", explain: "因为他准备要洗澡了。", source: "ChineseDatasets / brainteasers" },
  { question: "小丁在游泳池游泳，游着游着，为什么水突然变深了？", category: "脑筋急转弯", answer: "有人刚撒了一泡尿", explain: "因为有人刚撒了一泡尿", source: "ChineseDatasets / brainteasers" },
  { question: "不小心溺水时，若附近沒有其他人该如何自救？", category: "脑筋急转弯", answer: "把水喝光=>但是还是会胀死", explain: "把水喝光=>但是还是会胀死", source: "ChineseDatasets / brainteasers" },
  { question: "高考发榜了，为什么志明榜上无名却一点也不难过？", category: "脑筋急转弯", answer: "志明还在念小学。", explain: "因为志明还在念小学。", source: "ChineseDatasets / brainteasers" },
  { question: "王太太委托征信社二十四小时日夜跟踪、监视王先生，以防他出轨，但是为什么最后王先生还是出轨了？", category: "脑筋急转弯", answer: "王先生搭乘地铁出轨了", explain: "因为王先生搭乘地铁出轨了", source: "ChineseDatasets / brainteasers" },
  { question: "遇到什么事情最好高抬贵手", category: "脑筋急转弯", answer: "别人用枪指着你的时候", explain: "别人用枪指着你的时候", source: "ChineseDatasets / brainteasers" },
  { question: "一个老老人头顶上只剩三根头发，有一天他要参加重要盛会，为什么他仍忍痛拔掉其中一根头发呢？", category: "脑筋急转弯", answer: "他要梳中分", explain: "因为他要梳中分", source: "ChineseDatasets / brainteasers" },
  { question: "盒子里有四块蛋糕，四个小朋友，每人都分到一块，但盒子里还留下一快蛋糕，为什么？", category: "脑筋急转弯", answer: "其中一个小朋友连盒子一起拿走", explain: "其中一个小朋友连盒子一起拿走，所以盒子里还有一个蛋", source: "ChineseDatasets / brainteasers" },
  { question: "小明每天写信给他的女朋友，每天寄七封，但他的女朋友珍妮，每天却只收到一封信，为什么？", category: "脑筋急转弯", answer: "他有七个女朋友", explain: "因为他有七个女朋友", source: "ChineseDatasets / brainteasers" },
  { question: "現在有二枚市面常用的硬币，面值共为六毛，其中有一枚不是一毛，请问二枚硬币面值各为多少", category: "脑筋急转弯", answer: "一枚不是一毛", explain: "一枚不是一毛，那另一枚是一毛，因此是一毛和五毛", source: "ChineseDatasets / brainteasers" },
  { question: "IX---这个罗马数字代表9，如何加上一笔，使其变成偶数？", category: "脑筋急转弯", answer: "加\"s\"", explain: "加\"s\"，因为SIX是六的意思", source: "ChineseDatasets / brainteasers" },
  { question: "提早放工回家的小李，一进卧室，看見隔壁的小刘与自己老婆睡在床上，但小李却毫不动怒，为什么？", category: "脑筋急转弯", answer: "小刘是女的", explain: "因为小刘是女的", source: "ChineseDatasets / brainteasers" },
  { question: "有一座大大厦发生火灾，陈先生逃到頂楼后，想跳过距离只有1米的隔壁楼顶，结果却摔死了，为什么？", category: "脑筋急转弯", answer: "高度相差太远", explain: "因为高度相差太远", source: "ChineseDatasets / brainteasers" },
  { question: "小明拿了一百元去买一个七十五元的东西，但老板却只找了五元给他，为什么？", category: "脑筋急转弯", answer: "他只给了八十元给老板", explain: "因为他只给了八十元给老板", source: "ChineseDatasets / brainteasers" },
  { question: "今天下午到旺角看电影，到了旺角，半个人也看不見，为什么？", category: "脑筋急转弯", answer: "人很多，但没有\"半\"个人", explain: "人很多，但没有\"半\"个人", source: "ChineseDatasets / brainteasers" },
  { question: "有爷俩，娘俩和兄妹俩，只有6个烧饼，但却每人分得了两个，这是为什么？", category: "脑筋急转弯", answer: "他们只有三个人：母亲", explain: "他们只有三个人：母亲，儿子，舅舅", source: "ChineseDatasets / brainteasers" },
  { question: "为什么有可能对临震预报和自救有意义？", category: "十万个为什么", answer: "由于地声多在临震前出现", explain: "由于地声多在临震前出现，有可能对临震预报和自救有意义。", source: "CMRC 2018 · 地声" },
  { question: "为什么明清时期的韵书不能作为分析当时口语的依据？", category: "十万个为什么", answer: "承袭平水韵的音系", explain: "但这些韵书都承袭平水韵的音系，不能作为分析当时口语的依据。", source: "CMRC 2018 · 明清音系" },
  { question: "PukiWiki为什么在日本支援了手机网页功能？", category: "十万个为什么", answer: "日本国内使用手机上网十分普遍", explain: "另外日本国内使用手机上网十分普遍，因此PukiWiki也支援了手机网页功能。", source: "CMRC 2018 · PukiWiki" },
  { question: "1957年10月,兰氏因为何种原因去世？", category: "十万个为什么", answer: "车祸", explain: "1957年10月，兰氏因车祸去世。", source: "CMRC 2018 · 兰大卫" },
  { question: "杰森·科普为什么一直没有透露离开乐团的原因？", category: "十万个为什么", answer: "科普当时被要求签下言论禁止令", explain: "科普当时被要求签下言论禁止令（gag order），因此直到至今他仍然没有公开谈论过与离团有关的事情。", source: "CMRC 2018 · 杰森·科普" },
  { question: "马克·雅各布斯因为什么原因而被接受治疗？", category: "十万个为什么", answer: "毒品及酗酒", explain: "同年3月12日，雅各布斯因毒品及酗酒而接受治疗。", source: "CMRC 2018 · 马克·雅各布斯" },
  { question: "2001年的世界大赛因为什么原因而推迟？", category: "十万个为什么", answer: "911袭击", explain: "世界大赛将于10月28日开始，不迟于11月5日结束，这将是大联盟历史上第二次赛季结束于11月份，之前唯一的一次是2001年世界大赛，由于911袭击而推迟。", source: "CMRC 2018 · 2009年美国职棒大联盟球季" },
  { question: "为什么朝廷征讨海贼的军队损失惨重？", category: "十万个为什么", answer: "海贼用一术士法术，兴风作浪", explain: "岂知海贼用一术士法术，兴风作浪，致使朝廷战船毁坏，征讨遇挫，损失惨重。", source: "CMRC 2018 · 灵昭真君" },
  { question: "为什么1990年横道河子机车库停止使用？", category: "十万个为什么", answer: "由于蒸汽机逐渐被内燃机所淘汰", explain: "由于蒸汽机逐渐被内燃机所淘汰，1990年横道河子机车库停止使用。", source: "CMRC 2018 · 横道河子站" },
  { question: "为什么有些火斑笛鲷体内具有热带鱼毒？", category: "十万个为什么", answer: "食物链关系", explain: "有些个体因食物链关系体内具有热带鱼毒。", source: "CMRC 2018 · 火斑笛鲷" },
  { question: "为什么计划始终未能执行？", category: "十万个为什么", answer: "遭遇广泛的批评", explain: "该计划遭遇广泛的批评，始终未能执行。", source: "CMRC 2018 · 桑贾伊·甘地" },
  { question: "为什么食物环境衞生署分两阶段重建歌连臣角火葬场？", category: "十万个为什么", answer: "日益增加的火葬服务需求", explain: "鉴于日益增加的火葬服务需求，食物环境衞生署分两阶段重建歌连臣角火葬场，在原址重建10个新火化炉及其附属设施，预计2014年12月完成。", source: "CMRC 2018 · 歌连臣角火葬场" },
  { question: "为什么海蛇能将身体多余的盐分排除？", category: "十万个为什么", answer: "海蛇的舌头有盐份分泌线", explain: "海蛇的舌头有盐份分泌线，能将身体多余的盐分排除。", source: "CMRC 2018 · 钩鼻海蛇" },
  { question: "为什么1844-1846年广场中间设置了奥地利喷泉？", category: "十万个为什么", answer: "纪念奥地利皇帝斐迪南一世。", explain: "此外，在1844-1846年，在广场中间设置了奥地利喷泉，以纪念奥地利皇帝斐迪南一世。", source: "CMRC 2018 · 弗赖永广场" },
  { question: "为什么河口湾常为水产盛产区域？", category: "十万个为什么", answer: "咸淡水在河口湾混杂", explain: "由于咸淡水在河口湾混杂，所以河口湾常为水产盛产区域。", source: "CMRC 2018 · 河口" },
  { question: "为什么汪大燮能成为国务总理？", category: "十万个为什么", answer: "黎元洪大总统利用总统特权提出", explain: "汪大燮成为国务总理，是因为黎元洪大总统利用总统特权提出；", source: "CMRC 2018 · 汪大燮内阁" },
  { question: "为何后续版本IE9不如IE8普及呢？", category: "十万个为什么", answer: "不支援Windows XP", explain: "这个软体于2009年3月19日首次发行适用于Windows的版本，虽然它的后续版本IE9已推出，但由于不支援Windows XP，所以IE8在初期还是十分普及。", source: "CMRC 2018 · Internet Explorer 8" },
  { question: "为什么如今水力资源多数有待开发？", category: "十万个为什么", answer: "人类十分依赖非再生能源", explain: "现时，人类十分依赖非再生能源，所以水力资源多数有待开发。", source: "CMRC 2018 · 水力资源" },
  { question: "为什么要以陶街来纪念他们？", category: "十万个为什么", answer: "陶成、陶鲁父子有战绩", explain: "因陶成、陶鲁父子有战绩，明朝嘉靖四十年，于忠贤坊后街（今陶街）建“忠烈祠”以纪念。", source: "CMRC 2018 · 陶街" },
  { question: "为何该地区的人口十分稀少呢？", category: "十万个为什么", answer: "处于撒哈拉沙漠腹地", explain: "面积634,209平方公里，是非洲面积最大的行政区，该地区占尼日尔全国面积约52%，但因处于撒哈拉沙漠腹地而人烟稀少，2012年人口487,620人。", source: "CMRC 2018 · 阿加德兹大区" },
  { question: "为什么在1980年代许多石板棺及陪葬品民众的注意及争相盗掘？", category: "十万个为什么", answer: "陪葬品完整且精美", explain: "1980年代，因东线铁路改线及台东新站的设置，许多石板棺及陪葬品被发现，因陪葬品完整且精美，引起民众的注意及争相盗掘。", source: "CMRC 2018 · 卑南考古文物事件" },
  { question: "为什么有些物理学家也质疑宇宙审查假说的真确性？", category: "十万个为什么", answer: "宇宙审查假说并未经过直接验证", explain: "宇宙审查假说并未经过直接验证，而有些物理学家也质疑宇宙审查假说的真确性。", source: "CMRC 2018 · 裸奇异点" },
  { question: "为何不再补助自由软体铸造场？", category: "十万个为什么", answer: "因中华民国科技部政策改变", explain: "2015年，因中华民国科技部政策改变，决定不再补助，专案计划于年底停止。", source: "CMRC 2018 · 自由软体铸造场" },
  { question: "为何泰达足球场的场内不设计田径跑道？", category: "十万个为什么", answer: "使得观众可以近距离观看比赛", explain: "”泰达足球场按照国际足联标准建设，因而场内不设田径跑道，使得观众可以近距离观看比赛。", source: "CMRC 2018 · 泰达足球场" },
  { question: "为什么蔡守训去考台北师专当老师？", category: "十万个为什么", answer: "祖父说读师专后即有工作", explain: "本来想考明星高中，但祖父说读师专后即有工作，蔡守训就去考台北师专当老师，师专毕业后于小学担任老师，后来考上中兴大学法律系，1995年开始担任法官。", source: "CMRC 2018 · 蔡守训" },
  { question: "为什么鄂图曼军队纷纷丢弃阵地向内陆退却？", category: "十万个为什么", answer: "遭受突然袭击", explain: "在陆地上，鄂图曼军队因遭受突然袭击，纷纷丢弃阵地向内陆退却，英国突击部队在没有遇到抵抗的情况下冲上海岸。", source: "CMRC 2018 · 加里波利海战" },
  { question: "为什么小岛叙尔特塞能突出海面？", category: "十万个为什么", answer: "火山喷发", explain: "1963年－1967年西南部因火山喷发而使小岛叙尔特塞突出海面，当时，全群岛覆盖了一层火山灰。", source: "CMRC 2018 · 韦斯特曼纳群岛" },
  { question: "为什么李重进能在数年间不次擢升？", category: "十万个为什么", answer: "以姻亲之故", explain: "李重进、张永德本以姻亲之故，在数年间不次擢升，但后来都在战争中展现出过人的军事才能。", source: "CMRC 2018 · 李重进" },
  { question: "为什么汉元帝时婕妤之号退居第二？", category: "十万个为什么", answer: "因在皇后之下增设昭仪一位", explain: "汉元帝时因在皇后之下增设昭仪一位，使婕妤之号退居第二。", source: "CMRC 2018 · 婕妤" },
  { question: "为什么尹福是拜肃王府太监董海川的大弟子？", category: "十万个为什么", answer: "因入门最早", explain: "在秦凤仪死后，拜肃王府太监董海川为师，因入门最早，为其大弟子。", source: "CMRC 2018 · 尹福" },
  { question: "为什么尹福有“瘦尹”的绰号？", category: "十万个为什么", answer: "因为身形瘦长，外表斯文", explain: "因为身形瘦长，外表斯文，而有「瘦尹」的绰号。", source: "CMRC 2018 · 尹福" },
  { question: "为什么太祖命慕容延钊“肩舆即戎事”？", category: "十万个为什么", answer: "慕容延钊抱病在身", explain: "当时慕容延钊抱病在身，太祖命他“肩舆即戎事。", source: "CMRC 2018 · 慕容延钊" },
  { question: "为什么士坦次高中的女孩们认为全天下没有什么是瑟琳娜得不到的？", category: "十万个为什么", answer: "因她的美貌", explain: "瑟琳娜是个高挑的金发女孩，康士坦次高中的女孩们因她的美貌而认为全天下没有什么是她得不到的。", source: "CMRC 2018 · 韦倩莲" },
  { question: "为什么布莱尔总是娇滴滴的？", category: "十万个为什么", answer: "布莱尔为家中独女", explain: "布莱尔为家中独女，所以总是娇滴滴的，很“大小姐”脾气。", source: "CMRC 2018 · 胡贝雅" },
  { question: "为什么杨清的部将纷纷献城投降？", category: "十万个为什么", answer: "杨清残暴不仁", explain: "因杨清残暴不仁，部将纷纷献城投降。", source: "CMRC 2018 · 杨清" },
  { question: "为什么元羽嫡妻降为妾室？", category: "十万个为什么", answer: "孝文帝元宏鼓励鲜卑与汉族通婚", explain: "他的大哥孝文帝元宏鼓励鲜卑与汉族通婚，元羽嫡妻降为妾室，再聘娶骠骑谘议参军荥阳郑平城的女儿郑始容。", source: "CMRC 2018 · 元羽" },
  { question: "为什么1952年夏威夷雁只剩下约30余只了？", category: "十万个为什么", answer: "因被入侵的掠食者所猎食", explain: "但于1952年，因被入侵的掠食者所猎食，就只余下约30只。", source: "CMRC 2018 · 夏威夷雁" },
  { question: "为什么扩散厂能耗十分巨大？", category: "十万个为什么", answer: "由于需要不断重复分离气体", explain: "扩散厂由于需要不断重复分离气体，能耗十分巨大。", source: "CMRC 2018 · 气体扩散法" },
  { question: "为什么会出现用不同的字来音译同一词的现象？", category: "十万个为什么", answer: "由于不同时期汉语的语音不一样", explain: "由于不同时期汉语的语音不一样，所以出现用不同的字来音译同一词的现象。", source: "CMRC 2018 · 梵汉对音" },
  { question: "为什么会出现疤痕？", category: "十万个为什么", answer: "是自然愈合过程的一部分。", explain: "因此，疤痕是自然愈合过程的一部分。除了非常轻微的病变，每一个伤口（如意外事故，疾病或手术后）都会导致一定程度上的疤痕。", source: "CMRC 2018 · 疤痕" },
  { question: "为什么营业税的税源充足？", category: "十万个为什么", answer: "营业税涉及范围广", explain: "营业税涉及范围广，因而税源充足；", source: "CMRC 2018 · 营业税" },
  { question: "为什么陈衣凡会投身军旅？", category: "十万个为什么", answer: "中学期间适值九一八事变", explain: "中学期间适值九一八事变而决定投身军旅，1933年进入黄埔军校10期工兵科。", source: "CMRC 2018 · 陈衣凡" },
  { question: "为什么许多纽约本地人将曼哈顿上城视为外围区域？", category: "十万个为什么", answer: "远离曼哈顿中城，房租较低", explain: "由于曼哈顿上城远离曼哈顿中城，房租较低，甚至许多纽约本地人也将其视为外围区域，排除在纽约人所谓“城里”（The City）的范围之外。", source: "CMRC 2018 · 曼哈顿上城" },
  { question: "为什么14街的失去了原本的地位？", category: "十万个为什么", answer: "城市重心北移", explain: "在过去14街曾是高档地点，但城市重心北移后失去部分魅力与地位。", source: "CMRC 2018 · 14街" },
  { question: "为什么黄兆伦前往大陆学习舞台技巧？", category: "十万个为什么", answer: "为角色设计特别的舞台效果", explain: "她表示，参赛者愈来愈专业，她今次刻意往内地学习舞台技巧，为角色设计特别的舞台效果，结果自04至06年间得到冠军后，在08年的动漫Cosplay大赛再次夺得冠军。", source: "CMRC 2018 · 黄兆伦" },
  { question: "为什么3月28日不用补选？", category: "十万个为什么", answer: "因没有席位需要竞逐", explain: "因没有席位需要竞逐，3月28日不用补选。", source: "CMRC 2018 · 香港新界第一届村代表补选" },
  { question: "为什么被命名为凯旋门大赛？", category: "十万个为什么", answer: "以凯旋门命名", explain: "因而以凯旋门命名为凯旋门大赛，第一届总奖金为15万法郎。", source: "CMRC 2018 · 凯旋门大赛" },
  { question: "为什么叶若夫“血腥的侏儒”？", category: "十万个为什么", answer: "因叶若夫身高不足1米60", explain: "因叶若夫身高不足1米60，有个绰号“血腥的侏儒”。", source: "CMRC 2018 · 尼古拉·伊万诺维奇·叶若夫" },
  { question: "为什么浦和红钻自动晋级八强？", category: "十万个为什么", answer: "作为卫冕冠军", explain: "作为卫冕冠军，浦和红钻自动晋级八强，可惜红钻却于准决赛败于同国的大阪飞脚，无缘卫冕；", source: "CMRC 2018 · 2008年亚足联冠军联赛" },
  { question: "为什么又叫「三轮净闲寺」？", category: "十万个为什么", answer: "因为地处「三轮」", explain: "因为地处「三轮」，所以也叫做「三轮净闲寺」。", source: "CMRC 2018 · 净闲寺" },
  { question: "为什么近年来岛内居民外流？", category: "十万个为什么", answer: "海上渔业资源日渐枯竭", explain: "近年来海上渔业资源日渐枯竭，导致人口往外发展情况越来越严重。", source: "CMRC 2018 · 望安岛" },
  { question: "为什么近年来海鸟迁移？", category: "十万个为什么", answer: "由于开垦、岛上居民增加等因素", explain: "近年由于开垦、岛上居民增加等因素，致使海鸟迁移，现今岛上很少会看到海鸟的踪迹。", source: "CMRC 2018 · 鸟屿" },
  { question: "为什么称它为“桶盘”？", category: "十万个为什么", answer: "因外型像倒盖的脸盆", explain: "因外型像倒盖的脸盆，故称桶盘。", source: "CMRC 2018 · 桶盘屿" },
  { question: "为什么1930年米哈伊一世降为王储？", category: "十万个为什么", answer: "卡罗尔二世回国", explain: "1930年，卡罗尔二世回国，米哈伊一世降为王储。", source: "CMRC 2018 · 米哈伊一世" },
  { question: "为什么测量这颗恒星在赤道的自转速率会随著时间而改变？", category: "十万个为什么", answer: "由于磁场的作用", explain: "由于磁场的作用，测量这颗恒星在赤道的自转速率也会随著时间而改变。", source: "CMRC 2018 · 剑鱼座AB" },
  { question: "为什么铁钟列入文物保护单位并不合适？", category: "十万个为什么", answer: "铁钟属于可移动文物", explain: "事实上铁钟属于可移动文物，列入文物保护单位并不合适。", source: "CMRC 2018 · 大同钟楼" },
  { question: "为什么东南亚的华人习惯称这种食物为“马来粽”？", category: "十万个为什么", answer: "制法与形状类似华人所扎的粽子", explain: "马来粽由于制法与形状类似华人所扎的粽子，所以当地华人习惯上把它称作“马来粽”。", source: "CMRC 2018 · 马来粽" },
  { question: "为什么巴士公司很少派出10米或以上巴士行走？", category: "十万个为什么", answer: "受到发夹弯弯位影响", explain: "受到发夹弯弯位影响，巴士公司很少派出10米或以上巴士行走，但现时每日均有10.84米的大巴行驶于本线。", source: "CMRC 2018 · 澳门巴士2路线" },
  { question: "为什么严格禁止明朝宦官在外娶妻？", category: "十万个为什么", answer: "主要为防止外臣干涉宫廷事务", explain: "明朝宦官在外娶妻是被严格禁止，主要为防止外臣干涉宫廷事务。", source: "CMRC 2018 · 对食" },
  { question: "为什么普列谢茨克不适合用来发射小倾角卫星和地球同步轨道卫星？", category: "十万个为什么", answer: "高纬度的地理位", explain: "由于处于较高纬度的地理位置，普列谢茨克不适合用来发射小倾角卫星和地球同步轨道卫星。", source: "CMRC 2018 · 普列谢茨克航天发射场" },
  { question: "为什么每年的情人节，大批情侣都喜欢到挽叻县署作婚姻登记？", category: "十万个为什么", answer: "由于挽叻县的意义为「爱村」", explain: "由于挽叻县的意义为「爱村」，每年的情人节，大批情侣都喜欢到挽叻县署作婚姻登记。", source: "CMRC 2018 · 挽叻县" },
  { question: "为什么在天神学校中，4班是十分有趣的班级？", category: "十万个为什么", answer: "大家被期待的标准大多相同", explain: "可是由于大家被期待的标准大多相同，所以是天神学校中十分有趣的班级。", source: "CMRC 2018 · 天神小子" },
  { question: "为什么日军第二次占领福州后，加快机场修建工作？", category: "十万个为什么", answer: "为了与盟军争夺制空权", explain: "1944年福州被日军第二次占领后，为了与盟军争夺制空权，日军在占领区加快修建机场，福州机场即是其中之一。", source: "CMRC 2018 · 福州义序机场" },
  { question: "为什么很多黑监督吸蜜鸟被用来制作标本？", category: "十万个为什么", answer: "由于牠们的外表美丽", explain: "由于牠们的外表美丽，很多时会被捕猎来作为标本。", source: "CMRC 2018 · 黑监督吸蜜鸟" },
  { question: "为什么有时会用原驼的毛皮代替赤狐的毛皮？", category: "十万个为什么", answer: "因它们的质感极为相似", explain: "原驼的毛皮，尤其是幼驼的，有时会用作代替赤狐的毛皮，因它们的质感极为相似。", source: "CMRC 2018 · 原驼" },
  { question: "科学家认为第一代恒星相比后来形成的恒星有着怎样的特点？", category: "十万个为什么", answer: "恒星温度更高，质量更大", explain: "这使得科学家怀疑宇宙中的第一代恒星要比后来形成的恒星温度更高，质量更大。", source: "CMRC 2018 · GRB 090423" },
  { question: "《海，另一个未知的宇宙》的笔调有着怎样的特点？", category: "十万个为什么", answer: "幽默而轻松", explain: "本书以幽默而轻松的笔调描述了从古至今乃至于未来的海洋世界，为薛庆的第七本著作。", source: "CMRC 2018 · 海，另一个未知的宇宙" },
  { question: "北斗阿南鱼的烹饪方式是怎样的？", category: "十万个为什么", answer: "食用，清蒸、红烧", explain: "可以食用，清蒸、红烧均可，广东菜馆称之为青衣。", source: "CMRC 2018 · 北斗阿南鱼" },
  { question: "2007－08年全球粮食价格危机产生了怎样的影响？", category: "十万个为什么", answer: "引起了世界范围的恐慌。", explain: "因为粮食价格迅速上涨，从而引起了世界范围的恐慌。2008年3月，世界粮食计划署执行干事希兰说，自2007年6月以来，谷物价格上涨近40%，全球食品储备仅够53天应急供应。", source: "CMRC 2018 · 2007-08年全球粮食价格危机" },
  { question: "十干化运是运气学说中怎样的一种方法？", category: "十万个为什么", answer: "将天干与五行相配", explain: "十干化运为运气学说中将天干与五行相配的一种方法。", source: "CMRC 2018 · 五运六气" },
  { question: "后来米诺地尔发现了具有怎样的副作用？", category: "十万个为什么", answer: "扭转或减慢秃头过程", explain: "后来偶然发现有一个有趣的副作用，就是扭转或减慢秃头过程。", source: "CMRC 2018 · 米诺地尔" },
  { question: "梵汉对音发挥了怎样重要的作用？", category: "十万个为什么", answer: "被运用到中古汉语语音的构拟", explain: "梵汉对音材料已经被运用到中古汉语语音的构拟，发挥了重要的作用。", source: "CMRC 2018 · 梵汉对音" },
  { question: "尖吻单棘鲀常以怎么样的方式游泳？", category: "十万个为什么", answer: "略呈头上尾下的倾斜姿势", explain: "常以略呈头上尾下的倾斜姿势游泳，筑巢于长有海藻的死珊瑚基部。", source: "CMRC 2018 · 尖吻单棘鲀" },
  { question: "在潮乐中椰胡承担着怎样的作用？", category: "十万个为什么", answer: "作为主音乐器", explain: "在潮乐中作为主音乐器，亦用于潮州筝曲的伴奏；", source: "CMRC 2018 · 椰胡" },
  { question: "为什么电话本不受版权法保护？", category: "十万个为什么", answer: "没有体现任何创造性", explain: "美国最高法院认为按字母顺序排列的电话本连最低程度的创造性都满足不了，因为这样排列是该行业的传统实践，虽然该公司花费大量心血收集这些数据，但是并没有体现任何创造性，与版权法的宗旨不一致，因而不受版权法的保护。", source: "CMRC 2018 · 费斯特出版公司诉乡村电话公司案" },
  { question: "在中东铁路的建设过程中，为什么大批沙俄工程人员驻扎在位于张广才岭东侧的横道河子镇？", category: "十万个为什么", answer: "为克服铁路翻越张广才岭的困难", explain: "横道河子站随原中东铁路的开工而设立，在中东铁路的建设过程中，为克服铁路翻越张广才岭的困难，大批沙俄工程人员驻扎在位于张广才岭东侧的横道河子镇。", source: "CMRC 2018 · 横道河子站" },
  { question: "为什么巴勒斯坦国并非完整的独立的主权国家？", category: "十万个为什么", answer: "当时并未宣布其领土边界及主权", explain: "巴勒斯坦解放组织于1988年11月15日在阿尔及尔举行巴勒斯坦解放组织全国委员会第十九次特别会议中，单方面的通过独立宣言，从英属巴勒斯坦托管地成为巴勒斯坦国，但当时并未宣布其领土边界及主权，因此巴勒斯坦国并非完整的独立的主权国家。", source: "CMRC 2018 · 巴勒斯坦驻外机构列表" },
  { question: "如何确定各轴线的正方向？", category: "十万个为什么", answer: "用右手定则规定各轴线的正方向", explain: "用右手定则规定各轴线的正方向。", source: "CMRC 2018 · 卦限" },
  { question: "如何监测云的种类、云量以及雾等传感器接触不到的天气现象？", category: "十万个为什么", answer: "人工监测", explain: "云的种类、云量以及雾等接触不到传感器、需肉眼观察的天气现象，仍然要人工监测。", source: "CMRC 2018 · 自动气象站" },
  { question: "为什么广场的南部保护得最好，许多建筑物设有2或3层地窖？", category: "十万个为什么", answer: "用于保存食物、水井或污水坑。", explain: "许多建筑物设有2或3层地窖，用于保存食物、水井或污水坑。最重要的地标为圣巴尔多禄茂主教座堂（1295年兴建，1993年成为主教座堂）、比尔森市政厅（自1496年起）和圣母玛丽亚黑死病纪念柱（1681年），全部位于广场的北部。", source: "CMRC 2018 · 共和国广场 (比尔森)" },
  { question: "为什么Apple I实际上可说是Wozniak自己的作品？", category: "十万个为什么", answer: "因为它在公司成立前即已出产。", explain: "苹果公司并不反对这项计划，因为Wozniak已经许可，且Apple I实际上可说是Wozniak自己的作品，因为它在公司成立前即已出产。苹果公司曾释出关于Apple I的所有材料给Apple I Owners Club。", source: "CMRC 2018 · Replica 1" },
  { question: "为什么灯塔上要涂上黑白相间的条纹？", category: "十万个为什么", answer: "因当地多浓雾", explain: "最初塔身结构是八角形铁造，高度30公尺，因当地多浓雾， 故漆上黑白相间的平行条纹， 原装配二等三重芯煤油灯，白色定光，光力3,500支烛光，至1911年时（明治44年），改用17,600支烛光的煤油白热灯。", source: "CMRC 2018 · 富贵角灯塔" },
  { question: "为什么吴音中有很多佛教用语和律令纪（古代的法律与政令纪）用语？", category: "十万个为什么", answer: "六朝时佛教开始盛行", explain: "六朝时佛教开始盛行，故吴音多使用于佛教用语与律令纪（古代的法律与政令纪）用语，在汉音导入后也没有消失，直至现代仍用汉音一并使用。", source: "CMRC 2018 · 吴音" },
  { question: "为什么张致能很快即攻占附近的平州（今河北省卢龙县）、滦州（今河北省滦县）等数十州？", category: "十万个为什么", answer: "联络当地地主武装，攻城夺地", explain: "他又联络当地地主武装，攻城夺地，很快即攻占附近的平州（今河北省卢龙县）、滦州（今河北省滦县）等数十州，并自称瀛王。", source: "CMRC 2018 · 张致" },
  { question: "苏博为什么改名成苏镜宇？", category: "十万个为什么", answer: "婶婶认为他命中缺金", explain: "苏镜宇原名苏博，因为婶婶认为他命中缺金，改名镜宇。", source: "CMRC 2018 · 苏镜宇" },
  { question: "王沈为什么由叔叔抚养？", category: "十万个为什么", answer: "其父早死", explain: "由于其父早死，被叔叔王昶抚养。", source: "CMRC 2018 · 王沈 (太原)" },
  { question: "上海轨道交通16号线在2010年改名为什么？", category: "十万个为什么", answer: "上海轨道交通21号线", explain: "本线在2010年之前的规划中番号定为上海轨道交通16号线，2010年后改为上海轨道交通21号线，编号L2，为上海一条规划建设的轨道交通路线。", source: "CMRC 2018 · 上海轨道交通16号线 (2010年前)" },
  { question: "上海轨道交通17号线在2010年改名为什么？", category: "十万个为什么", answer: "上海轨道交通20号线", explain: "本线在2010年前的规划中番号定为上海轨道交通17号线，2011年后改为上海轨道交通20号线，编号L3，为上海市规划中的轨道交通路线之一。", source: "CMRC 2018 · 上海轨道交通17号线 (2010年前)" },
  { question: "灰凤冠雉为什么从易危被提升为濒危？", category: "十万个为什么", answer: "牠们的数量急遽减少", explain: "由于牠们的数量急遽减少，故世界自然保护联盟将其保育状况由易危提升为濒危。", source: "CMRC 2018 · 灰凤冠雉" },
  { question: "黑额鸣冠雉的数量为什么变少？", category: "十万个为什么", answer: "猎杀及失去栖息地", explain: "由于猎杀及失去栖息地，牠们的数量已开始变得稀少。", source: "CMRC 2018 · 黑额鸣冠雉" },
  { question: "徐晓飞为什么中途退役过？", category: "十万个为什么", answer: "因身体原因", explain: "徐晓飞（）是中国足球运动员，司职中场，曾经在日本大学生联赛和低级别球队效力，返回中国后不久因身体原因而退役。", source: "CMRC 2018 · 徐晓飞" },
  { question: "纽波特又被译为什么？", category: "十万个为什么", answer: "新港", explain: "纽波特（），又译为新港，位于美国罗得岛州南部，是纽波特县的县治所在，距离州首府普罗维登斯37公里，距离波士顿98公里。", source: "CMRC 2018 · 纽波特 (罗得岛州)" },
  { question: "顺治七年，清廷为什么不录用袁彭年？", category: "十万个为什么", answer: "厌其反复不定", explain: "清廷厌其反复不定，不予录用。", source: "CMRC 2018 · 袁彭年" },
  { question: "宗翰之长子「真珠」与次子「割韩奴」为什么改姓为粘？", category: "十万个为什么", answer: "躲避灾祸", explain: "金熙宗在位晚期时残暴不仁、喜怒无常、侮辱大臣、屡杀宗室，宗翰之长子「真珠」与次子「割韩奴」为了躲避灾祸，以二人之父「粘没喝」之名冠为姓，以避祸端。", source: "CMRC 2018 · 粘姓" },
  { question: "尼古拉·卡利尼奇被国家队主帅比利奇赞美为什么？", category: "十万个为什么", answer: "克罗地亚足球的未来", explain: "尼古拉·卡利尼奇（：Nikola Kalinić，），是一名克罗地亚职业足球运动员，司职前锋，被国家队主帅比利奇赞美为“克罗地亚足球的未来”。", source: "CMRC 2018 · 尼古拉·卡利尼奇" },
  { question: "莱索托为什么没有港口和海港？", category: "十万个为什么", answer: "因是一个内陆国家", explain: "因是一个内陆国家，莱索托没有港口，海港，但是有道路、空路和有限的铁路服务。", source: "CMRC 2018 · 莱索托交通" },
  { question: "尼高·高华因为什么错过了1998年世界杯？", category: "十万个为什么", answer: "因伤", explain: "科瓦奇于1996年12月11日首次代表克罗地亚国家队上场，但是他却因伤错过了1998年世界杯而无缘铜牌。", source: "CMRC 2018 · 尼科·科瓦奇" },
  { question: "侏罗纪海岸为什么是国际野外考察的对象？", category: "十万个为什么", answer: "地形多变", explain: "由于地形多变，因此这里是国际野外考察的对象。", source: "CMRC 2018 · 侏罗纪海岸" },
  { question: "在三叠纪，华北陆块成为什么的一部分？", category: "十万个为什么", answer: "盘古大陆", explain: "在三叠纪，华北陆块成为盘古大陆的一部分。", source: "CMRC 2018 · 华北陆块" },
  { question: "内眦赘皮整形术为什么被整形外科医师认为很有挑战性？", category: "十万个为什么", answer: "因为内眦赘皮覆盖在泪小管上。", explain: "该手术被整形外科医师认为很有挑战性，因为内眦赘皮覆盖在泪小管上。", source: "CMRC 2018 · 内眦赘皮" },
  { question: "细小的雄蛛交配时为什么要很小心地走近雌蛛？", category: "十万个为什么", answer: "若不小心，就会被雌蛛吃下。", explain: "若不小心，就会被雌蛛吃下。", source: "CMRC 2018 · 十字园蛛" },
  { question: "作为一位出色的中国女演员，余男一直因为什么而倍受瞩目？", category: "十万个为什么", answer: "她的国际路线和特立独行", explain: "作为一位出色的中国女演员，余男一直以她的国际路线和特立独行而倍受瞩目。", source: "CMRC 2018 · 余男" },
  { question: "厚嘴鸡鸠为什么容易成为大家鼠、野猪、野猫及野狗的猎物？", category: "十万个为什么", answer: "将巢筑在地上", explain: "牠们会将巢筑在地上，故容易成为入侵的大家鼠、野猪、野猫及野狗的猎物。", source: "CMRC 2018 · 厚嘴鸡鸠" },
  { question: "扁尾海蛇为什么在水中的活跃程度不及一般海蛇？", category: "十万个为什么", answer: "其尾鳍结构发展不足", explain: "此属蛇类有宽阔的腹鳞，可以活动于陆地上，相反其尾鳍结构发展不足，令牠在水中的活跃程度不及一般海蛇。", source: "CMRC 2018 · 扁尾海蛇属" },
  { question: "暴鲤龙经常被误为什么属性的宝可梦？", category: "十万个为什么", answer: "龙属性", explain: "暴鲤龙经常被误为龙属性的宝可梦，但事实是它是水属性加上飞行属性的。", source: "CMRC 2018 · 暴鲤龙" },
  { question: "属于食肉牛龙亚科的属重新被归类为什么科？", category: "十万个为什么", answer: "玛君龙亚科", explain: "而由托尔托萨等人于2013年所做的分析则是把数个属于食肉牛龙亚科的属重新归类为玛君龙亚科，并把数个阿贝力龙科归类为食肉牛龙族。", source: "CMRC 2018 · 食肉牛龙亚科" },
  { question: "AM为什么保留了4个男人和1个女人在地心深处？", category: "十万个为什么", answer: "深恨人类", explain: "AM深恨人类，所以保留了4个男人和1个女人在地心深处，在其后的一百年间，AM不断利用他们内心的恐惧而折磨他们。", source: "CMRC 2018 · 无声狂啸" },
  { question: "漫画因为什么一度停止连载？", category: "十万个为什么", answer: "因为日本出版社更换", explain: "漫画因为日本出版社更换而一度停止连载，后于一迅社的《ZERO-SUM》増刊《WARD》中复刊，在2、5、8、11月的16日刊登。", source: "CMRC 2018 · 最游记外传" },
  { question: "李惠珍现在为什么单位工作？", category: "十万个为什么", answer: "儿童杂志社", explain: "李惠珍现为儿童杂志社工作，《13点》仍然散见于当中的期刊。", source: "CMRC 2018 · 李惠珍" },
  { question: "张元素为什么落第？", category: "十万个为什么", answer: "犯了庙讳", explain: "因为犯了庙讳而落第，弃仕学医。", source: "CMRC 2018 · 张元素" },
  { question: "南北朝及隋唐时，成纪县因为什么出名？", category: "十万个为什么", answer: "为陇西李氏祖籍", explain: "南北朝及隋唐时，与狄道县同为陇西李氏祖籍而知名。", source: "CMRC 2018 · 成纪县" },
  { question: "宋朝时期一级行政区改划为什么名字？", category: "十万个为什么", answer: "路", explain: "宋朝汲取了唐朝藩镇割据的教训，一级行政区划改为「路」，二级行政区有府、州、军、监。", source: "CMRC 2018 · 宋朝行政区划" },
  { question: "瘰鳞蛇的皮肤为什么粗糙？", category: "十万个为什么", answer: "抵御水压，便于在海底猎食。", explain: "牠们粗糙的皮肤主要用途是为了抵御水压，便于在海底猎食。雌性瘰鳞蛇主要以伏击的形式捕食猎物，相对地雄性瘰鳞蛇则会比较主动地搜掠猎物。", source: "CMRC 2018 · 瘰鳞蛇" },
  { question: "瑞尼尔山因为什么可能引发巨大的火山泥流？", category: "十万个为什么", answer: "庞大的冰川", explain: "由于庞大的冰川，瑞尼尔山有可能引发巨大的火山泥流，将威胁到整个浦亚鲁普河山谷。", source: "CMRC 2018 · 瑞尼尔山" },
  { question: "吊钟花为什么被认为是中国新年花？", category: "十万个为什么", answer: "花朵通常在农历新年前后开花", explain: "因吊钟的花朵通常在农历新年前后开花，故英文又名为Chinese New Year Flower，意即中国新年花。", source: "CMRC 2018 · 吊钟" },
  { question: "10月9日被定为什么日子以纪念该条约的签署？", category: "十万个为什么", answer: "世界邮政日", explain: "10月9日定为世界邮政日（World Post Day ），以纪念该条约的签署。", source: "CMRC 2018 · 伯尔尼条约" },
  { question: "底特律第二浸信会为什么很快就负担起帮助解放奴隶的使命？", category: "十万个为什么", answer: "距离加拿大边境只有几英里远", explain: "底特律第二浸信会距离加拿大边境只有几英里远，很快负担起帮助解放奴隶的使命。", source: "CMRC 2018 · 底特律第二浸信会教堂" },
  { question: "1996年4月21日起为什么城巴12M线的客量开始回升？", category: "十万个为什么", answer: "每天清晨至午夜提供服务", explain: "后来于1996年4月21日起，提升至每天清晨至午夜提供服务，此后客量开始上升。", source: "CMRC 2018 · 城巴12M线" },
  { question: "巴沟站因何而得名？", category: "十万个为什么", answer: "临近“巴沟村”而得名", explain: "巴沟站是北京地铁10号线的车站，位于北京市海淀区巴沟路，临近“巴沟村”而得名。", source: "CMRC 2018 · 巴沟站" },
  { question: "10号线西土城站为什么采用分离式站厅？", category: "十万个为什么", answer: "为了绕开路口南北向地下管线", explain: "10号线西土城站为了绕开路口南北向地下管线采用分离式站厅，车站东西两端为三跨框架结构采用明挖施工，中部为单层双联拱结构采用暗挖法通过，这是为了不影响南北向交通及地下管线。", source: "CMRC 2018 · 西土城站 (北京市)" },
  { question: "在窑内烧制的花瓶为什么会变成红橙色？", category: "十万个为什么", answer: "氧化作用使花瓶变成红橙色", explain: "然后花瓶会放进约摄氏800度的窑内烧，氧化作用使花瓶变成红橙色。", source: "CMRC 2018 · 黑彩陶器" },
  { question: "龙山国小几经改名为什么最后改为台北市万华区龙山国民小学？", category: "十万个为什么", answer: "因台北市行政区重划", explain: "1990年因台北市行政区重划，改「台北市万华区龙山国民小学」。", source: "CMRC 2018 · 台北市万华区龙山国民小学" },
  { question: "司马伦倒台后，索靖为什么被加授散骑常侍？", category: "十万个为什么", answer: "以讨伐孙秀之功获加授散骑常侍", explain: "司马伦倒台后，索靖以讨伐孙秀之功获加授散骑常侍。", source: "CMRC 2018 · 索靖" },
  { question: "索靖去世后被追封为什么？", category: "十万个为什么", answer: "安乐亭侯", explain: "后来，索靖又被改赠司空，追封安乐亭侯，并获赐谥号为庄。", source: "CMRC 2018 · 索靖" },
  { question: "太浩湖旁边有一个小湖，为什么取名翡翠湾？", category: "十万个为什么", answer: "它的水的颜色是绿色的", explain: "之所以命名为翡翠湾，它的水的颜色是绿色的。", source: "CMRC 2018 · 太浩湖" },
  { question: "增城挂绿为什么叫挂绿？", category: "十万个为什么", answer: "每个果实都环绕有一圈绿线", explain: "其外形与一般荔枝不同，外壳红中带绿，四分绿六分红，每个果实都环绕有一圈绿线，故名挂绿。", source: "CMRC 2018 · 增城挂绿" },
  { question: "以仁王为什么没当上六条天皇的太子？", category: "十万个为什么", answer: "由于建春门院的作梗而作罢。", explain: "后白河上皇最初试图将他立为六条天皇的太子，但由于建春门院的作梗而作罢。永万2年（1165年），建春门院和后白河上皇所生的儿子宪仁亲王成为了皇太子。", source: "CMRC 2018 · 以仁王" },
  { question: "在佛教术语中，禅那被译为什么？", category: "十万个为什么", answer: "思惟修或静虑", explain: "禅那（，，，），又译为驮那演那，佛教术语，意译为思惟修或静虑，在佛教经论中，专指四种色界定。", source: "CMRC 2018 · 禅那" },
  { question: "葵扇为什么又叫芭蕉扇？", category: "十万个为什么", answer: "形似芭蕉叶", explain: "葵扇，又称蒲扇，是一种用蒲葵制成的，因形似芭蕉叶而得名，故又称芭蕉扇。", source: "CMRC 2018 · 葵扇" },
  { question: "廖立认为荆州被夺是因为什么？", category: "十万个为什么", answer: "关羽只有勇名而无军纪", explain: "又指关羽只有勇名而无军纪，致令荆州被夺；", source: "CMRC 2018 · 廖立" },
  { question: "项少龙为何妻妾成群？", category: "十万个为什么", answer: "项少龙为人风流且重视感情", explain: "项少龙为人风流且重视感情，故妻妾成群，唯后期较为克制。", source: "CMRC 2018 · 项少龙" },
  { question: "陆仲亨为什么受到明太祖的忌讳？", category: "十万个为什么", answer: "从陕西回京，用四匹马拉车", explain: "」从陕西回京，用四匹马拉车，为太祖所忌，罚代县拘捕盗贼。", source: "CMRC 2018 · 陆仲亨" },
  { question: "根据传说，猎骄靡为什么能被冒顿单于收养？", category: "十万个为什么", answer: "其曾被狼与乌鸦所救", explain: "猎骄靡被遗臣携往匈奴，传说其曾被狼与乌鸦所救，因此得以被冒顿单于收养。", source: "CMRC 2018 · 猎骄靡" },
  { question: "改革推行后，所有郡尉辖区被划分为什么？", category: "十万个为什么", answer: "都会郡和非都会郡", explain: "所有郡尉辖区都被划分为都会郡和非都会郡。", source: "CMRC 2018 · 1997年郡尉职权法案" },
  { question: "道同为什么被荐为太常寺赞礼郎？", category: "十万个为什么", answer: "事母至孝", explain: "事母至孝，洪武初，荐为太常寺赞礼郎，又出为番禺县令，为人刚正，与当地的土豪劣绅发生冲突。", source: "CMRC 2018 · 道同" },
  { question: "在2009年。为什么国会讨论将民用旗替换成白蓝红三色旗？", category: "十万个为什么", answer: "为了加强与俄罗斯之间的关系", explain: "2009年，为了加强与俄罗斯之间的关系，国会讨论将民用旗替换成白蓝红三色旗，与俄罗斯国旗基本相同，但采用 1:2 而不是俄罗斯 2:3 的比例。", source: "CMRC 2018 · 德涅斯特河沿岸摩尔达维亚共和国国旗" },
  { question: "张世昌为什么能在2009年中超最后一轮做客深圳时出场？", category: "十万个为什么", answer: "因曾诚的不冷静举动被罚下", explain: "2009年中超最后一轮作客深圳，因曾诚的不冷静举动被罚下才意外在中超完成一次出场，仓促上阵之下没能挽救少打一人的河南建业避免1比3落败。", source: "CMRC 2018 · 张世昌" },
  { question: "伊维卡·奥利奇为什么会提前结束2010-2011秋季？", category: "十万个为什么", answer: "因左膝严重受伤", explain: "2010年11月，奥历因左膝严重受伤，前往美国接受手术后，将会休息八个月，提早结束2010-2011球季。", source: "CMRC 2018 · 伊维卡·奥利奇" },
  { question: "2003年，列卡度·华斯迪在保顿期间为什么总是作为后备？", category: "十万个为什么", answer: "受到伤患困扰", explain: "2003年华斯迪免费加盟保顿，期间受到伤患困扰而多为作为后备，于2010年夏季遭球队弃用。", source: "CMRC 2018 · 列卡度·华斯迪" },
  { question: "尚恩·菲南在校时为什么会有“矮冬瓜”这个绰号？", category: "十万个为什么", answer: "长得不高", explain: "由于尚恩长得不高，他在校时有个绰号叫做“矮冬瓜”(Shorty)。", source: "CMRC 2018 · 尚恩·菲南" },
  { question: "美国电影为什么进行技术方面的变革？", category: "十万个为什么", answer: "电视的侵入", explain: "而面对电视的侵入，美国也开始考虑进行一些技术方面的变革，例如：宽银幕、立体电影、嗅觉电影等，一系列的新技术推向市场。", source: "CMRC 2018 · 美国新好莱坞电影" },
  { question: "金泛曾到澳大利亚留学，为什么又回到韩国？", category: "十万个为什么", answer: "因为外国的环境差异", explain: "金泛也曾经到澳大利亚留学了一段时间，但是最后还是因为外国的环境差异而回到韩国。", source: "CMRC 2018 · 金泛" },
  { question: "郭进为什么自缢身亡？", category: "十万个为什么", answer: "郭进屡次被田钦祚欺凌", explain: "郭进屡次被田钦祚欺凌，最后自缢死。", source: "CMRC 2018 · 郭进" },
  { question: "专辑中的歌曲《明星》成为什么主题曲？", category: "十万个为什么", answer: "2005年度亚洲游戏展", explain: "2005年度亚洲游戏展，古巨基被委任为亚洲游戏展大使。", source: "CMRC 2018 · 星战 (古巨基)" },
  { question: "南雅镇为什么最初命名为‘南瓦口’？", category: "十万个为什么", answer: "系建瓯南面门户", explain: "《建瓯县志》记载“东汉献帝建安初年，即隶属建安县，因系建瓯南面门户，初名‘南瓦口’。", source: "CMRC 2018 · 南雅镇 (建瓯市)" },
  { question: "江横须贺因何被移封至筑后久留米藩？", category: "十万个为什么", answer: "1620年因大坂之役的战功", explain: "1620年因大坂之役的战功，被移封至筑后久留米藩20万石，并由小堀政一以城代身份管治。", source: "CMRC 2018 · 福知山藩" },
  { question: "汤姆森汤普森为何会登上飞往月球的火箭？", category: "十万个为什么", answer: "记错时间阴差阳错登上火箭", explain: "在本作中，搭乘火箭前往月球的有丁丁及其的宠物白雪、阿道克船长、卡尔库鲁斯教授、助手弗兰克和因为记错时间阴差阳错登上火箭的汤姆森汤普森。", source: "CMRC 2018 · 月球探险" },
  { question: "丁丁和船长的悠闲假期因何被打乱？", category: "十万个为什么", answer: "歌后突然造访", explain: "丁丁和船长原本在城堡悠闲度假，却因歌后突然造访而弄得鸡飞狗跳；", source: "CMRC 2018 · 绿宝石失窃案" },
  { question: "2006年17173网为什么会被告上法庭？", category: "十万个为什么", answer: "旗下产品涉嫌侵权", explain: "2006年期间，17173曾因旗下产品涉嫌侵权而被天空游戏网诉至法庭，但并无下文。", source: "CMRC 2018 · 17173网" },
  { question: "李菁为何宣布退出娱乐圈？", category: "十万个为什么", answer: "长期陪伴在旁的母亲病故", explain: "1983年，长期陪伴在旁的母亲病故，遂宣布退出娱乐圈。", source: "CMRC 2018 · 李菁 (邵氏演员)" },
  { question: "格罗斯因因何被解除了主席的职位？", category: "十万个为什么", answer: "无法解释个人庞大财产来源", explain: "格罗斯因无法解释个人庞大财产来源而下台。", source: "CMRC 2018 · 捷克社会民主党" },
  { question: "珍·哈露与威廉·鲍威尔为什么没有结婚？", category: "十万个为什么", answer: "女方想要孩子而男方不同意", explain: "不过，因为女方想要孩子而男方不同意，两人最终没能步入婚姻的殿堂。", source: "CMRC 2018 · 珍·哈露" },
  { question: "刘定国虽然在票数上占有，为何还是没能成为苗栗县县长？", category: "十万个为什么", answer: "因仍具军人身分", explain: "刘定国虽以63,627票击败黄运金的60,814票，但因仍具军人身分，随后被判决当选无效。", source: "CMRC 2018 · 刘定国 (台湾)" },
  { question: "杨复恭因何被升为枢密使？", category: "十万个为什么", answer: "镇压庞勋有功", explain: "唐懿宗时，镇压庞勋有功，升枢密使。", source: "CMRC 2018 · 杨复恭" },
  { question: "《飘香剑雨》电影中为何天争教主无人知晓其身份？", category: "十万个为什么", answer: "其现身时均着一面具", explain: "故事叙述江湖中有一邪教名为天争，教主武功极为高强，且手段残酷，因欲称霸武林，不时令教众屠杀异己，其现身时均着一面具，故无人知晓其真实身分，更令江湖中人心惶惶。", source: "CMRC 2018 · 飘香剑雨 (电影)" },
  { question: "朱温为什么下令撤军？", category: "十万个为什么", answer: "时军中断粮，士卒多疫疾", explain: "时军中断粮，士卒多疫疾，朱温下令撤军，氏叔琮经上党南退，史称唐末晋阳之战。", source: "CMRC 2018 · 氏叔琮" },
  { question: "朱温后来为何贬黜氏叔琮？", category: "十万个为什么", answer: "以氏叔琮“军政不理”为由", explain: "事后朱温以氏叔琮“军政不理”为由，贬白州司户。", source: "CMRC 2018 · 氏叔琮" },
  { question: "传说广济寺因何而建？", category: "十万个为什么", answer: "为纪念金乔觉曾在此结茅庵驻锡", explain: "广济寺位于中国安徽省芜湖市镜湖区赭山西南麓半山腰上，始建于唐代干宁年间（传为纪念金乔觉曾在此结茅庵驻锡而建），光化年间署名永清寺，又称广济院，北宋大中祥符年间改今名。", source: "CMRC 2018 · 广济寺 (芜湖)" },
  { question: "它们因何理论可以用于一大类游戏的研究？", category: "十万个为什么", answer: "斯普莱格–格隆第定理", explain: "但是由于斯普莱格–格隆第定理，它们可以用于一大类游戏的研究。", source: "CMRC 2018 · 尼姆数" },
  { question: "卢世荣的理财措施为什么难以实行？", category: "十万个为什么", answer: "触犯了富豪势要的利益", explain: "与此同时，卢世荣的理财措施有许多因触犯了富豪势要的利益，导致难以实行。", source: "CMRC 2018 · 卢世荣" },
  { question: "1938年吴勇因何被驱逐出境？", category: "十万个为什么", answer: "策划反英活动", explain: "1938年因策划反英活动，被新加坡殖民政府驱逐出境，辗转返回福建，途中受到很多基督徒朋友帮助。", source: "CMRC 2018 · 吴勇" },
  { question: "Hammer博士因何闻名？", category: "十万个为什么", answer: "古动物学与南极洲研究", explain: "种名则是以伊利诺州奥古斯塔那学院的William R. Hammer博士为名，Hammer博士是以古动物学与南极洲研究闻名。", source: "CMRC 2018 · 冰河龙属" },
  { question: "鬼怒川因何闻名？", category: "十万个为什么", answer: "洪水泛滥", explain: "而自古以来，鬼怒川便以洪水泛滥而闻名，因此到了近世，人们以日语发音相近的汉字改称为「鬼怒川」，取其「凶猛狂暴如鬼之怒」之意。", source: "CMRC 2018 · 鬼怒川" },
  { question: "《欢天喜地七仙女》第二部将正式命名为什么？", category: "十万个为什么", answer: "《天地姻缘七仙女》", explain: "本剧自2005年暑期开播以来，因受广大观众们的支持与吹捧，第二部将正式命名为《天地姻缘七仙女》于2010年1月3日开机拍摄中。", source: "CMRC 2018 · 欢天喜地七仙女" },
  { question: "沼泽乳草为什么特别为蝴蝶和其它授粉类昆虫所喜爱？", category: "十万个为什么", answer: "其花朵分泌大量的花蜜", explain: "由于其花朵分泌大量的花蜜，因而特别为蝴蝶和其它授粉类昆虫所喜爱。", source: "CMRC 2018 · 沼泽乳草" },
  { question: "前335年，培松被任命为什么？", category: "十万个为什么", answer: "亚历山大的七护卫", explain: "前335年，培松被任命为亚历山大的七护卫。", source: "CMRC 2018 · 培松" },
  { question: "Ubuntu Studio主要是为何而设计？", category: "十万个为什么", answer: "一般的多媒体制作", explain: "这个版本主要是为一般的多媒体制作而设计。", source: "CMRC 2018 · Ubuntu Studio" },
  { question: "2005年台北国际牛肉面节当时名为什么？", category: "十万个为什么", answer: "「台北牛肉面节」", explain: "该活动创立于2005年，当时名为「台北牛肉面节」。", source: "CMRC 2018 · 台北国际牛肉面节" },
  { question: "王尚智被联合新闻网和凤凰网推荐为什么？", category: "十万个为什么", answer: "「媒体名人部落格」", explain: "其个人网志「王尚智的双城心事」遍谈两岸政治、国际财经，及文化评论等领域，获联合新闻网、凤凰网推荐为「媒体名人部落格」。", source: "CMRC 2018 · 王尚智" },
  { question: "昆仑弟子陈小飞为什么遭到师弟师妹的追杀？", category: "十万个为什么", answer: "学妹背叛", explain: "而一位昆仑弟子陈小飞，因为学妹背叛，所以遭师弟、妹的追杀，也跑到了王六包子店；", source: "CMRC 2018 · 江湖.com" },
  { question: "2007年总决赛为什么取消了？", category: "十万个为什么", answer: "缺乏赞助", explain: "2007年总决赛曾因缺乏赞助而取消。", source: "CMRC 2018 · 世界羽联超级系列赛总决赛" },
  { question: "很多特殊代词的尾缀被借用为什么？", category: "十万个为什么", answer: "名词尾缀", explain: "很多特殊代词尾缀被借用为名词尾缀。", source: "CMRC 2018 · 原始印欧语代词" },
  { question: "画法几何的起源是因为什么？", category: "十万个为什么", answer: "军事上的应用需要", explain: "其起源于军事上的应用需要，主要由法国数学家加斯帕·蒙日提出。", source: "CMRC 2018 · 画法几何" },
  { question: "查令十字又翻译为什么名字？", category: "十万个为什么", answer: "查灵歌斯、查灵十字、查宁阁等", explain: "查令十字（Charing Cross，），或译查灵歌斯、查灵十字、查宁阁等，是位於伦敦西敏市的一个交汇路口，是伦敦的传统中心点，也是英国习惯上的铁路、公路里程零基准点。", source: "CMRC 2018 · 查令十字" },
  { question: "自立为帝的高升泰封国号为什么？", category: "十万个为什么", answer: "“大中”", explain: "宋哲宗绍圣元年（1094年），一直以来都在专权的高升泰废段正明，自立为帝，国号“大中”，年号上治。", source: "CMRC 2018 · 高升泰" },
  { question: "风吕敷因为什么而在民间普及起来？", category: "十万个为什么", answer: "随着澡堂的普及", explain: "此后，在江户时代随着澡堂的普及，风吕敷也在民间普及起来。", source: "CMRC 2018 · 风吕敷" },
  { question: "733年，新罗士卒为何死者过半，无功而还？", category: "十万个为什么", answer: "于大雪", explain: "733年，新罗奉唐朝之命从南方攻击渤海，由于大雪，士卒死者过半，无功而还。", source: "CMRC 2018 · 大武艺" },
  { question: "基础代谢率的单位为什么？", category: "十万个为什么", answer: "“千焦/平方米/小时”", explain: "基础代谢率的单位为“千焦/平方米/小时”，表征每小时每平方米体表所散发的热量。", source: "CMRC 2018 · 基础代谢率" },
  { question: "Walt Kowalski为什么牺牲了自己？", category: "十万个为什么", answer: "以铲除苗族裔不良份子", explain: "苗族裔受恩涌泉以报，结果身患绝症的他牺牲自己以铲除苗族裔不良份子。", source: "CMRC 2018 · 驱·逐" },
  { question: "纳托尔为什么经由新奥尔良回到伦敦？", category: "十万个为什么", answer: "当时英国和美国开战", explain: "纳托尔考察后，由于当时英国和美国开战，他只得经由新奥尔良回到伦敦，回来后继续研究他收集的标本。", source: "CMRC 2018 · 托马斯·纳托尔" },
  { question: "粗粹取的竹醋液静置3-6个月后，为什么会分为三层？", category: "十万个为什么", answer: "受重力影响", explain: "将粗粹取的竹醋液静置3-6个月后，受重力影响，竹醋液分为三层，最重的焦油在最底层，中间为竹醋水，上层为轻质焦油。", source: "CMRC 2018 · 竹醋液" },
  { question: "韩通为什么被提拔为骑军队长？", category: "十万个为什么", answer: "应募从军，勇于作战", explain: "少年应募从军，勇于作战，被提拔为骑军队长。", source: "CMRC 2018 · 韩通 (后周)" },
  { question: "郭家梁为什么会研究中医？", category: "十万个为什么", answer: "因个人兴趣", explain: "从军，随国民政府撤退至台湾，服务于高雄左营军队中，因个人兴趣，开始研究中医。", source: "CMRC 2018 · 郭家梁" },
  { question: "现在第一条原创的钢制拖链样板已经发展为什么？", category: "十万个为什么", answer: "钢制和塑料拖链", explain: "现在第一条原创的钢制拖链样板已经发展为形形色色的钢制和塑料拖链，广泛应用于很多领域。", source: "CMRC 2018 · 拖链" },
  { question: "拖链为什么能分为桥式拖链，全封闭拖链，半封闭拖链三种？", category: "十万个为什么", answer: "使用环境和使用要求的不同", explain: "拖链根据使用环境和使用要求的不同分为桥式拖链，全封闭拖链，半封闭拖链三种。", source: "CMRC 2018 · 拖链" },
  { question: "那名电脑游戏爱好者为什么误入到游戏世界？", category: "十万个为什么", answer: "被一个闪电击中", explain: "因为被一个闪电击中，误入到游戏世界，带领正义勇敢的机车族与凶狠狡猾的猛兽族进行一场世纪大对决。", source: "CMRC 2018 · 百变机兽" },
  { question: "2009年12月19日，山寨春晚更名为什么？", category: "十万个为什么", answer: "“民间春晚”", explain: "2009年12月19日，由民间文艺爱好者组成的“山寨春晚”组委会已得到文化部门的正式批文，活动更名为“民间春晚”。", source: "CMRC 2018 · 山寨春晚" },
  { question: "在2009年春节期间，山寨春晚的网址为什么遭腾讯QQ屏蔽？", category: "十万个为什么", answer: "腾讯的理由为“不良网址”", explain: "在2009年春节期间，山寨春晚的网址http://www.ccstv.net遭腾讯QQ屏蔽，腾讯的理由为“不良网址”。", source: "CMRC 2018 · 山寨春晚" },
  { question: "溪生战役中美军为什么能坚守基地？", category: "十万个为什么", answer: "优势空中火力的支援", explain: "而美军则在优势空中火力的支援下坚守基地。", source: "CMRC 2018 · 溪生战役" },
  { question: "士徽为什么开城投降？", category: "十万个为什么", answer: "见守城无望", explain: "士徽见守城无望，在兄长士祗的劝说下开城投降，兄弟等六人赤裸出降。", source: "CMRC 2018 · 士徽" },
  { question: "瑟琳娜为什么是其他女孩的威胁？", category: "十万个为什么", answer: "瑟琳娜神秘而美丽", explain: "瑟琳娜神秘而美丽，是其他女孩的一个威胁。", source: "CMRC 2018 · 韦倩莲" },
  { question: "陈开为什么与李文茂起义包围广州？", category: "十万个为什么", answer: "受金田起义的影响", explain: "原为天地会领导人，受金田起义的影响，1854年与李文茂起义包围广州，两广总督叶名琛在英国香港总督宝宁援助下，坚守广州半年不失。", source: "CMRC 2018 · 陈开" },
  { question: "安南都护李象古为什么失去众心？", category: "十万个为什么", answer: "贪纵苛刻", explain: "当时的安南都护李象古以「贪纵苛刻而失众心」，见杨清据守驩州，心中忌之，于819年召杨清至安南都护府任自己的牙将，令其带三千人兵前往镇压黄洞蛮。", source: "CMRC 2018 · 杨清" },
  { question: "杨志烈为什么率军投降唐朝？", category: "十万个为什么", answer: "因势单力薄", explain: "但不久即因势单力薄，率军投降唐朝。", source: "CMRC 2018 · 杨清" },
  { question: "现在的印度政府为什么要停止街头弄蛇表演？", category: "十万个为什么", answer: "为了保护野生蛇类", explain: "现在印度政府为了保护野生蛇类，决定停止国内的街头弄蛇表演业。", source: "CMRC 2018 · 弄蛇术" },
  { question: "元详为什么用阴谋将六哥元勰排挤？", category: "十万个为什么", answer: "元详想独揽大权", explain: "元详想独揽大权，用阴谋将六哥元勰排挤，自己被皇帝任命为太傅，领司徒，侍中、录尚书事，贪财无厌，公私营贩，又抢夺良民宅第，威望很劣。", source: "CMRC 2018 · 元详" },
  { question: "大业三年循州改名为什么？", category: "十万个为什么", answer: "龙川郡", explain: "大业三年（607年）改为龙川郡。", source: "CMRC 2018 · 循州" },
  { question: "司马模为什么在总是中有贤名？", category: "十万个为什么", answer: "少好学", explain: "少好学，与琅琊王司马睿及范阳王司马虓在宗室中有贤名。", source: "CMRC 2018 · 司马模" },
  { question: "狐狸为什么要请山鹰照顾小狐狸？", category: "十万个为什么", answer: "狐狸去猎食", explain: "某日狐狸去猎食，请山鹰帮忙照顾小狐狸，山鹰虽然答应了，但及后却因为非常肚饿，竟然将三只小狐狸全捉回巢中与小鹰一起吃。", source: "CMRC 2018 · 山鹰和狐狸" },
  { question: "山鹰为什么要吃掉小狐狸？", category: "十万个为什么", answer: "非常肚饿", explain: "某日狐狸去猎食，请山鹰帮忙照顾小狐狸，山鹰虽然答应了，但及后却因为非常肚饿，竟然将三只小狐狸全捉回巢中与小鹰一起吃。", source: "CMRC 2018 · 山鹰和狐狸" },
  { question: "鹤为什么要找狐狸道歉？", category: "十万个为什么", answer: "觉得自己的语气太重了", explain: "几日后，鹤觉得自己的语气太重了，便去找狐狸道歉。", source: "CMRC 2018 · 狐狸和鹤" },
  { question: "BA-6侦察角色为什么被T-60坦克及T-70坦克等取代？", category: "十万个为什么", answer: "其装甲不足以应付德军火力", explain: "由于其装甲不足以应付德军火力，所以其侦察角色被T-60坦克及T-70坦克等取代。", source: "CMRC 2018 · BA-6装甲车" },
  { question: "护法为什么可以出任那烂陀寺住持？", category: "十万个为什么", answer: "其天资聪颖、见解超群", explain: "护法出身南印度达罗毗荼国首都建志补罗城，其天资聪颖、见解超群，曾出任那烂陀寺住持。", source: "CMRC 2018 · 护法 (人名)" },
  { question: "成员国为什么由一开始的三个变为四个？", category: "十万个为什么", answer: "因捷克斯洛伐克解体", explain: "后因捷克斯洛伐克解体，成员国变为四国。", source: "CMRC 2018 · 维谢格拉德集团" },
  { question: "扶余隆为什么不敢上任？", category: "十万个为什么", answer: "害怕受到新罗国的侵略", explain: "但扶余隆害怕受到新罗国的侵略，未敢赴任，只好由唐朝将领刘仁轨检校熊津都督。", source: "CMRC 2018 · 熊津都督府" },
  { question: "苹果为什么为 v10.0 的使用者推出免费的升级 CD？", category: "十万个为什么", answer: "由于 v10.0 的口碑不好", explain: "由于 v10.0 的口碑不好，苹果为 v10.0 的使用者推出免费的升级 CD，此为对于只有运行 Mac OS 9 的人推出 $129 美元的盒装版本。", source: "CMRC 2018 · Mac OS X v10.1" },
  { question: "南北两组平均分为什么队？", category: "十万个为什么", answer: "种籽队和非种籽队", explain: "72队参赛队伍分为南北两组，每组平均分为种籽队和非种籽队，而排名则根据上年成绩而定。", source: "CMRC 2018 · 2008年至2009年英格兰联赛杯" },
  { question: "大都会人寿为什么要缩减大楼高度？", category: "十万个为什么", answer: "为经济大萧条的缘故", explain: "麦迪逊大道11号大楼原本设计的比现在还要高，但是因为经济大萧条的缘故，大都会人寿只好缩减大楼高度，但是其装饰风艺术设计仍是非常精美。", source: "CMRC 2018 · 23街 (曼哈顿)" },
  { question: "在上西城，59街以北更名为什么？", category: "十万个为什么", answer: "阿姆斯特丹大道", explain: "在59街以北，曼哈顿的街区在中央公园两侧分为上西城和上东城，在上西城，59街以北更名为阿姆斯特丹大道，第十一大道更名为West End Avenue.", source: "CMRC 2018 · 59街" },
  { question: "李煦为什么会有「李佛」的称号？", category: "十万个为什么", answer: "为人宽怀仁慈，颇得当地的民心", explain: "李煦为人宽怀仁慈，颇得当地的民心，有「李佛」称号，但是“公子性奢华，好串戏，延名师，以教习梨园”，康熙四次南巡，李煦、曹寅等大事铺张，导致亏空高达数十万两。", source: "CMRC 2018 · 李煦" },
  { question: "安德里斯库斯在马其顿短暂的统治最终被定性为什么？", category: "十万个为什么", answer: "残暴的、压榨的。", explain: "安德里斯库斯在马其顿短暂的统治，被定性为残暴的、压榨的。马其顿最后成为罗马的一个行省。", source: "CMRC 2018 · 第四次马其顿战争" },
  { question: "曹操后来为什么支持不下去了？", category: "十万个为什么", answer: "袁绍军兵多粮足，曹操粮少", explain: "虽然如此，但袁绍军兵多粮足，曹操粮少，曹操不能支持下去，正巧袁绍手下谋士许攸来降，许攸献上奇袭一计，曹操言听计从，将袁军粮草全部烧毁，情况自此改变。", source: "CMRC 2018 · 乌巢之战" },
  { question: "时惠环球的大陆业务被命名为什么？", category: "十万个为什么", answer: "东方银座", explain: "2007年10月，时惠环球的大陆业务使用了时惠环球的上市地位，并命名为东方银座（）。", source: "CMRC 2018 · 时惠环球控股" },
  { question: "卡鲁索凯旋门为什么变成卡鲁索广场的主要标志？", category: "十万个为什么", answer: "宫殿的消失", explain: "随著宫殿的消失，卡鲁索凯旋门变成卡鲁索广场的主要标志。", source: "CMRC 2018 · 卡鲁索凯旋门" },
  { question: "该电影因为什么引发了争议？", category: "十万个为什么", answer: "因其变态的内容", explain: "当1972年上映时，这部片子因其变态的内容引发了大规模争论，并使它成为了最臭名昭著的非主流电影。", source: "CMRC 2018 · 粉红色火烈鸟" },
  { question: "FedUni在澳大利亚因何被称为第一？", category: "十万个为什么", answer: "第一所区域型、多领域大学", explain: "FedUni是澳大利亚第一所区域型、多领域大学，同时也是澳大利亚第三古老的大学，现已发展成为澳大利亚区域型大学的先驱。", source: "CMRC 2018 · 澳大利亚联邦大学" },
  { question: "铁路芦潮港客运中心站为什么自2015年8月27日起暂停运营？", category: "十万个为什么", answer: "由于离危险品仓库过近", explain: "由于离危险品仓库过近，铁路芦潮港客运中心站自2015年8月27日起暂停运营。", source: "CMRC 2018 · 芦潮港站" },
  { question: "高岳为什么被封为清河王？", category: "十万个为什么", answer: "屡次出征，功勋卓越", explain: "屡次出征，功勋卓越，封清河王。", source: "CMRC 2018 · 高岳" },
  { question: "高岳被追封为什么？", category: "十万个为什么", answer: "太师", explain: "”562年，武成帝高湛以谋逆将高归彦处死，将其家属共百余人赏赐给高岳家当奴仆，又追赠高岳为太师。", source: "CMRC 2018 · 高岳" },
  { question: "此比赛在1939-1940年为什么停赛？", category: "十万个为什么", answer: "因第二次世界大战影响", explain: "此赛事曾经在1939-1940年因第二次世界大战影响停办。", source: "CMRC 2018 · 凯旋门大赛" },
  { question: "2008年为什么奖金突然增长？", category: "十万个为什么", answer: "获得卡塔尔赛马会赞助", explain: "2008年获得卡塔尔赛马会赞助，总奖金由200万欧元增至400万欧元，成为欧洲草地赛事中最高奖金的比赛。", source: "CMRC 2018 · 凯旋门大赛" },
  { question: "郑信为什么将都城建立在了吞武里？", category: "十万个为什么", answer: "大城因战争残破不堪", explain: "然而，大城因战争残破不堪，郑信没有将都城定在那里，而是建立在了吞武里。", source: "CMRC 2018 · 吞武里王朝" },
  { question: "历史上的乌尔根奇的繁华为什么日渐没落？", category: "十万个为什么", answer: "随著阿姆河的河道迁移", explain: "但是随著阿姆河的河道迁移，乌尔根奇的繁华便日渐没落，16世纪以后，政治、商业的重心渐渐移向了北部的希瓦。", source: "CMRC 2018 · 乌尔根奇" },
  { question: "他为什么与自己的第一个乐团分离？", category: "十万个为什么", answer: "因为跟团员要走的音乐风格不同", explain: "之后因为跟团员要走的音乐风格不同，所以就离团了。", source: "CMRC 2018 · 安德烈·马特斯" },
  { question: "明治维新后，为什么有大量的日本人选择移民美国？", category: "十万个为什么", answer: "为追求更好的生活", explain: "明治维新后，曾经有一段时期有大量的日本人为追求更好的生活而移民美国。", source: "CMRC 2018 · 日本街" },
  { question: "这个游戏在台湾方面为什么停止运营？", category: "十万个为什么", answer: "由于玩家人数不断锐减", explain: "台湾方面由于玩家人数不断锐减，游戏橘子于2008年7月1日发布即将停止营运公告，自10月1日起台湾版椰子罐头正式停止营运。", source: "CMRC 2018 · 椰子罐头Online" },
  { question: "结构性失业被归类为什么？", category: "十万个为什么", answer: "自然失业", explain: "摩擦性失业和结构性失业被归类为自然失业，经济学家视这两种失业为正常现象。", source: "CMRC 2018 · 结构性失业" },
  { question: "员贝的海上步道为什么禁止同行了？", category: "十万个为什么", answer: "因严重破坏了海洋生态", explain: "员贝古道踏浪，由石板、碎石以及珊瑚礁等组成的海上步道，在退潮后，由湖西乡沙港至员贝屿之间通行，长4.5公里，步程约2个小时，但因严重破坏了海洋生态，现今已禁止此步道的开放。", source: "CMRC 2018 · 员贝屿" },
  { question: "卡尔·菲利普王子为什么得到王位第一继承权？", category: "十万个为什么", answer: "由于瑞典宪法尚未修改", explain: "出生时，由于瑞典宪法尚未修改，卡尔·菲利普王子得到王位第一继承权。", source: "CMRC 2018 · 卡尔·菲利普王子 (瑞典)" },
  { question: "朱慈炫去世后被追谥为什么封号？", category: "十万个为什么", answer: "哀愍太子", explain: "」遂于永历十六年（1662年）与其父一同被杀于滇京五华山逼死坡，年十四岁，郑经追谥为哀愍太子。", source: "CMRC 2018 · 朱慈煊" },
  { question: "飞鹅岭在为什么是历来兵家必争之地？", category: "十万个为什么", answer: "因是当时惠州城最高的山体", explain: "飞鹅岭因是当时惠州城最高的山体，故历来是兵家必争之地。", source: "CMRC 2018 · 飞鹅岭 (惠州)" },
  { question: "杜范去世后追谥为什么？", category: "十万个为什么", answer: "清献", explain: "淳祐五年（1245年）四月二十一日，病逝临安，宋理宗谥清献。", source: "CMRC 2018 · 杜范" },
  { question: "巴耶塞特与弟弟杰姆因为什么而开战？", category: "十万个为什么", answer: "王位继承权", explain: "巴耶塞特的父王穆罕默德二世在1481年去世后，巴耶塞特与弟弟杰姆为王位继承权而开战，杰姆战败后逃到罗德岛，巴耶塞特登上王位。", source: "CMRC 2018 · 奥斯曼帝国的扩张" },
  { question: "塞斯·亚伦·罗根为什么迁居至美国洛杉矶？", category: "十万个为什么", answer: "为了参与演出工作", explain: "为了参与演出工作，他迁居至美国洛杉矶，《怪胎们》在播映一季后便停播。", source: "CMRC 2018 · 塞斯·罗根" },
  { question: "因为什么事情，特罗曼献出了自己的生命？", category: "十万个为什么", answer: "在纽约休伦湖为了拯救落水的人", explain: "1956年6月18日，在纽约休伦湖为了拯救落水的人，特罗曼献出了自己的生命。", source: "CMRC 2018 · 陶申·特罗曼" },
  { question: "李瑞东的绰号因何而得？", category: "十万个为什么", answer: "因为鼻子扁平", explain: "李瑞东因为鼻子扁平，绰号“鼻子李”。", source: "CMRC 2018 · 李瑞东" },
  { question: "2007年4月，彤丝朵为什么动了外科手术？", category: "十万个为什么", answer: "来矫正她因童年感染", explain: "2007年4月，彤丝朵动了外科手术，来矫正她因童年感染，而尺寸较一般人小的肾脏的位置。", source: "CMRC 2018 · 凯蒂·彤丝朵" },
  { question: "焦哈尔·杜达耶夫执政后，阿尔哈诺夫成为什么派领导人？", category: "十万个为什么", answer: "反对派", explain: "焦哈尔·杜达耶夫执政后，阿尔哈诺夫成为主要反对派领导人。", source: "CMRC 2018 · 阿卢·阿尔哈诺夫" },
  { question: "马沙沟为什么变得有名？", category: "十万个为什么", answer: "因近年举办海滩派对而逐渐知名", explain: "因近年举办海滩派对而逐渐知名。", source: "CMRC 2018 · 马沙沟" },
  { question: "唐朝在665年把五个都督府统一合并为什么？", category: "十万个为什么", answer: "熊津都督府", explain: "但随着后来的百济复国运动，唐朝在665年把五个都督府统一合并为熊津都督府。", source: "CMRC 2018 · 熊津" },
  { question: "皇太极追尊都督福满为什么？", category: "十万个为什么", answer: "庆王", explain: "1636年5月16日（清崇德元年四月乙亥朔十二日丙戌），皇太极追尊他为庆王。", source: "CMRC 2018 · 福满" },
  { question: "奥古斯丁教堂为何逐渐演变为该建筑群的一部分？", category: "十万个为什么", answer: "由于邻近的霍夫堡皇宫扩展", explain: "由于邻近的霍夫堡皇宫扩展，奥古斯丁教堂逐渐演变为该建筑群的一部分。", source: "CMRC 2018 · 维也纳奥古斯丁教堂" },
  { question: "2001年初徐阳为何没有转到重庆力帆？", category: "十万个为什么", answer: "被山东鲁能中途“截牌”", explain: "2001年初他以国脚身份从北京国安挂牌希望转会到重庆力帆，但是被山东鲁能中途“截牌”，最终以350万元的高价完成转会。", source: "CMRC 2018 · 徐阳" },
  { question: "东涌道早期为什么样的行车的道路？", category: "十万个为什么", answer: "一条单线双程", explain: "早期为一条单线双程行车的道路，途中设有多个避车处，及后因青屿干线通车及北大屿山新市镇首期入伙，令居民及游人改选使用东涌道进出大屿山南部地区，使东涌道的车流量超出负荷。", source: "CMRC 2018 · 东涌道北" },
  { question: "同治年间，马维祺因何闻名？", category: "十万个为什么", answer: "武艺", explain: "同治年间，董海川因年老，离开肃王府，曾经住在马维祺家中三年，这段时间，马维祺专心跟随董海川练功，功力精进，因而以武艺闻名北京。", source: "CMRC 2018 · 马维祺" },
  { question: "川酒因为什么闻名国内外?", category: "十万个为什么", answer: "四川产酒量大和知名品牌众多", explain: "川酒，指产于中国四川地区的白酒，因四川产酒量大和知名品牌众多而闻名国内外。", source: "CMRC 2018 · 川酒" },
  { question: "卫笑堂因为什么疾病过世？", category: "十万个为什么", answer: "心脏病", explain: "民国73年（1984年），因心脏病发作过世。", source: "CMRC 2018 · 卫笑堂" },
  { question: "安达·俄松又被译为什么？", category: "十万个为什么", answer: "微松、欧松、沃松等", explain: "安达·俄松（，，藏语中意思是“光护”），又译为微松、欧松、沃松等。", source: "CMRC 2018 · 俄松" },
  { question: "公司之后再1999年改名为什么？", category: "十万个为什么", answer: "Connex", explain: "公司之后再1999年改名为Connex。", source: "CMRC 2018 · 威立雅运输" },
  { question: "霍弋为什么要规劝刘璿？", category: "十万个为什么", answer: "刘璿好骑射，出入无度", explain: "刘璿好骑射，出入无度，霍弋援引古书进行规劝，表现很得体。", source: "CMRC 2018 · 霍弋" },
  { question: "黄浩然为什么有「诗人」的外号？", category: "十万个为什么", answer: "因为名字让人联想起孟浩然", explain: "黄浩然（阿美语：，），因为名字让人联想起孟浩然而有「诗人」的外号，阿美族，为台湾的棒球选手之一，目前效力于中华职棒Lamigo桃猿队，守备位置为捕手。", source: "CMRC 2018 · 黄浩然 (棒球运动员)" },
  { question: "尚健为什么改名为朝直？", category: "十万个为什么", answer: "避萨摩藩藩主岛津忠义之讳", explain: "其名乘原为「朝忠」，后因避萨摩藩藩主岛津忠义之讳，改为「朝直」。", source: "CMRC 2018 · 尚健" },
  { question: "1994年奥姆真理教实行省厅制后被任命为什么？", category: "十万个为什么", answer: "科学技术省大臣", explain: "村井秀夫（，），日本科学家，奥姆真理教集团“科学技术省大臣”（最高干部）。", source: "CMRC 2018 · 村井秀夫" },
  { question: "变色树蜥为何又被称为鸡冠蛇？", category: "十万个为什么", answer: "背部有一例像鸡冠的脊突", explain: "背部有一例像鸡冠的脊突，所以又叫鸡冠蛇。", source: "CMRC 2018 · 变色树蜥" },
  { question: "大刺鳅的上部分为什么颜色？", category: "十万个为什么", answer: "金黄色", explain: "本鱼体修长，上部分为金黄色，下半部为深褐色，腹面有两排椭圆形斑块。", source: "CMRC 2018 · 大刺鳅" },
  { question: "黄鳍多棘鳞鲀成鱼时转变为什么颜色？", category: "十万个为什么", answer: "深橄榄绿或深褐色", explain: "成鱼则转变为深橄榄绿或深褐色，眼下具一细长白色横带。", source: "CMRC 2018 · 黄鳍多棘鳞鲀" },
  { question: "米点箱鲀幼鱼似颗黑底白点的小圆球，随成长变为什么颜色？", category: "十万个为什么", answer: "黑褐色", explain: "幼鱼似颗黑底白点的小圆球，随成长变为黑褐色；", source: "CMRC 2018 · 米点箱鲀" },
  { question: "丁比站为什么不再使用1和2号月台？", category: "十万个为什么", answer: "东山线的列车不再停下此站", explain: "在车站北面设有一这行人天桥连接各个月台，但随著东山线的列车不再停下此站，1和2号月台就不会再使用。", source: "CMRC 2018 · 丁比站" },
  { question: "金平糖名称因何而来？", category: "十万个为什么", answer: "葡萄牙语「糖果」一字", explain: "其名称来自于葡萄牙语「糖果」一字（）。", source: "CMRC 2018 · 金平糖" },
  { question: "叶绍德因何病逝？", category: "十万个为什么", answer: "癌症引起并发症逝", explain: "2009年4月4日香港时间中午12时20分，他因癌症引起并发症逝世于九龙播道医院；", source: "CMRC 2018 · 叶绍德" },
  { question: "2007年原定于秋季演出的阿里郎节为何没有举行？", category: "十万个为什么", answer: "因洪灾被取消", explain: "2007年阿里郎节曾在四五月间上演，而原定秋季的演出因洪灾被取消。", source: "CMRC 2018 · 阿里郎节" },
  { question: "农劲荪为什么总是出现在以霍元甲为中心人物的后代各改编作品中？", category: "十万个为什么", answer: "身为传奇人物霍元甲的挚友", explain: "农劲荪是位真实存在的历史人物，身为传奇人物霍元甲的挚友，此号人物也总是出现在以霍元甲为中心人物的后代各改编作品中。", source: "CMRC 2018 · 农劲荪" },
  { question: "巴塞隆拿球为什么会和施云奴续约至2009年？", category: "十万个为什么", answer: "2008年他在球会有好表现", explain: "2008年他在球会有好表现，使球会和他续约至2009年。", source: "CMRC 2018 · 施云奴" },
  { question: "鲲鹏航空准备在北京奥运前引进20架支线客机的计划为何落空？", category: "十万个为什么", answer: "伊春空难后该公司即宣布破产", explain: "伊春空难后该公司即宣布破产，但公司仍未注销。", source: "CMRC 2018 · 鲲鹏航空" },
  { question: "美国波士顿宣布退出后为什么洛杉矶选择顶替？", category: "十万个为什么", answer: "美国奥委会决定", explain: "美国波士顿原本也提出申办，但于2015年7月27日宣布退出，后美国奥委会决定由洛杉矶顶替。", source: "CMRC 2018 · 2024年夏季奥林匹克运动会" },
  { question: "巴统地区在1920年之前为什么没有在乔治亚政府的控制之下？", category: "十万个为什么", answer: "由于英国的占据", explain: "另一方面，由于英国的占据，使巴统地区在1920年之前均未在乔治亚政府的控制之下，1918年12月25日，英国势力也进入了提比利西。", source: "CMRC 2018 · 乔治亚民主共和国" },
  { question: "小檗属有些种的果实可以食用，为什么没有被普遍作为人类食品？", category: "十万个为什么", answer: "味道很酸，而且因刺多不易收获", explain: "有些种的的果实可以食用，富含维生素C，但味道很酸，而且因刺多不易收获，所以作为人类食品并不普遍。", source: "CMRC 2018 · 小檗属" },
  { question: "食用鱼类为什么要避免食用内脏及头部？", category: "十万个为什么", answer: "可能有毒性累积", explain: "食用鱼类，内脏及头部可能有毒性累积，故避免食用此部位。", source: "CMRC 2018 · 短喙鼻鱼" },
  { question: "在仙人洞西侧的圆门内侧有怪石，名为什么？", category: "十万个为什么", answer: "蟾蜍石", explain: "在仙人洞西侧的圆门内侧有怪石，名为蟾蜍石，石上长有古松。", source: "CMRC 2018 · 庐山仙人洞" },
  { question: "天道庄庄主杜天道（陈观泰饰）因为什么自而性情大变，横霸乡里？", category: "十万个为什么", answer: "妻儿遭仇家天南三虎所害", explain: "故事叙述天道庄庄主杜天道（陈观泰饰）因妻儿遭仇家天南三虎所害，自而性情大变，横霸乡里。", source: "CMRC 2018 · 残缺 (电影)" },
  { question: "白色玉珊瑚为什么又叫＂樱桃椒＂？", category: "十万个为什么", answer: "果实酷似樱桃", explain: "花色：白色玉珊瑚又叫＂樱桃椒＂，茄科长绿灌木，因为果实酷似樱桃而得名。", source: "CMRC 2018 · 玉珊瑚" },
  { question: "玉珊瑚为什么主要用为观赏植物？", category: "十万个为什么", answer: "花期长", explain: "玉珊瑚由于花期长，因此主要用为观赏植物（果实从结果到成熟落果可持久达三个月以上），玉珊瑚的果实浑圆晶莹，玲珑可爱，为观果之珍品，适合庭植缘栽，盆栽，果枝作花材。", source: "CMRC 2018 · 玉珊瑚" },
  { question: "玉珊瑚的花色为什么色？", category: "十万个为什么", answer: "白色", explain: "花色：白色玉珊瑚又叫＂樱桃椒＂，茄科长绿灌木，因为果实酷似樱桃而得名。", source: "CMRC 2018 · 玉珊瑚" },
  { question: "关中书院在1982年定名为什么？", category: "十万个为什么", answer: "陕西省西安师范学校", explain: "1903年，关中书院更名为陕西省第一师范学堂，1912年改为陕西省第一师范学校，1982年定名为陕西省西安师范学校。", source: "CMRC 2018 · 关中书院" },
  { question: "乔纳森的族群为什么要驱逐他？", category: "十万个为什么", answer: "他的特立独行", explain: "掌握高超技艺的乔纳森以为他的族群会欢迎他，但是他的鸥族因为他的特立独行驱逐了乔纳森。", source: "CMRC 2018 · 天地一沙鸥" },
  { question: "谢灵运为什么要替慧远在东林寺中开东西两池，遍种白莲？", category: "十万个为什么", answer: "钦敬慧远", explain: "当时名仕谢灵运，钦敬慧远，替他在东林寺中开东西两池，遍种白莲。", source: "CMRC 2018 · 东林寺" },
  { question: "科朗特在第一次世界大战中曾应征入伍，但不久就因为什么而退伍？", category: "十万个为什么", answer: "因伤", explain: "第一次世界大战中曾应征入伍，但不久就因伤而退伍。", source: "CMRC 2018 · 理查·科朗特" },
  { question: "1949年，张镈为什么一度随基泰公司移居香港？", category: "十万个为什么", answer: "为避兵火", explain: "1949年，张镈为避兵火，一度随基泰公司移居香港。", source: "CMRC 2018 · 张镈" },
  { question: "周成建开办服装加工厂，于1985年因为什么而倒闭？", category: "十万个为什么", answer: "欠债", explain: "受其父经营乡镇企业的影响，从小学会了裁缝手艺的周成建于1984年5月开始在农村老家于朋友开始个体经商，开办服装加工厂，于1985年因欠债而倒闭。", source: "CMRC 2018 · 周成建" },
  { question: "肯尼思·格雷厄姆的母亲因为什么而病逝？", category: "十万个为什么", answer: "猩红热", explain: "肯尼思·格雷厄姆的母亲因猩红热病逝后，外公外婆把他带到乡间抚养长大。", source: "CMRC 2018 · 柳林风声" },
  { question: "单角鼻鱼为什么一捕获，即需去除内脏？", category: "十万个为什么", answer: "不新鲜时，腥味极重", explain: "亦可食用，此鱼不新鲜时，腥味极重，故一捕获，即需去除内脏，尾柄有硬棘，须注意。", source: "CMRC 2018 · 单角鼻鱼" },
  { question: "司马岐因为什么而获升任廷尉？", category: "十万个为什么", answer: "一夜之间就解决了案件", explain: "及后囚犯来到，司马岐去诘问囚犯，他们都不再敢作假证供，将整件事和盘托出，一夜之间就解决了案件，因而获升任廷尉。", source: "CMRC 2018 · 司马岐" },
  { question: "萨曼因何去世？", category: "十万个为什么", answer: "因患肺结核英年早逝", explain: "他生活朴素，因患肺结核英年早逝。", source: "CMRC 2018 · 阿尔贝·萨曼" },
  { question: "宇文邕后来为何会疏远皇后？", category: "十万个为什么", answer: "武帝担心因此会被突厥控制", explain: "但武帝担心因此会被突厥控制，疏远了皇后。", source: "CMRC 2018 · 阿史那皇后" },
  { question: "欧阳玄为什么改名为欧阳元？", category: "十万个为什么", answer: "因避清讳", explain: "欧阳玄（），字元功，号圭斋，因避清讳，其名又作欧阳元，其先家庐陵，为欧阳修之后，后迁居浏阳，故为浏阳人。", source: "CMRC 2018 · 欧阳玄" },
  { question: "葡萄牙水手发现迪西岛后将它命名为什么？", category: "十万个为什么", answer: "La Encarnación", explain: "葡萄牙水手\"Pedro Fernandes de Queirós\"在1606年1月26日发现了迪西岛并且命名为\"La Encarnación\"。", source: "CMRC 2018 · 迪西岛" },
  { question: "花园为什么不接待穿著短裙及短裤的游客？", category: "十万个为什么", answer: "由于供奉有佛教的舍利子", explain: "由于供奉有佛教的舍利子，不接待穿著短裙及短裤的游客。", source: "CMRC 2018 · 卜蜂花园" },
  { question: "赵贞吉的户部右侍郎职位因为什么而被罢免？", category: "十万个为什么", answer: "因得罪严嵩遭到罢职", explain: "嘉靖四十年（1561年）始入为户部右侍郎，又因得罪严嵩遭到罢职，隆庆改元，起用为吏部侍郎兼翰林院学士，掌詹事府事。", source: "CMRC 2018 · 赵贞吉" },
  { question: "白眉丝刺莺被归类为什么科？", category: "十万个为什么", answer: "刺嘴莺科", explain: "现时将牠们分类在刺嘴莺科中。", source: "CMRC 2018 · 白眉丝刺莺" },
  { question: "罗宾晚年因为什么疾病而去世？", category: "十万个为什么", answer: "大肠癌及肝癌", explain: "在与大肠癌及肝癌长期搏斗后，罗宾于2012年5月20日逝世，享年62岁。", source: "CMRC 2018 · 罗宾·吉布" },
  { question: "莫里斯因为什么疾病而去世？", category: "十万个为什么", answer: "肠扭曲", explain: "2003年初，莫里斯因为肠扭曲病发而在佛罗里达州的迈阿密海滩接受手术，但是手术后状况不见好转，发生并发症，莫里斯不幸于2003年1月12日逝世。", source: "CMRC 2018 · 莫里斯·吉布" },
  { question: "孔塔拉斯为什么会逐渐失去在大联盟出场的机会？", category: "十万个为什么", answer: "维克多·马丁内斯来到球队", explain: "随著维克多·马丁内斯来到球队，孔塔拉斯逐渐失去在大联盟出场的机会。", source: "CMRC 2018 · 乔治·孔塔拉斯" },
  { question: "晋悼公即位时，魏绛被提拔为什么？", category: "十万个为什么", answer: "中军司马", explain: "前573年，晋悼公即位时，魏绛因为勇敢被提拔为中军司马。", source: "CMRC 2018 · 魏绛" },
  { question: "《黄国伦的异想世界》开播时播出的时间段为什么时候？", category: "十万个为什么", answer: "时段为周一至周五晚间七点", explain: "《黄国伦的异想世界》是新眼光电视台的音乐谈话性节目，承影传播制作，2008年5月19日开播，时段为周一至周五晚间七点，由知名音乐创作人黄国伦主持。", source: "CMRC 2018 · 黄国伦的异想世界" },
  { question: "阳朔二年（前23年），改封信都王刘兴为什么？", category: "十万个为什么", answer: "中山王", explain: "阳朔二年（前23年），改封信都王刘兴为中山王。", source: "CMRC 2018 · 刘兴 (中山王)" },
  { question: "2008年末武汉光谷为什么被中国足协取消联赛资格？", category: "十万个为什么", answer: "因为退赛", explain: "2008年末，汪洋原来效力的武汉光谷因为退赛被中国足协取消联赛资格，汪洋与队友梅方一起赴比利时试训，获得色格拉布鲁日俱乐部肯定，被邀请加盟。", source: "CMRC 2018 · 汪洋 (足球运动员)" },
  { question: "武汉光谷为什么被足协取消俱乐部参赛资格？", category: "十万个为什么", answer: "发生退赛事件", explain: "2008赛季，武汉光谷发生退赛事件并被足协取消俱乐部参赛资格。", source: "CMRC 2018 · 姚翰林" },
  { question: "为什么要改派一辆亚历山大丹尼士Enviro 500 12米超低地台巴士作指定用车啊？", category: "十万个为什么", answer: "进一步提升本线水平", explain: "直至2012年5月21日，改派一辆亚历山大丹尼士Enviro 500 12米超低地台巴士（ATE32／KZ9147）作指定用车，替代该线唯一一辆丹尼士三叉戟12米超低地台巴士（ATR106／HZ7433），进一步提升本线水平。", source: "CMRC 2018 · 九龙巴士86线" },
  { question: "莱索托2010年世界杯的战绩是怎样的？", category: "十万个为什么", answer: "6战全败", explain: "2010年世界杯外围赛莱索托在第一圈分组赛与加纳、加蓬及 利比亚同组，莱索托在分组赛所有主场赛事改往南非城市布隆方丹进行，最终以6战全败成绩出局。", source: "CMRC 2018 · 莱索托国家足球队" },
  { question: "植村秀有着怎样的美誉？", category: "十万个为什么", answer: "「洁颜油之父」", explain: "他所改良的洁颜油是革命性的创新，有「洁颜油之父」的美誉。", source: "CMRC 2018 · 植村秀" },
  { question: "进步号和联盟号都采取了怎样的结构？", category: "十万个为什么", answer: "三舱式结构", explain: "进步号采用了与联盟号相同的三舱式结构。", source: "CMRC 2018 · 进步号太空船" },
  { question: "实验室中，乙二醛是怎么制得的？", category: "十万个为什么", answer: "用亚硒酸氧化乙醛制取。", explain: "实验室中，乙二醛是通过用亚硒酸氧化乙醛制取。无水乙二醛可由固态水合物与五氧化二磷共热制得。", source: "CMRC 2018 · 乙二醛" },
  { question: "和弓的制式是怎样的？", category: "十万个为什么", answer: "上长下短", explain: "和弓长逾两米，而且弓的上弧部份共占了全弓长度的三分之二，换言之和弓的制式是「上长下短」，其规格及长度亦可称得上是世界最大的弓。", source: "CMRC 2018 · 和弓" },
  { question: "比利决定要把萝西包装成怎样的形象？", category: "十万个为什么", answer: "楚楚可怜的受害者", explain: "梦想成为歌星的萝西也是因为怒杀男友而身负罪名，比利决定要把她包装成楚楚可怜的受害者，令媒体更疯狂的大肆报道。", source: "CMRC 2018 · 芝加哥 (电影)" },
  { question: "美国海军为什么要租用瓦勒普斯岛上部约占全岛的三分之二的地区？", category: "十万个为什么", answer: "在那里进行航空武器测试。", explain: "美国海军从1947年起租用了瓦勒普斯岛上部约占全岛的三分之二的地区，主要目的是在那里进行航空武器测试。NASA的前身国家航空咨询委员会则租用了岛屿下部约4平方公里的地区作为火箭发射场。", source: "CMRC 2018 · 瓦勒普斯岛" },
  { question: "焦比是怎么得来的？", category: "十万个为什么", answer: "焦距数除以孔径数", explain: "简单来说，焦比等于焦距数除以孔径数。", source: "CMRC 2018 · 焦比" },
  { question: "大冠鹫的鸣叫声是怎样的？", category: "十万个为什么", answer: "呼、呼、悠悠阿", explain: "大冠鹫鸣叫声是「呼、呼、悠悠阿」，声音高昂，远处可听闻，尤其是在早上过后，靠著热气流盘旋飞上高空时。", source: "CMRC 2018 · 大冠鹫" },
  { question: "银河在2003年的水质指数如何？", category: "十万个为什么", answer: "极佳", explain: "根据香港政府资料，银河在2003年的水质指数为「极佳」。", source: "CMRC 2018 · 银河 (香港)" },
  { question: "广州番禺职业技术学院实行怎样的体制？", category: "十万个为什么", answer: "广州市和番禺区共建共管", explain: "实行广州市和番禺区共建共管的体制。", source: "CMRC 2018 · 广州番禺职业技术学院" },
  { question: "被扁尾海蛇咬伤后怎么办？", category: "十万个为什么", answer: "需严谨处理，并作即时治疗。", explain: "不过尽管扁尾海蛇的咬击并不普遍，但遭其咬伤后仍需严谨处理，并作即时治疗。扁尾海蛇属卵生蛇类，每当需要进行交配时，牠们会回归陆地。", source: "CMRC 2018 · 扁尾海蛇属" },
  { question: "舜天是怎么当上国王的？", category: "十万个为什么", answer: "舜天出兵平叛，诛灭利勇。", explain: "舜天出兵平叛，诛灭利勇。因天孙王朝末代王无子，22岁的舜天遂于次年被群臣拥立为王。", source: "CMRC 2018 · 舜天" },
  { question: "扬、南徐二州发生灾年时，齐武帝是怎么做的？", category: "十万个为什么", answer: "减免租税以减轻灾民负担", explain: "扬、南徐二州发生灾年时，他减免租税以减轻灾民负担，以为永制。", source: "CMRC 2018 · 永明之治" },
  { question: "前燕是怎么灭亡的？", category: "十万个为什么", answer: "前秦对前燕发动灭国战争", explain: "370年十一月初七，前秦对前燕发动灭国战争，前燕散骑侍郎余蔚率领扶余、高句丽及上党丁零的人质，趁夜打开邺城北门让秦军进入，邺城陷落，前燕灭亡。", source: "CMRC 2018 · 余蔚王" },
  { question: "大雷克雅维克的面积是如何计算的？", category: "十万个为什么", answer: "由其组成自治市的面积", explain: "大雷克雅维克的面积是由其组成自治市的面积算出的，包括大面积的内陆，但不包括约200平方公里（77平方英里）相对较小的城市核心。", source: "CMRC 2018 · 大雷克雅未克区" },
  { question: "1990年代初华堡如何包装？", category: "十万个为什么", answer: "以蜡纸包装", explain: "包装方面，华堡最初放在发泡胶盒内，1980年代初改用纸盒，再于1990年代初全面改以蜡纸包装。", source: "CMRC 2018 · 华堡" },
  { question: "颈阔肌在老年人身上有着怎样的体现？", category: "十万个为什么", answer: "颈部前部两侧可以看到两根沟", explain: "皮肤松弛的老年人的颈部前部两侧可以看到两根沟，就是颈阔肌形成的。", source: "CMRC 2018 · 颈阔肌" },
  { question: "变形金刚：超能连结剧情方面有着怎样的评价？", category: "十万个为什么", answer: "剧情让许多人有些不满", explain: "本作咸认为是「变形金刚2010」的新时代诠释版，一开始的走向也相近，不过剧情让许多人有些不满，有部分原因也是因为人类男主角奇克抢了太多戏份导致观赏者不太满意。", source: "CMRC 2018 · 变形金刚：超能连结" },
  { question: "吊钟花如何进行繁殖？", category: "十万个为什么", answer: "播种、扦插法及压条法", explain: "可以使用播种、扦插法及压条法繁殖。", source: "CMRC 2018 · 吊钟" },
  { question: "路德维希·普朗特是怎么发现气流分离问题的？", category: "十万个为什么", answer: "改进用管道抽吸废屑的装置", explain: "1901年在一机械厂工作中，因改进用管道抽吸废屑的装置发现了气流分离问题；", source: "CMRC 2018 · 路德维希·普朗特" },
  { question: "河茂铁路营运初期是为什么服务的？", category: "十万个为什么", answer: "为开发茂名的石油工业服务", explain: "该线路为单线铁路，按Ⅱ级干线标准建设，从1956年3月开工，同年12月停工，1958年1月复工，同年10月铺轨通车，1959年3月正式交付运营，营运初期是为开发茂名的石油工业服务，性质属工业支线。", source: "CMRC 2018 · 河茂铁路" },
  { question: "雨润集团在中国的地位是怎样的？", category: "十万个为什么", answer: "中国最大的肉制品生产企业之一", explain: "雨润集团（）是中国一家食品工业企业，是中国最大的肉制品生产企业之一。", source: "CMRC 2018 · 雨润集团" },
  { question: "伯尔尼条约的名字如何得来？", category: "十万个为什么", answer: "因在瑞士城市伯尔尼签署而得名", explain: "伯尔尼条约因在瑞士城市伯尔尼签署而得名，是瑞士政府在1874年9月15日召开的国际会议的成果。", source: "CMRC 2018 · 伯尔尼条约" },
  { question: "崇陵规模如何？", category: "十万个为什么", answer: "规模较小，没有大碑楼、石像生", explain: "其规模较小，没有大碑楼、石像生。", source: "CMRC 2018 · 清崇陵" },
  { question: "劲松站这个名字怎么来的？", category: "十万个为什么", answer: "因地处劲松街道辖区得名", explain: "车站因地处劲松街道辖区得名劲松站位于东三环南路（南北向）与劲松路－南磨房路（东西向）相交路口，在劲松桥东侧路口地下。", source: "CMRC 2018 · 劲松站 (北京市)" },
  { question: "太浩湖流域是怎么形成的？", category: "十万个为什么", answer: "地质层断裂", explain: "太浩湖流域是由于地质层断裂而形成的。", source: "CMRC 2018 · 太浩湖" },
  { question: "新加坡鹦嘴鱼作为食用鱼适合怎么吃？", category: "十万个为什么", answer: "清蒸、红烧或盐烧", explain: "食用鱼，食用时可清蒸、红烧或盐烧。", source: "CMRC 2018 · 新加坡鹦嘴鱼" },
  { question: "日本绿鹦嘴鱼作为食用鱼要怎么吃？", category: "十万个为什么", answer: "多用温火烧烤或清蒸", explain: "可食用，食用时多用温火烧烤或清蒸。", source: "CMRC 2018 · 日本绿鹦嘴鱼" },
  { question: "天津犹太会堂的建筑风格是怎样的？", category: "十万个为什么", answer: "具有犹太教风格", explain: "天津犹太会堂由北欧建筑师设计，是一座具有犹太教风格的犹太会堂，原建筑屋顶立有一金属质六芒星，建筑正面顶端亦镶嵌有六芒星，现已拆除但依稀可见六芒星的痕迹；", source: "CMRC 2018 · 天津犹太会堂" },
  { question: "诸葛亮上表廖立是怎么说的？", category: "十万个为什么", answer: "「诽谤先帝，疪毁群臣」", explain: "李邵及蒋琬听后将廖立的话告诉诸葛亮，诸葛亮于是上表廖立「诽谤先帝，疪毁群臣」，废他为庶民，流放汶山郡，与妻子和子女在汶山耕种，自给自足。", source: "CMRC 2018 · 廖立" },
  { question: "廖立听到诸葛亮逝世是怎么想的？", category: "十万个为什么", answer: "「吾终为左衽矣！」", explain: "廖立听到诸葛亮逝世的消息后，曾垂泪叹道：「吾终为左衽矣！」表示不能回归仕途的绝望。", source: "CMRC 2018 · 廖立" },
  { question: "巴勒斯坦的国际地位是怎样的？", category: "十万个为什么", answer: "目前还是处于不明确状态", explain: "巴勒斯坦的国际地位目前还是处于不明确状态，部份国家承认其为独立实体，而许多国家首都同时有巴勒斯坦国大使馆及以色列大使馆。", source: "CMRC 2018 · 巴勒斯坦驻外机构列表" },
  { question: "祭遵的家庭经济状况怎么样？", category: "十万个为什么", answer: "富给", explain: "少好经书，家富给，祭遵却常穿旧衣。", source: "CMRC 2018 · 祭遵" },
  { question: "祭遵做军市令的时候执法怎么样？", category: "十万个为什么", answer: "执法严明，不徇私情", explain: "执法严明，不徇私情，刘秀有个小侍从（舍中儿）犯法，祭遵依照法将其处死。", source: "CMRC 2018 · 祭遵" },
  { question: "1973年革命后，泰国的社会形式怎么样？", category: "十万个为什么", answer: "经历一段短暂而不稳定的民主期", explain: "1973年革命后，泰国经历一段短暂而不稳定的民主期，1976年的血腥军事政变后，泰国又重回军事独裁的统治。", source: "CMRC 2018 · 泰国皇家军队" },
  { question: "在现代，人们是如何看待神医的？", category: "十万个为什么", answer: "往往被视为神秘和迷信", explain: "今日医学昌明的时代，巫医往往被视为神秘和迷信。", source: "CMRC 2018 · 巫医" },
  { question: "林越峰是怎样成为作家的？", category: "十万个为什么", answer: "以自学方式变成作家", explain: "仅国民小学毕业的林越峰以自学方式变成作家，其文章如《到城市去》、《好年光》、《红萝卜》等文章陆续于1934年－1935年刊登在《台湾文艺》等知名文学杂志。", source: "CMRC 2018 · 林越峰" },
  { question: "钝头鹦嘴鱼作为食用鱼，适合怎么吃？", category: "十万个为什么", answer: "红烧或盐烧", explain: "食用鱼，可作鱼松，利用红烧或盐烧味道不错。", source: "CMRC 2018 · 钝头鹦嘴鱼" },
  { question: "生濑胜久的演技怎么样？", category: "十万个为什么", answer: "充满个性", explain: "1960年10月13日出生于兵库县，拥有充满个性的演技，为「个性派演员」之一。", source: "CMRC 2018 · 生濑胜久" },
  { question: "波斯黇鹿是如何从黎巴嫩及迦密山到达塞浦路斯的？", category: "十万个为什么", answer: "将头放在前面的背上游渡地中海", explain: "于200年就有希腊的记载指牠们将头放在前面的背上游渡地中海，由黎巴嫩及迦密山到达塞浦路斯。", source: "CMRC 2018 · 波斯黇鹿" },
  { question: "道同死后，百姓是怎么做的？", category: "十万个为什么", answer: "在家里供奉他的牌位", explain: "道同枉死，民众皆惋惜，在家里供奉他的牌位，向牌位问卜，都非常灵验，所以县民都传说道同升天成神了。", source: "CMRC 2018 · 道同" },
  { question: "工业上是怎样合成乙酸酐的？", category: "十万个为什么", answer: "乙烯酮与乙酸反应生成乙酸酐", explain: "乙烯酮与乙酸反应生成乙酸酐，工业上合成乙酸酐即是利用此法。", source: "CMRC 2018 · 烯酮" },
  { question: "王薄为什么会起兵反？", category: "十万个为什么", answer: "兵役繁重", explain: "隋炀帝大业七年（611年）十月，王薄因兵役繁重，与同郡孟让首先起兵反隋，占长白山（今山东章丘境内，非东北的长白山）为根据，自称「知世郎」，作《莫向辽东浪死歌》，号召群众反对出征高句丽。", source: "CMRC 2018 · 王薄" },
  { question: "清代考据学者遍寻众书普遍认为什么是正书第一？", category: "十万个为什么", answer: "九成宫醴泉铭", explain: "《麻姑仙坛记》（全称《有唐抚州南城县麻姑山仙坛记》），俗谓《麻姑帖》，是唐朝书法家颜真卿，年六十三时所书，号称真卿楷书代表之作，有人称此帖是天下第一楷书，但清代考据学者遍寻众书，不见此看法，普遍认为九成宫醴泉铭乃正书第一。", source: "CMRC 2018 · 麻姑仙坛记" },
  { question: "郭进早年贫贱时品质如何？", category: "十万个为什么", answer: "倜傥任气，嗜酒好赌。", explain: "早年贫贱，在巨鹿富家当佣保，倜傥任气，嗜酒好赌。投奔河东节度使刘知远，善用兵，从严治军，“然性喜杀，士卒小违令，必罪于死，居家御婢仆亦然。", source: "CMRC 2018 · 郭进" },
  { question: "二战后，埃尔热重新拾这部作品做出了怎样的改变？", category: "十万个为什么", answer: "将其的故事主线更改", explain: "二战后，埃尔热重新拾起了这部作品，并将其的故事主线更改。", source: "CMRC 2018 · 黑金之国" },
  { question: "影片通篇使用了怎样的手法拍摄？", category: "十万个为什么", answer: "用静止的镜头和自然光拍摄", explain: "影片通篇使用静止的镜头和自然光拍摄，体现了独特的效果。", source: "CMRC 2018 · 安阳婴儿" },
  { question: "押送官吏是如何对待杨守亮的？", category: "十万个为什么", answer: "用布帛绑缚他，用球堵住他的嘴", explain: "杨守亮请求活着被解送长安，希望能通过陈述先人功绩得免死，韩建答应，以槛车解送杨守亮，押送官吏用布帛绑缚他，用球堵住他的嘴。", source: "CMRC 2018 · 杨守亮" },
  { question: "主角从小都有怎样的一个想法？", category: "十万个为什么", answer: "「因为这样会比较有趣」", explain: "「因为这样会比较有趣」——主角皆川巧从小就以这个想法行动，把周围的人卷入闹剧中，因而被称之为「台风」。", source: "CMRC 2018 · 坂上台风" },
  { question: "决赛的加时赛是如何决定胜负的？", category: "十万个为什么", answer: "以互射十二码决定胜负", explain: "只有联赛第三至第六名可以参加升班附加赛，初赛以主客两回合进行，两回合赛和不会有作客入球优惠，在次回合后直接进行加时，加时再和则以互射十二码决定胜负，胜方者将会进入决赛。", source: "CMRC 2018 · 2008年至2009年英格兰足球甲级联赛" },
  { question: "2014年球季，富山胜利的战绩怎么样？", category: "十万个为什么", answer: "5胜8和29败", explain: "2014年球季，富山胜利的战绩为5胜8和29败，在22支球队当中敬陪末座，因此2015年赛季开始被降级到J3。", source: "CMRC 2018 · 富山胜利" },
  { question: "对于能登上2007年9月封面，刘芸怎么看？", category: "十万个为什么", answer: "刘芸觉得自己很幸运", explain: "对于能登上2007年9月封面，刘芸觉得自己很幸运。", source: "CMRC 2018 · 刘芸" },
  { question: "长圆银鲈适合如何食用？", category: "十万个为什么", answer: "油炸", explain: "为中小型食用鱼，多刺，适合以油炸的方式食用。", source: "CMRC 2018 · 长圆银鲈" },
  { question: "《江湖.com》的场景是怎样的？", category: "十万个为什么", answer: "以古代中国为主", explain: "《江湖.com》是赵正平制作、王伟忠导演的搞笑古装单元剧，场景以古代中国为主，叙述五个聚在「江湖客栈」（原名「王六包子店」）的人所发生一连串的故事。", source: "CMRC 2018 · 江湖.com" },
  { question: "在海南省中华辣椒一般如何食用？", category: "十万个为什么", answer: "在海南省主要做成黄灯笼辣椒酱", explain: "在海南省主要做成黄灯笼辣椒酱。", source: "CMRC 2018 · 黄灯笼辣椒" },
  { question: "新加坡仙姑殿成立的哪一天又是怎样的日子？", category: "十万个为什么", answer: "是仙姑下凡普渡众生的日子", explain: "新加坡仙姑殿成立于农历壬申年十月二十三日（1992年11月17日），也正是仙姑下凡普渡众生的日子。", source: "CMRC 2018 · 新加坡仙姑殿" },
  { question: "蒙纳黑体是一款怎样的字体？", category: "十万个为什么", answer: "一款中文无衬线字体", explain: "蒙纳黑体是蒙纳公司（Monotype Corporation）的一款中文无衬线字体。", source: "CMRC 2018 · 蒙纳黑体" },
  { question: "古代的船是怎样被推动的？", category: "十万个为什么", answer: "靠人力", explain: "古代的船只往往靠人力来推动，有些把船桨用双耳圆环固定在船舷的两侧，有些则安装在船尾，其中一部分船桨甚至设计为两者皆可通用。", source: "CMRC 2018 · 舵" },
  { question: "米诺地尔是一种怎样的药？", category: "十万个为什么", answer: "钾通道开放药", explain: "米诺地尔（）是一种钾通道开放药，这类药物在降压时常伴有反射性心动过速和心输出量的增加。", source: "CMRC 2018 · 米诺地尔" },
  { question: "米诺地尔对于血管扩张具有怎样的特性？", category: "十万个为什么", answer: "对于血管扩张的作用具有选择性", explain: "对于血管扩张的作用具有选择性，见于冠状动脉，胃肠道血管和脑血管，而不扩张肾和皮肤血管。", source: "CMRC 2018 · 米诺地尔" },
  { question: "本届赛事是第二届以怎样的形式进行的？", category: "十万个为什么", answer: "小组赛形式", explain: "本届赛事是第二届以小组赛形式进行，小组赛球队合共八队，分成两组，两组的首名会晋级决赛，以一场过的中立场决胜以分胜负。", source: "CMRC 2018 · 1992–93年欧洲冠军联赛" },
  { question: "《Close to ～祈愿之丘～》是一款怎样的游戏？", category: "十万个为什么", answer: "恋爱冒险游戏", explain: "《Close to ～祈愿之丘～》（）是日本KID在Dreamcast平台发售的恋爱冒险游戏。", source: "CMRC 2018 · Close to ～祈愿之丘～" },
  { question: "罗彻斯特理工学院在美国全国大学中的排名如何？", category: "十万个为什么", answer: "第107位", explain: "它在2016年《美国新闻与世界报道》的美国全国大学排名中列于第107位。", source: "CMRC 2018 · 罗彻斯特理工学院" },
  { question: "乌马托鳞片属是一类怎样的植物？", category: "十万个为什么", answer: "已灭绝的银杏类植物", explain: "乌马托鳞片属（\"Umaltolepis\"）是一类已灭绝的银杏类植物，属于乌马托鳞片科（Umaltolepidiaceae）。", source: "CMRC 2018 · 乌马托鳞片属" },
  { question: "巴鲁剌思氏为什么会采用察合台语，用阿拉伯文与波斯文？", category: "十万个为什么", answer: "突厥化与伊斯兰化", explain: "他们后来突厥化与伊斯兰化，采用察合台语，用阿拉伯文与波斯文,他们在察合台汗国中期发迹，帖木儿的父亲塔剌海控制了渴石，帖木儿后来成为秃忽鲁帖木儿的辅臣，在他死后，赶走也里牙思火者，袭杀忽辛，自称苏丹，建立帖木儿帝国。", source: "CMRC 2018 · 巴鲁剌思氏" },
  { question: "郭威病危，为什么特命李重进向柴荣行君臣之礼？", category: "十万个为什么", answer: "以免其觊觎皇位。", explain: "两年后，郭威病危，传位于发妻柴氏的侄子、养子柴荣，临终前特命李重进向柴荣行君臣之礼，以免其觊觎皇位。显德元年（954年），世宗柴荣即位，以姑表兄李重进为侍卫亲军马步军都虞侯，妹夫张永德接任殿前都指挥使，分掌侍卫亲军和殿前亲军。", source: "CMRC 2018 · 李重进" },
  { question: "汉武帝时期，婕妤的地位如何？", category: "十万个为什么", answer: "仅次于皇后，为妃嫔之首。", explain: "汉武帝时，设立婕妤、娙娥、傛华、充仪等位号，婕妤仅次于皇后，为妃嫔之首。汉昭帝时，上官氏入宫为婕妤，后被立为皇后。", source: "CMRC 2018 · 婕妤" },
  { question: "徐大椿的性格如何？", category: "十万个为什么", answer: "性通敏，喜豪辩。", explain: "性通敏，喜豪辩。自《周易》、《道德》、《阴符》家言，以及天文、地理、音律、技击等无不通晓，尤精于医。", source: "CMRC 2018 · 徐大椿" },
  { question: "Nate和Serena之间的感情怎样样？", category: "十万个为什么", answer: "很复杂", explain: "Nate和Serena之间的感情很复杂。", source: "CMRC 2018 · 欧尼特" },
  { question: "地热谷的水质如何？", category: "十万个为什么", answer: "清澈且呈微绿似玉的色泽", explain: "地热谷的泉水属酸性硫磺泉，水温高达摄氏90度，水质清澈且呈微绿似玉的色泽，俗称青磺泉。", source: "CMRC 2018 · 地热谷" },
  { question: "杨清的下场如何？", category: "十万个为什么", answer: "与其子杨志贞被捕处决。", explain: "杨清与其子杨志贞被捕处决。杜士交拥立其子杨志烈为主，退往长州的凿溪（在今越南宁平省）继续抗唐。", source: "CMRC 2018 · 杨清" },
  { question: "斑鱵具有怎样的食用价值？", category: "十万个为什么", answer: "高级食用鱼，适合油煎食用。", explain: "属高级食用鱼，适合油煎食用。2.FishBase3.台湾鱼类资料库", source: "CMRC 2018 · 斑鱵" },
  { question: "一般黄尾魣作为食用鱼怎么吃？", category: "十万个为什么", answer: "适合各种烹调方式。", explain: "为食用鱼，适合各种烹调方式。", source: "CMRC 2018 · 黄尾魣" },
  { question: "元详是怎么死的？", category: "十万个为什么", answer: "被元恪遣人秘密处决", explain: "正始元年六月十三日（504年7月10日），元详被囚禁不久就被元恪遣人秘密处决。", source: "CMRC 2018 · 元详" },
  { question: "司马模投降赵染之后有着怎样的下场？", category: "十万个为什么", answer: "送到刘粲处，刘粲杀了他", explain: "赵染坐在那里数落司马模的罪行，送到刘粲处，刘粲杀了他，以司马模的妃子刘氏赐给胡张本为妻，子司马保继立为南阳王。", source: "CMRC 2018 · 司马模" },
  { question: "狐狸表面上原谅了鹤实际上预备怎么样？", category: "十万个为什么", answer: "心怀诡计，要戏弄鹤", explain: "狐狸虽然表面上原谅了鹤，还表示要请他吃饭以示和好，但其实狐狸是心怀诡计，要戏弄鹤，鹤却不知就里答应了。", source: "CMRC 2018 · 狐狸和鹤" },
  { question: "苏黎世圣彼得教堂在1460年重建为什么形式的教堂？", category: "十万个为什么", answer: "哥特式教堂", explain: "教堂毗邻Lindenhof 山，昔日罗马城堡的地点，兴建在朱庇特神庙的遗址上. 8或者9世纪的早期教堂为10 乘 7 米大小，大约1000年前后改建为罗曼式教堂，1230年改为后期罗曼式，1460年重建为哥特式教堂。", source: "CMRC 2018 · 苏黎世圣彼得教堂" },
  { question: "这种鱼具有怎样的食用价值？", category: "十万个为什么", answer: "肉质佳，适合油炸和清蒸食用。", explain: "食用鱼，肉质佳，适合油炸和清蒸食用。为台湾地区重要的底栖鱼获物。", source: "CMRC 2018 · 斑鳍白姑鱼" },
  { question: "玩家如何选择自己的角色？", category: "十万个为什么", answer: "随机决定", explain: "玩家的角色为随机决定，各有各的优势跟劣势。", source: "CMRC 2018 · XEvil" },
  { question: "成名后的曾心梅如何拓展自己的事业？", category: "十万个为什么", answer: "朝主持界发展", explain: "之后也朝主持界发展，曾与名人、主持界大哥共同主持过电视节目，并获得电视金钟奖，也担任过电台节目主持人、活动主持人，但终究还是热爱著歌唱的事业。", source: "CMRC 2018 · 曾心梅" },
  { question: "赵元份的性情如何？", category: "十万个为什么", answer: "为人宽厚", explain: "赵元份为人宽厚，娶崇仪使李汉斌之女。", source: "CMRC 2018 · 赵元份" },
  { question: "时富金融是如何上市的？", category: "十万个为什么", answer: "由创业板转到主板上市。", explain: "至2008年3月，时富金融由创业板转到主板上市。2014年9月，时富金融服务宣布计划向天津滨海新区建设投资集团出售51%股权。", source: "CMRC 2018 · 时富金融服务" },
  { question: "曾有翼是怎样称为秀才的？", category: "十万个为什么", answer: "经过自学", explain: "后来他经过自学，于清朝末年中秀才，后成为光绪三十二年（1906年）丙午科优贡。", source: "CMRC 2018 · 曾有翼" },
  { question: "陈氏天竺鲷有着怎样的食用价值？", category: "十万个为什么", answer: "可食用，但多做为下杂鱼处理。", explain: "可食用，但多做为下杂鱼处理。", source: "CMRC 2018 · 陈氏天竺鲷" },
  { question: "高归彦是如何被杀死的？", category: "十万个为什么", answer: "以谋逆将高归彦处死", explain: "”562年，武成帝高湛以谋逆将高归彦处死，将其家属共百余人赏赐给高岳家当奴仆，又追赠高岳为太师。", source: "CMRC 2018 · 高岳" },
  { question: "光谱线的差距是怎么产生的？", category: "十万个为什么", answer: "因为能级的差别而产生的", explain: "应用量子力学理论，物理学家认为光谱线的差距是因为能级的差别而产生的；", source: "CMRC 2018 · 波数" },
  { question: "鲍威尔在1988年汉城奥运会上成绩如何？", category: "十万个为什么", answer: "获得银牌", explain: "鲍威尔在1988年汉城奥运会和1992年巴塞罗那奥运会上均获得银牌，在1993年世界田径锦标赛和1995年世界田径锦标赛中分别获得金牌和铜牌。", source: "CMRC 2018 · 迈克·鲍威尔" },
  { question: "当这个发散级数被运用到物理学中在是怎么解释的？", category: "十万个为什么", answer: "它是黎曼ζ函数在零点的取值。", explain: "当出现于物理运用时，它也解释为，它是黎曼ζ函数在零点的取值。上述二个公式在formula_6时不成立，必需利用解析连续定义。", source: "CMRC 2018 · 1 + 1 + 1 + 1 + …" },
  { question: "这个地方的资源如何？", category: "十万个为什么", answer: "拥有丰富的生物多样性资源。", explain: "瓦登海拥有丰富的生物多样性资源。2009年，瓦登海的荷兰和德国部分被联合国教科文组织列入世界遗产，2014年扩展至丹麦的部分。", source: "CMRC 2018 · 瓦登海" },
  { question: "气腔龙具有怎样的呼吸系统？", category: "十万个为什么", answer: "类似鸟类的呼吸系统。", explain: "气腔龙的化石具有类似鸟类的呼吸系统。气腔龙目前只有唯一种，里约科罗拉多气腔龙（\"A. riocoloradensis\"） 。", source: "CMRC 2018 · 气腔龙属" },
  { question: "石中玉明白长乐帮的真实用意后，怎么做的？", category: "十万个为什么", answer: "不告而别", explain: "石中玉不久也明白长乐帮的用意，于是不告而别(据长乐帮众所言，前帮主不愿独自赴会打算隐居，而石破天将其打倒夺得帮主，作威作福)，躲在市井妓院间醉生梦死，逍遥快活。", source: "CMRC 2018 · 石中玉" },
  { question: "韦特恩湖泊的形状如何？", category: "十万个为什么", answer: "细长", explain: "韦特恩湖的形状细长，湖的总面积为约1912平方公里（738平方哩），河盆面积约为4503平方公里（1,739平方哩）。", source: "CMRC 2018 · 韦特恩湖" },
  { question: "《五牛图》达到了怎样的艺术境界？", category: "十万个为什么", answer: "神形兼备", explain: "《五牛图》达到了神形兼备的高超艺术境界，元代的大书画家赵孟𫖯盛赞：「五牛图，神气磊落，稀世名笔也。", source: "CMRC 2018 · 五牛图" },
  { question: "这张专辑发行首周的销售量如何？", category: "十万个为什么", answer: "54万张", explain: "发行后首周以54万张销售量夺下日本公信榜专辑榜冠军，也是滨崎步的第14张冠军专辑。", source: "CMRC 2018 · A COMPLETE ～ALL SINGLES～" },
  { question: "目前经济学者对于强制接取是怎么认为的？", category: "十万个为什么", answer: "呈现各说各话的局面。", explain: "是否强制接取对于竞争环境有利，并且会降低价格目前还不能确定，因此在各方经济学者中呈现各说各话的局面。", source: "CMRC 2018 · 强制接取管制" },
  { question: "范玮琪是如何评价曾博君的？", category: "十万个为什么", answer: "具有极佳音乐天分", explain: "他也曾被《模范棒棒堂》堂主兼资深歌手范玮琪指具有极佳音乐天分（他甚至在节目中表演过将结他背在肩上弹奏），很看好他。", source: "CMRC 2018 · 曾博君" },
  { question: "在早期的古典时代，回合制拳击比赛是怎样一种存在？", category: "十万个为什么", answer: "古希腊运动员文化的一部分。", explain: "但有一点仍然很清楚，在早期的古典时代，回合制的拳击比赛仍是古希腊运动员文化的一部分。考古文物及艺术品显示古希腊拳击早在米诺斯及迈锡尼时期即已存在。", source: "CMRC 2018 · 古希腊拳击" },
  { question: "稀有卡这个名字是怎么来的？", category: "十万个为什么", answer: "伊斯兰传说的食尸鬼。", explain: "获得非法的大量利益，名字由来是伊斯兰传说的食尸鬼。北美版因宗教缘故，仅统称为稀有卡猎人。", source: "CMRC 2018 · 游戏王系列角色列表" },
  { question: "共和党人在北部城市波尔图发动了一场大规模的起义，结果如何？", category: "十万个为什么", answer: "最终失败", explain: "1891年1月，共和党人在北部城市波尔图发动了一场大规模的起义，但是最终失败。", source: "CMRC 2018 · 1910年10月5日革命" },
  { question: "奥威尔斯合成对反应物和产物的结构要求怎么样？", category: "十万个为什么", answer: "要求都比较高", explain: "由于这个反应对反应物和产物的结构要求都比较高，并且反应物二溴化物比较难制备，产率也不是很高(70%)，因此它在有机合成中的应用并不十分广泛。", source: "CMRC 2018 · 奥威尔斯合成" },
  { question: "1941年下半年，为何学校分散迁至农村坚持教学？", category: "十万个为什么", answer: "日寇逼近龙冈，为适应形势", explain: "1941年下半年，日寇逼近龙冈，为适应形势，学校分散迁至农村坚持教学，校名为“龙冈镇小学裔家舍分校”及三里桥分校、祁家舍分校、大李庄分校等四所，校舍借用庙宇、祠堂或民房，课桌均是学生自备的板条搭搁。", source: "CMRC 2018 · 龙冈小学" },
  { question: "爪哇集团将这元素注入汇豪山，希望以此制造出怎样的形象？", category: "十万个为什么", answer: "高级住宅", explain: "汇豪山的名字源自美国纽约著名的传统豪宅区「」，爪哇集团将这元素注入汇豪山，希望以此制造出高级住宅的形象。", source: "CMRC 2018 · 汇豪山" },
  { question: "红梅花雀的保护状况如何？", category: "十万个为什么", answer: "无危", explain: "该物种的保护状况被评为无危。", source: "CMRC 2018 · 红梅花雀" },
  { question: "唐绍华有着怎样的地位？", category: "十万个为什么", answer: "台湾影剧事业的开拓者之一", explain: "台湾影剧事业的开拓者之一。", source: "CMRC 2018 · 唐绍华" },
  { question: "美眉校探获得怎样的收视反响？", category: "十万个为什么", answer: "每集250万人", explain: "广受好评的第一季（22集）在美国获得了每集250万人的收视反响。", source: "CMRC 2018 · 美眉校探" },
  { question: "身体缺少白蛋白会怎么样？", category: "十万个为什么", answer: "身体缺少白蛋白会导致浮肿。", explain: "身体缺少白蛋白会导致浮肿。肝硬化病人的血浆白蛋白含量比正常人低。", source: "CMRC 2018 · 白蛋白" },
  { question: "王镕是怎么死的？", category: "十万个为什么", answer: "被义子王德明兵变所杀", explain: "藩政凋敝，被义子王德明兵变所杀。", source: "CMRC 2018 · 王镕" },
  { question: "《研究之美》是一本怎样的小说？", category: "十万个为什么", answer: "中短篇数学小说", explain: "《研究之美》是一部中短篇数学小说，而值得一提的是，这种把新的数学概念在一部小说中提出来的情形是非常少有的。", source: "CMRC 2018 · 超现实数" },
  { question: "亚砜可以怎样得到？", category: "十万个为什么", answer: "可由硫醚氧化得到", explain: "亚砜是含有亚硫酰基（>S=O）官能团的一类有机化合物，可由硫醚氧化得到。", source: "CMRC 2018 · 亚砜" },
  { question: "水腺毛草生长的状态是怎样的？", category: "十万个为什么", answer: "生长是以半水生的状态", explain: "生长是以半水生的状态，并会运用长在茎上的黏液腺体。", source: "CMRC 2018 · 水腺毛草" },
  { question: "长腰鲔在沿海怎么样的水质栖息？", category: "十万个为什么", answer: "混浊", explain: "栖息深度50-2473公尺，栖息在沿海水质混浊的海域，成群活动，属肉食性，以鱼类、头足类、甲壳类为食。", source: "CMRC 2018 · 青甘金枪鱼" },
  { question: "按照正确的礼节，最重要的宾客的座位通常被如何安排?", category: "十万个为什么", answer: "背对凹间而坐", explain: "凹间前方的座位被视为「上座」，因此正确的礼节是必须安排最重要的宾客背对凹间而坐。", source: "CMRC 2018 · 凹间" },
  { question: "农劲荪与霍元甲是如何击败俄国大力士奥皮音的？", category: "十万个为什么", answer: "对方听到是霍元甲就先认输了", explain: "二人的事迹之中，其中之一是击败俄国大力士奥皮音（事实上对方听到是霍元甲就先认输了），而最重要的成就，便是创立中国精武体操会（上海精武体育总会前身）。", source: "CMRC 2018 · 农劲荪" },
  { question: "施云奴是如何成为首位巴西籍阿仙奴球员的？", category: "十万个为什么", answer: "他被英超豪门阿仙奴看中", explain: "他在哥连泰斯展开职业生涯，从1994年开始效力，直至1999年，他被英超豪门阿仙奴看中，成为首位巴西籍的阿仙奴球员。", source: "CMRC 2018 · 施云奴" },
  { question: "巴黎和洛杉矶举办夏季奥林匹克运动会的最终顺序是如何确定的？", category: "十万个为什么", answer: "经过洛杉矶与巴黎协商决定", explain: "2017年7月31日，经过洛杉矶与巴黎协商决定：由巴黎举办2024年夏季奥林匹克运动会，洛杉矶举办2028年夏季奥林匹克运动会。", source: "CMRC 2018 · 2024年夏季奥林匹克运动会" },
  { question: "2010年11月6日董雷为什么会代表申花出战比赛", category: "十万个为什么", answer: "王大雷上调国奥队，邱盛炯受伤", explain: "2010年11月6日，上海申花在联赛最后一轮客场出战已经提前夺冠的山东鲁能，由于王大雷上调国奥队，邱盛炯受伤，董雷第一次也是最后一次代表申花出战正式比赛，不过球队以2-5告负。", source: "CMRC 2018 · 董雷 (足球运动员)" },
  { question: "1347年，忠穆王向元朝朝廷请求先王的谥号，结果如何？", category: "十万个为什么", answer: "被元廷拒绝了", explain: "1347年，忠穆王向元朝朝廷请求先王的谥号，但被元廷拒绝了。", source: "CMRC 2018 · 高丽忠穆王" },
  { question: "李抱玉镇守凤翔十余年表现如何?", category: "十万个为什么", answer: "虽无破虏之功，但境内比较安定", explain: "他镇守凤翔十余年，虽无破虏之功，但境内比较安定，颇为当时所称赞。", source: "CMRC 2018 · 李抱玉" },
  { question: "网络推手立二如何看待手机女孩事件？", category: "十万个为什么", answer: "一次完美的策划推广", explain: "网络推手立二认为：这是一次完美的策划推广。", source: "CMRC 2018 · IPhone女孩" },
  { question: "周皮形成后，表皮如何变化？", category: "十万个为什么", answer: "脱落", explain: "周皮是韧皮部和外表皮之间的部分，包括木栓、木栓形成层和栓内层的总称，周皮形成后，表皮即脱落。", source: "CMRC 2018 · 树皮" },
  { question: "刺鼠名字里面的Coxingi是怎么来的？", category: "十万个为什么", answer: "由其台湾俗名\"国姓鼠\"而来", explain: "刺鼠种名部分的Coxingi，即是由其台湾俗名\"国姓鼠\"而来。", source: "CMRC 2018 · 刺鼠" },
  { question: "日本于1989年才转变年号为什么？", category: "十万个为什么", answer: "平成", explain: "虽然电影于1984年上映(当时年号仍是「昭和」)，但因在故事及造型上与其后1989至1995年的作品有更大关联性，纵使日本于1989年才转变年号为「平成」，但此电影在往后日子亦被纳入为「平成系列」作品之一。", source: "CMRC 2018 · 哥吉拉 (1984年)" },
  { question: "长齿锯犁鳗的锄骨齿成一交相嵌合之二列齿在成熟期会变化为什么形状？", category: "十万个为什么", answer: "刀片状", explain: "锄骨齿成一交相嵌合之二列齿，成熟期后变化成刀片状；", source: "CMRC 2018 · 长齿锯犁鳗" },
  { question: "在1980年代为何订购了更多的波音727与波音737和欧洲的空中客车A310？", category: "十万个为什么", answer: "由于美伊关系更加亲近", explain: "在1980年代由于美伊关系更加亲近，所以订购了更多的波音727与波音737和欧洲的空中客车A310。", source: "CMRC 2018 · 伊拉克航空" },
  { question: "在克罗地亚的首次民主选举后，萨格勒布航空于1990年7月23日更名为什么？", category: "十万个为什么", answer: "克罗地亚航空", explain: "克罗地亚航空（Croatia Airlines d.d.），是克罗地亚的国家航空公司，总部设在萨格勒布。", source: "CMRC 2018 · 克罗地亚航空" },
  { question: "舰队从1915年2月19日起开始炮轰达达尼尔海峡，为什么要慌忙撤退？", category: "十万个为什么", answer: "4艘军舰触发水雷", explain: "3月18日，16艘军舰企图强行闯入狭窄的海峡通道， 4艘军舰触发水雷，舰只慌忙撤退。", source: "CMRC 2018 · 加里波利海战" },
  { question: "2009年9月15日切斯特外借到英冠球会普利茅夫3个月，为什么提前被送返曼联？", category: "十万个为什么", answer: "因伤", explain: "2009年9月15日切斯特再获外借到英冠球会普利茅夫3个月，但仅作赛3场便因伤提前被送返曼联。", source: "CMRC 2018 · 詹姆斯·切斯特" },
  { question: "泛海控股以6.63亿元收购时富金融服务共44.01%股权为什么没有成功？", category: "十万个为什么", answer: "因为小股东反对而告吹。", explain: "2015年1月，泛海控股以6.63亿元收购时富金融服务共44.01%股权， 同样因为小股东反对而告吹。", source: "CMRC 2018 · 时富金融服务" },
  { question: "麝香被中华人民共和国国家药品监督管理局列为国家管制药材，严禁私自买卖，是因为什么？", category: "十万个为什么", answer: "避免民间私自盗猎", explain: "为避免民间私自盗猎，麝香与犀角、牛黄、羚角等动物源药材一同被中华人民共和国国家药品监督管理局列为国家管制药材，严禁私自买卖，并实行价格管制。", source: "CMRC 2018 · 麝香" },
  { question: "Worm's Head（虫头）的小岛和Gower半岛之间为什么潮退时可以步行前往？", category: "十万个为什么", answer: "有天然海堤连接", explain: "罗西里湾的南端有一个叫Worm's Head（虫头）的小岛，和Gower半岛之间有天然海堤连接，潮退时可以步行前往。", source: "CMRC 2018 · 罗西里" },
  { question: "崇祯十七年（1644年），甲申之变，流寇攻入京师，李自成封朱慈炯为什么？", category: "十万个为什么", answer: "定安公", explain: "崇祯十七年（1644年），甲申之变，流寇攻入京师，李自成封朱慈炯为定安公，李自成败退时不知所终，南明年间追封为定哀王。", source: "CMRC 2018 · 朱慈炯" },
  { question: "1961年7月，黄西田在阿莲国校第16届毕业，为何没再继续升学？", category: "十万个为什么", answer: "家境不好", explain: "1961年7月，阿莲国校第16届毕业，因家境不好，从此没再继续升学。", source: "CMRC 2018 · 黄西田" },
  { question: "祥兴二年（1279年）以后，郑思肖为何坐卧必向南，并自号“所南”", category: "十万个为什么", answer: "为了寄托爱国情怀", explain: "为了寄托爱国情怀，郑思肖坐卧必向南，并自号“所南”；", source: "CMRC 2018 · 郑思肖" },
  { question: "2007年11月19日，德西尔维斯特被英国足球杂志《世界足球》评为什么？", category: "十万个为什么", answer: "五十位最出色的新秀之一", explain: "2007年11月19日，英国足球杂志《世界足球》把德西尔维斯特里选为五十位最出色的新秀之一。", source: "CMRC 2018 · 洛伦佐·德西尔维斯特里" },
  { question: "邓飏在中书省时因什么原因被魏明帝免职？", category: "十万个为什么", answer: "与李胜等人作风浮华", explain: "在中书省因与李胜等人作风浮华而被魏明帝免职，不再任用。", source: "CMRC 2018 · 邓飏" },
  { question: "建桥杯是什么项目的比赛？", category: "十万个为什么", answer: "围棋", explain: "建桥杯，由建桥集团主办的中国围棋赛，原为女子公开赛，后建桥集团冠名新人王战。", source: "CMRC 2018 · 建桥杯" },
  { question: "杰米·海纳曼和他的搭档相比以什么特点著称?", category: "十万个为什么", answer: "冷静、逻辑、严肃的行为举止", explain: "与搭档亚当活泼甚至有些幼稚的行为比起来，他以他的冷静、逻辑、严肃的行为举止而著称。", source: "CMRC 2018 · 杰米·海纳曼" },
  { question: "现代化过程中因什么被削弱破坏瓦解导致失范现象产生？", category: "十万个为什么", answer: "传统价值和传统社会规范", explain: "失范（，或译无规范、迷乱）是社会学术语，指现代化过程中，因传统价值和传统社会规范遭到削弱、破坏、乃至瓦解，所导致的社会成员心理上失去价值指引、价值观瓦解的无序状态。", source: "CMRC 2018 · 失范" },
  { question: "哪国哲学家最早在学术意义上定义并使用了“失范”这一概念？", category: "十万个为什么", answer: "法国", explain: "法国哲学家让-马利·居约最早在学术意义上定义并使用了“失范”这一概念。", source: "CMRC 2018 · 失范" },
  { question: "《无字碑歌》以谁的一生为改编依据？", category: "十万个为什么", answer: "武则天", explain: "《无字碑歌》是一部以武则天一生改编的古装历史剧，于2004年拍摄，2006年首播。", source: "CMRC 2018 · 无字碑歌" },
  { question: "《无字碑歌》的台词有什么特点？", category: "十万个为什么", answer: "文学性很强，古风韵味十足", explain: "本剧的另一大特色是台词，文学性很强，古风韵味十足，饰演青年武则天的演员温峥嵘称“台词写得就像天书，一手抱着剧本，一手还要翻字典。", source: "CMRC 2018 · 无字碑歌" },
  { question: "王金璐是什么项目的继承人？", category: "十万个为什么", answer: "国家级非物质文化遗产京剧项目", explain: "王金璐（），京剧演员，工生行，马连良弟子，中国国家1级演员，国家级非物质文化遗产京剧项目代表性传承人。", source: "CMRC 2018 · 王金璐" },
  { question: "极大笔的借贷关系主要采取什么方式？", category: "十万个为什么", answer: "人工计算", explain: "不过，人工计算的方式容易存在弊端及道德风险。", source: "CMRC 2018 · 信用额度" },
  { question: "圣训学的目的是什么？", category: "十万个为什么", answer: "研究传述世系与圣训正文的真伪", explain: "圣训学就是要研究传述世系与圣训正文的真伪，借以甄别出可靠的「正训」（sahih）。", source: "CMRC 2018 · 圣训学" },
  { question: "《安般守意经》论述了什么方法？", category: "十万个为什么", answer: "以观察呼吸作为修习禅定的方法", explain: "《安般守意经》，东汉安世高所译之坐禅佛典，收于《大正藏》经集部，论述以观察呼吸作为修习禅定的方法。", source: "CMRC 2018 · 安般守意经" },
  { question: "此方法流行于什么时期？", category: "十万个为什么", answer: "后汉到东晋", explain: "此安那般那念与不净观合称二甘露门，为后汉到东晋时期所流行的禅法。", source: "CMRC 2018 · 安般守意经" },
  { question: "松鸦发出的粗糙刺耳的尖叫声主要有啥作用呀？", category: "十万个为什么", answer: "在发现捕猎者时用以警戒同伴", explain: "常听到的呜叫声多是粗糙刺耳的尖叫声，主要是在发现捕猎者时用以警戒同伴之用。", source: "CMRC 2018 · 松鸦" },
  { question: "笔名「林双不」的由来受什么事件的影响？", category: "十万个为什么", answer: "美丽岛事件", explain: "1980年因美丽岛事件的影响，改笔名为「林双不」，作品风格丕变，积极参与政治运动、社会运动。", source: "CMRC 2018 · 林双不" },
  { question: "江文也和郭芝苑之间的关系犹如西方乐史上谁对谁的精神影响？", category: "十万个为什么", answer: "布鲁克纳对马勒", explain: "两人之间的关系犹如西方乐史上布鲁克纳对马勒的精神影响。", source: "CMRC 2018 · 郭芝苑" },
  { question: "在冷冻前食品制造商会通过什么方式来停止酶反应？", category: "十万个为什么", answer: "漂白食品或添加化学物", explain: "因为冷冻只能减缓酶反应，因此在冷冻前，食品制造商会漂白食品或添加化学物来停止酶反应。", source: "CMRC 2018 · 急冻食品" },
  { question: "桑贾伊·甘地的死亡原因是什么？", category: "十万个为什么", answer: "空难", explain: "他的功过备受争议，被指在1975年－1977年间以非官员身分滥权，但在其母亲夺回权力后不久又因空难死亡。", source: "CMRC 2018 · 桑贾伊·甘地" },
  { question: "导致北海道狼数量减少的原因是什么？", category: "十万个为什么", answer: "因为人类大量猎杀", explain: "北海道狼，又称虾夷狼，是一种已灭绝的狼，曾分布在日本的北海道，以及俄罗斯的萨哈林州（桦太、千岛群岛）一带，后来因为人类大量猎杀，导致北海道狼的数量减少，在1889年灭绝。", source: "CMRC 2018 · 北海道狼" },
  { question: "作品的最大目的是什么？", category: "十万个为什么", answer: "分享快乐", explain: "近期，李翰及其团队的重心在角色创作与授权，作品的最大目的就是分享快乐。", source: "CMRC 2018 · 李翰 (设计师)" },
  { question: "散发脱刀令其中一个目的是？", category: "十万个为什么", answer: "使废藩置县政策顺利执行", explain: "此法令的目的之一就是使废藩置县政策顺利执行，作为废止旧武士特权政策的其中一环，一边逐步废止带刀一边避免发生士族叛变。", source: "CMRC 2018 · 散发脱刀令" },
  { question: "许癸努斯的著作在哪个方面对现代学者研究具有重要意义？", category: "十万个为什么", answer: "现代学者研究古希腊神话", explain: "盖乌斯·尤利乌斯·许癸努斯（拉丁语：Gaius Julius Hyginus，约前64年~17年）拉丁作家，他的著作对于现代学者研究古希腊神话具有重要意义。", source: "CMRC 2018 · 许癸努斯" },
  { question: "李根政曾担任哪一档公共电视台节目的主持人？", category: "十万个为什么", answer: "《有话好说─南部开讲》", explain: "创办地球公民协会后，2008年李根政获选为中央通讯社「十大潜力人物」社运环保类得奖人，曾担任公共电视台节目《有话好说─南部开讲》主持人。", source: "CMRC 2018 · 地球公民基金会" },
  { question: "虫纹阿南鱼的食用方法是什么？", category: "十万个为什么", answer: "红烧或清蒸", explain: "为观赏鱼类，但亦可食用，红烧或清蒸均可。", source: "CMRC 2018 · 虫纹阿南鱼" },
  { question: "2013年9月成立「Go车志车队」成立的目的是什么？", category: "十万个为什么", answer: "推广台湾合法安全赛车运动", explain: "为推广推广台湾合法安全赛车运动，于2013年9月成立「Go车志车队」，2015年持续参加OTGP与台湾大赛车等赛车活动。", source: "CMRC 2018 · Go车志" },
  { question: "巡视船装设了系统有何作用？", category: "十万个为什么", answer: "方便准确地在海上定位。", explain: "所有巡视船装设了系统，方便准确地在海上定位。停泊于基地。", source: "CMRC 2018 · 第十管区海上保安本部" },
  { question: "郭麐号白眉生的原因是什么？", category: "十万个为什么", answer: "右眉全白", explain: "郭-{麐}-（-{麐}-同麟，）字群伯，号频伽，因右眉全白，又号白眉生，江苏吴江人。", source: "CMRC 2018 · " },
  { question: "当惹雍错对苯教徒有什么意义？", category: "十万个为什么", answer: "当惹雍错是苯教徒心目中的神湖", explain: "当惹雍错是苯教徒心目中的神湖，湖东岸有苯教寺庙玉本寺和圣地穷宗山。", source: "CMRC 2018 · 当惹雍错" },
  { question: "朱载圳的性格有什么特点?", category: "十万个为什么", answer: "贪婪蛮横", explain: "朱载圳贪婪蛮横而嘉靖帝骄傲暴躁，父子很不和睦，但嘉靖帝依然对儿子护短。", source: "CMRC 2018 · 朱载圳" },
  { question: "沼鹿消失的原因是什么？", category: "十万个为什么", answer: "被猎杀、烹食及失去栖息地", explain: "沼鹿消失的原因是被猎杀、烹食及失去栖息地。", source: "CMRC 2018 · 沼鹿" },
  { question: "麦银汉鱼的体型有什么特点？", category: "十万个为什么", answer: "延长而细，呈亚圆柱型。", explain: "本鱼体延长而细，呈亚圆柱型。头部及两腭外侧具齿状小棘列。", source: "CMRC 2018 · 糙头细银汉鱼" },
  { question: "纳斯卡文明关于头颅的习俗主要可能有什么作用？", category: "十万个为什么", answer: "改善旱灾或农作歉收", explain: "考古学家认为这可能是用来取悦神明的一种献祭，是为了改善旱灾或农作歉收而来。", source: "CMRC 2018 · 纳斯卡文明" },
  { question: "朱常浩的性格有什么特点", category: "十万个为什么", answer: "笃信佛教、不近女色，仅贪财", explain: "常浩笃信佛教、不近女色，仅贪财，很不得神宗的欢心，因此二十五岁还尚未结婚。", source: "CMRC 2018 · 朱常浩" },
  { question: "皱眉肌在强光下收缩的目的是什么？", category: "十万个为什么", answer: "遮挡并减少进入眼睛的光线。", explain: "当暴露在强光之下时，皱眉肌也会收缩，以靠拢两边眉毛，遮挡并减少进入眼睛的光线。", source: "CMRC 2018 · 皱眉肌" },
  { question: "额肌的主要功能是什么？", category: "十万个为什么", answer: "提起眉毛", explain: "额肌的主要功能就在于提起眉毛（相对于眼窝部分的眼轮匝肌），尤其当眼睛朝上看或眼前事物太远、太暗时起作用，人在感觉诧异的时候也会收缩额肌。", source: "CMRC 2018 · 额肌" },
  { question: "气体离心法是制造什么物质的机械式方法?", category: "十万个为什么", answer: "浓缩铀", explain: "气体离心法是一种制造浓缩铀的机械式方法，用以从天然铀中将铀-238分离出铀-235。", source: "CMRC 2018 · 气体离心法" },
  { question: "数珠丸的名字有什么由来？", category: "十万个为什么", answer: "日莲常把念珠挂在刀柄上", explain: "日莲大师认为数珠丸乃「破邪显正之剑」而时常配戴，后因日莲常把念珠挂在刀柄上，所以此刀才获得数珠丸的名字（在日本念珠也称为数珠）。", source: "CMRC 2018 · 数珠丸" },
  { question: "持有存货对企业会产生什么影响？", category: "十万个为什么", answer: "需要花费成本且管理不易", explain: "因为持有存货可能需要花费成本且管理不易，因此存货控制需考量以下这些因素", source: "CMRC 2018 · 存货" },
  { question: "吴淞路闸桥拆除后它的运输功能由什么代替？", category: "十万个为什么", answer: "外滩隧道", explain: "拆除后，吴淞路闸桥的运输功能由外滩隧道代替，水闸功能则由金山路水闸代替。", source: "CMRC 2018 · 吴淞路闸桥" },
  { question: "公司在全球有着怎样的地位？", category: "十万个为什么", answer: "是全球最大的水电上市公司", explain: "从事水力发电业务，公司是全球最大的水电上市公司，拥有总装机容量 4549.5 万千瓦，占全国水电装机的比例为 13.70%，2016 年年发电量 2060.60 亿千瓦时，占全国水电发电量的 17.45%。", source: "CMRC 2018 · 长江电力" },
  { question: "戚务生当年以什么特点著称？", category: "十万个为什么", answer: "迅疾的速度和犀利的突破", explain: "戚务生当年以迅疾的速度和犀利的突破著称。", source: "CMRC 2018 · 戚务生" },
  { question: "朱椿的性格有什么特点？", category: "十万个为什么", answer: "孝友慈祥", explain: "其人个性孝友慈祥，博览群书，所以朱元璋曾经称赞他为「蜀秀才」。", source: "CMRC 2018 · 朱椿 (明朝)" },
  { question: "尖吻灵猫和差不多体型的食肉动物相比有什么特点？", category: "十万个为什么", answer: "发育速度却较慢", explain: "虽然如此，但以差不多体型的肉食性动物来比较，其发育速度却较慢。", source: "CMRC 2018 · 尖吻灵猫" },
  { question: "靳云鹏内阁倒台的原因是什么？", category: "十万个为什么", answer: "因为和旧交通系的矛盾", explain: "此次靳云鹏内阁的倒台是因为和旧交通系的矛盾。", source: "CMRC 2018 · 第二次靳云鹏内阁" },
  { question: "赵鹏在2014年下半赛季没有出场的原因是什么？", category: "十万个为什么", answer: "伤病困扰", explain: "不过由于伤病困扰，他在2014下半赛季并没有得到出场机会。", source: "CMRC 2018 · 赵鹏" },
  { question: "城巴曾今计划将城巴12M线与城巴12线合并的原因是什么？", category: "十万个为什么", answer: "初期客量欠佳", explain: "城巴接办后，初期客量欠佳，城巴一度计划将本线与城巴12线合并，更已发出乘客通告，但因被半山区居民反对而把计划取消。", source: "CMRC 2018 · 城巴12M线" },
  { question: "苏州街站在设计上有什么特点？", category: "十万个为什么", answer: "采用分离式站厅、侧式站台设计", explain: "10号线苏州街站为地下二层车站，车站地处道路路口为绕开路面以下各类既有管线，采用分离式站厅、侧式站台设计，为两端二层，中间单层，单柱双跨结构，全长195米。", source: "CMRC 2018 · 苏州街站" },
  { question: "北京地铁4号线和10号线两线在采用什么方式换乘？", category: "十万个为什么", answer: "“站厅＋通道”双向通行方式", explain: "海淀黄庄站为地下车站，两线车站站台主体呈“十”字型岛–侧式相交形式，两线换乘采用“站厅＋通道”双向通行方式。", source: "CMRC 2018 · 海淀黄庄站" },
  { question: "沪昆铁路嘉善站的客运功能日益萎缩是受什么影响？", category: "十万个为什么", answer: "嘉善小火车停运、第六次大提速", explain: "嘉善小火车停运、第六次大提速的双重影响使得沪昆铁路嘉善站的客运功能日益萎缩。", source: "CMRC 2018 · 嘉善南站" },
  { question: "10号线站台和站厅的设计上有什么特点？", category: "十万个为什么", answer: "采用分离式岛式站台设计", explain: "呼家楼站为地下车站，10号线站台和站厅采用分离式岛式站台设计，以避开立交桥桥桩，左右线间距达47.2米。", source: "CMRC 2018 · 呼家楼站" },
  { question: "河口潮汐在一个周期中的涨落过程一共有几个阶段？", category: "十万个为什么", answer: "4个阶段", explain: "河口潮汐在一个周期中的涨落过程，分4个阶段；", source: "CMRC 2018 · 河口" },
  { question: "最近的一次一号风球是受什么影响产生的？", category: "十万个为什么", answer: "受热带风暴卡努影响", explain: "受热带风暴卡努影响，最近一次一号风球于2017年10月13日下午9时半悬挂。", source: "CMRC 2018 · 一号风球 (澳门)" },
  { question: "在法国殖民前，几内亚地区采用什么贸易方式？", category: "十万个为什么", answer: "物物交易", explain: "在法国殖民前，几内亚地区的商人通行物物交易，重要的商品为盐、棕榈油，并有小部分的金银交易。", source: "CMRC 2018 · 几内亚法郎" },
  { question: "增城挂绿的果肉有什么特点？", category: "十万个为什么", answer: "肉质洁白晶莹，清甜爽口", explain: "肉质洁白晶莹，清甜爽口。", source: "CMRC 2018 · 增城挂绿" },
  { question: "《野狼计划》玩家的副武器有什么功能？", category: "十万个为什么", answer: "可以清除掉画面的多数敌人", explain: "玩家的副武器，可以清除掉画面的多数敌人，初期配置5发。", source: "CMRC 2018 · 野狼计划" },
  { question: "冠饰角龙类是哪种恐龙下目的一个演化支？", category: "十万个为什么", answer: "角龙", explain: "冠饰角龙类（学名：Coronosauria），是角龙下目的一个演化支，生存于白垩纪晚期，分布于现今的北美洲与东亚。", source: "CMRC 2018 · 冠饰角龙类" },
  { question: "2012年于乐以什么方式加盟深圳红钻？", category: "十万个为什么", answer: "自由转会", explain: "2012年2月，于乐以自由转会方式加盟深圳红钻与球队签约3年，合同到期后深圳红钻有续约1年的优先权。", source: "CMRC 2018 · 于乐" },
  { question: "叶乔波在1993年第七届全运会上获得了什么项目的冠军？", category: "十万个为什么", answer: "女子短距离全能冠军", explain: "1993年获第七届全运会女子短距离全能冠军；", source: "CMRC 2018 · 叶乔波" },
  { question: "低级反射的主要作用是什么？", category: "十万个为什么", answer: "保证肢体姿势的稳定性", explain: "此类低级反射的主要作用是保证肢体姿势的稳定性。", source: "CMRC 2018 · 运动系统" },
  { question: "罂粟花有什么作用？", category: "十万个为什么", answer: "可作为观赏及亭园造景之用。", explain: "罂粟花为草本植物，其花朵有各种鲜艳的颜色，可作为观赏及亭园造景之用。其中最有名的，就是可做鸦片原料的罂粟。", source: "CMRC 2018 · 罂粟花" },
  { question: "蕊蕊与台湾艺人金刚结束恋情的原因是什么？", category: "十万个为什么", answer: "性格不合", explain: "蕊蕊与台湾艺人金刚于2013年开始交往，但两人在2016年4月因性格不合而结束恋情。", source: "CMRC 2018 · 蕊蕊" },
  { question: "险礁屿名字的由来是什么？", category: "十万个为什么", answer: "因岛屿四周多暗礁而得名。", explain: "因岛屿四周多暗礁而得名。岛上无人居住。", source: "CMRC 2018 · 险礁屿" },
  { question: "什么是治疗帕金森氏症的最普遍采用的方法的基础？", category: "十万个为什么", answer: "左旋多巴", explain: "而通过在这些实验动物的饮食中添加左旋多巴（L-Dopa），多巴胺的前体，能够减轻相应症状。", source: "CMRC 2018 · 阿尔维德·卡尔森" },
  { question: "阿部定吉表面上和广忠合作，其真实目的是什么？", category: "十万个为什么", answer: "觊觎着康孝的遗留领地。", explain: "此后，表面上和广忠合作的信孝，觊觎着康孝的遗留领地。广忠和阿部定吉商议后，趁信孝前往骏河今川义元处时，攻下信孝的三木城，把他放逐了。", source: "CMRC 2018 · 阿部定吉" },
  { question: "田乞可以继承父位的原因是？", category: "十万个为什么", answer: "兄长田开无嗣子，田乞得立。", explain: "兄长田开无嗣子，田乞得立。田乞向百姓征收赋税时用小斗收进，借给百姓粮食时用大斗，向百姓施以恩德，晏婴多次向齐景公进谏，齐景公却不干涉。", source: "CMRC 2018 · 田僖子" },
  { question: "汉武帝设立苍海郡的目的是什么？", category: "十万个为什么", answer: "阻隔朝鲜国与匈奴的联系。", explain: "设立苍海郡的目的是阻隔朝鲜国与匈奴的联系。由于史籍记载简略，其建制情形已难以详考。", source: "CMRC 2018 · 苍海郡" },
  { question: "丁丁及其伙伴们前往澳洲的原因是什么？", category: "十万个为什么", answer: "参加世界航空大会", explain: "丁丁、米路、哈达克船长和图纳思教授前往澳洲悉尼，参加世界航空大会，却误上了被绑匪看中的百万富翁卡达斯的私人飞机。", source: "CMRC 2018 · 714航班" },
  { question: "三次互反律最常以什么方式表述？", category: "十万个为什么", answer: "艾森斯坦整数", explain: "三次互反律最常使用艾森斯坦整数进行表述。", source: "CMRC 2018 · 三次互反律" },
  { question: "满洲国协和会创办之处的目的是什么？", category: "十万个为什么", answer: "担任未来一党执政的重任", explain: "满洲国协和会为满洲国的官民一体国民组织，起初石原莞尔等人期许本组织能担任未来一党执政的重任，然而在之后则受到日本大政翼赞会旗下各组织影响。", source: "CMRC 2018 · 满洲国协和会" },
  { question: "对唐彦谦学习影响最大的人是谁？", category: "十万个为什么", answer: "李商隐", explain: "能作诗，早年学温庭筠，唐彦谦师法众家，但李商隐对其影响最大，唐彦谦的《无题十首》，容易使人联想到李商隐的“无题诗”。", source: "CMRC 2018 · 唐彦谦" },
  { question: "太平洋潜鸟是属于哪一目的？", category: "十万个为什么", answer: "潜鸟目", explain: "太平洋潜鸟（学名：\"\"）是潜鸟目下的一种中型鸟种。", source: "CMRC 2018 · 太平洋潜鸟" },
  { question: "修改后的《美国爱国者法案》的主要目的是什么？", category: "十万个为什么", answer: "防止恐怖主义", explain: "这个法案以防止恐怖主义的目的，扩张了美国警察机关的权限。", source: "CMRC 2018 · 美国爱国者法案" },
  { question: "欧阳德勋最初是通过什么方式出道的？", category: "十万个为什么", answer: "第三届新秀歌唱大赛季军", explain: "欧阳德勋（，），香港歌手、司仪、前唱片骑师，于1984年第三届新秀歌唱大赛季军出身。", source: "CMRC 2018 · 欧阳德勋" },
  { question: "提出“汉地”这一名称的目的是什么？", category: "十万个为什么", answer: "与其他少数民族聚居地相区别", explain: "汉地一般是指中国汉族聚居地，为与其他少数民族聚居地相区别。", source: "CMRC 2018 · 汉地" },
  { question: "杨守亮官位升迁的原因是什么？", category: "十万个为什么", answer: "养伯杨复恭提拔", explain: "杨复光之养子，改姓杨，早年为扈跸都将，官至山南西道节度使，全靠养伯杨复恭提拔。", source: "CMRC 2018 · 杨守亮" },
  { question: "航空公司要符合什么条件才可申请除名？", category: "十万个为什么", answer: "能够证明飞机有适当的检修", explain: "如果航空公司能够证明飞机有适当的检修，即可申请除名。", source: "CMRC 2018 · 被禁止进入欧盟成员国之航空公司列表" },
  { question: "视力障碍成因中最常见的失明原因是什么？", category: "十万个为什么", answer: "白内障", explain: "全球最常见的视力障碍成因是未矫正的眼屈光不正（43%）、白内障（33%）和青光眼（2%）。", source: "CMRC 2018 · 视力受损" },
  { question: "长流村的名称有几种由来？", category: "十万个为什么", answer: "七种", explain: "长流村之名有七种来由：至于水波楼是推判原由同水冇流，但仅是种读音不同。", source: "CMRC 2018 · 长流村 (台湾)" },
  { question: "在动物驯化的约数万年前，什么是当时主要的生活方式？", category: "十万个为什么", answer: "游牧－采猎者", explain: "在动物驯化的约数万年前，游牧－采猎者是当时主要的生活方式，他们从一处移居到另一处，目的是寻找猎物及野果。", source: "CMRC 2018 · 游牧民族" },
  { question: "游牧民族群体从一处移居到另一处的目的是什么？", category: "十万个为什么", answer: "寻找猎物及野果", explain: "在动物驯化的约数万年前，游牧－采猎者是当时主要的生活方式，他们从一处移居到另一处，目的是寻找猎物及野果。", source: "CMRC 2018 · 游牧民族" },
  { question: "突尼斯航空共有多少个目的地飞越非洲、亚洲和欧洲？", category: "十万个为什么", answer: "53个", explain: "在2008年9月，突尼斯航空共有53个目的地飞越非洲、亚洲和欧洲。", source: "CMRC 2018 · 突尼斯航空" },
  { question: "「史莱姆的第一个家」网站功能是什么？", category: "十万个为什么", answer: "提供合法免费资源", explain: "「史莱姆的第一个家」正式创立于1997年，是台湾的一个知名网站，现以提供合法免费资源为网站功能。", source: "CMRC 2018 · 史莱姆的第一个家" },
  { question: "本体编辑器的功能实际上往往并不仅局限于哪些？", category: "十万个为什么", answer: "本体的创建、编辑和保存", explain: "尽管人们大都习惯于称此类工具为“\"本体编辑器\"”，而本体编辑器的功能实际上往往并不仅局限于本体的创建、编辑和保存。", source: "CMRC 2018 · 本体编辑器" },
  { question: "钱天白毕业后因为政治成分原因曾被分配到哪个项目？", category: "十万个为什么", answer: "继电", explain: "毕业后因政治成分原因曾被分配到继电1990年钱天白加入CANET项目。", source: "CMRC 2018 · 钱天白" },
  { question: "花旗参蜜的饮用方式有什么？", category: "十万个为什么", answer: "可热饮或冷饮", explain: "花旗参蜜，一种以为花旗参及蜂蜜调合而成的饮品，可热饮或冷饮。", source: "CMRC 2018 · 花旗参蜜" },
  { question: "影响马克·雅各布斯一生最大的人是谁？", category: "十万个为什么", answer: "雅各布斯的祖母", explain: "雅各布斯的祖母在他幼时教导他如何缝制衣物，并成了影响雅各斯一生最大的人。", source: "CMRC 2018 · 马克·雅各布斯" },
  { question: "奥奈银鲈适合以什么方式食用？", category: "十万个为什么", answer: "油炸", explain: "为中小型食用鱼，多刺，适合以油炸的方式食用。", source: "CMRC 2018 · 奥奈银鲈" },
  { question: "口器有什么作用？", category: "十万个为什么", answer: "有摄取食物及感觉等作用", explain: "口器（Arthropod mouthparts），位于节肢动物口两侧的器官，有摄取食物及感觉等作用。", source: "CMRC 2018 · 口器" },
  { question: "哪些甲壳亚门的营养方式是以咀嚼植物或动物的固体组织为食的？", category: "十万个为什么", answer: "蜚蠊、蝗虫、豆娘等", explain: "如：蜚蠊、蝗虫、豆娘等。", source: "CMRC 2018 · 口器" },
  { question: "世界影响力最高的前十项品牌中最知名的是哪个？", category: "十万个为什么", answer: "可口可乐", explain: "其中以可口可乐最为知名。", source: "CMRC 2018 · 美国化" },
  { question: "通过穴醚与碱金属的作用可以得到什么？", category: "十万个为什么", answer: "含K等碱金属阴离子的盐类", explain: "全胺穴醚对碱金属阳离子具有极高的亲和力，通过穴醚与碱金属作用，可以成功得到含K等碱金属阴离子的盐类。", source: "CMRC 2018 · 穴状配体" },
  { question: "西捷航空的目的地有多少？", category: "十万个为什么", answer: "89个", explain: "西捷航空提供客运、货运及包机服务，目的地共有89个，主要在北美洲及墨西哥。", source: "CMRC 2018 · 西捷航空" },
  { question: "软颚有什么作用？", category: "十万个为什么", answer: "分隔呼吸道和消化道", explain: "软颚有分隔呼吸道和消化道的作用。", source: "CMRC 2018 · 软颚" },
  { question: "岩石受到应力作用时常会沿着什么方向破裂？", category: "十万个为什么", answer: "垂直应力方向", explain: "岩石受到应力作用时，常会沿著垂直应力方向（或岩石本身具有的弱面）破裂，这些破裂面就称为岩石的节理。", source: "CMRC 2018 · 解理" },
  { question: "金花蛇的滑翔技巧利用了什么原理？", category: "十万个为什么", answer: "弹道学的原理", explain: "金花蛇能以弹道学的原理，准确到达其滑翔的目的地；", source: "CMRC 2018 · 金花蛇属" },
  { question: "导致斯蒂芬岛异鹩灭绝的原因可能是什么？", category: "十万个为什么", answer: "波利尼西亚鼠的掠食", explain: "牠们的消失可能是因波利尼西亚鼠的掠食。", source: "CMRC 2018 · 斯蒂芬岛异鹩" },
  { question: "《远方的鼓声》蕴含了什么文化意义？", category: "十万个为什么", answer: "对客家语言危机的赤裸告白。", explain: "其他曲目，如〈妳敢还记得〉、〈请你回来这里〉、〈爱是什么〉、〈来不及〉等等，从曲目来看都是男女情爱，其实所蕴含的是更深的文化意识，是对客家语言危机的赤裸告白。", source: "CMRC 2018 · 远方的鼓声" },
  { question: "计算速度较慢的显示芯片怎么样才能流畅显示？", category: "十万个为什么", answer: "更多的显存空间", explain: "从上公式可预知使用高分辨率和开启全屏抗锯齿、各向异性过滤、物理效果模拟、多边形顶点数据运算、海量三维函数运算等高级画面效果后，计算速度较慢的显示芯片需要更多的显存空间才能流畅显示。", source: "CMRC 2018 · 显存" },
  { question: "自2004年印度洋地震后，该计划的目的已经改变成什么", category: "十万个为什么", answer: "收集海平面的实时数据", explain: "自2004年印度洋地震后，该计划的目的已经改变为收集海平面的实时数据。", source: "CMRC 2018 · 全球海平面观测系统" },
  { question: "委内瑞拉蚁鸫被怀疑可能灭绝的原因是什么？", category: "十万个为什么", answer: "丧失栖息地", explain: "此后60年里它们都没有被再次发现，被怀疑可能已经因丧失栖息地而灭绝。", source: "CMRC 2018 · 委内瑞拉蚁鸫" },
  { question: "拖链能够对内置的电缆、油管、气管、水管等起到什么作用？", category: "十万个为什么", answer: "牵引和保护的作用", explain: "拖链应用于往复运动的场合，能够对内置的电缆、油管、气管、水管等起到牵引和保护的作用。", source: "CMRC 2018 · 拖链" },
  { question: "黑边鲾在水中取食时有什么特点？", category: "十万个为什么", answer: "发出「波波」的声音", explain: "侧线完整而高位，口能伸缩自如，在水中取食时，会发出「波波」的声音。", source: "CMRC 2018 · 黑边鲾" },
  { question: "肾萎缩与肾功能的减弱有什么关系？", category: "十万个为什么", answer: "相辅相成", explain: "肾萎缩和肾功能改变是相辅相成的，当患者出现肾萎缩时已经或者必然会出现肾功能不全及至肾功能衰竭（尿毒症）。", source: "CMRC 2018 · 肾萎缩" },
  { question: "宋代官员的官服有什么特点？", category: "十万个为什么", answer: "展脚幞头，外形方正。", explain: "而唐代的幞头发展到宋代出现了官员公服的展脚幞头，外形方正。到了明代，朱元璋极力恢复唐宋时期汉人的服制。", source: "CMRC 2018 · 翼善冠" },
  { question: "胡子鲇鳃腔上方具有一树枝状辅呼吸器有什么作用？", category: "十万个为什么", answer: "能呼吸空气", explain: "鳃腔上方具有一树枝状辅呼吸器，能呼吸空气。", source: "CMRC 2018 · 胡子鲇" },
  { question: "棱鮻作为食用鱼有什么特点？", category: "十万个为什么", answer: "体型也较小，红烧、煮汤均宜", explain: "食用鱼，体型也较小，红烧、煮汤均宜。", source: "CMRC 2018 · 棱鮻" },
  { question: "安天实验室追求怎样的团队风格？", category: "十万个为什么", answer: "彪悍、协作、民主、快乐", explain: "团队文化安天团队以工程师文化为主导，以“创造就是我们的脚步”为信念，以带给用户“信息安全每一天”为使命，崇尚安全工程师的责任感和荣誉感，崇尚彪悍、协作、民主、快乐的团队风格。", source: "CMRC 2018 · 安天实验室" },
  { question: "计算机还包括什么功能？", category: "十万个为什么", answer: "基本的转换功能", explain: "计算机还包括一些基本的转换功能，转换单位分为下列几类：汇率将通过互联网更新。", source: "CMRC 2018 · 计算机 (应用程式)" },
  { question: "心脏病发作的主要原因是什么？", category: "十万个为什么", answer: "心肌梗死", explain: "心肌梗死，通常被认为是心脏病发作的主要原因，导致心肌瘢痕形成，因此导致肌肉力量的损失，还可能出现心脏衰竭。", source: "CMRC 2018 · 疤痕" },
  { question: "系统管理汇流排有什么作用？", category: "十万个为什么", answer: "轻量级的通讯", explain: "系统管理汇流排（, 缩写为SMBus或SMB）是一种两条讯号所组成源自于I2C的一种汇流排，其设计应用于轻量级的通讯。", source: "CMRC 2018 · 系统管理汇流排" },
  { question: "这种鱼的数量下降的原因是什么？", category: "十万个为什么", answer: "过度滥捕", explain: "在市场上均切成小块出售，头可煮清汤、背肉宜清蒸，腹肉红烧最美，但过度滥捕，数量已开始下降，已列为受保护的鱼类，政府严厉禁止渔民抓捕，因此已经成为稀有品种的鱼类。", source: "CMRC 2018 · 鳃棘鲈" },
  { question: "量子系统的基态一般是采用什么方式计算出来的？", category: "十万个为什么", answer: "利用数值方法来求得基态", explain: "可想而知，随著量子系统的粒子数变多，且交互作用愈来愈复杂时，量子系统的基态很难用解析的方法计算出来，因此许多物理学家转向利用数值方法来求得基态。", source: "CMRC 2018 · 精确对角化法" },
  { question: "汉武帝发兵灭朝鲜的原因包括什么？", category: "十万个为什么", answer: "朝鲜阻挠真番、辰国使臣入贡", explain: "朝鲜阻挠真番、辰国使臣入贡，成为汉武帝发兵灭朝鲜的原因之一。", source: "CMRC 2018 · 真番郡" },
  { question: "1938年1月9日，苏共党中央的大清洗的方式有什么变化？", category: "十万个为什么", answer: "由全面清洗转为定点清除。", explain: "大清洗的方式开始由全面清洗转为定点清除。4月，叶若夫兼任水运人民委员，内务部实际由贝利亚负责。", source: "CMRC 2018 · 尼古拉·伊万诺维奇·叶若夫" },
  { question: "桶盘国小废校的原因是什么？", category: "十万个为什么", answer: "近年来因人口外移严重", explain: "，而近年来因人口外移严重，桶盘国小已于1993年废校。", source: "CMRC 2018 · 桶盘屿" },
  { question: "他的诗文有什么特点？", category: "十万个为什么", answer: "辞采逸丽", explain: "丘迟诗文辞采逸丽，亦擅诗，钟嵘评：“范诗（范云）清便宛转，如流风回雪。", source: "CMRC 2018 · 丘迟" },
  { question: "美军在这场海战中的起了重要作用的是什么？", category: "十万个为什么", answer: "雷达技术", explain: "美国的雷达技术在这一系列的海上交锋中扮演了重要的角色。", source: "CMRC 2018 · 圣乔治角海战" },
  { question: "英方营救亚皆老街集中营的英藉军官的计划一再搁置的原因是什么？", category: "十万个为什么", answer: "风险太高", explain: "1943年，英军服务团曾组派员参加美国军事顾问团在衡阳为国民政府军而设的伞兵训练营，英方一度计划以武力营救亚皆老街集中营的英藉军官，但最终因风险太高而搁置。", source: "CMRC 2018 · 英军服务团" },
  { question: "宗亲会设立的目的是什么？", category: "十万个为什么", answer: "维系伦理", explain: "而宗亲会除了平时的联络外，还有族谱的编制，宗族祖先的祭祀，所以亦可说宗亲会的设立就是为了维系伦理而产生的。", source: "CMRC 2018 · 宗亲会" },
  { question: "该公园的游览方式是什么？", category: "十万个为什么", answer: "通过游船或飞机在空中游览。", explain: "冰川湾国家公园内没有道路，因此主要的游览方式是通过游船或飞机在空中游览。尽管如此，平均每年参观冰川湾国家公园的游客仍然达到30万人（2006年为413,382人）。", source: "CMRC 2018 · 冰川湾国家公园" },
  { question: "CSCL的目的是什么？", category: "十万个为什么", answer: "支援学生有效率的共同学习。", explain: "CSCL 的目的是：支援学生有效率的共同学习。CSCL 支援学习者之间，意见与资讯的沟通；", source: "CMRC 2018 · 电脑支援协作学习" },
  { question: "最终促使蒙塔尼投身医学的原因是什么？", category: "十万个为什么", answer: "祖父患结肠癌", explain: "由于祖父患结肠癌，他决定投身医学。", source: "CMRC 2018 · 吕克·蒙塔尼耶" },
  { question: "三甲基氯硅烷与可以烯醇化的醛、酮和酯反应需要什么前提条件？", category: "十万个为什么", answer: "三乙胺和二异丙基氨基锂存在", explain: "三乙胺和二异丙基氨基锂存在下，三甲基氯硅烷与可以烯醇化的醛、酮和酯反应，将其转化为三甲硅基烯醇醚。", source: "CMRC 2018 · 三甲基氯硅烷" },
  { question: "这个计算黑子数目的想法是谁提出的？", category: "十万个为什么", answer: "鲁道夫·沃夫", explain: "这个计算黑子数目的想法鲁道夫·沃夫于1849年在瑞士的苏黎世提出的，因此以他的名字（或地名）做为名称，使用黑子数和它们的群数组合，以补偿小黑子群对观测数量的变异。", source: "CMRC 2018 · 沃夫数" },
  { question: "乔尔选择了什么方式要求纽卡斯尔联喷气机同意其转会？", category: "十万个为什么", answer: "罢赛、罢训方式", explain: "乔尔选择了罢赛、罢训方式要求纽卡斯尔联喷气机同意其转会。", source: "CMRC 2018 · 乔尔·格里菲斯" },
  { question: "什么原因导致程廷华入京为学徒？", category: "十万个为什么", answer: "因生计入京为学徒", explain: "程廷华自幼爱好武术，精通摔跤，因生计入京为学徒，后在北京崇文门外花市四条开设眼镜舖，绰号「眼镜程」。", source: "CMRC 2018 · 程廷华" },
  { question: "校园传道会强调什么是建造大学校园基督徒团体的方式？", category: "十万个为什么", answer: "门徒训练", explain: "其宗旨为以基督为中心过圣灵充满的生活、活在神的话语中、强调个人跟进的重要性、一对一门徒训练还有门徒、同工和传道人的倍增。", source: "CMRC 2018 · 陶申·特罗曼" },
  { question: "白俄罗斯传统服饰最初受什么的影响？", category: "十万个为什么", answer: "基辅罗斯时期服饰风格的影响", explain: "白俄罗斯传统服饰最初受基辅罗斯时期服饰风格的影响，随后主要受波兰、立陶宛、拉脱维亚、俄罗斯等其他欧洲国家的影响。", source: "CMRC 2018 · 白俄罗斯文化" },
  { question: "大多数的传播行为都采用什么方式传播？", category: "十万个为什么", answer: "游击营销的方式", explain: "大多数的传播行为都采用游击营销的方式传播，少数Netlabel会有额外的资金供给于加盟的艺术家。", source: "CMRC 2018 · Netlabel" },
  { question: "荷语系中是如何表示皇家一词的？", category: "十万个为什么", answer: "Koninklijke", explain: "荷语系使用Koninklijke一词，主要于荷兰和比利时两国使用，以比利时使用率较高，在多支文化会和体育会均有使用，例如皇家亨克体育会(KRC Genk)、皇家真特体育会(KAA Gent)等等。", source: "CMRC 2018 · 皇家" },
  { question: "列举法是什么理论中表示集合（或类）的一种方法？", category: "十万个为什么", answer: "集合论（或者类的理论）", explain: "列举法是集合论（或者类的理论）中表示集合（或类）的一种方法。", source: "CMRC 2018 · 列举法 (集合论)" },
  { question: "描述法是集合论（或者类的理论）中表示什么的一种方法？", category: "十万个为什么", answer: "集合（或类）", explain: "描述法是集合论（或者类的理论）中表示集合（或类）的一种方法。", source: "CMRC 2018 · 描述法 (集合论)" },
  { question: "在一般情况下，我们可以依据元素的什么来构造一个集合（或类）？", category: "十万个为什么", answer: "性质", explain: "在一般情况下，只要给出一个关于元素的性质，就能依该性质构造出一个集合（或类），因此我们可以用描述该性质的方法来表示相应的集合（或类）。", source: "CMRC 2018 · 描述法 (集合论)" },
  { question: "「灵活玩」的每票/每注最低投注金额进一步调低有什么作用？", category: "十万个为什么", answer: "让顾客能更灵活地运用投注本金", explain: "2012-13年马季开始，「灵活玩」的每票/每注最低投注金额进一步调低，让顾客能更灵活地运用投注本金。", source: "CMRC 2018 · 灵活玩" },
  { question: "项目的第一个领导者是谁？", category: "十万个为什么", answer: "Avinash Gupta", explain: "有了新目标和方向取代了\"成熟创世纪克隆\"而有了现在的名字\"WorldForge\" Avinash Gupta是项目的第一个领导者，然后是Bryce Harrington。", source: "CMRC 2018 · WorldForge" },
  { question: "淡黄纹霸鹟的鸟蛋有何特点？", category: "十万个为什么", answer: "鸟蛋呈白色及有淡红斑点", explain: "每次会产2-3颗鸟蛋，鸟蛋呈白色及有淡红斑点。", source: "CMRC 2018 · 淡黄纹霸鹟" },
  { question: "把偶然性量化的方法是什么？", category: "十万个为什么", answer: "概率论为基础的随机性模型", explain: "而把这种偶然性量化的方法是概率论为基础的随机性模型；", source: "CMRC 2018 · 偶然性" },
  { question: "1875年尚健因什么原因辞去摄政一职？", category: "十万个为什么", answer: "受向有恒的牵连遭人弹劾", explain: "1875年因受向有恒的牵连遭人弹劾，辞去摄政一职。", source: "CMRC 2018 · 尚健" },
  { question: "哪些因素会影响过冷现场不成功？", category: "十万个为什么", answer: "水的温度，水瓶质料，大小等", explain: "但现象可能受很多因素影响而未能成功，因素包括水的温度，水瓶质料，大小等。", source: "CMRC 2018 · 过冷" },
  { question: "由于什么原因，《中外交通史籍丛刊》中骤？", category: "十万个为什么", answer: "向达逝世", explain: "文化大革命期间，向达逝世，此丛刊中骤。", source: "CMRC 2018 · 中外交通史籍丛刊" },
  { question: "蓝点马鲛可以通过什么方法食用？", category: "十万个为什么", answer: "生鱼片、盐烤、煮汤", explain: "为高经济价值鱼，肉质鲜美，可做成生鱼片、盐烤、煮汤等方法食用。", source: "CMRC 2018 · 蓝点马鲛" },
  { question: "刺鲳适合什么烹饪方式来食用？", category: "十万个为什么", answer: "煎或清蒸", explain: "刺鲳是一种重要食用鱼，野生数量稳定，适合煎或清蒸食用。", source: "CMRC 2018 · 刺鲳" },
  { question: "繁星鲆是用什么烹饪方式做成扁鱼酥的？", category: "十万个为什么", answer: "油炸", explain: "食用鱼，用油炸成扁鱼酥。", source: "CMRC 2018 · 繁星鲆" },
  { question: "角箱鲀经常通过什么方式来寻找食物？", category: "十万个为什么", answer: "将海底的沙吹散", explain: "属肉食性，常将海底的沙吹散以寻找食物。", source: "CMRC 2018 · 角箱鲀" },
  { question: "中华民国合气道推广训练协进会成立的目的是什么？", category: "十万个为什么", answer: "追求理想，继续推展及维护道统", explain: "民国80年〈1991年〉之后，合气道协会中许多人士为了追求理想，继续推展及维护道统，遂成立中华民国合气道推广训练协进会。", source: "CMRC 2018 · 李清楠" },
  { question: "唐高宗通过扶植金仁问为新罗君主的方式来对付谁？", category: "十万个为什么", answer: "新罗文武王", explain: "金仁问（），新罗武烈王之子，新罗文武王的弟弟。", source: "CMRC 2018 · 金仁问" },
  { question: "美国真人秀《飞黄腾达》的应聘者可通过何种方式申请？", category: "十万个为什么", answer: "在线申请", explain: "学徒的应聘者可以在线申请（与既往的各辑相同） 。", source: "CMRC 2018 · 飞黄腾达5" },
  { question: "董雷最后一次代表申花出战正式比赛的战果如何？", category: "十万个为什么", answer: "球队以2-5告负", explain: "2010年11月6日，上海申花在联赛最后一轮客场出战已经提前夺冠的山东鲁能，由于王大雷上调国奥队，邱盛炯受伤，董雷第一次也是最后一次代表申花出战正式比赛，不过球队以2-5告负。", source: "CMRC 2018 · 董雷 (足球运动员)" },
  { question: "黄右昌被选派到日本留学，在哪所大学学习西方法律？", category: "十万个为什么", answer: "早稻田大学", explain: "后来，入湖南时务学堂，1904年因成绩优秀被选派到日本留学，入早稻田大学学习西方法律。", source: "CMRC 2018 · 黄右昌" },
  { question: "远距复健进行的方式相较于一般远距医学主要有什么特点？", category: "十万个为什么", answer: "介入强度较低，而施行时间较长", explain: "相较于一般远距医学，介入强度较低，而施行时间较长。", source: "CMRC 2018 · 复健" },
  { question: "上世纪三十年代后导致自立会影响下降的直接原因是什么？", category: "十万个为什么", answer: "中国民族主义运动的退潮", explain: "随着中国民族主义运动的退潮，自立会的影响也有所下降。", source: "CMRC 2018 · 中国耶稣教自立会" },
  { question: "如今，只有汽水和小食自动贩卖机，它们只接受哪种付款方式?", category: "十万个为什么", answer: "八达通", explain: "长洲渡轮码头接受八达通缴付船费，但只有豪华位会发出收据。", source: "CMRC 2018 · 长洲渡轮码头" },
  { question: "凭什么推断翠池可能是由冰河作用侵蚀所形成冰斗湖？", category: "十万个为什么", answer: "翠池南有圈谷坡，北有凸提", explain: "由于翠池南有圈谷坡，北有凸提，因此推断翠池可能是由冰河作用侵蚀所形成冰斗湖。", source: "CMRC 2018 · 翠池" },
  { question: "圣若望广场名字的由来是什么？", category: "十万个为什么", answer: "得名于圣若望洗礼堂", explain: "圣若望广场（）是佛罗伦萨的一个广场，得名于圣若望洗礼堂，实际上是主教座堂广场的向西延伸。", source: "CMRC 2018 · 圣若望广场 (佛罗伦萨)" },
  { question: "2000年悉尼奥运会羽毛球项目的比赛获得多少奖牌？", category: "十万个为什么", answer: "4金1银3铜共计8枚奖牌", explain: "1992年巴塞罗那奥运首次获1银4铜共计5枚奖牌的成绩，2000年悉尼奥运会羽毛球项目的比赛获得4金1银3铜共计8枚奖牌，为历届奥运会羽毛球比赛的最好成绩；", source: "CMRC 2018 · 2008年夏季奥林匹克运动会中国羽毛球队" },
  { question: "水绵进行光合作用的条件是什么？", category: "十万个为什么", answer: "产生大量氧气泡", explain: "春季，水绵在水下生活，当阳光充足、天气温暖时，它们就可以进行光合作用产生大量氧气泡，出现在缠结的细丝间。", source: "CMRC 2018 · 水绵" },
  { question: "对于可压缩流体，这两种机械装置的建立基于什么原理？", category: "十万个为什么", answer: "牛顿第二定律和欧拉能量方程。", explain: "对于可压缩流体，这两种机械装置都建立于两个基础原理之上，其为牛顿第二定律和欧拉能量方程。同时也是热力学及流体力学的应用。", source: "CMRC 2018 · 涡轮机构" },
  { question: "虔诚军对印度发动恐怖袭击的目的是什么？", category: "十万个为什么", answer: "终结印度在克什米尔地区的管治", explain: "虔诚军多次对印度发动了大型的恐怖袭击，其直接目的就是要终结印度在克什米尔地区的管治。", source: "CMRC 2018 · 虔诚军" },
  { question: "岸本早未的服装风格受到谁的影响？", category: "十万个为什么", answer: "安室奈美惠", explain: "另外，她的服装亦受到安室奈美惠的影响。", source: "CMRC 2018 · 岸本早未" },
  { question: "丞相陆秀夫和小皇帝是以什么方式殉国的？", category: "十万个为什么", answer: "跳海", explain: "西元1279年3月19日，丞相陆秀夫见大势已去，便背着这位刚满八岁的小皇帝赵昺跳海殉国，两人壮烈牺牲，宋王朝灭亡。", source: "CMRC 2018 · 宋少帝陵" },
  { question: "2012年10月18日，珠江台为什么被广电总局勒令在梧州市所有有线电视网络停止播送？", category: "十万个为什么", answer: "“违规跨省传输信号”", explain: "2012年10月18日起，珠江台又突然因“违规跨省传输信号”被广电总局勒令在梧州市所有有线电视网络停止播送，此举并未提前咨询公众意见，引起广泛反对声音，并对当局的真正目的提出质疑。", source: "CMRC 2018 · 广东广播电视台珠江频道" },
  { question: "有些单身女性本身没有任何固定的恋爱或婚姻关系,但是想养育一个孩子，她会怎么做？", category: "十万个为什么", answer: "藉著与男性发生性行为来怀孕", explain: "亦有些与性伴侣发生性关系后怀孕，也有些单身女性本身没有任何固定的恋爱或婚姻关系，但又想生儿育女，于是藉著与男性发生性行为来怀孕，也有些国家容许未婚女性接受他人捐精来怀孕。", source: "CMRC 2018 · 未婚怀孕" },
  { question: "《你的幼妻》游戏名为「Pick me, Honey!」，中文意为什么？", category: "十万个为什么", answer: "“选择我，宝贝！”", explain: "2005年12月20日由专门从事将日本美少女游戏翻译成英文的公司G-Collections推出英文版本在美国发售，游戏名为「Pick me, Honey!」，中文意为“选择我，宝贝！”。", source: "CMRC 2018 · 你的幼妻" },
  { question: "杂凑是电脑科学中一种对什么的处理方法？", category: "十万个为什么", answer: "资料", explain: "杂凑（）是电脑科学中一种对资料的处理方法，通过某种特定的函数/算法（称为杂凑函数/算法）将要检索的项与用来检索的索引（称为杂凑，或者杂凑值）关联起来，生成一种便于搜索的资料结构（称为杂凑表）。", source: "CMRC 2018 · 散列" },
  { question: "法国候爵佶拉尔丹受谁的朴素的自然思想所影响？", category: "十万个为什么", answer: "卢骚", explain: "在哲学家卢骚(Rousseau)朴素的自然思潮和废墟画家的影响下，法国候爵佶拉尔丹(Girardin)将巴黎近郊的艾美诺于尔(Ermenon Ville)，改造为法国首座自然的英国花园后，在十八世纪中期更是掀起建造英式花园的风潮。", source: "CMRC 2018 · 英式庭园" },
  { question: "林佩瑶靠着什么独特的条件获得了评委的青睐？", category: "十万个为什么", answer: "独特的嗓音和自身的努力", explain: "虽然因为没有舞蹈经验而经常被人称为「顾包包女郎」（意思指跟朋友去夜店，但只会负责看包包的女生），但她以其独特的嗓音和自身的努力还是嬴得了一众评审的青睐，并最终能进入十强，获得第九名的好成绩。", source: "CMRC 2018 · 林佩瑶" },
  { question: "该法案成立的主要目的是什么？", category: "十万个为什么", answer: "进一步扩大下议院选民基础", explain: "《1918年人民代表法令》（英语：Representation of the People Act 1918），亦称为“《第四部改革法令》”，是英国在1918年进一步扩大下议院选民基础的法案。", source: "CMRC 2018 · 1918年人民代表法令" },
  { question: "西挪威的潮湿气候主要是受什么的影响？", category: "十万个为什么", answer: "湾流", explain: "西挪威同时也是斯堪的纳维亚半岛的最西端，潮湿多雨，其中靠近海岸的山区，年平均降水达，高峰时一年可达，而卑尔根年平均降雨也达，潮湿的气候，主要是受到湾流的影响，也产生了一个比挪威其他地区更温和的冬天，冬天常见的是下雨而不是下雪。", source: "CMRC 2018 · 西挪威" },
  { question: "谁下诏让丘氏族人改姓邱？", category: "百科知识", answer: "清世宗爱新觉罗·胤禛", explain: "雍正三年（1725），清世宗爱新觉罗·胤禛下诏：天下为避儒家至圣先师孔子的名讳“丘”，丘氏族人的姓氏“丘”字皆加“邑”偏旁改为“邱”，丘氏因此大多改称邱氏。", source: "CMRC 2018 · 丘姓" },
  { question: "什么物质曾经是被观测到的中最动荡不安的？", category: "百科知识", answer: "氢分子", explain: "当NGC 7138B和NGC 7138A撞击时，气体从星系团中被抛出，氢原子被激震波加热，导致绿色的光辉，在这里看见的氢分子是曾经被观测到的中最动荡不安的。", source: "CMRC 2018 · NGC 7318" },
  { question: "哪位苏联外长拒绝了美国的马歇尔计划？", category: "百科知识", answer: "维亚切斯拉夫·莫洛托夫", explain: "苏联外长维亚切斯拉夫·莫洛托夫在政治因素考虑下拒绝了美国的马歇尔计划，因此在铁幕下的东欧国家不能加入马歇尔计划。", source: "CMRC 2018 · 莫洛托夫计划" },
  { question: "哪个国家的代表队在本次比赛中首次夺得冠军？", category: "百科知识", answer: "日本", explain: "日本的代表浦和红钻总比分以 3–1 击败伊朗代表沙巴罕，首次夺得冠军。", source: "CMRC 2018 · 2007年亚足联冠军联赛" },
  { question: "哪条公路纵贯了王江泾镇？", category: "百科知识", answer: "苏嘉乍高速公路", explain: "京杭大运河和苏嘉乍高速公路纵贯该镇。", source: "CMRC 2018 · 王江泾镇" },
  { question: "哪里有非常完整的硕鬣狗化石？", category: "百科知识", answer: "周口店", explain: "大部份遗骸都是碎片，一般是头颅骨，而在周口店亦有非常完整的硕鬣狗化石，估计牠们以洞穴为巢穴。", source: "CMRC 2018 · 硕鬣狗" },
  { question: "谁曾鼓舞林双不积极去投稿？", category: "百科知识", answer: "张清海", explain: "林双不小学时期就读东势国民学校，于小学五年级受教师张清海鼓励即开始投稿。", source: "CMRC 2018 · 林双不" },
  { question: "谁称黄衫女子为「杨姊姊」？", category: "百科知识", answer: "史红石", explain: "”丐帮帮主史火龙之女史红石称其为「杨姊姊」。", source: "CMRC 2018 · 黄衫女子" },
  { question: "什么研究说海熊兽同时使用前肢及后肢来游泳？", category: "百科知识", answer: "生物动力学的研究", explain: "生物动力学的研究显示海熊兽同时使用前肢及后肢来游泳。", source: "CMRC 2018 · 海熊兽" },
  { question: "哪一年海山客运正式并入台北客运？", category: "百科知识", answer: "1991年", explain: "1991年，海山客运正式并入台北客运，相关路线的营运权亦转移之。", source: "CMRC 2018 · 海山客运" },
  { question: "哪一因素决定游离能力？", category: "百科知识", answer: "射线（粒子或波）所带的能量", explain: "游离能力，决定于射线（粒子或波）所带的能量，而不是射线的数量。", source: "CMRC 2018 · 游离辐射" },
  { question: "哪一年在库页岛发现了索齿兽的完整骨骼？", category: "百科知识", answer: "1941年", explain: "于1941年在库页岛发现了索齿兽的完整骨骼，发现牠们是有四条腿的，而骨头更像河马般粗壮，故于1953年Roy H. Reinhart为牠们成立了独立的索齿兽目。", source: "CMRC 2018 · 索齿兽目" },
  { question: "谁是举牌小人的创作者？", category: "百科知识", answer: "李翰", explain: "李翰是一位台湾的插画家，也是举牌小人的创作者。", source: "CMRC 2018 · 李翰 (设计师)" },
  { question: "什么是月代？", category: "百科知识", answer: "传统日本成年男性的发型", explain: "月代，为传统日本成年男性的发型。", source: "CMRC 2018 · 月代" },
  { question: "谁杀了司马晏？", category: "百科知识", answer: "刘曜", explain: "永嘉之乱，司马晏被刘曜所杀，时年三十一。", source: "CMRC 2018 · 司马晏" },
  { question: "谁推荐项斯担任润州丹徒县尉？", category: "百科知识", answer: "郑薰", explain: "郑薰推荐他担任润州丹徒县尉，卒于任所，约卒年大中元年以前。", source: "CMRC 2018 · 项斯" },
  { question: "谁最先发表了攀梗狸藻的描述？", category: "百科知识", answer: "路德维希·本杰明", explain: "1847年，路德维希·本杰明最先发表了攀梗狸藻的描述。", source: "CMRC 2018 · 攀梗狸藻" },
  { question: "哪些物种中缺乏磷酸丙糖异构酶？", category: "百科知识", answer: "解脲支原体", explain: "但也有一些不进行糖酵解的细菌，如解脲支原体（），则缺乏该酶。", source: "CMRC 2018 · 磷酸丙糖异构酶" },
  { question: "谁设计了该教堂？", category: "百科知识", answer: "Henry A. Walsh", explain: "来自克利夫兰的建筑师Henry A. Walsh 设计了哥特式教堂。", source: "CMRC 2018 · 圣体主教座堂" },
  { question: "谁特别熟悉阿兹特克神圣历的用法？", category: "百科知识", answer: "阿兹特克祭司", explain: "阿兹特克神圣历（，意为「日子的算法」）是墨西哥地区还没被西班牙征服以前，阿兹特克人所使用的历法之一，不过除了阿兹特克祭司外，普罗大众并不通晓其用法。", source: "CMRC 2018 · 阿兹特克神圣历" },
  { question: "谁随王僧辩驻巴陵？", category: "百科知识", answer: "王琳", explain: "宜州刺史王琳随王僧辩驻巴陵，宋子仙久攻不克。", source: "CMRC 2018 · 宋子仙" },
  { question: "哪位大臣试图拥护永昌大君为王？", category: "百科知识", answer: "金悌男", explain: "后来因为发生大臣金悌男（仁穆王后之父）意图拥护永昌大君为王。", source: "CMRC 2018 · 永昌大君" },
  { question: "哪一首歌是华语乐坛第一首神游舞曲歌曲？", category: "百科知识", answer: "《醉迷情人》", explain: "《醉迷情人》为陈慧琳首张个人粤语大碟，共收录了10首粤语歌曲和1首国语歌曲。", source: "CMRC 2018 · 醉迷情人" },
  { question: "哪国的成年礼是在大学进行的？", category: "百科知识", answer: "日本", explain: "成年礼也有定在满十六岁时举办者，如日本人的元服礼、潮州人的出花园以及台湾人的做十六岁。", source: "CMRC 2018 · 成年礼" },
  { question: "哪部作品是《金刀情侠》的原著？", category: "百科知识", answer: "《九月鹰飞》", explain: "《金刀情侠》的原著是古龙的《九月鹰飞》。", source: "CMRC 2018 · 金刀情侠 (电视剧)" },
  { question: "谁的研究表示红腹锉尾蛇身体约有十五排鳞片？", category: "百科知识", answer: "贝多姆", explain: "根据贝多姆（Beddome）的研究表示，红腹锉尾蛇身体约有十五排鳞片，唇部的鳞片比较尖锐，覆盖及其鼻孔位置；", source: "CMRC 2018 · 红腹锉尾蛇" },
  { question: "哪个公司在2015年启动吸收合并东方明珠的程序？", category: "百科知识", answer: "百视通", explain: "2015年5月，百视通启动吸收合并东方明珠的程序，原“东方明珠”股票（代码600832）于5月20日摘牌停止交易。", source: "CMRC 2018 · 东方明珠 (公司)" },
  { question: "什么时候宣布了停战？", category: "百科知识", answer: "1814年3月30日", explain: "蒙塞积聚了15000名志愿者，散兵-巴黎综合理工学院和兽医学院的学生，尽管他们缺乏经验，却英勇抵抗，直到1814年3月30日宣布停战。", source: "CMRC 2018 · 克利希广场" },
  { question: "谁的雕像被安置在广场的台座之上？", category: "百科知识", answer: "蒙塞", explain: "面对敌人的推进，蒙塞元帅防守克利希屏障。", source: "CMRC 2018 · 克利希广场" },
  { question: "什么是索莫尼？", category: "百科知识", answer: "塔吉克斯坦的流通货币", explain: "索莫尼 （，ISO 4217代码: TJS）是塔吉克斯坦的流通货币。", source: "CMRC 2018 · 塔吉克斯坦索莫尼" },
  { question: "什么是九号风球？", category: "百科知识", answer: "为澳门第二高的热带气旋警告", explain: "为澳门第二高的热带气旋警告。", source: "CMRC 2018 · 九号风球 (澳门)" },
  { question: "几内亚法郎的辅币单位是什么？", category: "百科知识", answer: "分", explain: "辅币单位为分，1法郎=100分。", source: "CMRC 2018 · 几内亚法郎" },
  { question: "几内亚地区采用法国发行的货币是什么时候？", category: "百科知识", answer: "1890年建立殖民地后", explain: "1890年建立殖民地后，几内亚地区和周边的国家一样开始使用法国发行的货币，当局禁止其他外币和之前以物易物的支付方式。", source: "CMRC 2018 · 几内亚法郎" },
  { question: "什么决定了正、负离子的距离？", category: "百科知识", answer: "半径和", explain: "在每一正离子周围形成一个负离子配位多面体（见离子配位多面体），正、负离子的距离取决于半径和，正离子的配位数取决于正、负离子的半径比。", source: "CMRC 2018 · 鲍林酸碱经验规律" },
  { question: "什么人是不可能升至正四位的？", category: "百科知识", answer: "既非嫡子又无拥有武勋者", explain: "当武门之首清和源氏、桓武平氏初叙从五位下而极位正四位的状况时，既非嫡子又无拥有武勋者可以说是不可能升至此位。", source: "CMRC 2018 · 从四位" },
  { question: "什么时候当了骠骑卫指挥使？", category: "百科知识", answer: "出征陈友谅时", explain: "出征陈友谅时，以功进骠骑卫指挥使。", source: "CMRC 2018 · 陆仲亨" },
  { question: "谁领军讨伐雍闿的南中叛乱？", category: "百科知识", answer: "诸葛亮", explain: "当时雍闿在南中叛乱，南方诸郡响应，诸葛亮决定要亲自领军讨伐。", source: "CMRC 2018 · 王连" },
  { question: "什么是多音字？", category: "百科知识", answer: "多音字是指有多个读音的字", explain: "多音字是指有多个读音的字，在各种语言普遍都有。", source: "CMRC 2018 · 多音字" },
  { question: "哪一部香港电影是由这部电影改编的？", category: "百科知识", answer: "《人民英雄》", explain: "香港导演尔冬升亦受本片启发并于1987年改编本片并拍摄电影《人民英雄》。", source: "CMRC 2018 · 热天午后" },
  { question: "哪个出版社发行的《伯爵与妖精》？", category: "百科知识", answer: "集英社的Cobalt文库", explain: "《伯爵与妖精》（）是谷瑞惠所写的日本轻小说系列作品，发行于集英社的Cobalt文库。", source: "CMRC 2018 · 伯爵与妖精" },
  { question: "哪个国家实际管理太平洋群岛托管地？", category: "百科知识", answer: "美国", explain: "太平洋群岛托管地（），是联合国委托美国于西太平洋密克罗尼西亚群岛的一个托管地带，美国对该地区实际控制，直至1994年10月帛琉宣布独立为止。", source: "CMRC 2018 · 太平洋群岛托管地" },
  { question: "哪一年这里建成了一个码头？", category: "百科知识", answer: "2003年", explain: "2003年位于肯波拉的码头落成，可便捷地连接另一个旅游胜地埃奥利群岛。", source: "CMRC 2018 · 肯波拉圣吉奥瓦尼" },
  { question: "谁接受政府委托由连照美带领台大师生前往挖掘？", category: "百科知识", answer: "国立台湾大学人类学系", explain: "于是国立台湾大学人类学系接受政府委托由连照美带领台大师生前往挖掘，宋文薰也前往指导。", source: "CMRC 2018 · 卑南考古文物事件" },
  { question: "哪个族经是平埔族中人口最多且势力最强的族群？", category: "百科知识", answer: "西拉雅族", explain: "买姓在台湾是一个特殊罕见姓氏，其为台湾平埔族中的西拉雅族（或称之为西拉雅平埔族）的特有姓氏之一，原为「Takalomay」，汉化后改为「买姓」。", source: "CMRC 2018 · 买姓" },
  { question: "哪本书中称之为吴主权王夫人？", category: "百科知识", answer: "《三国志》", explain: "《三国志》中称之为吴主权王夫人。", source: "CMRC 2018 · 大懿皇后" },
  { question: "哪个行星可能是被发现的第一颗冥府行星？", category: "百科知识", answer: "柯洛7b", explain: "柯洛7b可能是被发现的第一颗冥府行星。", source: "CMRC 2018 · 冥府行星" },
  { question: "谁建构了科层制理论体系？", category: "百科知识", answer: "德国社会学家韦伯", explain: "德国社会学家韦伯建构了科层制理论体系，他认为理性的科层制应免除价值判断，仅依照专业知识与技能有效忠实执行主权者所交付的任务。", source: "CMRC 2018 · 行政中立" },
  { question: "哪里是GSM网络覆盖的世界最高点？", category: "百科知识", answer: "乞力马扎罗山", explain: "沃达康的信号覆盖了乞力马扎罗山，这里曾经是GSM网络覆盖的世界最高点。", source: "CMRC 2018 · Vodacom" },
  { question: "谁是美第奇银行的经理？", category: "百科知识", answer: "弗朗切斯科·萨塞蒂", explain: "其中最著名的是右侧第6个小圣堂萨塞蒂小堂，弗朗切斯科·萨塞蒂是美第奇银行的经理。", source: "CMRC 2018 · 天主圣三圣殿 (佛罗伦萨)" },
  { question: "哪种是分布区域最广的水獭？", category: "百科知识", answer: "欧亚水獭", explain: "欧亚水獭（学名：'），或简称水獭，是亚洲及欧洲的一种水獭，栖息在淡水环境。", source: "CMRC 2018 · 欧亚水獭" },
  { question: "什么被作为宗教仪式用品和音乐器具？", category: "百科知识", answer: "东山铜鼓", explain: "东山文化最突出的文化遗产是东山铜鼓等青铜器制品，它们在东南亚和今中国南部的广大地区都有发现。", source: "CMRC 2018 · 东山文化 (越南)" },
  { question: "哪年克罗地亚航空接送了第100万名乘客？", category: "百科知识", answer: "1994年", explain: "1994年，克罗地亚航空接送了第100万名乘客。", source: "CMRC 2018 · 克罗地亚航空" },
  { question: "谁是19世纪美术史上最前卫的画家之一？", category: "百科知识", answer: "詹姆斯·惠斯勒", explain: "詹姆斯·惠斯勒（James McNeill Whistler，），著名印象派画家，父亲是美国工程师，全家曾居于圣彼得堡。", source: "CMRC 2018 · 詹姆斯·惠斯勒" },
  { question: "什么是门索科特拉岛上唯一的商业机场？", category: "百科知识", answer: "索科特拉机场", explain: "索科特拉机场（英文：Socotra Airport，阿拉伯文：مطار سقطرى الدولي），是也门索科特拉岛上的一座机场，是该岛唯一的商业机场。", source: "CMRC 2018 · 索科特拉机场" },
  { question: "什么是已知最大型的结节龙科恐龙之一？", category: "百科知识", answer: "重怪龙", explain: "重怪龙属（学名：\"Peloroplites\"）是种结节龙科恐龙，化石发现于美国犹他州艾麦里县，年代属于白垩纪早期。", source: "CMRC 2018 · 重怪龙属" },
  { question: "哪一部电影曾在昃臣道拍过外景？", category: "百科知识", answer: "《英雄本色》", explain: "香港电影《英雄本色》第二场，周润发在香港会所大厦门前进食街头小食猪肠粉，就是在昃臣道拍外景。", source: "CMRC 2018 · 昃臣道" },
  { question: "什么记录了冰岛的植物和居民生活？", category: "百科知识", answer: "《冰岛记游》", explain: "1809年夏季，他到冰岛考察，搜集了许多标本，但回程时发生了火灾，差点丧命，标本几乎都被毁，但他凭记忆写出了《冰岛记游》，记录了冰岛的植物和居民生活。", source: "CMRC 2018 · 威廉·杰克逊·胡克" },
  { question: "哪一年自由软体铸造场成立？", category: "百科知识", answer: "2003年", explain: "于2003年，获得中华民国经济部工业局的专案补助而成立。", source: "CMRC 2018 · 自由软体铸造场" },
  { question: "何时保罗·策雷索莱当选为联邦委员会委员？", category: "百科知识", answer: "1870年2月1日", explain: "他于1870年2月1日当选为联邦委员会委员，任职至1875年12月31日卸任。", source: "CMRC 2018 · 保罗·策雷索莱" },
  { question: "哪一年再度创立后突厥汗国？", category: "百科知识", answer: "唐高宗末年（682年）", explain: "在唐高宗末年（682年），再度建立后突厥汗国，最后在745年，后突厥帝国亡于回纥。", source: "CMRC 2018 · 突厥汗国" },
  { question: "谁被很多毛利人部落奉为祖先？", category: "百科知识", answer: "库佩", explain: "库佩()在新西兰部份毛利人部族的神秘传说中，是新西兰最初的发现者，大约在公元925年到达当地。", source: "CMRC 2018 · 库佩" },
  { question: "什么疾病导致钱天白去世？", category: "百科知识", answer: "心脏病突发", explain: "1998年5月，钱天白心脏病突发去世，享年53岁。", source: "CMRC 2018 · 钱天白" },
  { question: "谁被认为是阿部氏的始祖？", category: "百科知识", answer: "孝元天皇的第一皇子阿部大彦命", explain: "孝元天皇的第一皇子阿部大彦命被认为是他们的始祖。", source: "CMRC 2018 · 阿部氏 (德川谱代)" },
  { question: "什么事件危及到了主上家的存亡？", category: "百科知识", answer: "“守山崩”事件", explain: "“守山崩”事件，危及到了主上家的存亡。", source: "CMRC 2018 · 阿部氏 (德川谱代)" },
  { question: "谁是三河松平氏（德川氏）的谱代家臣？", category: "百科知识", answer: "阿部氏", explain: "阿部氏是日本的一个氏族。", source: "CMRC 2018 · 阿部氏 (德川谱代)" },
  { question: "哪一年《夺命捉迷藏》被改编为真人版电影？", category: "百科知识", answer: "2008年", explain: "2008年改编成真人版电影在日本上映。", source: "CMRC 2018 · 夺命捉迷藏" },
  { question: "哪一年赵汇川病逝？", category: "百科知识", answer: "1996年", explain: "1996年5月27日逝世，享年84岁。", source: "CMRC 2018 · 赵汇川" },
  { question: "哪一年研究所被美军搬至海德堡总部附近？", category: "百科知识", answer: "二战后的1945年", explain: "二战后的1945年，研究所被美军搬迁到美军在海德堡的总部附近，搬迁工作于研究所300周年庆典2000年5月完毕。", source: "CMRC 2018 · 天文学计算研究所" },
  { question: "哪一年努马·德罗茨去世？", category: "百科知识", answer: "1899年", explain: "努马·德罗茨1899年在瑞士伯尔尼去世。", source: "CMRC 2018 · 努马·德罗茨" },
  { question: "哪个战争结束后内大臣府被废除？", category: "百科知识", answer: "太平洋战争结束后", explain: "太平洋战争结束后，驻日盟军总司令（SCAP）于1945年11月24日命令废除内大臣府。", source: "CMRC 2018 · 内大臣府" },
  { question: "谁是画法几何的主要提出者？", category: "百科知识", answer: "法国数学家加斯帕·蒙日", explain: "其起源于军事上的应用需要，主要由法国数学家加斯帕·蒙日提出。", source: "CMRC 2018 · 画法几何" },
  { question: "什么时候观察家报开创？", category: "百科知识", answer: "1791年12月4日", explain: "观察家报创刊于1791年12月4日，是世界第一份在礼拜日发行的报纸。", source: "CMRC 2018 · 观察家报" },
  { question: "哪一年报纸公开宣言了无党派倾向的编辑方针？", category: "百科知识", answer: "1942年", explain: "1942年，该报公开宣言了无党派倾向的编辑方针，这在当时是较为少有的。", source: "CMRC 2018 · 观察家报" },
  { question: "哪一年《星期日泰晤士报》被收购？", category: "百科知识", answer: "1981年", explain: "1981年，《星期日泰晤士报》被传媒大亨默多克的新闻集团收购。", source: "CMRC 2018 · 星期日泰晤士报" },
  { question: "哪一年天津市规划局将古文化街纳入历史文化街区规划？", category: "百科知识", answer: "2011年", explain: "2011年，天津市规划局将这里纳入历史文化街区规划，定名古文化街历史文化街区。", source: "CMRC 2018 · 古文化街" },
  { question: "哪个年代古伦美亚开始跨足流行歌曲领域？", category: "百科知识", answer: "1970年代中期", explain: "长于演歌、歌谣、儿童节目的动画歌曲、传统艺能与学校音乐教材方面，1970年代中期跨足流行歌曲领域。", source: "CMRC 2018 · 日本古伦美亚" },
  { question: "谁在拉策堡建造了一座大教堂？", category: "百科知识", answer: "亨利三世", explain: "亨利三世在拉策堡建造了一座哥特式的大教堂，而与此风格类似的教堂亨利在吕贝克和不伦瑞克也各建造了一座。", source: "CMRC 2018 · 拉策堡" },
  { question: "谁升为了建州留后？", category: "百科知识", answer: "次子王继", explain: "后唐明宗长兴二年（931年）四月，王延禀任奉国节度使兼中书令，听闻闽王王延钧有病，认为有机可乘，于是任命次子王继升为建州留后，和另一位儿子王继雄一同领水军进攻福州。", source: "CMRC 2018 · 王延禀" },
  { question: "谁是GAINAX的创始人之一？", category: "百科知识", answer: "庵野秀明", explain: "khara成立于2006年5月，其执行董事是GAINAX的动画企划庵野秀明。", source: "CMRC 2018 · Khara" },
  { question: "哪一年在安徽淮北市发现了拖舵?", category: "百科知识", answer: "1999年", explain: "1999年在安徽省淮北市唐朝木船上发现拖舵。", source: "CMRC 2018 · 舵" },
  { question: "谁是中国非洲第三大贸易伙伴？", category: "百科知识", answer: "苏丹", explain: "中国－苏丹关系是中国和苏丹之间的外交关系。", source: "CMRC 2018 · 中国－苏丹关系" },
  { question: "何时创立的天主教巴黎教会？", category: "百科知识", answer: "3世纪", explain: "创立于3世纪，首位主教是圣德尼。", source: "CMRC 2018 · 天主教巴黎总教区" },
  { question: "哪一年升格为总教会？", category: "百科知识", answer: "1622年10月20日", explain: "1622年10月20日升格为总教区。", source: "CMRC 2018 · 天主教巴黎总教区" },
  { question: "哪一年高智升与高升泰父子逼迫上明帝段寿辉退位出家？", category: "百科知识", answer: "1081年", explain: "1081年，高智升与高升泰父子逼迫上明帝段寿辉退位出家，接著便拥立段正明继位。", source: "CMRC 2018 · 高升泰" },
  { question: "哪一年德国爆发革命？", category: "百科知识", answer: "1918年", explain: "1918年，德国爆发革命。", source: "CMRC 2018 · 卡尔-奥古斯特 (萨克森-魏玛-艾森纳赫)" },
  { question: "谁继位成为家族族长？", category: "百科知识", answer: "他的长子米夏埃尔-本尼迪克特", explain: "他的长子米夏埃尔-本尼迪克特继位成为家族族长。", source: "CMRC 2018 · 卡尔-奥古斯特 (萨克森-魏玛-艾森纳赫)" },
  { question: "谁被尊为西班牙主教长？", category: "百科知识", answer: "托莱多总主教", explain: "托莱多总主教被尊为西班牙主教长。", source: "CMRC 2018 · 天主教托莱多总教区" },
  { question: "谁是第一个太保？", category: "百科知识", answer: "召公", explain: "召公是第一个太保，《大戴礼记》说：“召公为太保，周公为太傅，太公为太师。", source: "CMRC 2018 · 太保" },
  { question: "什么时候成立太平洋大学？", category: "百科知识", answer: "1851年7月10日", explain: "1851年7月10日在加州圣克拉拉（Santa Clara）成立，校名为加州卫斯理学院（California Wesleyan College）。", source: "CMRC 2018 · 太平洋大学" },
  { question: "哪一年成立了医学院？", category: "百科知识", answer: "1858年", explain: "最初属于循道教会，1858年成立医学院，之后医学院并入斯坦福，现在是加州太平洋医学中心（California Pacific Medical Center）。", source: "CMRC 2018 · 太平洋大学" },
  { question: "什么时候成立的教区？", category: "百科知识", answer: "3世纪", explain: "3世纪成立教区，1492年升格为总教区，附属教区有天主教阿尔梅里亚教区、天主教卡塔赫纳教区、天主教瓜迪克斯教区、天主教哈恩教区和天主教马拉加教区。", source: "CMRC 2018 · 天主教格拉纳达总教区" },
  { question: "哪一年升格为总教区？", category: "百科知识", answer: "1964年", explain: "1964年升格为总教区，当时仍属于托莱多教省范围。", source: "CMRC 2018 · 天主教马德里总教区" },
  { question: "哪一年葡国中央发表了主权宣言？", category: "百科知识", answer: "1446年", explain: "葡属几内亚（），是西非国家几内亚比索在1446年至1974年9月10日这段期间的名称。", source: "CMRC 2018 · 葡属几内亚" },
  { question: "哪一年巴黎教区升格为总教区？", category: "百科知识", answer: "1622年", explain: "1622年以前，桑斯总教区由7个附属教区：天主教沙特尔教区、天主教欧塞尔教区、天主教莫城教区、天主教巴黎教区、天主教奥尔良教区、天主教讷韦尔教区和天主教特鲁瓦教区。", source: "CMRC 2018 · 天主教桑斯总教区" },
  { question: "哪一年丁谓生病去世的？", category: "百科知识", answer: "景祐四年（1037年）病卒", explain: "景祐四年（1037年）病卒。", source: "CMRC 2018 · 丁谓" },
  { question: "哪年文礼阁第二期的第四座落成？", category: "百科知识", answer: "1993年", explain: "而第二期的第4座则于1993年落成。", source: "CMRC 2018 · 文礼阁" },
  { question: "什么时候起起在手机用官方网站开始提供？", category: "百科知识", answer: "2008年7月7日起", explain: "2008年7月7日起在手机用官方网站开始提供。", source: "CMRC 2018 · 绝对冲激 ～柏拉图之心～" },
  { question: "谁阐述了太阳运动的本性和范围？", category: "百科知识", answer: "威廉·赫歇尔", explain: "太阳运动的本性和范围最初于1783年由威廉·赫歇尔阐述。", source: "CMRC 2018 · 太阳向点" },
  { question: "哪一年跑道延长至英尺并改以沥青铺设？", category: "百科知识", answer: "1960年", explain: "跑道于1960年延长至英尺并改以沥青铺设。", source: "CMRC 2018 · 基隆拿国际机场" },
  { question: "哪个机场是加拿大国内最繁忙的机场之一？", category: "百科知识", answer: "基隆拿国际机场", explain: "基隆拿国际机场（，）位于加拿大不列颠哥伦比亚省基隆拿市，为一单跑道机场，并提供前往温哥华、西雅图、维多利亚、卡加里、爱民顿、乔治王子城和多伦多的定期航班。", source: "CMRC 2018 · 基隆拿国际机场" },
  { question: "谁继承了卡德尔的事业？", category: "百科知识", answer: "儿子则继承他的出版事业。", explain: "儿子则继承他的出版事业。1802年12月27日卡德尔因哮喘发作，死于家中。", source: "CMRC 2018 · 汤玛斯·卡德尔" },
  { question: "哪一年日本遣使向渤海答谢？", category: "百科知识", answer: "728年", explain: "727年，派遣高仁义出使至日本以遏制新罗， 728年，日本遣使向渤海答谢。", source: "CMRC 2018 · 大武艺" },
  { question: "什么是文化区？", category: "百科知识", answer: "文化较接近的地区", explain: "文化区（Cultural area）是指文化较接近的地区。", source: "CMRC 2018 · 文化区" },
  { question: "什么是静库仑？", category: "百科知识", answer: "电荷的物理单位", explain: "在厘米-克-秒单位制（CGS制）里，静库仑（statC）或（esu）是电荷的物理单位。", source: "CMRC 2018 · 静库仑" },
  { question: "什么是土地伦理？", category: "百科知识", answer: "环境伦理的视角之一", explain: "土地伦理是环境伦理的视角之一，是由奥尔多·利奥波德（）在他的《沙郡年纪》（\"\"）一书中首次倡导的。", source: "CMRC 2018 · 土地伦理" },
  { question: "谁是美国热门电视剧和小说《绯闻女孩》中的女主角？", category: "百科知识", answer: "瑟琳娜·范·德·伍德森", explain: "瑟琳娜·范·德·伍德森（）又译莎琳娜·凡·德·活逊、韦倩莲，美国热门电视剧和小说《绯闻女孩》中的女主角。", source: "CMRC 2018 · 韦倩莲" },
  { question: "什么是DVD-Video？", category: "百科知识", answer: "消费类视频格式", explain: "DVD-Video是消费类视频格式，用于将数位视频存储在DVD光碟上。", source: "CMRC 2018 · DVD-Video" },
  { question: "什么情况下不会有把疤痕？", category: "百科知识", answer: "动物的再生", explain: "一个例外是动物的再生，不形成疤痕，且组织会重新长成和以前一样。", source: "CMRC 2018 · 疤痕" },
  { question: "哪些韵书反映了当时的实际语音？", category: "百科知识", answer: "一些私修的描述声韵的册子", explain: "所幸的是，有一些私修的描述声韵的册子，不同程度地反映了当时的实际语音，如明兰茂作《韵略易通》，清无名氏作《圆音正考》。", source: "CMRC 2018 · 明清音系" },
  { question: "谁继承了俺巴孩的汗位？", category: "百科知识", answer: "侄子忽图剌", explain: "据《元朝秘史》记载，俺巴孩死后，汗位由侄子忽图剌继承。", source: "CMRC 2018 · 俺巴孩" },
  { question: "哪座桥常被称为“59街桥”？", category: "百科知识", answer: "皇后大桥", explain: "在第二大道，59街连接皇后大桥（Queensboro Bridge），此桥常被称为“59街桥”。", source: "CMRC 2018 · 59街" },
  { question: "什么时候后水尾天皇养子？", category: "百科知识", answer: "宽永元年（1624年）", explain: "宽永元年（1624年）成为后水尾天皇养子，寛永3年（1626年）12月接受亲王宣下，命名为忠仁（），后改称智忠亲王。", source: "CMRC 2018 · 八条宫智忠亲王" },
  { question: "什么称为最重要打吡战之一？", category: "百科知识", answer: "近期阿仙奴和车路士打吡战", explain: "而近期阿仙奴和车路士打吡战更成为当今最重要打吡战之一，自车路士在千禧年的冒起，两支球队已在英格兰球坛上争斗。", source: "CMRC 2018 · 新伦敦打吡" },
  { question: "什么时候正式改名为红牛二队？", category: "百科知识", answer: "2006年", explain: "2006年正式改名为红牛二队。", source: "CMRC 2018 · 米纳尔迪车队" },
  { question: "哪一段路是城区主干道？", category: "百科知识", answer: "紫荆山至独松树梁子", explain: "其中紫荆山至独松树梁子为城区主干道，长6公里，双向6车道，在紫荆山、攀枝花学院东门附近、独松树梁子3处分别与攀枝花大道东段、新宏路、炳仁路3条主干道相连；", source: "CMRC 2018 · 攀枝花保安营机场" },
  { question: "什么时候开始，美国对日本移民数量进行限制？", category: "百科知识", answer: "进入1920年代后", explain: "进入1920年代后，美国对日本移民的流入限制增加。", source: "CMRC 2018 · 日本街" },
  { question: "什么是石裙？", category: "百科知识", answer: "弯曲的柱状玄武岩", explain: "东北侧的海崖上，则有弯曲的柱状玄武岩，当地人称「石裙」。", source: "CMRC 2018 · 员贝屿" },
  { question: "什么标志着盟军第二阶段车轮行动的结束？", category: "百科知识", answer: "日本人完成了其撤退任务", explain: "日本人完成了其撤退任务，标志着盟军第二阶段车轮行动的结束。", source: "CMRC 2018 · 维拉拉维拉海战" },
  { question: "哪部通话小说的背景设在了斯科讷？", category: "百科知识", answer: "《尼尔斯骑鹅旅行记》", explain: "斯科讷的火车轨道非常多，童话小说《尼尔斯骑鹅旅行记》的故事背景也设在斯科讷。", source: "CMRC 2018 · 斯科讷" },
  { question: "谁是托勒密三世及其第四任妻子贝勒尼基二世的女儿？", category: "百科知识", answer: "阿尔西诺伊三世", explain: "阿尔西诺伊三世（笃爱父亲者）（希腊语：Αρσινόη ，前246年或245年–前204年），是托勒密三世及其第四任妻子贝勒尼基二世的女儿。", source: "CMRC 2018 · 阿尔西诺伊三世" },
  { question: "谁是为程派八卦掌的创始者？", category: "百科知识", answer: "程廷华", explain: "程廷华（），字应芳，河北省深县程家村人，董海川之徒，为程派八卦掌的创始者。", source: "CMRC 2018 · 程廷华" },
  { question: "哪个教堂全部完成后，将是世界最高教堂？", category: "百科知识", answer: "巴塞罗那的圣家堂", explain: "巴塞罗那的圣家堂全部完成后，将是世界最高教堂，高达170米。", source: "CMRC 2018 · 世界最高教堂列表" },
  { question: "谁曾担任冰岛共和国总理？", category: "百科知识", answer: "约翰娜·西于尔扎多蒂", explain: "约翰娜·西于尔扎多蒂（冰岛语：Jóhanna Sigurðardóttir，国际音标：，）是一位冰岛政治人物。", source: "CMRC 2018 · 约翰娜·西于尔扎多蒂" },
  { question: "什么是琉球国的汉文官修史书？", category: "百科知识", answer: "《中山世谱》", explain: "《中山世谱》是琉球国的汉文官修史书。", source: "CMRC 2018 · 中山世谱" },
  { question: "谁在他父亲去世后接管了公司？", category: "百科知识", answer: "母亲安妮·玛格丽特·斯科", explain: "他父亲马格努斯·马丁努斯·斯科是一名木材和煤炭商，母亲安妮·玛格丽特·斯科在他父亲去世后接管了公司。", source: "CMRC 2018 · 延斯·克里斯蒂安·斯科" },
  { question: "谁是俄罗斯车臣共和国前总统？", category: "百科知识", answer: "阿卢·阿尔哈诺夫", explain: "阿卢·阿尔哈诺夫（俄语：Алу Алханов，）是俄罗斯车臣共和国前总统，2004年至2007年在任。", source: "CMRC 2018 · 阿卢·阿尔哈诺夫" },
  { question: "哪些节气在双月十六日？", category: "百科知识", answer: "小满、大暑、秋分、小雪、大寒", explain: "小满、大暑、秋分、小雪、大寒皆在双月十六日。", source: "CMRC 2018 · 太平天历" },
  { question: "什么是M13弹链的一个缩小版本？", category: "百科知识", answer: "M27弹链", explain: "M27弹链（，全名：）是美国军方为其弹链供弹轻机枪设计的金属制可散式弹链，主要提供给美军及其他北约国家的5.56×45毫米口径的机枪使用。", source: "CMRC 2018 · M27弹链" },
  { question: "谁出席了发射仪式？", category: "百科知识", answer: "总统内贾德", explain: "本次发射恰逄伊朗革命的30周年庆典，总统内贾德出席了发射仪式，并开启卫星传送信号“Allāhu Akbar”（真主至大）。", source: "CMRC 2018 · 希望号卫星" },
  { question: "哪位皇帝追谥都督福满为直皇帝？", category: "百科知识", answer: "顺治帝", explain: "1648年12月18日（清顺治五年十一月辛酉朔五日乙丑），顺治帝追谥他为直皇帝，庙号兴祖。", source: "CMRC 2018 · 福满" },
  { question: "哪个人是世纪越南反唐起义军的军事首领？", category: "百科知识", answer: "冯兴", explain: "冯兴（，），是8世纪越南反唐起义军的军事首领。", source: "CMRC 2018 · 冯兴" },
  { question: "哪个地方为全地铁网络中最高？", category: "百科知识", answer: "天花板", explain: "本站是一个普通的侧式月台车站，且其天花板为全地铁网络中最高。", source: "CMRC 2018 · 蒙莫朗西站" },
  { question: "谁逮捕了安德海？", category: "百科知识", answer: "山东巡抚丁宝桢", explain: "山东巡抚丁宝桢以顺治帝祖训「宦竖非经差遣，不许擅出皇城」表示：“宦竖私出，非制。", source: "CMRC 2018 · 安德海" },
  { question: "哪本文献指出三司官一职早而有之？", category: "百科知识", answer: "《中山世谱》", explain: "据《中山世谱》记载，三司官一职早已有之，原称「阿司多部」，至明末，改称「法司」。", source: "CMRC 2018 · 三司官" },
  { question: "谁曾向唐高祖推荐张行成？", category: "百科知识", answer: "张锐", explain: "吏部侍郎张锐向唐高祖推荐，高祖授张行成雍州富平县主簿，有能干的名声。", source: "CMRC 2018 · 张行成 (唐朝)" },
  { question: "谁继承了第二代罗金汉侯爵的遗产？", category: "百科知识", answer: "第四代菲茨威廉伯爵", explain: "第二代罗金汉侯爵曾两度出任英国首相，他在1782年7月1日逝世后，所有贵族爵位因绝嗣而断绝，而他的遗产后来由外甥第四代菲茨威廉伯爵继承。", source: "CMRC 2018 · 罗金汉侯爵" },
  { question: "什么是力法？", category: "百科知识", answer: "利用变形谐合条件求解的方法", explain: "在结构分析中，将自由度作为主要未知数，基本求解方法有两种：利用变形谐合条件求解的方法，称为力法，此法的应用范围是未知的自由度较少的情况。", source: "CMRC 2018 · 自由度 (工程学)" },
  { question: "哪个车型在“战争机车”序列中重量排在第一？", category: "百科知识", answer: "BR52型", explain: "BR42型机车是从1943年开始制造的，是“战争机车”序列中重量排在第二的型号，仅次于最著名的产量冠军BR52型。", source: "CMRC 2018 · 德意志国铁路42型蒸汽机车" },
  { question: "哪个事件揭开了水晶之夜的序幕？", category: "百科知识", answer: "约瑟夫·戈培尔在大厅发表演说", explain: "1938年11月9日，约瑟夫·戈培尔在大厅发表演说，揭开水晶之夜的序幕。", source: "CMRC 2018 · 慕尼黑旧市政厅" },
  { question: "哪两个国家是首次参加此赛事？", category: "百科知识", answer: "印度与立陶宛是首度参加此赛事", explain: "其中，印度与立陶宛是首度参加此赛事。", source: "CMRC 2018 · 2008年世界大学棒球锦标赛" },
  { question: "谁补充了哈伯序列的不足？", category: "百科知识", answer: "热拉尔·佛科留斯", explain: "佛科留斯系统被视为是哈伯序列的扩充，并被广泛的使用者，最早是在1959年由热拉尔·佛科留斯 (Gérard de Vaucouleurs)提出的。", source: "CMRC 2018 · 佛科留斯系统" },
  { question: "哪些地区喜欢吃康氏马鲛？", category: "百科知识", answer: "闽南、台湾地区", explain: "台湾海域所产的马加鱼有六种：䲠鱼肉美刺少，含高蛋白质、低脂肪、矿物质、钙、磷、铁等，是闽南、台湾地区喜食的鱼类，尤其土托鱼羹更是有名的小吃。", source: "CMRC 2018 · 康氏马鲛" },
  { question: "哪个季节齿䲠的味道更好？", category: "百科知识", answer: "秋冬", explain: "本鱼为鲜美的食用鱼，尤以秋冬的味道更好，肉质细嫩，新鲜时可做成生鱼片、罐头、煮汤或盐烧。", source: "CMRC 2018 · 齿䲠" },
  { question: "哪里人称「好鱼马鲛、鲳，好菜芥蓝样，好戏苏六娘」？", category: "百科知识", answer: "潮州人", explain: "潮州人称「好鱼马鲛、鲳，好菜芥蓝样，好戏苏六娘」。", source: "CMRC 2018 · 银鲳" },
  { question: "哪一侧的建筑今天仍是法国海军部？", category: "百科知识", answer: "东侧", explain: "起初两座建筑均为作为政府机构，东侧的建筑今天仍是法国海军部，然而，西侧的建筑建成了豪华酒店，很快，王后玛丽·安托瓦内特和她的精英朋友就经常光顾此处。", source: "CMRC 2018 · 克里雍大饭店" },
  { question: "谁率兵包围主父宫殿，杀了公子章？", category: "百科知识", answer: "公子成和李兑", explain: "公子成和李兑率兵勤王，公子章逃跑，主父竟然接纳了公子章，公子成和李兑杀死公子章后，为了卸责，继续围困主父，主父因而饿死。", source: "CMRC 2018 · 沙丘之乱" },
  { question: "谁封朱慈烺为宋王？", category: "百科知识", answer: "李自成", explain: "崇祯十七年（1644年），李自成攻入北京，李邦华、史可法及姜曰广希望朱慈烺到南京监国，不久因北京外城被攻破而无结果。", source: "CMRC 2018 · 朱慈烺" },
  { question: "谁将仪銮殿改名为怀仁堂？", category: "百科知识", answer: "大总统袁世凯", explain: "1911年，中华民国成立后，大总统袁世凯将此楼改名为怀仁堂，并在此接见外宾、接受元旦朝贺。", source: "CMRC 2018 · 怀仁堂" },
  { question: "谁把《柳林风声》一口气读了3遍？", category: "百科知识", answer: "美国总统罗斯福", explain: "这本书曾经引起当时美国总统罗斯福的注意，他曾写信告诉作者，他把《柳林风声》一口气读了3遍。", source: "CMRC 2018 · 柳林风声" },
  { question: "谁称赞郑思肖是“民族意识浓烈的人”？", category: "百科知识", answer: "郭沫若", explain: "”郭沫若在抗日战争期间写的《国画中的民族意识》中，称赞郑思肖是“民族意识浓烈的人”。", source: "CMRC 2018 · 郑思肖" },
  { question: "哪首歌曲代表了谭咏麟入选了“香港20世纪十大金曲”？", category: "百科知识", answer: "雾之恋", explain: "《雾之恋》是香港歌手谭咏麟发行第七张粤语专辑，籍著上一年的专辑《春... 迟来的春天》的成功，谭咏麟开始在香港乐坛的前列歌手行列站稳阵脚。", source: "CMRC 2018 · 雾之恋" },
  { question: "谁在2008年斯诺克世界锦标赛中夺冠？", category: "百科知识", answer: "罗尼·奥沙利文", explain: "罗尼·奥沙利文在决赛中18比8战胜阿利斯特·卡特第3次夺冠。", source: "CMRC 2018 · 2008年斯诺克世界锦标赛" },
  { question: "哪位选手赢得了金牌？", category: "百科知识", answer: "南韩选手秦钟午", explain: "最终南韩选手秦钟午击败中国及俄罗斯选手夺得金牌。", source: "CMRC 2018 · 2008年夏季奥林匹克运动会射击比赛－男子50米手枪" },
  { question: "什么时候三乡镇合并组建江背镇？", category: "百科知识", answer: "1995年", explain: "今江背镇在1995年长沙地区撤区并乡镇之前属江背区（由五美区改名）江背镇、梅花乡和五美乡地域，1995年，三乡镇合并组建江背镇。", source: "CMRC 2018 · 江背镇 (长沙县)" },
  { question: "什么时候首次开始参加国家队的集训？", category: "百科知识", answer: "2005年", explain: "2005年首次开始参加国家队的集训，代表国家队参加了同哥斯达黎加的友谊赛表现不佳。", source: "CMRC 2018 · 矫喆" },
  { question: "谁第二次竞选自民党总裁以绝对优势胜出？", category: "百科知识", answer: "佐藤荣作", explain: "12月1日，佐藤荣作首相第二次竞选自民党总裁虽然以绝对优势胜出，但是比预计中多了不少的反对票告诫佐藤内阁必须为黑雾事件负责。", source: "CMRC 2018 · 黑雾解散" },
  { question: "什么时候和翌年三月初是五丝马鲅的盛产期？", category: "百科知识", answer: "秋末", explain: "秋末和翌年三月初为盛产期。", source: "CMRC 2018 · 五丝马鲅" },
  { question: "谁成为台湾第一位在欧洲女子冠军联赛出赛和进球的球员？", category: "百科知识", answer: "曾淑娥", explain: "曾淑娥（， ），是台湾女子足球运动员，她自2002年起代表中华台北女子足球代表队参加各项国际赛事。", source: "CMRC 2018 · 曾淑娥" },
  { question: "谁即位伊拉克王国成为了一个主权独立的国家？", category: "百科知识", answer: "费萨尔一世", explain: "始于1921年国王费萨尔一世即位，直到1958年被阿比德·阿尔·卡里姆·卡希姆所领导的血腥革命推翻。", source: "CMRC 2018 · 伊拉克王国" },
  { question: "哪半球的飓风顺时针旋转？", category: "百科知识", answer: "南半球", explain: "南半球的飓风则顺时针旋转，向东方或东南方运动。", source: "CMRC 2018 · 登陆 (气象学)" },
  { question: "哪个王朝又称加喜特巴比伦、巴比伦第三王朝？", category: "百科知识", answer: "加西特王朝", explain: "加西特王朝，是西亚两河流域古代王朝。", source: "CMRC 2018 · 加喜特人" },
  { question: "哪里收录了尚纯所写的绝句《咏双松》？", category: "百科知识", answer: "《中山诗文集》", explain: "《中山诗文集》收录了尚纯所写的绝句《咏双松》。", source: "CMRC 2018 · 尚纯" },
  { question: "哪一年武夷山崖墓群作为“武夷山史迹”的组成部分被列为福建省文物保护单位？", category: "百科知识", answer: "1985年", explain: "武夷山崖墓群位于中国福建省武夷山市武夷山风景名胜区九曲溪两岸和北山景区的悬崖岩洞、裂隙内，1985年作为“武夷山史迹”的组成部分被列为福建省文物保护单位，2006年被列为第六批全国重点文物保护单位。", source: "CMRC 2018 · 武夷山崖墓群" },
  { question: "小灰头稚冠雉属于哪一科?", category: "百科知识", answer: "凤冠雉科", explain: "小灰头稚冠雉（\"Ortalis vetula\"）是一种凤冠雉科的大型鸟类。", source: "CMRC 2018 · 小灰头稚冠雉" },
  { question: "主泣教堂位于什么地方?", category: "百科知识", answer: "橄榄山", explain: "主泣教堂（，又译为主哭耶京泣堂）是一个天主教教堂，位于橄榄山，正对着耶路撒冷老城。", source: "CMRC 2018 · 主哭耶京堂" },
  { question: "布洛涅森林属于什么机构管辖？", category: "百科知识", answer: "巴黎市政府", explain: "布洛涅森林，是法国巴黎城西边的一片森林，面积8.46平方公里，南北最长处3.5公里，东西最宽处2.6公里，属巴黎市政府管辖。", source: "CMRC 2018 · 布洛涅森林" },
  { question: "哪个香港艺人曾在２００９年寻求过生命热线的辅导？", category: "百科知识", answer: "崔建邦", explain: "陈志云的《志云情人节首选》于2010年2月7日在奥海城举行慈善义卖，部份收益拨捐生命热线，更透露2009年年底无线电视艺人崔建邦因涉嫌袭击绯闻女友嫩模邝敏慧而情绪受困扰，曾寻求生命热线辅导。", source: "CMRC 2018 · 生命热线" },
  { question: "中日韩统一收录的新加坡汉字字源名称是什么？", category: "百科知识", answer: "「GS」", explain: "中日韩统一表意文字扩展A区收有新加坡汉字226个，字源名称为「GS」。", source: "CMRC 2018 · 新加坡汉字" },
  { question: "河北省文物研究所位于什么地方？", category: "百科知识", answer: "石家庄市建华南大街82号", explain: "河北省文物研究所是中华人民共和国河北省最大的文物考古研究机构，位于石家庄市建华南大街82号。", source: "CMRC 2018 · 河北省文物研究所" },
  { question: "亚麻属于哪个属？", category: "百科知识", answer: "亚麻科亚麻属", explain: "亚麻（学名：\"\"）是亚麻科亚麻属一年生草本植物。", source: "CMRC 2018 · 亚麻" },
  { question: "科罗拉多河蟾蜍的毒腺位于什么地方？", category: "百科知识", answer: "眼下", explain: "蟾蜍的毒腺位于眼下，于嬉皮士的年代，有些嬉皮士为了寻求刺激而舔蟾蜍表皮的毒腺，以获得快感及迷幻的感觉。", source: "CMRC 2018 · 科罗拉多河蟾蜍" },
  { question: "象鼩属于哪个目？", category: "百科知识", answer: "象鼩目", explain: "象鼩是一类非洲原住的食虫哺乳动物，属于象鼩目（Macroscelidea）。", source: "CMRC 2018 · 象鼩" },
  { question: "真君庙位于什么地方？", category: "百科知识", answer: "新界青衣岛", explain: "真君庙是香港一所庙宇，位于新界青衣岛，供奉灵昭真君（俗称真君大帝）。", source: "CMRC 2018 · 真君庙" },
  { question: "灵昭真君的全称是什么？", category: "百科知识", answer: "灵昭威显佑境安民真君", explain: "灵昭真君，全称灵昭威显佑境安民真君。", source: "CMRC 2018 · 灵昭真君" },
  { question: "永平省属于哪个国家？", category: "百科知识", answer: "越南共和国", explain: "永平省（）是越南共和国南部湄公河三角洲的一个省，范围大约相等于今日茶荣省和永隆省东部。", source: "CMRC 2018 · 永平省" },
  { question: "布雷西亚足球俱乐部属于哪个国家？", category: "百科知识", answer: "意大利", explain: "布雷西亚足球俱乐部（Brescia Calcio），是一家意大利布雷西亚市的足球俱乐部，成立于1911年。", source: "CMRC 2018 · 布雷西亚足球俱乐部" },
  { question: "1982年布雷西亚足球队属于哪一级？", category: "百科知识", answer: "丙级", explain: "1982年球队降入丙级，直到1985年才回到乙级。", source: "CMRC 2018 · 布雷西亚足球俱乐部" },
  { question: "澉浦镇隶属于什么地方？", category: "百科知识", answer: "浙江省嘉兴市海盐县", explain: "澉浦镇是隶属于浙江省嘉兴市海盐县的一个镇，位于该县县境南部，西与海宁县接壤。", source: "CMRC 2018 · 澉浦镇" },
  { question: "乍浦镇开发了什么作为嘉兴市城市体系的组成部分？", category: "百科知识", answer: "滨海新城", explain: "乍浦镇也开发滨海新城，作为嘉兴市城市体系“一主、五副、一新城”的组成部分。", source: "CMRC 2018 · 乍浦镇" },
  { question: "斯韦阿兰属于哪个国家？", category: "百科知识", answer: "瑞典", explain: "斯韦阿兰（）是瑞典历史发展的核心地区，位于瑞典中南部。", source: "CMRC 2018 · 斯韦阿兰" },
  { question: "在19世纪初，威姆兰隶属于哪里？", category: "百科知识", answer: "斯韦阿法院", explain: "在19世纪初，威姆兰隶属于斯韦阿法院。", source: "CMRC 2018 · 斯韦阿兰" },
  { question: "涞滩镇隶属于哪个城市？", category: "百科知识", answer: "重庆市", explain: "涞滩镇，中国重庆市合川区下属的一个镇，面积70.99平方公里，下辖19个村委会、3个居委会，总人口13011人（2000年）。", source: "CMRC 2018 · 涞滩镇" },
  { question: "武藏浦和站隶属于什么公司？", category: "百科知识", answer: "东日本旅客铁道（JR东日本）", explain: "武藏浦和站（）是一个位于埼玉县埼玉市南区七丁目，属于东日本旅客铁道（JR东日本）的铁路车站。", source: "CMRC 2018 · 武藏浦和站" },
  { question: "武藏浦和站位于哪里？", category: "百科知识", answer: "埼玉县埼玉市南区七丁目", explain: "武藏浦和站（）是一个位于埼玉县埼玉市南区七丁目，属于东日本旅客铁道（JR东日本）的铁路车站。", source: "CMRC 2018 · 武藏浦和站" },
  { question: "松鸦属于什么科目？", category: "百科知识", answer: "鸦科", explain: "松鸦（学名：），又名㭴鸟、橿鸟，是一种分布极广泛的鸦科动物，包括西欧大部分地区，至非洲的东北部，以至亚洲的东海岸以及东南亚等地均有分内。", source: "CMRC 2018 · 松鸦" },
  { question: "曾伟明曾就读位于深井的哪所小学？", category: "百科知识", answer: "深井的灵光小学。", explain: "他曾就读位于深井的灵光小学。小时候在村内跟团练教头学打棍功夫或到附近啤油厂饮啤酒和沙滩游水。", source: "CMRC 2018 · 曾伟明" },
  { question: "元朗千色汇位于哪里？", category: "百科知识", answer: "香港元朗教育路1号", explain: "元朗千色汇（），2015年3月前称千色广场（），是一座位于香港元朗教育路1号的中型零售购物，于1994年落成。", source: "CMRC 2018 · 元朗千色汇" },
  { question: "印度空间研究组织的总部位于哪里？", category: "百科知识", answer: "印度班加罗尔", explain: "印度空间研究组织（，缩写：，，缩写：）是印度的国家航天机构，创建于1972年，总部位于印度班加罗尔，雇佣约2万名员工，主要从事与航天和空间科学有关的研究。", source: "CMRC 2018 · 印度空间研究组织" },
  { question: "侏罗纪海岸位于哪个海峡？", category: "百科知识", answer: "英吉利海峡", explain: "侏罗纪海岸（Jurassic Coast）位于英国南部英吉利海峡，从东德文埃克斯茅斯奥科姆岩石群一直延伸到东多塞特斯沃尼奇老哈里巨石，总长153千米。", source: "CMRC 2018 · 侏罗纪海岸" },
  { question: "扬子克拉通范围包括哪些？", category: "百科知识", answer: "今日的长江中下游、中国西南部", explain: "扬子克拉通，又名扬子陆块、华南陆块、华南克拉通，是个史前大陆或克拉通，目前是华南板块的一部分，范围包含今日的长江中下游、中国西南部。", source: "CMRC 2018 · 扬子克拉通" },
  { question: "矢井田瞳属于哪个唱片公司？", category: "百科知识", answer: "青空唱片", explain: "所属的唱片公司是青空唱片（2000年至2005年以前是EMI唱片所属，05年11月重返青空唱片）。", source: "CMRC 2018 · 矢井田瞳" },
  { question: "新西兰鸲鹟属于什么科目？", category: "百科知识", answer: "新西兰鸲鹟科", explain: "新西兰鸲鹟（\"Petroica australis longipes\"）是新西兰鸲鹟科的一种，原住在北岛。", source: "CMRC 2018 · 新西兰鸲鹟" },
  { question: "岩手宫城内陆地震的震中央位于哪里？", category: "百科知识", answer: "岩手县奥州市和宫城县栗原市", explain: "岩手宫城内陆地震发生于2008年6月14日日本当地时间8时43分（协调世界时23时43分），震央位于岩手县奥州市和宫城县栗原市，即距离岩手县县厅盛冈市西南60公里。", source: "CMRC 2018 · 岩手宫城内陆地震" },
  { question: "龙烟铁路位于哪里？", category: "百科知识", answer: "胶东半岛北侧海岸", explain: "龙烟铁路位于胶东半岛北侧海岸。", source: "CMRC 2018 · 龙烟铁路" },
  { question: "龙烟铁路是哪条铁路的重要组成部分？", category: "百科知识", answer: "德龙烟铁路", explain: "西起大莱龙铁路龙口西站，东至蓝烟铁路珠玑站，是德龙烟铁路的重要组成部分，正线全长112.7公里。", source: "CMRC 2018 · 龙烟铁路" },
  { question: "赫哲诸语言除了赫哲语还包括哪些语言？", category: "百科知识", answer: "奇勒恩语、奥罗克语和乌尔奇语", explain: "赫哲诸语言还包括奇勒恩语、奥罗克语和乌尔奇语。", source: "CMRC 2018 · 赫哲语" },
  { question: "「香港四大才子」是指哪四位？", category: "百科知识", answer: "金庸、倪匡、黄霑和蔡澜", explain: "「香港四大才子」，又称香江四大才子，是指香港四位文人，分别为金庸、倪匡、黄霑和蔡澜，四人各有所长，皆是腹中饱有学问之辈，而且分属好友，因而被称为「香港四大才子」。", source: "CMRC 2018 · 香港四大才子" },
  { question: "凤凰队的主场位于哪里？", category: "百科知识", answer: "威灵顿", explain: "威灵顿凤凰足球俱乐部（英文：Wellington Phoenix FC）是纽西兰威灵顿的一支职业足球队。", source: "CMRC 2018 · 威灵顿凤凰足球俱乐部" },
  { question: "隐面龙属属于什么科？", category: "百科知识", answer: "兽脚亚目阿贝力龙科", explain: "隐面龙属（学名：\"Kryptops\"）又译隐脸龙，属于兽脚亚目阿贝力龙科，生存于白垩纪早期。", source: "CMRC 2018 · 隐面龙属" },
  { question: "秦朝时期成纪县属于哪一郡？", category: "百科知识", answer: "陇西郡", explain: "成纪在战国时便设县，秦朝统一时属于陇西郡，县址大约在今天天水市秦安县西北叶堡川。", source: "CMRC 2018 · 成纪县" },
  { question: "当惹雍错位于哪里？", category: "百科知识", answer: "中国西藏那曲地区尼玛县", explain: "当惹雍错（），又名唐古拉雍木错，是一个咸水湖，位于中国西藏那曲地区尼玛县，冈底斯山脉中段北麓断陷盆地内。", source: "CMRC 2018 · 当惹雍错" },
  { question: "羗山道位于香港什么地方？", category: "百科知识", answer: "香港新界大屿山", explain: "羗山道（），又作羌山道，是香港新界大屿山一条道路，连接石壁及羗山，东南端连接屿南道，西北端连接大澳道，长达4.5公里。", source: "CMRC 2018 · 羗山道" },
  { question: "魏斯可金融公司总部位于哪里？", category: "百科知识", answer: "加尼福尼亚州帕萨迪纳", explain: "魏斯可金融公司是一家总部位于加尼福尼亚州帕萨迪纳的多元化金融企业。", source: "CMRC 2018 · 魏斯可金融公司" },
  { question: "宝山镇位于哪个省？", category: "百科知识", answer: "中国辽宁省", explain: "宝山镇 是中国辽宁省凤城市下辖的一个镇。", source: "CMRC 2018 · 宝山镇 (凤城市)" },
  { question: "1779年，佛蒙特州位于东部的县城是什么？", category: "百科知识", answer: "坎伯兰县", explain: "当时，位于西部的县为本宁顿县，而位于东部的县则为坎伯兰县。", source: "CMRC 2018 · 佛蒙特州行政区划" },
  { question: "固始站隶属于什么公司？", category: "百科知识", answer: "武汉铁路局", explain: "固始站是宁西铁路上的一座车站，位于河南省固始县段集镇，隶属于武汉铁路局，现为三等站。", source: "CMRC 2018 · 固始站" },
  { question: "固始站位于哪里？", category: "百科知识", answer: "河南省固始县段集镇", explain: "固始站是宁西铁路上的一座车站，位于河南省固始县段集镇，隶属于武汉铁路局，现为三等站。", source: "CMRC 2018 · 固始站" },
  { question: "海翠花园属于哪家物业管理？", category: "百科知识", answer: "轻铁屯门码头站上盖", explain: "海翠花园（）为香港新界屯门湖翠路168-236号的私人屋苑，属轻铁屯门码头站上盖物业，共有6座楼高32层楼宇，合共提供1440伙单位，于1988年8月入-{伙}-。", source: "CMRC 2018 · 海翠花园" },
  { question: "日月光名称命名来自于谁？", category: "百科知识", answer: "星云法师", explain: "张姚宏影为星云法师弟子，日月光名称由星云法师命名：星云大师觉得电和光代表快、代表速度，可以照耀万千人，可以永久、可以大，取名「日月光」。", source: "CMRC 2018 · 日月光半导体" },
  { question: "中文广播在1997年以前的电台名称叫什么？", category: "百科知识", answer: "多伦多广播电台", explain: "待1997年由新时代传媒集团收购后才改以中文广播，当时电台的名称叫作「多伦多广播电台」。", source: "CMRC 2018 · 加拿大中文电台" },
  { question: "日落大属于哪个国家？", category: "百科知识", answer: "美国", explain: "日落大道（）是美国洛杉矶的一条道路，从洛杉矶市中心延伸到太平洋海岸公路，长约35公里。", source: "CMRC 2018 · 日落大道" },
  { question: "诺丁汉郡隶属于哪个国家？", category: "百科知识", answer: "英国", explain: "诺定咸郡（，英文简称：Notts），英国英格兰东密德兰的郡。", source: "CMRC 2018 · 诺丁汉郡" },
  { question: "西米德兰兹郡位于哪个国家？", category: "百科知识", answer: "英国", explain: "西密德兰郡（），英国英格兰西密德兰区域的郡，范围像举起拇指的拳头向右卧。", source: "CMRC 2018 · 西米德兰兹郡" },
  { question: "鄂罗克人的语言属于什么语族？", category: "百科知识", answer: "通古斯语族", explain: "鄂罗克人 (，自称：ульта，ulta，ulcha）是居住在库页岛东边的一个小族群，今属俄罗斯联邦萨哈林州管辖，语言属于阿尔泰语系通古斯语族，无文字。", source: "CMRC 2018 · 鄂罗克人" },
  { question: "意大利大道属于哪个国家？", category: "百科知识", answer: "法国", explain: "它得名于法国革命前不久的1783年建于此处的意大利剧院（现在的巴黎喜剧院）。", source: "CMRC 2018 · 意大利大道" },
  { question: "鄂温人的语言属于哪个语族？", category: "百科知识", answer: "通古斯语族", explain: "鄂温人的语言鄂温语属于阿尔泰语系的通古斯语族。", source: "CMRC 2018 · 鄂温人" },
  { question: "大麦地遗址属于哪个时期？", category: "百科知识", answer: "旧石器时代", explain: "在大麦地遗址发现了诸多旧石器时代的痕迹。", source: "CMRC 2018 · 大麦地文化" },
  { question: "玖岛城位于什么地方？", category: "百科知识", answer: "长崎县大村市玖岛", explain: "玖岛城是日式的城堡，坐落于长崎县大村市玖岛。", source: "CMRC 2018 · 玖岛城" },
  { question: "克利希广场位于哪个国家？", category: "百科知识", answer: "法国", explain: "克利希广场（Place de Clichy）是法国巴黎的一个广场，位于市区西北部，坐落在古城墙上的克利希屏障旧址。", source: "CMRC 2018 · 克利希广场" },
  { question: "西土城站有1个岛式站台，位于什么地方？", category: "百科知识", answer: "知春路-北土城西路地底", explain: "10号线西土城站设有1个岛式站台，位于知春路-北土城西路地底。", source: "CMRC 2018 · 西土城站 (北京市)" },
  { question: "龙山国小的全称是什么？", category: "百科知识", answer: "台北市万华区龙山国民小学", explain: "台北市万华区龙山国民小学，简称龙山国小，是台湾台北市万华区的市立小学。", source: "CMRC 2018 · 台北市万华区龙山国民小学" },
  { question: "《三遂平妖传》的全称是什么？", category: "百科知识", answer: "《北宋三遂平妖传》", explain: "《三遂平妖传》全称《北宋三遂平妖传》，又名《新平妖传》，明朝罗贯中所著，是中国小说史上第一部长篇神魔小说。", source: "CMRC 2018 · 三遂平妖传" },
  { question: "《长眠不醒》属于什么派系的侦探小说？", category: "百科知识", answer: "冷硬派", explain: "这是首本以菲利普·马罗（Philip Marlowe）为主角的小说，并被认为是钱德勒最杰出的作品之一，并被认为是冷硬派（hard boiled）的侦探小说代表作品。", source: "CMRC 2018 · 大眠" },
  { question: "纽康的太阳表包括哪些年限的星历表？", category: "百科知识", answer: "从1900年至1983年间", explain: "纽康的太阳表是从1900年至1983年间所有出版的星历表，包括美国海军天文台和格林威治皇家天文台年历的依据。", source: "CMRC 2018 · 纽康的太阳表" },
  { question: "葵扇之乡是指哪里？", category: "百科知识", answer: "广东新会", explain: "广东新会有「葵扇之乡」之称，其出产的葵扇行销国内外。", source: "CMRC 2018 · 葵扇" },
  { question: "长鼻王是什么东西的名称？", category: "百科知识", answer: "一种膨化夹心卷的商标名", explain: "长鼻王是一种膨化夹心卷的商标名，它由台商合资的嘉兴长鼻王食品有限公司生产，台商合资杭州大恩食品有限公司经销。", source: "CMRC 2018 · 长鼻王" },
  { question: "阿贝歇属于哪个国家？", category: "百科知识", answer: "乍得", explain: "阿贝歇（法语：、）是乍得第四大城市，也是瓦达伊区的首府，人口78,191人（2008年）。", source: "CMRC 2018 · 阿贝歇" },
  { question: "谢尔吉耶夫镇位于哪里？", category: "百科知识", answer: "俄罗斯莫斯科州东北部", explain: "谢尔吉耶夫镇 （）是俄罗斯莫斯科州东北部的一个城市，著名的金环古城之一。", source: "CMRC 2018 · 谢尔吉耶夫镇" },
  { question: "相武台下车站属于哪个公司？", category: "百科知识", answer: "东日本旅客铁道（JR东日本）", explain: "相武台下车站（）是一由东日本旅客铁道（JR东日本）所经营的铁路车站，位于日本神奈川县相模原市新户，是JR东日本相模线沿线的车站。", source: "CMRC 2018 · 相武台下车站" },
  { question: "钝头鹦嘴鱼属于哪一科？", category: "百科知识", answer: "鹦哥鱼科", explain: "钝头鹦嘴鱼，又名红紫鹦哥鱼，俗名红鹦哥、红衣、青衫（雄）、红海蜇（雌）、红黑落（雌），为辐鳍鱼纲鲈形目隆头鱼亚目鹦哥鱼科的其中一种。", source: "CMRC 2018 · 钝头鹦嘴鱼" },
  { question: "《1997年郡尉职权法案》属于哪个机构？", category: "百科知识", answer: "英国国会", explain: "《1997年郡尉职权法案》（）于1997年生效，是一项英国国会法案，来厘订大不列颠委任的郡尉（Lord Lieutenant）所管辖的地区。", source: "CMRC 2018 · 1997年郡尉职权法案" },
  { question: "哪个球队是第一个使用拉里·伯德条款的球队？", category: "百科知识", answer: "波士顿凯尔特人", explain: "此条款是NBA在1984年时期，当时波士顿凯尔特人的球员拉里·伯德（）合约期满成为自由球员，波士顿凯尔特人为了留下这位球队超级巨星，成为在NBA第一个使用此条款的队伍。", source: "CMRC 2018 · 拉里·伯德条款" },
  { question: "阿瓦隆尼亚大陆名称来自于哪里？", category: "百科知识", answer: "阿瓦隆半岛", explain: "其名称来自于加拿大纽芬兰省东南部的阿瓦隆半岛。", source: "CMRC 2018 · 阿瓦隆尼亚大陆" },
  { question: "结头龙属属于什么龙科？", category: "百科知识", answer: "厚头龙科", explain: "结头龙属（学名：\"Colepiocephale\"）是厚头龙科恐龙的一属。", source: "CMRC 2018 · 结头龙属" },
  { question: "巴林国际机场位于什么省份？", category: "百科知识", answer: "穆哈拉格省", explain: "穆哈拉格省（阿拉伯文：）是巴林王国的四个省份之一，位于穆哈拉格岛上，省会为同名城市穆哈拉格，巴林国际机场亦位于该省。", source: "CMRC 2018 · 穆哈拉格省" },
  { question: "德班国际机场位于那个城市？", category: "百科知识", answer: "南非德班", explain: "），前称路易博塔机场，位于南非德班。", source: "CMRC 2018 · 德班国际机场" },
  { question: "黑龙江省大兴安岭林业集团公司隶属于哪个机构？", category: "百科知识", answer: "中华人民共和国国家林业局。", explain: "黑龙江省大兴安岭林业集团公司暨黑龙江大兴安岭林业管理局，是中国首批57家试点企业集团之一，隶属于中华人民共和国国家林业局。其上级不是黑龙江省。", source: "CMRC 2018 · 黑龙江省大兴安岭林业集团公司" },
  { question: "南雅镇位于什么地方？", category: "百科知识", answer: "中国福建省南平市建瓯市南部", explain: "南雅镇是中国福建省南平市建瓯市南部的一个镇，位于建溪中游，与延平区及顺昌县相邻。", source: "CMRC 2018 · 南雅镇 (建瓯市)" },
  { question: "彩荣路位于什么地方？", category: "百科知识", answer: "香港九龙观塘区平山", explain: "彩荣路（），是一条位于香港九龙观塘区平山的两线双向行车道路。", source: "CMRC 2018 · 彩荣路" },
  { question: "小洋山位于哪里？", category: "百科知识", answer: "浙江省舟山群岛和嵊泗县内", explain: "小洋山是浙江省舟山群岛和嵊泗县内的一个重要岛屿。", source: "CMRC 2018 · 小洋山" },
  { question: "福知山藩位于什么地方？", category: "百科知识", answer: "日本丹波国天田郡", explain: "福知山藩是位于日本丹波国天田郡的一个藩，藩厅位于福知山城（京都府福知山市）1600年，从属东军的有马丰氏由远江横须贺藩的3万石移封至福知山6万石。", source: "CMRC 2018 · 福知山藩" },
  { question: "丹北镇位于什么地方？", category: "百科知识", answer: "江苏省丹阳市老北门外", explain: "丹北镇是江苏省丹阳市老北门外的一中心镇，2014年由原来的埤城镇、后巷镇、新桥镇合并成立。", source: "CMRC 2018 · 丹北镇" },
  { question: "陈中和墓位于什么地方？", category: "百科知识", answer: "台湾高雄市苓雅区", explain: "陈中和墓位于台湾高雄市苓雅区，于民国八十五年（1996年）8月27日公告为古迹。", source: "CMRC 2018 · 陈中和墓" },
  { question: "在澳大利亚从属于宗教机构的独立学校占比多少？", category: "百科知识", answer: "超过85%", explain: "在澳大利亚，独立学校这个术语也可与私立学校交替使用，独立学校是增长最快的教育部门，其中超过85%都从属于宗教机构。", source: "CMRC 2018 · 独立学校" },
  { question: "梳邦位于哪里？", category: "百科知识", answer: "马来西亚雪兰莪州八打灵县", explain: "梳邦（）是马来西亚雪兰莪州八打灵县的一个市郊，行政上隶属于莎亚南市政厅（MBAS）。", source: "CMRC 2018 · 梳邦" },
  { question: "梳邦在行政上属于哪里？", category: "百科知识", answer: "莎亚南市政厅（MBAS）", explain: "梳邦（）是马来西亚雪兰莪州八打灵县的一个市郊，行政上隶属于莎亚南市政厅（MBAS）。", source: "CMRC 2018 · 梳邦" },
  { question: "单系群A和单系群B可以组成一个独立的什么？", category: "百科知识", answer: "一个单系群单元D", explain: "A和B也可以组成一个单系群单元D，此时这个单元D就是C的旁系群，反之亦然……，以此类推，用以概括更远的旁系群。", source: "CMRC 2018 · 旁系群" },
  { question: "越南泰族的语言属于哪个语群？", category: "百科知识", answer: "侗台语族台语支西南语群", explain: "越南泰族的语言和前面提到的几个民族的语言都属于侗台语族台语支西南语群。", source: "CMRC 2018 · 泰族 (越南)" },
  { question: "赫蒙族属于哪个少数民族的分支？", category: "百科知识", answer: "苗族", explain: "赫蒙族（Hmong）是苗族的一个分支，在越南被划为分53个法定少数民族之一。", source: "CMRC 2018 · 赫蒙族" },
  { question: "鼠尾草属属于哪个科目？", category: "百科知识", answer: "唇形科", explain: "鼠尾草属是唇形科下最大的一个属，包括大约1000种植物，广泛分布在全球各地的温带和热带地区，既有草本也有灌木或亚灌木，大多数品种集中在亚洲。", source: "CMRC 2018 · 鼠尾草属" },
  { question: "南挪威这个名称与观念是谁提出的？", category: "百科知识", answer: "当地作家威尔海姆·克拉格", explain: "南挪威大致上是历史上阿格德尔（）王国的领地，1902年，由当地作家威尔海姆·克拉格（）提出南挪威这个名称与观念，在这之前，这个区域被视为是西挪威的一部份。", source: "CMRC 2018 · 南挪威" },
  { question: "在南挪威这个名称提出之前此地归属于哪里？", category: "百科知识", answer: "西挪威", explain: "南挪威大致上是历史上阿格德尔（）王国的领地，1902年，由当地作家威尔海姆·克拉格（）提出南挪威这个名称与观念，在这之前，这个区域被视为是西挪威的一部份。", source: "CMRC 2018 · 南挪威" },
  { question: "花卷机场车站位于哪里？", category: "百科知识", answer: "日本岩手县花卷市二枚桥", explain: "花卷机场车站（）是一由东日本旅客铁道（JR东日本）与日本货物铁道（JR货物）所共用的铁路车站，位于日本岩手县花卷市二枚桥。", source: "CMRC 2018 · 花卷机场车站" },
  { question: "盐肤木属属于哪一科？", category: "百科知识", answer: "漆树科", explain: "盐肤木属（学名：\"\"），是漆树科中的一个属，包括有250余种，广泛分布在全球亚热带和温带地区。", source: "CMRC 2018 · 盐肤木属" },
  { question: "盐肤木属包括多少物种？", category: "百科知识", answer: "250余种", explain: "盐肤木属（学名：\"\"），是漆树科中的一个属，包括有250余种，广泛分布在全球亚热带和温带地区。", source: "CMRC 2018 · 盐肤木属" },
  { question: "未婚怀孕是指什么情况？", category: "百科知识", answer: "女性在未有结婚的情况下怀孕", explain: "未婚怀孕，是女性在未有结婚的情况下怀孕。", source: "CMRC 2018 · 未婚怀孕" },
  { question: "咨商关系包括哪两个主体？", category: "百科知识", answer: "当事人与咨商心理师", explain: "咨商关系包括当事人与咨商心理师两个主体，是一种刻意营造的人际关系，不同于其他种类的人际关系，咨商关系的相互性系以当事人的最佳权益为优先的考量。", source: "CMRC 2018 · 咨商关系" },
  { question: "红脚鲣鸟是属于哪个科的物种？", category: "百科知识", answer: "鲣鸟科", explain: "红脚鲣鸟（学名：\"\"）是鲣鸟科下的一种大型海鸟。", source: "CMRC 2018 · 红脚鲣鸟" },
  { question: "武汉长江隧道位于哪两座大桥之间？", category: "百科知识", answer: "武汉市长江一桥和长江二桥", explain: "武汉长江隧道位于湖北省武汉市长江一桥和长江二桥之间，设计为左右两条单洞式隧道，隧道为单向两车道。", source: "CMRC 2018 · 武汉长江隧道" },
  { question: "白鹤洞街道位于什么地方？", category: "百科知识", answer: "中国广东省广州市荔湾区", explain: "白鹤洞街道是中国广东省广州市荔湾区下辖的一个街道（旧属芳村区），位于荔湾区南部（广州市西南部）。", source: "CMRC 2018 · 白鹤洞街道" },
  { question: "浙江春晖中学位于何地？", category: "百科知识", answer: "浙江省绍兴市上虞区白马湖畔", explain: "浙江春晖中学位于浙江省绍兴市上虞区白马湖畔，为浙江省一级重点中学。", source: "CMRC 2018 · 浙江春晖中学" },
  { question: "京岘山位于何地？", category: "百科知识", answer: "江苏省镇江市市区东南郊", explain: "京岘山位于江苏省镇江市市区东南郊，山高300米左右，受爆破采石以及市区拓宽影响，现已被铲平为新区的一部分。", source: "CMRC 2018 · 京岘山" },
  { question: "客气是指什么气？", category: "百科知识", answer: "在天的三阴三阳之气", explain: "客气即是在天的三阴三阳之气，因其运动不息，犹如客之往来，故称客气。", source: "CMRC 2018 · 五运六气" },
  { question: "初期恒星体是指什么样的天体？", category: "百科知识", answer: "进入恒星演化早期阶段", explain: "初期恒星体 (YSO)表示是一颗进入恒星演化早期阶段的天体。", source: "CMRC 2018 · 初期恒星体" },
  { question: "氏叔琮最初隶属于谁的部队？", category: "百科知识", answer: "庞师古", explain: "唐代中和末年，应募为骑军，最早隶属于庞师古，担任伍长，为人壮勇沈毅，胆力过人。", source: "CMRC 2018 · 氏叔琮" },
  { question: "都兰山位于何地？", category: "百科知识", answer: "台湾台东县东河乡", explain: "都兰山位于台湾台东县东河乡，为卑南族人心目中的圣山，同时也是目前台湾正向联合国申请世界文化遗产的项目之一。", source: "CMRC 2018 · 都兰山" },
  { question: "东山街道位于何地？", category: "百科知识", answer: "中国广东省广州市越秀区", explain: "东山街道是中国广东省广州市越秀区下辖的一个街道。", source: "CMRC 2018 · 东山街道 (广州市)" },
  { question: "HVC 127-41-330是由什么组成的云团？", category: "百科知识", answer: "气态氢和宇宙微粒", explain: "HVC 127-41-330 一个由气态氢和宇宙微粒组成的黑色云团，HVC指的是高速气体云，这是第一次发现这种暗星系。", source: "CMRC 2018 · HVC 127-41-330" },
  { question: "HVC是指什么？", category: "百科知识", answer: "高速气体云", explain: "HVC 127-41-330 一个由气态氢和宇宙微粒组成的黑色云团，HVC指的是高速气体云，这是第一次发现这种暗星系。", source: "CMRC 2018 · HVC 127-41-330" },
  { question: "利府车站位于谁的管辖范围内？", category: "百科知识", answer: "JR东日本仙台支社", explain: "利府是JR东日本东北本线利府支线的终点站，管辖上位于JR东日本仙台支社的范围之内，由岩切车站管理，设有绿窗口（）。", source: "CMRC 2018 · 利府车站" },
  { question: "陶街位于何地？", category: "百科知识", answer: "中国广州市越秀区", explain: "陶街，是中国广州市越秀区一条著名的街道。", source: "CMRC 2018 · 陶街" },
  { question: "经脉在中医学中属于什么类别？", category: "百科知识", answer: "经络", explain: "经脉是中医学中经络的一种。", source: "CMRC 2018 · 经脉" },
  { question: "工业技术研究院产业学院位于什么地方？", category: "百科知识", answer: "台湾新竹县竹东镇", explain: "工研院产业学院（简称产业学院，英文简写：ITRI College）位于台湾新竹县竹东镇，是工业技术研究院衔接研究发展与研发服务的新模式。", source: "CMRC 2018 · 工业技术研究院产业学院" },
  { question: "紫城镇位于何地？", category: "百科知识", answer: "中国广东省河源市紫金县", explain: "紫城镇是中国广东省河源市紫金县下辖的一个镇，位于紫金县中部，2009年7月经省政府批准由原紫城、乌石、附城三镇合并而成。", source: "CMRC 2018 · 紫城镇" },
  { question: "北京经济技术开发区位于何地？", category: "百科知识", answer: "北京市大兴区亦庄地区附近", explain: "北京经济技术开发区，或被称为亦庄开发区，（英文缩写，全称为），位于北京市大兴区亦庄地区附近，临近南五环和京津塘高速公路，是中国国家级经济技术开发区之一。", source: "CMRC 2018 · 北京经济技术开发区" },
  { question: "长流村位于什么地方？", category: "百科知识", answer: "台湾南投县", explain: "长流村，为台湾南投县之村落，位在国姓市区北方，行政区划划分为国姓乡，今称水长流，旧称写法甚多：水冇流、水无流、水波流或水无楼。", source: "CMRC 2018 · 长流村 (台湾)" },
  { question: "哪条是利根川支流中最长的河川？", category: "百科知识", answer: "鬼怒川", explain: "鬼怒川（）是日本关东北部的一条河川，发源于栃木县日光市的鬼怒沼，于茨城县守谷市与利根川合流，全长176.7公里，流域面积达1760平方公里，为利根川支流中最长的河川，日本政府指定为一级河川管理。", source: "CMRC 2018 · 鬼怒川" },
  { question: "什么是扩大和开发新市场，提供新的功能的有力方法？", category: "百科知识", answer: "破坏性创新", explain: "破坏性创新(英文：Disruptive innovation)，亦被称作破坏性科技、突破性创新，是指将产品或服务透过科技性的创新，并以低价特色针对特殊目标消费族群，突破现有市场所能预期的消费改变。", source: "CMRC 2018 · 破坏性创新" },
  { question: "航空公司基地位于何地？", category: "百科知识", answer: "吉布提国际机场", explain: "航空公司基地位于吉布提国际机场。", source: "CMRC 2018 · 吉布提航空" },
  { question: "史莱姆的第一个家创办人的网路名称叫什么？", category: "百科知识", answer: "史莱姆", explain: "「史莱姆的第一个家」正式创立于1997年，是台湾的一个知名网站，现以提供合法免费资源为网站功能。", source: "CMRC 2018 · 史莱姆的第一个家" },
  { question: "米拉加亚龙属属于什么年代？", category: "百科知识", answer: "侏罗纪晚期", explain: "米拉加亚龙属（学名：\"Miragaia\"）是种剑龙下目恐龙，化石发现于葡萄牙，年代属于侏罗纪晚期。", source: "CMRC 2018 · 米拉加亚龙属" },
  { question: "蒙田大街现在的名称得名于谁？", category: "百科知识", answer: "法国文艺复兴作家蒙田", explain: "这条街现在的名称得名于法国文艺复兴作家蒙田。", source: "CMRC 2018 · 蒙田大街" },
  { question: "莱德岛战役可能发生于哪一年？", category: "百科知识", answer: "公元前201年", explain: "莱德岛战役（Battle of Lade），可能发生在公元前201年，是马其顿王国舰队与罗德岛舰队在克里特战争中的一场海战。", source: "CMRC 2018 · 莱德岛战役 (前201年)" },
  { question: "叶齿鳄属于哪一亚目？", category: "百科知识", answer: "喙头鳄亚目", explain: "叶齿鳄（学名：\"Phyllodontosuchus\"）是种原始鳄形类动物，属于喙头鳄亚目。", source: "CMRC 2018 · 叶齿鳄" },
  { question: "贫齿鳄的化石是属于哪一个年代的？", category: "百科知识", answer: "属于白垩纪早期", explain: "贫齿鳄（学名：\"Edentosuchus\"）是种已灭绝鳄类，属于鳄形超目的原鳄亚目，化石发现于中国新疆准噶尔盆地的吐谷鲁群，年代属于白垩纪早期。", source: "CMRC 2018 · 贫齿鳄" },
  { question: "裂头鳄属于哪一亚目？", category: "百科知识", answer: "喙头鳄亚目", explain: "裂头鳄属（学名：\"Dibothrosuchus\"）是种原始鳄形类，属于喙头鳄亚目。", source: "CMRC 2018 · 裂头鳄属" },
  { question: "日本的首都圈是指什么？", category: "百科知识", answer: "以首都东京为中心的都会区", explain: "日本的首都圈（），指的是以首都东京为中心的都会区，也称东京圈（）或东京都市圈（）。", source: "CMRC 2018 · 首都圈 (日本)" },
  { question: "哪一年查令村的埃莉诺十字被下令拆除？", category: "百科知识", answer: "1647年", explain: "查令村的埃莉诺十字在1647年英国内战中被革命派的议会政府下令拆毁，直至王室复辟后的1675年，一座被保皇党保护下来的查理一世骑马铜像被放置在原来埃莉诺十字的位置上，直至今日。", source: "CMRC 2018 · 查令十字" },
  { question: "中国政法大学弑师案发生于什么时候？", category: "百科知识", answer: "2008年10月28日晚", explain: "中国政法大学弑师案，是指2008年10月28日晚发生在中国政法大学的一场由于师生恋而引发的血腥惨案。", source: "CMRC 2018 · 中国政法大学弑师案" },
  { question: "天主教巴黎总教会位于哪里？", category: "百科知识", answer: "法国首都巴黎", explain: "）是天主教会在法国设立的23个总教区之一，位于法国首都巴黎。", source: "CMRC 2018 · 天主教巴黎总教区" },
  { question: "太平洋大学最初是属于哪里的？", category: "百科知识", answer: "循道教会", explain: "最初属于循道教会，1858年成立医学院，之后医学院并入斯坦福，现在是加州太平洋医学中心（California Pacific Medical Center）。", source: "CMRC 2018 · 太平洋大学" },
  { question: "塔武连特山国家公园包括什么？", category: "百科知识", answer: "绵延宽阔的塔武连特山", explain: "塔武连特山国家公园（）坐落于西班牙加那利群岛拉帕尔马岛，包括绵延宽阔的塔武连特山，该山为占据了岛的北部的一个大型火山。", source: "CMRC 2018 · 塔武连特山国家公园" },
  { question: "伦敦奥林匹克体育场位于哪里？", category: "百科知识", answer: "伊丽莎白女王奥运园", explain: "位于伊丽莎白女王奥运园的体育场（） 是一座位于英国伦敦斯特拉特福地区的体育场 ，通称“奥林匹克体育场”（），中文俗称“伦敦碗”。", source: "CMRC 2018 · 伦敦奥林匹克体育场" },
  { question: "哪一年蒂芙尼公司在纽约市成立", category: "百科知识", answer: "1837年", explain: "1837年，蒂芙尼公司由和泰迪·杨在纽约市成立，开始时名称为蒂芙尼和杨（Tiffany & Young），商店设在下曼哈顿区，是一间专门销售时尚商品的精品店。", source: "CMRC 2018 · 蒂芙尼公司" },
  { question: "崇庆县属于哪个省？", category: "百科知识", answer: "四川省", explain: "崇庆县，中华民国初年在四川省设置的县。", source: "CMRC 2018 · 崇庆县" },
  { question: "宪法广场位于哪里？", category: "百科知识", answer: "希腊首都雅典", explain: "宪法广场（）是希腊首都雅典的主要广场，位于希腊国会之前，得名于1843年9月3日奥托国王在起义后批准的希腊宪法。", source: "CMRC 2018 · 宪法广场 (雅典)" },
  { question: "1970年胡红玉参加的社团叫什么名称？", category: "百科知识", answer: "「香港观察社」", explain: "1970年代加入论政团体「香港观察社」，1983年更与观察社成员上京，要求中英联合声明保障香港人权和法治及推行民主政制。", source: "CMRC 2018 · 胡红玉" },
  { question: "韦斯特曼纳群岛位于哪里？", category: "百科知识", answer: "冰岛南海岸外的火山群岛", explain: "冰岛语：Vestmannaeyjar），位于冰岛南海岸外的火山群岛，由14个小岛屿组成，总面积约21平方公里。", source: "CMRC 2018 · 韦斯特曼纳群岛" },
  { question: "中国首家股份制职业足球俱乐部名称是什么？", category: "百科知识", answer: "广州太阳神足球俱乐部", explain: "1993年1月8日广州太阳神集团和广州市体委合作成立中国首家股份制职业足球俱乐部，改名为广州太阳神足球俱乐部。", source: "CMRC 2018 · 广州白云足球队" },
  { question: "董景昌的著作名称是什么？", category: "百科知识", answer: "《董氏针灸正经奇穴学》", explain: "著作有《董氏针灸正经奇穴学》。", source: "CMRC 2018 · 董景昌" },
  { question: "显存的全称是什么？", category: "百科知识", answer: "显示记忆体", explain: "显存全称显示记忆体，亦称帧缓存，它是用来存储显示芯片处理过或者即将读取的渲染数据。", source: "CMRC 2018 · 显存" },
  { question: "百变机兽的全称是什么？", category: "百科知识", answer: "百变机兽之洛洛历险记", explain: "百变机兽全称百变机兽之洛洛历险记，是一部完全由中国人原创的全三维52集连续动画片，和其他其他动画片，如变形金刚有点相像，但它绝对是原创。", source: "CMRC 2018 · 百变机兽" },
  { question: "棘眦海蛇属属于哪一科？", category: "百科知识", answer: "蛇亚目海蛇科", explain: "棘眦海蛇属（学名：），是蛇亚目海蛇科下的一种有毒单型蛇属，属下只有棘眦海蛇（\"Acalyptophis peronii\"）一种海蛇，主要分布于南中国海、澳洲等海域。", source: "CMRC 2018 · 棘眦海蛇" },
  { question: "栢慧豪园第二期的名称是什么？", category: "百科知识", answer: "栢慧豪廷", explain: "目前该屋苑第一期已落成并已于2008年第一季入伙，而第2期命名为栢慧豪廷，于2010年11月开始入伙。", source: "CMRC 2018 · 栢慧豪园" },
  { question: "棱鮻属于哪一科？", category: "百科知识", answer: "为辐鳍鱼纲鲻形目鲻科", explain: "棱鮻（学名：），俗名白鱼、犬鱼、乌头、虫鱼，为为辐鳍鱼纲鲻形目鲻科鮻属的其中一种。", source: "CMRC 2018 · 棱鮻" },
  { question: "现在说到《让世界充满爱》一般是指第几部分？", category: "百科知识", answer: "第二部分", explain: "该曲共分三部分，其中第二部分“轻轻地捧着你的脸，为你把眼泪擦干……”流传最为广泛，现在说到《让世界充满爱》一般就指第二部分。", source: "CMRC 2018 · 让世界充满爱" },
  { question: "《让世界充满爱》一共由几部分组成？", category: "百科知识", answer: "三部分", explain: "该曲共分三部分，其中第二部分“轻轻地捧着你的脸，为你把眼泪擦干……”流传最为广泛，现在说到《让世界充满爱》一般就指第二部分。", source: "CMRC 2018 · 让世界充满爱" },
  { question: "苏黎世大教堂位于哪里？", category: "百科知识", answer: "利马特河河岸附近", explain: "教堂位于利马特河河岸附近。", source: "CMRC 2018 · 苏黎世大教堂" },
  { question: "崖勤猎站位于什么地方？", category: "百科知识", answer: "国王十字地底", explain: "崖勤猎站（）是城市铁路辖下的一个车站，位于国王十字地底。", source: "CMRC 2018 · 崖勤猎站" },
  { question: "白云鄂博铁矿位于什么地方？", category: "百科知识", answer: "中国内蒙古自治区中部", explain: "白云鄂博铁矿是位于中国内蒙古自治区中部的一座大型露天铁-稀土矿床，1927年由著名地质学家丁道衡发现。", source: "CMRC 2018 · 白云鄂博铁矿" },
  { question: "什么是营业税？", category: "百科知识", answer: "是流转税制中的一个税种", explain: "营业税是流转税制中的一个税种，其课税范围和纳税依据可以是商品生产、商品流通、转让无形资产、销售不动产、提供应税劳务或服务等等的营业额，特殊情况下也有不计价值而按商品流通数量或者服务次数等计税的。", source: "CMRC 2018 · 营业税" },
  { question: "银彭纳石首鱼属于哪一科？", category: "百科知识", answer: "辐鳍鱼纲鲈形目石首鱼科", explain: "银彭纳石首鱼（学名：Pennahia argentata），又称白姑鱼，俗名白口、帕头、黄顺，为辐鳍鱼纲鲈形目石首鱼科的其中一个种。", source: "CMRC 2018 · 银彭纳石首鱼" },
  { question: "斑鳍彭纳石首鱼属于哪一科？", category: "百科知识", answer: "辐鳍鱼纲鲈形目石首鱼科", explain: "斑鳍彭纳石首鱼（学名：Pennahia pawak），又称斑鳍白姑鱼俗名春子、帕头，为辐鳍鱼纲鲈形目石首鱼科的其中一个种。", source: "CMRC 2018 · 斑鳍白姑鱼" },
  { question: "炮台公园位于什么地方？", category: "百科知识", answer: "在该岛最南端", explain: "在该岛最南端是炮台公园（Battery Park），在西侧，TriBeCa区横跨钱伯斯街，在街的东端是庞大的曼哈顿市政大楼。", source: "CMRC 2018 · 曼哈顿下城" },
  { question: "宝永山位于什么地方？", category: "百科知识", answer: "日本静冈县御殿场市的一座火山", explain: "宝永山（）是位于日本静冈县御殿场市的一座火山，在宝永4年（1707年）的宝永大喷火中诞生的，为富士山最大的侧火山（寄生火山）。", source: "CMRC 2018 · 宝永山" },
  { question: "59街位于哪里？", category: "百科知识", answer: "纽约市曼哈顿区", explain: "59街是纽约市曼哈顿区的一条东西向街道，从约克大道到西侧高速公路，在第九大道/哥伦布大道与第八大道/中央公园西之间被时代华纳中心隔断。", source: "CMRC 2018 · 59街" },
  { question: "萨尔保护领位于什么地方？", category: "百科知识", answer: "位于德、法两国之间。", explain: "由法国所管理，位于德、法两国之间。1955年举行全民公投后，于1957年1月1日起成为西德一部分，相当于今日德国萨尔兰。", source: "CMRC 2018 · 萨尔保护领" },
  { question: "该球队建立于什么时候？", category: "百科知识", answer: "1979年", explain: "塞舌尔于1979年成立塞舌尔足球协会，直到1986年同时加入国际足协及非洲足协。", source: "CMRC 2018 · 塞舌尔国家足球队" },
  { question: "陶鹰鼎是属于什么陶器？", category: "百科知识", answer: "仰韶文化陶器", explain: "陶鹰鼎是仰韶文化陶器，出土于陕西省华县（现渭南市华州区）太平庄。", source: "CMRC 2018 · 陶鹰鼎" },
  { question: "广东人一般用什么代替商号或名字全称？", category: "百科知识", answer: "习惯以记字", explain: "另外，广东人同时习惯以记字代替商号或名字全称。", source: "CMRC 2018 · 伙伴" },
  { question: "中国文化大学华语中心隶属于哪个组织？", category: "百科知识", answer: "中国文化大学推广教育部", explain: "中国文化大学华语中心（Mandarin Learning Center，缩写 MLC），隶属于中国文化大学推广教育部。", source: "CMRC 2018 · 中国文化大学华语中心" },
  { question: "美国国家女子足球队目前位于国际足联的排名的第几位？", category: "百科知识", answer: "第一位", explain: "美国国家女子足球队目前位于国际足联的排名的第一位。", source: "CMRC 2018 · 美国国家女子足球队" },
  { question: "国大党属于哪个组织？", category: "百科知识", answer: "「团结进步联盟」", explain: "国大党取得206席，其所属的「团结进步联盟」合计取得262席。", source: "CMRC 2018 · 2009年印度议会选举" },
  { question: "尖吻鲈属于哪一科？", category: "百科知识", answer: "为辐鳍鱼纲鲈形目尖嘴鲈科", explain: "尖吻鲈（学名：）为辐鳍鱼纲鲈形目尖嘴鲈科尖吻鲈属的鱼类。", source: "CMRC 2018 · 尖吻鲈" },
  { question: "丝鳍高身天竺鲷还有什么其他的名称？", category: "百科知识", answer: "俗名丝鳍圆天竺鲷、丝鳍天竺鲷", explain: "丝鳍高身天竺鲷（学名：）为天竺鲷科高身天竺鲷属的鱼类，俗名丝鳍圆天竺鲷、丝鳍天竺鲷。", source: "CMRC 2018 · 丝鳍天竺鲷" },
  { question: "孔平仲属于哪个派别？", category: "百科知识", answer: "临江派", explain: "孔子四十七代孙，属于“临江派”。", source: "CMRC 2018 · 孔平仲" },
  { question: "该实验室的日常运作的管理权是属于哪个公司所有？", category: "百科知识", answer: "美国电报电话公司", explain: "就在当时它成为了一个独立的子公司，组织权、所有权和经营权都归美国电报电话公司，也就是贝尔实验室的母公司所有。", source: "CMRC 2018 · Unix系统实验室" },
  { question: "当时，日本舰队由什么组成？", category: "百科知识", answer: "3艘驱逐舰和7艘运输驱逐舰", explain: "日本舰队由3艘驱逐舰和7艘运输驱逐舰组成，指挥官为秋山辉男少将，计划运载2,600名官兵增援科隆班加拉。", source: "CMRC 2018 · 库拉湾海战" },
  { question: "谁的艺名叫泳儿？", category: "百科知识", answer: "陈家欣", explain: "在24强淘汰赛中出局的陈家欣，同年回到香港参加了《2005年度英皇新秀歌唱大赛》并夺得亚军及最佳型格奖，继而晋身乐坛，加盟英皇娱乐集团有限公司 Music Plus，取了艺名「泳儿」 。", source: "CMRC 2018 · 绝对SuperStar" },
  { question: "林芳正属于哪个党派？", category: "百科知识", answer: "自民党", explain: "林 芳正（），日本政治家，出身于山口县下关市，为自民党的参议院议员（4次当选），历任防卫大臣、内阁府特命担当大臣（经济财政担当大臣）、农林水产大臣等要职。", source: "CMRC 2018 · 林芳正" },
  { question: "这场海战发生于哪两个国家之间？", category: "百科知识", answer: "日本和美国", explain: "1943年10月7日）是一场发生于所罗门群岛维拉拉维拉岛海域，在日本和美国舰队之间爆发的一场海战。", source: "CMRC 2018 · 维拉拉维拉海战" },
  { question: "飞鹅岭现在属于哪个风景区？", category: "百科知识", answer: "惠州西湖风景名胜区", explain: "目前飞鹅岭已辟为飞鹅公园，纳入惠州西湖风景名胜区。", source: "CMRC 2018 · 飞鹅岭 (惠州)" },
  { question: "冰川湾国家公园位于哪里？", category: "百科知识", answer: "美国阿拉斯加州南部", explain: "冰川湾国家公园（Glacier Bay National Park and Preserve）是位于美国阿拉斯加州南部的一个国家公园。", source: "CMRC 2018 · 冰川湾国家公园" },
  { question: "包天笑属于中国近代小说的哪个流派？", category: "百科知识", answer: "鸳鸯蝴蝶派", explain: "20世纪中国通俗文学作家，鸳鸯蝴蝶派作家。", source: "CMRC 2018 · 包天笑" },
  { question: "依潘龙实际上属于哪个科目？", category: "百科知识", answer: "兽脚亚目", explain: "依潘龙属（学名：\"Epanterias\"）是种兽脚亚目恐龙，生存于侏㑩纪晚期的启莫里阶/提通阶。", source: "CMRC 2018 · 依潘龙属" },
  { question: "映秀镇属于哪个省？", category: "百科知识", answer: "四川省", explain: "映秀镇是中国四川省阿坝藏族羌族自治州汶川县的一个镇。", source: "CMRC 2018 · 映秀镇" },
  { question: "圣福里安圣殿位于哪里？", category: "百科知识", answer: "马泰伊科广场的北端", explain: "圣福里安圣殿（）是波兰城市克拉科夫一座建筑于中世纪的天主教教堂，位于马泰伊科广场的北端，曾是中世纪城市克莱帕日（现在是克拉科夫的一个区）的中心。", source: "CMRC 2018 · 圣福里安圣殿 (克拉科夫)" },
  { question: "瓦维尔主教座堂位于 哪里？", category: "百科知识", answer: "波兰克拉科夫瓦维尔山上", explain: "瓦维尔主教座堂（）是位于波兰克拉科夫瓦维尔山上的教堂，也是天主教克拉科夫总教区的主教座堂。", source: "CMRC 2018 · 圣达尼老圣文策老圣殿总主教座堂 (克拉科夫)" },
  { question: "绵阳站位于哪里？", category: "百科知识", answer: "四川省绵阳市涪城区临园路西段", explain: "绵阳站，位于四川省绵阳市涪城区临园路西段，为成都铁路局管辖的一等站，距成都站115公里，距宝鸡站554公里。", source: "CMRC 2018 · 绵阳站" },
  { question: "《球阳》全称什么？", category: "百科知识", answer: "《球阳记事》", explain: "《球阳》全称《球阳记事》，在第二尚氏王朝时期简称《记事》，《球阳》是琉球处分之后的通称。", source: "CMRC 2018 · 球阳" },
  { question: "7号线月台位于哪里？", category: "百科知识", answer: "约瑟夫河边街地底", explain: "在南部，7号线月台位于约瑟夫河边街地底，11号线位于维多利亚街地底。", source: "CMRC 2018 · 沙特雷站" },
  { question: "沙特雷-大堂站位于哪里？", category: "百科知识", answer: "巴黎第一区巴黎大堂的地底", explain: "沙特雷-大堂站（）是巴黎区域快铁（RER）最大的换乘站，座落在巴黎第一区巴黎大堂的地底。", source: "CMRC 2018 · 沙特雷-大堂站" },
  { question: "活动地区包括哪里？", category: "百科知识", answer: "中山、顺德、鹤山、新会等地", explain: "活动地区包括中山、顺德、鹤山、新会等地。", source: "CMRC 2018 · 伍蕃" },
  { question: "中央广场包括几层零售商舖？", category: "百科知识", answer: "2层", explain: "大厦包括25层写字楼及6层停车场，另设2层零售商舖，提供各类商店食肆，并有穿梭巴士往返港铁中环站。", source: "CMRC 2018 · 中央广场" },
  { question: "西山话传统上有多少个声母（包括零声母）？", category: "百科知识", answer: "33个", explain: "西山话传统上有33个声母（包括零声母），尖团合并则有34个声母（包括零声母）。", source: "CMRC 2018 · 西山话" },
  { question: "加佐洞由哪两个法定洞组成？", category: "百科知识", answer: "北加佐洞及南加佐洞", explain: "加佐洞是大韩民国首都首尔的西大门区的一个地方名称，总人口约10万人，由北加佐洞及南加佐洞两个法定洞组成。", source: "CMRC 2018 · 加佐洞" },
  { question: "什么是猎户座内很容易辨认的一颗1等星？", category: "百科知识", answer: "参宿四", explain: "更小但更规则的形状是「冬季大三角」，几乎是一个三边等长的正三角形，与大星群共用两个顶点（天狼星和南河三），第三个顶点是接近六边形中心位置的猎户座参宿四（Betelgeuse、α Ori）。", source: "CMRC 2018 · 冬季六边形" },
  { question: "和属于是什么语言？", category: "百科知识", answer: "是支持一阶逻辑表达式的语言", explain: "和属于是支持一阶逻辑表达式的语言，尤其是允许通用谓词（）。", source: "CMRC 2018 · 本体语言" },
  { question: "北京市第五中学位于什么地方？", category: "百科知识", answer: "北京市东城区细管胡同13号", explain: "北京市第五中学，简称北京五中，是北京市示范性高中，位于北京市东城区细管胡同13号。", source: "CMRC 2018 · 北京市第五中学" },
  { question: "灵活玩的英文名称是什么？", category: "百科知识", answer: "Flexi Betting", explain: "是博彩的其中一种投注方式，英文为Flexi Betting，在香港「灵活玩」，由香港赛马会于2008-09年马季开始举办。", source: "CMRC 2018 · 灵活玩" },
  { question: "翠群径位于什么地方？", category: "百科知识", answer: "离岛区东涌", explain: "翠群径是位于离岛区东涌。", source: "CMRC 2018 · 翠群径" },
  { question: "红翅旋壁雀属于哪一科？", category: "百科知识", answer: "旋壁雀科", explain: "旧属䴓科，今独立出来成为旋壁雀科，之下只有旋壁雀属一个属。", source: "CMRC 2018 · 红翅旋壁雀" },
  { question: "栗斑腹鹀属于什么科？", category: "百科知识", answer: "雀科鹀属", explain: "栗斑腹鹀（学名：）为雀科鹀属的鸟类，俗名红肚麻雀。", source: "CMRC 2018 · 栗斑腹鹀" },
  { question: "陕西省体育场位于什么地方？", category: "百科知识", answer: "西安市南二环长安立交西北部", explain: "又称“朱雀体育场”），座落在西安市南二环长安立交西北部，长安北路和朱雀大街之间；", source: "CMRC 2018 · 陕西省体育场" },
  { question: "金牛街位于什么地方？", category: "百科知识", answer: "昆明市中心", explain: "金牛街，曾位于昆明市中心，盘龙江边。", source: "CMRC 2018 · 金牛街" },
  { question: "纽博格林赛道位于什么地方？", category: "百科知识", answer: "德国艾菲尔山区", explain: "纽博格林赛道(北环)位于德国艾菲尔山区, 总长约20.8公里。", source: "CMRC 2018 · 纽伯格林赛道圈速" },
  { question: "为了确保病患隔离，汉生病患的聚落常位于哪些地区？", category: "百科知识", answer: "小岛上，或是偏远地区", explain: "为了确保病患隔离，汉生病患的聚落常位于小岛上，或是偏远地区。", source: "CMRC 2018 · 汉生病疗养院" },
  { question: "纽约大街位于什么地方？", category: "百科知识", answer: "巴黎十六区", explain: "纽约大街（Avenue de New-York）是巴黎十六区的一条街道。", source: "CMRC 2018 · 纽约大街" },
  { question: "异剑齿虎属于哪一科？", category: "百科知识", answer: "剑齿虎亚科", explain: "异剑齿虎（学名：），又名异剑虎或异刃虎，是剑齿虎亚科下的一属。", source: "CMRC 2018 · 异剑齿虎属" },
  { question: "五所川原车站位于日本哪个地方？", category: "百科知识", answer: "日本青森县五所川原市大町", explain: "五所川原车站（）是一位于日本青森县五所川原市大町，由东日本旅客铁道（JR东日本）与津轻铁道所共用的铁路车站。", source: "CMRC 2018 · 五所川原车站" },
  { question: "《开宝本草》的全称是什么？", category: "百科知识", answer: "《开宝重定本草》", explain: "《开宝本草》全称《开宝重定本草》，凡20卷，目录1卷，宋开宝六年尚药奉御刘翰、道士马志，翰林医官翟煦、张素、王从蕴、吴复圭、王光祐、陈昭遇、安自良等九人编著。", source: "CMRC 2018 · 开宝重定本草" },
  { question: "老教堂位于哪个城市？", category: "百科知识", answer: "阿姆斯特丹", explain: "老教堂（Oude Kerk）是阿姆斯特丹最古老的本堂区教堂，1306年由乌德勒支主教祝圣。", source: "CMRC 2018 · 老教堂 (阿姆斯特丹)" },
  { question: "罗金汉侯爵属于哪个地区的贵族爵位？", category: "百科知识", answer: "大不列颠", explain: "罗金汉侯爵（Marquess of Rockingham）属于大不列颠贵族爵位，创设于1746年4月19日，授予托马斯·沃森-文特沃斯，第六代罗金汉男爵。", source: "CMRC 2018 · 罗金汉侯爵" },
  { question: "慕尼黑新市政厅位于德国慕尼的什么地方？", category: "百科知识", answer: "玛利亚广场北部", explain: "慕尼黑新市政厅（）是德国慕尼黑玛利亚广场北部的一座市政厅建筑，设有市议会、市长办公室和一部分行政机构。", source: "CMRC 2018 · 慕尼黑新市政厅" },
  { question: "慕尼黑旧市政厅位于什么地方？", category: "百科知识", answer: "慕尼黑市中心玛利亚广场东侧", explain: "慕尼黑旧市政厅（Altes Rathaus）是1874年以前的慕尼黑市政厅，位于慕尼黑市中心玛利亚广场东侧，现在供市议会代表使用。", source: "CMRC 2018 · 慕尼黑旧市政厅" },
  { question: "黄额闭壳龟属于什么类的动物？", category: "百科知识", answer: "龟科闭壳龟属的爬行动物", explain: "黄额闭壳龟（学名：）又称梅花箱龟、梅花盒龟，为龟科闭壳龟属的爬行动物，又称梅花盒龟、花背盒龟、海南闭壳龟等。", source: "CMRC 2018 · 黄额闭壳龟" },
  { question: "黄喉拟水龟属于什么类的动物？", category: "百科知识", answer: "泽龟科拟水龟属的爬行动物", explain: "黄喉拟水龟（学名：、）又称柴棺龟、石金钱龟，为泽龟科拟水龟属的爬行动物。", source: "CMRC 2018 · 黄喉拟水龟" },
  { question: "花龟属于什么类的动物？", category: "百科知识", answer: "龟科花龟属的爬行动物", explain: "花龟（学名：）又称中华花龟、斑龟、台湾斑龟、长尾龟、珍珠龟、台湾龟、梅花龟，为龟科花龟属的爬行动物。", source: "CMRC 2018 · 花龟" },
  { question: "变色树蜥属于什么类的动物？", category: "百科知识", answer: "鬣蜥科树蜥属的爬行动物", explain: "变色树蜥（学名：）为鬣蜥科树蜥属的爬行动物，俗名马鬃蛇、鸡冠蛇。", source: "CMRC 2018 · 变色树蜥" },
  { question: "溪头龙蜥属于什么类的动物？", category: "百科知识", answer: "飞蜥科龙蜥属", explain: "溪头龙蜥（学名：），又名牧氏攀蜥，俗称竹虎，旧称牧茂氏攀蜥，为飞蜥科龙蜥属下的物种。", source: "CMRC 2018 · 溪头龙蜥" },
  { question: "丽纹龙蜥属于哪一类动物？", category: "百科知识", answer: "飞蜥科龙蜥属", explain: "丽纹龙蜥（学名：）为飞蜥科龙蜥属的一种。", source: "CMRC 2018 · 丽纹龙蜥" },
  { question: "台湾龙蜥属于哪一类动物？", category: "百科知识", answer: "飞蜥科龙蜥属", explain: "台湾龙蜥（学名：），又名台湾攀蜥、箕作氏攀蜥，俗称竹虎、山狗大，为飞蜥科龙蜥属下的物种。", source: "CMRC 2018 · 台湾龙蜥" },
  { question: "乌卢鲁位于哪个公园？", category: "百科知识", answer: "乌鲁汝－卡塔楚塔国家公园", explain: "乌卢鲁（意为「土地之母」），又被称为艾尔斯岩，位于澳大利亚北领地的南部，是在澳大利亚中部形成的一个大型砂岩岩层，位于乌鲁汝－卡塔楚塔国家公园 之内。", source: "CMRC 2018 · 乌卢鲁" },
  { question: "根据康氏马鲛的分布，它属于什么鱼类？", category: "百科知识", answer: "近海暖水性中上层鱼类", explain: "分布于印度洋北部沿岸、红海、东至澳大利亚、北至日本、朝鲜以及中国大陆南海、台湾海峡、东海南部等海域，属于近海暖水性中上层鱼类。", source: "CMRC 2018 · 康氏马鲛" },
  { question: "褐牙鲆属于什么温度性质的底层海鱼？", category: "百科知识", answer: "暖温性", explain: "分布于国外达朝鲜、日本及库页岛等海区以及中国自珠江口到鸭绿江口外附近海域等，属于暖温性底层海鱼。", source: "CMRC 2018 · 褐牙鲆" },
  { question: "冠鲽是属于哪纲的鱼？", category: "百科知识", answer: "辐鳍鱼纲", explain: "冠鲽（学名：），俗名白须公、冠汉鲽、丝翅右鲽，为辐鳍鱼纲鲽形目鲽亚目冠鲽科的一种。", source: "CMRC 2018 · 冠鲽" },
  { question: "花斑拟鳞鲀属于什么温度性质的鱼类？", category: "百科知识", answer: "暖水性鱼类", explain: "本鱼分布于非洲东海岸到太平洋中部波利尼西亚、北至日本南部以及西沙群岛海域和台湾海峡等，属于暖水性鱼类。", source: "CMRC 2018 · 花斑拟鳞鲀" },
  { question: "纹腹叉鼻鲀以小型底栖动物为食，属于什么食性的鱼类？", category: "百科知识", answer: "肉食性", explain: "属肉食性，以小型底栖动物为食。", source: "CMRC 2018 · 纹腹叉鼻鲀" },
  { question: "挽叻县是组成曼谷的多少个县之一？", category: "百科知识", answer: "五十个", explain: "英文：Bang Rak)位于泰国的首都曼谷的东部，它是组成曼谷的五十个县之一。", source: "CMRC 2018 · 挽叻县" },
  { question: "农业自然及食品品质部1935年成立时的名称是什么？", category: "百科知识", answer: "农业及渔业部", explain: "十个政策部门为：农业自然及食品品质部成立于1935年，当时名称为「农业及渔业部」（Ministerie van Landbouw en Visserij）。", source: "CMRC 2018 · 荷兰农业、自然及食品品质部" },
  { question: "尼康D90属于哪种类型的相机？", category: "百科知识", answer: "数码单镜反光相机", explain: "艺康D90是一款由日本相机制造厂尼康生产的数码单镜反光相机，于2008年8月27日发布，并预定当年9月开始销售，计划取代原本的进阶业余机种D80。", source: "CMRC 2018 · 尼康D90" },
  { question: "尼康D90属于哪一档次的单反相机？", category: "百科知识", answer: "中阶单镜反光相机", explain: "一直以来，尼康D90都是中阶单镜反光相机中的热卖型号。", source: "CMRC 2018 · 尼康D90" },
  { question: "圣母无原罪主教座堂位于何地？", category: "百科知识", answer: "台湾台北市大同区", explain: "圣母无原罪主教座堂位于台湾台北市大同区，为天主教台北总教区的主教座堂，也是台北市首座天主教堂；", source: "CMRC 2018 · 圣母无原罪主教座堂 (台北市)" },
  { question: "圣母无原罪主教座堂又被称为什么名称？", category: "百科知识", answer: "民生西路天主堂", explain: "由于座落于民生西路，亦名民生西路天主堂。", source: "CMRC 2018 · 圣母无原罪主教座堂 (台北市)" },
  { question: "高淳县从何时起开始隶属于江苏省？", category: "百科知识", answer: "民国元年(1912)", explain: "民国元年(1912)，废府，高淳县隶江苏省。", source: "CMRC 2018 · 高淳县" },
  { question: "鲍里索夫BATE足球俱乐部属于哪个国家？", category: "百科知识", answer: "白俄罗斯", explain: "，\"FK BATE Borisov\"），也称波里索夫贝特，是一家设在波里索夫的白俄罗斯足球俱乐部。", source: "CMRC 2018 · 鲍里索夫BATE足球俱乐部" },
  { question: "勉方言属于什么语序语支？", category: "百科知识", answer: "苗瑶语系瑶语支", explain: "勉方言是勉语的一种，属于苗瑶语系瑶语支。", source: "CMRC 2018 · 勉方言" },
  { question: "椰胡属于什么类型的乐器？", category: "百科知识", answer: "弓弦乐器", explain: "椰胡是广东、福建、台湾等地流行的弓弦乐器，粤语、客语、潮语、台语等语种的口语和书面语称为「冇弦」，「冇」潮语、台语读pah（带鼻音）；", source: "CMRC 2018 · 椰胡" },
  { question: "五山街道具体位于什么地区？", category: "百科知识", answer: "中国广东省广州市天河区", explain: "五山街道是中国广东省广州市天河区下辖的一个街道，始设于1953年。", source: "CMRC 2018 · 五山街道" },
  { question: "双屿港位于什么地方？", category: "百科知识", answer: "浙江省舟山市六横岛", explain: "双屿港，位于今天浙江省舟山市六横岛，十六世纪远东与西方贸易的重要港口，也是明朝海盗集团王直等人的根据地。", source: "CMRC 2018 · 双屿港" },
  { question: "花径位于什么地方？", category: "百科知识", answer: "中国江西省庐山山顶", explain: "花径是位于中国江西省庐山山顶的一个公园，在牯岭正街以西约2公里处，大林路沿线。", source: "CMRC 2018 · 花径" },
  { question: "神木与瞳是谁与谁组成的台湾乐团团体？", category: "百科知识", answer: "赖铭伟与黄美珍所组成", explain: "神木与瞳（Y2J），是赖铭伟与黄美珍所组成的台湾乐团团体，所属唱片公司为环球音乐。", source: "CMRC 2018 · 神木与瞳" },
  { question: "北京景山学校位于哪个城区？", category: "百科知识", answer: "中国北京市东城区", explain: "北京景山学校是1960年代建立的一所集小学、初中、高中于一体的学校，位于中国北京市东城区，是北京市高中示范校。", source: "CMRC 2018 · 北京景山学校" },
  { question: "桑比亚半岛属于哪国？", category: "百科知识", answer: "俄罗斯", explain: "桑比亚半岛（俄语：）是俄罗斯加里宁格勒州的一座半岛，位于波罗的海东南沿岸。", source: "CMRC 2018 · 桑比亚半岛" },
  { question: "东林寺位于哪里？", category: "百科知识", answer: "中国江西省九江市庐山西北麓", explain: "东林寺是位于中国江西省九江市庐山西北麓的一座著名佛寺，始建于384年（东晋太元九年），为东林慧远所创。", source: "CMRC 2018 · 东林寺" },
  { question: "博尔德校区位于哪个城市？", category: "百科知识", answer: "洛叽山麓的波德市", explain: "博尔德校区是科罗拉多大学主校区，该校区位于洛叽山麓的波德市。", source: "CMRC 2018 · 科罗拉多大学波德分校" },
  { question: "归元寺属于湖北省的哪个城市？", category: "百科知识", answer: "武汉市", explain: "归元寺，位于汉阳区翠微路和归元寺路交界，是中国湖北省武汉市的一座著名佛教曹洞宗寺院，武汉的佛教四大丛林(还包括宝通寺、莲溪寺、正觉寺）之一。", source: "CMRC 2018 · 归元寺" },
  { question: "后劲溪位于哪里？", category: "百科知识", answer: "台湾高雄市", explain: "后劲溪是位在台湾高雄市的河川，长13公里，流经楠梓区、仁武区、大社区等地，为高雄地区1,600多公顷的农田的灌溉水源。", source: "CMRC 2018 · 后劲溪" },
  { question: "普鲁士公国位于什么位置？", category: "百科知识", answer: "普鲁士地区东部", explain: "普鲁士公国（、）位于普鲁士地区东部，存在时间为1525年至1701年（其中1618年－1701年间以勃兰登堡-普鲁士形式存在）。", source: "CMRC 2018 · 普鲁士公国" },
  { question: "谁被认为是最早到达巴西的欧洲人？", category: "百科知识", answer: "佩德罗·阿尔瓦雷斯·卡布拉尔", explain: "佩德罗·阿尔瓦雷斯·卡布拉尔（葡萄牙语：，约1467年出生于贝尔蒙蒂－约1520年），葡萄牙航海家、探险家，被普遍认为是最早到达巴西的欧洲人（1500年4月22日）。", source: "CMRC 2018 · 佩德罗·阿尔瓦雷斯·卡布拉尔" },
  { question: "白云山位于什么位置？", category: "百科知识", answer: "内江市资中县境内", explain: "白云山（资中白云山风景名胜区）为省级风景名胜区，位于内江市资中县境内，面积56平方公里。", source: "CMRC 2018 · 白云山 (四川)" },
  { question: "濑峰车站位于哪里？", category: "百科知识", answer: "日本宫城县栗原市濑峰下田", explain: "濑峰车站（）是一由东日本旅客铁道（JR东日本）的所经营铁路车站，位于日本宫城县栗原市濑峰下田。", source: "CMRC 2018 · 濑峰车站" },
  { question: "桥社是指什么？", category: "百科知识", answer: "德国表现主义的一个艺术组织", explain: "桥社（）是德国表现主义的一个艺术组织，1905年成立于德累斯顿工业大学。", source: "CMRC 2018 · 桥社" },
  { question: "石越车站的站房位于什么位置？", category: "百科知识", answer: "JR石越车站站前广场西北角", explain: "其车站站房位于JR石越车站站前广场西北角的位置，但车站早已在2001年时就改为无人化经营、2007年3月随著栗原田原铁道线废线而停止营运。", source: "CMRC 2018 · 石越车站" },
  { question: "有壁车站位于哪里？", category: "百科知识", answer: "日本宫城县栗原市金成有壁", explain: "有壁车站（）是一由东日本旅客铁道（JR东日本）的所经营铁路车站，位于日本宫城县栗原市金成有壁。", source: "CMRC 2018 · 有壁车站" },
  { question: "闻名全苏联的诺沃切尔卡斯克电力机车厂位于哪里？", category: "百科知识", answer: "新切尔卡斯克", explain: "新切尔卡斯克（），是俄罗斯罗斯托夫州西部的一个城市，距首府罗斯托夫东北30公里。", source: "CMRC 2018 · 新切尔卡斯克" },
  { question: "尼古洛巴托总统国际机场位于哪里？", category: "百科知识", answer: "东帝汶帝力", explain: "尼古洛巴托总统国际机场（，），之前称科摩罗国际机场（），机场位于东帝汶帝力。", source: "CMRC 2018 · 尼古劳·洛巴托总统国际机场" },
  { question: "圣若望广场位于哪里？", category: "百科知识", answer: "佛罗伦萨", explain: "圣若望广场（）是佛罗伦萨的一个广场，得名于圣若望洗礼堂，实际上是主教座堂广场的向西延伸。", source: "CMRC 2018 · 圣若望广场 (佛罗伦萨)" },
  { question: "西藏南路隧道的南岸位于哪里？", category: "百科知识", answer: "南岸位于浦东新区", explain: "西藏南路隧道为南北走向，北岸位于黄浦区，南岸位于浦东新区，全长2.67公里，设双向四车道，设计时速40公里。", source: "CMRC 2018 · 西藏南路隧道" },
  { question: "桥杭岩是位于哪里的著名旅游名胜？", category: "百科知识", answer: "和歌山县东牟娄郡串本町", explain: "桥杭岩是位于和歌山县东牟娄郡串本町的旅游名胜，吉野熊野国立公园的一部分。", source: "CMRC 2018 · 桥杭岩" },
  { question: "切尔尼戈夫省位于哪个国家？", category: "百科知识", answer: "俄罗斯帝国", explain: "切尔尼戈夫省（）是俄罗斯帝国的一个省，范围大致包括乌克兰北部，包括切尔尼戈夫州、苏梅州北部和俄罗斯布良斯克州大部。", source: "CMRC 2018 · 切尔尼戈夫省" },
  { question: "时代图书公司是谁组成的？", category: "百科知识", answer: "张光宇与邵洵美", explain: "1934年张光宇与邵洵美组成时代图书公司，创办了《时代漫画》，由鲁少飞担任主编，于1937年终刊。", source: "CMRC 2018 · 时代漫画" },
  { question: "谁钦点慧卡拍摄了多季的Fendi平面广告？", category: "百科知识", answer: "Fendi设计师卡尔·拉格斐", explain: "但现在精灵系风潮已不在，Raquel于是得以出线，凭借她苗窕的身材、德巴混血野性中带优雅的气质，成了近来各大品牌的爱用名模，Fendi设计师卡尔·拉格斐（Karl Lagerfeld）便钦点她为该名牌拍摄多季的平面广告。", source: "CMRC 2018 · 慧卡·芝玛曼" },
  { question: "五马街位于中国哪座城市？", category: "百科知识", answer: "浙江省温州市", explain: "五马街是中国浙江省温州市最著名的商业街，位于该市中心地段，鹿城区五马街道，温州古城区的南部，东起解放南路，西接蝉街，全长424米。", source: "CMRC 2018 · 五马街" },
  { question: "江西理工大学位于中国哪座城市？", category: "百科知识", answer: "江西省南昌市和赣州市", explain: "江西理工大学是一所全日制普通高等院校，位于江西省南昌市和赣州市。", source: "CMRC 2018 · 江西理工大学" },
  { question: "基隆街位于什么地方？", category: "百科知识", answer: "位于台北州基隆郡。", explain: "基隆街为台湾日治时期中期（1920年至1924年间）存在之行政区，位于台北州基隆郡。辖属范围包含今基隆市的中山、中正、仁爱、信义、安乐等5个区。", source: "CMRC 2018 · 基隆街 (基隆郡)" },
  { question: "黄花镇位于什么地方？", category: "百科知识", answer: "湖南省长沙县中南部", explain: "黄花镇位于湖南省长沙县中南部，为长沙县第三大乡镇。", source: "CMRC 2018 · 黄花镇 (长沙县)" },
  { question: "江背镇位于什么地方？", category: "百科知识", answer: "湖南省长沙县东南部", explain: "江背镇位于湖南省长沙县东南部，为长沙县第二大乡镇，镇域北、东、南为浏阳市地域。", source: "CMRC 2018 · 江背镇 (长沙县)" },
  { question: "教育路位于哪里？", category: "百科知识", answer: "香港新界西元朗市中心", explain: "教育路（Kau Yuk Road）是香港新界西元朗市中心的一条主要街道，呈东西走向，全长约700米，整条街道横贯元朗市心脏地带。", source: "CMRC 2018 · 教育路 (香港)" },
  { question: "宝田总站位于什么地方？", category: "百科知识", answer: "香港屯门震寰路宝田邨", explain: "宝田总站（英文：Po Tin Bus Terminus）位于香港屯门震寰路宝田邨，邻近轻铁田景站，现时有2条巴士路线和2条特别班次路线以此处为总站。", source: "CMRC 2018 · 宝田公共运输交汇处" },
  { question: "现在六横镇镇政府位于什么区域？", category: "百科知识", answer: "西安路54号原峧头镇政府驻地", explain: "现六横镇镇政府驻西安路54号原峧头镇政府驻地，并与六横岛全国海岛资源综合开发试验区管理委员会合署办公。", source: "CMRC 2018 · 六横镇" },
  { question: "体温调节的中枢位于什么地方？", category: "百科知识", answer: "体温调节的中枢位于下视丘。", explain: "体温调节的中枢位于下视丘。传统生理学认为，在下视丘前部存在著散热中枢，而下视丘后部则存在著产热中枢，两个中枢之间有著交互抑制的关系，从而保持了体温的相对稳定。", source: "CMRC 2018 · 体温调节" },
  { question: "青山铺镇位于什么地方？", category: "百科知识", answer: "湖南省长沙县西北部", explain: "青山铺镇位于湖南省长沙县西北部，地处长沙县、汨罗市二县交汇处。", source: "CMRC 2018 · 青山铺镇" },
  { question: "塞拉纳岛这个名称首次出现在地图里是什么时候？", category: "百科知识", answer: "1545年", explain: "塞拉纳岛的名称一般认为是取自西班牙坐船遇难的人佩德罗·塞拉诺，这个名称在1545年首次出现在荷兰的地图里面，然后在1660年英国更广阔地在地图上标注了该岛。", source: "CMRC 2018 · 塞拉纳岛" },
  { question: "干杉镇位于什么地方？", category: "百科知识", answer: "湖南省长沙县南部", explain: "干杉镇位于湖南省长沙县南部。", source: "CMRC 2018 · 干杉镇" },
  { question: "非网路的电子出版物包括哪些？", category: "百科知识", answer: "CD和DVD", explain: "在现代，尽管电子出版强烈依赖于网路的传播，但也有很多非网路的电子出版物，像是CD和DVD。", source: "CMRC 2018 · 电子出版" },
  { question: "泰姬玛哈酒店位于什么地方？", category: "百科知识", answer: "印度孟买可拉巴地区印度门旁边", explain: "泰姬玛哈酒店（Taj Mahal Palace & Tower）是位于印度孟买可拉巴地区印度门旁边的一家有名望五星级豪华旅馆，拥有565个房间。", source: "CMRC 2018 · 泰姬玛哈酒店" },
  { question: "1958年，双江镇属于哪里管辖？", category: "百科知识", answer: "金井公社", explain: "1958年属金井公社，1961年析置双江公社，1983年双江公社改为双江乡，（年份？", source: "CMRC 2018 · 双江镇 (长沙县)" },
  { question: "金正日花属于什么科？", category: "百科知识", answer: "多年生秋海棠科", explain: "）是一种由日本培育的多年生秋海棠科植物。", source: "CMRC 2018 · 金正日花" },
  { question: "朴属属于什么科？", category: "百科知识", answer: "蔷薇目大麻科", explain: "朴属（学名：）是蔷薇目大麻科的一属，约60-70种落叶乔木，广泛分布在北半球暖温带地区，以及中非和南美洲部分地区。", source: "CMRC 2018 · 朴属" },
  { question: "伯根-贝尔森集中营位于哪里？", category: "百科知识", answer: "德国西北部下萨克森", explain: "伯根-贝尔森集中营 (，又称Bergen-Belsen或Belsen) ，是纳粹德国在德国西北部下萨克森建立的一座集中营，该地毗邻伯根和策勒。", source: "CMRC 2018 · 伯根-贝尔森集中营" },
  { question: "《花吃了那女孩》由几段不同的故事组成？", category: "百科知识", answer: "四段", explain: "是陈宏一所导演的一部台湾女同志电影，是根据四个真实的女同志情侣故事，改编拍摄而成的四段式电影。", source: "CMRC 2018 · 花吃了那女孩" },
  { question: "原城位于哪个半岛的南部？", category: "百科知识", answer: "岛原半岛", explain: "位于岛原半岛的南部，明应5年作为日野江城的支城由有马贵纯所建。", source: "CMRC 2018 · 原城" },
  { question: "澳大利亚管理研究所位于澳大利亚的哪个洲？", category: "百科知识", answer: "新南威尔士州", explain: "它位于澳大利亚新南威尔士州的府城悉尼，曾是当地的两大学府：新南威尔士大学（UNSW）及雪梨大学所集资经营的管理学院。", source: "CMRC 2018 · 澳大利亚管理研究所" },
  { question: "南车水库位于哪儿？", category: "百科知识", answer: "江西泰和县桥头镇，井冈山脚下", explain: "南车水库，又称白鹭湖，位于江西泰和县桥头镇，井冈山脚下，是一座以灌溉为主，兼有发电、防洪、养殖、旅游等综合利用的大（二）型水库。", source: "CMRC 2018 · 南车水库" },
  { question: "小北站位于哪儿？", category: "百科知识", answer: "环市中路小北路口以东的地底", explain: "小北站（）是广州地铁5号线的车站，位于环市中路小北路口以东的地底，于2009年12月28号启用。", source: "CMRC 2018 · 小北站 (广州)" },
  { question: "国技院位于哪里？", category: "百科知识", answer: "韩国首尔市江南区", explain: "国技院，又称世界跆拳道总部，地处韩国首尔市江南区，于1972年11月30日落成，其功能包括负责跆拳道品、段考试及发放品、段证书，并且从事跆拳道的研究事务。", source: "CMRC 2018 · 韩国国技院" },
  { question: "哈林环球旅行者篮球队的总部位于哪里？", category: "百科知识", answer: "纽约市哈林区", explain: "哈林环球旅行者篮球队，简称：哈林篮球队），是一支以表演花式篮球的美国职业篮球队，总部位于纽约市哈林区。", source: "CMRC 2018 · 哈林篮球队" },
  { question: "五羊邨站的公共洗手间位于哪儿？", category: "百科知识", answer: "站厅层A出入口处", explain: "另外，本站的公共洗手间位于站厅层A出入口处。", source: "CMRC 2018 · 五羊邨站" },
  { question: "什么样的家庭有时会让邻居充当托儿员照顾他们的年幼子女？", category: "百科知识", answer: "双薪家庭", explain: "有时家中一些必需品用完也会向邻居暂借，如调味品、清洁用品等，而一些双薪家庭也会由邻居充当托儿员，照顾他们的年幼子女。", source: "CMRC 2018 · 近邻社区" },
  { question: "什么时候开始，中国和俄罗斯境内的赫哲族均受到了很大程度的汉化和俄化？", category: "百科知识", answer: "20世纪中叶", explain: "从20世纪中叶起，中国和俄罗斯境内的赫哲族均受到了很大程度的汉化和俄化，赫哲语在族内的母语地位被汉语和俄语代替，赫哲语面临濒危。", source: "CMRC 2018 · 赫哲语" },
  { question: "谁出版了以潮流用语为主题编著的学习教材的《香港潮语话斋》？", category: "百科知识", answer: "彭志铭", explain: "曾经有人以潮流用语为主题编著学习教材，如中学老师苏扬真(笔名:苏真真)出版的潮语学习卡和岭南大学教授彭志铭出版的香港潮语话斋。", source: "CMRC 2018 · 流行语" },
  { question: "谁被委任为首位华人布政司，成为香港拥有第二高权力的人？", category: "百科知识", answer: "陈方安生", explain: "鉴于距离香港回归时间不远，英方遂逐步将主要司局级官员改由香港华人出任，11月，陈方安生被委任为首位华人布政司，成为香港拥有第二高权力的人士。", source: "CMRC 2018 · 1993年香港" },
  { question: "谁的报告指出女神响尾蛇的幼种约在七月下旬至十月中旬期间能于野外发现？", category: "百科知识", answer: "格里斯墨尔", explain: "据格里斯墨尔（Grismer）的研究报告，指约在七月下旬至十月中旬期间能于野外发现女神响尾蛇的幼种。", source: "CMRC 2018 · 女神响尾蛇" },
  { question: "几位科学家使用什么工具发现了HVC 127-41-330？", category: "百科知识", answer: "阿雷卡纳特射电天文望远镜", explain: "布利茨（Leo Blitz）三位天文学家通过波多黎各的阿雷卡纳特射电天文望远镜观察到的。", source: "CMRC 2018 · HVC 127-41-330" },
  { question: "何时来自马西利亚的探险家毕提亚斯成为最早能够区别凯尔特人和日耳曼人的地中海人？", category: "百科知识", answer: "约公元前320年", explain: "约公元前320年，来自马西利亚的探险家毕提亚斯航行至不列颠和北欧沿海，成为最早能够区别凯尔特人和日耳曼人的地中海人。", source: "CMRC 2018 · 日耳曼尼亚" },
  { question: "何时当局机场确认会给予冠名，以纪念对柏林市有重要贡献之人士？", category: "百科知识", answer: "2007年", explain: "2007年，当局机场确认会给予冠名，以纪念对柏林市有重要贡献之人士。", source: "CMRC 2018 · 柏林勃兰登堡机场" },
  { question: "哪一年他加盟意乙俱乐部切沃，随后陆续以租借身份效力于一些低级别的俱乐部？", category: "百科知识", answer: "1998年", explain: "1998年，他加盟意乙俱乐部切沃，随后陆续以租借身份效力于一些低级别的俱乐部。", source: "CMRC 2018 · 尼古拉·莱罗塔列" },
  { question: "什么时候蒙古人把布里亚特人纳入草原封建帝国的政治系统内？", category: "百科知识", answer: "元代", explain: "在元代，蒙古人把他们纳入草原封建帝国的政治系统内。", source: "CMRC 2018 · 布里亚特人" },
  { question: "什么时候陶鹰鼎被列为中华人民共和国禁止出国（境）展览文物之一？", category: "百科知识", answer: "2002年", explain: "2002年列为中华人民共和国禁止出国（境）展览文物之一，现藏中国国家博物馆。", source: "CMRC 2018 · 陶鹰鼎" },
  { question: "什么的好处是通过具体事例来说明事物的特点，把抽象、复杂的事物或事理说得具体？", category: "百科知识", answer: "举例说明", explain: "举例说明：举出具有代表性的例子来说明事物的本质、特征。", source: "CMRC 2018 · 说明文" },
  { question: "谁认为天历在癸好三年二月初十以前，与阴历阳历完全相同？", category: "百科知识", answer: "萧一山", explain: "天历不阴不阳，萧一山认为天历在癸好三年二月初十以前，与阴历阳历完全相同。", source: "CMRC 2018 · 太平天历" },
  { question: "哪个威尔斯诗人曾经因为未能赶及在潮涨前离开而被困岛上一晚？", category: "百科知识", answer: "狄兰·托马斯", explain: "著名威尔斯诗人狄兰·托马斯(Dylan Thomas)曾经因为未能赶及在潮涨前离开而被困岛上一晚。", source: "CMRC 2018 · 罗西里" },
  { question: "哪两座城市参与了第三十三届夏季奥林匹克运动会的最终角逐？", category: "百科知识", answer: "巴黎以及洛杉矶", explain: "共有两座城市参与最终角逐，分别是巴黎以及洛杉矶。", source: "CMRC 2018 · 2024年夏季奥林匹克运动会" },
  { question: "什么时候，慧卡取代了吉玛·沃德（Gemma Ward）的位置？", category: "百科知识", answer: "2007年1月起", explain: "2007年1月起，慧卡取代了吉玛·沃德（Gemma Ward）的位置，被模特儿权威网站model.com封-{后}-，2010年2月更跻身殿堂级超模。", source: "CMRC 2018 · 慧卡·芝玛曼" },
  { question: "什么时候五马街被命名为国家级“百城万店无假货”示范街？", category: "百科知识", answer: "1999年", explain: "1999年，被命名为国家级“百城万店无假货”示范街。", source: "CMRC 2018 · 五马街" },
  { question: "深水埗关帝庙最初的名称是什么？", category: "百科知识", answer: "协天宫", explain: "深水埗关帝庙，最初称为协天宫，其后更名深水埗武帝庙，是香港一所关帝庙，供奉三国时期蜀国大将关羽，位于九龙深水埗海坛街与界限街交界，建筑物背靠深水埗公立医局，是九龙区唯一供奉关帝的庙宇，由华人庙宇委员会管理。", source: "CMRC 2018 · 深水埗关帝庙" },
  { question: "大莱龙铁路位于哪里？", category: "百科知识", answer: "山东省北部环渤海地区", explain: "大莱龙铁路位于山东省北部环渤海地区，西起位于益羊铁路的潍坊大家洼车站，向东经海化、寿光、寒亭、昌邑、平度、莱州、招远、终到龙口，连接山东半岛羊角沟、潍坊、莱州、龙口四个港口，全长175公里，工程建设概算总投资11.42亿元。", source: "CMRC 2018 · 大莱龙铁路" },
  { question: "美国特勤局隶属于什么部门？", category: "百科知识", answer: "美国国土安全部", explain: "美国特勤局（又译美国特勤处、美国秘勤局等，英文：United States Secret Service，缩写USSS）是美国联邦政府的执法机构，隶属于美国国土安全部。", source: "CMRC 2018 · 美国特勤局" },
  { question: "中国空间技术研究院属于什么公司？", category: "百科知识", answer: "中国航天科技集团公司", explain: "中国空间技术研究院（China Academy of Space Technology，简称CAST）隶属于中国航天科技集团公司，是中国空间技术的主要研究中心和航天器研制、生产基地，成立于1968年2月20日。", source: "CMRC 2018 · 中国空间技术研究院" },
  { question: "澳门瑞吉金沙城中心酒店位于什么地方？", category: "百科知识", answer: "路氹城塡海区金光大道地段", explain: "澳门瑞吉金沙城中心酒店（St. Regis Macao, Cotai Central），位于路氹城塡海区金光大道地段，是路氹金光大道中一个五星级酒店发展项目．毗连澳门喜来登酒店、澳门金沙城中心假日酒店以及澳门金沙城中心康莱德酒店。", source: "CMRC 2018 · 澳门瑞吉金沙城中心酒店" },
  { question: "VIRGOHI21星系位于哪个星系群中？", category: "百科知识", answer: "室女座星系群", explain: "VIRGOHI21星系位于室女座星系群中，2007年6月18日美国康奈尔大学科学家领导的国际天文学研究小组宣布，最终证实该天体构造其实是一个暗星系，其尺寸与普通的星系差不多，但却完全由暗物质组成。", source: "CMRC 2018 · VIRGOHI21" },
  { question: "沈阳造币厂隶属于哪个公司？", category: "百科知识", answer: "中国印钞造币总公司", explain: "沈阳造币厂隶属于中国印钞造币总公司，是中国政府指定的专门从事法定货币生产的特殊企业，主要生产流通硬币、金银纪念币、铜合金坯饼和工业金银材，是中国目前铜合金硬币生产基地，占地149147平方米，现有职工1500余人。", source: "CMRC 2018 · 沈阳造币厂" },
  { question: "重要的地标性建筑主要位于共和广场哪里？", category: "百科知识", answer: "北部", explain: "最重要的地标为圣巴尔多禄茂主教座堂（1295年兴建，1993年成为主教座堂）、比尔森市政厅（自1496年起）和圣母玛丽亚黑死病纪念柱（1681年），全部位于广场的北部。", source: "CMRC 2018 · 共和国广场 (比尔森)" },
  { question: "槲鸫属于什么科？", category: "百科知识", answer: "鸫科鸫属", explain: "槲鸫（学名：\"\"）属于鸫科鸫属，是一种常见雀鸟，广泛分布于欧洲、非洲北部、北亚中部、中亚及中国西部的疏林和耕地，其中中国境内仅有新疆西南部、西北部天山分布有\"T. v. bonapartei\"。", source: "CMRC 2018 · 槲鸫" },
  { question: "苏黎世圣彼得教堂位于什么地方？", category: "百科知识", answer: "毗邻Lindenhof 山", explain: "教堂毗邻Lindenhof 山，昔日罗马城堡的地点，兴建在朱庇特神庙的遗址上. 8或者9世纪的早期教堂为10 乘 7 米大小，大约1000年前后改建为罗曼式教堂，1230年改为后期罗曼式，1460年重建为哥特式教堂。", source: "CMRC 2018 · 苏黎世圣彼得教堂" },
  { question: "新濠锋酒店位于什么地方？", category: "百科知识", answer: "氹仔广东大马路", explain: "新濠锋酒店（），前称皇冠酒店（），位于氹仔广东大马路，是澳门第一家以六星级酒店标准所建造的五星级酒店，于2007年5月9日试业，并于2007年5月12日举行开幕典礼。", source: "CMRC 2018 · 新濠锋酒店" },
  { question: "深圳体育场位于什么位置？", category: "百科知识", answer: "深圳市福田区笔架山下", explain: "深圳体育场，座落于深圳市福田区笔架山下，东邻上步北路，北接泥岗西路，南靠笋岗路，落成于1993年6月，总面积达到24892平方米，总投资1.41亿元人民币，场地包含一个主体育场及1个副场。", source: "CMRC 2018 · 深圳体育场" },
  { question: "多伦多全科医院位于什么位置？", category: "百科知识", answer: "加拿大安大略省多伦多市中心", explain: "多伦多全科医院（英文：Toronto General Hospital）位于加拿大安大略省多伦多市中心，是市内一座主要教学医院，亦是的一分子，与多伦多大学医学院关系密切。", source: "CMRC 2018 · 多伦多全科医院" },
  { question: "斯诺登站位于什么地方？", category: "百科知识", answer: "加拿大魁北克省蒙特利尔市", explain: "斯诺登站（、）位于加拿大魁北克省蒙特利尔市，是蒙特利尔地铁2号线及5号线的换乘站，设有上下4个月台，并以岛式月台排列，跨月台转车站的转乘设计让乘客只要走到对面月台便可转线。", source: "CMRC 2018 · 斯诺登站" },
  { question: "云起游戏全称是什么？", category: "百科知识", answer: "云起游戏代理有限公司", explain: "云起游戏代理有限公司（Run Up Game Distribution Limited），简称云起游戏，于2002年成立，主要业务为营运线上游戏以及代理销售其相关产品。", source: "CMRC 2018 · 云起游戏" },
  { question: "盐排高速公路位于那座城市？", category: "百科知识", answer: "深圳市", explain: "盐排高速公路是位于广东省深圳市的一条高速公路，又名深圳市机荷高速公路盐田港支线，于2006年5月10日建成通车，现为长深高速公路及武深高速公路（仁深高速公路）的并行路段。", source: "CMRC 2018 · 盐排高速公路" },
  { question: "长洲渡轮码头位于哪里？", category: "百科知识", answer: "长洲的中西部沿岸", explain: "长洲渡轮码头（）是香港长洲岛民日常对外交通的枢纽，是港外线渡轮码头，位于长洲的中西部沿岸，其西边是长洲避风塘，南面毗邻为长洲公众码头，西边是长洲最繁盛的市中心新兴海傍街。", source: "CMRC 2018 · 长洲渡轮码头" },
  { question: "关中书院，位于哪里？", category: "百科知识", answer: "中国陕西省西安市", explain: "关中书院，是一所位于中国陕西省西安市的书院，始建于明朝万历三十七年（1609年），天启六年（1626年）一度被禁毁，后于清朝康熙三年（1664年）重建，一度成为全国四大著名书院之一，也是西北四大书院之执牛耳者。", source: "CMRC 2018 · 关中书院" },
  { question: "长洲北帝庙位于什么地方？", category: "百科知识", answer: "香港离岛区长洲北社街北端", explain: "长洲北帝庙，又名长洲玉虚宫，位于香港离岛区长洲北社街北端，建于清朝乾隆四十八年（1783年），有二百多年历史，已获古物咨询委员会评定为一级历史建筑物，是全香港最具规模的北帝庙，除北帝外，庙内亦供奉太岁、观音及列圣。", source: "CMRC 2018 · 长洲北帝庙" },
  { question: "姆西里王国名称的由来是什么？", category: "百科知识", answer: "其统治者是姆西里", explain: "姆西里王国，又称“叶克王国”(Yeke Kingdom)、“加朗甘兹王国”(1856－1891年)，是曾建立于今刚果东南部的加丹加地区的一个王国，其统治者是姆西里，因此得名。", source: "CMRC 2018 · 姆西里王国" },
  { question: "湖南路街道位于什么地方？", category: "百科知识", answer: "徐汇区东北部", explain: "，位于徐汇区东北部，东以陕西南路与黄浦区瑞金二路街道相邻，西以兴国路毗邻长宁区，北以长乐路、华山路毗邻静安区，南临复兴中路、淮海中路，面积1.73平方公里，有居委会16个，户籍人口5.34万人（2008年）。", source: "CMRC 2018 · 湖南路街道 (上海市)" },
  { question: "山景巴士总站位于什么地方？", category: "百科知识", answer: "香港新界屯门区", explain: "山景巴士总站（英文：Shan King Bus Terminus）是香港新界屯门区一个巴士总站，位于菠萝山以东山脚下旺贤街，在山景邨旁，邻近轻铁石排站，现时有3条巴士路线以此处为总站。", source: "CMRC 2018 · 山景巴士总站" },
  { question: "RTECS中主要包括几类化学物质的毒性数据？", category: "百科知识", answer: "六大类", explain: "RTECS中主要包括以下六大类化学物质的毒性数据：其中记录有该化学物质的数值毒性值，如半数致死量（LD50或LC50），最低中毒剂量（TDLo），最低中毒浓度（TCLo）等，以及实验所使用的物种和给药途径。", source: "CMRC 2018 · 化学物质毒性数据库" },
  { question: "吉泰盆地位于哪儿？", category: "百科知识", answer: "中国江西省中部、赣江中游", explain: "吉泰盆地，在地质学上又称为吉安凹陷，是位于中国江西省中部、赣江中游的一个盆地，面积1.87万平方公里，地域上包括吉安市所辖的吉州区、青原区、泰和县、吉水县、吉安县、永丰县、新干县、峡江县、安福县、万安县等10个区县。", source: "CMRC 2018 · 吉泰盆地" },
  { question: "哪一句俗语可以表现这种即使没有血缘关系的邻居在传统社会里关系也很亲密的情况？", category: "百科知识", answer: "远亲不如近邻", explain: "即使没有血缘关系的邻居，在传统社会里，关系也很亲密，俗语「远亲不如近邻」就表现了这种关系，而在乡村地区，近邻社区内不少重大事务都要邻居们一起讨论，寻求共识，平日亦要发挥守望相助的精神。", source: "CMRC 2018 · 近邻社区" },
  { question: "在组成大雷克雅维克地区的七个自治市当中，哪个市人口最多？", category: "百科知识", answer: "雷克雅维克", explain: "大雷克雅维克（，意指「首都地区」）是指雷克雅维克及其周围六个自治市的区域。", source: "CMRC 2018 · 大雷克雅未克区" },
  { question: "先前拥有免税特权的土地，包括寺社领等，都取消了，这一点基于什么原则？", category: "百科知识", answer: "全国土地均要上缴地租", explain: "由于实行地租改正，在全国土地均要上缴地租的原则下，先前拥有免税特权的土地，包括寺社领等，均一一取消。", source: "CMRC 2018 · 上知令" },
  { question: "在1990年代中期的英国地方政府改革中，很多非都会郡都开始重组成什么？", category: "百科知识", answer: "单一管理区", explain: "在1990年代中期的英国地方政府改革中，很多非都会郡都开始重组成为单一管理区。", source: "CMRC 2018 · 1997年郡尉职权法案" },
  { question: "是谁主张内阁成员应该由参加过华盛顿会议的代表和「好政府主义」的支持者组成？", category: "百科知识", answer: "吴佩孚", explain: "之后，吴佩孚主张内阁成员应该由参加过华盛顿会议的代表和「好政府主义」的支持者组成，以改善政府形象。", source: "CMRC 2018 · 王宠惠内阁" },
  { question: "总政治部是何时确认使用“中国人民解放军总政治部”这一名称的？", category: "百科知识", answer: "1954年", explain: "其前身是1930年创建的中共中央军委总政治部，1954年正式改称中国人民解放军总政治部。", source: "CMRC 2018 · 中国人民解放军总政治部" },
  { question: "谁获得Indonesian Idol 2008(印尼偶像第4届)的亚军？", category: "百科知识", answer: "吉塞拉·阿纳斯塔西娅", explain: "印度尼西亚女歌手吉塞拉·阿纳斯塔西娅（Gisella Anastasia）1990年11月16 出生在泗水，， 年龄18岁，东爪哇，是Indonesian Idol 2008(印尼偶像第4届)的亚军，印尼华侨，懂英语和印尼语。", source: "CMRC 2018 · 吉塞拉·阿纳斯塔西娅" },
  { question: "澎湖群岛是台湾三大火山群之一，除了花屿之外，各岛大多由什么组成？", category: "百科知识", answer: "玄武岩", explain: "澎湖玄武岩自然保留区位于台湾澎湖县，包含锭钩屿、鸡善屿及小白沙屿3个无人岛，主要的保育对象为当地特殊的玄武岩地形景观。", source: "CMRC 2018 · 澎湖玄武岩自然保留区" },
  { question: "什么是马其顿军队与雅典人所领导的希腊城邦联军在拉米亚战争中的最后一场海战？", category: "百科知识", answer: "阿玛格斯战役", explain: "阿玛格斯战役（Battle of Amorgos），发生在公元前322年七月，是马其顿军队与雅典人所领导的希腊城邦联军在拉米亚战争中的最后一场海战，此战终结了雅典海军。", source: "CMRC 2018 · 阿玛格斯战役" },
  { question: "谁的海上势力几乎笼罩爱琴海各岛屿，拥有当时爱琴海的制海权", category: "百科知识", answer: "托勒密埃及", explain: "此时，托勒密埃及的海上势力几乎笼罩爱琴海各岛屿，拥有当时爱琴海的制海权，还拥有一支约300艘且主要由腓尼基人所组成的舰队，同时也和海军强国罗德岛同盟。", source: "CMRC 2018 · 科斯岛战役" },
  { question: "西澳州政府体-{制}-是隶属于哪个国家宪法的政府体-{制}？", category: "百科知识", answer: "澳大利亚", explain: "西澳州政府体-{制}-是隶属于澳大利亚宪法的政府体-{制}-，成立于1890年，百余年来经历多次修订。", source: "CMRC 2018 · 西澳大利亚州政府" },
  { question: "梁次震宇宙学与粒子天文物理学研究中心未来将迁至的宇宙观大楼位于哪里？", category: "百科知识", answer: "物理新馆与天数馆之间", explain: "目前该单位位于台大物理系新馆8楼，未来将迁至将于2015年6月开始兴建之宇宙馆大楼，位于物理新馆与天数馆之间。", source: "CMRC 2018 · 梁次震宇宙学与粒子天文物理学研究中心" },
  { question: "该路线穿过上西城之后，在西110街开始再次把名称改为什么？", category: "百科知识", answer: "晨边快速路", explain: "该路线穿过上西城之后，在西110街开始再次更名为晨边快速路（Morningside Drive），向北穿过晨边高地，直到122街。", source: "CMRC 2018 · 第九大道" },
  { question: "海马集团自军事产业转换为游戏开发产业后，将公司的名称改为什么？", category: "百科知识", answer: "海马娱乐集团", explain: "海马濑人就任后，海马集团自军事产业转换为游戏开发产业，公司名改为「海马娱乐集团」；", source: "CMRC 2018 · 游戏王系列角色列表" },
  { question: "哪个球场由2005/06球季开始成为拜仁慕尼黑及慕尼黑1860两间球会的新主场？", category: "百科知识", answer: "安联球场", explain: "安联球场（，因冠名权售予德国的安联保险公司而命名）是一座位于慕尼黑北部的专业足球场，2005年4月正式启用，由2005/06球季开始成为拜仁慕尼黑及慕尼黑1860两间球会的新主场，代替自1972年起使用的慕尼黑奥林匹克体育场。", source: "CMRC 2018 · 安联球场 (慕尼黑)" },
  { question: "阿拉伯文数字被大多数使用阿拉伯文的国家使用，这包括哪些国家？", category: "百科知识", answer: "阿拉伯国家和大多其他西亚国家", explain: "这种数字被大多数使用阿拉伯文的国家使用，这包括阿拉伯国家和大多其他西亚国家。", source: "CMRC 2018 · 阿拉伯文数字" },
  { question: "《战国无双3》是由哪两个公司合作开发的？", category: "百科知识", answer: "光荣和ω-force", explain: "《战国无双3》（）是由光荣和ω-force开发的战国无双系列的正统第三续作。", source: "CMRC 2018 · 战国无双3" },
  { question: "男女主角亦有专属声优这一模式是由谁改编的？", category: "百科知识", answer: "村雨城", explain: "此模式是任天堂游戏谜之村雨城改编的新增模式。", source: "CMRC 2018 · 战国无双3" },
  { question: "战国史模式主打哪两个模式？", category: "百科知识", answer: "「战史演武」&「争霸演武」", explain: "主打两大模式「战史演武」&「争霸演武」。", source: "CMRC 2018 · 战国无双3" },
  { question: "锣鼓经常用的节奏型称为什么？", category: "百科知识", answer: "锣鼓点", explain: "常用的节奏型称为「锣鼓点」。", source: "CMRC 2018 · 锣鼓经" },
  { question: "戏曲锣鼓所运用的敲击乐器主要有什么类型？", category: "百科知识", answer: "鼓、锣、钹和板", explain: "戏曲锣鼓所运用的敲击乐器主要分为鼓、锣、钹和板四类型：鼓类包括有单皮鼓（板鼓）、大鼓、大堂鼓(唐鼓)、小堂鼓、怀鼓、花盆鼓等；", source: "CMRC 2018 · 锣鼓经" },
  { question: "苏镜宇的原名叫什么？", category: "百科知识", answer: "苏博", explain: "苏镜宇原名苏博，因为婶婶认为他命中缺金，改名镜宇。", source: "CMRC 2018 · 苏镜宇" },
  { question: "小灰头稚冠雉生活在什么地带？", category: "百科知识", answer: "热带及亚热带的环境", explain: "牠们栖息在热带及亚热带的环境，由美国德克萨斯州瑞欧格兰山谷（Rio Grande Valley）丛林至哥斯达黎加的最北部。", source: "CMRC 2018 · 小灰头稚冠雉" },
  { question: "小灰头稚冠雉成鸟头部和颈部是什么颜色？", category: "百科知识", answer: "灰色", explain: "成鸟的头部及颈部是灰色的，身体及双翼都呈深橄榄褐色。", source: "CMRC 2018 · 小灰头稚冠雉" },
  { question: "小灰头稚冠雉一般会在什么季节繁殖？", category: "百科知识", answer: "雨季", explain: "小灰头稚冠雉一般会在雨季繁殖。", source: "CMRC 2018 · 小灰头稚冠雉" },
  { question: "小灰头稚冠雉的蛋的外表有什么特征？", category: "百科知识", answer: "表面粗糙，呈白色至奶白色", explain: "牠们每次会生2-4颗蛋，蛋表面粗糙，呈白色至奶白色。", source: "CMRC 2018 · 小灰头稚冠雉" },
  { question: "复兴社干事会的十三人号称什么？", category: "百科知识", answer: "“十三太保”", explain: "干事会的主要成员有贺衷寒、桂永清、肖赞育、滕杰、康泽、戴笠、郑介民等十三人，号称“十三太保”。", source: "CMRC 2018 · 中华民族复兴社" },
  { question: "复兴社之后出版了什么杂志？", category: "百科知识", answer: "《中国革命》、《前途》等", explain: "复兴社还出版《中国革命》、《前途》等杂志。", source: "CMRC 2018 · 中华民族复兴社" },
  { question: "邓飏是哪里人？", category: "百科知识", answer: "南阳新野", explain: "邓飏（），字玄茂，南阳新野人。", source: "CMRC 2018 · 邓飏" },
  { question: "邓飏和哪些人并称为「四聪」？", category: "百科知识", answer: "夏侯玄、诸葛诞和田畴", explain: "与夏侯玄、诸葛诞和田畴并称为「四聪」。", source: "CMRC 2018 · 邓飏" },
  { question: "邓飏和李胜为令曹爽立威信，给他提出了什么建议？", category: "百科知识", answer: "征伐蜀汉", explain: "及后李胜和邓飏为了令曹爽立威信，建议曹爽征伐蜀汉，曹爽听从并于正始五年（244年）从长安率兵经骆谷伐蜀。", source: "CMRC 2018 · 邓飏" },
  { question: "邓飏的下场是什么？", category: "百科知识", answer: "被诛杀、夷三族", explain: "事后曹爽被控告谋反，邓飏等党羽都曹爽一同被捕，被指控与曹爽同谋，其后被诛杀、夷三族。", source: "CMRC 2018 · 邓飏" },
  { question: "福林德斯大学设立在什么地方？", category: "百科知识", answer: "澳大利亚南澳首府阿德雷得", explain: "简称Flinders），是一所1966年设立于澳大利亚南澳首府阿德雷得的中小型公立综合大学。", source: "CMRC 2018 · 福林德斯大学" },
  { question: "福林德斯大学大学开办第一年有多少学生？", category: "百科知识", answer: "400余位", explain: "开办第一年的福林德斯大学仅有90位教职员、四所学系、400余位学生。", source: "CMRC 2018 · 福林德斯大学" },
  { question: "Adobe OnLocation的适用范围是什么？", category: "百科知识", answer: "笔记本电脑到工作站等", explain: "它为用户提供高质量的视频多媒体文件，涵盖了笔记本电脑到工作站等广泛的适用范围。", source: "CMRC 2018 · Adobe OnLocation" },
  { question: "高豆莫是哪个部落的首领？", category: "百科知识", answer: "扶余人部落", explain: "高豆莫是位于现在中国东北的扶余人部落的部落首领。", source: "CMRC 2018 · 高豆莫" },
  { question: "卒本扶余是哪个国家的一个延续？", category: "百科知识", answer: "北扶余国", explain: "高豆莫的部落卒本扶余是北扶余国的一个延续。", source: "CMRC 2018 · 高豆莫" },
  { question: "高豆莫在哪一年将东明国和北扶余合并为卒本扶余？", category: "百科知识", answer: "前108年", explain: "前108年，高豆莫征服北扶余，将东明国和北扶余合并为卒本扶余。", source: "CMRC 2018 · 高豆莫" },
  { question: "前37年，朱蒙建立了什么国家?", category: "百科知识", answer: "高句丽国", explain: "前37年，朱蒙建高句丽国。", source: "CMRC 2018 · 高豆莫" },
  { question: "桓檀古记记载中，一些书籍把高朱蒙称为什么？", category: "百科知识", answer: "高豆莫汗", explain: "桓檀古记记载：在一些书籍里也把高朱蒙称为高豆莫汗。", source: "CMRC 2018 · 高豆莫" },
  { question: "德意志-奥地利共和国是什么国家解体后所建立的政权?", category: "百科知识", answer: "奥匈帝国", explain: "德意志-奥地利共和国（），是第一次世界大战结束，奥匈帝国解体后，其境内说德语的人所短暂建立的政权。", source: "CMRC 2018 · 德意志-奥地利共和国" },
  { question: "王沈的字是什么？", category: "百科知识", answer: "处道", explain: "王沈，字处道，太原晋阳人。", source: "CMRC 2018 · 王沈 (太原)" },
  { question: "王沈是哪里人？", category: "百科知识", answer: "太原晋阳", explain: "王沈，字处道，太原晋阳人。", source: "CMRC 2018 · 王沈 (太原)" },
  { question: "魏甘露十年，曹髦与王沈、王经和王业商讨什么事情？", category: "百科知识", answer: "灭司马家族", explain: "魏甘露十年（260年），曹髦打算消灭司马家族，召王沈、王经、王业共商此事，后王沈与王业密告于司马昭。", source: "CMRC 2018 · 王沈 (太原)" },
  { question: "达特穆尔是什么地方的地名？", category: "百科知识", answer: "英格兰德文郡中部穆尔兰", explain: "达特穆尔是（）英格兰德文郡中部穆尔兰的一个地区，面积368平方英里（953平方公里），是一个受保护的国家公园。", source: "CMRC 2018 · 达特穆尔" },
  { question: "达特穆尔的面积是多大？", category: "百科知识", answer: "368平方英里", explain: "达特穆尔是（）英格兰德文郡中部穆尔兰的一个地区，面积368平方英里（953平方公里），是一个受保护的国家公园。", source: "CMRC 2018 · 达特穆尔" },
  { question: "花岗岩高地的历史可以追溯到什么时期？", category: "百科知识", answer: "地质时代的石炭纪", explain: "花岗岩高地的历史可以追溯到地质时代的石炭纪。", source: "CMRC 2018 · 达特穆尔" },
  { question: "达特穆尔的部分地区被用来作为什么长达两百年之久？", category: "百科知识", answer: "一个军事射击场", explain: "达特穆尔的部分地区被用来作为一个军事射击场达两百年之久。", source: "CMRC 2018 · 达特穆尔" },
  { question: "罗伯特·卡莱尔·吉芬出生在什么地方？", category: "百科知识", answer: "宾夕法尼亚州的西切斯特", explain: "罗伯特·卡莱尔·吉芬（Robert Carlisle Giffen）1886年6月29日出生于宾夕法尼亚州的西切斯特。", source: "CMRC 2018 · 罗伯特·C·吉芬" },
  { question: "罗伯特·卡莱尔·吉芬作为海军见习生毕业于哪一级？", category: "百科知识", answer: "1907级", explain: "在1903年进入内布拉斯加的美国海军学院前，他在印第安纳州的圣母大学学习，海军见习生吉芬毕业于1907级，被分配到弗吉尼亚号战列舰上。", source: "CMRC 2018 · 罗伯特·C·吉芬" },
  { question: "格利泽581b围绕哪颗行星运转？", category: "百科知识", answer: "格利泽581", explain: "格利泽581b是一颗围绕红矮星格利泽581运转的太阳系外行星。", source: "CMRC 2018 · 格利泽581b" },
  { question: "格利泽518b的质量至少是地球的多少倍？", category: "百科知识", answer: "90倍", explain: "对格利泽581b来说，其质量上限大约为地球质量的90倍，接近于土星的质量。", source: "CMRC 2018 · 格利泽581b" },
  { question: "林俊贤在八十九十年代是哪个电视台的当家小生？", category: "百科知识", answer: "无线电视", explain: "），于香港出生，香港男演员，与刘德华、周星驰 、 梁朝伟 、刘青云和温兆伦为1980,1990年代初为无线电视一线当家小生。", source: "CMRC 2018 · 林俊贤" },
  { question: "2017年林俊贤参与了什么剧？", category: "百科知识", answer: "《风林火山》", explain: "2017年林俊贤再次加盟 《邵氏兄弟电影公司》 ， 参演《风林火山》 。", source: "CMRC 2018 · 林俊贤" },
  { question: "教堂形状是什么样的？", category: "百科知识", answer: "一颗泪珠", explain: "“Dominus Flevit”，从拉丁语翻译意为“上帝哭了”，教堂形状似一颗泪珠象征耶稣的眼泪。", source: "CMRC 2018 · 主哭耶京堂" },
  { question: "古老遗迹可以追溯到什么时期？", category: "百科知识", answer: "迦南时期", explain: "在施工期间，圣殿考古学家发掘出的文物可以追溯到迦南时期，并发现第二圣殿和拜占庭时代的古墓。", source: "CMRC 2018 · 主哭耶京堂" },
  { question: "1187年耶路撒冷沦陷后主泣教堂面临了什么样的结局？", category: "百科知识", answer: "教堂被毁灭", explain: "1187年耶路撒冷沦陷后，教堂被毁灭。", source: "CMRC 2018 · 主哭耶京堂" },
  { question: "现在的教堂的设计师是谁？", category: "百科知识", answer: "安东尼·巴卢奇", explain: "设计师为安东尼·巴卢奇。", source: "CMRC 2018 · 主哭耶京堂" },
  { question: "华硕Eee这系列是哪一年推出的？", category: "百科知识", answer: "2007年", explain: "华硕Eee是华硕开发的电脑系列，此系列以2007年推出的Eee PC netbook为开始。", source: "CMRC 2018 · 华硕Eee系列" },
  { question: "《停止！！ 云雀》是谁的漫画作品？", category: "百科知识", answer: "江口寿史", explain: "云雀(ストップ!!_ひばりくん!)，是日本漫画家江口寿史的漫画作品，于周刊少年Jump连载。", source: "CMRC 2018 · 停止！！云雀" },
  { question: "《停止！！ 云雀》在哪个杂志上连载？", category: "百科知识", answer: "《周刊少年Jump》", explain: "在《周刊少年Jump》(WJ，集英社)杂志上从1981年（昭和56年）45号到1983年（昭和58年）51号其中夹杂了多次的停止刊载。", source: "CMRC 2018 · 停止！！云雀" },
  { question: "丘姓在《百家姓》里排多少位？", category: "百科知识", answer: "第151位", explain: "丘是一个中文姓氏，丘（邱）姓在《百家姓》中排第151位。", source: "CMRC 2018 · 丘姓" },
  { question: "丘和哪个姓同源？", category: "百科知识", answer: "邱", explain: "丘是一个中文姓氏，丘（邱）姓在《百家姓》中排第151位。", source: "CMRC 2018 · 丘姓" },
  { question: "五胡乱华之后丘氏家族搬迁到了什么地方？", category: "百科知识", answer: "福建", explain: "到了晋朝，发生了五胡乱华，丘（邱）氏家族就移入福建，居住在莆田县宗头乡，成为闽籍邱氏世居之地。", source: "CMRC 2018 · 丘姓" },
  { question: "《白之春》在什么电视台上播放？", category: "百科知识", answer: "关西电视台", explain: "《白之春》（日文：白い春）是由关西电视台从2009年4月14日开始，到2009年6月，于每周星期二22:00-22:54（日本时间）播出。", source: "CMRC 2018 · 白之春" },
  { question: "《白之春》的主演是谁？", category: "百科知识", answer: "阿部宽与大桥望美", explain: "由阿部宽与大桥望美主演。", source: "CMRC 2018 · 白之春" },
  { question: "班登再也轻快铁站是哪个线路上的车站？", category: "百科知识", answer: "吉隆坡安邦线", explain: "班登再也轻快铁站（）是吉隆坡安邦线的其中一个车站。", source: "CMRC 2018 · 班登再也站" },
  { question: "班登再也轻快铁站在哪一年正式提升了站内设备？", category: "百科知识", answer: "2012年", explain: "自2012年起，为提升站内设备，本站开始布置跨铁轨之遮雨棚，以及在各自月台设立电梯、电动手扶梯、洗手间、祈祷间等各项设备。", source: "CMRC 2018 · 班登再也站" },
  { question: "杰米·海纳曼是什么大学的语言学博士？", category: "百科知识", answer: "印第安纳大学", explain: "詹姆斯·富兰克林·“杰米”·海纳曼（，）是美国的一名特效专家，印第安纳大学语言学学士，专长是俄语。", source: "CMRC 2018 · 杰米·海纳曼" },
  { question: "杰米·海纳曼以主持什么节目著称？", category: "百科知识", answer: "《流言终结者》", explain: "以其主持的电视节目《流言终结者》著称。", source: "CMRC 2018 · 杰米·海纳曼" },
  { question: "布洛涅森林在什么地方？", category: "百科知识", answer: "法国巴黎城西边", explain: "布洛涅森林，是法国巴黎城西边的一片森林，面积8.46平方公里，南北最长处3.5公里，东西最宽处2.6公里，属巴黎市政府管辖。", source: "CMRC 2018 · 布洛涅森林" },
  { question: "许申早年得到了谁的赏识？", category: "百科知识", answer: "陈尧佐", explain: "早年能文，深得潮州通判陈尧佐赏识。", source: "CMRC 2018 · 许申" },
  { question: "许申在什么时候担任韶州知州？", category: "百科知识", answer: "天禧初年（1017年）", explain: "天禧初年（1017年）任韶州（今广东韶关）知州，在韶州时，种植官道松榕数万株。", source: "CMRC 2018 · 许申" },
  { question: "许申的官途终止于什么职位？", category: "百科知识", answer: "刑部郎中", explain: "许申见其粗糙，上言新法之弊，被撤去刑部郎中之职。", source: "CMRC 2018 · 许申" },
  { question: "许申有什么著作？", category: "百科知识", answer: "《高阳集》", explain: "著有《高阳集》，刘允为之序。", source: "CMRC 2018 · 许申" },
  { question: "上海轨道交通16号线的编号是多少？", category: "百科知识", answer: "L2", explain: "本线在2010年之前的规划中番号定为上海轨道交通16号线，2010年后改为上海轨道交通21号线，编号L2，为上海一条规划建设的轨道交通路线。", source: "CMRC 2018 · 上海轨道交通16号线 (2010年前)" },
  { question: "美味牛肝菌又被称为什么？", category: "百科知识", answer: "大腿蘑、网纹牛肝菌", explain: "美味牛肝菌（学名：'）是一种可食用的蘑菇，也称大腿蘑、网纹牛肝菌，属于真菌类。", source: "CMRC 2018 · 美味牛肝菌" },
  { question: "美味牛肝菌的伞盖是什么颜色？", category: "百科知识", answer: "褐色", explain: "美味牛肝菌的子实体为肉质，伞盖褐色，直径最大可达25厘米，1千克重，菌盖厚，下面有许多小孔，类似牛肝，可生食，也可制成干制品。", source: "CMRC 2018 · 美味牛肝菌" },
  { question: "维尔纳·法伊曼担任过哪个国家的总理？", category: "百科知识", answer: "奥地利", explain: "），奥地利政治家、曾任奥地利总理。", source: "CMRC 2018 · 维尔纳·法伊曼" },
  { question: "维尔纳·法伊曼担任过哪个州州议会和市议会的议员？", category: "百科知识", answer: "维也纳州", explain: "他还担任青年社会主义维也纳州主席，从1985年至1994年，他成为维也纳州议会和市议会议员，同时担任住房建设和城市更新的多项职务。", source: "CMRC 2018 · 维尔纳·法伊曼" },
  { question: "维尔纳·法伊曼在哪个政府中担任创新科技部部长？", category: "百科知识", answer: "阿尔弗雷德·古森鲍尔政府", explain: "法伊曼在阿尔弗雷德·古森鲍尔政府任运输及创新科技部部长（2007－2008年）。", source: "CMRC 2018 · 维尔纳·法伊曼" },
  { question: "Playfish的游戏集中发布在什么类型的网站？", category: "百科知识", answer: "社交网站", explain: "Playfish的游戏集中发布于社交网站如Facebook、MySpace、Bebo以及 iPhone。", source: "CMRC 2018 · Playfish" },
  { question: "Playfish的总部在什么地方？", category: "百科知识", answer: "英国伦敦", explain: "公司的总部在英国伦敦，另外有分公司在中国北京、美国三藩市和挪威特罗姆瑟。", source: "CMRC 2018 · Playfish" },
  { question: "2008年10月Playfish获得了多少融资？", category: "百科知识", answer: "170万美元", explain: "在2008年10月，Playfish成功获得170万美元的融资。", source: "CMRC 2018 · Playfish" },
  { question: "上海漫唐堂主要进行哪些工作？", category: "百科知识", answer: "原创漫画的企划、创作和发售", explain: "主要进行原创漫画的企划、创作和发售。", source: "CMRC 2018 · 漫唐堂" },
  { question: "上海漫唐堂的主打作品之一是什么？", category: "百科知识", answer: "《1区212》", explain: "其中以四格漫画《1区212》最为有代表性。", source: "CMRC 2018 · 漫唐堂" },
  { question: "上海漫唐堂在国内首先提出了什么口号？", category: "百科知识", answer: "“团队无纸化漫画创作模式”", explain: "随着电脑绘画技术不断的普及，漫唐堂在国内首先提出了“团队无纸化漫画创作模式”。", source: "CMRC 2018 · 漫唐堂" },
  { question: "上海漫唐堂的主打作品在什么杂志的创刊号上连载？", category: "百科知识", answer: "《知音漫客》", explain: "2005年由口袋巧克力创作的《1区212》在杂志《知音漫客》创刊号上开始连载，并在国内获得了相当大的反响。", source: "CMRC 2018 · 漫唐堂" },
  { question: "罗店镇在什么地方？", category: "百科知识", answer: "浙江省金华市婺城区", explain: "罗店镇是浙江省金华市婺城区下辖的一个镇，位于金华市区北部，北靠兰溪市，是著名的花卉之乡，境内有国家级风景名胜区金华双龙洞。", source: "CMRC 2018 · 罗店镇 (金华市)" },
  { question: "罗店镇境内的国家级风景名胜区是什么？", category: "百科知识", answer: "金华双龙洞", explain: "罗店镇是浙江省金华市婺城区下辖的一个镇，位于金华市区北部，北靠兰溪市，是著名的花卉之乡，境内有国家级风景名胜区金华双龙洞。", source: "CMRC 2018 · 罗店镇 (金华市)" },
  { question: "罗店镇全镇面积是多大？", category: "百科知识", answer: "72平方公里", explain: "全镇总面积72平方公里，人口1.82万人口。", source: "CMRC 2018 · 罗店镇 (金华市)" },
  { question: "罗店镇１９７９年由什么机构管理？", category: "百科知识", answer: "罗店乡", explain: "1983年撤消人民公社，改设罗店乡。", source: "CMRC 2018 · 罗店镇 (金华市)" },
  { question: "赞尼特期又被称为什么时期？", category: "百科知识", answer: "兰登期或海尔斯期", explain: "赞尼特期（亦被称为兰登期或海尔斯期）是古新世的最后一个时期，与晚古新亚世相对应。", source: "CMRC 2018 · 赞尼特期" },
  { question: "赞尼特期这一名字源于什么？", category: "百科知识", answer: "赞尼特岩层", explain: "该阶名字来源于在伦敦盆地发现的最古老的古新世沉积层——赞尼特岩层，该岩层的名字则来自肯特地区的赞尼特岛。", source: "CMRC 2018 · 赞尼特期" },
  { question: "赞尼特期的欧洲处于什么气候？", category: "百科知识", answer: "热带性气候", explain: "Sézanne植物群落是在Sézanne的淡水石灰岩沉积层中发现的植物化石群落，属于赞尼特阶时期，这个时期欧洲为热带性气候。", source: "CMRC 2018 · 赞尼特期" },
  { question: "国际联盟是什么地方的一个联盟？", category: "百科知识", answer: "美国东部", explain: "国际联盟（International League，简称IL），是位于美国东部的美国职棒小联盟其中一个联盟。", source: "CMRC 2018 · 国际联盟 (棒球)" },
  { question: "１８８７年什么联盟加入了国际联盟？", category: "百科知识", answer: "东方联盟", explain: "国际联盟是从3个先前的联盟合并而成的：创立于1884年的东方联盟、创立于1885年的纽约州联盟和也于同年创立的安大略联盟。", source: "CMRC 2018 · 国际联盟 (棒球)" },
  { question: "曾炯是什么地方人？", category: "百科知识", answer: "江西南昌", explain: "曾炯()，字炯之，谱名祥江，江西南昌人，数学家。", source: "CMRC 2018 · 曾炯" },
  { question: "上海轨道交通17号线的编号是多少？", category: "百科知识", answer: "L3", explain: "本线在2010年前的规划中番号定为上海轨道交通17号线，2011年后改为上海轨道交通20号线，编号L3，为上海市规划中的轨道交通路线之一。", source: "CMRC 2018 · 上海轨道交通17号线 (2010年前)" },
  { question: "灰凤冠雉又名什么？", category: "百科知识", answer: "盔凤冠雉", explain: "灰凤冠雉（\"Pauxi pauxi\"），又名盔凤冠雉，是一种陆上的凤冠雉。", source: "CMRC 2018 · 灰凤冠雉" },
  { question: "灰凤冠雉可能来自于什么时期的分支？", category: "百科知识", answer: "中新世晚期", explain: "牠们可能是源自中新世晚期的分支。", source: "CMRC 2018 · 灰凤冠雉" },
  { question: "生命热线的旧会址在哪里？", category: "百科知识", answer: "九龙东头邨逸东楼", explain: "会址位于九龙东头邨逸东楼，于2011年1月10日乔迁坪石邨新址。", source: "CMRC 2018 · 生命热线" },
  { question: "当地居民称火山喷发的火山灰厚度约为多少？", category: "百科知识", answer: "1厘米", explain: "据当地居民称，火山喷出的火山灰覆盖了周围区域，厚度大约有1厘米。", source: "CMRC 2018 · 塔乌鲁火山" },
  { question: "省政府因火山喷发而把省会搬迁到了什么地方？", category: "百科知识", answer: "科可波", explain: "1994年，该火山与沃尔坎火山再度一起喷发，拉包尔绝大部分地区被废弃，并促使省政府将省会搬迁到科可波（Kokopo）。", source: "CMRC 2018 · 塔乌鲁火山" },
  { question: "紫冠雉的体长大约是多少？", category: "百科知识", answer: "长86厘米", explain: "紫冠雉是大型的鸟类，一般长86厘米及重1.7公斤。", source: "CMRC 2018 · 紫冠雉" },
  { question: "紫冠雉主要呈什么颜色？", category: "百科知识", answer: "深褐色", explain: "牠们主要呈深褐色，颈部及胸部有白色斑点。", source: "CMRC 2018 · 紫冠雉" },
  { question: "紫冠雉的蛋有什么特征？", category: "百科知识", answer: "蛋表面粗糙及呈白色", explain: "雌鸡每次会生2-3只蛋，蛋表面粗糙及呈白色。", source: "CMRC 2018 · 紫冠雉" },
  { question: "Noctis的第一版到第四版是用什么语言编写？", category: "百科知识", answer: "C语言及Assembly语言", explain: "Noctis的第一版到第四版（Noctis I-IV）是由C语言及Assembly语言编写的。", source: "CMRC 2018 · Noctis" },
  { question: "钟建民取得了大会的什么奖？", category: "百科知识", answer: "勇创高峰奖", explain: "大会又设立了勇创高峰奖，以鼓励不怕困难、勇于挑战自我的非竞技体育项目的运动员。", source: "CMRC 2018 · 香港体育记者协会" },
  { question: "新加坡官方目前采用什么字？", category: "百科知识", answer: "简体字", explain: "虽然新加坡官方目前采用简体字，与中国大陆相同，繁体字也在民间存在，不过在读写方面，新加坡主要还是以英文为主，其次才是中文。", source: "CMRC 2018 · 新加坡汉字" },
  { question: "在读写方面新加坡以什么语言为主？", category: "百科知识", answer: "英文", explain: "虽然新加坡官方目前采用简体字，与中国大陆相同，繁体字也在民间存在，不过在读写方面，新加坡主要还是以英文为主，其次才是中文。", source: "CMRC 2018 · 新加坡汉字" },
  { question: "新加坡1974年公布了什么文件？", category: "百科知识", answer: "《简体字总表》", explain: "1974年，又公布《简体字总表》，收简体字2248个，包括了中国公布的所有简化字，以及10个中国尚未简化的，如“要”、“窗”。", source: "CMRC 2018 · 新加坡汉字" },
  { question: "上海轨道交通18号线的编号为多少？", category: "百科知识", answer: "L5", explain: "上海轨道交通18号线，编号L5，为上海2010到2020年规划建设的一条贯穿城市南北的切向轨道交通路线，途径宝山、杨浦、浦东。", source: "CMRC 2018 · 上海轨道交通18号线" },
  { question: "上海轨道交通18号线途径哪里？", category: "百科知识", answer: "宝山、杨浦、浦东", explain: "上海轨道交通18号线，编号L5，为上海2010到2020年规划建设的一条贯穿城市南北的切向轨道交通路线，途径宝山、杨浦、浦东。", source: "CMRC 2018 · 上海轨道交通18号线" },
  { question: "上海轨道交通18号线一期工程的总长是多少？", category: "百科知识", answer: "36.8公里", explain: "一期工程从长江南路到航头，总长36.8公里，全程地下，设车站26座，已于2016年5月正式开工，预计2020年建成通车试运营。", source: "CMRC 2018 · 上海轨道交通18号线" },
  { question: "NGC 7318在哪个星系的方向上？", category: "百科知识", answer: "飞马座", explain: "NGC 7318（也称为UGC 12099/UGC 12100或HCG 92d/b）是在飞马座的方向上，距离3亿光年远的一组星系。", source: "CMRC 2018 · NGC 7318" },
  { question: "气炉以什么为燃料？", category: "百科知识", answer: "天然气、丙烷或其他可燃性气体", explain: "气炉是一种以天然气、丙烷或其他可燃性气体作为燃料以产生火焰的厨房煮食用具。", source: "CMRC 2018 · 气炉" },
  { question: "真正用于煮食的气炉在什么时间什么地点曾经被展示？", category: "百科知识", answer: "1851年的伦敦世博", explain: "真正用于煮食上的炉具于1851年的伦敦世博上展示，但当时的气体管路的铺设技术并不成熟，难以每家每户装设气炉，因此气炉并未能商业化地大量生产。", source: "CMRC 2018 · 气炉" },
  { question: "气炉在什么时候才走向商业化？", category: "百科知识", answer: "1880年代", explain: "至1880年代，气炉才走向商业化。", source: "CMRC 2018 · 气炉" },
  { question: "业务是什么的简称？", category: "百科知识", answer: "业务员、业务人员", explain: "业务也是业务员、业务人员的简称，是指一群专门做销售、行销的工作者，负责将公司之产品或服务销售给客户。", source: "CMRC 2018 · 业务" },
  { question: "业务负责什么工作？", category: "百科知识", answer: "将公司之产品或服务销售给客户", explain: "业务也是业务员、业务人员的简称，是指一群专门做销售、行销的工作者，负责将公司之产品或服务销售给客户。", source: "CMRC 2018 · 业务" },
  { question: "社会惰化又被叫做什么？", category: "百科知识", answer: "社会干扰、社会致弱、社会懈怠", explain: "社会惰化（）也叫社会干扰、社会致弱、社会懈怠，是一个社会心理学术语，指群体一起完成一件工作时，每个成员所付出的努力会少于单独完成工作时的现象。", source: "CMRC 2018 · 社会惰化" },
  { question: "纽西兰国防军分为哪两大体系？", category: "百科知识", answer: "军政与军令", explain: "纽西兰国防军则分为军政与军令两大体系。", source: "CMRC 2018 · 纽西兰国防军" },
  { question: "纽西兰国防军海军目前有多少艘舰艇？", category: "百科知识", answer: "10艘", explain: "目前海军有各类型主要舰艇约10艘。", source: "CMRC 2018 · 纽西兰国防军" },
  { question: "《抓鬼天狗帮》的作者是谁？", category: "百科知识", answer: "木下樱与东山和子", explain: "《抓鬼天狗帮》（日本原名：tactics）是一部由日本漫画家木下樱与东山和子所合作的日本漫画，以及由此漫画改编而成的日本电视动画。", source: "CMRC 2018 · 抓鬼天狗帮" },
  { question: "《抓鬼天狗帮》的小说由谁创作？", category: "百科知识", answer: "七海鸣", explain: "漫画第一部全15卷，由七海鸣创作的小说则已发售至第三卷。", source: "CMRC 2018 · 抓鬼天狗帮" },
  { question: "李婉华毕业于什么学校？", category: "百科知识", answer: "香港演艺学院", explain: "李婉华（，），香港演员，香港演艺学院毕业，与刘玉翠及张锦程等人同为毛俊辉的学生，后来拍摄实况剧，被无线电视的潘嘉德发掘，应邀演出剧集而出道，也演过很多电影。", source: "CMRC 2018 · 李婉华" },
  { question: "李婉华被谁发掘应邀出演剧集并由此出道？", category: "百科知识", answer: "潘嘉德", explain: "李婉华（，），香港演员，香港演艺学院毕业，与刘玉翠及张锦程等人同为毛俊辉的学生，后来拍摄实况剧，被无线电视的潘嘉德发掘，应邀演出剧集而出道，也演过很多电影。", source: "CMRC 2018 · 李婉华" },
  { question: "李婉华在1989年拍摄了哪部喜剧？", category: "百科知识", answer: "《公私三文治》", explain: "1989年，李婉华因拍摄处境喜剧《公私三文治》与同剧演员吴镇宇相恋，二人相恋8年后感情无疾而终。", source: "CMRC 2018 · 李婉华" },
  { question: "河北省文物研究所的前身是什么？", category: "百科知识", answer: "河北省文物管理委员会", explain: "研究所的前身是1953年成立的河北省文物管理委员会，后曾更名为“河北省文物工作队”和“河北省文物管理处”。", source: "CMRC 2018 · 河北省文物研究所" },
  { question: "广州大学法学院的前身是什么？", category: "百科知识", answer: "广州大学政法系", explain: "广州大学法学院是广州大学的下属学院，前身为广州大学政法系，创立于1984年，现任院长为邓成明教授。", source: "CMRC 2018 · 广州大学法学院" },
  { question: "该院的现任院长是谁？", category: "百科知识", answer: "邓成明", explain: "广州大学法学院是广州大学的下属学院，前身为广州大学政法系，创立于1984年，现任院长为邓成明教授。", source: "CMRC 2018 · 广州大学法学院" },
  { question: "狭义的唐音是什么时候传入日本的？", category: "百科知识", answer: "江户时代（明清）", explain: "包含室町时代传入的「宋音」与狭义的「唐音」，即江户时代（明清）传入的汉字音。", source: "CMRC 2018 · 唐音" },
  { question: "江户时代传入的「唐音」主要用于什么方面？", category: "百科知识", answer: "佛典诵读及学问研究", explain: "江户时代传入的「唐音」与之前的「宋音」一样，主要限于佛典诵读及学问研究等，对一般用语的影响很小，仅限于特定的词语。", source: "CMRC 2018 · 唐音" },
  { question: "华南理工大学法学院创立于哪一年？", category: "百科知识", answer: "1993年", explain: "华南理工大学法学院（知识产权学院），简称华工法学院，是华南理工大学的下属学院，前身为华南理工大学原人文社会科学学院法律系，创立于1993年，首任院长为葛洪义教授。", source: "CMRC 2018 · 华南理工大学法学院" },
  { question: "华南理工大学法学院首任院长是谁？", category: "百科知识", answer: "葛洪义", explain: "华南理工大学法学院（知识产权学院），简称华工法学院，是华南理工大学的下属学院，前身为华南理工大学原人文社会科学学院法律系，创立于1993年，首任院长为葛洪义教授。", source: "CMRC 2018 · 华南理工大学法学院" },
  { question: "华南理工大学法学院现有哪两个本科专业？", category: "百科知识", answer: "法学与知识产权", explain: "学院现有法学与知识产权两个本科专业；", source: "CMRC 2018 · 华南理工大学法学院" },
  { question: "2011年华南理工大学法学院获批了什么资格？", category: "百科知识", answer: "法学一级学科博士点", explain: "2011年，获批法学一级学科博士点。", source: "CMRC 2018 · 华南理工大学法学院" },
  { question: "在中世纪神学中，失范是什么意思？", category: "百科知识", answer: "不守法而亵渎神灵", explain: "在中世纪神学中，失范指不守法而亵渎神灵。", source: "CMRC 2018 · 失范" },
  { question: "涂尔干在1893年出版的什么著作里提出了自己的看法?", category: "百科知识", answer: "《社会分工论》", explain: "在1893出版的《社会分工论》中，涂尔干认为“失范只是暂时的规则匮乏状态，社会习俗仍旧可以规定和协调新的社会器官和功能及其相互关系。", source: "CMRC 2018 · 失范" },
  { question: "短兵在中国文化中是什么类型的兵器？", category: "百科知识", answer: "尺寸较短的冷兵器", explain: "短兵在中国文化当中是对尺寸较短的冷兵器，如短刀、剑等的统称。", source: "CMRC 2018 · 短兵" },
  { question: "短兵的创制是在什么时期？", category: "百科知识", answer: "20世纪初", explain: "20世纪初，短兵的创制受启发于日本剑道。", source: "CMRC 2018 · 短兵" },
  { question: "2009年哪个比赛上专设了短兵项目？", category: "百科知识", answer: "香港世界中华国术大赛", explain: "21世纪初，短兵热再度兴起，2009年香港世界中华国术大赛专设短兵项目。", source: "CMRC 2018 · 短兵" },
  { question: "衙门是哪些地区对于官署的称呼？", category: "百科知识", answer: "中国乃至东亚", explain: "衙门，本作牙门，又称官衙，为中国乃至东亚古代对官署的称呼，内有地方官员负责审理案件，衙门中的衙门差役就是协助地方官员搜查证据及逮捕犯人。", source: "CMRC 2018 · 衙门" },
  { question: "许国佐又名什么？", category: "百科知识", answer: "许钦翼", explain: "许国佐，又名许钦翼，号班王、旧庵、拙庵。", source: "CMRC 2018 · 许国佐" },
  { question: "许国佐是什么地方人？", category: "百科知识", answer: "揭阳县榕城（今榕城区）", explain: "揭阳县榕城（今榕城区）人。", source: "CMRC 2018 · 许国佐" },
  { question: "许国佐是哪一年的进士？", category: "百科知识", answer: "崇祯四年（1631年）", explain: "许国佐为天启七年（1627年）举人，崇祯四年（1631年）成进士，授四川富顺县正堂。", source: "CMRC 2018 · 许国佐" },
  { question: "许国佐有着哪些著作？", category: "百科知识", answer: "《蜀弦集》和《百洲堂集》等", explain: "著有《蜀弦集》和《百洲堂集》等。", source: "CMRC 2018 · 许国佐" },
  { question: "亚麻可能原产于什么地方？", category: "百科知识", answer: "西亚", explain: "是在全球各地广泛栽培的植物，可能原产于西亚。", source: "CMRC 2018 · 亚麻" },
  { question: "亚麻适宜生活在什么气候？", category: "百科知识", answer: "凉爽湿润气候", explain: "果实为蒴果，种子扁卵圆形，喜凉爽湿润气候。", source: "CMRC 2018 · 亚麻" },
  { question: "亚麻在中国主要在哪些地方栽培？", category: "百科知识", answer: "东北各地", explain: "也可制凉席，在中国主要在东北各地栽培。", source: "CMRC 2018 · 亚麻" },
  { question: "阿尔西比亚德斯是哪个国家的政治家？", category: "百科知识", answer: "雅典", explain: "阿尔西比亚德斯（希腊语：，，）是雅典杰出的政治家、演说家和将军。", source: "CMRC 2018 · 阿尔西比亚德斯" },
  { question: "阿尔西比亚德斯的家族在什么战争之后衰败？", category: "百科知识", answer: "伯罗奔尼撒战争", explain: "阿尔西比亚德斯是这个贵族家系的最后一名著名成员，这个家族在伯罗奔尼撒战争之后衰败。", source: "CMRC 2018 · 阿尔西比亚德斯" },
  { question: "约翰·达利是哪个国家的社会心理学家？", category: "百科知识", answer: "美国", explain: "约翰·达利（John Darley，）是一位美国社会心理学家，以研究助人行为著称，目前是普林斯顿大学的心理学教授。", source: "CMRC 2018 · 约翰·达利" },
  { question: "约翰·达利现在是哪个学校的教授？", category: "百科知识", answer: "普林斯顿大学", explain: "约翰·达利（John Darley，）是一位美国社会心理学家，以研究助人行为著称，目前是普林斯顿大学的心理学教授。", source: "CMRC 2018 · 约翰·达利" },
  { question: "约翰·达利最优秀的博士生是谁？", category: "百科知识", answer: "Daniel Batson", explain: "达利最优秀的博士生之一是Daniel Batson。", source: "CMRC 2018 · 约翰·达利" },
  { question: "《ONE PIECE 被诅咒的圣剑》上映于哪一年？", category: "百科知识", answer: "2004年", explain: "《ONE PIECE 被诅咒的圣剑》是于2004年上映的第五部《ONE PIECE》剧场版动画。", source: "CMRC 2018 · ONE PIECE 被诅咒的圣剑" },
  { question: "戴龙·罗伯斯是什么运动员？", category: "百科知识", answer: "田径", explain: "戴龙·罗伯斯（，），西班牙语音译为戴龙·罗夫莱斯，古巴田径运动员。", source: "CMRC 2018 · 戴龙·罗伯斯" },
  { question: "戴龙·罗伯斯是哪国人？", category: "百科知识", answer: "古巴", explain: "戴龙·罗伯斯（，），西班牙语音译为戴龙·罗夫莱斯，古巴田径运动员。", source: "CMRC 2018 · 戴龙·罗伯斯" },
  { question: "戴龙·罗伯斯女友的职业是什么？", category: "百科知识", answer: "歌手", explain: "戴龙·罗伯斯的女友是一位古巴歌手，当他有空闲时间时，总是会去听女友的演唱会，以舒缓压力和补充动力。", source: "CMRC 2018 · 戴龙·罗伯斯" },
  { question: "《ONE PIECE 死亡尽头的冒险》在哪一年上映？", category: "百科知识", answer: "2003年", explain: "《ONE PIECE 死亡尽头的冒险》是于2003年上映的第四部《ONE PIECE》剧场版。", source: "CMRC 2018 · ONE PIECE 死亡尽头的冒险" },
  { question: "2003年1月担任周刊少年Jump编辑长的谁？", category: "百科知识", answer: "高桥俊昌", explain: "2003年1月24号，当时担任周刊少年Jump编辑长的高桥俊昌参加东京湾内的船上制作发表会时，因蛛网膜下腔出血而突然昏倒，紧急送往圣路加国际医院后仍不幸过世。", source: "CMRC 2018 · ONE PIECE 死亡尽头的冒险" },
  { question: "《ONE PIECE 发条岛的冒险》上映于哪一年？", category: "百科知识", answer: "2001年", explain: "《ONE PIECE 发条岛的冒险》是于2001年上映的第二部《ONE PIECE》剧场版动画。", source: "CMRC 2018 · ONE PIECE 发条岛的冒险" },
  { question: "梁修身出生在哪里？", category: "百科知识", answer: "安徽", explain: "梁修身，出生于安徽，台湾男演员、戏剧制作人、导演，曾获金钟奖男演员奖。", source: "CMRC 2018 · 梁修身" },
  { question: "梁修身曾经获得过什么奖项？", category: "百科知识", answer: "金钟奖男演员奖", explain: "梁修身，出生于安徽，台湾男演员、戏剧制作人、导演，曾获金钟奖男演员奖。", source: "CMRC 2018 · 梁修身" },
  { question: "梁修身1974年出演了什么电视剧？", category: "百科知识", answer: "《我父我夫我子》", explain: "1974年受白景瑞导演赏识，演出《我父我夫我子》，之后暂离电视圈，接演多部电影，成为1970年代台湾影坛当红小生。", source: "CMRC 2018 · 梁修身" },
  { question: "梁修身在哪一年获得了金钟奖男主角奖？", category: "百科知识", answer: "2003年", explain: "2003年，他以公视电视剧《家》中的本省籍父亲角色，获得第38届金钟奖男主角奖。", source: "CMRC 2018 · 梁修身" },
  { question: "金关丈夫出身于什么地方？", category: "百科知识", answer: "日本香川县", explain: "金关丈夫（，笔名：林熊生），日本香川县人，解剖学者、人类学者。", source: "CMRC 2018 · 金关丈夫" },
  { question: "金关丈夫在什么时候进入「闲谷黉」冈山分黉就读？", category: "百科知识", answer: "明治43年(1910年)4月", explain: "明治43年(1910年)4月，金关丈夫13岁即进入儒学教育著名的藩校「闲谷黉」冈山分黉就读。", source: "CMRC 2018 · 金关丈夫" },
  { question: "金关丈夫凭借什么文章取得了京都大学医学博士学位？", category: "百科知识", answer: "《琉球人的人类学研究》", explain: "昭和4年(1929年)1月，进行琉球人掌纹调查及人骨采集的研究，昭和5年(1930年)9月，以《琉球人的人类学研究》取得京都大学医学博士学位。", source: "CMRC 2018 · 金关丈夫" },
  { question: "金关丈夫享年多少岁？", category: "百科知识", answer: "八十六岁", explain: "昭和58年(1983年)年2月27日早上，因心肌梗塞逝世，享年八十六岁。", source: "CMRC 2018 · 金关丈夫" },
  { question: "《无字碑歌》拍摄于哪一年？", category: "百科知识", answer: "2004年", explain: "《无字碑歌》是一部以武则天一生改编的古装历史剧，于2004年拍摄，2006年首播。", source: "CMRC 2018 · 无字碑歌" },
  { question: "武媚娘向皇帝提出了什么政治观点，使她受到高宗的赞赏？", category: "百科知识", answer: "“建言十二事”", explain: "成为皇后之后，武媚娘逐渐展现她在政治上的才华，她向皇帝提出了“建言十二事”，深得高宗赞赏，大唐朝廷开始了“双圣”临朝的局面。", source: "CMRC 2018 · 无字碑歌" },
  { question: "黑额鸣冠雉又名什么？", category: "百科知识", answer: "黑胸鸣官鸟", explain: "黑额鸣冠雉（\"Aburria jacutinga\"），又名黑胸鸣官鸟，是分布在巴西东南部的大西洋森林、阿根廷及巴拉圭的凤冠雉。", source: "CMRC 2018 · 黑额鸣冠雉" },
  { question: "黑额鸣冠雉的体长是多少？", category: "百科知识", answer: "63-74厘米", explain: "黑额鸣冠雉是大型的鸟类，长63-74厘米，外观像火鸡，颈幼头细。", source: "CMRC 2018 · 黑额鸣冠雉" },
  { question: "黑额鸣冠雉的双脚是什么颜色？", category: "百科知识", answer: "红色", explain: "胸部呈白色，喉咙有红色垂肉，前端深蓝色。", source: "CMRC 2018 · 黑额鸣冠雉" },
  { question: "科罗拉多河蟾蜍原产于什么地方？", category: "百科知识", answer: "美国西南部及墨西哥北部", explain: "科罗拉多河蟾蜍（学名：）是一种有毒的蟾蜍，原产于美国西南部及墨西哥北部。", source: "CMRC 2018 · 科罗拉多河蟾蜍" },
  { question: "王金璐是谁的弟子？", category: "百科知识", answer: "马连良", explain: "王金璐（），京剧演员，工生行，马连良弟子，中国国家1级演员，国家级非物质文化遗产京剧项目代表性传承人。", source: "CMRC 2018 · 王金璐" },
  { question: "王金璐出身于什么学校？", category: "百科知识", answer: "北京中华戏曲学校", explain: "出身北京中华戏曲学校「金」字科，1934年经校长焦菊隐推荐，与师兄王和霖同拜马连良先生门下。", source: "CMRC 2018 · 王金璐" },
  { question: "王金璐1979年起担任了什么院系的教授？", category: "百科知识", answer: "表演系", explain: "1979年起任北京中国戏曲学院表演系教授。", source: "CMRC 2018 · 王金璐" },
  { question: "高畠车站由哪个公司运营？", category: "百科知识", answer: "东日本旅客铁道（JR东日本）", explain: "高畠车站（）是一位于日本山形县东置赐郡高畠町大字山崎，由东日本旅客铁道（JR东日本）所经营的铁路车站。", source: "CMRC 2018 · 高畠车站" },
  { question: "莱索托足球队代表哪个国家？", category: "百科知识", answer: "莱索托", explain: "莱索托足球代表队是莱索托的国家足球代表队，由莱索托足球协会管理，现时属于国际足协及非洲足协成员国之一。", source: "CMRC 2018 · 莱索托国家足球队" },
  { question: "莱索托2010年分组赛的所有主场赛事在哪国举行？", category: "百科知识", answer: "南非", explain: "2002年世界杯外围赛莱索托在第一圈遇上南非，首回合在主场负0比2，次回合作客南非负0比1，总比数以0比3出局。", source: "CMRC 2018 · 莱索托国家足球队" },
  { question: "普通鸣冠雉又名什么？", category: "百科知识", answer: "鸣官鸟", explain: "普通鸣冠雉（学名：'），又名鸣官鸟，是一种凤冠雉。", source: "CMRC 2018 · 普通鸣冠雉" },
  { question: "普通鸣冠雉主要是什么颜色?", category: "百科知识", answer: "黑色", explain: "普通鸣冠雉主要是黑色，有紫色光泽。", source: "CMRC 2018 · 普通鸣冠雉" },
  { question: "普通鸣冠雉的叫声像什么？", category: "百科知识", answer: "尖笛声", explain: "普通鸣冠雉的叫声像尖笛声。", source: "CMRC 2018 · 普通鸣冠雉" },
  { question: "约瑟夫·洛克曾在什么时期到云南以及西藏地区考察？", category: "百科知识", answer: "20世纪初", explain: "曾于20世纪初，以美国《国家地理杂志》、美国农业部、哈佛大学植物研究所的探险家，撰稿人、摄影家的身份到云南滇缅边境以及西藏考察。", source: "CMRC 2018 · 约瑟夫·洛克" },
  { question: "约瑟夫·洛克出生在什么地方？", category: "百科知识", answer: "奥地利维也纳", explain: "1884年生于奥地利维也纳，1907年移居美国夏威夷檀香山，并在此成为植物群落专家。", source: "CMRC 2018 · 约瑟夫·洛克" },
  { question: "约瑟夫·洛克哪一年移居至檀香山？", category: "百科知识", answer: "1907年", explain: "1884年生于奥地利维也纳，1907年移居美国夏威夷檀香山，并在此成为植物群落专家。", source: "CMRC 2018 · 约瑟夫·洛克" },
  { question: "罗素-爱因斯坦宣言最初称为什么？", category: "百科知识", answer: "《科学家要求废止战争》", explain: "罗素-爱因斯坦宣言（Russell–Einstein Manifesto），最初称为《科学家要求废止战争》，是由罗素起草的。", source: "CMRC 2018 · 罗素—爱因斯坦宣言" },
  { question: "签字的11名科学家中谁不是诺贝尔奖得主？", category: "百科知识", answer: "利奥波德·英费尔德", explain: "宣言的签字者包括11位著名的科学家，其中10人均为诺贝尔奖得主，只有利奥波德·英费尔德（Leopold Infeld）例外。", source: "CMRC 2018 · 罗素—爱因斯坦宣言" },
  { question: "吉格梅·多吉·旺楚克鼓励使用什么来帮助本地农民？", category: "百科知识", answer: "现代工具", explain: "他鼓励使用现代工具来帮助本地农民。", source: "CMRC 2018 · 吉格梅·多吉·旺楚克" },
  { question: "吉格梅·多吉·旺楚克在哪一年成立了国会？", category: "百科知识", answer: "1953年", explain: "1953年，他成立了国会——不丹首个一院制的国民议会。", source: "CMRC 2018 · 吉格梅·多吉·旺楚克" },
  { question: "吉格梅·多吉·旺楚克在哪里接收治疗时不幸病逝？", category: "百科知识", answer: "肯尼亚内罗毕", explain: "1972年他在肯尼亚内罗毕接受治疗期间不幸病逝。", source: "CMRC 2018 · 吉格梅·多吉·旺楚克" },
  { question: "岑朗天笔名叫什么？", category: "百科知识", answer: "朗天、霍惊觉", explain: "岑朗天（），笔名朗天、霍惊觉。", source: "CMRC 2018 · 岑朗天" },
  { question: "岑朗天哪年加入香港电影评论学会？", category: "百科知识", answer: "1995年", explain: "1995年加入香港电影评论学会，并于2003-2007年出任该会会长，2016年退出。", source: "CMRC 2018 · 岑朗天" },
  { question: "叔梁纥的表字是什么？", category: "百科知识", answer: "叔梁", explain: "叔梁纥（），孔氏，名纥，字叔梁，又称郰人纥、郰叔纥，是伯夏的儿子，孟皮和孔子的父亲。", source: "CMRC 2018 · 叔梁纥" },
  { question: "叔梁纥的墓地如今被称为什么？", category: "百科知识", answer: "「梁公林」", explain: "叔梁纥的墓地，今称「梁公林」，位于曲阜城东14公里，面对防山，北阻泗水，又称“齐国公墓”、“启圣林”或“启圣王林”。", source: "CMRC 2018 · 叔梁纥" },
  { question: "中国博客第一案的原告陈堂发是哪个学校的副教授？", category: "百科知识", answer: "南京大学", explain: "陈堂发是南京大学新闻传播学院副教授。", source: "CMRC 2018 · 中国博客第一案" },
  { question: "中国博客第一案中涉及了陈堂发的哪部作品？", category: "百科知识", answer: "《新闻伦理与法规》", explain: "博客主人「K007」写了一篇名为《烂人烂教材》的心情日记， 声称明天要考陈堂发的《新闻伦理与法规》，于是决定看书。", source: "CMRC 2018 · 中国博客第一案" },
  { question: "中国博客第一案中原告最终能拿到多少赔偿金？", category: "百科知识", answer: "1000元", explain: "2006年8月2日，鼓楼区法院作出判决，被告杭州博客资讯技术有限公司，在中国博客网首页向原告刊登致歉声明并保留10日，赔偿原告经济损失1000元。", source: "CMRC 2018 · 中国博客第一案" },
  { question: "《内蒙古植物志》主要记载了哪个地区的植物？", category: "百科知识", answer: "中国内蒙古自治区", explain: "《内蒙古植物志》（拉丁文：\"Flora Innermongolica\"）是记载中国内蒙古自治区维管植物的植物志。", source: "CMRC 2018 · 内蒙古植物志" },
  { question: "《内蒙古植物志》的编写组是哪一年成立的？", category: "百科知识", answer: "1976年", explain: "1976年成立了《内蒙古植物志》编写组。", source: "CMRC 2018 · 内蒙古植物志" },
  { question: "《内蒙古植物志》中的裸子植物采用了谁的系统？", category: "百科知识", answer: "郑万钧系统", explain: "和中国大陆大部分地方植物志一样，《内蒙古植物志》的蕨类植物采用1978年秦仁昌系统，裸子植物采用1978年郑万钧系统，被子植物采用1936年恩格勒系统。", source: "CMRC 2018 · 内蒙古植物志" },
  { question: "王天成的籍贯是哪里？", category: "百科知识", answer: "中国湖南省双牌县", explain: "王天成，中国湖南省双牌县人，著名异议人士、政治学者。", source: "CMRC 2018 · 王天成" },
  { question: "王天成哪一年从北京大学法律系毕业？", category: "百科知识", answer: "1989年", explain: "1989年毕业于北京大学法律系（现北京大学法学院），获硕士学位，同年留校任助教，兼任北大《中外法学》杂志编辑，旋即晋升为讲师。", source: "CMRC 2018 · 王天成" },
  { question: "王天成兼任了哪个杂志的编辑？", category: "百科知识", answer: "《中外法学》", explain: "1989年毕业于北京大学法律系（现北京大学法学院），获硕士学位，同年留校任助教，兼任北大《中外法学》杂志编辑，旋即晋升为讲师。", source: "CMRC 2018 · 王天成" },
  { question: "荷兰数学奥林匹克比赛一共分为几轮？", category: "百科知识", answer: "两轮", explain: "比赛分为两轮，接著有一个训练课程，从中挑选六名学生参加国际数学奥林匹克。", source: "CMRC 2018 · 荷兰数学奥林匹克" },
  { question: "荷兰数学奥林匹克比赛在2007年有多少人参赛？", category: "百科知识", answer: "2742人", explain: "2006年有2192人参赛，2007年有2742人。", source: "CMRC 2018 · 荷兰数学奥林匹克" },
  { question: "荷兰数学奥林匹克比赛的训练内容有哪些？", category: "百科知识", answer: "组合数学、代数、几何、数论", explain: "内容计有组合数学、代数、几何、数论。", source: "CMRC 2018 · 荷兰数学奥林匹克" },
  { question: "摩根·理查德·茨万吉拉伊是哪个国家的政治家？", category: "百科知识", answer: "津巴布韦", explain: "摩根·理查德·茨万吉拉伊（，），津巴布韦政治家，末任津巴布韦总理，争取民主变革运动的主要领袖。", source: "CMRC 2018 · 摩根·茨万吉拉伊" },
  { question: "摩根·理查德·茨万吉拉伊在哪一年再次参选？", category: "百科知识", answer: "2008年", explain: "茨万吉拉伊曾于2002年在备受争议的总统选举中被穆加贝击败，2008年再度参选，并在第一轮投票中战胜穆加贝。", source: "CMRC 2018 · 摩根·茨万吉拉伊" },
  { question: "摩根·理查德·茨万吉拉伊的妻子是谁？", category: "百科知识", answer: "苏珊·茨万吉拉伊", explain: "2009年3月6日，茨万吉拉伊前往在家乡举行的集会途中遇上车祸，本人受轻伤，但妻子苏珊·茨万吉拉伊不幸死亡。", source: "CMRC 2018 · 摩根·茨万吉拉伊" },
  { question: "徐晓飞是什么职业？", category: "百科知识", answer: "足球运动员", explain: "徐晓飞（）是中国足球运动员，司职中场，曾经在日本大学生联赛和低级别球队效力，返回中国后不久因身体原因而退役。", source: "CMRC 2018 · 徐晓飞" },
  { question: "徐晓飞现在效力于哪个球队？", category: "百科知识", answer: "日本四国（地区）联赛球队", explain: "2012年复出，现效力于日本四国（地区）联赛球队。", source: "CMRC 2018 · 徐晓飞" },
  { question: "短耳象鼩平均大小是多少？", category: "百科知识", answer: "15厘米", explain: "短耳象鼩平均大小为15厘米。", source: "CMRC 2018 · 象鼩" },
  { question: "无锡市辅仁中学创办于哪一年？", category: "百科知识", answer: "1918年秋", explain: "无锡市辅仁高级中学，简称辅仁中学、辅仁高中，位于中国江苏省无锡市，创办于1918年秋，原名“无锡私立辅仁中学”，原本乃上海圣约翰大学的预备中学。", source: "CMRC 2018 · 无锡市辅仁高级中学" },
  { question: "辅仁中学的名字来自于哪本经典著作？", category: "百科知识", answer: "《论语·颜渊》", explain: "校名取义《论语·颜渊》“以文会友，以友辅仁”，校训为“明道进德”。", source: "CMRC 2018 · 无锡市辅仁高级中学" },
  { question: "辅仁中学的校训是什么？", category: "百科知识", answer: "“明道进德”", explain: "校名取义《论语·颜渊》“以文会友，以友辅仁”，校训为“明道进德”。", source: "CMRC 2018 · 无锡市辅仁高级中学" },
  { question: "辅仁中学在哪一年于市内最先通过国家级示范高中的验收？", category: "百科知识", answer: "1998年", explain: "1998年在市内率先通过国家级示范高中验收。", source: "CMRC 2018 · 无锡市辅仁高级中学" },
  { question: "目前辅仁中学的初高中共计有多少个班级？", category: "百科知识", answer: "66个", explain: "目前辅仁中学初中部和蠡湖新校区高中部共占地一百五十八亩，建筑面积约8万平方米，初高中总计66个班级，在校师生近5000人。", source: "CMRC 2018 · 无锡市辅仁高级中学" },
  { question: "林肯郡在什么位置？", category: "百科知识", answer: "英国英格兰东米德兰兹", explain: "林肯郡（，英文简称：Lincs），英国英格兰东米德兰兹（包含的2个单一管理区属于约克郡-亨伯）的郡。", source: "CMRC 2018 · 林肯郡" },
  { question: "林肯郡的第1大镇是什么？", category: "百科知识", answer: "格里姆斯比", explain: "格里姆斯比是第1大镇（Town），斯肯索普是第2大镇。", source: "CMRC 2018 · 林肯郡" },
  { question: "林肯郡实际管辖了几个非都市区？", category: "百科知识", answer: "7个", explain: "林肯郡是34个非都市郡之一，实际管辖7个非都市区，占地5,921平方公里（第4），有686,300人口（第15；", source: "CMRC 2018 · 林肯郡" },
  { question: "《越战狂想曲》的英文名恶搞了哪部美国电影？", category: "百科知识", answer: "《现代启示录》", explain: "《越战狂想曲》（），或称《猫屎一号》，日文版采用《》原名称，英文版则译成《》（即“喵咪启示录”，其英文名称是恶搞于同样是以越战为背景的美国电影《现代启示录》）。", source: "CMRC 2018 · 越战狂想曲" },
  { question: "《越战狂想曲》的作者是谁？", category: "百科知识", answer: "小林源文", explain: "《越战狂想曲》是为小林源文所编著绘制完成的日本漫画，最早由日本Softbank Publishing于1998年出版，2007年在台湾由尖端出版发行单行本。", source: "CMRC 2018 · 越战狂想曲" },
  { question: "《越战狂想曲》何时在英国出版？", category: "百科知识", answer: "2004年", explain: "在欧洲，本漫画在2004年由A.D. Vision于英国出版，2006年于波兰与西班牙以同名出版。", source: "CMRC 2018 · 越战狂想曲" },
  { question: "《越战狂想曲》的主角是谁？", category: "百科知识", answer: "波塔斯基、帕奇与莱兹", explain: "漫画情节是三位美国军人波塔斯基、帕奇与莱兹于越战时期的故事。", source: "CMRC 2018 · 越战狂想曲" },
  { question: "轻艇水球每队中有几名队员？", category: "百科知识", answer: "五名", explain: "轻艇水球是一项由两队对垒的球类运动，每队派出五名球员作赛。", source: "CMRC 2018 · 轻艇水球" },
  { question: "轻艇水球的目标是什么？", category: "百科知识", answer: "争取在对方的龙门入球", explain: "用特定的轻艇在一指定的场地上比赛，以争取在对方的龙门入球为目标。", source: "CMRC 2018 · 轻艇水球" },
  { question: "轻艇水球在什么时候引入香港？", category: "百科知识", answer: "1974年", explain: "这项运动于1974年引入香港。", source: "CMRC 2018 · 轻艇水球" },
  { question: "推官是什么朝代设置的？", category: "百科知识", answer: "唐代", explain: "推官，唐代设置，最早是节度使、观察使等官的属官，多掌理司法，不系京职，后期成为对法官的雅称。", source: "CMRC 2018 · 推官" },
  { question: "清末时推官被称为什么？", category: "百科知识", answer: "「推事」", explain: "清末，改称推官为「推事」，民国初年仍称法官为「推事」。", source: "CMRC 2018 · 推官" },
  { question: "推官在明代各府主要负责什么？", category: "百科知识", answer: "掌理刑名，处理民刑讼事。", explain: "明代各府设推官，掌理刑名，处理民刑讼事。清初仍设推官及挂衔推官，清世祖顺治三年（1646年）废除职衔推官，清圣祖康熙六年（1667年）废除推官。", source: "CMRC 2018 · 推官" },
  { question: "推事一词在哪本法典中一直沿用？", category: "百科知识", answer: "《刑事诉讼法》", explain: "1989年，推事更名为「法官」，但是《刑事诉讼法》至今仍沿用「推事」一词。", source: "CMRC 2018 · 推官" },
  { question: "莫洛托夫计划发生在哪一年？", category: "百科知识", answer: "1947年", explain: "莫洛托夫计划是1947年由苏联所创立的经济互助组织，是一项参与国与苏联的双边贸易协定，协助社会主义国家的经济发展。", source: "CMRC 2018 · 莫洛托夫计划" },
  { question: "莫洛托夫计划是哪个国家所创立？", category: "百科知识", answer: "苏联", explain: "莫洛托夫计划是1947年由苏联所创立的经济互助组织，是一项参与国与苏联的双边贸易协定，协助社会主义国家的经济发展。", source: "CMRC 2018 · 莫洛托夫计划" },
  { question: "现代货箱码头在哪一年称为香港货箱码头界的第二？", category: "百科知识", answer: "1991年", explain: "1991年，现代货箱再获得八号货柜码头4个泊位中的两个，成为香港货柜码头业仅次于香港国际货柜码头有限公司的另一大集团。", source: "CMRC 2018 · 现代货箱码头" },
  { question: "铜锣湾电车厂的前称叫什么？", category: "百科知识", answer: "罗素街电车厂", explain: "铜锣湾电车厂，又名霎东街电车厂（前称罗素街电车厂），是一处已经拆建的香港电车车厂，位于香港铜锣湾罗素街，即是时代广场的前身。", source: "CMRC 2018 · 铜锣湾电车厂" },
  { question: "铜锣湾电车厂在哪里？", category: "百科知识", answer: "香港铜锣湾罗素街", explain: "铜锣湾电车厂，又名霎东街电车厂（前称罗素街电车厂），是一处已经拆建的香港电车车厂，位于香港铜锣湾罗素街，即是时代广场的前身。", source: "CMRC 2018 · 铜锣湾电车厂" },
  { question: "铜锣湾电车厂是什么的前身？", category: "百科知识", answer: "时代广场", explain: "铜锣湾电车厂，又名霎东街电车厂（前称罗素街电车厂），是一处已经拆建的香港电车车厂，位于香港铜锣湾罗素街，即是时代广场的前身。", source: "CMRC 2018 · 铜锣湾电车厂" },
  { question: "满田拓也的作品获得了第几届新人奖？", category: "百科知识", answer: "第11届", explain: "1982年 作品蛮勇荣获第11届新人奖，并以此作品出道。", source: "CMRC 2018 · 满田拓也" },
  { question: "印度尼西亚作为新兴市场国家是哪个地区最大的经济体?", category: "百科知识", answer: "东南亚", explain: "印度尼西亚是一个新兴市场国家，东南亚最大的经济体。", source: "CMRC 2018 · 印度尼西亚经济" },
  { question: "印度尼西亚的经济在哪位领导人手中开始增长？", category: "百科知识", answer: "苏哈托", explain: "印尼经济直至1960年代仍然呆滞，主因是政局长期不稳，直至政治强人苏哈托上台，致力建立经济制度，印尼经济才于1970年代始见增长。", source: "CMRC 2018 · 印度尼西亚经济" },
  { question: "印尼经济最开始靠什么带动？", category: "百科知识", answer: "石油", explain: "起先是靠出售石油所带动，至1980年代大量外资引进，制造业发展急速，在1989年至1997年间，印尼经济一直有著平均7%的增长。", source: "CMRC 2018 · 印度尼西亚经济" },
  { question: "1998年的什么事件中印尼遭受的经济创伤最大？", category: "百科知识", answer: "亚洲金融风暴", explain: "1998年亚洲金融风暴打击东南亚各国的经济，其中以印尼遭受的创伤最大，兑美元的汇价由2,000印尼盾跌至18,000印尼盾，而增长率更下滑13.7%。", source: "CMRC 2018 · 印度尼西亚经济" },
  { question: "《魔力充电娘》漫画的单行本由谁发行？", category: "百科知识", answer: "WANI BOOKS", explain: "单行本由WANI BOOKS发售共10册，中文版由尖端出版代理发售。", source: "CMRC 2018 · 魔力充电娘" },
  { question: "《魔力充电娘》的电视动画一共有多少集？", category: "百科知识", answer: "12集", explain: "2009年播放电视动画共12集。", source: "CMRC 2018 · 魔力充电娘" },
  { question: "被流放的塞雷茨创立了什么党派？", category: "百科知识", answer: "波札那民主党", explain: "被流放的塞雷茨并未因此放弃希望，在结束五年的流放生涯后，他选择创立波札那民主党，1965年议会大选中赢得多数，被推选为总理，持续致力于独立运动。", source: "CMRC 2018 · 塞雷茨·卡马" },
  { question: "塞雷茨的儿子叫什么？", category: "百科知识", answer: "伊恩·卡马", explain: "28年后他儿子伊恩·卡马亦被推为第四届总统。", source: "CMRC 2018 · 塞雷茨·卡马" },
  { question: "1983年植村秀在东京的什么地方开设了美容精品店？", category: "百科知识", answer: "表参道", explain: "1982年，改为「植村秀化粧品公司」1983年，在东京的表参道开设以「shu uemura」为名号的美容精品1号店，正式开始他的品牌之路。", source: "CMRC 2018 · 植村秀" },
  { question: "九龙灵粮堂是哪位牧师所建立？", category: "百科知识", answer: "赵世光牧师", explain: "九龙灵粮堂是香港九龙的基督教独立教会，为赵世光牧师于上海来到香港后建立的首间灵粮堂，于1951年9月9日落成，现址为九龙城嘉林边道1号，现任主任牧师为王华灿牧师。", source: "CMRC 2018 · 九龙灵粮堂" },
  { question: "多数认为临床心理学在哪一年开始？", category: "百科知识", answer: "1896年", explain: "多数认为临床心理学是1896年由莱特那·维特莫在宾夕法尼亚大学建立世界上第一所心理诊所开始。", source: "CMRC 2018 · 临床心理学" },
  { question: "真君庙供奉的是谁？", category: "百科知识", answer: "灵昭真君", explain: "真君庙是香港一所庙宇，位于新界青衣岛，供奉灵昭真君（俗称真君大帝）。", source: "CMRC 2018 · 真君庙" },
  { question: "《选择》杂志以什么为主题？", category: "百科知识", answer: "产品测试", explain: "《选择》月刊是香港唯一一本以产品测试为主题的杂志，由香港法定机构消费者委员会出版。", source: "CMRC 2018 · 选择月刊" },
  { question: "《选择》杂志由哪个机构出版？", category: "百科知识", answer: "香港法定机构消费者委员会", explain: "《选择》月刊是香港唯一一本以产品测试为主题的杂志，由香港法定机构消费者委员会出版。", source: "CMRC 2018 · 选择月刊" },
  { question: "2008年《选择》杂志的定价是多少？", category: "百科知识", answer: "12港元", explain: "2008年，该刊每本定价为12港元。", source: "CMRC 2018 · 选择月刊" },
  { question: "1988年《选择》杂志的封面人物是谁？", category: "百科知识", answer: "林贝聿嘉", explain: "1988年第142期《选择》月刊，就特别请得家计会首任总干事林贝聿嘉做封面介绍避孕套报告，该期竟然大卖7万多份，是创刊以来销量最高的一期。", source: "CMRC 2018 · 选择月刊" },
  { question: "完全萨克斯-瓦福效应是由什么造成的？", category: "百科知识", answer: "重力红移", explain: "萨克斯-瓦福效应，以雷纳·库尔特·萨克斯和亚瑟·迈克尔·瓦福为名，是宇宙微波背景辐射（CMB）的一种性质，来自CMB的光子由于重力红移而使得CMB的光谱参差不齐。", source: "CMRC 2018 · 萨克斯-瓦福效应" },
  { question: "王永吉的表字是什么？", category: "百科知识", answer: "修之", explain: "王永吉（），字修之，一字六谦，号铁山。", source: "CMRC 2018 · 王永吉" },
  { question: "王永吉是哪个时期的官员?", category: "百科知识", answer: "明末清初时期", explain: "明末清初时期官员，江南高邮人。", source: "CMRC 2018 · 王永吉" },
  { question: "王永吉是哪一年的进士？", category: "百科知识", answer: "天启五年（1625年）", explain: "天启五年（1625年）进士，任知县，为官清廉，崇祯十五年（1642年），擢升为右佥都御史巡抚山东，誉满京华。", source: "CMRC 2018 · 王永吉" },
  { question: "王永吉在顺治四年担任了什么官职？", category: "百科知识", answer: "工部侍郎", explain: "顺治四年（1647年）任工部侍郎，顺治八年（1651年）任户部侍郎。", source: "CMRC 2018 · 王永吉" },
  { question: "王永吉的谥号是什么？", category: "百科知识", answer: "文通", explain: "顺治帝念其“勤劳素著”，命予以优恤，追赠少保兼太子太保、吏部尚书，谥文通。", source: "CMRC 2018 · 王永吉" },
  { question: "孙德培是哪个帮派的成立者？", category: "百科知识", answer: "中和帮", explain: "孙德培，中和帮的成立者。", source: "CMRC 2018 · 孙德培" },
  { question: "孙德培是哪一年成立了中和帮？", category: "百科知识", answer: "1953年左右", explain: "1953年左右，孙德培在现在新北市中和区、永和区一带成立中和帮，当时的成员只有十几人。", source: "CMRC 2018 · 孙德培" },
  { question: "孙德培入狱之后哪位元老将中和帮改名为竹联帮？", category: "百科知识", answer: "赵宁", explain: "后来以中和帮元老赵宁为首，召集帮众于永和市竹林路举行大会，商量对策。", source: "CMRC 2018 · 孙德培" },
  { question: "HAT-P-2b距离地球有多远？", category: "百科知识", answer: "440多光年", explain: "HAT-P-2b是一颗位于武仙座、距离地球约440多光年的系外行星，其母星为一颗F型恒星（体积大于太阳、温度也高于太阳）。", source: "CMRC 2018 · HAT-P-2b" },
  { question: "HAT-P-2b的母星是什么类型的恒星？", category: "百科知识", answer: "F型恒星", explain: "HAT-P-2b是一颗位于武仙座、距离地球约440多光年的系外行星，其母星为一颗F型恒星（体积大于太阳、温度也高于太阳）。", source: "CMRC 2018 · HAT-P-2b" },
  { question: "HAT-P-2b的轨道周期是多少？", category: "百科知识", answer: "5地球日15小时", explain: "其轨道周期为5地球日15小时；", source: "CMRC 2018 · HAT-P-2b" },
  { question: "HAT-P-2b的质量是木星的多少倍？", category: "百科知识", answer: "8.65倍", explain: "据估计，该行星的质量为木星的8.65倍，半径为木星的0.951倍，即13万5978公里，这一质量体积比在类木行星中较为罕见。", source: "CMRC 2018 · HAT-P-2b" },
  { question: "进步号太空船是哪个国家的无人驾驶货运太空船？", category: "百科知识", answer: "俄罗斯", explain: "进步号太空船（）是俄罗斯的无人驾驶货运太空船，可以运送物资到国际太空站。", source: "CMRC 2018 · 进步号太空船" },
  { question: "蟒鳗又被称为什么？", category: "百科知识", answer: "血红拟蛇鱼", explain: "蟒鳗，又称血红拟蛇鱼，为辐鳍鱼纲鳗鲡目鳗鲡亚目异蝮鯙科的其中一个种。", source: "CMRC 2018 · 蟒鳗" },
  { question: "灵昭真君是什么地区的乡土神？", category: "百科知识", answer: "广东", explain: "是广东地区的乡土神，又有大帝封号，故俗称真君大帝。", source: "CMRC 2018 · 灵昭真君" },
  { question: "犯罪小说主要描述哪些内容？", category: "百科知识", answer: "犯罪、侦查、动机与嫌疑犯", explain: "犯罪小说（）是一种描述犯罪、侦查、动机与嫌疑犯的小说类型，通常可以与其他小说类型相区隔开来，不过界线可能不够明确。", source: "CMRC 2018 · 犯罪小说" },
  { question: "2008年亚足联女子亚洲杯在什么地方举行？", category: "百科知识", answer: "越南胡志明市", explain: "2008年亚足联女子亚洲杯决赛周于2008年5月28日至6月8日于越南胡志明市举行。", source: "CMRC 2018 · 2008年亚足联女子亚洲杯" },
  { question: "2008年亚足联女子亚洲杯本届赛赛一共有几轮外围赛？", category: "百科知识", answer: "两轮", explain: "本届赛事共分为两轮外围赛及决赛周。", source: "CMRC 2018 · 2008年亚足联女子亚洲杯" },
  { question: "线蚓鳗主要栖息在哪些地区？", category: "百科知识", answer: "近海与河口区之泥质海底", explain: "栖息在近海与河口区之泥质海底。", source: "CMRC 2018 · 线蚓鳗" },
  { question: "茶荣省和三芹省在哪一年合并为永平省？", category: "百科知识", answer: "1956年", explain: "1956年2月9日，越南共和国以永隆省和茶荣省析置三芹省。", source: "CMRC 2018 · 永平省" },
  { question: "1975年哪个政权接手了管政权？", category: "百科知识", answer: "越南南方共和国", explain: "1975年，越南南方共和国接管政权。", source: "CMRC 2018 · 永平省" },
  { question: "1976年越南统一，茶荣省和永隆省合并成了哪个省？", category: "百科知识", answer: "九龙省", explain: "1976年，越南统一，茶荣省和永隆省合并为九龙省。", source: "CMRC 2018 · 永平省" },
  { question: "赛斯纳170是由哪个公司研制？", category: "百科知识", answer: "塞斯纳公司", explain: "塞斯纳170型是一个单引擎四座位的小型飞机，由塞斯纳公司所研制的，在1948-1956年期间生产数量达5174架。", source: "CMRC 2018 · 塞斯纳170" },
  { question: "1948-1956年间赛斯纳的生产数量是多少？", category: "百科知识", answer: "5174架", explain: "塞斯纳170型是一个单引擎四座位的小型飞机，由塞斯纳公司所研制的，在1948-1956年期间生产数量达5174架。", source: "CMRC 2018 · 塞斯纳170" },
  { question: "1949年赛斯纳公司提出的改良型号是什么？", category: "百科知识", answer: "C-170A", explain: "在1949年，塞斯纳提出C-170的改良型，即是C-170A，是一个全金属制成的飞机。", source: "CMRC 2018 · 塞斯纳170" },
  { question: "布雷西亚足球俱乐部成立于哪一年？", category: "百科知识", answer: "1911年", explain: "布雷西亚足球俱乐部（Brescia Calcio），是一家意大利布雷西亚市的足球俱乐部，成立于1911年。", source: "CMRC 2018 · 布雷西亚足球俱乐部" },
  { question: "布雷西亚足球俱乐部因为签下了谁而得到广泛关注？", category: "百科知识", answer: "罗伯特·巴乔", explain: "但直到2000年，布雷西亚俱乐部才取得广泛关注，因为他们签下了前世界足球先生罗伯特·巴乔。", source: "CMRC 2018 · 布雷西亚足球俱乐部" },
  { question: "当地人兴建关帝庙的愿景是什么？", category: "百科知识", answer: "祈求保祐贸易的忠诚", explain: "当地人便兴建这座主祀关帝的庙宇，祈求保祐贸易的忠诚。", source: "CMRC 2018 · 深水埗关帝庙" },
  { question: "氯化铷的化学式是什么？", category: "百科知识", answer: "RbCl", explain: "氯化铷是一个碱金属卤化物，化学式为RbCl。", source: "CMRC 2018 · 氯化铷" },
  { question: "小孤岛大医生原作的作者是谁？", category: "百科知识", answer: "山田贵敏", explain: "，又名《离岛大夫日志》、《五岛医生诊疗所》，是一部依山田贵敏漫画原作《孤岛诊疗所》改编成的电视剧。", source: "CMRC 2018 · 小孤岛大医生" },
  { question: "小孤岛大医生首次放映的是哪个系列？", category: "百科知识", answer: "「2003年系列」", explain: "首次放映的「2003年系列」于日本创造出极佳收视率，故又于2004年拍摄特别篇（「」，即「2004年系列」，于同年11月12、13两日放送）。", source: "CMRC 2018 · 小孤岛大医生" },
  { question: "雷切尔·墨索里尼是哪个国家的人？", category: "百科知识", answer: "意大利", explain: "雷切尔·墨索里尼（意大利文：，），意大利人，贝尼托·墨索里尼的第二任妻子。", source: "CMRC 2018 · 雷切尔·墨索里尼" },
  { question: "雷切尔·墨索里尼在哪一年和贝尼托·墨索里尼同居？", category: "百科知识", answer: "1910年", explain: "雷切尔在1910年开始与贝尼托·墨索里尼同居，并于1915年正式结婚。", source: "CMRC 2018 · 雷切尔·墨索里尼" },
  { question: "墨索里尼的故乡是哪里？", category: "百科知识", answer: "普雷达皮奥", explain: "她出生于意大利的一个叫普雷达皮奥的小镇农家，婚前的本名是：。", source: "CMRC 2018 · 雷切尔·墨索里尼" },
  { question: "硼砂的分子式是什么？", category: "百科知识", answer: "NaBO.10HO", explain: "硼砂，旧亦作鹏砂，或称四硼酸钠，分子式NaBO.10HO，是非常重要的含硼矿物及。", source: "CMRC 2018 · 硼砂" },
  { question: "硼砂是什么溶液的主要成分？", category: "百科知识", answer: "复方硼砂溶液", explain: "硼砂有防腐作用，为复方硼砂溶液的主要成分。", source: "CMRC 2018 · 硼砂" },
  { question: "撒拉森装甲车生产于哪一年？", category: "百科知识", answer: "1952年", explain: "撒拉森装甲车在1952年生产，因为马来西亚危机时英军急需装甲运兵车，因此比撒拉丁更早投产，量产型包括了没有炮塔版本。", source: "CMRC 2018 · 撒拉森装甲车" },
  { question: "氧化铁的化学式是什么？", category: "百科知识", answer: "FeO", explain: "氧化铁，或称三氧化二铁，化学式FeO，是铁锈和赤铁矿的主要成分。", source: "CMRC 2018 · 氧化铁" },
  { question: "1994年哪支球队取得了中国足球乙级联赛亚军？", category: "百科知识", answer: "上海大顺队（上海二队）", explain: "1994年，上海大顺队（上海二队）取得中国足球乙级联赛亚军，从而升入甲B联赛。", source: "CMRC 2018 · 上海豫园足球俱乐部" },
  { question: "纽波特在什么地方？", category: "百科知识", answer: "美国罗得岛州南部", explain: "纽波特（），又译为新港，位于美国罗得岛州南部，是纽波特县的县治所在，距离州首府普罗维登斯37公里，距离波士顿98公里。", source: "CMRC 2018 · 纽波特 (罗得岛州)" },
  { question: "纽波特是哪个大学的所在地？", category: "百科知识", answer: "沙尔瓦·瑞金纳大学", explain: "纽波特是新英格兰的避暑胜地，以豪宅著称，亦是沙尔瓦·瑞金纳大学和纽波特海军基地（包括海军战争学院、海军水下战中心和一处美国海军培训中心）的所在地。", source: "CMRC 2018 · 纽波特 (罗得岛州)" },
  { question: "大雄宝殿在日本被称为什么？", category: "百科知识", answer: "金堂、本堂", explain: "大雄宝殿，也叫大雄殿，或简称大殿，日本称金堂、本堂，是汉传佛教寺院或各类祭祀场所对主殿的惯常称呼。", source: "CMRC 2018 · 大雄宝殿" },
  { question: "大雄宝殿实际上是佛寺的什么地方？", category: "百科知识", answer: "主殿", explain: "大雄宝殿，也叫大雄殿，或简称大殿，日本称金堂、本堂，是汉传佛教寺院或各类祭祀场所对主殿的惯常称呼。", source: "CMRC 2018 · 大雄宝殿" },
  { question: "大雄宝殿一般供奉着谁？", category: "百科知识", answer: "释迦牟尼佛", explain: "简单来说，大雄宝殿就是佛寺主殿，一般以供奉释迦牟尼佛为主。", source: "CMRC 2018 · 大雄宝殿" },
  { question: "妙法寺新建的大殿称为什么？", category: "百科知识", answer: "「万佛宝殿」", explain: "而妙法寺新建的大殿则称「万佛宝殿」，避免在称呼上跟原有的「大雄宝殿」重复。", source: "CMRC 2018 · 大雄宝殿" },
  { question: "迪士尼度假区线有多少列车?", category: "百科知识", answer: "5列", explain: "迪士尼度假区线的列车共5列、每列6卡、每卡载客人数达537人，由日立制造。", source: "CMRC 2018 · 迪士尼度假区线" },
  { question: "迪士尼度假区线内的列车窗户是什么形状？", category: "百科知识", answer: "米奇老鼠头部", explain: "另外，列车的窗户都是米奇老鼠头部形状的。", source: "CMRC 2018 · 迪士尼度假区线" },
  { question: "东京迪士尼度假区的假区线被称为什么?", category: "百科知识", answer: "Resort Liner", explain: "单轨铁路一般会叫作「列车」或「电车」，但在东京迪士尼度假区该假区线被称为「Resort Liner」。", source: "CMRC 2018 · 迪士尼度假区线" },
  { question: "袁彭年的字是什么？", category: "百科知识", answer: "介眉", explain: "袁彭年，字介眉，别号特邱，湖广公安人。", source: "CMRC 2018 · 袁彭年" },
  { question: "袁彭年是哪里人？", category: "百科知识", answer: "湖广公安", explain: "袁彭年，字介眉，别号特邱，湖广公安人。", source: "CMRC 2018 · 袁彭年" },
  { question: "袁彭年历仕几朝？", category: "百科知识", answer: "三朝", explain: "崇祯七年（1635年）成进士，历仕崇祯、隆武、永历三朝。", source: "CMRC 2018 · 袁彭年" },
  { question: "中国唐朝以什么制度来表示尊荣？", category: "百科知识", answer: "“虚衔”", explain: "中国唐朝时则采取“虚衔”制度表示尊荣。", source: "CMRC 2018 · 贵族等级" },
  { question: "汉语中的爵位依照西方国家的贵族制度划分为几个等级？", category: "百科知识", answer: "五个", explain: "除爵位制度以外，诸侯国实行“世卿世禄制”，由诸侯分封上大夫卿、下大夫、上士、中士、下士等五个卿大夫等级，是没有爵位的世袭贵族等级。", source: "CMRC 2018 · 贵族等级" },
  { question: "国际消费者联会成员一共有多少个？", category: "百科知识", answer: "220个", explain: "国际消费者联会是全球独立的消费者组织联盟，成员共有220个来自115个国家的消费者组织，当中理事成员及执委成员有14及7位。", source: "CMRC 2018 · 刘燕卿" },
  { question: "2011年香港科技大学为刘燕卿授予了什么荣誉？", category: "百科知识", answer: "国际组织科大分会的荣誉会员", explain: "2011年1月，刘燕卿获香港科技大学商学院颁授，成为国际组织科大分会的荣誉会员。", source: "CMRC 2018 · 刘燕卿" },
  { question: "刘燕卿担任消委会的申诉专员的任期是多长？", category: "百科知识", answer: "五年", explain: "到了2014年3月17日，政府委任她出任申诉专员，4月1日生效，任期五年。", source: "CMRC 2018 · 刘燕卿" },
  { question: "四通控股有限公司的前身是什么？", category: "百科知识", answer: "四通电子技术有限公司", explain: "四通控股有限公司，简称四通控股，(港交所原代码：0409)，前身为四通电子技术有限公司，成立于1987年9月3日，是一家中国大陆民营企业。", source: "CMRC 2018 · 四通控股" },
  { question: "四通控股的创办人兼总裁是谁？", category: "百科知识", answer: "万润南", explain: "1989年天安门事件后，四通的创办人兼总裁万润南出走法国参加海外民运，并当选民主中国阵线 (民阵) 第二任主席。", source: "CMRC 2018 · 四通控股" },
  { question: "罗德·拉沃竞技场在什么地方？", category: "百科知识", answer: "澳洲维多利亚州墨尔本", explain: "罗德·拉沃竞技场（Rod Laver Arena）是一座位于澳洲维多利亚州墨尔本的一座大型网球竞技场，亦是四大满贯之一的澳洲网球公开赛现时的主要举办场地之一。", source: "CMRC 2018 · 罗德·拉沃竞技场" },
  { question: "罗德·拉沃竞技场是什么比赛的主要举办场地之一？", category: "百科知识", answer: "澳洲网球公开赛", explain: "罗德·拉沃竞技场（Rod Laver Arena）是一座位于澳洲维多利亚州墨尔本的一座大型网球竞技场，亦是四大满贯之一的澳洲网球公开赛现时的主要举办场地之一。", source: "CMRC 2018 · 罗德·拉沃竞技场" },
  { question: "罗德·拉沃竞技场每年吸引了多少游客参观？", category: "百科知识", answer: "1500万", explain: "每年亦吸引了大约1500万的游客参观访问。", source: "CMRC 2018 · 罗德·拉沃竞技场" },
  { question: "澉浦镇西边与哪个县接壤？", category: "百科知识", answer: "海宁县", explain: "澉浦镇是隶属于浙江省嘉兴市海盐县的一个镇，位于该县县境南部，西与海宁县接壤。", source: "CMRC 2018 · 澉浦镇" },
  { question: "澉浦镇的人口是多少？", category: "百科知识", answer: "15518人", explain: "面积24平方公里，人口15518人。", source: "CMRC 2018 · 澉浦镇" },
  { question: "嘉兴地区的最高峰是什么？", category: "百科知识", answer: "高阳山", explain: "在地势低平的杭嘉湖平原，澉浦镇拥有罕见的数座孤丘（长山、葫芦山、高阳山），其中高阳山是嘉兴地区的最高峰，海拔251.6米。", source: "CMRC 2018 · 澉浦镇" },
  { question: "澉浦在什么朝代曾设立市舶司？", category: "百科知识", answer: "宋、元", explain: "在宋、元两代，澉浦还曾经设为对外贸易口岸，设立市舶司。", source: "CMRC 2018 · 澉浦镇" },
  { question: "长齿锯犁鳗又被称为什么？", category: "百科知识", answer: "长齿锯齿鳗", explain: "长齿锯犁鳗，又称长齿锯齿鳗，为辐鳍鱼纲鳗鲡目糯鳗亚目锯齿鳗科的其中一个种。", source: "CMRC 2018 · 长齿锯犁鳗" },
  { question: "前鼻丝鳗又被称为什么？", category: "百科知识", answer: "前鼻鸭嘴鳗", explain: "前鼻丝鳗，又称前鼻鸭嘴鳗，为辐鳍鱼纲鳗鲡目糯鳗亚目鸭嘴鳗科的一个种。", source: "CMRC 2018 · 前鼻丝鳗" },
  { question: "前鼻丝鳗的体长是体高的多少倍？", category: "百科知识", answer: "31倍", explain: "体长为体高的31倍，头长9倍；", source: "CMRC 2018 · 前鼻丝鳗" },
  { question: "前鼻丝鳗主要栖息于什么样的海域？", category: "百科知识", answer: "400公尺深以上之中层海域", explain: "本于栖息在400公尺深以上之中层海域。", source: "CMRC 2018 · 前鼻丝鳗" },
  { question: "乍浦镇在哪里？", category: "百科知识", answer: "中国浙江省嘉兴平湖市", explain: "乍浦镇是隶属于中国浙江省嘉兴平湖市的一个镇，位于杭州湾北岸，毗邻上海市金山区。", source: "CMRC 2018 · 乍浦镇" },
  { question: "乍浦镇毗邻什么地方？", category: "百科知识", answer: "上海市金山区", explain: "乍浦镇是隶属于中国浙江省嘉兴平湖市的一个镇，位于杭州湾北岸，毗邻上海市金山区。", source: "CMRC 2018 · 乍浦镇" },
  { question: "乍浦镇的常住人口是多少？", category: "百科知识", answer: "5万余人", explain: "面积54平方公里，常住人口5万余人。", source: "CMRC 2018 · 乍浦镇" },
  { question: "1990年代以后哪个工厂在此建立原油码头？", category: "百科知识", answer: "上海石化总厂", explain: "1990年代以后，上海石化总厂在此建造原油码头。", source: "CMRC 2018 · 乍浦镇" },
  { question: "非洲猬目又名什么？", category: "百科知识", answer: "非洲鼩目", explain: "非洲猬目（Afrosoricida），又名非洲鼩目，是包含了南部非洲的金毛鼹及马达加斯加与非洲的马岛猬的目。", source: "CMRC 2018 · 非洲猬目" },
  { question: "科学家会使用什么来表示马岛猬／金毛鼹的分支？", category: "百科知识", answer: "Tenrecomorpha", explain: "一些科学家会使用Tenrecomorpha来表示马岛猬／金毛鼹的分支，但证据显示非洲猬目是更为合适的分类，而Tenrecomorpha则降为只有马岛猬的亚目。", source: "CMRC 2018 · 非洲猬目" },
  { question: "非洲猬目有时被认为是什么总目下的非洲食虫类分支？", category: "百科知识", answer: "非洲兽总目", explain: "非洲猬目有时被认为是属于非洲兽总目下的非洲食虫类分支。", source: "CMRC 2018 · 非洲猬目" },
  { question: "鲤鱼门天后庙又可以叫什么名字？", category: "百科知识", answer: "鲤鱼门天后宫", explain: "鲤鱼门天后庙，又称鲤鱼门天后宫，是香港一所天后庙，位于九龙油塘鲤鱼门，现被列为香港三级历史建筑。", source: "CMRC 2018 · 鲤鱼门天后庙" },
  { question: "鲤鱼门天后庙在哪里?", category: "百科知识", answer: "九龙油塘鲤鱼门", explain: "鲤鱼门天后庙，又称鲤鱼门天后宫，是香港一所天后庙，位于九龙油塘鲤鱼门，现被列为香港三级历史建筑。", source: "CMRC 2018 · 鲤鱼门天后庙" },
  { question: "这个鲤鱼门天后庙建于哪一年？", category: "百科知识", answer: "清朝乾隆十八年（1753年）", explain: "鲤鱼门天后庙建于清朝乾隆十八年（1753年），由当时盘踞鲤鱼门海域的海盗郑连昌建成。", source: "CMRC 2018 · 鲤鱼门天后庙" },
  { question: "鲤鱼门天后庙是谁建的？", category: "百科知识", answer: "郑连昌", explain: "鲤鱼门天后庙建于清朝乾隆十八年（1753年），由当时盘踞鲤鱼门海域的海盗郑连昌建成。", source: "CMRC 2018 · 鲤鱼门天后庙" },
  { question: "历史上住在斯韦阿兰的原住民被称为什么？", category: "百科知识", answer: "「斯韦阿人」", explain: "历史上，住在斯韦阿兰的原住民被称为「斯韦阿人」（）。", source: "CMRC 2018 · 斯韦阿兰" },
  { question: "斯韦阿兰占地多大？", category: "百科知识", answer: "91,098平方公里", explain: "斯韦阿兰占地91,098平方公里，是三个地区之中最小的。", source: "CMRC 2018 · 斯韦阿兰" },
  { question: "斯韦阿兰的国王在什么时候发动了十字军东征？", category: "百科知识", answer: "12世纪", explain: "斯韦阿兰的国王在12世纪发动了十字军东征，征服了埃斯特拉兰的土地，即芬兰。", source: "CMRC 2018 · 斯韦阿兰" },
  { question: "庆大霉素常见的商品名是什么？", category: "百科知识", answer: "「Garamycin」", explain: "庆大霉素（），常见商品名「Garamycin」是一种抗生素，主要用于治疗以革兰氏阴性菌为主的感染。", source: "CMRC 2018 · 庆大霉素" },
  { question: "妊娠期使用庆大霉素可能会导致什么后果？", category: "百科知识", answer: "伤害胎儿", explain: "妊娠期间用药可能伤害胎儿，哺乳期间用药目前显示安全。", source: "CMRC 2018 · 庆大霉素" },
  { question: "庆大霉素是哪一年被发现的？", category: "百科知识", answer: "1963年", explain: "庆大霉素于1963年首次发现，是从身上提炼而得。", source: "CMRC 2018 · 庆大霉素" },
  { question: "王江泾镇在哪里？", category: "百科知识", answer: "中国浙江省嘉兴市秀洲区", explain: "王江泾镇是隶属于中国浙江省嘉兴市秀洲区的一个镇，南面毗邻嘉兴城区，北面毗邻江苏省吴江市盛泽镇。", source: "CMRC 2018 · 王江泾镇" },
  { question: "王江泾镇的南面毗邻什么地方？", category: "百科知识", answer: "嘉兴城区", explain: "王江泾镇是隶属于中国浙江省嘉兴市秀洲区的一个镇，南面毗邻嘉兴城区，北面毗邻江苏省吴江市盛泽镇。", source: "CMRC 2018 · 王江泾镇" },
  { question: "王江泾镇内有多少人口？", category: "百科知识", answer: "8.57万", explain: "面积127平方公里，人口8.57万。", source: "CMRC 2018 · 王江泾镇" },
  { question: "王江泾镇主要以什么行业为主？", category: "百科知识", answer: "纺织业", explain: "王江泾镇是位于江、浙两省交界处一个历史悠久的工商业市镇，一向以纺织业为主。", source: "CMRC 2018 · 王江泾镇" },
  { question: "前肛鳗以什么为食？", category: "百科知识", answer: "小型鱼类、甲壳类及软体动物", explain: "属于底栖鱼类，多分布在1000~200公尺之海底属优势鱼种，以小型鱼类、甲壳类及软体动物为食。", source: "CMRC 2018 · 前肛鳗" },
  { question: "异齿前肛鳗又被称为什么?", category: "百科知识", answer: "长身前肛鳗", explain: "异齿前肛鳗，又称长身前肛鳗，为辐鳍鱼纲鳗鲡目糯鳗亚目通鳃鳗科的其中一个种。", source: "CMRC 2018 · 异齿前肛鳗" },
  { question: "异齿前肛鳗分布在什么地区？", category: "百科知识", answer: "印度西太平洋海域", explain: "本鱼分布于印度西太平洋海域。", source: "CMRC 2018 · 异齿前肛鳗" },
  { question: "异齿前肛鳗生活的水深是多少？", category: "百科知识", answer: "100至400公尺", explain: "属于底栖鱼类，在100至400公尺深之海底生活，以小型鱼类、甲壳类及软体动物为食。", source: "CMRC 2018 · 异齿前肛鳗" },
  { question: "高氏前肛鳗分布在什么地方？", category: "百科知识", answer: "印度西太平洋海域", explain: "本鱼分布于印度西太平洋海域。", source: "CMRC 2018 · 高氏前肛鳗" },
  { question: "高氏前肛鳗有几列上颌骨齿？", category: "百科知识", answer: "4列", explain: "上颌骨齿细小，约4列，最内侧的牙齿较大；", source: "CMRC 2018 · 高氏前肛鳗" },
  { question: "高氏前肛鳗以什么为食？", category: "百科知识", answer: "小型鱼类、甲壳类及软体动物", explain: "属于底栖鱼类，在100至400公尺深之海底生活，以小型鱼类、甲壳类及软体动物为食。", source: "CMRC 2018 · 高氏前肛鳗" },
  { question: "1999年国家联盟分区赛采用什么赛制？", category: "百科知识", answer: "5战3胜制", explain: "三个分区的冠军与外卡队伍，两两捉对厮杀，分别进行5战3胜制的系列赛。", source: "CMRC 2018 · 1999年国家联盟分区赛" },
  { question: "黑尾前肛鳗分布在什么地区？", category: "百科知识", answer: "台湾西南海域", explain: "本鱼分布于台湾西南海域。", source: "CMRC 2018 · 黑尾前肛鳗" },
  { question: "黑尾前肛鳗的体长是体高的多少倍？", category: "百科知识", answer: "20.1倍", explain: "体长为体高的20.1倍；", source: "CMRC 2018 · 黑尾前肛鳗" },
  { question: "辣豆酱源于什么地方？", category: "百科知识", answer: "西班牙语美洲", explain: "辣豆酱原本是一道源自西班牙语美洲的菜肴，但传入美国后有很大的变化，比如全素的辣豆酱。", source: "CMRC 2018 · 辣豆酱" },
  { question: "李成栋的字是什么？", category: "百科知识", answer: "廷贞", explain: "李成栋（），字廷贞，山西人（一说宁夏人）。", source: "CMRC 2018 · 李成栋 (明朝)" },
  { question: "李成栋是哪里人？", category: "百科知识", answer: "山西", explain: "李成栋（），字廷贞，山西人（一说宁夏人）。", source: "CMRC 2018 · 李成栋 (明朝)" },
  { question: "顺治二年，谁兵下江南之后，成栋降清？", category: "百科知识", answer: "清豫亲王多铎", explain: "顺治二年四月，清豫亲王多铎兵下江南，成栋率所部降清。", source: "CMRC 2018 · 李成栋 (明朝)" },
  { question: "涞滩镇的面积是多少平方公里？", category: "百科知识", answer: "70.99平方公里", explain: "涞滩镇，中国重庆市合川区下属的一个镇，面积70.99平方公里，下辖19个村委会、3个居委会，总人口13011人（2000年）。", source: "CMRC 2018 · 涞滩镇" },
  { question: "涞滩镇的总人口是多少？", category: "百科知识", answer: "13011人（2000年）", explain: "涞滩镇，中国重庆市合川区下属的一个镇，面积70.99平方公里，下辖19个村委会、3个居委会，总人口13011人（2000年）。", source: "CMRC 2018 · 涞滩镇" },
  { question: "武藏浦和站可分为几个部分？", category: "百科知识", answer: "分为两个部份。", explain: "武藏浦和站是一个高架车站，可分为两个部份。在东边较矮的是武藏野线的月台，采2座侧式月台2线设计。", source: "CMRC 2018 · 武藏浦和站" },
  { question: "原冈瓦那大陆的意思是什么？", category: "百科知识", answer: "最初的冈瓦那大陆", explain: "原冈瓦那大陆（Proto-Gondwana）意为「最初的冈瓦那大陆」，是个史前大陆，存在于中元古代到新元古代。", source: "CMRC 2018 · 原冈瓦那大陆" },
  { question: "原冈瓦那大陆存在于哪个时期？", category: "百科知识", answer: "中元古代到新元古代", explain: "原冈瓦那大陆（Proto-Gondwana）意为「最初的冈瓦那大陆」，是个史前大陆，存在于中元古代到新元古代。", source: "CMRC 2018 · 原冈瓦那大陆" },
  { question: "Stam1na是什么？", category: "百科知识", answer: "金属乐队", explain: "Stam1na是芬兰南卡累利阿区莱米的一支本土金属乐队，其主要音乐风格为前卫金属，同时受鞭击金属、死亡金属和另类金属影响。", source: "CMRC 2018 · Stam1na" },
  { question: "Stam1na的主要音乐风格是什么？", category: "百科知识", answer: "前卫金属", explain: "Stam1na是芬兰南卡累利阿区莱米的一支本土金属乐队，其主要音乐风格为前卫金属，同时受鞭击金属、死亡金属和另类金属影响。", source: "CMRC 2018 · Stam1na" },
  { question: "Stam1na的首张专辑在哪年发行？", category: "百科知识", answer: "2005年", explain: "贝斯手凯-佩卡·坎加斯迈基（Kai-Pekka Kangasmäki）于2005年11月加入乐队使阵容得以完整。", source: "CMRC 2018 · Stam1na" },
  { question: "乙烯醇的分子式是什么？", category: "百科知识", answer: "CHOH", explain: "乙烯醇（英语：Ethenol），是分子式为CHOH（HC=CHOH）的烯醇，CAS号557-75-5。", source: "CMRC 2018 · 乙烯醇" },
  { question: "乙烯醇具有什么性质？", category: "百科知识", answer: "不稳定性", explain: "由于乙烯醇的不稳定性，其形式聚合物—聚乙烯醇（PVA）不是由乙烯醇作单体聚合制备的，而是从醋酸乙烯酯聚合，再水解酯键得到的。", source: "CMRC 2018 · 乙烯醇" },
  { question: "氨碱法又可以叫什么？", category: "百科知识", answer: "索尔维制碱法", explain: "又称“索尔维制碱法”）是1861年比利时工业化学家欧内斯特·索尔维（，1832-1922）发明的用氨水来使氯化钠转变为碳酸钠的方法。", source: "CMRC 2018 · 氨碱法" },
  { question: "氨碱法是由谁发明的？", category: "百科知识", answer: "欧内斯特·索尔维", explain: "又称“索尔维制碱法”）是1861年比利时工业化学家欧内斯特·索尔维（，1832-1922）发明的用氨水来使氯化钠转变为碳酸钠的方法。", source: "CMRC 2018 · 氨碱法" },
  { question: "氨碱法在什么时候实现现代化生产？", category: "百科知识", answer: "19世纪60年代", explain: "此法于19世纪60年代由索尔维公司实现现代化生产。", source: "CMRC 2018 · 氨碱法" },
  { question: "氨碱法是用来生产什么的？", category: "百科知识", answer: "碳酸钠", explain: "又称“索尔维制碱法”）是1861年比利时工业化学家欧内斯特·索尔维（，1832-1922）发明的用氨水来使氯化钠转变为碳酸钠的方法。", source: "CMRC 2018 · 氨碱法" },
  { question: "原劳亚大陆的意思是什么？", category: "百科知识", answer: "最初的劳亚大陆", explain: "原劳亚大陆（Proto-Gondwana）意为「最初的劳亚大陆」，是个史前大陆。", source: "CMRC 2018 · 原劳亚大陆" },
  { question: "原劳亚大陆曾先后是哪两个大陆的一部分？", category: "百科知识", answer: "罗迪尼亚大陆、潘诺西亚大陆", explain: "原劳亚大陆曾先后是罗迪尼亚大陆、潘诺西亚大陆的一部分。", source: "CMRC 2018 · 原劳亚大陆" },
  { question: "乙二醛是有机还是无机化合物？", category: "百科知识", answer: "有机化合物", explain: "乙二醛是一个有机化合物，化学式为OCHCHO，由两个醛基-C相连。", source: "CMRC 2018 · 乙二醛" },
  { question: "乙二醛的化学式是什么？", category: "百科知识", answer: "OCHCHO", explain: "乙二醛是一个有机化合物，化学式为OCHCHO，由两个醛基-C相连。", source: "CMRC 2018 · 乙二醛" },
  { question: "室温下乙二醛的物理性态是什么样的？", category: "百科知识", answer: "黄色液体", explain: "它是最简单的二醛，室温下为黄色液体。", source: "CMRC 2018 · 乙二醛" },
  { question: "沃夫424是什么？", category: "百科知识", answer: "由两颗红矮星组成的联星系统", explain: "沃夫424是一个由两颗红矮星组成的联星系统，距离太阳大约14.2光年，它目前的位置在室女座的东次将（室女座ε）星和东次相（室女座δ）星之间。", source: "CMRC 2018 · 沃夫424" },
  { question: "沃夫424距离太阳多远？", category: "百科知识", answer: "14.2光年", explain: "沃夫424是一个由两颗红矮星组成的联星系统，距离太阳大约14.2光年，它目前的位置在室女座的东次将（室女座ε）星和东次相（室女座δ）星之间。", source: "CMRC 2018 · 沃夫424" },
  { question: "硫醚的通式是什么？", category: "百科知识", answer: "R-S-R", explain: "硫醚是有机硫化合物的一种，通式为R-S-R，其中R是有机基团。", source: "CMRC 2018 · 硫醚" },
  { question: "挥发性的硫醚大多具有什么气味？", category: "百科知识", answer: "腐烂的气味", explain: "与其他含硫化合物类似，挥发性的硫醚大多具有腐烂的气味。", source: "CMRC 2018 · 硫醚" },
  { question: "白岳峰是哪一个少数民族的？", category: "百科知识", answer: "朝鲜族", explain: "白岳峰（백악봉，），朝鲜族，曾用名白磊，中国足球运动员，司职中场，现效力于中超球队天津泰达。", source: "CMRC 2018 · 白岳峰" },
  { question: "白岳峰打什么位置？", category: "百科知识", answer: "中场", explain: "白岳峰（백악봉，），朝鲜族，曾用名白磊，中国足球运动员，司职中场，现效力于中超球队天津泰达。", source: "CMRC 2018 · 白岳峰" },
  { question: "白岳峰现效力于哪支球队？", category: "百科知识", answer: "中超球队天津泰达", explain: "白岳峰（백악봉，），朝鲜族，曾用名白磊，中国足球运动员，司职中场，现效力于中超球队天津泰达。", source: "CMRC 2018 · 白岳峰" },
  { question: "粘姓是什么人的后裔姓氏之一？", category: "百科知识", answer: "女真人", explain: "粘姓在华人社会中是一个特殊罕见姓氏，为女真人后裔姓氏之一。", source: "CMRC 2018 · 粘姓" },
  { question: "粘姓的原姓是什么？", category: "百科知识", answer: "完颜", explain: "粘氏原本是女真族，而其原姓为完颜，金太祖完颜阿骨打与粘氏有亲属关系。", source: "CMRC 2018 · 粘姓" },
  { question: "姆拉登·佩特里奇是哪国人？", category: "百科知识", answer: "克罗地亚", explain: "姆拉登·佩特里奇（，），是一名克罗地亚职业足球运动员，司职前锋或影子前锋。", source: "CMRC 2018 · 姆拉登·佩特里奇" },
  { question: "姆拉登·佩特里奇的职业是什么？", category: "百科知识", answer: "职业足球运动员", explain: "姆拉登·佩特里奇（，），是一名克罗地亚职业足球运动员，司职前锋或影子前锋。", source: "CMRC 2018 · 姆拉登·佩特里奇" },
  { question: "姆拉登·佩特里奇打哪个位置？", category: "百科知识", answer: "前锋或影子前锋", explain: "姆拉登·佩特里奇（，），是一名克罗地亚职业足球运动员，司职前锋或影子前锋。", source: "CMRC 2018 · 姆拉登·佩特里奇" },
  { question: "2007年，佩特里奇加盟哪个球队？", category: "百科知识", answer: "德甲多特蒙德队", explain: "2007年夏天，佩特里奇加盟德甲多特蒙德队，在第一个赛季表现极其出色。", source: "CMRC 2018 · 姆拉登·佩特里奇" },
  { question: "《安般守意经》被收在什么作品中？", category: "百科知识", answer: "《大正藏》", explain: "《安般守意经》，东汉安世高所译之坐禅佛典，收于《大正藏》经集部，论述以观察呼吸作为修习禅定的方法。", source: "CMRC 2018 · 安般守意经" },
  { question: "杨群是哪里人？", category: "百科知识", answer: "哈尔滨", explain: "杨群（，），哈尔滨人，香港知名老牌演员，属邵氏元老之一。", source: "CMRC 2018 · 杨群" },
  { question: "杨群的职业是什么？", category: "百科知识", answer: "演员", explain: "杨群（，），哈尔滨人，香港知名老牌演员，属邵氏元老之一。", source: "CMRC 2018 · 杨群" },
  { question: "杨群现居哪里？", category: "百科知识", answer: "美国洛杉矶", explain: "他获得过第七届（1969年）和第十一届（1973年）台湾金马奖最佳男主角，现居美国洛杉矶。", source: "CMRC 2018 · 杨群" },
  { question: "杨群的首部作品叫什么？", category: "百科知识", answer: "《碧血黄花》", explain: "他于1950年代已投身影坛，参与的首部作品乃《碧血黄花》，至1963年他凭《秦香莲》一片声名大噪，自此片约不断。", source: "CMRC 2018 · 杨群" },
  { question: "尼古拉·卡利尼奇是职业什么职业呀？", category: "百科知识", answer: "职业足球运动员", explain: "尼古拉·卡利尼奇（：Nikola Kalinić，），是一名克罗地亚职业足球运动员，司职前锋，被国家队主帅比利奇赞美为“克罗地亚足球的未来”。", source: "CMRC 2018 · 尼古拉·卡利尼奇" },
  { question: "尼古拉·卡利尼奇是哪国人？", category: "百科知识", answer: "克罗地亚", explain: "尼古拉·卡利尼奇（：Nikola Kalinić，），是一名克罗地亚职业足球运动员，司职前锋，被国家队主帅比利奇赞美为“克罗地亚足球的未来”。", source: "CMRC 2018 · 尼古拉·卡利尼奇" },
  { question: "尼古拉·卡利尼奇在哪年和英超球会布力般流浪签约？", category: "百科知识", answer: "2009年", explain: "2009年8月3日哈伊杜克宣称卡利尼奇已与英超球会布力般流浪签署四年合约，转会费达到1,200万英镑。", source: "CMRC 2018 · 尼古拉·卡利尼奇" },
  { question: "莱索托哪一年独立？", category: "百科知识", answer: "1966年", explain: "在莱索托于1966年独立之前，那时只有马塞卢内的Mejametalana机场路皇宫才有铺平道路。", source: "CMRC 2018 · 莱索托交通" },
  { question: "莱索托有几个国际机场？", category: "百科知识", answer: "一个", explain: "因是一个内陆国家，莱索托没有港口，海港，但是有道路、空路和有限的铁路服务。", source: "CMRC 2018 · 莱索托交通" },
  { question: "最近莱索托的主要港口是哪一个？", category: "百科知识", answer: "南非德班", explain: "最近莱索托的主要港口是南非德班。", source: "CMRC 2018 · 莱索托交通" },
  { question: "谢尔的面积有多大？", category: "百科知识", answer: "19.2平方公里", explain: "谢尔（法语：）是瑞士瓦莱州谢尔区的一座城市，面积19.2平方公里，人口14355人（2002年）。", source: "CMRC 2018 · 谢尔" },
  { question: "谢尔人口有多少？", category: "百科知识", answer: "14355人（2002年）", explain: "谢尔（法语：）是瑞士瓦莱州谢尔区的一座城市，面积19.2平方公里，人口14355人（2002年）。", source: "CMRC 2018 · 谢尔" },
  { question: "松鸦又可以叫什么？", category: "百科知识", answer: "㭴鸟、橿鸟", explain: "松鸦（学名：），又名㭴鸟、橿鸟，是一种分布极广泛的鸦科动物，包括西欧大部分地区，至非洲的东北部，以至亚洲的东海岸以及东南亚等地均有分内。", source: "CMRC 2018 · 松鸦" },
  { question: "尼高·高华的职业是什么？", category: "百科知识", answer: "职业足球运动员", explain: "尼高·高华（克罗地亚语：，），是一名克罗地亚职业足球运动员，前任克罗地亚国家队队长。", source: "CMRC 2018 · 尼科·科瓦奇" },
  { question: "尼高·高华是哪国人？", category: "百科知识", answer: "克罗地亚", explain: "尼高·高华（克罗地亚语：，），是一名克罗地亚职业足球运动员，前任克罗地亚国家队队长。", source: "CMRC 2018 · 尼科·科瓦奇" },
  { question: "尼高·高华以什么著称？", category: "百科知识", answer: "抢截和传球技术", explain: "在球场上他司职防守型中场，以抢截和传球技术而著称。", source: "CMRC 2018 · 尼科·科瓦奇" },
  { question: "半球状炮塔的外径是多少米？", category: "百科知识", answer: "近6米", explain: "半球状炮塔外径近6米，高4.7米。", source: "CMRC 2018 · AK-130舰砲" },
  { question: "黑褐新箭雀鲷又可以叫什么？", category: "百科知识", answer: "黑褐副雀鲷、拟黑雀鲷", explain: "黑褐新箭雀鲷，又称黑褐副雀鲷、拟黑雀鲷，俗名为厚壳仔，为辐鳍鱼纲鲈形目隆头鱼亚目雀鲷科的其中一种。", source: "CMRC 2018 · 黑褐新箭雀鲷" },
  { question: "黑褐新箭雀鲷的栖息环境是什么样的？", category: "百科知识", answer: "珊瑚礁密生的礁湖或向海斜坡", explain: "本鱼栖息在珊瑚礁密生的礁湖或向海斜坡上，大多独自行动，属杂食性，以摄食藻类、甲壳类等为生。", source: "CMRC 2018 · 黑褐新箭雀鲷" },
  { question: "班卡雀鲷还可以叫什么？", category: "百科知识", answer: "细点齿鲷", explain: "班卡雀鲷，又称细点齿鲷，俗名为厚壳仔，为辐鳍鱼纲鲈形目隆头鱼亚目雀鲷科的其中一种。", source: "CMRC 2018 · 班卡雀鲷" },
  { question: "西湾河电车厂简称什么？", category: "百科知识", answer: "西电", explain: "西湾河电车厂（简称西电；", source: "CMRC 2018 · 西湾河电车厂" },
  { question: "香港天文台发出什么信号时电车厂会暂停服务？", category: "百科知识", answer: "一号戒备信号或三号强风信号", explain: "如香港天文台发出一号戒备信号或三号强风信号电车厂会如常运作，如预八号烈风或暴风信号会维持有限度服务，如预九号烈风或暴风增强信号或更高信号，电车厂会暂停服务。", source: "CMRC 2018 · 西湾河电车厂" },
  { question: "霓虹雀鲷的俗名叫什么？", category: "百科知识", answer: "天蓝雀鲷", explain: "霓虹雀鲷，又称天蓝雀鲷，俗名为厚壳仔，为辐鳍鱼纲鲈形目隆头鱼亚目雀鲷科的其中一种。", source: "CMRC 2018 · 霓虹雀鲷" },
  { question: "五羊新城又称什么？", category: "百科知识", answer: "五羊邨、五羊新村", explain: "五羊新城，又称五羊邨、五羊新村，是中国广州市越秀区（原东山区）东南角的一个街区，位于由广州大道中、明月二路、明月路、寺右二马路、东兴南路围成的范围内。", source: "CMRC 2018 · 五羊新城" },
  { question: "五羊新城由哪个公司开发？", category: "百科知识", answer: "东华实业", explain: "五羊新城于1980年代由东华实业开发。", source: "CMRC 2018 · 五羊新城" },
  { question: "银花鲈鱼在大陆又被叫什么？", category: "百科知识", answer: "条纹鲈", explain: "银花鲈鱼 （学名：'），大陆又称条纹鲈，原产于大西洋，是马里兰州、罗德岛州、南卡罗莱纳州、以及纽约州的州代表鱼。", source: "CMRC 2018 · 银花鲈鱼" },
  { question: "银花鲈鱼原产于哪里？", category: "百科知识", answer: "大西洋", explain: "银花鲈鱼 （学名：'），大陆又称条纹鲈，原产于大西洋，是马里兰州、罗德岛州、南卡罗莱纳州、以及纽约州的州代表鱼。", source: "CMRC 2018 · 银花鲈鱼" },
  { question: "短吻硕鬣狗站立时肩高约有多少米？", category: "百科知识", answer: "1米", explain: "硕鬣狗最大及最多资料的短吻硕鬣狗站立时肩高约有1米，重达200公斤，差不多是一只细小狮子的重量，而牠却更为粗壮。", source: "CMRC 2018 · 硕鬣狗" },
  { question: "澳门市划分为几个堂区？", category: "百科知识", answer: "五个", explain: "澳门在葡属时期划分为两个市即澳门市和海岛市，澳门市（澳门半岛）再划分为五个堂区，海岛市（氹仔和路环）再划分为两个堂区。", source: "CMRC 2018 · 澳门行政区划" },
  { question: "朗孜厦的哪层楼是地牢？", category: "百科知识", answer: "一楼", explain: "朗孜厦大门设于二楼，一楼为地牢，除杀人案需报噶厦处理外，其余地牢犯人均可随意处置。", source: "CMRC 2018 · 朗孜厦" },
  { question: "朗孜厦的长官需经谁同意后任命？", category: "百科知识", answer: "达赖喇嘛", explain: "朗孜厦的长官为五品米本二人，由噶厦拟定经达赖喇嘛同意后任命，米本下设有文书一人、管理人员二名、房管员一人、警察连长一名、警员二十余名。", source: "CMRC 2018 · 朗孜厦" },
  { question: "朗孜厦在哪一世达赖时期成为司法机构？", category: "百科知识", answer: "七世达赖时期", explain: "朗孜厦始建于17世纪五世达赖喇嘛在位时期，在七世达赖时期成为司法机构，1959年3月十四世达赖喇嘛出逃后被中华人民共和国政府关闭，后进行过多次修缮，今辟为博物馆。", source: "CMRC 2018 · 朗孜厦" },
  { question: "《飞黄腾达7》曾在美国哪个频道播出？", category: "百科知识", answer: "NBC", explain: "飞黄腾达7为美国真人秀《飞黄腾达》的第七辑，于2008年1月3日开始于美国NBC频道播出。", source: "CMRC 2018 · 飞黄腾达7" },
  { question: "胜出者能为其机构获得多少美金？", category: "百科知识", answer: "25万", explain: "本辑的参赛者全是美国的知名人物（除Omarosa外），并为他们支持的慈善机构筹款，每集胜出的项目经理能为其机构筹得一笔款项，最后胜出者能为其机构获得25万美金。", source: "CMRC 2018 · 飞黄腾达7" },
  { question: "男方的队伍名是什么？", category: "百科知识", answer: "九头蛇", explain: "男方的队伍名为九头蛇（Hydra）（港译：许德拉），女方的队伍名为实业家（Empresario）（港译：企业家）。", source: "CMRC 2018 · 飞黄腾达7" },
  { question: "女方队伍叫什么名字？", category: "百科知识", answer: "实业家", explain: "男方的队伍名为九头蛇（Hydra）（港译：许德拉），女方的队伍名为实业家（Empresario）（港译：企业家）。", source: "CMRC 2018 · 飞黄腾达7" },
  { question: "九龙巴士95M线是香港一条来往哪里的路线？", category: "百科知识", answer: "翠林及观塘（雅丽道）", explain: "九龙巴士95M线是香港一条来往翠林及观塘（雅丽道）的路线，为将军澳西（康盛花园、翠林）民居提供来往观塘区的服务。", source: "CMRC 2018 · 九龙巴士95M线" },
  { question: "曾伟明的出生地在哪里？", category: "百科知识", answer: "马来西亚", explain: "曾伟明于1952年生于马来西亚，约1959年及1960年移居香港荃湾青龙头圆墩村至今。", source: "CMRC 2018 · 曾伟明" },
  { question: "徐小明在哪一部电影的演技启发了曾伟明加入演艺圈？", category: "百科知识", answer: "《流浪小天使》", explain: "当中徐小明在《流浪小天使》这出1964年的电影的演技启发曾伟明日后加入演艺圈。", source: "CMRC 2018 · 曾伟明" },
  { question: "曾伟明当亚洲电视男艺员时的代表作是什么？", category: "百科知识", answer: "《再见艳阳天》", explain: "他亦是亚洲电视前男艺员，《再见艳阳天》为其代表作。", source: "CMRC 2018 · 曾伟明" },
  { question: "冈察洛夫是哪一国的小说家？", category: "百科知识", answer: "俄罗斯", explain: "冈察洛夫（俄语：，儒略历1812年6月6日－1891年9月15日，合格里历），俄罗斯小说家，代表作有《奥勃洛莫夫》（1859年）等。", source: "CMRC 2018 · 伊凡·亚历山大罗维奇·冈察洛夫" },
  { question: "1831年时冈察洛夫进入了什么大学？", category: "百科知识", answer: "莫斯科大学", explain: "1831年他进入莫斯科大学语文系，1834年大学毕业后到政府工作达30年。", source: "CMRC 2018 · 伊凡·亚历山大罗维奇·冈察洛夫" },
  { question: "冈察洛夫的最后一部长篇小说是什么？", category: "百科知识", answer: "《悬崖》", explain: "1867年，他辞去政府职务，并发表他最后一部长篇小说《悬崖》（1869年）。", source: "CMRC 2018 · 伊凡·亚历山大罗维奇·冈察洛夫" },
  { question: "元朗千色汇在2015年3月之前叫什么？", category: "百科知识", answer: "千色广场", explain: "元朗千色汇（），2015年3月前称千色广场（），是一座位于香港元朗教育路1号的中型零售购物，于1994年落成。", source: "CMRC 2018 · 元朗千色汇" },
  { question: "元朗千色汇在哪一年落成？", category: "百科知识", answer: "1994年", explain: "元朗千色汇（），2015年3月前称千色广场（），是一座位于香港元朗教育路1号的中型零售购物，于1994年落成。", source: "CMRC 2018 · 元朗千色汇" },
  { question: "元朗千色汇主要有什么用途？", category: "百科知识", answer: "购物消闲", explain: "商场坐落教育路及大棠路交界，与青山公路－元朗段和轻铁大棠路站相距仅5分钟步程，地点兴旺，人流量高，也有较多针对年轻人客源的商店，是区内主要的购物消闲地点之一。", source: "CMRC 2018 · 元朗千色汇" },
  { question: "在元朗千色汇之前，该地是什么建筑？", category: "百科知识", answer: "校舍", explain: "1948年，侨港东莞同乡会元朗分会已于大旗岭区购置校舍，并开设一至四年级四班。", source: "CMRC 2018 · 元朗千色汇" },
  { question: "单人剧情模式的最后一战是谁与谁的对决？", category: "百科知识", answer: "漩涡鸣人与宇智波佐助", explain: "单人剧情模式由动画火影忍者疾风传的剧情开始，中途须经历28个关卡，最后一战为漩涡鸣人与宇智波佐助的对决。", source: "CMRC 2018 · 火影忍者疾风传 激斗忍者大战！EX2" },
  { question: "单人对战模式之下还多出了哪三种模式？", category: "百科知识", answer: "绩分战、时间战、生存战", explain: "对战模式可选择一至四人的对战，单人对战模式之下，还多出了绩分战、时间战、生存战等三种模式。", source: "CMRC 2018 · 火影忍者疾风传 激斗忍者大战！EX2" },
  { question: "林双不在读初级中学时曾以什么为笔名投稿赚零用钱？", category: "百科知识", answer: "碧竹", explain: "就读台湾省立虎尾初级中学（今国立虎尾高级中学）时，以「碧竹」为笔名，靠稿费赚取零用钱。", source: "CMRC 2018 · 林双不" },
  { question: "卡特里娜骷髅头是谁创造的锡版画角色？", category: "百科知识", answer: "何塞·瓜达卢佩·波萨达", explain: "卡特里娜骷髅头（西班牙语：la Calavera de la Catrina）是墨西哥刻版画家何塞·瓜达卢佩·波萨达于1913年所创造的锡版画角色。", source: "CMRC 2018 · 卡翠娜骷髅头" },
  { question: "「catrina」的意思是什么？", category: "百科知识", answer: "花花公主", explain: "「catrina」是「catrín」的阴性名词 ，意思是“花花公主”。", source: "CMRC 2018 · 卡翠娜骷髅头" },
  { question: "2008年迟子建凭借哪一部小说荣膺第七届茅盾文学奖？", category: "百科知识", answer: "《额尔古纳河右岸》", explain: "迟子建（），中国女作家，出生于中国最北端的黑龙江省漠河县的北极村，2008年凭借《额尔古纳河右岸》荣膺第七届茅盾文学奖，是中国具有广泛影响力的作家之一。", source: "CMRC 2018 · 迟子建" },
  { question: "1986年迟子建在《人民文学》上发表哪篇文章而成名？", category: "百科知识", answer: "《北极村的童话》", explain: "1986年，迟子建在《人民文学》上发表《北极村的童话》一文，从而成名。", source: "CMRC 2018 · 迟子建" },
  { question: "零食物语专门销售哪个国家的零食？", category: "百科知识", answer: "日本", explain: "零食物语（）为香港一间专门销售日本零食的连锁店，属四洲集团旗下的零售店，代理包括明治及固力果等品牌。", source: "CMRC 2018 · 零食物语" },
  { question: "零食物语创立于哪一年？", category: "百科知识", answer: "1997年", explain: "零食物语于1997年创立，高峰期拥有超过60间分店，位处各大型商场及港铁站，并自2006年起拓展国内业务，于上海、北京、顺德等主要城市建立销售点。", source: "CMRC 2018 · 零食物语" },
  { question: "印度空间研究组织创建于哪一年？", category: "百科知识", answer: "1972年", explain: "印度空间研究组织（，缩写：，，缩写：）是印度的国家航天机构，创建于1972年，总部位于印度班加罗尔，雇佣约2万名员工，主要从事与航天和空间科学有关的研究。", source: "CMRC 2018 · 印度空间研究组织" },
  { question: "2008年印度空间研究组织将什么发射升空？", category: "百科知识", answer: "月船1号", explain: "2008年10月22日，印度空间研究组织在斯里赫里戈达岛萨迪什·达万航天中心用一枚极地卫星运载火箭将印度首个月球探测器月船1号发射升空。", source: "CMRC 2018 · 印度空间研究组织" },
  { question: "颊鳞雀鲷的俗名叫什么？", category: "百科知识", answer: "厚壳仔", explain: "颊鳞雀鲷，俗名为厚壳仔，为辐鳍鱼纲鲈形目隆头鱼亚目雀鲷科的其中一种。", source: "CMRC 2018 · 颊鳞雀鲷" },
  { question: "黄衫女子是金庸哪一部武侠小说的角色？", category: "百科知识", answer: "《倚天屠龙记》", explain: "黄衫女子，金庸武侠小说《倚天屠龙记》的角色。", source: "CMRC 2018 · 黄衫女子" },
  { question: "侏罗纪海岸哪一年入选联合国教科文组织世界遗产？", category: "百科知识", answer: "2001年", explain: "2001年入选联合国教科文组织世界遗产。", source: "CMRC 2018 · 侏罗纪海岸" },
  { question: "玛丽·安宁研究海岸线上的化石时发现了哪个完整的化石？", category: "百科知识", answer: "鱼龙目化石", explain: "该地区是古生物学家玛丽·安宁的故乡，她研究海岸线上的化石并发现了第一个完整的鱼龙目化石。", source: "CMRC 2018 · 侏罗纪海岸" },
  { question: "侏罗纪早期，中国是由哪两个板块碰撞形成的？", category: "百科知识", answer: "华南陆块与盘古大陆", explain: "侏㑩纪早期，华南陆块与盘古大陆（华北陆块部分）碰撞，形成今日的中国。", source: "CMRC 2018 · 扬子克拉通" },
  { question: "莱姆里杰斯是哪个国家的海滨城市？", category: "百科知识", answer: "英国", explain: "莱姆里杰斯（）是英国多塞特郡的一个海滨城市，位于英吉利海峡德文郡和多塞特郡交界的莱姆湾畔。", source: "CMRC 2018 · 莱姆里杰斯" },
  { question: "大鳞大眼鲷的俗名是什么？", category: "百科知识", answer: "红目鲢、红目眶", explain: "大鳞大眼鲷，又称日本锯大眼鲷，俗名红目鲢、红目眶，为辐鳍鱼纲鲈形目的其中一个种。", source: "CMRC 2018 · 大鳞大眼鲷" },
  { question: "大鳞大眼鲷分布于哪一大洋区？", category: "百科知识", answer: "印度西太平洋区", explain: "本鱼分布于印度西太平洋区，包括东非、红海、台湾、澳洲、菲律宾等海域。", source: "CMRC 2018 · 大鳞大眼鲷" },
  { question: "大鳞大眼鲷的鱼体呈什么颜色？", category: "百科知识", answer: "赤红色", explain: "本鱼体呈赤红色，体甚高，显然侧扁，呈卵圆形。", source: "CMRC 2018 · 大鳞大眼鲷" },
  { question: "大鳞大眼鲷幼鱼体侧有多少条白色的垂直条纹？", category: "百科知识", answer: "5条", explain: "幼鱼体侧有5条白色之垂直条纹，较带间地色为狭，各鳍黑色，鳞片有短而宽之棘突。", source: "CMRC 2018 · 大鳞大眼鲷" },
  { question: "九命奇冤的作者是谁？", category: "百科知识", answer: "吴沃尧", explain: "九命奇冤，清吴沃尧所著的小说。", source: "CMRC 2018 · 九命奇冤" },
  { question: "九命奇冤最初发表在哪里？", category: "百科知识", answer: "《新小说》杂志", explain: "最初发表于梁启超主办的《新小说》杂志。", source: "CMRC 2018 · 九命奇冤" },
  { question: "九命奇冤根据什么小说改编而成？", category: "百科知识", answer: "《梁天来警富奇书》", explain: "他根据旧小说安和先生所著的《梁天来警富奇书》而加以改作，用较好的布局与描写，写成了一本动人的作品。", source: "CMRC 2018 · 九命奇冤" },
  { question: "郭芝苑是台湾哪一种音乐类型的先驱？", category: "百科知识", answer: "现代民族音乐", explain: "郭氏可说是台湾现代民族音乐的先驱，在台湾接触西洋古典音乐之初，扮演著相当重要的角色。", source: "CMRC 2018 · 郭芝苑" },
  { question: "短齿天竺鲷的俗名可以叫什么？", category: "百科知识", answer: "大目侧仔", explain: "短齿天竺鲷，又名短牙天竺鲷、正天竺鲷，俗名大目侧仔，为辐鳍鱼纲鲈形目鲈亚目天竺鲷科的其中一个种。", source: "CMRC 2018 · 短齿天竺鲷" },
  { question: "短齿天竺鲷有多少枚臀鳍硬棘？", category: "百科知识", answer: "2枚", explain: "臀鳍硬棘2枚、软条8枚。", source: "CMRC 2018 · 短齿天竺鲷" },
  { question: "短齿天竺鲷是吃什么的？", category: "百科知识", answer: "多毛类及小型无脊椎动物", explain: "属于珊瑚礁区之夜行性鱼类，大多成群躲在礁体之底部，以多毛类及小型无脊椎动物为食。", source: "CMRC 2018 · 短齿天竺鲷" },
  { question: "天水围河在哪里？", category: "百科知识", answer: "香港新界西北部", explain: "天水围河（）是香港新界西北部比较长的明渠，位于元朗区天水围新市镇西面，是厦村和新市镇的分界线，为发展新市镇时兴建的一条人工水道，渠道两岸设有河畔公园。", source: "CMRC 2018 · 天水围河" },
  { question: "天水围河有哪三条支流？", category: "百科知识", answer: "厦村河、石埗引水道及田心水道", explain: "天水围河有3条支流，分别是厦村河、石埗引水道及田心水道，全长27公里。", source: "CMRC 2018 · 天水围河" },
  { question: "天水围河全长有多少公里？", category: "百科知识", answer: "27公里", explain: "天水围河有3条支流，分别是厦村河、石埗引水道及田心水道，全长27公里。", source: "CMRC 2018 · 天水围河" },
  { question: "天水围河的发源地在哪？", category: "百科知识", answer: "屯门区九迳山一带", explain: "天水围渠起源自屯门区九迳山一带，流经洪水坑水塘、丹桂村、钟屋村、洪水桥东和石埗村，在沙洲里思信货柜场一带与厦村明渠汇合。", source: "CMRC 2018 · 天水围河" },
  { question: "黄天竺鲷的俗名是什么？", category: "百科知识", answer: "大目侧仔", explain: "黄天竺鲷，又名环天竺鲷、环尾天竺鲷，俗名大目侧仔，为辐鳍鱼纲鲈形目鲈亚目天竺鲷科的其中一个种。", source: "CMRC 2018 · 黄天竺鲷" },
  { question: "黄天竺鲷鱼体呈什么颜色？", category: "百科知识", answer: "金黄色略带红色", explain: "体呈金黄色略带红色，除尾柄有一黑带环绕外，头部从吻部经眼到鳃盖亦有一可辨识之棕色带，第一背鳍末端呈黑色。", source: "CMRC 2018 · 黄天竺鲷" },
  { question: "黄天竺鲷有多少枚背鳍硬棘？", category: "百科知识", answer: "8枚", explain: "背鳍硬棘8枚，软条9枚；", source: "CMRC 2018 · 黄天竺鲷" },
  { question: "黄天竺鲷繁殖期时，雄鱼会把卵放在哪里孵化？", category: "百科知识", answer: "口中", explain: "繁殖期时，雄鱼会将卵置于口中孵化，由雄鱼吐出仔鱼，具短暂的仔鱼飘浮期。", source: "CMRC 2018 · 黄天竺鲷" },
  { question: "黑边天竺鲷的俗名是什么？", category: "百科知识", answer: "大目侧仔", explain: "黑边天竺鲷，俗名大目侧仔，为辐鳍鱼纲鲈形目鲈亚目天竺鲷科的其中一个种。", source: "CMRC 2018 · 黑边天竺鲷" },
  { question: "黑边天竺鲷鱼体呈什么颜色？", category: "百科知识", answer: "银灰色", explain: "本鱼体呈银灰色，眼径较吻长为大；", source: "CMRC 2018 · 黑边天竺鲷" },
  { question: "黑边天竺鲷有多少枚背鳍硬棘？", category: "百科知识", answer: "8枚", explain: "背鳍硬棘8枚，软条9枚；", source: "CMRC 2018 · 黑边天竺鲷" },
  { question: "黑边天竺鲷是什么食性的鱼类？", category: "百科知识", answer: "肉食性", explain: "为肉食性鱼类，经常补食虾等甲壳类生物，其胸部到腹部的肌肉里有发光器，雄鱼并具有口孵卵的习性。", source: "CMRC 2018 · 黑边天竺鲷" },
  { question: "黑边天竺鲷的发光器在哪里？", category: "百科知识", answer: "胸部到腹部的肌肉里", explain: "为肉食性鱼类，经常补食虾等甲壳类生物，其胸部到腹部的肌肉里有发光器，雄鱼并具有口孵卵的习性。", source: "CMRC 2018 · 黑边天竺鲷" },
  { question: "单线天竺鲷的俗名是什么？", category: "百科知识", answer: "外斑天竺鲷、大目侧仔", explain: "单线天竺鲷（学名：），俗名外斑天竺鲷、大目侧仔，为辐鳍鱼纲鲈形目鲈亚目天竺鲷科的其中一个种。", source: "CMRC 2018 · 单线天竺鲷" },
  { question: "单线天竺鲷哪个部位有一个暗斑点？", category: "百科知识", answer: "尾鳍基底", explain: "由吻尖端到尾鳍基底有一黑色暗带；", source: "CMRC 2018 · 单线天竺鲷" },
  { question: "《人民公敌》是挪威哪位剧作家的剧作？", category: "百科知识", answer: "亨利·易卜生", explain: "《人民公敌》（）是挪威剧作家亨利·易卜生于1882年的剧作。", source: "CMRC 2018 · 人民公敌" },
  { question: "《人民公敌》剧中哪个角色代表了易卜生本人的声音？", category: "百科知识", answer: "斯多克芒医生", explain: "剧中主角斯多克芒医生，代表的是易卜生本人的声音。", source: "CMRC 2018 · 人民公敌" },
  { question: "黄鳍雀鲷的俗名叫什么？", category: "百科知识", answer: "菲律宾雀鲷", explain: "黄鳍雀鲷（学名：）为雀鲷科雀鲷属的鱼类，俗名菲律宾雀鲷。", source: "CMRC 2018 · 黄鳍雀鲷" },
  { question: "黄鳍雀鲷分布于什么海域？", category: "百科知识", answer: "印度西太平洋区", explain: "本鱼分布于印度西太平洋区，包括马尔地夫、琉球群岛、马来西亚、台湾、菲律宾、印尼、澳洲、索罗门群岛、马绍尔群岛、新喀里多尼亚、东加、诺鲁等海域。", source: "CMRC 2018 · 黄鳍雀鲷" },
  { question: "黄鳍雀鲷幼鱼体色是什么颜色？", category: "百科知识", answer: "蓝黑近紫色", explain: "幼鱼时体色为蓝黑近紫色，背鳍、臀鳍、尾鳍为黄色，与成鱼不同。", source: "CMRC 2018 · 黄鳍雀鲷" },
  { question: "现存的什么动物也是用前后肢来游泳的？", category: "百科知识", answer: "海象", explain: "海熊兽估计是所有已知鳍足类的祖先，包括海狮科、 Desmatophocidae、海豹科及海象科。", source: "CMRC 2018 · 海熊兽" },
  { question: "半线天竺鲷有哪些俗名？", category: "百科知识", answer: "目择仔、大目侧仔", explain: "半线天竺鲷，俗名目择仔、大目侧仔，为辐鳍鱼纲鲈形目鲈亚目天竺鲷科的其中一个种。", source: "CMRC 2018 · 半线天竺鲷" },
  { question: "半线天竺鲷的模式产地在哪里？", category: "百科知识", answer: "日本长崎县", explain: "该物种的模式产地在日本长崎县。", source: "CMRC 2018 · 半线天竺鲷" },
  { question: "半线天竺鲷的第一背鳍硬棘末端呈什么颜色？", category: "百科知识", answer: "淡灰色，略带红", explain: "颜色淡灰色，略带红，尾柄有和瞳孔同大小之圆黑点；", source: "CMRC 2018 · 半线天竺鲷" },
  { question: "半线天竺鲷的食物是什么？", category: "百科知识", answer: "浮游生物和底栖无脊椎动物", explain: "以浮游生物和底栖无脊椎动物为食物。", source: "CMRC 2018 · 半线天竺鲷" },
  { question: "横道河子站距离哈尔滨站多少公里？", category: "百科知识", answer: "272公里", explain: "距哈尔滨站272公里，绥芬河站276公里。", source: "CMRC 2018 · 横道河子站" },
  { question: "横道河子站共有多少趟旅客列车经过？", category: "百科知识", answer: "16趟", explain: "现隶属哈尔滨铁路局牡丹江铁路分局管辖，为三等站，共有16趟旅客列车经过。", source: "CMRC 2018 · 横道河子站" },
  { question: "香港上海汇丰银行哪一年在巴拿马城开设代表处？", category: "百科知识", answer: "1972年", explain: "香港上海汇丰银行于1972年在巴拿马城开设代表处，并分别在1973年及1993年获发在巴拿马城与使用的持牌银行牌照。", source: "CMRC 2018 · 巴拿马汇丰银行" },
  { question: "2005年汇丰收购哪一个消费贷款企业？", category: "百科知识", answer: "Financomer", explain: "2000年汇丰收购美国大通银行在巴拿马业务，2005年汇丰收购早在1986年已经进入巴拿马个人贷款市场的消费贷款企业Financomer。", source: "CMRC 2018 · 巴拿马汇丰银行" },
  { question: "杨树浦路是一条什么走向的干道？", category: "百科知识", answer: "东西向", explain: "杨树浦路是上海市虹口区与杨浦区南部、滨临黄浦江的一条东西向干道，西起惠民路，东至黎平路，全长5586米。", source: "CMRC 2018 · 杨树浦路" },
  { question: "杨树浦路全长多少米？", category: "百科知识", answer: "5586米", explain: "杨树浦路是上海市虹口区与杨浦区南部、滨临黄浦江的一条东西向干道，西起惠民路，东至黎平路，全长5586米。", source: "CMRC 2018 · 杨树浦路" },
  { question: "杨树浦水厂是什么造型的？", category: "百科知识", answer: "英国古典城堡式造型", explain: "其中杨树浦水厂为英国古典城堡式造型，1883年建成供水，是中国最早的现代化地面水厂。", source: "CMRC 2018 · 杨树浦路" },
  { question: "杨树浦路目前只在哪段路集中了数十家中小型商店？", category: "百科知识", answer: "宁国南路至临青路之间", explain: "杨树浦路目前大部分路段店铺稀少，只在宁国南路至临青路之间，集中了数十家中小型商店。", source: "CMRC 2018 · 杨树浦路" },
  { question: "被保存的种子通常是哪些？", category: "百科知识", answer: "农作物或是罕见物种", explain: "被保存的种子较常是农作物或是罕见物种。", source: "CMRC 2018 · 急冻食品" },
  { question: "九龙巴士7号线来往于哪两个地方？", category: "百科知识", answer: "乐富及尖沙咀码头", explain: "九龙巴士7号线是香港九龙市区的一条日间巴士路线，来往乐富及尖沙咀码头。", source: "CMRC 2018 · 九龙巴士7号线" },
  { question: "九龙巴士7号线于哪年引入超低台空调巴士服务？", category: "百科知识", answer: "1999年", explain: "1999年引入超低地台空调巴士服务， 所有空调巴士都改用12米丹尼士三叉戟（ATR）。", source: "CMRC 2018 · 九龙巴士7号线" },
  { question: "九龙巴士7号线全程收费多少？", category: "百科知识", answer: "4.9", explain: "全程收费：$4.9乘本路线往乐富方向于上车后150分钟内转乘95／270A往翠林／上水方向，或由上述路线往市区方向转乘本路线往尖沙咀码头方向，次程可获$4.2优惠。", source: "CMRC 2018 · 九龙巴士7号线" },
  { question: "1980年代，什么成为九龙巴士7号线的主力？", category: "百科知识", answer: "都城嘉慕11米", explain: "到了1980年代，都城嘉慕11米（S3M）成为本线的主力。", source: "CMRC 2018 · 九龙巴士7号线" },
  { question: "䲟又叫做什么？", category: "百科知识", answer: "长印鱼", explain: "䲟（yìn, ㄧㄣˋ，学名：），又称长印鱼，为辐鳍鱼纲鲈形目鲈亚目䲟科的其中一个种。", source: "CMRC 2018 · 䲟" },
  { question: "䲟的背吸盘有多少对鳍瓣？", category: "百科知识", answer: "21至28对", explain: "远洋地区本鱼体延长，胸鳍尖锐，背吸盘有21至28对鳍瓣，体长为盘长之3.5至4.35倍，尾部较吻短以致肛门为长。", source: "CMRC 2018 · 䲟" },
  { question: "䲟除了哪些部位没有鳞外，全身均被鳞？", category: "百科知识", answer: "头部及吸盘", explain: "体被小圆鳞，除头部及吸盘无鳞外，全身均被鳞。", source: "CMRC 2018 · 䲟" },
  { question: "䲟身上有吸盘会附著在哪里？", category: "百科知识", answer: "鲨鱼、翻车鱼、海龟甚至小船", explain: "为沿岸昼行性鱼类，身上有吸盘会附著在鲨鱼、翻车鱼、海龟甚至小船，往往以捡大鱼吃剩的食物为食、体外寄生虫为食，或者自行捕捉浅海的无脊椎动物。", source: "CMRC 2018 · 䲟" },
  { question: "短䲟又叫做什么？", category: "百科知识", answer: "短印鱼、短印仔鱼", explain: "短䲟（学名：），又称短印鱼、短印仔鱼，为辐鳍鱼纲鲈形目鲈亚目䲟科的其中一个种。", source: "CMRC 2018 · 短䲟" },
  { question: "短䲟的背吸盘有多少对鳍瓣？", category: "百科知识", answer: "16至20对", explain: "背吸盘有16至20对鳍瓣，体长为背吸盘2.6至3.45倍，背吸盘后端部超越胸鳍与腹鳍，胸鳍鳍条软。", source: "CMRC 2018 · 短䲟" },
  { question: "短䲟的第几背鳍变形成为吸盘？", category: "百科知识", answer: "第一背鳍", explain: "背鳍两个，第一背鳍变形而成吸盘，吸盘不及胸鳍后端；", source: "CMRC 2018 · 短䲟" },
  { question: "短䲟会随着什么而改变自己的颜色？", category: "百科知识", answer: "寄主体色", explain: "本鱼随著寄主体色而改变自己的颜色，从灰色到暗褐色不等，主要吸附在外洋性的鲨鱼身上（片利共生），全长要长到25公分以上的成鱼，吸盘才会发育完全。", source: "CMRC 2018 · 短䲟" },
  { question: "短䲟全长要长到多少公分以上吸盘才会发育完全？", category: "百科知识", answer: "25公分以上", explain: "本鱼随著寄主体色而改变自己的颜色，从灰色到暗褐色不等，主要吸附在外洋性的鲨鱼身上（片利共生），全长要长到25公分以上的成鱼，吸盘才会发育完全。", source: "CMRC 2018 · 短䲟" },
  { question: "高层大气物理学有哪两个重要部分？", category: "百科知识", answer: "分子离解和电离", explain: "高层大气物理学（）是大气物理学的一个分支，主要研究中层与高层（平流层、中间层、热成层和磁层等）大气的成分和物理性质，分子离解和电离是该学科重要的部分。", source: "CMRC 2018 · 高层大气物理学" },
  { question: "高层大气物理学主要在什么时候发展？", category: "百科知识", answer: "20世纪和21世纪", explain: "高层大气物理学主要发展于20世纪和21世纪。", source: "CMRC 2018 · 高层大气物理学" }
]

const QUOTES = [
  { text: "你所有的大张旗鼓地表达，只是想换来一个能注意你的人。", note: "原创", source: "MJEnvieBelle", uuid: "041987dd-e347-4d50-b948-60010b741cbf" },
  { text: "那时我们已白发斑斑。", note: "网络", source: "徐重來", uuid: "6d6884a0-48c5-46ea-b211-8ca7aa0e514c" },
  { text: "你才是⑨！你全家都是⑨！", note: "网络", source: "网络", uuid: "9f7fcef3-a251-44dd-831c-752e559a7169" },
  { text: "你眼中的星海灿烂 是我不曾见过的世外桃源", note: "网络", source: "晓良", uuid: "1bc73652-c577-44d0-9c80-fbdd46911ca1" },
  { text: "我在文字中遇见新的自己。", note: "原创", source: "CuSO4", uuid: "95632883-5552-403d-865f-90ffe80b8fb3" },
  { text: "春来我不先游泳，哪只虫儿敢过江？", note: "网络", source: "贺指导", uuid: "4b8c3a1a-b3b2-422b-8aec-5d4008c08e6c" },
  { text: "请和这样的我恋爱吧。", note: "网络", source: "我不吃饭", uuid: "548bd09e-217e-467e-bf85-1a0ed02119f4" },
  { text: "前路昭昭，莫自扰便逍遥。", note: "网络", source: "网络", uuid: "36fcdd2b-fc5d-4c67-86db-a48090755727" },
  { text: "如果你也有还未做完的梦，还请将它撒入这片星河。", note: "原创", source: "linkey2011", uuid: "20e5a664-2a42-47bf-acfd-0abf15d59e3c" },
  { text: "你看这个面他又长又宽~", note: "网络", source: "Kris Wu", uuid: "b02bca83-823c-4eb2-a7ea-82bceae0f302" },
  { text: "当法律不再是人民的武器之时，武器将会成为人民的法律。", note: "网络", source: "AC_love", uuid: "2da7404a-d345-4123-b8b4-9fef83249dc5" },
  { text: "时空把我们阻隔，网络将彼此连接。", note: "原创", source: "Kelin", uuid: "ca43a3b5-40b8-44d5-a9f9-d10f53cafd46" },
  { text: "我们没有永恒的朋友，也没有永恒的敌人，只有永恒的利益。", note: "哲学", source: "亨利·坦普尔", uuid: "dd4ed420-6e48-41e5-9f8d-b1aaadffcc96" },
  { text: "又苦又甜，也挺好嘛，很像生活", note: "原创", source: "singular港", uuid: "7be21831-4dfd-464e-bf15-f3684822b2cd" },
  { text: "我喝了李白的酒，却写不出唐诗三百首……", note: "原创", source: "仙", uuid: "6c883e74-0c4a-4bb4-b24e-4527c5b297ad" },
  { text: "眼睛可以近视，目光不能短浅。", note: "网络", source: "佚名", uuid: "582423a6-0429-4d5a-b234-60a2fc87c340" },
  { text: "人生，自在意，得其乐。", note: "原创", source: "陈树凤", uuid: "fb18a153-411c-4b02-b1c4-5d735e48ee7d" },
  { text: "跳跃是人类靠近天空的最初尝试。", note: "网络", source: "网络", uuid: "196a8f21-3143-4bef-9eb0-f91185649b29" },
  { text: "舟中暗坐附耳满江仓促船声。", note: "网络", source: "楼玉明只是路过", uuid: "1b9b8a85-053a-4c86-816d-9ef904b37faa" },
  { text: "胸不平何以平天下，乳不巨何以聚人心。", note: "网络", source: "网络", uuid: "ec090f91-8294-44fa-9f1e-3cb8e89a6d3f" },
  { text: "落幕时留下的轮廓和灰烬是留给这世界的一个吻和一份叹息。", note: "网络", source: "佚名", uuid: "f1547161-3acf-4724-a298-1b09d46bf336" },
  { text: "哪有小孩天天哭？哪有赌徒天天输？", note: "网络", source: "网络", uuid: "abd5a4ec-917b-4752-8464-5a8b20a6ab3f" },
  { text: "伤人的话难说，却觉得很洒脱。", note: "网络", source: "Fanko冯思源", uuid: "e4c51d1e-45aa-44e3-871f-70ed0e5407e6" },
  { text: "做你认为正确的事情，希望你的选择值得被尊重。", note: "网络", source: "终末之诗（梗体）", uuid: "47cceb6c-616b-42f4-87db-41930b49044b" },
  { text: "爱像是一场小雨淅沥沥淅沥沥。", note: "网络", source: "刘嘉星", uuid: "ac359908-ae0c-4cce-9e7e-9ee458d7392e" },
  { text: "拒绝性别刻板印象，凭什么男生不能是女生？", note: "原创", source: "Shawn", uuid: "f3f437fc-1819-4ae2-8b5d-34791a41b9bb" },
  { text: "保持热爱，奔赴山海。", note: "网络", source: "佚名", uuid: "f4b75c75-e329-424c-90ed-3512b1d9568f" },
  { text: "春秋相往犹如似水流年。", note: "原创", source: "朴素", uuid: "8adcf1ee-d934-4b4f-bbee-a923eda0a130" },
  { text: "双向奔赴，丝线重合，我们仰头探望，便是树状星辰。", note: "网络", source: "BlankAo", uuid: "026bcc06-2831-4b18-99ff-453fb1c5925d" },
  { text: "我寻了半生的春天，你一笑便是了。", note: "网络", source: "网络", uuid: "7500f910-006e-4df4-afdb-1915fe9c4245" },
  { text: "你要知道生活是各种颜色汇合而成的黑。", note: "网络", source: "网络", uuid: "6b4c920f-86fd-4179-8533-9508b7141d11" },
  { text: "我知道我无法主宰一切，但此时此刻，我是活着的。", note: "网络", source: "佚名", uuid: "5f50f43a-01f9-4e87-9af4-250830842d74" },
  { text: "你还没放下吗，心里还念着啊。", note: "网络", source: "Lamry/戴荃", uuid: "6f8f766f-540f-4942-8972-8ff30ef4372d" },
  { text: "给我一个电话亭，我要拯救地球。", note: "网络", source: "网络", uuid: "576eefe4-7206-46ff-b2e8-88c3dedb5dd3" },
  { text: "我不知道明天会怎么样，但是我一定要努力过好今天。", note: "原创", source: "Alex Cui", uuid: "4dfda1c2-c9b1-43c3-8183-12935cf39082" },
  { text: "梧高凤必至，花香蝶自来。", note: "网络", source: "兔子君", uuid: "e4729849-cb94-444d-9bff-bb1004f7b2a3" },
  { text: "忘掉拥有过的花，去种有结果的树。", note: "网络", source: "佚名", uuid: "bac7068a-b09f-445e-ba54-5c68c16ab5f8" },
  { text: "东风已入相思门。", note: "网络", source: "楼玉明只是路过", uuid: "a8dcf41c-d8a6-42d9-9fc3-d4139e0f6898" },
  { text: "善语结善缘，恶言伤人心。", note: "网络", source: "抖音", uuid: "8c5eb2a3-29a1-43e5-9cb1-a74d3385a4bb" },
  { text: "星空啊，请让我们再一次相遇吧！", note: "原创", source: "一只叫一行的喵/扮君", uuid: "f40626b5-5d25-42aa-83af-d68be593ea79" },
  { text: "或许你想要的终究只是你想要的。", note: "原创", source: "无名氏", uuid: "4f70c901-af02-4c2f-9f23-7636d3e4928a" },
  { text: "大多人都活在平静的绝望中，不要逆来顺受，要破茧而出。", note: "哲学", source: "梭罗", uuid: "6df73eb3-1565-42ad-a986-c0da9e909107" },
  { text: "心事诉与明月收。", note: "网络", source: "日月同辉", uuid: "b27587eb-8bfa-4ef4-94b9-0f4a2f5c20de" },
  { text: "舞鸳鸯之形影兮，歌凤凰之涅槃。", note: "原创", source: "一只叫一行的喵", uuid: "1c81eda9-a805-42df-b918-eabbb90e735f" },
  { text: "喜欢就争取，得到就珍惜，错过就忘记。", note: "网络", source: "dcxdcx_20100323d", uuid: "7fe37194-be11-46dd-b7db-c9aa8441c382" },
  { text: "卑屈游戏谁是先该离场的呢？", note: "原创", source: "兰斯洛特", uuid: "561acf75-0ebf-42c0-8306-81701ee46dff" },
  { text: "无诗可读的时候，我便读你的眼睛。", note: "原创", source: "程平发", uuid: "5c84d454-68c1-4069-8607-dbd8144c33ca" },
  { text: "你总炫耀你的音乐等级，可幸福的人不听歌。", note: "网络", source: "网络", uuid: "d3f00665-6ace-4baa-be81-2f930e349f6c" },
  { text: "时空可能不会阻隔我们，但时间一定会让我们天各一方。", note: "原创", source: "无事献殷勤", uuid: "c99fa775-29b1-4b1a-8762-86641317cc32" },
  { text: "你不能让所有人都满意，但你可以让所有人都不满意。", note: "原创", source: "Yanser", uuid: "07aa0835-9e4b-4117-84ac-844d289afe64" },
  { text: "我命由我不由天，吴钩弯，展锋寒。", note: "网络", source: "一高三学子", uuid: "03372c85-7222-4f01-a211-2d74a0744ffb" },
  { text: "梦想不应被嘲笑，也应该不惧流言！", note: "原创", source: "原创", uuid: "7da9e966-393a-4d0e-a702-009864a7975b" },
  { text: "绵绵寒冬不尽夏，瑟瑟悲秋不迎春。", note: "原创", source: "做魚玉子燒", uuid: "cf2196dc-6014-4095-9e69-3f1bb092a37e" },
  { text: "来自地狱的萤石，怎能叩开天堂的大门？", note: "网络", source: "佚名", uuid: "c1d77494-075e-44b5-9a3d-fd0faa91b7a6" },
  { text: "人亡则死，心亡则忘。", note: "网络", source: "耳根", uuid: "8b9e4609-b377-4789-8ac9-847b5b8e13be" },
  { text: "扮演可爱的人太久之后，我居然也变得有点可爱了。", note: "网络", source: "李滇滇", uuid: "4352cc7f-65b0-4728-a8f0-29b3375992f7" },
  { text: "忍着身体的惨痛，憧憬黎明的光芒。", note: "原创", source: "九月彷徨", uuid: "28c8d7e6-f179-4d8f-a939-daac4fa9c2da" },
  { text: "现在开始，还算不晚。", note: "网络", source: "周梦忆", uuid: "d101935f-4083-4ce0-83e8-7d78a2552493" },
  { text: "程序漏洞叫特性，设计漏洞叫特色", note: "原创", source: "沃·兹基·硕得", uuid: "707fbfe2-b839-4e90-9c17-f25bbacf5a98" },
  { text: "也许，梅花本应在春天到来前落下。", note: "原创", source: "Cindy_Li", uuid: "dd4ec541-8646-42eb-b082-5b09ab68a775" },
  { text: "人本身可以是聚光灯，我自己可以就是发光体。", note: "网络", source: "刘耀文", uuid: "ebbdb7af-1483-4356-8a00-8026c51610f9" },
  { text: "绝望自有绝望的力量，正如希望自有希望的无能.", note: "网络", source: "XiaoMaFenJu", uuid: "7ce5938b-cfc3-4fc8-89a6-77e3c3c73727" },
  { text: "驱穹不得反之焚文，其欲直达天听。", note: "原创", source: "朴素", uuid: "d8366934-a35c-4915-96ca-efccaf3992a8" },
  { text: "喜欢的时候没办法拥有，能够拥有时，却再也没办法喜欢了。", note: "网络", source: "佚名", uuid: "ae7459a3-a3ad-45b8-a5bf-8426dcdb9441" },
  { text: "记忆不是我的延续。精神才是。", note: "原创", source: "pokon548", uuid: "90d49934-9de5-4a21-92f2-d4808b808b42" },
  { text: "照将催人泪，新月朦胧，幽咽噬残妆。", note: "原创", source: "碧水凌涛", uuid: "ee8718ac-8f59-4318-9327-39c021f00202" },
  { text: "他们不配做知己，不必有结局。", note: "网络", source: "佚名", uuid: "650517ce-355c-44aa-bd3b-9b97d5a92505" },
  { text: "你搅散一池星光成为我的月亮。", note: "网络", source: "网络", uuid: "71d28741-11f6-4787-8c9d-ac8035e34a3c" },
  { text: "我们擦身而过，是为了相识或者遗忘。", note: "网络", source: "网络", uuid: "64734ca9-1f34-43b4-b4ae-22ae3a7ba2c4" },
  { text: "如果命运扼住了你的喉咙，那你就挠命运的胳肢窝。", note: "网络", source: "佚名", uuid: "7641cee1-215f-4ba1-bfe0-ccf2e3873aa1" },
  { text: "花踌躇柳轻叹敢问情何以堪。", note: "网络", source: "花晶晶", uuid: "15332182-1cf5-491a-a0f5-a91c3932130a" },
  { text: "就算你呀忘了我的存在。", note: "网络", source: "徐重来", uuid: "93180cfc-537c-4cd3-8db7-42f31fdf878b" },
  { text: "如果有人在陪你，你又怎么会看这些文字。", note: "网络", source: "佚名", uuid: "ea614390-274f-47d0-ae81-16cc89f7a6dc" },
  { text: "是幻境的终点，穿过命运罅隙的光。", note: "网络", source: "南岐", uuid: "0eb6eb8c-4d62-40b0-8153-42a4be56f152" },
  { text: "我听到水流进入我的身体，我听到阳光穿透海面。", note: "网络", source: "深蓝", uuid: "07d1f187-9553-462c-b2b2-b8c55b8be9c8" },
  { text: "望不穿那海底突然跌落的暗与无穷。", note: "原创", source: "夙鱼", uuid: "22020007-43fe-4df4-a9d6-0976b29c65d0" },
  { text: "良人十载散 牵挂长夜下辗转​。", note: "网络", source: "郑明河", uuid: "a84c1af3-82e7-41ab-a3d5-3d3482f9a264" },
  { text: "把自己当傻瓜，不懂就问，你会学的更多", note: "原创", source: "原创", uuid: "a603b66b-baca-49d9-a956-7356efe2c88f" },
  { text: "方生方死，方死方生，方可方不可，方不可方可。", note: "哲学", source: "庄周", uuid: "25ae3a43-deda-4bee-a809-f94481b096ea" },
  { text: "对于我们的幸福来说，别人的看法在本质上来讲并不十分重要。", note: "哲学", source: "叔本华", uuid: "e1fbeb24-a0a2-406f-8b44-397d5e876a98" },
  { text: "我路过街角的杂货铺，想买一筐六块钱的阳光。", note: "原创", source: "孤帆", uuid: "f2c8ecf8-7dcd-4895-929a-8d35f884c111" },
  { text: "最懂我的只有编译器，它教会我，我理解它。", note: "原创", source: "洛洃", uuid: "d553cfaf-bb4a-4160-80d6-9b8e7c8f8df6" },
  { text: "不努力，怎么对的起你的喜欢呢。", note: "原创", source: "xy0313", uuid: "e894a893-a724-4e8d-b61a-b3568a6b3455" },
  { text: "偶尔的停顿和修整，对于人生是非常必要的。", note: "哲学", source: "随记", uuid: "0479eee0-3dec-4cd5-863d-20e4dea94b84" },
  { text: "然而世事千帆而过 路的尽头终归是温柔和月光", note: "原创", source: "原创", uuid: "5d466a87-acc1-4f84-88e0-073ffcc820b3" },
  { text: "挑战自我，不进则退。", note: "网络", source: "Redmountain", uuid: "8a44065f-26c4-424e-9fbb-f6ed7db3f3df" },
  { text: "剑指之地，破穹其顶。", note: "原创", source: "朴素", uuid: "09f0af5a-f80b-4b76-8dfd-688d52c93f49" },
  { text: "我不会接受我不要的未来，哪怕是命中注定。", note: "原创", source: "lzgsimerly", uuid: "2098be08-b271-4fdd-aa19-c5fce0d77b75" },
  { text: "梦+想=梦想，这个等式是不成立的。", note: "原创", source: "原创", uuid: "7694adf2-a5b0-4003-809d-e55329713ba9" },
  { text: "逐渐带上现实的枷锁，信任在短短解释后崩塌。", note: "网络", source: "三七", uuid: "fa2754be-05de-4727-b7c9-b75745f8e0db" },
  { text: "哇多么好的机会啊。", note: "网络", source: "博丽神主", uuid: "a4d4bbd4-a47b-4e29-9832-e58fafe6e046" },
  { text: "卫星轨道千万条，心心相印才永久。", note: "网络", source: "网络", uuid: "c06bec38-878f-4c5e-9e1d-2838e96c7a02" },
  { text: "你的身体藏着倦意。", note: "网络", source: "吴佩岭@房东的猫", uuid: "0a8fa35f-3c9f-470e-b33c-5a56d2015759" },
  { text: "小轩窗谁正梳妆。", note: "网络", source: "郑明河", uuid: "370dbf20-624e-4002-aece-644f99f569a7" },
  { text: "穿越百夜，仰望千空。", note: "网络", source: "网络", uuid: "701d38fe-b757-4128-ba00-3d618f35f931" },
  { text: "何必满腹心酸，委屈的承受。", note: "网络", source: "王健美", uuid: "64ab313c-afe7-4e10-9f98-b9cd413c4549" },
  { text: "空山新雨后，兵长一米六。", note: "网络", source: "百度贴吧", uuid: "68438514-42c0-4de7-a5f6-2d37ebc99986" },
  { text: "跟喜欢的人是做不了朋友的，距离远近都是折磨。", note: "网络", source: "佚名", uuid: "feba7900-039f-4c65-b69a-eda6aeca5de9" },
  { text: "我相信我会在另一个世界醒来。", note: "原创", source: "CuSO4", uuid: "81c45136-3f91-4f1b-b4c0-84f307f69a2e" },
  { text: "你就當，從沒認識我吧，反正，你也這樣做了。", note: "原创", source: "做魚玉子燒", uuid: "8bc5c343-25b8-41d0-9420-05eb4f6cfd54" },
  { text: "如果可以的话，我也想成为这个世界中特殊的存在。", note: "原创", source: "”·躲猫猫＿.", uuid: "98ec4a6a-f341-472c-b33b-9963128941ab" },
  { text: "面具戴久了，就会长在脸上哦。", note: "网络", source: "佚名", uuid: "2da71278-3700-49fd-b52a-9266cd599563" },
  { text: "时时诸事递减数理，空空万地无二本真。", note: "原创", source: "朴素", uuid: "58df900d-c397-4659-9d91-d6e62897397a" },
  { text: "青春，其实在与现实的接受与妥协时就结束了​", note: "原创", source: "柳柳", uuid: "c6f88af3-6a43-4f5d-9ac3-f3b6be238187" },
  { text: "我们都是人生的盲人，摸着名为世界的大象。", note: "网络", source: "弱智吧", uuid: "2131fe8a-dbb8-481c-9860-03daea756321" },
  { text: "历史，是以血为墨书写的巨著。", note: "原创", source: "流云澄", uuid: "c7438949-d6c1-44cb-81f3-4cccebe67fe6" },
  { text: "有些人的温柔，不过是骨子里的卑微。", note: "原创", source: "原创", uuid: "ecf19550-7614-41e6-9b36-b062c26d05c2" },
  { text: "与其孤独，不如独孤！", note: "原创", source: "秋白", uuid: "ce53689e-ba6b-4804-b2e3-74fe58cbe255" },
  { text: "浪也拍打着沙，我却对你情有独钟。", note: "网络", source: "三七", uuid: "b0edd513-fae2-4d16-9e63-f5a4129fe993" },
  { text: "什么都会的那是内测玩家和天才。", note: "网络", source: "某幻君", uuid: "2e01ddf0-5ab1-4050-9384-3a09e6314b72" },
  { text: "所谓豪言壮志，只是为了安慰某刻的自己。", note: "原创", source: "朴素", uuid: "dfd9c70b-b826-47fb-84a6-1511fdc1dc2c" },
  { text: "年少时，当妈妈永久离开我的那一刻：往后的心脏又软又硬。", note: "原创", source: "王烁焱", uuid: "73403b83-3c9e-4933-93fe-05ad7f69af6d" },
  { text: "请别怕黑暗，你自带光环！", note: "原创", source: "Mi", uuid: "08c0095f-7c05-496b-8ec8-76ce2db61660" },
  { text: "梦里还是醒不来的梦，窗外有道看不清的虹。", note: "原创", source: "jhn", uuid: "cf89fc46-8d53-475d-87ca-27bb4d35c69b" },
  { text: "剃刀边缘怎能起造伽蓝。", note: "哲学", source: "木心", uuid: "37f5ca75-33a8-4932-95fa-efc11753b057" },
  { text: "抛开世俗去找回那自我。", note: "网络", source: "疯狂的羊", uuid: "61e036c9-57b4-4a81-9fe0-b91198db06cf" },
  { text: "闻道者，朝生夕死，足尔；寻道者，忘生之死，憾尔。", note: "网络", source: "耳根", uuid: "71f0481f-f6eb-41e5-975c-d0c82fb3ec1e" },
  { text: "为君再入相思门。", note: "网络", source: "楼玉明只是路过", uuid: "e655a5d7-812a-453a-b29b-2a7b63968e04" },
  { text: "得意不尽欢，失意心倍空，假意难割舍，真情总多变。", note: "原创", source: "抱月", uuid: "1964314d-37ec-4d8b-83ab-432efecba76a" },
  { text: "我穿梭在万千烟火中，体味世人不曾有的味道。", note: "原创", source: "岁心流年", uuid: "3f035fb0-11c1-498c-b5c9-2e9e4f71e2f9" },
  { text: "你凭什么喜欢我，就凭你眼光好吗？", note: "网络", source: "网络", uuid: "2fb44aae-b7c3-4c33-bf5a-cc30cd37c9ad" },
  { text: "百般乐器，唢呐为王；不是升天，就是拜堂。", note: "网络", source: "一个转身的距离", uuid: "f47407d6-fa96-4a81-9669-d5c619dd4d68" },
  { text: "社会犹如一个立方体，总有不被光照到的一面。", note: "原创", source: "清巳星岚", uuid: "fd9c0f74-d3b3-4e23-9822-1cd50b0778b1" },
  { text: "仲夏夜茫，七月未央，我们年少轻狂，不惧岁月漫长。", note: "原创", source: "葭樱", uuid: "7afccafc-a0a6-4c45-a7c4-dbd7f3dbeb58" },
  { text: "在你最冷的时候，有人不顾自己寒冷抱着你，这就是幸福。", note: "网络", source: "网络", uuid: "ea07df7b-8dae-45a2-9c49-24bd2eaac664" },
  { text: "别回头，哥有哥的浪漫。", note: "原创", source: "崔鑫浩", uuid: "2b89056f-253f-498d-903e-48a94ef1192d" },
  { text: "当世界背叛你的那天到来时，我会为你背叛全世界。", note: "网络", source: "网络", uuid: "09863e67-6a63-47f9-8196-4996bea8da4b" },
  { text: "只要我们开始追赶，就已经走在通往胜利的路上。", note: "哲学", source: "雷军", uuid: "d7e39429-5d5d-48da-b66e-187f14fdd2fa" },
  { text: "这世界太大到处是人海与人山，遇见了你我就不遗憾。", note: "网络", source: "徐重来", uuid: "9d92b88c-a3ac-47b0-8070-e56b46852367" },
  { text: "世人的赞美不过是临时起意。", note: "原创", source: "xomk", uuid: "c88a876e-fba3-43e4-8d89-ac9ce7101eac" },
  { text: "生活可不是电影，错过了就真的没有了...", note: "网络", source: "星宇动漫社", uuid: "2643338c-0dcf-4133-93a8-92cb3cbfae42" },
  { text: "黑色世界唯有东方的曙光。", note: "哲学", source: "Google Translate", uuid: "98d01b71-8441-43a2-8cbf-616c0d213c55" },
  { text: "只愿你不忘年少时，坦荡而无畏。", note: "网络", source: "佚名", uuid: "5c9b0aae-3292-4250-9d54-ab06dd6271e6" },
  { text: "生死之间，我选择生的希望，因为生，已是一种幸运。", note: "网络", source: "佚名", uuid: "00f83705-182f-49bf-9b4f-937daf74a72f" },
  { text: "雾都伦敦的浪漫，是迷雾之下珍藏的一缕阳光。", note: "原创", source: "夙鱼", uuid: "c665a6ec-86a7-4443-96de-8ab1ead415cc" },
  { text: "既出淤泥，如何不染。", note: "原创", source: "自己", uuid: "8aa71c84-ed35-444d-9d31-8b3dacb25745" },
  { text: "纵深于黑夜之中化作黎明！", note: "原创", source: "林清凝", uuid: "18efbc86-ebae-4bb4-aedd-57007bbec780" },
  { text: "回忆是冷，思念是病。", note: "原创", source: "呜哩亚绅", uuid: "2931e0db-5138-45f6-a54c-a6d039f3df10" },
  { text: "华风夏韵，洛水天依！", note: "网络", source: "网络", uuid: "f20c17b5-10e9-4b08-b1e8-2f7210f93c53" },
  { text: "我们无法回到过去，前进的方向，只有未来。", note: "原创", source: "原创", uuid: "ac04af69-8dc9-419a-9c75-ddbfa3171b77" },
  { text: "曲则全，枉则直，洼则盈，敝则新。", note: "哲学", source: "老子", uuid: "c22a57cb-deb7-4b88-9054-1c2e5ab92ce8" },
  { text: "我喜欢的姑娘，眉如青山。", note: "原创", source: "Yly", uuid: "b32ee34f-29bc-49e0-aaf3-dbc92e92932d" },
  { text: "喜欢大胸只是本能，喜欢贫乳才是审美。", note: "网络", source: "网络", uuid: "34662c58-8eba-4757-a637-c7c11e9f537e" },
  { text: "昨天成就明天，那就努力把今天变成昨天，共同成就美好明天。", note: "原创", source: "樊唯", uuid: "90493f99-9cd3-4182-a74a-7305cbc9de4b" },
  { text: "我喜爱因喜爱而喜爱的，我憎恶为憎恶而憎恶的。", note: "网络", source: "AC_love", uuid: "f921dff3-22b5-48f4-bdac-58bbac0fe0b3" },
  { text: "我不确定完全不确定。", note: "网络", source: "吴佩岭@房东的猫", uuid: "add5443a-7bc5-48cf-8687-71334dc3b161" },
  { text: "去远方摘一朵叫自由的花朵。", note: "网络", source: "疯狂的羊", uuid: "6f875a31-7abb-4966-9d16-73b0d5c4c34e" },
  { text: "朋友，如果有一天我死了，请相信我只是去了另一个世界等你", note: "原创", source: "圣", uuid: "442fbb7f-d261-4b97-b6c7-d364e9ab64e7" },
  { text: "那年，一定很美吧。", note: "原创", source: "幻空", uuid: "9b7b8447-ca40-4308-8103-50c2c0738e75" },
  { text: "赢得了时间就是赢得了一切。", note: "哲学", source: "弗拉基米尔·伊里奇·列宁", uuid: "9c09482c-3230-432d-99d8-00e0ece52c4a" },
  { text: "过期的牛奶失去了价值，迟来的正义也是。", note: "原创", source: "清巳星岚", uuid: "e6996875-27ea-49c8-bb45-6563f1e79b10" },
  { text: "你金色阳光下的影子，消失在了时间的海里。", note: "原创", source: "Pfolg", uuid: "80724a98-bf21-4006-886a-bbf376bca90b" },
  { text: "不忘初心，方得始终。", note: "网络", source: "网络", uuid: "06f60a39-f899-4f2b-b11e-a3411e79a844" },
  { text: "青春散场听雨声坠落。", note: "网络", source: "你有没有真的爱过我", uuid: "3b589619-a888-401c-90ee-43f8e459aa9a" },
  { text: "别人走在拼命赚钱，而我赚不到，我感觉我和这个世界格格不入", note: "原创", source: "二十一", uuid: "600d7269-99e9-49e2-95b9-3f9626e05423" },
  { text: "我们登上并非我们所选择的舞台，演出并非我们所选择的剧本。", note: "哲学", source: "爱比克泰德", uuid: "43574bd6-b563-45ab-9398-b09f33234f7a" },
  { text: "农场里挤满了人类的幻影", note: "网络", source: "道雀Bzz", uuid: "0210fcd8-5b20-49b8-9904-a2bbd6c6c4aa" },
  { text: "正因为一无所有，才可以拥有一切。", note: "原创", source: "Varuxn", uuid: "d1372c32-e8b4-4d1f-9e29-dd228b2c539b" },
  { text: "物质决定意识，意识反作用于物质", note: "哲学", source: "唯物主义哲学", uuid: "64497f0d-816b-4097-857c-7fc65db84b10" },
  { text: "苦难是生命的防沉迷系统。", note: "哲学", source: "弱智吧", uuid: "569f151e-a7dd-4580-8ec5-777c874ea566" },
  { text: "孩子们玩耍，双脚全是沙。", note: "网络", source: "小寒", uuid: "67921fe3-e763-410c-9f8b-76cd25c16110" },
  { text: "山海若不见，自去见山海。", note: "原创", source: "comma", uuid: "1385da03-b16a-42fc-9389-c169f1369af7" },
  { text: "理性的人追求的并非快乐，而只是避免痛苦。", note: "哲学", source: "叔本华", uuid: "bf7a7862-0b1c-4e7b-9df3-431a9148bed8" },
  { text: "呜呼！斯吏踏金上濠梁，看得庄惠辩鱼却引裳！", note: "原创", source: "LampyStar", uuid: "a573a721-526e-480d-ad77-57c45e0e55a9" },
  { text: "人啊，是利益的作品。", note: "原创", source: "陈和锐", uuid: "4a695d75-63e5-4ea9-9ce2-6283fd7d0fc3" },
  { text: "与孤独为伴，那还能叫孤独吗？", note: "网络", source: "弱智吧", uuid: "163c266b-70ad-4597-a56d-2285ad4571cb" },
  { text: "找一片树荫，坐在长椅上听远处吹来的风。", note: "原创", source: "CuSO4", uuid: "1ed8aae5-3790-4af6-aaf1-4180a5c991c7" },
  { text: "翻开对你仅有的记忆，然后放大，彻底的覆盖我的脑海。", note: "原创", source: "朴素", uuid: "bc326033-2f4c-487a-a28f-147769e5549c" },
  { text: "不要在晚上做出任何决定。", note: "网络", source: "互联网", uuid: "84ece63a-e7e1-4f89-b8f9-eddadbdfdb1e" },
  { text: "痴心对月一醉难醒。", note: "网络", source: "蓝乐", uuid: "0c366591-0612-4692-8579-9dcb99f3eac3" },
  { text: "我这么无聊，几乎从不主动的一个人也想为你变得有趣呢！", note: "原创", source: "非知名面包", uuid: "0077021a-ef28-4d39-8e73-1a4eff34392c" },
  { text: "我们站在去与来的中间，我们告别过去，我们追逐明天。", note: "原创", source: "Xun", uuid: "9f8b6405-090c-4fd1-a7e3-4138ae16426b" },
  { text: "前路无远弗届，一切皆有可能。", note: "原创", source: "琅環书生", uuid: "c252941f-7a60-44a9-9379-cfc45338ef02" },
  { text: "新雪旧草，好景曾温。", note: "网络", source: "楼玉明只是路过", uuid: "4ad6d788-0b18-49d6-8608-951ad563f4a0" },
  { text: "妄想就是你有意识得决定毁灭自己！", note: "原创", source: "尼希亚南达", uuid: "4fddc00d-b444-4712-a4bc-158cb4cde48f" },
  { text: "从前不讲究，往后不将就。", note: "网络", source: "网络", uuid: "f85a3780-9bd1-4123-ad58-01ba8d6ba15a" },
  { text: "要成为光，因为有怕黑的人。", note: "网络", source: "现实", uuid: "a23dea5b-517a-4d52-b603-733c909b0279" },
  { text: "要是爬太高，跌下来是会很疼的！", note: "原创", source: "小忧忧", uuid: "18ffd92a-a755-4560-a3aa-9a7f955cf0f5" },
  { text: "对视是最浪漫的精神接吻.", note: "网络", source: "未知", uuid: "0eb94aeb-1fee-4f84-9eaa-fa7b0c6b73c5" },
  { text: "若没有离开海岸的勇气，就必然无法横跨大海。", note: "网络", source: "哥伦布", uuid: "128481d7-998c-4845-8706-f250d673f172" },
  { text: "踏碎零花，执剑称皇！", note: "原创", source: "Myself-原创", uuid: "b295ab2a-9706-47e8-8bc0-01b932176b69" },
  { text: "生命的遗产是对知识的更新。", note: "网络", source: "YJango", uuid: "862ae932-ee96-4920-b66c-cf4e42be3040" },
  { text: "清潇薄暮雨，半烛下莲舟。蝉鸣微月影，独赏醉难求。", note: "原创", source: "月雩", uuid: "cb4afcfd-c68b-446f-8212-ded141a931ae" },
  { text: "海浪会来，生活总会继续。", note: "网络", source: "明前奶绿", uuid: "e6f47ac1-5277-42fa-8380-3515801b9657" },
  { text: "曾经的那些发生过的开心和难过，就像开败的花。", note: "网络", source: "三七", uuid: "1e851442-a042-4751-a80a-60ac3256e968" },
  { text: "浅相遇，深相知。久相念，长相思。", note: "网络", source: "网络", uuid: "e735fe14-0e78-49a1-ab86-638ceb17bfc7" },
  { text: "出言有尺，嬉闹有度，做事有余，说话有德。", note: "网络", source: "网络", uuid: "2d5274a8-892e-4824-83a0-bdfa90194667" },
  { text: "梦想不会逃跑，会逃跑的只有人", note: "网络", source: "网络", uuid: "5cec7b54-2a5a-4099-96ae-75f8a6f84688" },
  { text: "任何一个伟大的目标，都有一个微不足道的开始", note: "网络", source: "洛谷", uuid: "4b607f19-9335-4931-979f-1906e64ef437" },
  { text: "舞一曲红尘入酒，回拢长袖。", note: "网络", source: "郑明河", uuid: "31e61fa1-f16f-4f3e-b773-c0170d219361" },
  { text: "看落花水东流，岁月不停留。", note: "网络", source: "山风山风等等我", uuid: "55e19e7e-0f37-40c2-b185-ccf4403cdce6" },
  { text: "你强归你强，我永不示弱。", note: "原创", source: "Siyuan", uuid: "752dee2a-7a6c-452f-9d3e-df67fd5999c5" },
  { text: "充其量只是好奇罢了。", note: "网络", source: "佚名", uuid: "86bec6b8-16ac-45fb-b967-983644a82f5e" },
  { text: "可填沧海，成败不堪一说。", note: "网络", source: "烧灯续昼", uuid: "9b067ae8-641e-4d6e-9f51-853c1584dfae" },
  { text: "没有任何力量能毁了下一代，除了不懂时代的上一代。", note: "网络", source: "佚名", uuid: "ca9040c4-aa16-4ed7-90fb-614a7e5f9c14" },
  { text: "心不动，则不痛；爱不离，则不弃。", note: "网络", source: "网络", uuid: "d7bbc3dd-9f5f-4d3f-979c-c40e5018a006" },
  { text: "风吹一次就是一次念想。", note: "网络", source: "自游诗/伊铱", uuid: "737ebb61-2c0b-4a5e-8c77-8a4502e51c8f" },
  { text: "岁月亦没有等我，你......何时来带我走......", note: "网络", source: "耳根", uuid: "a6d43a7c-bd21-4fc9-8594-0d6ae3545f7c" },
  { text: "和风斜阳西向晚，晚风吹尽阴蒙云。", note: "网络", source: "佚名", uuid: "d0306f44-c6f2-4545-8a79-b399888f09c1" },
  { text: "你无法同时拥有青春和对青春的感受。", note: "网络", source: "佚名", uuid: "f69aabc3-122d-4fb6-b752-455c80bca4a9" },
  { text: "不必仰望别人，自己亦是风景。", note: "网络", source: "网络", uuid: "94702493-4c2a-4224-9430-a9d849b58de0" },
  { text: "不用羡慕，你也是太阳。", note: "原创", source: "边妤仙", uuid: "c6239fd3-7279-4155-9e9b-323a76393219" },
  { text: "社会是个就像个机床，人就像块没有加工过的铁。", note: "原创", source: "小忧忧", uuid: "3d21e4ed-a2a1-46e4-9a57-2b7be6ab796f" },
  { text: "其实我们每个人都是一座孤岛。", note: "网络", source: "佚名", uuid: "87c6d25d-a641-4558-9a6e-f9da315a409c" },
  { text: "我若说：黑夜必定遮蔽我，我周围的亮光必成为黑夜。", note: "哲学", source: "诗篇139:11", uuid: "dc5280cc-d565-4914-a9a2-377bb5092d96" },
  { text: "雪崩时，没有一片雪花是无辜的！", note: "网络", source: "网络", uuid: "b8b3e14b-1a81-402a-864a-d137eb0f60e7" },
  { text: "那双原来最喜欢的匡威鞋带现在却解不开。", note: "网络", source: "刘嘉星", uuid: "617a7c6e-7b86-4313-8d09-0d37c4db45cf" },
  { text: "现在的终将成为过去的，过去的终将代替现在的。", note: "原创", source: "npf", uuid: "496cf340-0eeb-4b44-8172-b9c9b8c0ca24" },
  { text: "拂衣袖别繁华，独自踏清秋。", note: "网络", source: "山风山风等等我", uuid: "d2d5b0ed-c1b3-44d7-a6a3-b1fd719cf0e5" },
  { text: "上一阵风、它吹过的时候，带走了我的心我的寂寞。", note: "原创", source: "声音工作室晚风部", uuid: "611d3a72-69f3-4817-adb3-c9a28e925e5d" },
  { text: "明知道这颗种子不会发芽，却依然每天盼望它能长大。", note: "网络", source: "佚名", uuid: "8cf943da-62ed-4b2f-8da5-eb9a0ac92fac" },
  { text: "很久以后他脱了相，皱纹里是他积的愁。", note: "网络", source: "道雀Bzz", uuid: "5eae6677-19f3-4c72-a9ab-bd95ae463063" },
  { text: "我今天的苦，何尝不是你来日的难。", note: "原创", source: "若遇浅香", uuid: "4df86c8e-52d2-45f9-84e4-7c3c9a9c56fb" },
  { text: "以水聚思，以木筑形。", note: "原创", source: "三水柒木", uuid: "d9178919-eedd-46e5-ad13-92e369545a8e" },
  { text: "人总要抱紧什么才知道自己真的存在，哪怕那只是幻影。", note: "网络", source: "不知", uuid: "bda58fe9-16b6-4898-b61c-51317cd65117" },
  { text: "酒后的眼泪像芦苇荡里浑浊愤怒的溪流。", note: "网络", source: "道雀Bzz", uuid: "70f60440-fb3a-41b8-98f0-1abd704161cb" },
  { text: "电脑的处理器总比执行单元小。", note: "原创", source: "licorp", uuid: "20a7d441-3007-4bde-a9eb-d7abc6ea99ba" },
  { text: "我们之间的故事还不多。", note: "网络", source: "Fanko冯思源", uuid: "8c854c5e-c7e6-4e08-8d40-748b919334fc" },
  { text: "多少事，从来急，天地转，光阴迫，一万年太久，只争朝夕。", note: "哲学", source: "毛泽东", uuid: "9685ca1d-7815-4f96-9ac7-f70f6cff0f2e" },
  { text: "再爱你10年，我也才26。", note: "原创", source: "nDhnzr6r", uuid: "4f3be90d-4ec7-43b2-86d3-7cf67b96b60e" },
  { text: "记忆付诸生命之时，时间亦将付诸生命。", note: "原创", source: "JLD", uuid: "08734689-6d3f-45b9-932a-dfa09e7ff84c" },
  { text: "世界上，最漫长的，无疑是等待。直到风带着芬芳，日落水塘。", note: "原创", source: "Moqzekun", uuid: "ce62c97a-c2e0-4c81-93a9-e2a4b91ff671" },
  { text: "窥月色荒芜，曌拂晓清寒。", note: "原创", source: "鹤空流乂", uuid: "929b977f-e147-4550-a382-ce0e49679a20" },
  { text: "红月千年逢此夜，若得卿伴更无求。", note: "原创", source: "nDhnzr6r", uuid: "e6653fd3-345a-4fe1-a0d9-647803641043" },
  { text: "那轮你摘给我的月亮，还挂在你说再见的山梁。", note: "网络", source: "自游诗/伊铱", uuid: "2629a3da-269f-4fc0-ad52-98047b91f943" },
  { text: "节日的意义，就是用美好的方式消耗时间", note: "网络", source: "日食记", uuid: "b2a13e27-460d-40b1-9605-55542c473a8f" },
  { text: "天不生我墨泽埃，赌道万古如长夜。钱来！", note: "原创", source: "mozei", uuid: "289ae44c-b3f9-45dd-aa88-392d6a889b47" },
  { text: "生活没有对错，只要愿意，就会更好。", note: "原创", source: "菲.lin", uuid: "07946fb4-0535-4dfb-953c-94419c2368ba" },
  { text: "我没有负着虚伪的重担的勇气，却将真实的重担卸给了她。", note: "网络", source: "网络", uuid: "d53b85ee-6fd5-435e-8dc1-3210b8a174df" },
  { text: "我想要山盟，你却带给我海誓。", note: "网络", source: "山有木兮", uuid: "cdb1facf-448a-4083-842c-c203572cb077" },
  { text: "神把黑暗中跳舞的心脏叫做月亮。", note: "网络", source: "佚名", uuid: "051c266b-03a7-4eaa-b831-09ce1372a432" },
  { text: "智者不入爱河，遇你不做智者。", note: "网络", source: "佚名", uuid: "e7d5cd6b-2fd9-4eb3-9581-a7c9e9c929f4" },
  { text: "绘守御之明信兮，书香随之丰年。", note: "原创", source: "一只叫一行的喵", uuid: "889ac9b8-3022-4356-98f6-b3bdd9f2ec1d" },
  { text: "自我是一个持续进行着自我存档的“世界线”。", note: "哲学", source: "侯世达", uuid: "f82f12a5-bc5f-471f-8c80-b75c058da8a9" },
  { text: "我们这个世界，从不会给一个伤心的落伍者颁发奖牌。", note: "网络", source: "网络", uuid: "bfb75f93-1fbf-47b2-8ad1-acd9f10073fc" },
  { text: "你知道什么叫幸福嘛？幸福就是拍拍手。", note: "网络", source: "我是皮皮参", uuid: "a5faf166-4696-4345-838c-579a2059438e" },
  { text: "短暂柔情似流星划落，我是你诗的哪个段落？", note: "网络", source: "廖伟志", uuid: "7d344890-6a2f-4430-9306-687ac4c1ed06" },
  { text: "明明是个视观者，却以主角的观念活着！", note: "原创", source: "朴素", uuid: "485629a7-cc35-4cbd-9958-b16f35ed3966" },
  { text: "短暂柔情似流星划落。", note: "网络", source: "廖伟志", uuid: "a8410dc7-f6fc-43bf-b10c-775a6bfcf8ae" },
  { text: "我不是很想你，可为什么想的都是你。", note: "原创", source: "做魚玉子燒", uuid: "f10bbbc6-4441-4726-9b05-216999b841ea" },
  { text: "早点脱单吧，我怕你孤独终老，却又长命百岁。", note: "原创", source: "三行", uuid: "502ae3b6-2fa8-4120-a060-8ebe64dfe29a" },
  { text: "本想自省，却闭门思他人之过。", note: "原创", source: "氧化_小卡门", uuid: "85d2c421-f8d3-456e-87bd-60c219f2b55c" },
  { text: "自与你相识起，我便觉得你与众不同。", note: "原创", source: "Alex", uuid: "4d1afffd-dc42-41f6-94d4-7c023b37df7e" },
  { text: "我们追逐浪漫，看到了自己。", note: "原创", source: "0x h41f", uuid: "00755496-84ee-4f91-85cb-cf2cf241f89e" },
  { text: "人总是害怕死亡，却殊不知有出生之时必有死亡之日。", note: "原创", source: "不善", uuid: "a3455375-329e-4bab-ba96-533a3a8dec08" },
  { text: "请不要带着不好的事情去做自己喜欢做的事情。", note: "原创", source: "御辞", uuid: "7777404f-492e-437f-9471-c4e3d61bce70" },
  { text: "我和我的小伙伴们都惊呆了！", note: "网络", source: "我和我的小伙伴们都惊呆了", uuid: "968f18d5-2444-4866-a1d0-5c4aaa3bece4" },
  { text: "成败不堪一说，如人间过客，总追着虚无漂泊。", note: "网络", source: "精卫（万物终归向海）", uuid: "d36bcf15-3df2-41dd-967b-8c2798bc89e9" },
  { text: "青霞永伴孤陽暮，浮生空等殘月全。", note: "原创", source: "做魚玉子燒", uuid: "f081025b-86b7-4212-88a9-3ac685d689ad" },
  { text: "手松开的沉默，连着我这颗心也死了。", note: "网络", source: "三七", uuid: "188e7999-f401-44eb-bb70-31740fe42611" },
  { text: "你在颓废的时候别人都在努力哦~♪", note: "原创", source: "椎名奈緒", uuid: "708e593b-806e-4e6e-b3f7-64780822e79f" },
  { text: "反正年纪还小，日子还长，那就一边生活，一边期待吧。", note: "网络", source: "佚名", uuid: "a8f420a3-0f9e-4cf2-8664-c1bf42ef638e" },
  { text: "想要更多的力量，去爱这个世界。", note: "网络", source: "佚名", uuid: "ef8ec994-34d2-4bcb-a237-c50a09f1aa87" },
  { text: "即使无法掌握未来，也请不要忘了明天。", note: "网络", source: "网络", uuid: "75f52946-d8a8-4a5f-acfa-923117874af0" },
  { text: "我真的很想喜欢你们，可是你们没有人喜欢我。", note: "原创", source: "梨子", uuid: "a0ed3158-c41f-40d2-8674-e7cd1c9eca87" },
  { text: "我想任性要一回自由。", note: "网络", source: "王健美", uuid: "125091d1-7007-4679-aeb9-4a89f10e6004" },
  { text: "千教万教教人求真，千学万学学做真人。", note: "哲学", source: "陶行知", uuid: "9c5df6da-e338-432b-ac12-70c9305da9ce" },
  { text: "若以色见我，以音声求我，是人行邪道，不能见如来。", note: "哲学", source: "鸠摩罗什", uuid: "8e6ef443-7fde-4141-8a6d-163da578e59e" },
  { text: "雨，打湿了窗，打湿了行人，打湿了梦境。", note: "原创", source: "GoodChing", uuid: "4a5ce569-02eb-4547-970a-1a0cc7209d8a" },
  { text: "忘记了过去，就意味着背叛！", note: "哲学", source: "弗拉基米尔·伊里奇·列宁", uuid: "d52c0edf-751f-495d-b605-cc4d24d095d0" },
  { text: "别错把工具当成目的。", note: "原创", source: "子公", uuid: "772d87da-d1d9-4233-9576-c32e043dcdee" },
  { text: "如果你没有做好准备，你就是在准备失败。", note: "哲学", source: "本杰明·富兰克林", uuid: "bf073df3-c812-48c6-9b1c-a5cd9151cac0" },
  { text: "某天我想起你，你竟然只有轮廓，转瞬即逝。", note: "网络", source: "网络", uuid: "af95e8d6-ecbe-4f96-b0d8-8ed5e642c1ab" },
  { text: "问题不在于自我有限，而在于自我设限。", note: "网络", source: "Zaunese", uuid: "a1e0c879-2243-4523-8595-cd874e044ec5" },
  { text: "梦里都是假象。", note: "网络", source: "30年前，50年后", uuid: "cd9bef2b-27e1-4a9c-9fd7-a405d6746928" },
  { text: "没有人帮你，说明你一个人可以。", note: "网络", source: "网络", uuid: "c67ecded-ebc6-4cbf-8da6-38b4416a3436" },
  { text: "每一次匆忙的路过，都是一次永久的离别。", note: "原创", source: "咸鱼君ps", uuid: "d4eeefd4-ac96-41fe-9e0f-c85ba41f9b38" },
  { text: "宅，是一种生活状态；死宅，是一种人生境界…", note: "网络", source: "网络", uuid: "992502d6-7d1b-49d5-bef9-ecd846246798" },
  { text: "幼儿园的孩子们会哭，但他们还不懂得什么是累。", note: "原创", source: "舟泛四海", uuid: "4d4adcf2-bf35-4975-9a08-44c2c17cce18" },
  { text: "明明就是喜欢，失去了才痛心，你在胆怯什么啊喂？", note: "原创", source: "流光印记", uuid: "611ac7af-07ce-4442-ab86-31888f8848bf" },
  { text: "暴力出奇迹，骗分过样例。", note: "原创", source: "OIer", uuid: "0a2e5306-5283-4d80-b4da-17646d4ad572" },
  { text: "学会生活，这应该意味着学会死亡。", note: "哲学", source: "德里达", uuid: "2d78acb2-b0a7-4476-b156-8a60dc030000" },
  { text: "黄昏时的天略带有妩媚。", note: "原创", source: "朴素", uuid: "8e556a37-ce4f-431f-b1e0-3a179abc59dd" },
  { text: "都是你的错，没有理由的。", note: "原创", source: "JJJ", uuid: "2e56caf0-f6a0-4ecf-9659-d5aba55a0a38" },
  { text: "一切悲剧皆始于无能。", note: "原创", source: "hdcs", uuid: "36a25f06-582d-41ed-a2e7-35d6ffb7c0ec" },
  { text: "新雪旧草冷冷，好景曾温。", note: "网络", source: "楼玉明只是路过", uuid: "4912968a-7919-4d10-bc58-81c38cfc1ef3" },
  { text: "无求之所，自有天赐。", note: "原创", source: "朴素", uuid: "9d3ced91-fc6c-49ee-8020-0410d36d2d9b" },
  { text: "不要过模棱两可的人生。", note: "原创", source: "yzuyuz", uuid: "f73eb4f4-28c4-4fed-9b34-d8df62a5cc4b" },
  { text: "你指尖跃动的电光，是我此生不灭的信仰。", note: "网络", source: "某科学的超电磁炮", uuid: "b036ff4a-24de-4017-beeb-7323c7474916" },
  { text: "幸福往往是摸得透彻，而敬业的心却常常隐藏。", note: "网络", source: "网络", uuid: "758f5661-46cc-4249-a268-2d3ddf22356c" },
  { text: "狂喜是雨。忧愁是雨。悲剧是雨。", note: "原创", source: "auc", uuid: "d867e948-1bb4-47fa-b941-59c38bf0d3a4" },
  { text: "世人只会记得第一，而不会记得第二。", note: "原创", source: "prisoer", uuid: "19364de3-4a54-4efc-bdc8-c416226181df" },
  { text: "找导师和找对象一样，都是迷惑行为。", note: "原创", source: "帆仔", uuid: "66fc1e2c-7cce-458f-8b62-1b6c2c2f4684" },
  { text: "我们，在路上，勿忘初心。找寻最初的梦想和微弱的希望。", note: "原创", source: "根号菌SAMA", uuid: "1eef659b-3a69-454b-930f-6823d1b290ef" },
  { text: "巴别通天隔语种，岱宗横绵绝知音。", note: "原创", source: "做魚玉子燒", uuid: "29a6de7a-efef-445b-83b7-533823f0b18b" },
  { text: "风追落叶叶追尘，彩云追月月自明。", note: "网络", source: "网络", uuid: "989cc3cf-4237-4ce6-9e91-7d03b11fd25c" },
  { text: "活的不快乐，本质上源于自己的无能。", note: "网络", source: "匿名", uuid: "d3abc428-9a93-4553-9ace-b6c54d183e7f" },
  { text: "无数少年蜷缩在火车里，却幻想拥抱全世界。", note: "网络", source: "汗衫哥", uuid: "20332714-8aa8-4c80-8d1e-ad4d73ad9c7b" },
  { text: "落日拉开黑夜的帷幕，繁星点燃黎明的火光。", note: "原创", source: "神奇のDzoer", uuid: "769c93c2-b7db-47f8-a39b-df52e37b0f01" },
  { text: "以后不见面的日子要按年算了，希望你不留遗憾地度过。", note: "原创", source: "葭樱", uuid: "89843c7f-847d-4fa5-8e6a-f07625cb93bd" },
  { text: "执着与进退？这是个问题。", note: "原创", source: "GoodChing", uuid: "4a578d8b-3aa4-45c7-ad0e-4e5b2db7400e" },
  { text: "思念悬枝，月影迟迟。", note: "网络", source: "小红书", uuid: "62dc356d-befa-4daa-9496-b1446d74cc68" },
  { text: "每个人都害怕受伤害，只是看谁更勇敢而已。", note: "原创", source: "帆仔", uuid: "b5154a2d-b929-4af4-b5b7-63959038876d" },
  { text: "生命中，再无聊的时光，也都是限量版。", note: "哲学", source: "英语杂刊", uuid: "ab0a754a-da25-4523-87a8-2cf6eaafcaff" },
  { text: "我最怀念的是大家起哄我们两个的时候", note: "网络", source: "佚名", uuid: "d135594b-f537-4684-ab64-048b4b710cdc" },
  { text: "人类最大的敌人是傲慢，其次是无知。", note: "原创", source: "亚亚努阿", uuid: "746ba691-5103-4b13-88e6-b11ffc215fe6" },
  { text: "不要祈求生活公平，只需要适应它。", note: "网络", source: "网络", uuid: "9e4981f5-5ae0-44ae-9b76-38b1b420f6e8" },
  { text: "此后人间应如是，天南海北不相逢。", note: "网络", source: "知足常乐", uuid: "f6eafc78-ef87-46dd-9b90-c87bf771387c" },
  { text: "最深的孤独不是长久的一个人，而是心里没有了任何期望。", note: "网络", source: "网络", uuid: "f221a75c-7589-4df2-ae2a-45069ecc7a72" },
  { text: "我已经完全爱上沃玛(Warma)了！", note: "网络", source: "来自网络", uuid: "54c0277d-2852-4ef8-a43e-00e2f0ba0c5c" },
  { text: "向来是据理力争，从不曾无理取闹。", note: "网络", source: "胡向荣", uuid: "46b6ec55-5b03-4ce4-ade8-bc68ea21ae29" },
  { text: "你这个年纪是站在太阳底下都会发光的年纪。", note: "原创", source: "鱼", uuid: "42e72e97-5f46-4187-b86e-10da06d33463" },
  { text: "寒梦凄影深似雪，透彻心思写浓烈。", note: "原创", source: "雪彻", uuid: "cff871ee-84e6-4f6b-86c1-a7d6bbea29f3" },
  { text: "强者改变环境，弱者适应环境，死者变得僵硬。", note: "网络", source: "网络", uuid: "aa736f1f-7dc6-4b52-b802-aabc50718086" },
  { text: "爱永远不是在乎，而是正确的表达。", note: "网络", source: "知乎用户肥叔", uuid: "d8df4bd8-8735-48d5-9b3d-f2f0b393ed70" },
  { text: "我的东西难道不可随我的意思用吗？", note: "哲学", source: "马太福音20:15", uuid: "308675ef-495f-427d-83e0-377710ee4a59" },
  { text: "资本来到世间，从头到脚每个毛孔都滴着血和肮脏的东西。", note: "哲学", source: "卡尔·海因里希·马克思", uuid: "116833d9-61ea-4634-a913-c51a3410cf85" },
  { text: "我不愿再为你困在原地。", note: "网络", source: "音量不足", uuid: "2bada89d-c359-4b1b-b40c-7db6638059fe" },
  { text: "远望着这片海我独自在徘徊，将泪水掩盖。", note: "网络", source: "三七", uuid: "1ac90dea-2246-4989-9de5-a827c8e462b9" },
  { text: "窗外花火亮起的瞬间，我为何在流泪？", note: "原创", source: "CuSO4", uuid: "cf4e7d1f-dabf-429d-8eae-47daa56c6a5a" },
  { text: "死亡是所有人的共同幸福。", note: "哲学", source: "克尔凯郭尔", uuid: "28e92c07-0ca1-45d2-b7da-f01d59ad608f" },
  { text: "如果分手的恋人还能做朋友，要不从没爱过，要不还在爱着。", note: "网络", source: "九ちのセカィ", uuid: "4ca539b4-d533-4721-85af-4c54da60b716" },
  { text: "很多人看不到未来，其实是看到了未来。", note: "网络", source: "弱智吧", uuid: "8cb1f75b-d05e-4349-a74f-621d5e7a10c5" },
  { text: "话送友人时，眉眼盈盈峰簇。", note: "原创", source: "碧水凌涛", uuid: "4bc16802-ed31-4354-afd0-671947572214" },
  { text: "时间，捉摸不透。", note: "原创", source: "GoodChing", uuid: "aa7b8982-16c0-4ced-9848-c82a9f818090" },
  { text: "你如果認識以前的我，也許你會原諒現在的我。", note: "原创", source: "Hasty", uuid: "6af7d400-2c5b-4465-b96c-cbca5d5d4ee0" },
  { text: "绝望的人没有故乡。", note: "哲学", source: "阿尔贝·加缪", uuid: "4d4dc771-98ed-4860-a4ab-7ee652dd522a" },
  { text: "在灰色的世界中追寻纯粹的白色或黑色，也只是坐井观天吧。", note: "原创", source: "CuSO4", uuid: "d359eb86-4dcd-4353-87ed-1d88f0bb15bf" },
  { text: "当眼泪流下来，才知道，分开也是另一种明白。", note: "网络", source: "佚名", uuid: "206c7881-a44b-4b9b-bf5b-511cd9b3a299" },
  { text: "每个人都是有梦想的！当然，你要先做个梦，不然就是瞎想。", note: "原创", source: "Shawn", uuid: "361e230e-a233-459e-8d73-7dc3316e48b4" },
  { text: "月色随风摇摆，我仍飞奔向海。", note: "网络", source: "30年前，50年后、烧灯续昼", uuid: "10452a63-5655-46dc-a415-65eedd36f12b" },
  { text: "人生四然：来是偶然，去是必然，尽其当然，顺其自然 ...", note: "原创", source: "san.ci", uuid: "260de447-6582-4c91-ad67-1c3bc9058f26" },
  { text: "所谓有求而不得，人心欲壑。", note: "网络", source: "30年前，50年后", uuid: "87e9b1c3-ec9b-4f81-a680-c8063c914875" },
  { text: "若非缠绵落雨中，怎知情意浓，点滴伴着浮生若梦。", note: "网络", source: "蓝乐", uuid: "55edb11e-fa57-4ca9-b28a-b9eab1a95952" },
  { text: "也如春骄秋瑟处，胜景未在浸寒水。", note: "原创", source: "storm1614", uuid: "a7371801-f63a-45d1-ae25-56b564b48f87" },
  { text: "还好还可以想你，不然拿什么对抗生活的琐碎和无趣。", note: "网络", source: "佚名", uuid: "c8f2e898-c9c6-4e27-8a8d-c2dd1749ef32" },
  { text: "水遇断崖无处走，垂下成瀑。", note: "原创", source: "鹤空流乂", uuid: "7c8901c7-77bb-47aa-af4a-6626344a46c4" },
  { text: "说爱，不过是千百年一次的轮回。", note: "原创", source: "夕阳怀雪", uuid: "6e1e9f1b-df60-4d26-984e-f2d9fbf90709" },
  { text: "尘染梧桐穿叶落，暖春秋色是人寰。", note: "原创", source: "碧水凌涛", uuid: "31626dd6-c586-4b4e-aea3-95c0f8d80d57" },
  { text: "那时候感觉不到痛，想当孙悟空。", note: "网络", source: "我的纸飞机", uuid: "5512e9af-dfd8-4eb6-924d-c22519fec74e" },
  { text: "人生在世不称意，不如自挂东南枝", note: "网络", source: "十万个冷笑话", uuid: "0ff27b0a-5598-4c3b-b905-4dc5360edca4" },
  { text: "窗头清角残光，床头丧气萦梁。只恨眉头紧锁，无言欲堕天狼。", note: "原创", source: "凌涛", uuid: "c6dd89c5-1500-415d-becd-7f4e15c1bab0" },
  { text: "下坡路固然好走，可也许就再也上不来了。", note: "原创", source: "Enthon", uuid: "fed0926d-bb4c-4d74-917a-e68f1a7b1796" },
  { text: "苍山月下问纯真，惟解孤光自照暗香魂。", note: "原创", source: "凌涛", uuid: "49c9cc08-e49d-49b5-a1e3-af36d95ab03f" },
  { text: "愿你的青春如花般绽放。", note: "网络", source: "QQ空间", uuid: "1880f080-b1cf-4ee2-a86d-d0cd84bf8577" },
  { text: "真正的感情是不会被时光淡化，而与时共长。", note: "原创", source: "大霸儿", uuid: "af070812-4982-4310-8e47-62fb23137c67" },
  { text: "钱塘风雨起苍黄，贺鸡儿楠过大江。", note: "网络", source: "贺指导", uuid: "920024dc-747b-4a70-90db-0022d070a03e" },
  { text: "在那以前，人们都以为自己是天之骄子。", note: "原创", source: "Hope888", uuid: "9f42c787-7cd3-4d35-be25-f7f75841bc93" },
  { text: "学习和什么使我们快乐", note: "原创", source: "原创", uuid: "5f0c3caa-24a2-415a-8c46-d7a7e7fddc04" },
  { text: "悲痛藏于心，欢喜言于表。说的不就是我们吗！", note: "原创", source: "白凝羽", uuid: "3d1ba2fa-1d63-4944-b142-3bdefbd1f3f8" },
  { text: "我真的很没用，但是你要是喜欢我，那我就为你而活吧。", note: "原创", source: "MMMMMhx", uuid: "013dfd58-3450-40e4-a243-baf5688fff43" },
  { text: "如果错也是缘，那么一错再错的未必就是孽缘。", note: "原创", source: "汪洋", uuid: "ad63dcd5-6209-4952-8e7d-6434f743700c" },
  { text: "在无数个伸手不见五指的黑暗里，请记住，你的灵魂自有光。", note: "原创", source: "杨嘉鑫", uuid: "42f0c3e3-788c-4d34-9aeb-4c78b9e504a5" },
  { text: "故事的结局从来不人意！", note: "原创", source: "九思", uuid: "b69df0ef-287e-4ae8-b728-81d50cc03dd4" },
  { text: "譬如眼根，不自见眼；性自平等，无平等者。", note: "哲学", source: "大方广圆觉修多罗了义经", uuid: "3a22762f-bd4c-46dd-a4fa-d068b7ab0b6c" },
  { text: "举头三尺光；隐现交欢日，暮是圣光毕。", note: "原创", source: "朴素", uuid: "5473ec63-4046-4002-9a20-6e51268774c5" },
  { text: "什么是灰色？是风吹的，是飞蛾。", note: "网络", source: "道雀Bzz", uuid: "24bb757b-0938-42fe-b91c-30e3c09c40d5" },
  { text: "一阴一阳之谓道，乐天知命故不忧。", note: "网络", source: "佚名", uuid: "20c2faaf-b964-4c08-a65f-da02e3cf14ae" },
  { text: "徒伤悲青春年月。", note: "网络", source: "花晶晶", uuid: "562733b3-867b-4573-8e1c-a7dce1a95b72" },
  { text: "避弊盗利非小人不可为，须纳其弊方承其禾。", note: "原创", source: "朴素", uuid: "b2e22f7c-934b-4551-b1af-7279c9398df7" },
  { text: "我似乎又回到开始的地方了。", note: "原创", source: "Rene", uuid: "4e1f9fd3-fcab-4f8b-b0c4-81f0eecfc746" },
  { text: "你是我最真模样，从来不曾遗忘。", note: "网络", source: "纯白", uuid: "645b42c4-9d42-44da-8b5b-c9c44b1bf7f5" },
  { text: "我们都在假装坚不可摧，其实一触即碎。", note: "原创", source: "Eternal_Battle", uuid: "9b4cfd30-97d3-41e6-9a85-25aca37677c0" },
  { text: "我们曾经是恋人，不是敌人。", note: "网络", source: "网络", uuid: "aba31edc-a73a-49d4-9b4d-409d258e5287" },
  { text: "磨损年岁迁延日月犹自借问 此身。", note: "网络", source: "楼玉明只是路过", uuid: "80711018-8f72-4535-aa2c-eba1b905dd31" },
  { text: "终是那一捧土，时光会溜走。", note: "网络", source: "王健美", uuid: "9d64288b-2148-4071-9d3e-b4874385be51" },
  { text: "刚好那晚我心情不好，而你刚好睡的很早。", note: "网络", source: "网络", uuid: "a9e53014-3275-4af4-8a0f-c710ef618977" },
  { text: "像受体酪氨酸激酶一样，激活自己。", note: "原创", source: "帆仔", uuid: "a5f937ad-74a8-4a9f-98fc-21ffbcab0fb0" },
  { text: "爱你如同烈火，照亮万里山河。", note: "原创", source: "every_sun", uuid: "66d94bdc-be5c-4293-a1e9-9c4fb78cbfd7" },
  { text: "酸甜苦辣咸，五味调和，共存相生，百味纷呈。", note: "网络", source: "2019年高考试卷命题组", uuid: "620bdadc-a773-4344-9580-0708e6c236fa" },
  { text: "不要随便找个参照物就坠落得理所应当。", note: "原创", source: "边妤仙", uuid: "0de5b911-6ae7-46ef-bfe9-91d94f8196ac" },
  { text: "蝶舞休时，大梦初醒，万籁俱静。", note: "原创", source: "笙", uuid: "4c52ea7b-fb5c-460a-9f94-f013f343b2ac" },
  { text: "（根据相关法律法规，相关内容已被屏蔽。）", note: "网络", source: "（根据相关法律法规，相关内容已被", uuid: "9fda32f5-c54f-4b35-b4b4-4f963e65a403" },
  { text: "所为为人不指褥自耻。", note: "原创", source: "朴素", uuid: "bb79a96e-126c-4bbe-b22f-432e83324c33" },
  { text: "何必满腹心酸，委屈地承受。", note: "网络", source: "王健美", uuid: "8339ada2-4859-4b3c-a5d3-3a8a1a013606" },
  { text: "喜欢寒冬。因为寒冷时，更能感受到被温暖的幸福和美好。", note: "原创", source: "Sad_slime", uuid: "43bcd15d-1d99-4f42-b111-13775a037e1f" },
  { text: "静，留一份安宁美好；动，绎一部年少轻狂。", note: "原创", source: "一只叫一行的喵", uuid: "4e00c73b-66ad-43a5-bcf3-a038c75739b9" },
  { text: "保留这牵挂，属于我们的童话。", note: "网络", source: "小寒", uuid: "de811a5f-f56d-49bc-890a-b1bccffeea91" },
  { text: "我的心是生命的禁区，总有人无意闯进来，然后自杀。", note: "原创", source: "双十", uuid: "44543c88-5c87-4be4-9139-34a2ddd0199b" },
  { text: "把人生苦乐，活通透。", note: "网络", source: "王健美", uuid: "edda92d6-d700-4408-be42-3011f89922b3" },
  { text: "我喜欢热闹，但并不拒绝孤独。", note: "原创", source: "莽红尘觅知嘤", uuid: "1f5a54f6-4337-4d65-bb56-fea48de3f93c" },
  { text: "抛开世间的烦忧，不被世俗左右。", note: "网络", source: "追着山风寻自由", uuid: "5545644f-29ab-488f-814f-880fe00e042f" },
  { text: "这雨生于天，死于地，中间的过程就是人生。", note: "网络", source: "耳根", uuid: "efedcfa7-8fad-4fc2-ae88-f15ba32a9526" },
  { text: "恶魔离开你的那一天，天使也会离开。", note: "原创", source: "忆", uuid: "d7411692-1d08-417a-a027-ae58ae14adcb" },
  { text: "不弄丢自己，是爱情的底线。", note: "原创", source: "落叶", uuid: "7a9dd985-0dd8-44f9-9a2c-ea77764b371c" },
  { text: "必须在敌军还分散的时候，出其不意地袭击他们。", note: "哲学", source: "弗拉基米尔·伊里奇·列宁", uuid: "e521ca54-e04a-49ca-a25c-2388147f6460" },
  { text: "牵着你手的时候，世界属于我。", note: "网络", source: "啦啦啦种太阳", uuid: "b05a8bd3-5947-4a04-b36e-f87b679cded4" },
  { text: "人生就像爬楼梯，只有脚踏实地的向上，才能到达屋顶。", note: "网络", source: "网络", uuid: "15975da5-b1a3-4f58-8d6b-554cc2c42c37" },
  { text: "夏雨微尘轻拂袖，两衫风雪若得闲。", note: "原创", source: "随笔", uuid: "5aef4e77-6a40-4038-8670-de4a20f6752f" },
  { text: "旅人不识清明雨，深院碧桃香红袖。", note: "原创", source: "日央", uuid: "6cab6512-8cfe-4dfe-a1de-54532d884ff4" },
  { text: "我曾因她置身光明，却又因她堕于崖底。", note: "原创", source: "夜杏", uuid: "8aa19f15-738d-4262-8f6a-0fb30f8acb19" },
  { text: "雾柳迷苍星，夜百闻梦云。潦中倒杯酒，终与化月灵。", note: "原创", source: "月雩", uuid: "a524fb5b-4e64-42e7-bf0a-95f3b720572f" },
  { text: "但哲学的真理必须是含有个人承诺的真理。", note: "哲学", source: "张汝伦", uuid: "8af7d84e-ddc6-43d3-ba44-1050f287041b" },
  { text: "让我们，爱上生活，体验生命的魅力。", note: "原创", source: "叶小楠", uuid: "9ee7a47e-bde3-4597-88a8-dc78a1416304" },
  { text: "你终于在我的生命中暗了下来。", note: "网络", source: "网络", uuid: "85cc4d30-a7ee-4d7e-a511-c1746537c7b7" },
  { text: "我们在努力扩大自己，以靠近，以触及我们自身以外的世界。", note: "哲学", source: "博尔赫斯谈话录", uuid: "b2f3834f-5f52-4b62-bb3c-f9fb98901419" },
  { text: "扣首问路，码梦为生。", note: "网络", source: "网络", uuid: "ee6904cd-f6ef-49b6-9062-4bcb53465da7" },
  { text: "你很朴实＝你可以无偿为我工作而且不抱怨。", note: "网络", source: "不知名网友", uuid: "cceeff35-5aba-4456-9346-a8809523083b" },
  { text: "(随意切换 我的速度 我的轨道。)", note: "网络", source: "周梦忆", uuid: "3e84241c-b772-4547-90e4-ff170d9d1c77" },
  { text: "童年那仍然红色的血，依然成为我心中的光。", note: "原创", source: "Yanser", uuid: "8dec7be7-991a-4ce7-89fb-0384034832b5" },
  { text: "烂木上新生的真菌，也许是逝去的寄托。", note: "原创", source: "yzuyuz", uuid: "73e47ede-dcde-4078-bf6c-001552b66fe9" },
  { text: "青木披山岚，绿漪漾水河。", note: "原创", source: "鹤空流乂", uuid: "ec81a064-6bb6-4643-8f4d-0a225040c4e4" },
  { text: "我珍惜一路真心的相逢，感恩命运的温柔。", note: "网络", source: "日月同辉", uuid: "42844885-f40b-45f6-82f0-44da01f6149e" },
  { text: "心事与谁能诉说，我独自来承受。", note: "网络", source: "追着山风寻自由", uuid: "dc889246-300f-4c8a-af48-e5f24236ab0c" },
  { text: "后代人的权利远比当代人的欲望更重要。", note: "哲学", source: "《黄石国家公园法》的理念", uuid: "0e286fe6-ca51-42bb-8f78-134a1bd98873" },
  { text: "我们都很擅长口是心非，但又希望对方能有所察觉。", note: "原创", source: "九ちのセカィ", uuid: "49c1bed7-20de-4905-b63d-e3aace63b175" },
  { text: "忘你不舍，寻你不休。", note: "网络", source: "春秋肠の小曲", uuid: "11c049c7-5ff4-44b1-903c-c82efeb62c8a" },
  { text: "故事不是人生指南，你喜欢，可能只是你遇过。", note: "网络", source: "mess up", uuid: "590d021f-8c2a-480c-8beb-d064e265fece" },
  { text: "还好回头有你，不悔这一路。", note: "网络", source: "路小可", uuid: "41c94970-8861-484b-8ee3-fb05ec1fe929" },
  { text: "不是我熬夜，是黑夜需要我这颗璀璨明亮的星。", note: "原创", source: "希铁石z", uuid: "6fbb8815-c9a1-4d4e-ace5-e6bbd38b8a26" },
  { text: "自别后空影落轩窗。", note: "网络", source: "郑明河", uuid: "354e1bdd-adf6-4984-8229-8dc5756092f7" },
  { text: "哪有什么反派，只不过是一群悲惨童年的孩子罢了。", note: "网络", source: "小宋不会装纯情", uuid: "1ab2f6a8-68dc-40a5-8927-077baca46880" },
  { text: "努力微笑想让你回头。", note: "网络", source: "Fanko冯思源", uuid: "17474cb6-b6e6-4f16-acdb-a3e6cd9b7e10" },
  { text: "我的每一个动作都有你的印记", note: "网络", source: "十万个冷笑话", uuid: "8dd357e1-8611-49b6-ad05-12dc475d4918" },
  { text: "纸鸢殁回飚，苔箋啮旧痕。", note: "网络", source: "佚名", uuid: "08448c10-cc66-4661-9294-60aff20c5ff5" },
  { text: "生活就像超级女生，走到最后的都是纯爷们。", note: "网络", source: "网络", uuid: "eb2e8532-b24e-4907-94cd-6dc1e0dc3d51" },
  { text: "乱风错错卷卷云散散八千里。", note: "原创", source: "无名氏", uuid: "37beea93-3d06-421c-a5a8-62a87656e4a7" },
  { text: "伤心的人别听慢歌，颓废的人要听战歌。", note: "原创", source: "帆仔", uuid: "0587b726-da7d-43fa-80cf-89f62158e9f3" },
  { text: "美术之为物，欲者不观，观者不欲。", note: "哲学", source: "王国维", uuid: "bc61f14d-5cc8-4b46-a183-e79e38089d83" },
  { text: "生活就像愤怒的小鸟，失败后总有几只猪在笑。", note: "网络", source: "网络", uuid: "01220135-ef58-4844-b10a-57d5fad2cf4b" },
  { text: "一举一动，都是承诺，会被另一个人看在眼里，记在心上的。", note: "网络", source: "佚名", uuid: "c57ae5c8-b1ca-4025-af73-0e884ee1660e" },
  { text: "上帝不会为难头脑简单的孩子", note: "网络", source: "句子迷", uuid: "db9249ac-366d-4303-b95b-082b153e7913" },
  { text: "这个世界那么脏，谁有资格说悲伤。", note: "网络", source: "网络", uuid: "0d855d8b-eea5-4c84-b5e7-c495c99fec2c" },
  { text: "忌寒北雁离难挽。", note: "原创", source: "鹤空流乂", uuid: "0f7929fa-f4b9-4556-aaaf-16190e3df78c" },
  { text: "师者，所以传道授业解惑也。", note: "哲学", source: "韩愈", uuid: "24b3813e-17cf-454c-8351-0a718bab0fdc" },
  { text: "为什么你宁愿吃生活上的苦 而不愿意吃学习上的苦？", note: "网络", source: "知乎", uuid: "84773a37-02fc-4509-854e-50483a20d7ff" },
  { text: "我们就像小小的纸飞机，老师就是放飞我们的手。", note: "原创", source: "啟腾同学", uuid: "6873af3e-ef52-4c6c-80c5-ce60fdd7dba9" },
  { text: "童年暑假那个他，快乐是永不忘的", note: "网络", source: "小寒", uuid: "f58cc570-ed17-429c-873e-41d9b7859b44" },
  { text: "雨喝醉了，小路摇摇晃晃，倒在我怀里。", note: "原创", source: "青栀", uuid: "56f7c444-3642-4403-8375-649a88ea564a" },
  { text: "有钱人的生活，往往就是这么朴实无华，且枯燥。", note: "网络", source: "朱一旦的枯燥生活", uuid: "801e9675-f34a-4cd0-9692-38a1acbc5b8e" },
  { text: "可能你现在不是别人的，但将来也不会是我的。", note: "原创", source: "相信你愿意相信的就好了", uuid: "61d71053-cb19-411a-bd0c-be91b05cb01d" },
  { text: "我们用15年铺设了整整30公里的铁轨！", note: "网络", source: "小约翰可汗", uuid: "c5e1d05c-a439-42dd-9aeb-ae6e1b3853ff" },
  { text: "我们的周围并非没光亮，只是太耀眼将我们灼伤。", note: "网络", source: "乌托邦P", uuid: "f1d43e2b-d461-4f40-8e5c-6e114280513d" },
  { text: "没有好身体，哪来的好工作？", note: "网络", source: "网络", uuid: "0ae1e827-25b5-44ad-aea4-c7970ea9ca6a" },
  { text: "或许相遇不再避开才是真的释怀了。", note: "网络", source: "佚名", uuid: "5b20c4ff-48ad-4331-b442-594c37558f63" },
  { text: "编译驱动这事，说真的，不该让普通用户干。", note: "网络", source: "openKylin", uuid: "36688dfe-3e8d-4d43-90ce-38ac0eb3cc4d" },
  { text: "迷茫在人海之中，找不到路，东顾西顾，无所谓，只管前行。", note: "原创", source: "dthope", uuid: "58c15828-8da8-4d68-b7d9-b3561d4298c7" },
  { text: "东西再好又怎样，我喜欢的永远是我拥有的。", note: "原创", source: "HUYYY", uuid: "34fd8867-060f-436e-8df0-53810260910d" },
  { text: "人的精神思想方面的优势越大，给无聊留下的空间就越小。", note: "哲学", source: "叔本华", uuid: "4c13716e-b34b-4407-9e2a-490e63f52c7d" },
  { text: "改革不停顿，开放不止步。", note: "网络", source: "习近平", uuid: "df95e3f6-7603-4085-ad8f-17e7e57c7b60" },
  { text: "我的辫子长在头上，诸君的辫子长在心里。", note: "哲学", source: "辜鸿铭", uuid: "5562841a-6724-477f-8708-9243f7a76deb" },
  { text: "我只是太想被好好对待。", note: "网络", source: "精卫(万物终归向海)", uuid: "80a973e2-7c74-427a-a0b3-f9ae21137bca" },
  { text: "不求闻达，但求心安。", note: "网络", source: "增增", uuid: "f6c80eb2-f6e7-438d-8752-f6a94db8d2f5" },
  { text: "我想与你共度余生，但不是今天。", note: "网络", source: "网络", uuid: "96022b42-fe9f-4081-aee0-f642bc54390d" },
  { text: "此生的约定，白头亦不负。", note: "网络", source: "耳根", uuid: "ea27ce3d-cfe6-47f9-9e3d-96b939400a92" },
  { text: "墓碑是大地的记忆，生者是死者的救赎。", note: "原创", source: "CuSO4", uuid: "6cdd219a-a6bb-484c-bd21-f69c08985f05" },
  { text: "就算未曾拥有，也要满怀期待。", note: "网络", source: "糯米大兔子", uuid: "79fae99f-a7a9-49ed-a4cb-7eb66bec4798" },
  { text: "能不能停下来，看看那个满眼泪花奔向你的我。", note: "网络", source: "网络", uuid: "7e6e8b78-56ac-47fb-ad2b-d32a30a8c994" },
  { text: "许久未见的朋友，定会在梦里，有一次无需言语的交流。", note: "原创", source: "JiujiuYu", uuid: "8d81788d-3e33-454c-8726-0a9cf55cba9f" },
  { text: "美国有乔丹，中国有黑丹。", note: "原创", source: "蜥蜴", uuid: "d79499f7-27e8-4f9b-b3aa-6f1ac9abe82b" },
  { text: "循此苦旅，终抵繁星。", note: "哲学", source: "拉丁古谚", uuid: "fbcb26cb-6343-42bb-8f6c-bc302363de89" },
  { text: "我来人间一趟，化作尘埃飞扬。", note: "原创", source: "宽宽", uuid: "56f95672-ae3b-4149-8432-502037efadb0" },
  { text: "我喜欢你，仅你可见！", note: "原创", source: "Curtain.飘尘", uuid: "01bb195a-3843-4d5a-94e9-5616679768d4" },
  { text: "愿世间万物都会被温柔相待。", note: "原创", source: "夜雨天梦", uuid: "0558aa2e-8994-48cd-bc7a-7a3a7258cb23" },
  { text: "我愿意耗尽所有换一次重新珍惜。", note: "网络", source: "音量不足", uuid: "3bb96e11-09ff-4d19-9964-15d6842ba18a" },
  { text: "人民，只有人民，才是创造世界历史的动力。", note: "哲学", source: "毛泽东", uuid: "2f1e5224-ce99-4658-a7c6-281bd4893ce6" },
  { text: "占有欲太强来源于对自己极度的不自信我们要学会对生活和解。", note: "网络", source: "佚名", uuid: "551c3bb6-7a9d-44c0-8ae7-3cc1f1b7f0cc" },
  { text: "笑声让我想起童年暑假那个他教我折飞机的他好吗。", note: "网络", source: "小寒", uuid: "e40b1dd8-02dc-4ecb-a0e9-252cc545bf45" },
  { text: "没有过多的幸运值，就得拥有个坚持不懈的斗志。", note: "原创", source: "朴素", uuid: "94904be0-9a51-4d0d-879c-91d58e85f0fd" },
  { text: "片是落叶处，一切尽萧然。", note: "原创", source: "方树", uuid: "aed41cf0-c9c5-42dc-b87d-f283e7f30d81" },
  { text: "人生，三十年前看爹敬儿，三十年后看儿敬爹！", note: "原创", source: "白给少年洛初", uuid: "d844038b-cb58-489d-874d-65efc95d9f6f" },
  { text: "几千年只不过是麦子熟了几千次而已。", note: "网络", source: "网络", uuid: "d5797879-f6a0-4b53-8b8e-46b499bec593" },
  { text: "人为什么要努力？因为怕有朝一日，普通的我，遇见特别的你！", note: "网络", source: "佚名", uuid: "cc8bd35c-cc13-45c2-a422-393e0abeea6c" },
  { text: "你是年少的欢喜，倒过来也亦然。", note: "网络", source: "佚名", uuid: "8549fc69-e4bf-46ff-a3f3-aed338e42f8e" },
  { text: "我写了一首诗，我不敢写的是你的名字。", note: "原创", source: "光之帝皇侠", uuid: "754ea585-fa0f-4d6c-b345-129f6270fddd" },
  { text: "事已至此，幸而夜风对他温柔。", note: "网络", source: "网络", uuid: "de49ff90-2d84-43c2-9248-bbf012c2a1be" },
  { text: "哪里都去不了，就想念起大海来。", note: "网络", source: "佚名", uuid: "78672e1e-2a08-403d-9568-374976bd88b0" },
  { text: "宇宙中只有一个地球，毁掉它容易，回头路难走。", note: "网络", source: "第五薰", uuid: "51b4e12f-f2de-4585-acb4-3c0b1db4bee8" },
  { text: "你若盛开，清风自来。", note: "网络", source: "网络", uuid: "d018d48f-4072-4736-a750-3c4856fb8077" },
  { text: "我漂泊的船能不能靠在你的岸？", note: "网络", source: "徐重来", uuid: "3ece519e-a076-46db-ad4b-fd50d44e4220" },
  { text: "我们生来平凡，那便做一朵洁白的栀子，经过之处，皆留芬芳。", note: "原创", source: "Cindy_Li", uuid: "69c03525-b960-483d-8d50-2ca8334cdfc1" },
  { text: "任何一件事都具有两面性。", note: "哲学", source: "弗拉基米尔·伊里奇·列宁", uuid: "886817c3-981a-4753-8041-1eb409ab214f" },
  { text: "人不患不知人，患不知己。", note: "网络", source: "知乎", uuid: "be3980ec-c9a2-4628-9e9f-93c7055ba3f4" },
  { text: "世界历史的最后一个阶段是它的悲剧。", note: "哲学", source: "马克思", uuid: "ad3c1db5-1e10-441f-9f30-fa5b2bd8d3db" },
  { text: "当黄昏时的光照耀在我的脸颊，我就知道夜晚快要来临了。", note: "原创", source: "朴素", uuid: "66fe1343-a490-4bc8-92bc-5a76448ed8e0" },
  { text: "往后随心而活我不再去将就。", note: "网络", source: "王一佳", uuid: "3c134653-5a5b-435e-8840-47fedd04a88a" },
  { text: "看破了自己才算看破红尘。", note: "原创", source: "珂朵莉诺塔瑟尼欧里斯", uuid: "74a40ed4-bae1-411e-92e5-438c4df1dbf1" },
  { text: "我无法参加你的派对，因为我沉迷在自己的世界。", note: "原创", source: "不朽千秋", uuid: "8152aa82-2d69-4994-8e70-66e8232bbeef" },
  { text: "你总是这样轻言放弃的话，无论多久都只会原地踏步", note: "网络", source: "Qihoo360", uuid: "62c93a12-96ab-454c-9c95-dc937fb40c31" },
  { text: "另一半要去靠大师算命。", note: "网络", source: "道雀Bzz", uuid: "9b07632c-94f9-4f61-84e1-0589aa6eb7bc" },
  { text: "静以制动，明以破军。", note: "原创", source: "朴素", uuid: "46ce206d-7473-4769-a160-ab86516dad21" },
  { text: "君子可寓意于物，但不可留意于物。", note: "网络", source: "网络", uuid: "26a01750-fd36-42a8-a751-d37cbabeaed0" },
  { text: "少几分执着，多一些洒脱。", note: "网络", source: "耳根", uuid: "12086471-46b0-420d-9ae4-4fff1b835ec0" },
  { text: "如果你自认是一位普通人，那么你就错了。", note: "原创", source: "幻空", uuid: "caa9f3a4-9da2-448c-9692-82c0b40b3c41" },
  { text: "学而不厌，诲人不倦。", note: "哲学", source: "孔子", uuid: "7ee7f854-f05b-43cf-85ba-a59bc31831dc" },
  { text: "如果你不能给她穿上嫁衣，请停下脱她衣服的手。", note: "网络", source: "网络", uuid: "9e087493-8c0b-4a2a-816b-6f24fcfe3797" },
  { text: "句号被点下的地方，回声沿时间的墙无数次折返。", note: "原创", source: "auc", uuid: "e9054380-cc71-43b9-b9fa-5c5f34e3b635" },
  { text: "在现实生活中我改变我的生命，在这里我们可以用心创造美好！", note: "原创", source: "小依", uuid: "61c33865-1896-46f5-90e6-86849bc137eb" },
  { text: "夜幽幽，月优优，曲悠悠，吾忧忧。", note: "原创", source: "莽红尘觅知嘤", uuid: "7bf6b650-d79a-4adc-aa1f-31172dca6a71" },
  { text: "无眠之夜黑混沌，她忘点灯昏红阵。", note: "原创", source: "Awoluua_", uuid: "500ff3d9-951f-4c19-9cbd-dd0d01b70d30" },
  { text: "我的生活是彩色的复印机。", note: "原创", source: "云小闲的童话日记", uuid: "6ab73e46-f97b-4ca2-afc3-9e93766099f5" },
  { text: "上签在手，举杯共饮。", note: "网络", source: "kaibo yu.", uuid: "31c9684f-0a64-48b4-9e89-96da9aa4a459" },
  { text: "安时而处顺，哀乐不能入也。", note: "哲学", source: "庄子", uuid: "7a13968e-c467-464d-8ee3-d4a884e3fcef" },
  { text: "慎终如始，则无败事。", note: "哲学", source: "老子", uuid: "88d42006-71a6-425a-8af6-f090af512bb1" },
  { text: "苍天有眼，命数天定，但行好事，莫问前程。", note: "网络", source: "佚名", uuid: "0af53ed2-e7b8-4b79-972a-1ead74c379ed" },
  { text: "当你对自己诚实的时候，世界上就没有人能够欺骗得了你。", note: "网络", source: "网络", uuid: "4ccde4a5-f583-492f-9507-7bb8350b1be8" },
  { text: "痛苦证明你还活着，活着就要战胜痛苦。", note: "原创", source: "黑夜里的桃花", uuid: "49ae1d82-9400-4784-a40d-f54f5ab6c5f1" },
  { text: "时间不会流失，一切的存在将在终点之后。", note: "网络", source: "alirtn", uuid: "217a0ae7-fac4-422c-ab9e-0427a7700ef2" },
  { text: "从未给过我任何帮助，却想让我展翅高飞？", note: "原创", source: "Vikey安凝柠", uuid: "91c22ae2-d21d-4967-850a-d41bc36753f4" },
  { text: "我们执着于寻找对方缺少的品质，真是太傻了。", note: "网络", source: "面纱", uuid: "d05cf3ac-b10a-4dc6-b1c2-6555d14f82a7" },
  { text: "若有來世仍相錯，但願此身不記前。", note: "原创", source: "做魚玉子燒", uuid: "cb3210b5-f2d7-468e-b57f-85041115f3ac" },
  { text: "须知政权是由枪杆子中取得的。", note: "哲学", source: "毛泽东", uuid: "13b4dae9-85ca-4098-bc65-eef57dacfb22" },
  { text: "我把情话刻在高山上，风一吹漫过整个青藏。", note: "网络", source: "自游诗/伊铱", uuid: "294b72f8-8d3d-447e-909f-f87cb6db75e1" },
  { text: "人生充斥着谎言,我又岂能独善其身!", note: "网络", source: "网络", uuid: "9477003b-d477-402d-9b2b-8e8999724f08" },
  { text: "纵然变化，依然故我。", note: "哲学", source: "雅各布·伯努利", uuid: "eb208de6-4c58-451a-a049-57ddb60b120b" },
  { text: "悄悄地想你，波澜不惊。", note: "原创", source: "别云", uuid: "4d33936e-4e2e-4bea-ae25-82574e84d3e7" },
  { text: "人生于我，一场豪赌而已。", note: "哲学", source: "刘慈欣", uuid: "2a9c7d20-af35-4e90-b130-be235ec31c94" },
  { text: "既然等不到青城的日落，那就从朝阳开始。", note: "原创", source: "墨上青锋", uuid: "0cca38a2-d9b9-4a6e-9204-77d0273ea942" },
  { text: "等到功成名就的一天，日月山川都来祝贺。", note: "网络", source: "佚名", uuid: "52e9072f-cfe9-46aa-9f48-063d7a6b628a" },
  { text: "流年似水，載夢入辰。", note: "原创", source: "做魚玉子燒", uuid: "d684e5b0-6344-4e2f-9a5f-b7c65b95d58c" },
  { text: "一点星光，在心上就能反射出太阳。", note: "哲学", source: "学而思", uuid: "a1fb02d7-b454-492d-8834-35e963b4e3a4" },
  { text: "缘起，我在人群中看你；缘灭，我看你在人群中。", note: "网络", source: "佚名", uuid: "79b721fd-a988-4263-a4b6-858ed08ed861" },
  { text: "只念一人，共你白首。", note: "网络", source: "廖羽", uuid: "e1bb03fe-0f45-426e-8aa3-2958fb4a18bf" },
  { text: "明知心中有菩提，却想盼她一个牵挂。", note: "网络", source: "Lamry/戴荃", uuid: "c7b66388-6ab2-4830-a335-e68d07490f72" },
  { text: "只有登上山顶，才能看到那边的风光。", note: "网络", source: "网络", uuid: "bd205366-985d-4a4a-89c3-29097debdb8c" },
  { text: "少年戏本唱到最后一则，故事里的人也昏聩转醒。", note: "网络", source: "千百自渡", uuid: "0e9fd042-ff60-423e-98e9-4cd6127dddab" },
  { text: "合群是平凡的开始，独行是拔尖的开端。", note: "网络", source: "佚名", uuid: "d93c8636-8cbc-43d1-92a4-dfcaf91c1647" },
  { text: "我想去天涯，你却带我去海角。", note: "网络", source: "山有木兮", uuid: "5eb5324d-de94-4077-bb65-b665e7e0cfea" },
  { text: "薄雾依枝残月，参宿舞千帆。", note: "原创", source: "碧水凌涛", uuid: "0c2b3b64-9c56-4d63-b7de-67559818eb34" },
  { text: "背影要显得很高大，才够真实的自己躲在自己的阴影下。", note: "网络", source: "名字平均值就好", uuid: "fd8b0081-62d8-4ac5-82d8-044c773d8a13" },
  { text: "你特殊的遭遇并不是你可以特殊的理由。", note: "原创", source: "CrankAR", uuid: "e157cfdc-fedb-4268-9ff7-b4dba506a92b" },
  { text: "人生而自由，却无往不在枷锁中。", note: "哲学", source: "卢梭", uuid: "1bbed6ba-bf08-43d3-9538-134340f0c526" },
  { text: "有人戳你脊梁，有人爱你荒唐。", note: "原创", source: "与又", uuid: "ec873eda-10b9-4a13-be4f-3bcbfefb11ba" },
  { text: "萧萧玉笛兮孩儿啼，绵绵征军兮终不返。", note: "原创", source: "清巳星嵐", uuid: "30b17b83-1261-4d7b-bdbf-44948d2d466f" },
  { text: "人生啊，一场梦！", note: "原创", source: "mengyj", uuid: "5d32cc97-5938-45de-81c0-e4475e4e3c23" },
  { text: "始终弄不明白，合适和喜欢哪个更重要。", note: "原创", source: "Qicloud", uuid: "cf741332-de25-4e8d-a074-9f6a1c805bfe" },
  { text: "人能够能动地认识世界；人能够能动地改造世界。", note: "哲学", source: "主观能动性", uuid: "130634bb-3a87-4564-8717-54fc014b9592" },
  { text: "故事每天都在发生，每天有人遗忘。", note: "原创", source: "0xh41f", uuid: "271cdb80-df9f-4eeb-be9f-643bf48e3c33" },
  { text: "孤独不是病，习惯了自然会好。", note: "原创", source: "根号菌SAMA", uuid: "4fbdb917-160f-4c6f-aea7-219d5c7522c8" },
  { text: "因为无能为力，所以顺其自然。因为心无所恃，所以随遇而安。", note: "网络", source: "未知", uuid: "aae28604-5146-414d-9ef8-64d25e9459e4" },
  { text: "从长远看，我们都已经死了。", note: "哲学", source: "凯恩斯", uuid: "c5fe8a35-a118-4300-9ab7-bbbeeceae515" },
  { text: "当漆黑一片，当光明灼眼，一样看不见。", note: "原创", source: "抱月", uuid: "f686e683-deae-4515-bcfc-1dcde1923c7f" },
  { text: "我有一个小小的梦在田野飞奔。", note: "网络", source: "我的纸飞机", uuid: "e773d835-ecae-4fd2-bfb0-c0b8cb901ae5" },
  { text: "喜欢下雪，喜欢小猫，喜欢你。", note: "网络", source: "网络", uuid: "c6da0766-0766-4e00-82d5-72c59f651db1" },
  { text: "梦里走了许多路，醒来还是没能走到是非之外...", note: "原创", source: "linkey2011", uuid: "43edc259-ddec-4e15-9dda-1732ff19f7a9" },
  { text: "爵士乐响起之时便是吉翁覆灭之日！", note: "网络", source: "机动战士高达雷霆宙域", uuid: "03c9c019-c546-448a-8921-e18dbf8c930f" },
  { text: "一个人的自身越是丰富，就越难以忍受世俗常规的安排。", note: "哲学", source: "叔本华", uuid: "eb11da1b-26b0-486c-b9fe-f57ae0b35e81" },
  { text: "再多的困难也击不倒一个心中拥有希望之力的男人。", note: "原创", source: "linkey2011", uuid: "22cd79b4-e476-4256-b134-62f95d5a3f2f" },
  { text: "入夜随孤灯等昙花开。", note: "原创", source: "夙鱼", uuid: "95991a54-4628-44a7-ab12-408c29e886db" },
  { text: "本世纪大部分哲学辩论其实在反对辩论。", note: "哲学", source: "肉身的逻各斯 ——赫尔曼•施密茨", uuid: "b621b758-2054-453e-9cd1-5afe68bf04c5" },
  { text: "人，总要为自己的愚蠢选择买单的，不是吗？", note: "原创", source: "上冬十二", uuid: "1be5992f-e39e-4dc8-a83b-9f6b8c7c8864" },
  { text: "花开自有天算尽，风来风去道无情。", note: "原创", source: "宽宽", uuid: "26f36d7a-1c52-4adf-9621-d8c88a6269fa" },
  { text: "不要让美好的回忆成为抹不掉的刀伤。", note: "原创", source: "熟鱼", uuid: "9cd84fba-836e-4a49-b489-fec7c4fae68a" },
  { text: "辉煌时刻不常有，能装多久是多久。", note: "网络", source: "网络评论", uuid: "8073082a-f5cd-4df9-84e3-0d737a53417a" },
  { text: "阳和启蛰，自爱沉稳而后爱人。", note: "网络", source: "网络", uuid: "6deb4d58-9f37-4f2b-a2f0-f4e2dc14ce26" },
  { text: "我想要追着山风去寻一个自由。", note: "网络", source: "王一佳", uuid: "88d287c3-7d6e-486a-9f04-284d2092bcff" },
  { text: "忘却并不是可怕的，而是你不肯。", note: "原创", source: "根号菌SAMA", uuid: "0517343a-62b2-4c9f-b168-6513d9a94ab7" },
  { text: "看看苍茫的天地大梦多悠悠。", note: "网络", source: "山风山风等等我", uuid: "de3a2f67-e1db-4502-84f9-1ff564f47832" },
  { text: "忘了TA以后，我还能忘记什么！", note: "原创", source: "墓封影", uuid: "46e10f2a-b748-417b-96dc-41c1da400e88" },
  { text: "久处于夜里；初知那微光，认为似光明。", note: "原创", source: "朴素", uuid: "01361b53-cee9-46c3-9a0b-cf008807c676" },
  { text: "愿用余生换半城烟雨，半城繁花。", note: "原创", source: "乱世流年", uuid: "7e57c392-3861-4fa7-bae9-1501653461b3" },
  { text: "生活百般滋味，人生需要笑对。", note: "哲学", source: "佚名", uuid: "a8cbf7b7-c28f-4f6f-9475-7ac3236bd482" },
  { text: "你就是盛开着的，漫山遍野的温柔。", note: "网络", source: "佚名", uuid: "e39d04ba-5cc1-4c36-a9e7-bf00737f43a4" },
  { text: "小说大多是虚构的，却又有生活的影子。", note: "原创", source: "鱼", uuid: "364709a0-dc88-4b63-b8b5-caeaaa0d748d" },
  { text: "幸福，就是找一个温暖的人过一辈子，然后一辈子都是温暖的。", note: "网络", source: "佚名", uuid: "51a8055e-df64-47f9-bf78-d1775a566374" },
  { text: "给自己画条线，给他人也画条线。", note: "原创", source: "三分钟", uuid: "c29f8fe1-d12a-4e0a-8c84-18644db6c2c9" },
  { text: "在哪里跌倒，就在那里睡一觉。", note: "网络", source: "不详", uuid: "2a8b1265-76cc-4186-9208-837c101fab33" },
  { text: "宇宙热寂是时间的自杀，留下了自己无意义的尸体。", note: "原创", source: "auc", uuid: "0f86c632-1f7b-46c0-8a44-bc4356284958" },
  { text: "春华是秋实模特，掩饰过的延伸向海。", note: "网络", source: "30年前，50年后", uuid: "12a63c4b-3715-4547-a60f-e662f43813cd" },
  { text: "有时候，幸福不是越多越好，而是要恰到好处。", note: "原创", source: "雅", uuid: "4beb4192-7e1e-457c-9e5b-622b5ebd12d1" },
  { text: "日高悬风拂面留下丝丝温暖，别辜负眼前季节。", note: "网络", source: "花晶晶", uuid: "c45f7844-1626-4cc9-aa13-c1401117503b" },
  { text: "这一路纵使有千沟万壑，也挡不住浪子傲视天涯的心。", note: "原创", source: "Hacker", uuid: "7a38e4db-35de-41e0-876a-7234b7f79a49" },
  { text: "春秋更迭几时辰，昏沉，未拭酒痕。", note: "网络", source: "楼玉明只是路过", uuid: "e3ff6c00-5b9a-42d1-8a32-86717f0d834f" },
  { text: "我的灵魂患上了孤独症，唯有在你的陪伴中才能感到完整。", note: "网络", source: "网络", uuid: "51dae9a7-d7b9-4c58-9f03-c73d4e6d52b0" },
  { text: "为自己当初的誓言而努力！", note: "原创", source: "疯人", uuid: "31a34841-74af-476b-91ed-25b811df1669" },
  { text: "纸飞机快飞吧，快乐方法并不复杂。", note: "网络", source: "小寒", uuid: "29384e3b-91c2-4303-a354-1d6e1ba28a2c" },
  { text: "曾经是意中人，现在是忆中人。", note: "网络", source: "佚名", uuid: "2c2a30e6-0a14-48d9-b647-3e35037f0366" },
  { text: "万般皆苦，唯有自渡。", note: "网络", source: "清风", uuid: "58cd51de-4314-45cc-9bc0-7dbacfda34dd" },
  { text: "无为而无不为，以不变应万变。", note: "原创", source: "SquareBlock", uuid: "ca22ecd0-89f8-43bd-a8fc-ab127236c46f" },
  { text: "每个细节只需要再好一点点，最终结果将会更加完美。", note: "原创", source: "再好一点点", uuid: "b81bc4a3-53d6-4379-a34a-5b51309f4aae" },
  { text: "在东北挺好的，但是很快秋天就要来了，再不走就冷了。", note: "网络", source: "流浪贴吧老哥", uuid: "4fd0ce14-939c-4b83-a917-8e930307433f" },
  { text: "大笑三声回首望，并无风雨更无人。", note: "原创", source: "本人", uuid: "95c95112-b5cc-4702-829e-b4754fbeaeb7" },
  { text: "还有多少个明天可以浪费，还有多少个夜晚可以忏悔。", note: "网络", source: "网络", uuid: "5a95ba6a-1703-4b6c-8a9d-680ae7b4d1d1" },
  { text: "人生如戏，万事皆空；昔日不在，神话已逝。", note: "原创", source: "lrs2187", uuid: "53da2d36-bc65-4fca-94ab-4f8b58042580" },
  { text: "梦觉几更山水几程。", note: "网络", source: "楼玉明只是路过", uuid: "6a404911-3221-4897-a452-61e12a8c7102" },
  { text: "城市用灯光点缀繁华，乡村用星空装饰梦想。", note: "原创", source: "小狼", uuid: "64878418-24f0-4a66-8381-d03d4a292c2d" },
  { text: "幸福就是当我望向你时，发现你满眼尽是我。", note: "原创", source: "王佩", uuid: "ab1cf6e0-01d9-4491-b96f-4026e7211a1a" },
  { text: "往昔红颜梦，今朝朦胧泪。", note: "网络", source: "耳根", uuid: "f01138bc-c285-4d08-be41-77de46e04890" },
  { text: "旧时轻寒友，醉与梦沙舟。月寒苦夜短，终岁望南洲。", note: "原创", source: "月雩", uuid: "ca64886a-49f2-40f4-96b1-b7ae776c80a4" },
  { text: "未知，迷茫，沉默，孤独，恐惧，堕落。值得吗？", note: "原创", source: "沫夏孤水", uuid: "ad63ff0a-1c64-48dc-b4ce-c76b537f5567" },
  { text: "穿破迷雾，探寻真相。", note: "原创", source: "浮世之旅者", uuid: "da6a1a37-a541-47ca-97cb-872086841702" },
  { text: "人们总是希望付出最少的，获得最好的。", note: "原创", source: "清巳星嵐", uuid: "68cdddce-033b-41c7-be55-a56c3b956474" },
  { text: "见死不救的不一定是恶人，救死扶伤的不一定是好人。", note: "原创", source: "某个Dr.", uuid: "c8eeaa0b-78a5-4536-90cb-454ade34763f" },
  { text: "没有汗水浇灌的未来，又能见沿途灿烂的花？", note: "原创", source: "shazi_awa", uuid: "0ab39940-19ea-45ba-840b-c349ce1c0dce" },
  { text: "可是爱怎么能靠旁人判定。", note: "网络", source: "道雀Bzz", uuid: "c54ddeb2-4039-4bbb-808e-6652695ff5f8" },
  { text: "不要任凭时光这样飞逝，不要等到失去才知道后悔当时。", note: "原创", source: "蓝罗", uuid: "1d50cc14-ac4c-4b81-8f2e-324b6b9738c1" },
  { text: "无关紧要，就没有必要！", note: "原创", source: "榆木理", uuid: "4c72d0c9-9f48-4a25-9476-79a1963820a0" },
  { text: "每个点发出的射线能相交就是一件不可思议的事。", note: "网络", source: "网络", uuid: "a14c6310-59b3-4056-96ce-b5db9245d7a9" },
  { text: "就算下雨也没关系，总会停下来。", note: "网络", source: "鹦鹉芝芝", uuid: "8e31fc5d-c395-4bbe-b4db-044ddee68fed" },
  { text: "运伟大之思者，必行伟大之迷途。", note: "哲学", source: "海德格尔", uuid: "e6bab0f3-0996-4831-a77f-0e092b0ec3b6" },
  { text: "与回忆缠绕枷锁，同那朵鲜花凋落。", note: "网络", source: "三七", uuid: "2d45745a-d060-4655-b342-291bacc59f30" },
  { text: "当我原谅世界，拥抱世界，我就获得了赦免。", note: "原创", source: "苏菲", uuid: "d7fb5cac-a7ce-4855-814f-2275405c1d8b" },
  { text: "远方未必远，未来一定来。", note: "网络", source: "网络", uuid: "90948bf0-03cd-4c09-a8cd-4fc6d9b8d9c1" },
  { text: "胸中有丘壑，立马镇山河。", note: "网络", source: "热血", uuid: "febebf41-6b08-4d81-ad73-23dd9b4f6365" },
  { text: "纸皱了就抚不平了。", note: "原创", source: "小孟科技", uuid: "5ace470b-ca90-46fb-9014-d1483fbc28b6" },
  { text: "夜悠悠几度秋，只落得人消瘦。", note: "网络", source: "蓝乐", uuid: "2b71ee70-64a9-4a55-b29a-5828033c2e57" },
  { text: "命运的绑架没有救赎，你我皆是上帝的囚徒。", note: "原创", source: "BISHOP", uuid: "a84b32a4-8623-4a84-86d7-a3cb1717368d" },
  { text: "找回当年的朋友吧，风雨再兼程。", note: "网络", source: "我的纸飞机", uuid: "647efa63-1429-4861-bcba-db7633046bc2" },
  { text: "生命永无止境，浪漫至死不渝。", note: "原创", source: "清风不语", uuid: "7e3a47c4-ff9e-43fd-9fab-6a33c072933a" },
  { text: "一个人，一个人，一个人，不是不想交朋友，而是懒。", note: "原创", source: "年轻人的颓丧", uuid: "f7349f36-0616-4bb8-afab-8e472290fc33" },
  { text: "把温柔和心软留给值得的人。", note: "网络", source: "网络", uuid: "276a8f6b-326a-4e66-80a7-46b307951525" },
  { text: "我可曾是你情感寄托？", note: "网络", source: "廖伟志", uuid: "70e8aa83-e82d-4694-8a60-a4503eb714a1" },
  { text: "地球上的任何一点离太阳都同样地遥远。", note: "哲学", source: "伯顿", uuid: "ab75a1f3-029e-40de-a7f8-dc9d78e83108" },
  { text: "我的另一个灵魂正在离家出走。", note: "原创", source: "九幽之下", uuid: "e6dfb3c6-6f08-469b-a127-7412e6ea84ba" },
  { text: "每天這麼累，人是背負了什麼才這樣步履維艱。", note: "原创", source: "做魚玉子燒", uuid: "3a6d6af1-ddb6-41e1-8319-02075e034925" },
  { text: "我舍不得喝水。", note: "网络", source: "吴易纬", uuid: "4af66827-a643-4297-a3eb-719d026b13ac" },
  { text: "在某种意义上说即令这世界全不存在，音乐却还存在。", note: "哲学", source: "叔本华", uuid: "02678ac4-7a7e-42e1-bf92-a88dea5e37ae" },
  { text: "有一个捉迷藏社团，他们团长现在还没找到。", note: "网络", source: "网络", uuid: "28300930-1165-4b8d-b48c-07858ae394b7" },
  { text: "抱竹辞旧岁，好运滚滚来！", note: "网络", source: "网络", uuid: "0a2bcbba-a453-4b4b-8f73-31a1424a8ab3" },
  { text: "事实证明，阿德巴约和李思有着密不可分的关系。", note: "原创", source: "蜥蜴", uuid: "43ba0082-9b73-481b-a524-6d3d95c32c78" },
  { text: "从不犯错误的人终将一事无成", note: "网络", source: "来自网络", uuid: "605120be-7876-4360-86d4-c99dc265ed94" },
  { text: "世界美好与莫环环相扣。", note: "网络", source: "网络", uuid: "c92e2e2c-393f-4fad-b318-f4ae1e59faee" },
  { text: "机场永远等不到船，就像我永远等不到你。", note: "网络", source: "某网友", uuid: "9357e70b-7c00-4d7f-9d60-85c5c2da906c" },
  { text: "感觉的力量教导你如何通过责任感将生命提升到另一个层次。", note: "原创", source: "尼希亚南达", uuid: "83f9b71e-6f6f-4619-a87e-8163cf5ea03b" },
  { text: "我好累啊，我终于变成了自己当初最讨厌的样子。", note: "网络", source: "华子我想你", uuid: "28ec0a85-c647-459e-9f16-7c4778c44e74" },
  { text: "所以，谎话总说得幽默，真希望你肯改过。", note: "网络", source: "三七", uuid: "be953555-ceae-4a6c-860e-ff987e0d43a2" },
  { text: "一个人的思想等于一个人的素养。", note: "原创", source: "朴素", uuid: "55feafa7-e693-498d-b4d5-5c16677f0918" },
  { text: "常饮黄昏伴酒歌，今见晨霞送归客。", note: "原创", source: "雪彻", uuid: "2a1d8363-17d0-48d6-8294-de2fe81d2926" },
  { text: "也许我们都没有长大，只是世界变小了。", note: "原创", source: "cukecora", uuid: "d5a24e2f-4961-42fd-9d9b-d0edcd08e970" },
  { text: "月影积陈春秋，垣壁剥落冬夏。", note: "网络", source: "小红书", uuid: "cbdc2dd6-07c2-4e27-a698-283d712640b4" },
  { text: "群雁千山过，孤帆一叶生。", note: "原创", source: "碧水凌涛", uuid: "1c4ca91b-ad5e-492c-bc94-4f52f4d1b194" },
  { text: "天命碧城灰土，刀弓褐锈。", note: "网络", source: "春秋肠の小曲", uuid: "3471ba72-1cdd-4f0b-ba2a-f35f2152b99e" },
  { text: "爱欲于人，犹如执炬，逆风而行，必有烧手之患。", note: "哲学", source: "四十二章经", uuid: "55c9ce9a-58fb-4fd7-9ba7-e81202b353e3" },
  { text: "有些路很远，走下去会很累。可是，不走，会后悔。", note: "网络", source: "晓良", uuid: "157d3021-4d95-4152-98b2-7727bf528787" },
  { text: "为你离开预热，留我一个品尝苦果。", note: "网络", source: "三七", uuid: "1b7ef99f-0bb3-4c13-bf15-49bc96c660ef" },
  { text: "让时间过吧，经不起考验的情谊——弃之可惜，留之无味！", note: "原创", source: "Shawn", uuid: "bf7f01c4-07d2-422a-a8a4-b5f41c9cbdfa" },
  { text: "你外套味道还没散，假装你还在身旁。", note: "网络", source: "应晓璃", uuid: "67b9c9e6-c795-478a-ad2d-9b777125b3ec" },
  { text: "我做到了，你也一定要说话算话。", note: "原创", source: "茉莉雨", uuid: "655b8f11-d1ee-403f-8014-b30b49337c44" },
  { text: "如果每个人都能理解你，那么你得普通成什么样子。", note: "原创", source: "失忆北岛.", uuid: "123e1448-5c7a-4958-a2e3-f7614bb2d128" },
  { text: "被伤太多就变懦弱，你却还要掠夺。", note: "网络", source: "三七", uuid: "c51166ca-812c-4c9b-ac59-d7221a3b1fc8" },
  { text: "单机游戏打多了就会没有朋友，联机游戏打多了就会拥有敌人。", note: "网络", source: "Lukhudel", uuid: "2a1bae00-247d-47df-88f4-835b28aeb082" },
  { text: "总有人间一两风，填我十万八千梦。", note: "原创", source: "无心", uuid: "d2dbb960-7ffe-495c-b8dc-f8a4c5dd0125" },
  { text: "愿今生常相守不负这段深情。", note: "网络", source: "岁月如笔写春秋", uuid: "1717a6b9-32da-4add-9590-cba7f90396c9" },
  { text: "等待是灯火阑珊，蓦然回首是你。", note: "原创", source: "张凯森", uuid: "23b63b5c-72f9-428a-aaad-d81dca2c241b" },
  { text: "脚步声的急促是我想见你的预示。", note: "原创", source: "Zlemon", uuid: "ac2f4dde-be27-4ccd-9ac1-e510b19cdbd1" },
  { text: "不以为然的存在，细品起来会得到意想不到的有趣。", note: "原创", source: "朴素", uuid: "cb4109d5-c8e8-40ce-93b0-2c7cdf2ae127" },
  { text: "在平凡岁月里细数风风雨雨，最想感谢的那个人还是你。", note: "网络", source: "路小可", uuid: "a65fd967-271e-42a1-8e1d-c05d463ee583" },
  { text: "勇气就是明知会受伤，却还要这样做，愚蠢也是如此。", note: "原创", source: "凡ICE", uuid: "cd6879b1-3338-40c0-a583-61eb9eff9ff6" },
  { text: "人生总有起落，精神终可继承。", note: "网络", source: "网络", uuid: "cea9d88c-37c2-4dbd-874e-a3124ff1bbbb" },
  { text: "可它为什么不记得。", note: "网络", source: "30年前，50年后", uuid: "895bee9c-b0ed-40cb-aeae-e256a38f6c9e" },
  { text: "却话往昔，不觉泪落，但看燕天飞，晚霞粉片天！", note: "原创", source: "storm1614", uuid: "2966df03-3282-4804-ae4c-e6fec9e02002" },
  { text: "三万年的距离，也不及你我的爱河。", note: "网络", source: "无名", uuid: "d3ebe14d-f45a-4f81-bef8-f0a566f5fd60" },
  { text: "野蛮人之间人吃人，文明人之间人骗人。", note: "哲学", source: "叔本华", uuid: "5d5523d1-e586-42dd-9b7a-faf4571d1090" },
  { text: "不是天才，就要慎独。", note: "网络", source: "皎月半洒花", uuid: "b8bbc457-d6f3-4fed-be62-09bb81cbaa8b" },
  { text: "就在自己的小世界里，做一个快乐的小神仙。", note: "原创", source: "菲.lin", uuid: "c3b742c3-f1e4-48e9-b4cc-00489646fda2" },
  { text: "满天繁星思绪起，一言一诺只为你。", note: "原创", source: "fine", uuid: "86380b6d-fccb-4cff-9f5c-5350a98b09cd" },
  { text: "死在遗忘的沙丘，直到忘记你，想要忘掉一个人，只能想起你。", note: "原创", source: "双十", uuid: "760b74b7-87ef-4d65-a6f7-c737ac70144a" },
  { text: "人生路漫长度，江河东流不息。", note: "原创", source: "江上悦峰", uuid: "0ea4322d-94ad-4209-8b4a-0d825a2bfc06" },
  { text: "我守着时光沉静的安宁。", note: "网络", source: "岁月如笔写春秋", uuid: "0299909e-446c-4028-b95f-faaa8672c5ee" },
  { text: "念极生死定其无天，破尽黑白临天行道。", note: "原创", source: "朴素", uuid: "c8f17732-8d1b-4c0c-9061-1fbb7ae344b4" },
  { text: "遗忘比绝望更强有力。", note: "哲学", source: "叔本华", uuid: "8c874b63-bff2-4392-9308-587f35f4f9fa" },
  { text: "做好事不求回报，但也不要让自己吃亏！", note: "网络", source: "网络", uuid: "7f6931c1-af6f-4874-912c-cf52c078ee9d" },
  { text: "我只是卖伞的人，不想做慈悲的神。", note: "原创", source: "宽宽", uuid: "5741dc3b-d2a6-4e7b-95c5-36a5f39d8fab" },
  { text: "纱雾拨尽青天启，和泉响彻白日出。", note: "网络", source: "佚名", uuid: "1c7e36e9-08cf-453c-8a79-0a5cc60a7896" },
  { text: "殷勤命笔排字阵。", note: "网络", source: "楼玉明只是路过", uuid: "43e6b37d-e0da-4c95-99e9-b07597fec768" },
  { text: "每次对一个人很好，最后换来的不过是自己身价的卑微。", note: "原创", source: "以沫", uuid: "7b0fd33f-0564-40c5-b0b4-a8c070220165" },
  { text: "腰斩自己100次。", note: "原创", source: "李斯", uuid: "80a151e0-c976-4ab3-aa83-323288007a87" },
  { text: "国家是阶级矛盾不可调和的产物和表现。", note: "哲学", source: "弗拉基米尔·伊里奇·列宁", uuid: "f7c54aa8-251d-40df-90d5-43e45f9564c5" },
  { text: "如果赶不上日出高光，也错过落日余晖，请记得还有漫天星辰。", note: "网络", source: "网络", uuid: "00478de2-94ea-4baf-bb54-d6f583505501" },
  { text: "我从不害怕失去什么，人生就是失去与努力取得的一段经历。", note: "原创", source: "ajhuhe", uuid: "72a90397-549c-4f8b-921d-8b7800262da5" },
  { text: "不要企图窥探我的生活，你能看到的，都是我希望让你看到的。", note: "原创", source: "原创", uuid: "b039fc01-8fa1-4656-a1c2-c8dfa09309aa" },
  { text: "体谅别人谁又懂我的难受。", note: "网络", source: "王健美", uuid: "2df82bb4-634f-4f09-a0ee-c65781206b3c" },
  { text: "我不是在等你喜欢我，我是在等自己不喜欢你。", note: "网络", source: "佚名", uuid: "1bc908e7-c8f4-4f67-8e53-f4a666002366" },
  { text: "如果你能在浪费时间中获得乐趣，就不算浪费时间。", note: "哲学", source: "罗素", uuid: "f0108c24-57ae-423b-937b-075fd13078e5" },
  { text: "洒一地斑驳阳光穿过新叶，心事空流转思念渐渐倾斜。", note: "网络", source: "花晶晶", uuid: "cd02f85c-31d0-40b0-b58c-7e22d1fb186f" },
  { text: "生命的意义在于生命本身。", note: "原创", source: "Cindy_Li", uuid: "6864dfdc-16ae-4aab-8817-9c9813523d3c" },
  { text: "所以蜡烛少点，人天真点，有事也并不是什么坏事。", note: "网络", source: "北星", uuid: "004609de-9466-4b6f-ad0f-864a733af27e" },
  { text: "生为人杰，死亦鬼雄，我辈修士，何惜一战！", note: "网络", source: "耳根", uuid: "ad1c0589-f957-48ee-a765-3f034eb1d91d" },
  { text: "一天很短，开心了就笑，不开心了就过会儿再笑。", note: "网络", source: "读者", uuid: "4ec80364-4b3a-4d81-8f68-376b3161e1fb" },
  { text: "天际沉月影，风兮万花行。漫卷大荒乱，苍冥守空寻。", note: "原创", source: "月雩", uuid: "8926b203-5ff6-4c3d-b91b-7d92644418b9" },
  { text: "年愁今夜未到乡，卧思可哀笑南梁。", note: "网络", source: "蜥蜴人", uuid: "174c24da-618f-41c3-a0b1-3bcc1a18fb72" },
  { text: "我只是太想要份爱，我只是太想被好好对待。", note: "网络", source: "万物终归", uuid: "21c5250b-8778-492e-8d68-9d5d7946100c" },
  { text: "想不完的思念，道不尽的话。", note: "原创", source: "陈树凤", uuid: "f28d0d0b-21db-4bfc-abb3-9ee7ec680ae4" },
  { text: "自己永远是孤单的，但你可以让其他人变得不孤单。", note: "原创", source: "Rokileng", uuid: "cd11e7e1-45cd-4852-9064-1da5b67aad79" },
  { text: "偏我来时不逢春，恰无一人再似我。", note: "网络", source: "网络", uuid: "2cf08347-6c2e-4397-980c-ccaca4de726f" },
  { text: "我们绝对不会坐以待毙，即便冬日的阳光也能温暖如春。", note: "原创", source: "paper", uuid: "40119df8-4d9f-4b60-a694-242b88e6a636" },
  { text: "故事都会结束，只是有人欢喜有人忧。", note: "原创", source: "qianhuiya", uuid: "bfee1b54-86fc-4cfb-b8e7-92f30c81513a" },
  { text: "当愚昧成为潮流，清醒便是原罪。", note: "网络", source: "佚名", uuid: "5d537666-5295-4575-bdf5-3c7766fe06c9" },
  { text: "与其在家颓废，还不如多出去干点善事。", note: "原创", source: "哲理", uuid: "1aa70b1e-6cf0-4292-80b0-d79f39048f26" },
  { text: "一生知己最难求，相逢本是百年修。", note: "网络", source: "日月同辉", uuid: "a2be0810-a0ec-4df1-b2c4-cd1cff397ee9" },
  { text: "彼岸花花开彼岸，断肠草草断肝肠。", note: "原创", source: "MXLBS", uuid: "8d48c8bd-4996-49a2-9751-19f67ef5cef5" },
  { text: "在人山人海的无数漠然之中，拥有这一份感动。", note: "原创", source: "一只叫一行的喵", uuid: "8ca14fba-fc68-4557-a3b4-26cb340ec863" },
  { text: "梦想脱胎于现实，现实由梦想所化。", note: "原创", source: "寸惑", uuid: "e28093f9-86ae-45de-aef8-85797b4310a7" },
  { text: "抛开情侣的身份，你是我这一生遇见的最不可多得的挚友。", note: "原创", source: "nDhnzr6r", uuid: "72e2cd3b-f2c3-41bb-8e80-dfcec2d060ef" },
  { text: "让时钟就此冰冻，让我们在无尽的时光里紧紧相拥。", note: "原创", source: "一只叫一行的喵", uuid: "2fdfb572-689d-4461-8727-a0b11b2ed29f" },
  { text: "我想与你共度余生，但不是现在。", note: "原创", source: "nDhnzr6r", uuid: "04e516e9-653b-4f83-ada0-5c31975b81e5" },
  { text: "这世界上没有坏女人和坏男人只有喜欢你的人和不喜欢你的人。", note: "网络", source: "童锦程", uuid: "07ef5e98-d8ba-40c3-ae33-1a0044b28714" },
  { text: "梦想是远方的太阳，虽远却充满光芒。", note: "网络", source: "谷爱凌", uuid: "c98bec31-f4e0-4926-965a-6951038a6f37" },
  { text: "闲来静赏花满枝，泪落半纸染新词。", note: "原创", source: "荒眸", uuid: "ced83c06-78f2-471b-b146-73b8527d857f" },
  { text: "那时我们穷得只有时间，却富得像拥有永恒。", note: "原创", source: "神", uuid: "dc379028-31ba-46bb-bb6b-afd1dc67ac89" },
  { text: "雲深不問歸途路，誰解紅塵一念煎。", note: "原创", source: "做魚玉子燒", uuid: "c2b6f25b-d135-43c9-a3fd-6141b4392a57" },
  { text: "我怎么能倒下，我身后空无一人。", note: "原创", source: "hasty", uuid: "f886c07d-e042-448b-bd95-a2a2e91f3780" },
  { text: "事实上，你在所有地方都死了，除去某一处小小所在（这里）。", note: "哲学", source: "侯世达", uuid: "0dbf7d1f-1eb0-40dd-b32a-5911f1bcddf2" },
  { text: "爱情走了，心也碎了，只剩下无尽的思念。", note: "原创", source: "呜哩亚绅", uuid: "f1190daa-c06d-429b-a383-5dceb80b7687" },
  { text: "今天地铁上明显少了很多人。", note: "网络", source: "网易云音乐热评", uuid: "556249ce-eb11-48ee-b294-a6805f90ef7a" },
  { text: "行远自迩，登高自卑。", note: "哲学", source: "戴圣", uuid: "969506ed-37d7-4231-9f8c-055b88a7a3d4" },
  { text: "为文以明心载道，为文以陶冶情操。", note: "原创", source: "碧水凌涛", uuid: "35e77dcb-1e9f-4e00-91f9-e7d9bcf2be92" },
  { text: "时间是件无价的易耗品，不管你愿不愿意，它总是被消耗着。", note: "网络", source: "佚名", uuid: "0981b82b-c90a-4419-ac7d-75f3871a95bb" },
  { text: "对于你是解脱，而我如此落魄。", note: "网络", source: "三七", uuid: "8f66fecb-f72a-403f-b395-d0a8908ed6de" },
  { text: "好好爱自己，才是终生浪漫的开始。", note: "原创", source: "Nick", uuid: "78467ee5-1dea-4be0-967d-8dd1a0f62c2d" },
  { text: "周围的人漏出慌张的神情。", note: "网络", source: "道雀Bzz", uuid: "546ae088-4f77-44d6-9293-a8165161ea25" },
  { text: "人生的旷野不是轨道，我有权利拒绝任何一种解法。", note: "网络", source: "摸鱼事务所", uuid: "0e7b569b-4d19-4900-bf00-b4292882e6c2" },
  { text: "多去看看世界，多去读读有用的书，少理那些没用的感情。", note: "网络", source: "佚名", uuid: "8e340565-625f-4c97-ac4b-b716eef5cf0c" },
  { text: "宇宙有限，思想无限。", note: "原创", source: "纳兰音韵", uuid: "3d4a47cc-c892-4ae2-8a7d-88b87f1eda59" },
  { text: "你别见怪，我不会先离开。", note: "网络", source: "徐重来", uuid: "2037a6ee-736a-436f-8a64-f43c04d6dfc0" },
  { text: "后退一步，为的是前进两步。", note: "哲学", source: "列宁", uuid: "58367241-65b5-4d3e-b272-286d986ac5ba" },
  { text: "梦想还是要有的，万一见鬼了呢？", note: "网络", source: "网络", uuid: "6d5ff9e6-87a4-4a83-81cc-13751c0482f2" },
  { text: "如果你瞄准月亮，即便迷失也只是落在星河之间。", note: "网络", source: "网络", uuid: "45789ceb-bd87-4429-b26f-e88befdea129" },
  { text: "表象不会说谎，可表象也不是真相。", note: "网络", source: "angsaide", uuid: "df149217-c6df-40b4-80a7-481739bada68" },
  { text: "承诺常常很像蝴蝶，美丽的盘旋后就不见了。", note: "网络", source: "网络", uuid: "cd032bc0-fd45-45f3-b0c7-4eca68e2b5b4" },
  { text: "如果爱，请深爱，如不爱，请离开", note: "网络", source: "Qihoo360", uuid: "815e62cc-1072-4c3b-b3a6-b06ea25f89b2" },
  { text: "心血来潮的时候，总会有那么几人要顿悟的。", note: "原创", source: "朴素", uuid: "d70082b5-8874-4911-8c4f-337de9550106" },
  { text: "一切终归虚无，唯有过程能留下沧海一粟。", note: "原创", source: "创作中的lamb", uuid: "60ea1238-f29a-469f-a045-10c72aff15c4" },
  { text: "世界上最美丽的就是世界本身", note: "网络", source: "Qihoo360", uuid: "6c3089f1-1c8a-4e0d-a6e4-b010e3b41b6b" },
  { text: "每天都是绝版。", note: "原创", source: "鱼", uuid: "3ed86f37-3ada-4377-af95-e3c5630d7ebd" },
  { text: "鱼与熊掌不可兼得，唯独穷和单身可以", note: "网络", source: "皮皮虾", uuid: "4c592612-3454-47ab-9b97-f52169806fb5" },
  { text: "保持好迎接强者的心态，才是初心", note: "网络", source: "syc", uuid: "e6697a88-4cf3-4f32-bc39-5efd9717ec52" },
  { text: "纸上留他眉眼淡，良人十载散。", note: "网络", source: "郑明河", uuid: "1973a395-b696-4262-b9db-1a87a873c40f" },
  { text: "装作拥有某样品质，实际上就等于承认了自己并没有这样品质。", note: "哲学", source: "叔本华", uuid: "e689f682-5334-474b-8be6-8911407a6bf9" },
  { text: "阳光洒落，冰冷的眼中，澄澈入海却依旧向往自由。", note: "原创", source: "白颜yaku", uuid: "8bcad583-da3c-438b-b7e4-581bfe7e06d3" },
  { text: "生命太短，一秒钟都不留给让人不快的家伙。", note: "网络", source: "网络", uuid: "12308e01-1a83-4c5f-a71e-53c2a59108ac" },
  { text: "生活原本沉闷，但跑起来就会有风。", note: "原创", source: "北省", uuid: "21b22a64-8154-4996-ba49-bd1efdbdcc8f" },
  { text: "一年来一次的人和一年开一次的樱花默默签下了契约。", note: "原创", source: "CuSO4", uuid: "50abcb6d-980e-4e7f-811f-a1b61e870463" },
  { text: "戒除欲望，控制行为，充实生活，美好的世界。", note: "原创", source: "yuanziyu", uuid: "31c4753d-4e73-4668-ab3d-6dbdf79ea013" },
  { text: "你不努力，你得到的一切一定会被夺走！", note: "原创", source: "Posherlunch", uuid: "92d84ee6-d17c-4137-8ca3-d95e56bc770e" },
  { text: "高中的万众内卷景观本身内含一种溃不成军的沉默与孤独。", note: "原创", source: "Iking", uuid: "da6e02f5-375a-451d-bac6-f0747f6faf39" },
  { text: "嘴里塞满无知的梦想，醉了就吐一地闪光。", note: "网络", source: "快乐放屁小狗", uuid: "339fd812-ea41-4db6-b842-33bc24a066c5" },
  { text: "祝愿每日会有太阳为你升起，把你当做诗的最后一行。", note: "原创", source: "双十", uuid: "45be5a61-87fa-47bb-8fcf-a895db80e534" },
  { text: "失约梦几更颠倒梦一程。", note: "网络", source: "楼玉明只是路过", uuid: "ef7e6899-decc-483b-a76f-424f73079f5e" },
  { text: "斯人若彩虹，遇上方知有。", note: "网络", source: "怦然心动", uuid: "5a8f8c81-1f15-440d-b635-8ce04fa7a1f1" },
  { text: "镜中花偷窥着笼中鸟。", note: "原创", source: "美波七海", uuid: "08581213-da61-400e-9677-1f2173a67184" },
  { text: "终日困城中我望着远处高楼。", note: "网络", source: "王一佳", uuid: "39bad1f8-8de7-4f2f-b8b5-c0583a2f2284" },
  { text: "若问情根深几许，朝朝暮暮共白头。", note: "网络", source: "日月同辉", uuid: "3efbb302-cb1a-412b-962c-ab3484d371d6" },
  { text: "愿每一个人都能遇到自己爱的人与爱自己的人。", note: "网络", source: "曲念笙", uuid: "9d242495-1082-4bf8-9a45-90f833b1f24b" },
  { text: "自信起来，你能做到任何事。", note: "原创", source: "HONTARG", uuid: "38f2e90f-8125-43a8-b1fe-b94e98578bdc" },
  { text: "无论怎么坚持，我都可能失败。无论怎么失败，我都始终坚持。", note: "网络", source: "网络", uuid: "68216220-8b49-4f1e-900e-74e45f123a40" },
  { text: "没出口的话，你懂我，一定是喜欢。", note: "网络", source: "徐重来", uuid: "b37473b8-7fdd-4d8d-ad18-cd6149c8bafe" },
  { text: "一场秋雨一场凉，秋心酌满泪为霜。", note: "原创", source: "夙鱼", uuid: "d02b66ae-61d5-4b0c-a307-0bc1cc1eb8e7" },
  { text: "你是我的，那是曾经。我是你的，直到现在。", note: "原创", source: "时静", uuid: "875ba7b3-7469-4c4d-ba69-0668a20cd88a" },
  { text: "風撫柳意尋情解，誓做空言未了塵。", note: "原创", source: "做魚玉子燒", uuid: "ed98b9ab-217a-4dc0-96d4-a112f175c9fc" },
  { text: "尼古丁的绑架没有救赎，你我都是上瘾的赌徒。", note: "网络", source: "网友", uuid: "69d02475-d6a4-40e2-ba3c-5ba00f3b8bb8" },
  { text: "如果你热爱生活就不要浪费时间，因为时间组成了生活。", note: "原创", source: "joah", uuid: "51df2309-7c89-40e0-a01b-fd766e215ef2" },
  { text: "有些东西，你说不出它哪里好，但就是怎么也忘不了。", note: "网络", source: "网络", uuid: "7bc819a3-97b4-4553-a6d3-94303834e8dd" },
  { text: "奋斗的目标就是为了躺平，就是为了过上不被闹钟叫醒的日子。", note: "哲学", source: "余华", uuid: "b32c61c7-8452-4652-90e0-0604794a5ecd" },
  { text: "说你是人，却过完牛的一生。", note: "原创", source: "致明", uuid: "2e98fe35-e10a-43b8-b8af-65bc0d519698" },
  { text: "你余生未来可以都交给我保管。", note: "网络", source: "徐重来", uuid: "71a28218-8af4-4b2e-973b-056548dc888b" },
  { text: "世界不需要你去了解，因为你永远也看不透。", note: "原创", source: "归属", uuid: "76f05a93-1e7c-4631-aa26-b7fe64280571" },
  { text: "我在出差的高铁上晒着太阳，装作出门旅行的模样。", note: "原创", source: "T&Z", uuid: "158034d8-9eb7-48a3-98e0-fb472a0f2b41" },
  { text: "人之初，性虽善，后天之善恶，乃个人之选择。", note: "原创", source: "御坂美琴", uuid: "a521e441-3f1b-4cc7-ad67-e4a74618ff12" },
  { text: "我想，当风吹过的时候，我可以拥抱这个世界。", note: "原创", source: "落雨成声", uuid: "fe2389c3-e628-480a-87fa-d2cd41d4cc86" },
  { text: "生命如同寓言，其价值不在于长短，而在于内容。", note: "哲学", source: "塞涅卡", uuid: "d84dcc1e-2789-4d67-a371-576f46671c41" },
  { text: "星辰浩瀚，人生暗淡。", note: "原创", source: "jason", uuid: "60923c5c-26b8-4c3d-afd8-7a4afe3fd2e0" },
  { text: "我陪你留下，说最浪漫的话。", note: "网络", source: "三七", uuid: "72f0c7d1-d675-4b64-8ba7-c363c2650bec" },
  { text: "这是童年的一场历练。", note: "网络", source: "道雀Bzz", uuid: "ba40ab59-78e4-40b2-b43d-cc85ce4376b4" },
  { text: "太阳纵然温暖热烈，但我更偏爱温柔如玉的你。", note: "原创", source: "葭樱", uuid: "bacde290-122b-48d3-a97b-8f36189b0bf1" },
  { text: "若实现正义要以非正义行为作路径的话，那正义何在？", note: "原创", source: "碧水凌涛", uuid: "ac418531-daa6-4f90-9f19-e844f5cc61b9" },
  { text: "悲剧是荒诞世界的衍生文物。", note: "原创", source: "柑茶浸膏", uuid: "02c2964d-3e3f-46d9-b17c-0e51746223b7" },
  { text: "无知不可怕，可怕的是不知道自己需要知道什么。", note: "原创", source: "原创", uuid: "0143b012-444c-4aa1-8b76-6ea3a4eb8b66" },
  { text: "求你别离开我。", note: "网络", source: "Fanko冯思源", uuid: "be2fe6f5-310e-47af-9faa-392001d52257" },
  { text: "人们喜欢爱这个概念，胜过同他们交往的人。", note: "网络", source: "网络", uuid: "87f80060-a03b-4249-83be-adf83887970c" },
  { text: "你站在高处，就少往下看。", note: "网络", source: "rgo142", uuid: "66e8ac5d-680e-4a74-b6ab-4d517b83011b" },
  { text: "没有绝对的坏人，只是被逼疯的好人。", note: "网络", source: "网友", uuid: "eee8f934-71fc-4b0f-8768-e08b27fbf037" },
  { text: "小时候哭着哭着就笑了，长大后笑着笑着就哭了。", note: "网络", source: "Declan", uuid: "3f7a075c-8994-4698-81bb-eb4891bff69c" },
  { text: "但是我存在的意义呢，填满我悲欢的执着呢。", note: "网络", source: "30年前，50年后", uuid: "5b209027-7ced-43f4-8221-a649fe8d6316" },
  { text: "流光驰骤追梦魂，江声叠作青春。", note: "网络", source: "楼玉明只是路过", uuid: "7ae8177d-7ead-4abc-aee1-667e9477b467" },
  { text: "没人喜欢血淋淋的现实，于是便给自己他人画了个大饼。", note: "哲学", source: "Why", uuid: "883e91ac-1f7a-402e-9df5-aae52a9e3c92" },
  { text: "花开花落，化而为泥。", note: "原创", source: "HIOG--ZM", uuid: "c82dc93f-8d22-4b58-9a1f-fe2f01979422" },
  { text: "分分合合太多。", note: "网络", source: "Fanko冯思源", uuid: "4ae329e6-cb05-46f4-b339-19eb8f2bb8f5" },
  { text: "家长真讨厌，为什么在玩的时候一定要加入一些有意义的事情？", note: "网络", source: "摸老师", uuid: "aac606e0-d19d-4866-9226-76a47e23059d" },
  { text: "我愛生活，那誰來愛我。", note: "原创", source: "做魚玉子燒", uuid: "5a85e4b9-5c47-4ec2-8c2a-bfb267576ae7" },
  { text: "博学而笃志，切问而近思。", note: "哲学", source: "论语·子张", uuid: "48c766f0-70c8-432b-897e-01fa1d5b8aed" },
  { text: "有时候你必须在现实中取关别人。", note: "网络", source: "每个人", uuid: "ce00139a-cea4-4dc3-a049-d3b5c0b334d1" },
  { text: "即使天还没有亮，固执做梦的人，身前会有光。", note: "网络", source: "日食记", uuid: "866a4cce-2c00-4cd3-b1dc-cc21b9067301" },
  { text: "太阳背后的黑暗，你无从知晓。", note: "原创", source: "自己", uuid: "6538918b-0dac-4537-aa63-84f7c423c218" },
  { text: "黑暗中的曙光，遥不可及.", note: "原创", source: "茉莉雨", uuid: "b49f3c99-7606-4286-8bfa-91e686c87b40" },
  { text: "有幽默感的人，永远都不会默默无闻。", note: "网络", source: "网络", uuid: "1266e517-baaf-4371-be5d-7d10078cdcd8" },
  { text: "如果可以，请让我们慢慢了解，慢慢喜欢。", note: "原创", source: "临沂彭养鱼", uuid: "1be9f951-c27b-4a07-bf7b-cbe0a91c38a3" },
  { text: "万书皆下品，唯有萌最高！", note: "原创", source: "wy6510166", uuid: "1bec05d6-1bc5-40ab-bc32-758d7c82b9e4" },
  { text: "免费的馈赠往往标明了无形的价格。", note: "原创", source: "亚亚努阿", uuid: "3c280de7-d709-4b25-b722-78d0d56b31c6" },
  { text: "没有xx在这里就算是烂命。", note: "网络", source: "道雀Bzz", uuid: "554c15bc-3dcb-4bba-b494-4b3dfe677583" },
  { text: "不喜欢你的人多少秘籍都没用。", note: "网络", source: "佚名", uuid: "3136c22e-bbcc-48ea-a571-69f7dd2a4f72" },
  { text: "放下的过程很难，但是结束的来临很快。", note: "原创", source: "朴素", uuid: "b9239d8b-c74b-40dd-acb4-04fd321065f9" },
  { text: "白夜行、深庭破院，星落寒窗。", note: "原创", source: "碧水凌涛", uuid: "656b4396-f92f-4c5e-84fb-e37f7f9d03d4" },
  { text: "我不知道将去何方，但我已在路上。", note: "网络", source: "宫崎骏", uuid: "71f823d7-4c6c-4ffe-97a0-4844c1b04a3a" },
  { text: "甩臭汗，丢了爱。", note: "网络", source: "杨树人", uuid: "1d62a4c8-11f4-48d3-87c7-e7009e0cf934" },
  { text: "不喜欢什么都是理由，喜欢什么都不是理由。", note: "原创", source: "木子吻雨叚", uuid: "0c342eb2-f921-4f31-9e78-40a7dc06ae0e" },
  { text: "现实与理想相差了十万八千里,我马不停蹄,却也鞭长莫及。", note: "网络", source: "听《稻香》时的一些感慨", uuid: "c0b57851-40c9-46e9-a0c7-36ef47dc2106" },
  { text: "天流浅云，海泛清浪。", note: "原创", source: "鹤空流乂", uuid: "08181217-1ad7-412c-b88c-5eb28a65c9e9" },
  { text: "那是年少时的我们，在夜晚看星空。", note: "网络", source: "我的纸飞机", uuid: "794b5b31-8e53-4fd8-a513-b108981afe19" },
  { text: "等到了寒雨中的晴，没等到美梦中的你。", note: "原创", source: "刘志文", uuid: "d9e8d8c5-785c-465e-a545-ec2b545fcae8" },
  { text: "彼此相互推卸不幸是没有结果的。", note: "原创", source: "凋零", uuid: "2da10ca0-ba36-428e-8cdb-0b1fecbefd36" },
  { text: "写了不一定对，但不写绝对不会不错。", note: "原创", source: "二凡", uuid: "4445c9f9-367f-450c-97da-8070597dc4f8" },
  { text: "穹顶之下，仰望繁星。", note: "网络", source: "清巳星嵐", uuid: "1742ed8e-a304-4376-bdca-ba05741db342" },
  { text: "难道我注定困在尘埃。", note: "网络", source: "精卫(史诗版)", uuid: "faab9e25-bb33-4d38-b324-756044330b15" },
  { text: "因为喜欢你，所以喜欢你。", note: "原创", source: "茶", uuid: "2200401a-5add-4001-9663-e1d90505033a" },
  { text: "物是旧时物，人非旧时人。", note: "网络", source: "bilibili", uuid: "41f3f9a1-dbd8-41a4-ab20-0e9c8880c925" },
  { text: "别磨蹭，只有现在自己才能改变自己的未来！", note: "原创", source: "无名者", uuid: "60d17185-3ac5-4095-b509-19b6e8257fc1" },
  { text: "我以为是光救赎了我，但在光的深处我看到了你。", note: "网络", source: "打瞌睡的然", uuid: "5346f425-f975-4b2b-b3a2-1a4e35b32620" },
  { text: "我是你诗的哪个段落？", note: "网络", source: "廖伟志", uuid: "5b126411-65a6-46b6-a791-2efaee6dabf0" },
  { text: "我可是个面壁者，怎么能随便告诉你呢？", note: "原创", source: "帆仔", uuid: "cd826ecb-ebc0-47fd-a1eb-ff91ef7ca527" },
  { text: "“她不小心掉的皮筋，他捡起来戴了10年”.", note: "网络", source: "GGB", uuid: "7be26507-8b42-4181-b2c9-19d4b8aa7af9" },
  { text: "龙腾跃起，平望年年岁岁；爆竹声响，道尽岁岁年年。", note: "原创", source: "一只生菜", uuid: "5b83cc00-2b83-498b-9eed-125907bf3826" },
  { text: "你撑起的伞能不能借给我一半。", note: "网络", source: "徐重來", uuid: "3c93eb54-77b7-4963-8966-ee9bcdd9ae2d" },
  { text: "为毛我的眼里常含泪水，因为我老是中枪。", note: "原创", source: "不管外表怎样强悍我都是受", uuid: "5ecb7c7a-d999-45d5-8998-b6815569b9af" },
  { text: "人生路漫漫搀扶在岁月的荏苒，那时我们已白发斑斑。", note: "网络", source: "徐重来", uuid: "1520b5b6-34a5-4c31-bf49-0128c8bd424e" },
  { text: "一生败在太没钱，不敢爱她太明显。", note: "网络", source: "内涵段子TV", uuid: "c1d0cc8a-4a4e-4ece-b2d3-70ba4fbc7292" },
  { text: "看烟花在绽放啊，站在同一片天空下，在最美的年华。", note: "原创", source: "一只叫一行的喵", uuid: "691e81e1-ae78-464e-ac9c-8ecf58745a5e" },
  { text: "热烈相拥过，又不再交错。", note: "网络", source: "廖伟志", uuid: "ac239495-6467-46d8-8faa-f578fc154580" },
  { text: "把所有的疲倦换一叶扁舟。", note: "网络", source: "山风山风等等我", uuid: "eff36bcc-18bd-4cbc-b68b-91dd87cd9151" },
  { text: "能够被人们正常理解的现实，只是大概率事件恰巧发生了而已。", note: "原创", source: "小行星坠落", uuid: "ce67eb41-3f84-4999-91d1-37d125d8e9da" },
  { text: "努力没用的话，那谁还能区分天才？", note: "原创", source: "又诗几行", uuid: "c2050532-5d0d-4742-a1ea-b6d0f3da6a9d" },
  { text: "君可知别花今是谁人？", note: "网络", source: "楼玉明只是路过", uuid: "d0fe89c0-4c0b-49a0-b010-c7b37a6680c1" },
  { text: "就算你忘了我的存在，你余生未来可以都交给我保管。", note: "网络", source: "徐重来", uuid: "a10500c3-0af6-4ebd-9934-0fadc0a84312" },
  { text: "三五年听起来挺吓人的，其实风一吹就什么都不剩了。", note: "网络", source: "网络", uuid: "0b7119d9-eb67-4fbe-acba-516dcfb4ae21" },
  { text: "你站在我面前。", note: "网络", source: "吴佩岭@房东的猫", uuid: "cbd33d25-7ba1-4a01-85e5-97a6699af5ff" },
  { text: "前半生无你，余生请指教。", note: "网络", source: "网络", uuid: "306bb97b-14ec-4083-844e-0a977774dc13" },
  { text: "习惯不是路，是轨道，你以为自己在走，其实是在被拉。", note: "网络", source: "我是小鸭头", uuid: "84d5ca02-91bc-45fa-9923-49d04dde2247" },
  { text: "犹豫就会败北，果断就会白给。", note: "网络", source: "网友", uuid: "be0ee57a-8d15-4e00-949b-c962e02b909e" },
  { text: "只有除了爱情什么都不缺的人，才有底气去等待爱情。", note: "网络", source: "网络", uuid: "6fbf16d7-3fe7-4fec-9457-40af7280bf24" },
  { text: "人在年轻时，不该遇到太惊艳的人。", note: "网络", source: "佚名", uuid: "67fa6d52-39f2-4045-a7e3-18cf7e9f7dc8" },
  { text: "还有猫咪总是追着尾巴 有多傻。", note: "网络", source: "小寒", uuid: "6621ea80-d483-4ba9-8cdd-e587f5ffd83d" },
  { text: "花在女人身上的钱不能省，就算省了也不能让她知道。", note: "网络", source: "Internet", uuid: "e77cbb7c-a826-451a-af6c-a14de8a0ab2d" },
  { text: "人终其一生都是自我改善的过程。", note: "原创", source: "Bruce Jc", uuid: "7abc96e3-ea38-4123-9692-2ccbfc4745d9" },
  { text: "道路再远，也有终点。", note: "网络", source: "JackuXL", uuid: "58d6b195-91a1-4fe8-9e35-868fafd1e39b" },
  { text: "若我余生来得及，你是我所有的不介意。", note: "原创", source: "一个无归期的人", uuid: "48c9fc48-5fff-4dc4-95b5-f257b779b3d6" },
  { text: "纵使天光终将熄灭，我们也要歌颂太阳。", note: "哲学", source: "巴尔蒙特", uuid: "c408e4a6-f79e-47a6-85d3-15b863964023" },
  { text: "智者永不入爱河，怨者才重蹈覆辙。", note: "原创", source: "Yanser", uuid: "72713592-0733-42d0-8d3b-7c29b6eef018" },
  { text: "待吾修身以鸣心，胆斗诸天降无色。", note: "原创", source: "朴素", uuid: "173b7c6b-142f-4a02-ac8e-4406585338ff" },
  { text: "但滥情成了主流，深情便成了罪过。", note: "网络", source: "童锦程", uuid: "84fd714f-60d6-4d72-ab30-c7288b42dd63" },
  { text: "切勿为几两碎钱，毁了结下的尘缘。", note: "网络", source: "王悦辰", uuid: "c4cae62a-d4e4-489d-af79-7b0b55ab46b6" },
  { text: "也许是把一些事物看太重了，然而失去了才患于恋恋不舍。", note: "原创", source: "朴素", uuid: "22b8700a-d01e-43bd-b08e-0b4f1f3f93d2" },
  { text: "观睹他人不幸，方知自己何幸。", note: "原创", source: "AweiX", uuid: "95816600-21e5-4e2f-9945-13183738cece" },
  { text: "好想变成猫，蹭蹭就能睡。", note: "原创", source: "做魚玉子燒", uuid: "ac038235-418d-4f3b-9c30-8a4649b50b54" },
  { text: "请成为永远疯狂 ，永远浪漫 ，永远清澈的存在。", note: "网络", source: "网络", uuid: "e6109211-9139-4f4a-aecf-01be61642083" },
  { text: "飘荡在浩渺烟波里，如今我已不为看见你。", note: "原创", source: "新雪初霁", uuid: "b3917f16-b78b-4a33-a1ab-0576688fe020" },
  { text: "旦暮未歇浅处深，天之垂，记得酒痕。", note: "网络", source: "楼玉明只是路过", uuid: "0272400a-32ae-4fee-97fc-7687709140ba" },
  { text: "月是当年月，人不似当年。", note: "原创", source: "May", uuid: "38afb810-ba9f-4e34-a025-40a76b755cac" },
  { text: "只要一息尚存，就还有希望。", note: "网络", source: "格言", uuid: "3109b8b6-3b25-4b27-ab97-a972978a0721" },
  { text: "我只对我喜欢的人说真话，我不喜欢你。", note: "网络", source: "佚名", uuid: "cdcbdd7e-9680-4f7c-9307-f7f487c2c070" },
  { text: "仗剑救一人，从文万事休。闻鸡两起舞，一死一白头。", note: "原创", source: "无心", uuid: "ab5fc134-56d9-4b94-a087-ff772a861d02" },
  { text: "前世若不相欠，今生怎会相见。", note: "网络", source: "佚名", uuid: "b7adc2e1-72d5-41fe-9c35-06417073f8de" },
  { text: "労働者の命は何よりも大切です。", note: "网络", source: "Internet", uuid: "6b7b0596-8cd6-4921-9ba5-6147c56288a5" },
  { text: "抬头看向星空，低头遍地焦土。", note: "原创", source: "DreamStars", uuid: "19a03617-7970-4301-b8e9-9462a1782f37" },
  { text: "生活，不是选择，而是热爱。", note: "网络", source: "网络", uuid: "e0ee3e30-ec29-451f-89e0-34fd0c76ba5b" },
  { text: "有些父母宁愿相信不真实的营销号，也不愿意相信自己的孩子。", note: "网络", source: "滑稽的游侠", uuid: "d0513cdc-f304-4c36-bede-5f5a6b479692" },
  { text: "如果我是神呢。", note: "原创", source: "小豆", uuid: "36e573c5-baaf-47fd-81b8-81d485282636" },
  { text: "你看这个碗他又大又圆~", note: "网络", source: "Kris Wu", uuid: "63633cf9-ca5c-4dc9-ad5e-6cfc35e23f93" },
  { text: "活的越是绝望 写的词越是温柔 这也许是世间最大的讽刺", note: "网络", source: "来自网络", uuid: "b6d140f6-82d5-4771-9a1b-13f00c003488" },
  { text: "飘兮若海以亵餐，玄之又玄不可道。", note: "原创", source: "seyi", uuid: "733efcde-12e5-4963-978e-7cd47161b3ed" },
  { text: "也罢就这样吧，淡看缘起缘落，有缘聚，无缘不见", note: "原创", source: "—兔先森", uuid: "f0136d60-c81b-47f4-8859-59e314a4c2eb" },
  { text: "数天宇宙循序叠域，神处洪荒唯一世界。", note: "原创", source: "朴素子", uuid: "85f27822-dab0-4c98-961c-0ad56ecf53ca" },
  { text: "这个世界并没有变坏，只是人们自己的心、坏了。", note: "原创", source: "Qicloud", uuid: "ef15c2ad-8c48-40b1-af0a-2e9466a74e3a" },
  { text: "飞向了黑河却逃不出梦里，冲动的故事你要什么动机。", note: "网络", source: "道雀Bzz", uuid: "dee1fd11-9aa1-4f5a-9df5-1bf8950b785a" },
  { text: "无论撒怎样的谎，都无法欺骗自己的心。", note: "网络", source: "网络", uuid: "e6ffaaf3-928d-4637-825f-b9b64fc3ba88" },
  { text: "你知道的都是真相。只可惜那些并不是真相的全部。", note: "原创", source: "pokon548", uuid: "d83d56f8-b38c-4918-9844-5f7288947acd" },
  { text: "去寻找那无拘的以后。", note: "网络", source: "山风山风等等我", uuid: "1dc16d84-b3a6-4bc0-a63a-39e3cb175473" },
  { text: "就像开始的那个点，一切都是命中注定。", note: "原创", source: "Saliva", uuid: "dc9fcd56-730b-4bc4-a664-d20ed948ee81" },
  { text: "内心湛然，则无往而不乐。", note: "哲学", source: "梁实秋先生", uuid: "c4786aa6-95b8-4631-9a10-13d170615cdf" },
  { text: "科研成就的上限在于你的想象力。", note: "原创", source: "帆仔", uuid: "3dafd530-d2a3-4405-acc2-3e19b4e5a693" },
  { text: "行走于苍穹之上，将星空献给你。", note: "网络", source: "囚星蝶", uuid: "545197b1-06da-4ef5-9efe-d430f0debae6" },
  { text: "不是我想要放弃，你自己不去珍惜为什么要去怪我？", note: "原创", source: "Az殇芯", uuid: "d2459726-e1ed-40fb-bf41-325ef00a9b9c" },
  { text: "我得罪了领导，领导醉了。", note: "原创", source: "ideng", uuid: "954ed277-51c4-4b28-aa47-85bdbc4103c9" },
  { text: "光屏蔽了我们的过去，让我们有机会用影子最后相拥。", note: "原创", source: "双十", uuid: "1e3ddec8-9127-46db-9634-486b1ec5baf8" },
  { text: "寥寥长情过往旧，执念且放手。", note: "网络", source: "郑明河", uuid: "94f37649-5643-4ffd-ab94-4ef2084d857f" },
  { text: "吾尝终日不食，终夜不寝，以思无益，不如学也。", note: "哲学", source: "孔子", uuid: "5e950218-e701-4753-846a-1d32a642dcf9" },
  { text: "热爱是引领前进的第一动力。", note: "原创", source: "写bug的代码人", uuid: "8c7d28a4-219e-4ac1-98bb-de5c63e1e696" },
  { text: "我很少回忆，却不代表那些过往不在。", note: "网络", source: "佚名", uuid: "4fb5e4a4-fb69-46c0-9d3d-8326501d975a" },
  { text: "你的世界，我进不去。我的未来，你也不必参与。", note: "网络", source: "一个无归期的人", uuid: "56aab037-e46b-4b3a-94ad-82c20d8f0697" },
  { text: "我爱生活，大夫，全心全意，但生活并没有给我回报。", note: "原创", source: "红鲱鱼", uuid: "57bee814-6d0c-40ba-aee7-08f262178e61" },
  { text: "愿你晴雨无伤。", note: "原创", source: "鹤空流乂", uuid: "57108a5e-212f-4d1a-bce2-ea27c4b137d7" },
  { text: "日落尤其温柔，人间皆是浪漫。", note: "网络", source: "风月行者prodigal", uuid: "26320cdd-b389-4a6a-bfcf-6bf68ddf26a1" },
  { text: "天欲使其灭亡，必先使其疯狂。", note: "哲学", source: "佚名", uuid: "b3442935-6058-43e0-b8a5-b30863881e46" },
  { text: "纵天下几变春秋，我依旧还是我。", note: "原创", source: "crazy", uuid: "97ef46eb-cc0b-4ac6-a58e-5f345d13e31f" },
  { text: "愿人生如剑、立起寒光四射、躺倒四射寒光", note: "网络", source: "汪国真", uuid: "65980ded-6a3c-4b9f-855d-387922c20fd8" },
  { text: "我要做一颗星星，有棱有角，还会发光。", note: "网络", source: "佚名", uuid: "4641f6ba-347d-4756-9304-581c6175c8a4" },
  { text: "我们有太多凑巧，却唯独缺个正好。", note: "网络", source: "网络", uuid: "f47949de-23fa-45e3-b449-cb49327f05dc" },
  { text: "以前喜欢一个人，现在喜欢一个人。", note: "网络", source: "QQ音乐用户", uuid: "686fca99-e420-47e2-b239-4e298ab47658" },
  { text: "流浪去吧，总会在世界的一角找到愿意懂你的人。", note: "网络", source: "几米", uuid: "167ff1b8-1804-46a9-bba4-7ef3e27183e3" },
  { text: "即便在最黑暗的时刻也要看到光明。", note: "原创", source: "佩索亚·贝利斯", uuid: "71970f3e-ff2e-4c97-8e46-341c432ec344" },
  { text: "哲学是世界观和方法论的统一。", note: "哲学", source: "马克思主义哲学", uuid: "c494a593-81e0-45ac-b2d0-bdb8d5252ca3" },
  { text: "草长莺飞慰藉孤单的残雪，放开手让寒冷胆怯。", note: "网络", source: "花晶晶", uuid: "7b5f0239-c4e5-47d1-a565-4f75d158b79f" },
  { text: "我不是畏惧风，我只是怕风把沙子吹到我的眼睛里！", note: "原创", source: "白凝羽", uuid: "bc908f7e-9985-44d3-8234-4e0273e19672" },
  { text: "我没有失去任何东西，因为我一无所有。", note: "网络", source: "FanChestnut", uuid: "d29e70f7-1269-4919-8d13-a46017e0f025" },
  { text: "金霞錯日遲雲暮，回首摸空茶已涼。", note: "原创", source: "做魚玉子燒", uuid: "712774bd-cc04-4f32-b4c6-8520906e64ff" },
  { text: "没有你，我的人生会连狗都不如。", note: "网络", source: "网络", uuid: "a8e9d813-5fda-4869-bdd6-67e6c363bd0a" },
  { text: "时间是个庸医，却号称包治百病。", note: "网络", source: "不详", uuid: "d814f5ac-ef6d-4350-81df-8f14caa15272" },
  { text: "有些事情本身我们无法控制，只好控制自己。", note: "网络", source: "网络", uuid: "b8bc17b5-b94d-407c-a13d-0c34cf721dcd" },
  { text: "只想去往山野和清风来邂逅。", note: "网络", source: "追着山风寻自由", uuid: "45213b03-a282-4bdf-8f54-c167424ced3e" },
  { text: "这个城市大得让人到处能一见钟情，却没法重逢。", note: "网络", source: "九ちのセカィ", uuid: "eabd4dc9-8351-4ac5-aeaa-dd7e99c93361" },
  { text: "雾里浓云处，寻前路。", note: "原创", source: "Voyage.", uuid: "c45a761c-8d23-4d25-8702-e8112f97ad5e" },
  { text: "乐得浮生半日闲，一杯酒前细烟点。", note: "原创", source: "林萧", uuid: "df030b46-b9cf-4a6b-b4c0-524e0291adf0" },
  { text: "怎样用\"好寂寞\"，来表现我深深的伤口呢。", note: "网络", source: "神绮一织", uuid: "ecef2dd9-9bed-4bd8-ab2c-3ec692c633f4" },
  { text: "非痴非嗔，却应谶。", note: "网络", source: "楼玉明只是路过", uuid: "c81be373-9412-4e33-9605-15b3bbfa6921" },
  { text: "且视他人之疑目如盏盏鬼火，大胆地去你的夜路。", note: "哲学", source: "史铁生", uuid: "0348752c-6bb6-43c2-8a6d-a4c780e04767" },
  { text: "你很好，我也很喜欢，但我不是追着别人跑的年纪了。", note: "原创", source: "相信你愿意相信的就好了", uuid: "05fae027-f323-4662-9b2b-448f6bed3280" },
  { text: "都结束了，又开始了。", note: "原创", source: "茉莉雨", uuid: "a52fc909-6269-4da7-af9e-30a4ab8d2d23" },
  { text: "禾舟乡里数尽情，孤思无泪尽是茫。", note: "原创", source: "storm1614", uuid: "4acbc91f-4a28-4ba3-8c43-eca0d1552553" },
  { text: "我是沉默的我是旁观的。", note: "网络", source: "道雀Bzz", uuid: "60bc7825-2f1f-4eca-b095-d1c5667e5496" },
  { text: "生活是晨起暮落，日子是柴米油盐，喜欢烟火气的平淡与真实。", note: "网络", source: "佚名", uuid: "be659e1a-5484-4982-b492-b9caab9a3043" },
  { text: "熟读诗书千百遍，欲颂青春竟无言！", note: "原创", source: "碧水凌涛", uuid: "37b151b0-d869-4ec6-bf2f-55d5992eedd9" },
  { text: "路为纸，地成册，行做笔，心当墨。", note: "网络", source: "CCTV9", uuid: "677a3dcc-90f3-4b04-95b2-d65652b8bcd6" },
  { text: "热火总冠军，火箭倒闭。", note: "原创", source: "JJJ", uuid: "2482692f-2057-4ad6-b3a9-93d677295bf0" },
  { text: "与其诅咒黑暗，不如点亮烛光。", note: "网络", source: "网络", uuid: "1c1b3200-f8cb-43ca-8714-e0f9fc971830" },
  { text: "不管多少个选择，最后都是二选一！", note: "原创", source: "尤龙", uuid: "5dfcab7e-0c40-4ccf-982c-9834572714b5" },
  { text: "谑寻殉之泫吮兮，嘲赴死之自怜。", note: "原创", source: "一只叫一行的喵", uuid: "750272bf-9371-4e69-88a1-4b6f0e8e9277" },
  { text: "情不自禁，似我的哀，它到底用什么灌溉。", note: "网络", source: "30年前，50年后/烧灯续昼", uuid: "0789fb88-6707-4ce0-a2fa-5cb382e99d49" },
  { text: "你对不起任何一个爱你的人。", note: "原创", source: "nDhnzr6r", uuid: "b37e06f9-da1b-417c-9381-0cb7d9bbf7cd" },
  { text: "人烟物纷至，还有多少回？", note: "原创", source: "storm1614", uuid: "327f59ba-c4a3-431f-b09a-83bf61a1d738" },
  { text: "愿颠倒的天空吞噬一切绝望与不幸。", note: "原创", source: "auc", uuid: "aa48afec-c88e-4922-9569-f7cf17974569" },
  { text: "记得当时年纪小，你爱卖萌我爱笑。", note: "网络", source: "网络", uuid: "369d4d8a-1749-473d-9a07-c1001175e913" },
  { text: "余生向阳，往后如意。", note: "原创", source: "鹤空流乂", uuid: "d4b184e9-5b5f-4ed4-8dd4-d0b649b05bac" },
  { text: "自由的目的是为了为他人创造自由", note: "原创", source: "马拉默德", uuid: "73619006-c9fe-4e8e-9fcb-b9b460ea49cb" },
  { text: "时光如梭，你娃还在唱歌。", note: "原创", source: "JokerPink", uuid: "c34f915d-56f0-4e79-b633-5b2674a171a0" },
  { text: "心中却向往那山野的温柔。", note: "网络", source: "追着山风寻自由", uuid: "0ea033ad-fc1a-44e3-88c7-27b24f9ae7a7" },
  { text: "每条荒谬不堪的真理都有其深以为然的支持者。", note: "原创", source: "纤素丶", uuid: "6561efe5-0f08-4820-8a4a-b7c727379dcf" },
  { text: "回避现实的人，未来将更不理想", note: "原创", source: "温白", uuid: "089d5969-4326-468f-87c0-8f350fe6ce0f" },
  { text: "风吹落叶叶飘零，何处漂泊何处停。", note: "原创", source: "iseea", uuid: "ef9d6521-33f4-43b4-a8f5-503f3df5df42" },
  { text: "爱是等待，是细水长流。", note: "原创", source: "临沂冈田武", uuid: "8e12fc18-5144-415e-bb22-cf3a1fc81679" },
  { text: "物质的贫瘠只是暂时的，思想和坚定的心才是结果的基础。", note: "原创", source: "白榆郁离君", uuid: "02db59d7-5642-49ce-975d-5f2de67ee846" },
  { text: "努力微笑想让你回头，被泪水打湿的是一场梦。", note: "网络", source: "三七", uuid: "1e666bc2-d781-47c9-93bb-02f0eb716f0a" },
  { text: "错过了日出，我就等你看日落。", note: "网络", source: "张曦匀", uuid: "feb85f43-f5cf-40c3-8a60-df79c0d5c9a5" },
  { text: "有任何人在意自己，都是幸福的", note: "原创", source: "Diving_lin", uuid: "3f29c6fd-aee3-45de-9840-0e2962d0cd93" },
  { text: "甲之蜜糖，乙之砒霜。", note: "哲学", source: "亦舒", uuid: "a76f52f7-4095-47e2-b829-af9dd7c38688" },
  { text: "妄想进入虚空，却被虚空吞噬。", note: "原创", source: "DreamStars", uuid: "665955b4-315b-4bc5-ac95-03e6a055107e" },
  { text: "提起笔，可见泪光，照月光。", note: "网络", source: "郑明河", uuid: "d78b03ea-76fe-4133-9d99-4f7c1e134b46" },
  { text: "夢裡舊影難驅散，醒時心火亦未眠。", note: "原创", source: "做魚玉子燒", uuid: "af758ebb-bc3e-4b9c-abc9-f2e36e76e47c" },
  { text: "艺术应该走进殿堂，而不是走进灵堂。", note: "网络", source: "网络", uuid: "b0722cec-1756-402b-94cc-a1f45a8a9374" },
  { text: "神伤。伤及四海，四海难平，望滔滔大浪。", note: "原创", source: "碧水凌涛", uuid: "6d0edb83-e2ef-4bed-bf89-1b2c350c7046" },
  { text: "那么多的梦你一点也不记得，它们又是谁梦见的？", note: "哲学", source: "侯世达", uuid: "baca1358-2022-453f-b088-c08698db0d7a" },
  { text: "用所有的生命，拥抱身躯几亿兆倍的星球。", note: "原创", source: "山旅嗣槻", uuid: "976e6575-62f0-4da9-9bcd-520b7df3c5fa" },
  { text: "手执烟火以谋生，心怀诗意以谋爱。", note: "网络", source: "佚名", uuid: "e9d34135-c976-4233-9a88-9c93628cc750" },
  { text: "哪怕只是敷衍的承诺。", note: "网络", source: "你有没有真的爱过我", uuid: "e9c9afd1-79f6-483e-8bd6-6fedab8d55f8" },
  { text: "你们都说我是弱智，其实只有我遵守了当年一起不长大的约定。", note: "网络", source: "排山烈打", uuid: "8cb3c637-9a21-40d2-87c6-2d89391e216c" },
  { text: "在繁华中沉淀自我，在乱世中静静伫立，一笔一划，雕刻时光", note: "原创", source: "Henry_Huang", uuid: "6c5f5fa9-126a-4d43-b9d0-0a0b1c47c32d" },
  { text: "我们的科学永远只是找到近似真理。", note: "哲学", source: "爱因斯坦", uuid: "188c5217-9f90-430d-8417-759afa4fac9c" },
  { text: "欺骗的友谊是痛苦的创伤，虚伪的同情是锐利的毒箭。", note: "哲学", source: "弗拉基米尔·伊里奇·列宁", uuid: "da8ce74e-9253-4998-9461-52cc1bd15edc" },
  { text: "日为朝，月为暮，而你是朝朝暮暮。", note: "网络", source: "路小可", uuid: "7d3bea24-9f18-431e-ab8d-6d8c5c530150" },
  { text: "皱纹是时间吹过身体时泛起的涟漪。", note: "网络", source: "弱智吧", uuid: "cf8c687c-e110-4dff-bdc3-c25da429f37f" },
  { text: "我不相信长夜将至，因为火把就在我的手中。", note: "网络", source: "凯文·杜兰特", uuid: "0b4f06f7-ace6-444f-a90c-ded64a2243eb" },
  { text: "世上本没有什么岁月静好，只是有人为你负重前行。", note: "网络", source: "网友", uuid: "4941af7f-a4f4-485b-aac3-602e9b5dedb0" },
  { text: "我拯救了全世界，全世界却抛弃了我。", note: "网络", source: "哔哩哔哩", uuid: "29506e97-85a5-4df8-bffa-346987ff9d88" },
  { text: "在地球75亿人内与你相遇是多么幸福啊。", note: "原创", source: "孤影墨香", uuid: "095ef8c3-f8ab-484d-9189-6627836218db" },
  { text: "真诚加任何一项都是王炸，唯独单出是死牌。", note: "网络", source: "童锦程", uuid: "bd6d57a8-841b-48bd-abd8-4f8b08f8036a" },
  { text: "我最想的，就是好好活着。", note: "原创", source: "Que", uuid: "d5540ba6-2e69-43bc-8d73-d19bd3e255b4" },
  { text: "无求一生光辉，唯望斗志不断。", note: "原创", source: "清岷", uuid: "fd27fb54-05b8-4c0d-bc2e-1222b1dce466" },
  { text: "情商高的人情伤都多吧。", note: "网络", source: "佚名", uuid: "12f144ec-195c-4083-81a7-65f682d09ed7" },
  { text: "踏过一年，迎来一年。", note: "原创", source: "南宫雨熈", uuid: "2c3cc358-44ce-4a97-9161-22decd6e939f" },
  { text: "就算路不坦荡也要做自己的太阳。", note: "网络", source: "网络", uuid: "6e7fbdbc-2454-4c62-873c-868e8b7ca89d" },
  { text: "无次数的沉沦就是为了苏醒。", note: "网络", source: "耳根", uuid: "6dccdbb2-1e95-44b0-984b-2f5601e19aea" },
  { text: "灰尽暗夜燎前线，烟起迷雾挂蓝巾。", note: "原创", source: "Awoluua_", uuid: "87fd3e5e-c359-4ae4-a6a2-d3d26cd9efdf" },
  { text: "在太上忘情却终究人非草木。", note: "网络", source: "佚名", uuid: "97835d10-60da-4465-839b-2b682799e148" },
  { text: "相思不露，只因入骨，晚安！", note: "原创", source: "自创", uuid: "b576b02c-c878-4f4d-8be7-0bf9874fe70a" },
  { text: "人生的胜负并不重要，但求尽心尽力，问心无愧。", note: "网络", source: "网络", uuid: "b8782af1-c101-4922-aedd-5f9b9326a8d7" },
  { text: "铭记历史，心怀宇宙。", note: "原创", source: "铭宇", uuid: "a7bb87d8-fba0-4047-836e-f5aa0ae78339" },
  { text: "不会去爱，那就别爱，天有注定，缘也会散。", note: "原创", source: "陈树凤", uuid: "898db02a-f4f0-4be8-8bde-6c276f65d161" },
  { text: "能雪藏的只能是过往。", note: "原创", source: "汪洋", uuid: "f24365b9-2f05-4e59-ac9a-d8926def8d72" },
  { text: "我仍飞奔向海。", note: "网络", source: "精卫", uuid: "e9191b69-b296-4824-bcad-4b796951d311" },
  { text: "最是无情荷下月，满天星落潭中花。", note: "原创", source: "做魚玉子燒", uuid: "faaf57b3-05d0-4f65-b405-3074decd06d4" },
  { text: "喜欢的话就坚持吧。", note: "网络", source: "陈睿", uuid: "9400493a-b5b2-4b44-b713-b51f6caafea7" },
  { text: "善变与矛盾是青春最大的特点，而你，是不变的答案。", note: "原创", source: "Eternal__Battle", uuid: "48abb120-1f2c-4d92-a1b6-855eaf42782f" },
  { text: "曲高必然和寡，英雄总是孤独。", note: "原创", source: "帆仔", uuid: "e75daf78-6ede-4b07-9c8a-e535448367c3" },
  { text: "一如软件深似海，头发从此是路人！", note: "网络", source: "来自网络", uuid: "c6e27dd7-5d5d-48ce-ba8d-a4a28c678830" },
  { text: "少年与爱永不老去，即便披荆斩棘，丢失怒马鲜衣。", note: "网络", source: "莫峻", uuid: "1046112d-8b76-40d3-8634-df76dce8f290" },
  { text: "昨夜疾风飞瀚海，怎料夏花犹在。", note: "原创", source: "凌涛", uuid: "04fbf41a-d06a-4d21-b2f1-6ce7c042f795" },
  { text: "夜晚看星海坠落，我们的爱情，此刻像夕阳般遗落。", note: "网络", source: "三七", uuid: "20d5b250-a006-4e3c-abbd-ac53914347b2" },
  { text: "深情岁月寒，故事里她还孤单。", note: "网络", source: "郑明河", uuid: "eb50345b-432c-4150-996a-b6309339511a" },
  { text: "不管明天会发生什么，请牢记住今天。", note: "原创", source: "根号菌SAMA", uuid: "09d95092-c25d-4170-9627-c636f05f6c19" },
  { text: "巧合是上帝默默操控世界的方式。", note: "哲学", source: "爱因斯坦", uuid: "b5f3e632-6d18-44ad-81fa-9fc0e114dc3f" },
  { text: "顾盼红尘谁又懂我的渴求。", note: "网络", source: "山风山风等等我", uuid: "a7527e6e-7d63-44e8-bb0c-a9f672596ae8" },
  { text: "日月同辉时，诸神的黄昏。", note: "原创", source: "朴素", uuid: "0e6a08a8-c255-4210-8771-f3cdbe5b8fc1" },
  { text: "活得最伟大的人，都遗忘了世界，却让世界记住了他。", note: "原创", source: "空明·离", uuid: "f14e5c57-85ce-4ef9-b70d-a66cb998f108" },
  { text: "夜悠悠几度秋，只落得人消瘦，一梦相思道不完，眉间的离愁。", note: "网络", source: "蓝乐", uuid: "7c9d03be-911e-4b27-a3ab-de85c1fa5894" },
  { text: "每个凉宫都会遇到属于她的John Smith。", note: "原创", source: "gmouse", uuid: "0466f217-54b7-467f-b34c-7ef4bbd72265" },
  { text: "在放弃之前，成功的可能性永远不会归零。", note: "原创", source: "北城不夏", uuid: "eb51ac20-0f3a-44d6-be4a-c908e78ef03b" },
  { text: "你最无暇的时光是哪段，你又把它奉献给了谁？", note: "网络", source: "B站弹幕", uuid: "50a227fc-be5f-4652-8c6c-d71632bdf19f" },
  { text: "每一次选择，都要为其承担后果。", note: "网络", source: "网络", uuid: "f6b14e22-5408-4bf5-9cd4-28e6044b6bab" },
  { text: "思念揉进月光，云一散就铺满你的山岗。", note: "网络", source: "自游诗/伊铱", uuid: "a2f3b7d9-899c-419d-8d21-7631ea2e23fe" },
  { text: "你看她笑靥如花，恰似此间神话。", note: "原创", source: "渊鱼", uuid: "d84ef646-0abe-40fe-ac41-352967cc321f" },
  { text: "难舍，难分，难解，缘起，缘浅，缘灭。", note: "网络", source: "二水/自游诗", uuid: "4583dbc0-4c2d-4832-9b24-07c039c21290" },
  { text: "我要你的全部，赐我被你爱的天赋。", note: "网络", source: "我不吃饭", uuid: "79638654-51d3-4e22-8374-029662fc7fb0" },
  { text: "半梦半醒执念被割破。", note: "网络", source: "你有没有真的爱过我", uuid: "0dd59bad-b966-4e17-9320-2fe7c4915603" },
  { text: "我们都以为雨滴落向地面，其实是我们坠入天空。", note: "哲学", source: "弱智吧", uuid: "0225e39b-864e-466a-b712-5f5da634ae37" },
  { text: "时间是最暴虐的存在，它能够毁掉一切。", note: "原创", source: "我", uuid: "52385222-0f8d-495c-913d-c87e5e241ddd" },
  { text: "别等待，趁现在，迈向未来！", note: "原创", source: "HanTian LanHai", uuid: "b89777e1-65ce-4282-994b-9d37007dc12e" },
  { text: "修道者，逆天而行，注定要一生孤独。", note: "网络", source: "耳根", uuid: "e1091d9c-5964-4f92-a418-1d134cb71f3f" },
  { text: "和夕阳并肩走，和往事挥着手。", note: "网络", source: "王健美", uuid: "31097789-e2a2-4371-b4fd-e23a6d1e3754" },
  { text: "何苦执迷不悟，疲惫的强求。", note: "网络", source: "山风山风等等我", uuid: "0c3bab31-ebdd-4ec0-9125-5bdc0f8bf8f2" },
  { text: "文明是技术与艺术的结合，理性和浪漫皆为基石。", note: "原创", source: "Cindy_Li", uuid: "0ce14fec-570b-440d-b869-c2f875a9fec8" },
  { text: "为者常成，行者常至。", note: "哲学", source: "晏子春秋·内篇杂下", uuid: "dd72e127-5e7b-4581-a11b-0a978992455c" },
  { text: "我只是希望能够超越自己。", note: "原创", source: "HONTARG", uuid: "a1899a9a-cf37-4bf9-a25b-0b6ab3f5f2a6" },
  { text: "无法避过轮回，而岁月亦没有等我，你，何时来带我。", note: "网络", source: "耳根", uuid: "1eaa75cc-18d5-432c-add3-09f0eb34d238" },
  { text: "燐灯三千燃长夜，烛照天门千山雪。", note: "原创", source: "烛火千年", uuid: "2d8a6bec-58a3-49c0-88d7-51315171bb42" },
  { text: "点亮星火，眺望未来。", note: "原创", source: "点亮星火", uuid: "485cec6f-8f23-42d8-9e0d-c0daca7ccebc" },
  { text: "醒来的时候很困，要睡了的时候很精神。", note: "原创", source: "混沌喵", uuid: "6396d76f-52f5-4950-9e40-d922550a9ee7" },
  { text: "我不知道我要干什么，我也不知道我该干什么。", note: "原创", source: "Peter", uuid: "768bdaec-5b35-4c88-9b4e-c70745b8f928" },
  { text: "那双紧握不放的手……抓住的是希望……亦或是绝望……", note: "原创", source: "sseeyyou", uuid: "e5f59f93-80be-4bec-9a03-964d7bd426fa" },
  { text: "人生最重要的是时机，时机对了，凡事都有可能。", note: "网络", source: "网络", uuid: "801f2ee8-7c90-41f1-9674-44c035c4a6e3" },
  { text: "就像你流下眼泪的声音，融化雪一样的冬季。", note: "网络", source: "二水/自游诗", uuid: "a0ee7a59-dd46-410c-b919-2dc999dc22d2" },
  { text: "被拉成长条的影子下，孩子们哼着回家的歌谣。", note: "原创", source: "CuSO4", uuid: "c1e14e0a-254d-4c92-880c-d00cc55fac8a" },
  { text: "九天幽冥鸟尽鸣，朝夕福地世无空。", note: "原创", source: "朴素", uuid: "1677e62e-2ad0-4a0d-8324-a196f504817a" },
  { text: "快乐方法并不复杂，不管未来怎样多变化。", note: "网络", source: "小寒", uuid: "c65cbb42-5b87-405a-ace4-a5c818244094" },
  { text: "凡人觊觎神的智慧，却不想自己已踏入神的边境。", note: "网络", source: "网络", uuid: "9d0ffbfa-189d-41b2-806a-7c0814b3c6cc" },
  { text: "绝对清澈，绝对透明，绝对空灵，就是深邃。", note: "原创", source: "孤独的人啊", uuid: "4ddcfe97-2c0c-413e-82a7-9b25173b7ad7" },
  { text: "愿追逐光明的我们，都会迎来属于自己的春天。", note: "原创", source: "Xun", uuid: "5feeae81-bf4c-4e0c-bb7d-b2f1ef6fe38a" },
  { text: "这份错位，给我的寻觅平添重重阻碍。我到底是谁？", note: "网络", source: "angsaide", uuid: "abc78c63-7985-47b4-b120-165f2d6a6752" },
  { text: "那不是温柔，那不过是软弱罢了", note: "原创", source: "原创", uuid: "ab5d7cb1-05f9-4b53-9ac9-0c1146ece917" },
  { text: "在我义无反顾爱你时，恐惧同样无边无际。", note: "网络", source: "网络", uuid: "d58a68f5-5d57-4614-a9bf-36ecdb8587e9" },
  { text: "或许就像现在这样，孤独、寂寞。但我们依旧有着美好的明天。", note: "原创", source: "TNXG", uuid: "a64943da-021b-4e83-8d31-217a88eda477" },
  { text: "因为荒谬，我才相信。", note: "哲学", source: "德尔图良", uuid: "58ae4703-3c7a-4e17-8cb7-36e0efc4e78f" },
  { text: "我卸掉眼鏡，世界全是朦朧美！", note: "原创", source: "cyalias", uuid: "4c64b338-0853-4a28-8be0-61f18d0cfeea" },
  { text: "你只需看着别人精彩，老天对你另有安排", note: "网络", source: "春天", uuid: "26598529-bdcd-46a5-85f2-abc25b011898" },
  { text: "望如常，而非平常；知彼此，而非如此。", note: "原创", source: "自拟", uuid: "69406a1b-04bd-4b4a-8109-9370af204d99" },
  { text: "为学日益，为道日损。", note: "哲学", source: "李耳", uuid: "8ac6df1a-85ee-4dfd-94e1-8d5812501811" },
  { text: "如果现在不开始想，那以后哪有时间做", note: "原创", source: "哲理", uuid: "f4d9ffc7-67a7-441f-b1e0-8b2395e26033" },
  { text: "懵懂少年，不知天涯多远。", note: "网络", source: "无", uuid: "3a1e5d51-c1e3-4c18-ada5-bd8d0acca8b8" },
  { text: "年前翘相盼，年时众欢愉，年后长相思，年兽竟如我。", note: "原创", source: "白榆郁离君", uuid: "1c05eed4-dbb6-4b50-b8ef-8bef1ecefb6d" },
  { text: "一切不谈语境的真理都是耍流氓", note: "网络", source: "来自网络", uuid: "8ae82850-8fb5-4619-a12b-64d2ba1e0dec" },
  { text: "她着红衣丝千里，天铺巨网罩深红。", note: "原创", source: "Awoluua_", uuid: "6c94d2b0-b707-430d-861d-b0111a9ea974" },
  { text: "这件事犹如风一般，掀开了我人生的下一场幕布。", note: "原创", source: "安", uuid: "788b4bdb-e4e8-4af7-ae49-960de695b606" },
  { text: "我做对了，但我错得很彻底。", note: "原创", source: "茉莉雨", uuid: "5c3f8e29-dad9-4227-9459-a8af36918fee" },
  { text: "取法于上，仅得为中；取法于中，故为其下。", note: "哲学", source: "每日一习话", uuid: "86b3fe81-dd36-42bd-80ce-1664cd37f118" },
  { text: "珍爱生命，不要小病变大病，大病拖没命。", note: "原创", source: "Yang", uuid: "9047be0f-9dfc-4889-a32a-0337f46d1e04" },
  { text: "悲兮叹兮终餐亵，人度天度不涅槃。", note: "原创", source: "seyi", uuid: "82323343-8808-4446-9c15-131bb48101d1" },
  { text: "珍藏于心底的时光，是记忆深处最美的花。", note: "原创", source: "沐云湘夕", uuid: "4d897880-50f0-44ef-8c7c-67cc7b9709bb" },
  { text: "我却对你情有独钟。", note: "网络", source: "Fanko冯思源", uuid: "b1a1623a-5a6c-4ee2-932f-536a78b0e2da" },
  { text: "黎明之前总有一段时间特别黑。", note: "网络", source: "网络", uuid: "0c804669-06c4-4d5b-b151-44901b56c206" },
  { text: "今天的雨很大，你那边下雨了么？", note: "原创", source: "生活", uuid: "fe714371-1e51-4cf5-98ea-52a715b76226" },
  { text: "如果你看过大海，就不会介意池塘里的是非。", note: "网络", source: "笔尖上的躁动", uuid: "05223399-b7f0-4f52-aad0-4f71b5a6ffdc" },
  { text: "生活就像一盒巧克力，你永远不知道下一块会是什么味道。", note: "原创", source: "阿飞", uuid: "6c5e4222-d5a0-46d6-a8c1-6ea1d2da061f" },
  { text: "将盈耆欲，长好恶，则性命之情病矣。", note: "哲学", source: "庄子", uuid: "44b7b89f-cef1-45bf-b764-ccd9f8b8f389" },
  { text: "当我终于理解了你时，你却再也不能听见我的声音。", note: "原创", source: "SKANER", uuid: "59a29d17-7432-4fcf-bae9-e91ce3602405" },
  { text: "我相信你，不是你的错。", note: "原创", source: "王安南", uuid: "01aa89cb-50d0-4a0a-b330-c6dd25b3ccc9" },
  { text: "Oh，我们辗转几何，可结果又是如何。", note: "网络", source: "别错过", uuid: "e33b99f0-b402-4046-88d3-d480f112097c" },
  { text: "就很犯困很困很困~很忙还是很困！", note: "原创", source: "上班", uuid: "337e907c-4f5e-40b9-afcf-c68cf6877dd7" },
  { text: "谨口慎言方可保命。", note: "哲学", source: "圣经", uuid: "c58b4496-5b91-4ab5-b4f5-561c959cfff7" },
  { text: "当雪崩发生时，没有一片雪花，不在浪迹天涯。", note: "原创", source: "Kyanite", uuid: "d620e424-9147-4f0a-95ea-9c3cd40cda3e" },
  { text: "我只是有点害怕一转身就错过。", note: "网络", source: "别错过", uuid: "b46621d2-ff22-48e0-b96c-771f5da0c17c" },
  { text: "我有故人携剑去，斩尽春风未曾归。", note: "原创", source: "妤枍", uuid: "8e1654a8-4a95-4387-b0a0-ed88fcb0d360" },
  { text: "绕远的路，总能看见更美的风景。", note: "网络", source: "佚名", uuid: "33dbd402-e013-47b6-ad78-c134cf7bf725" },
  { text: "夜幽幽，月优优，水攸攸，曲悠悠，吾忧忧。", note: "原创", source: "莽红尘觅知嘤", uuid: "85ea7f5b-b3d8-4a2b-bbbc-554d20f9fc46" },
  { text: "只要我足够穷，就没有什么能够诱惑我。", note: "网络", source: "陈树凤", uuid: "cd82be88-5cd9-4042-8539-ea9b5bbaa21c" },
  { text: "最折磨人的或许不是一场惨烈战争，而是烦琐的日常生活。", note: "哲学", source: "亦舒", uuid: "da22aded-e58b-4b9d-8e2d-55d302ea95ed" },
  { text: "憧憧尘世与君哂笑寄残灯。", note: "网络", source: "楼玉明只是路过", uuid: "c8a92bc4-2053-4e31-b4d8-6137b13901d5" },
  { text: "如果没有天赋，那就不断重复。", note: "网络", source: "网络", uuid: "3d437f73-dee5-4f2d-af47-ceb91c9cdebf" },
  { text: "丢掉幻想，准备斗争。", note: "哲学", source: "毛泽东", uuid: "2ae8d734-9266-48f0-9bd9-fd1f560d3bad" },
  { text: "风早已偃旗息鼓，染血的翎羽宣告着一切。", note: "网络", source: "CyOI", uuid: "efc7c0ba-ed66-439f-be62-a9f6ccf84758" },
  { text: "我是一个很没有毅力的人，喜欢你这件事我却爱了三年。", note: "原创", source: "葭樱", uuid: "9fd16b0c-6cce-4938-8738-e00807549ada" },
  { text: "看看外面的世界，山河多锦绣。", note: "网络", source: "王健美", uuid: "2aac7f76-3d19-47ae-8016-8b1b9811cc90" },
  { text: "逆而顺之，顺而逆之。", note: "原创", source: "朴素", uuid: "27893c2c-f517-4768-9cfd-af70b43dca5c" },
  { text: "无论将来会遇到谁，生活都是先从遇到自己开始的。", note: "网络", source: "苏晨", uuid: "fa295ea4-84d8-49c6-a162-26a0d3a7c58f" },
  { text: "远赴人间惊鸿宴，一睹大唐盛世颜。", note: "网络", source: "佚名", uuid: "ba7c1baf-e251-4268-9b53-24a679bf4257" },
  { text: "我们似乎有着相遇，我们似乎早已别离。", note: "原创", source: "双十", uuid: "ff395c71-c533-4965-a8a6-95d782c12a4c" },
  { text: "实践是检验真理的唯一标准。", note: "哲学", source: "光明日报", uuid: "f765507c-8ea5-4058-9304-0d3ca6db2dc1" },
  { text: "今天是一起养狗，以后就一起遛狗，日久生情，狗又生狗。", note: "网络", source: "我的少女时代", uuid: "a9ed50e2-a4a4-4566-b2d5-183da28972ff" },
  { text: "用柔软的面点，对抗这个坚硬的世界吧。", note: "网络", source: "日食记", uuid: "901a3a77-e851-47cc-8978-80e156ec58b0" },
  { text: "随云朵去漫游。", note: "网络", source: "疯狂的羊", uuid: "7c22ae2a-a7ec-47cf-8e42-17d5960f8264" },
  { text: "人只有活着时，才有肉身。", note: "哲学", source: "海德格尔", uuid: "0884ae65-0e54-493d-bdc3-0ccb9823a33c" },
  { text: "理性总是在给感性收拾烂摊子。", note: "原创", source: "忆", uuid: "0c3c529e-39fa-4b0b-818e-4c77c0c33e22" },
  { text: "微笑着挥手再见，但内心却却深知，以后不会再相见。", note: "原创", source: "何叶", uuid: "74c1c8db-bb76-4ad8-9294-252135193fae" },
  { text: "我是个特别害怕失败的人，为此错过了好多事。", note: "原创", source: "碎碎念", uuid: "531d7277-02c2-46a9-bbb0-7864cca021db" },
  { text: "没有伤痕累累，哪来皮糙肉厚，英雄自古多磨难。", note: "网络", source: "任正非", uuid: "d6ae3e89-5a28-4b78-a31e-706f12b8341e" },
  { text: "舟中暗坐附耳滔滔放歌声。", note: "网络", source: "楼玉明只是路过", uuid: "9fb02619-ecdd-4384-81d0-50a03651b1f4" },
  { text: "一定要像小孩子一样爱笑，眼睛一定要闪着不谙世事的光。", note: "原创", source: "致她", uuid: "7ee4f7be-c3af-4a51-8e11-a8a2caff496d" },
  { text: "就随心向前走，抛开旧烦忧。", note: "网络", source: "山风山风等等我", uuid: "d2204dc3-4465-4e1c-89d8-dec23524b627" },
  { text: "我们把世界看错，反说它欺骗了我们。", note: "哲学", source: "泰戈尔", uuid: "6c7697d2-46e1-413b-a40c-11a999bfd0db" },
  { text: "我当然不会试图摘月，我要月亮奔我而来。", note: "网络", source: "黛丽·赫本", uuid: "3b05c4f3-a7fe-427d-b89b-6ae5934b7c5f" },
  { text: "清风徐来，我自盛开。", note: "原创", source: "菲.lin", uuid: "c279171a-1dba-44a7-9329-ba1fd3f01635" },
  { text: "如果累，那就停下来，想一想，你在做什么……", note: "原创", source: "ideng", uuid: "b4186e05-78ea-4e6f-bfaa-8c7d091c069f" },
  { text: "千万丈的大厦总要有片奠基石，最初的爱好无可替代。", note: "哲学", source: "王小波", uuid: "d97561d8-b4e9-46f5-addf-1d4d946dd946" },
  { text: "经典之所以称之为经典，因为它能经得起时间的考验。", note: "网络", source: "哔哩哔哩", uuid: "4f3f0bd8-822a-4d4a-ac4f-bcdb89a71b65" },
  { text: "你背朝太阳，就只能看到自己的影子。", note: "哲学", source: "纪伯伦", uuid: "7733ec16-4af0-4ae0-9ebf-1a0f14eff91b" },
  { text: "忘情不如情忘，绝念不如念绝。", note: "哲学", source: "王常月", uuid: "3f7076b1-f500-4c55-a1f4-f9acde556b5f" },
  { text: "思源来去何以碧落，顾计进退求得天赐。", note: "原创", source: "朴素", uuid: "488d1d2d-2697-42ee-8291-9e12aae517d9" },
  { text: "输了你，赢了这个世界也没意义。", note: "原创", source: "Qicloud", uuid: "8d742dd4-e975-4be4-8323-9115c3256344" },
  { text: "我最喜欢你的那一年，那将是我永远不会再有的十八岁。", note: "网络", source: "佚名", uuid: "0d55fdc1-9adf-42af-8c50-6087c3d9c22e" },
  { text: "放过一场烟花，从此燃尽我一生芳华。", note: "网络", source: "互联网用户", uuid: "bb2f32ff-3c70-422e-a27a-33160317e436" },
  { text: "劝你相信一回。", note: "网络", source: "30年前，50年后", uuid: "5093ffcc-a814-46d9-ae16-b4b5a9bdcfbd" },
  { text: "知道自己为何而活的人，总会是幸福的。", note: "原创", source: "CuSO4", uuid: "6d7ea7bc-4dd6-4119-9099-cb0fbc89a5eb" },
  { text: "就任性向前走，莫问岁月愁。", note: "网络", source: "王健美", uuid: "01c072f0-d668-4adc-8bd7-d13939268dd0" },
  { text: "后来我想那天如果我听清了。", note: "网络", source: "道雀Bzz", uuid: "3e0b3a4d-237f-4d9d-91cc-fdbb775e5927" },
  { text: "游心于淡，合气于漠，顺物自然而无容私焉。", note: "哲学", source: "庄子", uuid: "272fe5de-72d3-46c9-9cc3-660eff190d1a" },
  { text: "吃百家饭，哭百家坟，叫百家姓，做百家人。", note: "网络", source: "网络", uuid: "46c7e8c5-0e6f-497e-b04c-4bdc969ebd75" },
  { text: "郎才女貌遥相唤，旧桥新柳换君旁。", note: "原创", source: "做魚玉子燒", uuid: "3b4e8b3e-4b17-4166-b46c-96e329200dfd" },
  { text: "让魔法的风暴，成为你们的终章！", note: "原创", source: "月白清风", uuid: "d01855eb-46a3-4d18-bb27-3a19e4bcfb36" },
  { text: "患了中二病，等于有了一种信仰。", note: "网络", source: "网络", uuid: "5d6abf73-e420-4ac0-85bd-e46a500418b7" },
  { text: "一瓶250ml的吊水，一共是3111滴。", note: "网络", source: "网络", uuid: "4eebdd10-9814-4348-8745-976a8bc484be" },
  { text: "学习知识是为了提出更好的问题。", note: "原创", source: "帆仔", uuid: "bc2d02aa-3271-4480-83bf-17c2326b44f3" },
  { text: "眼眸中万片璀璨星光，那是挚爱之人的眼眸。", note: "原创", source: "幕崽", uuid: "3373e9d0-cf6c-48c2-8195-5570be9787d8" },
  { text: "上帝成为我的诗人。", note: "原创", source: "Iking", uuid: "373335c5-44ca-421a-afc0-2a24a0d1e688" },
  { text: "祈焚天，昙花现。", note: "原创", source: "朴素", uuid: "6d52f53e-c37b-4f38-a43b-8f3c228f95a2" },
  { text: "五月繁如四面叶，三九生乃一支花。", note: "网络", source: "佚名", uuid: "2c6ea746-6e0c-4c6b-9a36-2c626821ba4e" },
  { text: "那双紧握不放的手…抓住的是希望…亦或是绝望…", note: "原创", source: "原创", uuid: "15fdecee-d0f5-4128-bf7e-55b07add4155" },
  { text: "万物终归向海，何必衔木石来。", note: "网络", source: "万物终归", uuid: "7fe26f4e-861b-49ee-ad53-7d9f4e560dfb" },
  { text: "值得获取的东西，就在风险的彼岸。", note: "网络", source: "网络", uuid: "1c336d74-4418-4653-89a7-430db76ad563" },
  { text: "也许是老天安排要我们学会珍惜，才会让这一路这么不容易。", note: "网络", source: "路小可", uuid: "14f6281f-ad6f-4fbd-889e-78462c4ddbf9" },
  { text: "那些听不见音乐的人认为那些跳舞的人疯了。", note: "哲学", source: "亨利·柏格森", uuid: "483c691a-d898-428c-8ebc-51efe05f9e7a" },
  { text: "圣人不死，大盗不止。", note: "哲学", source: "庄子及门生（外篇）", uuid: "eb6e3bf5-cd49-4904-866f-923162e854b9" },
  { text: "想留的人却总难留，想说的话都到嘴边。", note: "网络", source: "互联网", uuid: "c2d16f1e-612b-4038-9da6-399d9b88d4a0" },
  { text: "我躺在黑暗里用血丝赤红的眼看每一个凌晨的灿红初阳。", note: "原创", source: "食取", uuid: "9a8b69d2-7eb0-4617-acb1-8f35e605e7a7" },
  { text: "都是同龄人，我本来没想降维打击!", note: "网络", source: "zmjjkk", uuid: "d0c6aaa8-529b-4688-8b41-b5d5a227d8b0" },
  { text: "呐，答应我，看完这一条，就去学习吧！", note: "原创", source: "SKANER", uuid: "9ee1f499-5861-4a02-8330-c7171de6b058" },
  { text: "黑白的时钟翻滚着浪潮，秒针旋转着人们的心。", note: "原创", source: "Lazyii", uuid: "83139216-632d-4dc4-9f9c-aa6242dd50e7" },
  { text: "再抱抱我吧，闹钟快要响了。", note: "网络", source: "网络", uuid: "b43242c2-ae24-40a1-a9e3-785bdcdd5341" },
  { text: "有意义的人等再久都有意义。", note: "网络", source: "佚名", uuid: "fb0f4f15-84f2-4766-a962-3c60acb623c8" },
  { text: "没有回忆就去创造回忆，没有道路就去开辟道路。", note: "网络", source: "平安夜的噩梦", uuid: "0eea1f47-b826-4993-b2c3-e254f531e6ba" },
  { text: "我和别人的故事很少，却和自己的故事有很多。", note: "原创", source: "linkey2011", uuid: "adfed409-0a6a-44f6-bb44-8b72e2eb4864" },
  { text: "他会找到别的月光，你也会拥有你的月亮。", note: "网络", source: "网络", uuid: "87ebe748-cb98-4080-9631-56307c1b0021" },
  { text: "今年夏，遇一人，甚喜之，我无能，未能留之。", note: "网络", source: "佚名", uuid: "5d34f4dc-7ea1-4283-84fe-446da322edf2" },
  { text: "可惜生活不是电影，我也少一点运气。", note: "原创", source: "兔子君", uuid: "3dcab3a8-fd51-4e04-89c2-29f0f95c6023" },
  { text: "生活如叶，重重叠叠，只如毡般消逝在林间。", note: "原创", source: "原创", uuid: "fc83fef2-5249-498f-bae8-517d7220e528" },
  { text: "不会用怎么办？首先不要慌张，打开文档看看。", note: "网络", source: "Coconut Studio", uuid: "b43eb8f4-90ae-4a08-b419-db9a99bac125" },
  { text: "寒蝉是盛夏死骸。", note: "网络", source: "精卫(史诗版)", uuid: "0375ba48-d490-4767-b5a9-dc8ed2c4e29c" },
  { text: "如人间过客，总追着虚无漂泊。", note: "网络", source: "30年前，50年后、烧灯续昼", uuid: "83f38b02-8871-4c67-bb90-68d223265878" },
  { text: "主角永远是靠自己的努力获取成功的，不然还是配角。", note: "原创", source: "归属", uuid: "6b2360cb-c511-4d36-b18c-d3a36f9aa474" },
  { text: "没有任何条件比真的喜欢你更重要。", note: "网络", source: "佚名", uuid: "6ed2bc2e-bb47-4efd-8e99-7ac7e584e96d" },
  { text: "大千世界风景瑰丽，却无人有心欣赏。", note: "原创", source: "沫夏孤水", uuid: "e98bde7d-91d4-4514-9c2f-b0c9731ab99b" },
  { text: "未经审视的人生是不值得过的。", note: "哲学", source: "苏格拉底", uuid: "833a7838-c2d6-45a2-8d01-f7fe9824c9fe" },
  { text: "你的心南极冰，我的泪北极星。", note: "网络", source: "网络", uuid: "67ee3469-c5e4-404b-af9a-813035a1bca2" },
  { text: "遇见你之前，不懂感情；遇见你之后，唯有钟情。", note: "原创", source: "Hvf", uuid: "d9cd17ed-05bb-46bc-9edc-ea025df517d8" },
  { text: "人们终将为其不可得之物穷其一生。", note: "原创", source: "夜雨天梦", uuid: "1eebe58e-9411-43e9-ac3a-036de8c8bc8b" },
  { text: "万般世故难欢乐，一程风景作银河。", note: "原创", source: "清岷", uuid: "7dea35ca-218a-4478-83e0-b63f030cb4ec" },
  { text: "让时间再慢些啊，让笑容常驻啊，让你再近一点啊。", note: "原创", source: "一只叫一行的喵", uuid: "9b284b85-fd82-4113-add2-771d8bc7e99e" },
  { text: "一瓣人间为春困，一樽三州劳梦魂。", note: "网络", source: "楼玉明只是路过", uuid: "5ec16047-c64c-47be-acab-2bf2af4b55a7" },
  { text: "若不爱你，死生无地。若不爱你，青魂可离。", note: "原创", source: "有风来", uuid: "bac14101-c168-49c8-a0db-3b95c5380112" },
  { text: "不要太在意，太在意会开始害怕失去。", note: "原创", source: "Cherri", uuid: "b97a9743-aceb-4763-aa79-5f8aae646984" },
  { text: "我站在阳台抽烟，我吸一口，风也吸一口，可能风也有烦恼吧。", note: "网络", source: "佚名", uuid: "99c01b12-fedb-428f-aced-c9b1d114e9e6" },
  { text: "负断只舟阡陌短，雨淋青瓦深巷中。", note: "原创", source: "刘渤源", uuid: "87af43a0-60cc-42e8-9990-02707b7a5209" },
  { text: "属于我们的童话童年暑假那个他。", note: "网络", source: "小寒", uuid: "c0dd0ef5-9367-43a5-97b2-727fd3c40304" },
  { text: "我们奔跑在曲折的时空，过去与未来发生交折。", note: "原创", source: "原创", uuid: "6989d546-7f28-4774-a24f-83f32714f688" },
  { text: "孤独的人不过都是一厢情愿的伤害自己，然后再感动自己罢了。", note: "原创", source: "西风", uuid: "0e14ce82-ee3e-4d02-98ab-08d2a026cec7" },
  { text: "我眷恋时光沉淀的安宁，憧憬偕老的约定。", note: "网络", source: "日月同辉", uuid: "9735d98b-8435-4399-8a44-ea21cf532faa" },
  { text: "每个人生来都是妄想家", note: "原创", source: "mozei", uuid: "c53f6c01-d633-46f3-90b8-bf32ccf09302" },
  { text: "花开如火，也如寂寞。", note: "网络", source: "——顾城", uuid: "be5845b8-b91d-476d-b0eb-4907dba5e417" },
  { text: "感谢岁月的温柔。", note: "网络", source: "岁月如笔写春秋", uuid: "e97afe18-6df7-46ab-9415-0ea312b6bc39" },
  { text: "没有什么过不去，只是再也回不去。", note: "网络", source: "网络", uuid: "09a8eca7-e241-40c9-9225-f80369bf6902" },
  { text: "我只是想要被平等对待。", note: "网络", source: "精卫(史诗版)", uuid: "c377e48a-342f-43b0-b586-7b9c058521ec" },
  { text: "你曾打马过银河，倒影一百光年长。", note: "网络", source: "李倦容", uuid: "9b1da76b-c8d7-4d79-be68-7da3d7206b77" },
  { text: "你余生未来可以都交给我保管，有你在身边我想我会一直勇敢。", note: "网络", source: "徐重来", uuid: "27b1dfbf-7555-420e-b766-a040108248c9" },
  { text: "和月亮醉个酒，跟狂风不回头。", note: "网络", source: "王健美", uuid: "ca695da0-a3f5-49c6-addb-6e31092724ff" },
  { text: "尽管我会凋零，但至少我盛开过。", note: "原创", source: "菲.lin", uuid: "2897119e-fa5d-4087-a942-ac3281a56949" },
  { text: "远道而来这世间，要把余生献给你热爱的故事。", note: "网络", source: "佚名", uuid: "99cb4b10-df53-4e8c-8816-a81495c438cf" },
  { text: "月光的银边把广袤的夜空烫出个洞，里头塞满了少年的梦想。", note: "原创", source: "余川", uuid: "bfb4d87f-e512-485e-a286-2ffdfa687d30" },
  { text: "落座无言行三载，持笔无悔笑苍生！", note: "原创", source: "SpaceSkyNet", uuid: "4938063a-c968-42b7-acf6-031503fc6b7f" },
  { text: "撸起袖子加油干。", note: "网络", source: "佚名", uuid: "f277f39b-935c-4646-8cf3-efeb5501c3ec" },
  { text: "我是神里绫华的狗！", note: "网络", source: "网络用户", uuid: "dbb6a147-ba14-402c-a0dc-2cfded857ac5" },
  { text: "凉夜晚秋，倚门回首。", note: "网络", source: "廖羽", uuid: "10acbae7-2e3a-449e-8016-41261d04bc6c" },
  { text: "逐梦尽天际，万般非顺意。世间万千法，碾碎赤子心。", note: "原创", source: "雪彻", uuid: "7eca3c46-d0e8-4136-8d7b-2dd8668c3c38" },
  { text: "人生有三大幸事：虚惊一场，失而复得，久别重逢。", note: "网络", source: "无限暖暖", uuid: "41842d27-b4b4-45b9-bd5e-15e74a53bdaf" },
  { text: "逆着光行走，任风吹雨打。", note: "网络", source: "买辣椒也用券", uuid: "3cdf95f2-7911-41e4-b9a6-e6b667ca62ca" },
  { text: "绕远的路，总有风景。", note: "网络", source: "洛谷", uuid: "390a44d1-1b22-453d-93a8-a593ae602636" },
  { text: "错过了一次的人，始终会错过第二次。", note: "原创", source: "侠名", uuid: "b374af21-7c70-4a9b-b27a-3dc80ad09f86" },
  { text: "那个少年也终于做出了自己的选择，开始向他想去的高度前进。", note: "原创", source: "小瑞", uuid: "120a6c03-9d3b-4582-ba1f-2092249818b7" },
  { text: "爱可以穿透时间与空间！堪比万有引力！", note: "原创", source: "刘源", uuid: "9c331d5e-a8e6-41c0-8f92-771a4f501fb0" },
  { text: "既然认准这条路，何必去打听要走多久。", note: "网络", source: "网络", uuid: "ea1f5517-6d4c-492e-a139-ceec3bb17332" },
  { text: "我已经过了会脸红的年纪。", note: "原创", source: "陈树凤", uuid: "0e8a57ae-fb35-4a96-9819-0bf6c72b45a9" },
  { text: "尊严，只在剑锋之上；真理，只在大炮射程之内！", note: "网络", source: "艾跃进教授", uuid: "33737262-9766-4f0d-8101-2cf28a2ce465" },
  { text: "生活就像一桌流水席，可就算是流水席也可以有回头客啊。", note: "原创", source: "Diving_lin", uuid: "d0d911ea-5791-4974-a1d7-b190af82e3fa" },
  { text: "风起了，你却消失了。", note: "原创", source: "叶小楠", uuid: "efbea15f-167a-493f-9d46-af3c402cb1f8" },
  { text: "默默的看着你，听说你，思念你，但我能做到的也仅仅如此了。", note: "原创", source: "别云", uuid: "74a955de-7994-4af5-91f1-70bc5fa1b03c" },
  { text: "岂怪当初来人世，颠沛如今不向生。", note: "原创", source: "做魚玉子燒", uuid: "6808197d-a9ca-4363-a374-bf7c1df67242" },
  { text: "友情也好爱情也罢，如果累了，我们就回到第一天见面的时候吧", note: "网络", source: "佚名", uuid: "fce9d7a5-8f06-4071-9b5e-cb993eaf92ea" },
  { text: "互相心里有对方的人不应该错过。", note: "原创", source: "雅", uuid: "ea873a6c-655d-4964-9ac5-1be7b1fb64a2" },
  { text: "看他们假装深情不久伴。", note: "原创", source: "无言", uuid: "920a151b-29f7-4a9b-aa00-96fd39c41b3e" },
  { text: "不是消失的太阳，也没多少的力量，仍会尽力地发光。", note: "网络", source: "愚人戏社", uuid: "98e467e0-c101-4455-bdcd-d5c3b1890240" },
  { text: "战争考验人类的良知与正义，和平呼唤我们的理性与智慧。", note: "网络", source: "王毅", uuid: "4614026b-9182-417f-b14c-59099f48422e" },
  { text: "尚无凌云志，倒有遨游世界梦。", note: "原创", source: "神", uuid: "9f8244f2-4504-4613-a117-b57c8e290a5f" },
  { text: "我的星星在眼底，赋予了天空温柔的光。", note: "原创", source: "奕之", uuid: "0e556eb8-ba17-4a03-98fc-88a011b77ff9" },
  { text: "文豪野犬的区别，或许在于浪漫，与非浪漫。", note: "原创", source: "朴素", uuid: "b103264e-474f-41b2-a73d-325fdd30b3b6" },
  { text: "我与旧事归于尽，来年依旧迎花开。", note: "网络", source: "佚名", uuid: "2b1e174b-d30f-4871-859a-463a25aaff37" },
  { text: "遵从剧本获取既定结局，突破剧本付出相应代价。", note: "原创", source: "做魚玉子燒", uuid: "11a66e24-b4af-4aa0-b384-80b618b3a300" },
  { text: "快乐是永不忘的呀，抛开烦恼自有解答。", note: "网络", source: "小寒", uuid: "422b10f8-71ee-445a-9910-e803b898294c" },
  { text: "对于讨厌的人不要想改变他，远离他才是上策。", note: "网络", source: "来自网络", uuid: "ae916588-a221-44e8-9b3a-708296c79c43" },
  { text: "不能共苦，还是只是不能和我共苦……", note: "原创", source: "做魚玉子燒", uuid: "5fb63863-dc01-40c7-94be-aec4f495268b" },
  { text: "明天你有可能会忘记自己，那是因为这是一个全新的自己。", note: "原创", source: "瓜瓜乐", uuid: "6f24efc6-9827-4cd4-93e2-4ca2a9a717f9" },
  { text: "后悔是好事啊，说明冲动的事你一件没少做。", note: "网络", source: "峰哥亡命天涯", uuid: "b0d037e4-e722-4a81-abf7-51f245cdad8c" },
  { text: "其实很多人都没去过自己家乡的景点，别问好不好玩了。", note: "网络", source: "佚名", uuid: "a253fb50-0580-46a3-87df-91de3b98f075" },
  { text: "幸福是你一幕幕陪伴。", note: "网络", source: "徐重來", uuid: "aa8d8e74-d185-40a8-a88d-762c10ca2df8" },
  { text: "重重尘世与君哂笑寄残灯。", note: "网络", source: "楼玉明只是路过", uuid: "38b15331-baa4-44bb-a262-0769cc3fcb8d" },
  { text: "活着的意义并不大，但不活着就没有意义。", note: "原创", source: "皮皮参", uuid: "a838b78e-4aab-436c-b445-93d3c7b17b12" },
  { text: "你总说你很累，可谁又过的顺风顺水。", note: "原创", source: "像风", uuid: "5e54aaf8-8098-418d-bd69-903c8e96e373" },
  { text: "十几岁的年纪里，谁都不是谁的一生。", note: "原创", source: "生活", uuid: "37b65a26-093d-4573-8809-49053cc2f62f" },
  { text: "永远坚信，黎明就在眼前。", note: "原创", source: "澈亦", uuid: "471e3a2e-e802-46c1-9e56-16a17b7e9e3b" },
  { text: "书山题海磨砺，且教看锋芒锐。须待蟾宫折桂，疏狂图一醉。", note: "网络", source: "包子不好吃_Official", uuid: "98a1e9cb-5314-47f1-89a4-81539e166b0a" },
  { text: "生命如意志永存，青春永远年轻。", note: "原创", source: "安", uuid: "d31300f7-5474-4a28-8dfb-3922f055346d" },
  { text: "信心这个东西，什么时候都像个高楼大厦，但是里面会长白蚁。", note: "哲学", source: "王小波", uuid: "33b805a1-11b3-4940-8e74-283c08b76511" },
  { text: "生死去留，棚头傀儡。一线断时，落落磊磊。", note: "网络", source: "豆瓣网友", uuid: "3c1212fa-d991-4bf5-a865-ff665b49a7b7" },
  { text: "犠牲を払って、何を救う？", note: "网络", source: "大森元貴", uuid: "df974eb5-8733-48c6-8b0b-c1eb7244f684" },
  { text: "以有涯随无涯，殆已！已而为知者，殆而已矣！", note: "哲学", source: "庄周", uuid: "de606f8f-2d26-4d94-b4b6-efc8262b3f0a" },
  { text: "往事真的不堪回首吗？", note: "网络", source: "Ajiang", uuid: "d37887fb-4820-4f4e-9984-1cb08cd82c05" },
  { text: "信仰与孤独·真正的财富是一种思维方式.", note: "原创", source: "草堂设计", uuid: "07e46ec3-d8f8-4cb5-a017-3a7018405ec0" },
  { text: "努力到无能为力，拼搏到感动自己。", note: "原创", source: "忆", uuid: "ec5e0897-9af3-4585-8032-05610888eb8e" },
  { text: "永远不要活在过去的回忆里；昨天的太阳，晒不干今天的衣裳！", note: "网络", source: "Qihoo360", uuid: "d75b34ae-2e4f-419e-822a-401f8c58e300" },
  { text: "少年一场，是回不去的盛唐。", note: "原创", source: "神", uuid: "a73192d9-ec19-4bb3-a329-3c0655fff279" },
  { text: "鞭炮再响，可哪有我想你那么想", note: "网络", source: "一个转身的距离", uuid: "bf1e88d0-14a8-4c25-8467-aaf4e320dc6e" },
  { text: "我收集了满屋子阳光，因为你是太阳。", note: "原创", source: "小甜酿", uuid: "5ecb4311-f743-4b07-9bd3-48e8132269e4" },
  { text: "通透不是让你看清别人身体结构的，而是让你看透活着的目的。", note: "原创", source: "归属", uuid: "b6866a70-1896-4afa-9f53-6ac4b86f470b" },
  { text: "愿：汝之烦恼痛苦心不在焉，汝之快乐幸福全神贯注。", note: "原创", source: "CANICRY", uuid: "1ca6adfe-deec-4203-873d-949a7738378c" },
  { text: "厌倦了行尸走肉的生活，只想过有血有肉的生活。", note: "原创", source: "山涧", uuid: "2dda386d-d4c5-4e6c-b107-b137c56cd189" },
  { text: "记忆模糊之前，或者去见一面。", note: "网络", source: "nDhnzr6r", uuid: "11c43f28-74a5-45d7-8fa0-b5b7ffc05457" },
  { text: "下辈子变成你喜欢的人，然后不喜欢你！", note: "网络", source: "网络", uuid: "31b3894b-bd34-42b3-8e52-efa0ad445f96" },
  { text: "物质与意识的辩证关系：物质决定意识，意识反作用于物质。", note: "哲学", source: "唯物主义哲学", uuid: "8394d83d-af0c-4757-8f6a-807dab8bdaf6" },
  { text: "低山臭水遇知音，穷山恶水双子星。", note: "网络", source: "网络", uuid: "deeff1f6-b563-4ec6-8294-4453016c11ba" },
  { text: "鲁迅：我没说过这句话。", note: "原创", source: "我是皮皮参", uuid: "f6821e26-6ccd-4eda-9afd-97dd6edd5761" },
  { text: "花会沿路盛开，以后的路也是。", note: "网络", source: "流浪猫治愈记", uuid: "2c938005-1bb2-475b-b016-519dd72c9712" },
  { text: "有些故事没有结尾，可沿途的风景依旧很美。", note: "原创", source: "佚名", uuid: "9ad912fe-407f-43e6-9a06-2240029d16a3" },
  { text: "有些人坐飞机就能见到，有些人坐时光机才可以。", note: "网络", source: "网络", uuid: "e92b1e11-b626-4ebe-bab5-922ed9a2ef0e" },
  { text: "当人觉得自己看不到前途时，其实已经看到了前途。", note: "网络", source: "Coffee_zzz", uuid: "a50091ab-0ce2-408c-bb1b-c8ee272dad75" },
  { text: "人间千百事，落得花间酒。不知礼乐坏，不得道德法。", note: "原创", source: "璃墨", uuid: "03bf261c-e6d3-4ba6-827c-c24f847a86f5" },
  { text: "谁曾想，再见，竟是再也不见。", note: "原创", source: "LJS80", uuid: "e50daef0-a1e3-4b63-9280-fa9a6b05325a" },
  { text: "记性太好，有时候是一种负担。容易忘记往事的人，是幸福的。", note: "网络", source: "九ちのセカィ", uuid: "0158cf66-2605-4409-892b-a999287b340f" },
  { text: "不为梦想本身奋斗。为那个提出梦想的自己。", note: "原创", source: "pokon548", uuid: "44f98b9b-d209-42d4-9abc-f444677228bf" },
  { text: "但正是因为他曾经享受过光明，所以他才如此惧怕黑暗啊！", note: "网络", source: "炸天帮奥特堂堂主", uuid: "af563f36-eea0-44f1-b001-59e96c58f4b4" },
  { text: "其实结束并不是真正的结束，而是美好的开始。", note: "网络", source: "1sdaxf", uuid: "968efb3a-3f96-45c3-b57e-a93d89fd9d59" },
  { text: "以眼还眼，世界只会更盲目。", note: "哲学", source: "圣雄甘地", uuid: "bfe830d7-60c3-4a43-a660-75926f157c8f" },
  { text: "在深空里，死寂比交响更可怕。", note: "原创", source: "yzuyuz", uuid: "0715708e-1cc9-4f73-9672-9765f63e7aa7" },
  { text: "没有真正的快乐，除非找到……你爱的那个人。", note: "原创", source: "绎泽", uuid: "a66a75a4-44ea-42e4-8489-be2c5c03d84b" },
  { text: "出入相友，守望相助。", note: "哲学", source: "每日一习话", uuid: "c6d9d4c5-4634-4755-b01b-2fdc7ed11050" },
  { text: "哲学家们只是用不同的方式解释世界，而问题在于改变世界。", note: "哲学", source: "马克思", uuid: "abc4f7af-23ef-4a2b-8364-e1956f2024b9" },
  { text: "被风吹散的思念，卷起不羁的时间。", note: "网络", source: "一个无归期的人", uuid: "d1c03047-a32d-4371-aa52-c48b3401895e" },
  { text: "星海无垠，与君乐饮。", note: "网络", source: "kaibo yu.", uuid: "73f20068-409d-44b3-a739-82c7bf89c0f5" },
  { text: "你我之间就像VIP的试听片段。", note: "原创", source: "土豆泥椰", uuid: "ab1d7579-e8ce-4948-9041-8eff7965de7f" },
  { text: "受伤的次数多了，就知道自己保护自己了。", note: "原创", source: "xy0313", uuid: "507a1dca-98e9-4417-b882-85d20ccb7b0b" },
  { text: "再深的感情终是黄粱一梦。", note: "原创", source: "蓝麓", uuid: "1b1cceb4-a84b-427c-9914-2537876aa390" },
  { text: "人恰得亏，戏不好看。", note: "网络", source: "网络", uuid: "1fbb2890-2dc2-457a-a9cb-96882a109958" },
  { text: "当晚睡规律起来，就不算熬夜了。", note: "原创", source: "ZainCheung", uuid: "485b5b8d-e9e4-4b71-9656-9a87b2d9c3b6" },
  { text: "无论如何轮回做出选择，终将还是会后悔。", note: "原创", source: "HUAMBAKA", uuid: "a7d689b8-9006-481e-8a9f-71de7b844b0c" },
  { text: "充满着无尽的能量与自信，向着未来出发", note: "原创", source: "涓尘", uuid: "04ba0062-0127-49a9-bedd-d7c6d56f3df5" },
  { text: "人即他人之狼。", note: "哲学", source: "霍布斯", uuid: "68a9bf8d-cc70-4af9-ad33-66f1b4c3f623" },
  { text: "如果你能从浪费时间中获得乐趣，就不是在浪费时间。", note: "哲学", source: "罗素", uuid: "255fdcb5-02ec-4128-ba35-9079487e8c1b" },
  { text: "人的一切痛苦，本质上都是对自己无能的愤怒。", note: "哲学", source: "王小波", uuid: "b35caca2-09b3-4728-9f22-8ae4684a8153" },
  { text: "青春贵吗？贵在——后来所有的黄金，都买不起那一日的黄昏。", note: "原创", source: "神", uuid: "9dd302cb-6b59-421b-89e2-09a6123791dc" },
  { text: "限时已范闲，追随勇不乱。", note: "原创", source: "一曲横笛", uuid: "9a5d2490-f9c4-4179-b48a-6853f423d2c1" },
  { text: "等风来，希望雨别下。", note: "原创", source: "森木志", uuid: "ae9b1c11-33b8-425d-822c-d355bd3761df" },
  { text: "愿余生常相伴不负这份宿命。", note: "网络", source: "日月同辉", uuid: "dddc28d0-cdde-4f2b-8386-4f090685789f" },
  { text: "这次我终于解脱，等到了这一刻。", note: "网络", source: "程佳佳", uuid: "610060ba-92d6-4b18-b8df-ecfb6cc838cb" },
  { text: "多动手，没什么难的！", note: "原创", source: "请叫我仓鼠阁下", uuid: "b884fcfa-4879-4096-a50a-d130370b2f04" },
  { text: "熬得住无人问津的日子，方可配得起诗和远方。", note: "哲学", source: "杨绛", uuid: "41cfceca-8e92-42a6-bb4e-cdb1bf0e1e24" },
  { text: "我手起刀落的时候，也会有这样的微醺感呢。", note: "原创", source: "子安", uuid: "e1dd900b-203b-466e-b98b-e16870f9c7be" },
  { text: "我们等待着戈多，在等待的过程中发现戈多就是等待本身。", note: "哲学", source: "王希明", uuid: "9da62009-3d8d-4670-a6f9-7419d0abdce4" },
  { text: "我拿着杀虫剂，蜜蜂能感受到我的善意吗？", note: "原创", source: "zhiyu", uuid: "13376db4-c511-4c22-98b0-4974442f9bed" },
  { text: "愿生活即使周而复始，也有意气相投的知音。", note: "原创", source: "VeilCode", uuid: "b9a9c440-bd34-4df1-b108-5b0badbf6a31" },
  { text: "成长的过程就是人生的意义。", note: "原创", source: "玖⁠", uuid: "15949933-d725-45a8-b3ca-690584389dda" },
  { text: "吃得酒肉饱，来听僧谈禅。", note: "网络", source: "网络", uuid: "75788992-ec3d-438d-abf2-f36b4d9109af" },
  { text: "智慧只能使人免于无知，不能使人免于痛苦。", note: "哲学", source: "洞穴的囚徒", uuid: "6f36ef09-a09a-4089-b925-d6c4610313bc" },
  { text: "浮世之行，寻星之旅。", note: "原创", source: "浮世之旅者", uuid: "304518a3-260d-406e-9f76-d13ec57edd3a" },
  { text: "直到看见她和别人恋爱的模样，才发现自己从来没被爱过。", note: "网络", source: "佚名", uuid: "71b0fb3a-5f96-4f50-ba8f-2599b48634cd" },
  { text: "如果预计中的不幸没有发生的话，我们就会收获意外的喜悦。", note: "哲学", source: "叔本华", uuid: "09636259-5f9e-4e5e-b78a-48bedf0e3bf3" },
  { text: "都已立秋，又何必执着于夏天的故事。", note: "原创", source: "慕凯viel", uuid: "d7c9ce8c-4ca8-4c26-985e-3bb06db33192" },
  { text: "你可以不学习，但你的竞争对手不会！", note: "网络", source: "网络", uuid: "8d7fa99e-90a6-4da4-9799-0cf70bd3c1a9" },
  { text: "我当真能担得起，少年人这个词吗？", note: "原创", source: "山涧", uuid: "85762a66-7d16-4aed-938e-6447b9c80c6e" },
  { text: "历尽千帆皆不是/随北星到此/不易/停风惟你。", note: "原创", source: "鹤空流乂", uuid: "d6a534a6-da90-492e-bcae-f4d1dab656c3" },
  { text: "走完同一条街，回到两个世界。", note: "原创", source: "雅", uuid: "3b41e7db-918b-4e69-9cc9-f7f6c10aa6bd" },
  { text: "守口如瓶，包括对自己。这是一种美德。", note: "原创", source: "原创", uuid: "a600d24c-57fb-4c9b-9e71-13f922aa16eb" },
  { text: "我们是独立的个体，却不是孤独的存在。", note: "哲学", source: "千里共良宵", uuid: "739cb56b-3e22-4dbe-b018-861acf248b2e" },
  { text: "无论是丢下还是被丢下，都是一样痛苦的。", note: "网络", source: "网络", uuid: "de3678e6-ca91-4d06-bee0-904fe4762060" },
  { text: "小时候词不达意，长大了言不由衷。", note: "网络", source: "网络", uuid: "d5ba5a37-c078-4f9f-8605-a4da38acc2e2" },
  { text: "如果惧怕前面跌宕的山岩，生命就永远只能是死水一潭。", note: "网络", source: "佚名", uuid: "afd29f3c-ada8-4939-acee-641494fe945f" },
  { text: "如果本来就知道是结果失败的，那为何还要尝试呢？", note: "网络", source: "佚名", uuid: "db9d96f8-8991-4ca7-bfc5-13478ce7d761" },
  { text: "事與願違，安天命乎？", note: "原创", source: "朴素", uuid: "6fb02480-5790-4329-a283-625cbded6faa" },
  { text: "山风山风等等我，带我去山那头。", note: "网络", source: "王健美", uuid: "0ba22bd7-c3a9-4a30-8de4-c7b7937c5845" },
  { text: "得到得太容易，失去得不经意。", note: "原创", source: "帆仔", uuid: "870506b2-a7a9-4344-8662-21469ad8ade0" },
  { text: "无数次举起我的小天才手表，可是依然找不到你的电话号码。", note: "原创", source: "Cheshrin", uuid: "3897da0d-edf4-44fb-b658-082056840614" },
  { text: "仅仅是沉溺于过去，那么，一个人将没有未来。", note: "原创", source: "pokon548", uuid: "7f4ead86-1a8b-4002-9b07-1fe3218dae71" },
  { text: "也许我们终将行踪不明，但你该知道，我曾为你动情。", note: "原创", source: "晨曦", uuid: "b6bbeab4-33fd-481a-a412-d59d1fd68488" },
  { text: "生活的洪流欲让人们窒息，我们却在缺氧的环境中肆意成长。", note: "网络", source: "网络", uuid: "9d15ee7c-b08b-4bb0-bdea-50642a0fb5bf" },
  { text: "始无弱，盛极衰，和以中之大同。", note: "原创", source: "朴素", uuid: "ca732780-6636-4caa-8c16-ebd41e03f9dc" },
  { text: "如果真的失败了，请总结自己\"为什么会失败？\"", note: "原创", source: "原创", uuid: "4bc2b2f1-b480-44ba-80f0-9171d71ca9b9" },
  { text: "我已经很乖了，自己把全部的委屈和心酸都宣泄在黑夜里。", note: "网络", source: "网络作者", uuid: "a3045c3a-ac0a-4598-8e79-8403ec3a9727" },
  { text: "世界上没有鸟黑，只有鸟厨和丧心病狂的鸟厨！", note: "原创", source: "树形图设计者", uuid: "90a1ba14-70d1-4c39-a6f0-3a6f11addf21" },
  { text: "一无所有的人，说什么来日方长。", note: "原创", source: "鬼绿", uuid: "42f5e83c-f53d-466f-9629-6a2490e4c646" },
  { text: "结果需要的是一个开始。没开始说什么都是废话。", note: "原创", source: "朴素", uuid: "b842a9c8-1c6c-43be-90fd-1d309d0a52db" },
  { text: "已逝者怀抱着爱撒手人间，未亡人背负着爱向死而生。", note: "网络", source: "佚名", uuid: "e8acb55d-1d32-48c0-ab11-4b9ae6364a99" },
  { text: "万事开头难，然后中间难，最后结尾难。", note: "网络", source: "网络", uuid: "b031a9d3-61a6-4635-97bd-0ca3c45f2a15" },
  { text: "我的小伙伴们都惊呆了！", note: "网络", source: "网络", uuid: "7043bde9-0a0f-4de8-a65a-6415890c9da0" },
  { text: "真正珍惜时间的人不会找任何借口……可惜我不是。", note: "原创", source: "原创", uuid: "dbc37737-8085-45a4-a7e7-fc6927134316" },
  { text: "娇娘在器，道蕴天下；蛮子入腹，世临主意。", note: "原创", source: "朴素", uuid: "b87077b9-cbde-4c51-9c82-347159bd4504" },
  { text: "清醒便是原罪。", note: "网络", source: "佚名", uuid: "e17518a3-18d1-44ce-b261-c34f8e273b43" },
  { text: "好好学习，天天向上。", note: "哲学", source: "毛泽东", uuid: "9a623335-f120-4912-9dea-68148bd02b90" },
  { text: "一件事物与其自身完全一致", note: "哲学", source: "逻辑哲学论", uuid: "2f5aac92-0b05-44bc-aaa0-93af289337cd" },
  { text: "舌头无骨却是伤人最深。", note: "网络", source: "不知名网友", uuid: "ee015470-85e8-4017-bef9-1b7c72c1fcf7" },
  { text: "无垢清净光，慧日破诸暗，能伏灾风火，普明照世间。", note: "哲学", source: "鸠摩罗什", uuid: "4a14fd11-9e45-4935-bd16-da864c361fe9" },
  { text: "我想要个潇洒的以后。", note: "网络", source: "王健美", uuid: "60e6cc7e-f7d5-4f8b-bb18-67643543ec55" },
  { text: "他乡纵有当头月，不及故乡一盏灯。", note: "网络", source: "闫浔", uuid: "3e4d48ff-5ae7-4d16-ab52-8a60de3d25c6" },
  { text: "人都有两面，一面天使，一面恶魔。", note: "网络", source: "网络", uuid: "7f9a69b6-fc4a-4492-8482-59a9eac35383" },
  { text: "再逛逛呗，没准就找着了呢？", note: "原创", source: "白热背景辐射", uuid: "3d6fadf5-0f32-4acc-ae55-249e557d140d" },
  { text: "我们所爱之物昭示着我们究竟是谁。", note: "哲学", source: "托马斯·阿奎纳", uuid: "ae85ec0a-4e0d-45a5-900f-850d2ee89bfe" },
  { text: "十里佳酿千里醉，九尺暖阳半寸寒。", note: "原创", source: "一只叫一行的喵", uuid: "0f740680-4676-4283-8097-b9359a1b5a3f" },
  { text: "爱一个人，就让自己变得明亮，给她带去光明。", note: "原创", source: "柳柳", uuid: "8f11877e-dddd-42f6-9b1c-56be30fe04ff" },
  { text: "只要你不停下来，走得多慢都没关系。", note: "网络", source: "网络", uuid: "29b0763c-2a6d-4f8e-af84-b1c6685886c2" },
  { text: "站起来吧孩子，没人会看见倒下的人。", note: "原创", source: "凡ICE", uuid: "958a78cc-eca1-4f56-b441-7d1a2ba09ea4" },
  { text: "没有信仰的夜晚是充满厄难的白天！", note: "原创", source: "朴素", uuid: "ad4c0334-b725-456c-bb1a-d32801783794" },
  { text: "只要你不混乱，时间永远够用。", note: "网络", source: "网络", uuid: "36c1ab75-d502-401a-ad5c-0a89dbaebd6e" },
  { text: "每个说不找对象的人，心里都藏了一个不可能的人。", note: "网络", source: "网络", uuid: "1afa0b85-f617-4a63-af41-8380a3710be0" },
  { text: "有时候，你不得不停下来，回头看看你走过的路。", note: "网络", source: "网络", uuid: "7cd641a5-ba82-4ae6-85df-7cfa7e56bd37" },
  { text: "若不追忆，则从此听不到那年华里，谁的叹息。", note: "网络", source: "耳根", uuid: "f3089f50-0632-4f4e-9b43-6da79ffdefa6" },
  { text: "遵从内心，做你喜欢的，见你所爱的。", note: "网络", source: "佚名", uuid: "ee0360b9-6ee1-45c5-92be-9a2079e285b1" },
  { text: "人性一个最特别的弱点就是：在意别人如何看待自己。", note: "哲学", source: "亚瑟・叔本华", uuid: "96ad5c2f-ad9f-4f2b-a9c8-987af784442e" },
  { text: "美在盛世烟火，人间喧嚣，他们终成遗憾。", note: "网络", source: "佚名", uuid: "6c16ad82-57c5-40e1-8496-ae23836fe473" },
  { text: "你若愿爱，我若无悔。", note: "原创", source: "后会无期", uuid: "55138601-c16f-47c9-92a9-b2d5f7e2e2af" },
  { text: "飞花落雪皆不见，眸中唯有一人现。", note: "原创", source: "墨隐", uuid: "7f041124-0223-48fc-8660-04563496829f" },
  { text: "不见晴日争与夕，天阴四处皆萧景，近冰点，入隆冬。", note: "原创", source: "storm1614", uuid: "4ac764dc-6c3f-4d5b-bea5-43a716d241b5" },
  { text: "就算是阴雨天，晾在阳台上的衣服，也会有干的时候。", note: "网络", source: "是老胡没错", uuid: "1cc9ea59-bcd7-4092-8c17-d77d7a830580" },
  { text: "那么，问题来了…", note: "网络", source: "中国山东找蓝翔", uuid: "1033b1b6-9896-486d-8ac9-8262f0ca4b26" },
  { text: "花开不争艳，叶落不悲秋。", note: "网络", source: "现代佚名", uuid: "70246ce2-ac16-48af-b56c-482b29ec8957" },
  { text: "我们可以感同身受，但扶不起一个跌倒的人。", note: "原创", source: "NebulaDreamer", uuid: "016a3c5b-ce1f-4e71-9fdb-5afda09bf25c" },
  { text: "我可以孑然一身，但不能心无所属。", note: "原创", source: "呼呼呼呼兔", uuid: "259b1cdf-9788-43f0-9c64-fb4e6187cd15" },
  { text: "这一次，我试着向你奔来，不问归期。", note: "原创", source: "葭樱", uuid: "945fd0da-b5a6-44c2-9c65-328e6e05766c" },
  { text: "我要逃离世俗的烦忧", note: "网络", source: "疯狂的羊", uuid: "367835fc-a573-4081-807b-4cbc4f00beff" },
  { text: "假使让ta的爱回归，你的心过得去吗？", note: "原创", source: "终究", uuid: "76fff68e-5740-4b70-a837-404958a8fae7" },
  { text: "我们都为了自己而生活。我们我为了梦想而拼搏。", note: "原创", source: "Xun", uuid: "7c7022bf-c14c-4ed9-b4e7-8146e82c9c72" },
  { text: "我喜欢猪，狗崇拜人类，猫鄙视人类，猪对我们一视同仁。", note: "哲学", source: "温斯顿·丘吉尔", uuid: "597dde98-facb-4e50-887a-3582c276a81b" },
  { text: "繁华落尽如烟花坠落。", note: "网络", source: "你有没有真的爱过我", uuid: "05b7c026-125d-47a1-9c84-eeb918529dd1" },
  { text: "倘若爱不可能有对等，愿我是爱得更多的那人。", note: "原创", source: "茶褐", uuid: "e9a2f575-f167-46f7-ad2f-7c0869d381d4" },
  { text: "纯音乐，请欣赏。", note: "网络", source: "周仁", uuid: "8f76dfe5-0f1a-4cac-80a2-9a04776660d1" },
  { text: "永远相信美好的事情，即将发生", note: "网络", source: "XiaoMi", uuid: "8cd68879-4fcb-48d1-a76f-cca5d7c22060" },
  { text: "放弃也是需要勇气的。", note: "网络", source: "网络", uuid: "2d3b0e40-4a87-496c-a7cd-5a3743428a23" },
  { text: "大英警察进小学。", note: "网络", source: "蜥蜴人", uuid: "d2c6ffca-f207-480a-ae29-9ee3cd35da6b" },
  { text: "世界真的要命，而我假的要死。", note: "原创", source: "浮空花园", uuid: "5dea5cd5-e868-4c84-9d7c-d47635f1b160" },
  { text: "你还欠我一句对不起，可我不会再说没关系了。", note: "网络", source: "网络", uuid: "b5bbc608-ec1f-4f0f-a1e9-e10753226da3" },
  { text: "我游走于无数灯火间隙，这是最夺目的光彩。", note: "网络", source: "为了拍到烟花爆炸中心的画面，我们", uuid: "a304aada-195c-438d-b559-6f7b0d6849cf" },
  { text: "最美好的瞬间，莫过于有你在我身边。", note: "原创", source: "凤凰", uuid: "e98721e7-9d2b-448c-9e3a-15de9e24c709" },
  { text: "或许此刻需要“推力”来成长。", note: "原创", source: "朴素", uuid: "d8d7b264-3229-4522-b89d-893a89420df8" },
  { text: "长大了，就要自己做决定，哪怕是艰难的决定。", note: "网络", source: "老番茄", uuid: "2488e60c-8216-44d9-a465-abf198665bf4" },
  { text: "形如野马色如碳，千书木兰太上权。", note: "原创", source: "seyi", uuid: "c8ff3782-3153-4261-824a-2cbe1c60c886" },
  { text: "我早已踏过深渊，又岂会畏惧黑夜!", note: "原创", source: "zmal", uuid: "b47df580-d0df-4561-b6d0-040e5a5b4853" },
  { text: "我们没有相见，却是此刻最好的相聚。", note: "网络", source: "日食记", uuid: "a550694a-a373-4e8c-aabf-82fc76318140" },
  { text: "找回当年的朋友，风雨再兼程。", note: "网络", source: "我的纸飞机", uuid: "0cabc4a6-ac44-46db-86b2-12e7d9554d6a" },
  { text: "相遇不一定有结果，但一定有意义。", note: "原创", source: "楠枫", uuid: "4432c823-425c-49b1-b7a6-4f0b556d4914" },
  { text: "一言的语言都会不断变换，何况你的心呢。", note: "原创", source: "Deep sea", uuid: "8c8f4e7a-a474-4f4c-bed9-f302361b469c" },
  { text: "祝你此生，梦想光芒，野蛮生长，永不彷徨。", note: "网络", source: "佚名", uuid: "d91b73b7-e2b1-4266-8cb0-40470533e06b" },
  { text: "习惯性的回头，想起你已经不在了。", note: "网络", source: "清巳星嵐", uuid: "8350d829-dec4-435a-aeeb-effd7e5eb388" },
  { text: "不管人生呈现出什么样貌，人生的构成要素都是一样的。", note: "哲学", source: "叔本华", uuid: "48a1ad9c-54eb-4dd9-a389-c2e12c7244a8" },
  { text: "没有激流就称不上勇进，没有山峰就谈不上攀登。", note: "网络", source: "佚名", uuid: "f1e56e9f-0291-446e-af29-1f91894e1700" },
  { text: "做不了天才，那就努力成为人才吧！", note: "原创", source: "秋白", uuid: "aeeed9cd-be64-4224-8280-c57692e5630d" },
  { text: "一瓣人间为春困。", note: "网络", source: "楼玉明只是路过", uuid: "94cea551-7d71-4df2-8716-5dbe274b24f6" },
  { text: "不敢正视你的眼睛，是怕我每一个眼神都在告白。", note: "网络", source: "九ちのセカィ", uuid: "e76de41d-d875-431d-8d1c-01b11e678c05" },
  { text: "总有一些东西，要用消失来证明珍贵。", note: "网络", source: "小翊韩墨", uuid: "b29fa209-95eb-452c-85cb-c8ce596b9d62" },
  { text: "小孩子看了根本把持不住！", note: "原创", source: "李狗蛋儿", uuid: "a713047d-ee9c-4313-8379-2169341eaaad" },
  { text: "用代码表达言语的魅力，用代码书写山河的壮丽。", note: "网络", source: "一言", uuid: "75a45fd4-4f2f-45eb-80cb-6f0a7bcdfaf2" },
  { text: "梦，随时生，随实灭。", note: "原创", source: "墓封影", uuid: "918eabaa-247a-4612-a51a-36687aa91a4d" },
  { text: "持道而修，不可议其。", note: "原创", source: "朴素", uuid: "4316372f-f9db-481c-be29-62fc286ac5d3" },
  { text: "要走的，不挽留。留下的，我珍惜。", note: "原创", source: "一个无归期的人", uuid: "2ba887e1-b8c2-436b-bc73-218babe3a5bd" },
  { text: "闲暇阅几页，读几篇书。", note: "网络", source: "精卫（关中王进行曲）", uuid: "8662ab92-3cb4-4290-af18-00cabf5e2edf" },
  { text: "用宏大的世界稀释痛苦，用微小的事情感知幸福。", note: "网络", source: "网络", uuid: "1c441b4b-5785-4d6f-99e0-c5aeedad3371" },
  { text: "最好的感觉，是有人懂你的欲言又止。", note: "网络", source: "网络", uuid: "5f98cc78-af6d-47fb-979e-da2d45d609a2" },
  { text: "一个人唯有身处烈火中才能领悟做人的真谛。", note: "原创", source: "本人", uuid: "b3bf4683-97c7-4f51-abda-750b07a9cf98" },
  { text: "忘掉一个人的劣根性就像把千辛万苦赚来的钱扔掉一样。", note: "哲学", source: "叔本华", uuid: "a3aad3af-9ae9-46af-9296-ceedca152d34" },
  { text: "云渺渺，山茫茫，道阻风雨长。故地重游人却徨，不似少年徉。", note: "原创", source: "黔中极客", uuid: "1651eff2-b6a9-4e2b-ace3-279ec74cf6a4" },
  { text: "长夜路漫漫，仍有天亮时。", note: "原创", source: "无魂人士", uuid: "789fe570-c7cc-4c0c-b280-b6ff80eabe9d" },
  { text: "淌着泪河，沉沦沉默。", note: "网络", source: "万物终归", uuid: "703ee3a9-0ff1-4652-b1f7-5a5724fb20dc" },
  { text: "cd ~ #世界很大，记得回家。", note: "原创", source: "江南", uuid: "6c0f6dd0-d9ec-41ef-9d99-16f3aff0fb70" },
  { text: "所谓辉煌的人生，不过是欲望的囚徒。", note: "哲学", source: "叔本华", uuid: "94422198-895d-459f-98e2-f0d36bb52f21" },
  { text: "幕君左而定计，不使己陷囹圄。", note: "原创", source: "Pusu", uuid: "33640820-9a3e-481c-9fe7-65c2de892bb8" },
  { text: "晚安，只能自己對自己說了，再也沒有任何人，能讓我晚安。", note: "原创", source: "做魚玉子燒", uuid: "74bb0172-21b3-4899-8bf3-d470ef081cf7" },
  { text: "一念放下，万般自在。", note: "哲学", source: "弘一法师", uuid: "065747fb-4633-4023-9664-862a76f9a13c" },
  { text: "可以回头看，但不能回头走。", note: "网络", source: "网络", uuid: "9ad3089f-1edf-418a-bd32-26dd3e2ec0ba" },
  { text: "闹脾气的是我，最后难过的还是我。", note: "原创", source: "一个无归期的人", uuid: "9cb4ab14-8988-43d8-bd77-75951485bdc2" },
  { text: "九分真实的话语是最纯粹的谎言。", note: "原创", source: "抱月", uuid: "f88ad64b-f38e-43cb-b532-345480f462ae" },
  { text: "我只是五行缺驱动程序，别说我怠惰。", note: "网络", source: "网络", uuid: "0dca9bf0-42d9-405f-b9ae-f89b40808d29" },
  { text: "我们之间的故事不多，这回忆的漩涡，快要把我吞没。", note: "网络", source: "三七", uuid: "54e25949-e709-458f-b762-18e2f053032a" },
  { text: "我愿意给你自己所有的快乐，你愿意分担我一半的难过吗？", note: "原创", source: "getweb", uuid: "06f8eaf8-bbc8-44f2-bdff-e8666120d088" },
  { text: "遥远的距离使我相思成灰，阴阳的间隔使我欲哭无泪。", note: "网络", source: "佚名", uuid: "a227797f-f1f0-407f-a6e1-a13c76cfda00" },
  { text: "我来见你的时候，没想过你会不开心。", note: "原创", source: "茶褐", uuid: "3c22bf77-ad6f-4444-9635-793fc9697ed4" },
  { text: "时光清浅处，一步一安然。", note: "网络", source: "愿时光清浅，许你安然", uuid: "82ad3814-4857-48c7-bbe2-b86341e69652" },
  { text: "真理只有一个，它不是在宗教之中，而是在科学之中。", note: "哲学", source: "达·芬奇", uuid: "dea41a02-0c93-438f-b381-90f6e4a4e98c" },
  { text: "此番怅然才满月，桥断泉黄不入尘。", note: "原创", source: "做魚玉子燒", uuid: "dfa61505-bee7-4729-8106-099efa6e2faf" },
  { text: "做人潇洒一点，别为了一个不爱你的人浪费感情。", note: "网络", source: "佚名", uuid: "689465f7-5dde-4df6-8971-95b94add337d" },
  { text: "活着就是为了改变世界。", note: "网络", source: "Apple", uuid: "417baaf9-c1a5-498f-b2c3-ac95f76af920" },
  { text: "重要的事情，你怎么不做呢？", note: "原创", source: "vasvdfg", uuid: "35ef7d69-5771-4869-b9f9-d843bc91d3df" },
  { text: "其实地上本没有草，走的人少了，也便长出了草。", note: "原创", source: "雄龙ztz", uuid: "0e4107c0-651a-4c29-8df5-0cb2ca8800d9" },
  { text: "唱一回琴声温柔 莫再回首。", note: "网络", source: "郑明河", uuid: "e07a8759-1b5f-46d8-9ea1-122663f39c1e" },
  { text: "一滴温度合适成分一致的盐水不能被称之为眼泪。", note: "网络", source: "网络", uuid: "b64324a8-780d-41e5-8555-1e530edd6250" },
  { text: "我愿将歌化作风，聆听朗朗的春声。", note: "原创", source: "村花上树", uuid: "bbe6102c-af5b-4e32-99a8-fd3777b24ce9" },
  { text: "我想伟大的思想家确实有同样的想法。", note: "哲学", source: "postman开发人员", uuid: "0ef5bfd0-0bbf-4e76-a72e-556828a4d9c8" },
  { text: "愿你无所畏惧，向阳而生。", note: "网络", source: "佚名", uuid: "41d87fe8-6247-4f03-a4ad-fbf8d8e6f7d6" },
  { text: "冬祀孕春，阳生复始。", note: "原创", source: "朴素", uuid: "0c883fb0-f5c6-44e7-a9e8-a081a91845c2" },
  { text: "君子当自强方成事。", note: "原创", source: "朴素", uuid: "73871f6e-2379-441e-b34d-7e8d330e5bd2" },
  { text: "奇怪的是，当他死去，所有人才开始爱他。", note: "哲学", source: "崔雪莉", uuid: "8ecd9ac2-8685-4991-a6a6-3c75cbc0e118" },
  { text: "想君眉眼起轻尘。", note: "网络", source: "楼玉明只是路过", uuid: "bd077d89-22a5-4f38-9d13-2968d055c1e9" },
  { text: "人生路漫长渡，江河东流不息。", note: "原创", source: "江上悦峰", uuid: "87a364f2-1d31-4224-92b9-102315eb110e" },
  { text: "不去占有就是最好的拥有。", note: "原创", source: "青岑", uuid: "ec5cf8ed-232a-415f-8987-df84af0542d7" },
  { text: "其实每个女孩身边都有张万森，只是女孩不想承认罢了。", note: "网络", source: "佚名", uuid: "4e1f6cde-8857-4301-802f-c3c6f87ffa66" },
  { text: "你要乖，要长大，要不负众望。", note: "原创", source: "耽萌", uuid: "33a50389-e7ec-4c45-9c19-8c9267493294" },
  { text: "被光所引，为光而行。", note: "原创", source: "Tianmoy", uuid: "0e2f300e-1371-49f0-aeed-fb52311480ab" },
  { text: "月摇江湄，你回首花落梦碎。", note: "原创", source: "无心", uuid: "e8edb49e-fa7d-41f6-b31c-71a851e1aa22" },
  { text: "每个人的身上都有太阳，重要的是如何让它发光。", note: "原创", source: "Seddy", uuid: "308efb4c-ef95-4ff2-a502-8f6b756eb2ea" },
  { text: "再自信的人都会觉得自己还不够好", note: "网络", source: "网络", uuid: "06a2453c-70c9-488c-8fe6-040de22c9bee" },
  { text: "这对青少年的影响不可计量！", note: "网络", source: "网络", uuid: "40b77391-d362-4b5b-9dad-92079da467c1" },
  { text: "当你看着镜子的时候，镜子里的你也在看着你自己。", note: "原创", source: "曹博睿cbr", uuid: "e352ddd1-8f1d-437d-934a-dc996ba11324" },
  { text: "人生总是聚少离多，我至今仍然无法习惯。", note: "原创", source: "原创", uuid: "26b6c84a-072b-4cd2-bf6f-324ceb27c20b" },
  { text: "喜欢你，是喜欢你，不是喜欢和你一模一样的任何人。", note: "原创", source: "nDhnzr6r", uuid: "18862664-b866-40b4-a786-bbb1f4286f7a" },
  { text: "并非只有能毁掉你的才值得敬畏。", note: "原创", source: "纤素丶", uuid: "bb8d2acc-9d2e-4f2f-ab63-9f4010c88dc1" },
  { text: "仰望星空，接轨宇宙。", note: "原创", source: "CraSice", uuid: "195e6da9-b70a-49e7-8071-01712d81774d" },
  { text: "其他与我无关。", note: "网络", source: "周梦忆", uuid: "1c03dce6-8e12-4fb2-9023-b1c9475ebfd4" },
  { text: "当星星变成星空，梦想也就近在咫尺了。", note: "原创", source: "一只叫一行的喵", uuid: "2cbcdf76-6833-4da0-b23c-3b34d8f4693d" },
  { text: "我现在已经不做自己的梦了，有时候我觉得我是你。", note: "网络", source: "小蝴蝶音", uuid: "577ca280-2df6-44ba-ab17-de7ca9e3aeff" },
  { text: "每一个不曾起舞的日子，都是对生活的辜负！", note: "哲学", source: "尼采", uuid: "5a894539-2203-476d-9881-7671e92ac95f" },
  { text: "虽然我的心脏停止跳动了，但它不会停止爱你。", note: "原创", source: "残灯晓霜", uuid: "cd3b8d01-6d2b-4c4d-a313-8bf9ac1a2819" },
  { text: "我不知为何，疯狂对你执着。", note: "网络", source: "三七", uuid: "7435afd1-14ff-4654-8fb0-7222bcc1eca6" },
  { text: "人为什么会在极端的天气下感到兴奋。", note: "网络", source: "网络", uuid: "d187fe6f-8823-4129-92f4-12501302327d" },
  { text: "自己选择的路，跪着也要走完", note: "原创", source: "原创", uuid: "f6517b2c-6bf5-4d25-84b3-39e70aa82a37" },
  { text: "伴随神的是孤独，好在世上不止我一位神，还有你。", note: "原创", source: "nDhnzr6r", uuid: "dcfb9046-4cfc-4d37-934a-1b1c2118f7ca" },
  { text: "身处谷底有谁能分清我在哪片迷雾里。", note: "原创", source: "夜杏", uuid: "d1aca3f8-f6ea-4ef8-ac7c-7e312d9399cc" },
  { text: "细雨纷纷雾蒙蒙，不见桃花红，恍然相逢往昔光景。", note: "网络", source: "蓝乐", uuid: "071676b7-cc1e-420f-ab54-d41003b7e193" },
  { text: "为了能体面地死去而狼狈地活着。", note: "原创", source: "夙鱼", uuid: "f7e6db82-12e2-4c1b-acf5-d5f4beb49d46" },
  { text: "有志者，事竟成。", note: "哲学", source: "后汉书·耿弇传", uuid: "3a99e352-d34c-4a71-bf3a-e60bfda3cb00" },
  { text: "明月也不曾记得它点亮过世界！", note: "哲学", source: "皓月", uuid: "8e950c82-8d8f-4fb9-95c3-096d876d7af5" },
  { text: "恐惧的话，只是因为内心不够强大", note: "网络", source: "来自网络", uuid: "007d0533-2e59-488d-9f49-06c089dec71a" },
  { text: "宽容是一种典型的傲慢。", note: "原创", source: "决明", uuid: "c138d6bc-7242-4829-ad38-924092052806" },
  { text: "我们必须知道，我们终会知道。", note: "哲学", source: "戴维·希尔伯特", uuid: "d5691464-8c3a-42cb-bee1-70ee63a59209" },
  { text: "总会有始料不及的运气和忽如其来的惊喜！", note: "网络", source: "佚名", uuid: "3eebd91f-85ea-4c34-a9c7-8d3f9431889b" },
  { text: "哪有什么人生开挂，不过是坚持很久的厚积薄发。", note: "网络", source: "网络", uuid: "7bb7b187-f237-4a38-acc9-e8ccbc31b25d" },
  { text: "我已在这可怕的控制欲中溺毙。", note: "原创", source: "Vikey安凝柠", uuid: "40c90b05-2331-41dd-ac9e-c15d7bc7c0bd" },
  { text: "飘摇风雨中，五色穹顶下，阳光被映出彩虹的颜色。", note: "原创", source: "CuSO4", uuid: "0c0773c7-4e33-43fd-bca4-0dcb54d84b45" },
  { text: "心情已经习惯和候鸟一起迁徙只是有些仓惶而已。", note: "网络", source: "晓良", uuid: "0cb796d6-4147-413b-93c7-17e3719b30f1" },
  { text: "没有任何意义，其实你根本没爱过我。", note: "网络", source: "别错过", uuid: "d9a76dc3-dd37-4e13-93d8-fbf035ac0b39" },
  { text: "故事还在你的眼眸，我倾其所有。", note: "网络", source: "我的纸飞机", uuid: "58a48e58-7752-4ce9-9c9d-2c704564e287" },
  { text: "被关心然后关心，关心然后被关心。", note: "原创", source: "auc", uuid: "1d037b86-224b-4daa-9df7-d4a2f671e396" },
  { text: "哪怕一百个愚笨的人在一起聚会，也无法产生一个智慧的人。", note: "哲学", source: "叔本华", uuid: "00f5e655-c46f-40f3-9587-0fd6aca0dd10" },
  { text: "即使这一切如此虚假，那又如何？", note: "原创", source: "small_xu", uuid: "b049604a-e8ac-4494-902d-b6f54a33ee36" },
  { text: "理性把感性框出了形状。", note: "原创", source: "NS2000", uuid: "4e201cfc-ceee-4fd2-8502-b92634cb7518" },
  { text: "你我皆为红尘客，纵断生死又如何。", note: "原创", source: "宽宽", uuid: "10322fda-792f-48d4-b0b3-8cfc2bce73e6" },
  { text: "你的一生，我只借一程，这一程便是余生。", note: "网络", source: "佚名", uuid: "7e459212-9625-419e-878c-b5d56799ed2c" },
  { text: "愿好好奔赴人生的同时，也要活的开心。", note: "原创", source: "菲.lin", uuid: "9d14309e-0cbc-4a91-aac6-e2df782aa091" },
  { text: "一扇不愿意为你开的门，一直敲是不礼貌的。", note: "网络", source: "网络", uuid: "58e76a6a-7155-47fc-95b0-dbfb1ed52fc6" },
  { text: "总有人爱你，不论你是白鸽还是少年。", note: "原创", source: "MYR", uuid: "6601c87c-32d4-4a9f-af90-945738f58537" },
  { text: "就算被世界遗忘，我也会陪在你的身旁。", note: "网络", source: "纯白", uuid: "6dc3ce16-3d21-400b-9dfe-15c49d67626f" },
  { text: "厚道的人 运气都不会太差", note: "网络", source: "Xiaomi", uuid: "cd71a826-39a2-49e6-8dc1-3db937815db1" },
  { text: "人类刻着对痛苦的敏感，却没有对痛苦的反感。", note: "原创", source: "xomk", uuid: "4c5d9945-0123-4a8f-bd1c-46abf822bc50" },
  { text: "失去，得到，往往于一念间。", note: "原创", source: "GoodChing", uuid: "d898c41d-c663-4b3c-b8f6-f4706b3f6202" },
  { text: "地球只有一个，而欧派有两个。", note: "网络", source: "网络", uuid: "2e183f0c-f818-4578-8021-47c374fa2e74" },
  { text: "最终的结果可以预测，那过程中的选择就是多余！", note: "原创", source: "尤龙", uuid: "a05fc37e-231e-4b31-b23c-c3e81d81f9a4" },
  { text: "眼泪填满的黑夜，是戒不掉的烟。", note: "网络", source: "吴易纬", uuid: "b55fe11d-17f6-4592-96d8-33069e3ca554" },
  { text: "漫漫人生路，相知有几人。", note: "原创", source: "安如星", uuid: "e712f02b-3aa9-4498-8802-666ad7fca461" },
  { text: "我们最终都要远行，最终都要跟稚嫩的自己告别。", note: "网络", source: "佚名", uuid: "48be1605-7ccd-4e1e-802b-7d3c017312f2" },
  { text: "我最讨厌的，是对你束手无策。", note: "原创", source: "茶褐", uuid: "06133cd5-e0e0-46e7-978c-caabf5803f36" },
  { text: "我宁愿错过也不愿意相遇。", note: "原创", source: "御辞", uuid: "2a3bd5fb-00fe-4532-949a-b272d3aad415" },
  { text: "一沈秋园，满庭霜落，云烟北桥夜连城。", note: "原创", source: "北湖词", uuid: "5a9fc8f5-695e-4299-b1c9-e170245be103" },
  { text: "我们爱生活，并非我们习惯于生活，而是我们习惯于爱。", note: "哲学", source: "尼采", uuid: "ac5ed860-bb9f-4d86-b649-5724cd14e964" },
  { text: "能享受最好的，也能享受最差的，这才做见过世面。", note: "原创", source: "Linzepore", uuid: "b521b826-10b3-4dc5-a9f3-ade8af0f3aa2" },
  { text: "一朵花不必开在花园，它本身就是春天。", note: "网络", source: "网络", uuid: "14e608d6-2542-4ad5-b293-c22b3d77c6e2" },
  { text: "飞向了芦苇边。", note: "网络", source: "good", uuid: "38bcdb14-2535-4379-95cb-1121de0c23ac" },
  { text: "听听外面的故事，岁月多温柔。", note: "网络", source: "王健美", uuid: "31e3d67b-8104-43b7-bf51-48d34be72832" },
  { text: "阳光照在海面，我也归于大海。", note: "网络", source: "刘学州", uuid: "4f8f1c9a-ab14-4efe-aa94-0b334c98662d" },
  { text: "宅，是一种生活状态；死宅，是一种人生境界……", note: "原创", source: "朝颜留空", uuid: "f8149463-bb65-47bd-ae69-32fe32c1b907" },
  { text: "即使窗外天寒地冻，吃一口肉，一切自有力量。", note: "网络", source: "日食记", uuid: "68e20644-d3d2-4796-869d-b4abf8ea574e" },
  { text: "你不是畏惧黑暗吗？那你为何还喜欢在黑暗潜行。", note: "原创", source: "御辞", uuid: "30cc780f-b116-4c50-b3f1-60c0f841a44b" },
  { text: "理性的思维需要感性的眼光看待，反之亦然。", note: "原创", source: "纤素丶", uuid: "ddb66a65-244d-4f5a-ba1c-d97345b828bd" },
  { text: "如日中天，群魔乱舞，应臆。", note: "原创", source: "朴素", uuid: "a64d5c19-3ecb-4e21-95a5-44942fabbd88" },
  { text: "揽星辰入怀袖，将往事抛脑后。", note: "网络", source: "山风山风等等我", uuid: "99a53f6b-79ea-4845-89fd-c1c6fbe68fbb" },
  { text: "我曾想过给你写一封信，满腔心潮翻涌，最后只落下一个致你。", note: "原创", source: "茶褐", uuid: "23276d7b-2f02-4b4e-a728-991e105ae8e0" },
  { text: "凡是不赚钱的都说自己在创业。", note: "原创", source: "安安", uuid: "8b740fac-2953-4bae-8ca8-61312ee99c3d" },
  { text: "对自己的爱好保持热情，不要太功利！", note: "网络", source: "我叫何同学", uuid: "ffad0079-be5b-4a3b-a71f-628ef2e04190" },
  { text: "我想潇洒做一回云游。", note: "网络", source: "山风山风等等我", uuid: "adb326ea-2886-4ff9-8dc8-18968f7a10bb" },
  { text: "心节以信居神，自为神上；视异义者无知。", note: "原创", source: "朴素", uuid: "b4e475b6-8f1d-47f7-ad02-afac24264ecc" },
  { text: "醉生梦死才是人生真正追求。", note: "原创", source: "朴素", uuid: "a0d37c8d-4e2d-4e4e-b682-5b6971524dcf" },
  { text: "今天你要是不做，你明天还是得做。", note: "原创", source: "MengCheng1015", uuid: "f4e6643c-6397-47a3-9211-a7723c8a5b71" },
  { text: "每一个人活着，本质上都是对自己的不信任。", note: "原创", source: "浮生若梦", uuid: "ddbe4911-b07e-4dda-a0df-4a656fd0b32c" },
  { text: "时光似酒酿温柔，心事诉与明月收。", note: "网络", source: "日月同辉", uuid: "5ae21653-7cd8-4636-a362-c0737b5d51e7" },
  { text: "独徘徊等你等你等你的一切。", note: "网络", source: "花晶晶", uuid: "358019e7-753b-42fa-86ff-581b9576cf93" },
  { text: "从春夏到秋冬看流过的时空，像拂面过的微风。", note: "原创", source: "一只叫一行的喵", uuid: "af6f2a46-edb4-4af4-a826-2051c44fc3b9" },
  { text: "也许来时那段路总有些颠沛流离，才配得上后来和你的相遇。", note: "网络", source: "路小可", uuid: "fe231b24-4226-4a48-b4a0-c6859222b924" },
  { text: "既然能够仰望星辰大海，又怎会在乎钻石的微光？", note: "网络", source: "网络", uuid: "4487e18f-06c9-4bee-9bd0-ef7a2e940431" },
  { text: "时间突然向前迈了一大步，我奋力追赶，却遥不可及。", note: "原创", source: "原创", uuid: "b4e447a5-14af-49d5-9687-d0b450074982" },
  { text: "梦是故事的回响，风是爱恋的流浪。", note: "原创", source: "青栀", uuid: "41d107aa-87b4-42ff-9617-b46024fab246" },
  { text: "所有的努力不过是延缓必将到来的坍塌。", note: "原创", source: "heiheihei", uuid: "187d89de-170f-4425-9eae-270535867fc4" },
  { text: "现在的付佳程涛不是付佳程涛的付佳程涛。", note: "原创", source: "付佳程涛", uuid: "3b2eed9c-9912-4caf-be7b-17fda9e30108" },
  { text: "扬帆起航，于舟渡之。", note: "原创", source: "朴素", uuid: "20353911-a0d0-4b62-83df-462b1cfbcdcf" },
  { text: "你会不会在某一个瞬间想起我，哪怕，一瞬间。", note: "原创", source: "Qicloud", uuid: "91dd51db-5af5-484f-8719-006e9a06ef43" },
  { text: "岁月总让人成长，却从不指明方向。", note: "网络", source: "佚名", uuid: "b7969911-cb7b-4c60-bb8b-9fce191dbdc8" },
  { text: "感情被焖透的只渴望着惯性。", note: "网络", source: "道雀Bzz", uuid: "a38b3368-1eea-4cd5-8d52-5fd5633293f5" },
  { text: "他帮你驱散黑暗，我却带给你光明。可，你心里没有我。", note: "原创", source: "柳柳", uuid: "70e5c716-4b42-404f-839f-546efbc1b734" },
  { text: "听都没听说过的事，假装听懂、明白是一件很失礼的事情。", note: "网络", source: "金律", uuid: "c7a160e5-9ec5-479b-9657-d0c735cb4348" },
  { text: "双马尾是最好的方向盘", note: "网络", source: "来自网络", uuid: "02f3602b-19a8-4dc8-8cdc-7397e148abd4" },
  { text: "所谓最难忘的，就是从来不曾想起，却永远也不会忘记。", note: "网络", source: "佚名", uuid: "1f8e72b8-daf9-4153-8761-6aa820007806" },
  { text: "有些日子眨眨眼一下子就过去了，然后永远怀念。", note: "网络", source: "抖音", uuid: "769442d3-dbe6-4c7e-8a82-ae5128758502" },
  { text: "我一直在不停地扔东西，却没想过保留什么。", note: "网络", source: "佚名", uuid: "d2061b6f-48ec-4b4b-a751-6d5e95fc2470" },
  { text: "人这一生大约会说8.8万谎，最容易脱口而出的是，没事。", note: "网络", source: "佚名", uuid: "0369a309-b10a-42c5-a772-c9c45ed7b0d1" },
  { text: "人生艰难。这是一条伟大的真理，是最伟大的真理之一。", note: "哲学", source: "M. Scott Peck", uuid: "e24c4fd6-949d-4a37-ad95-7599177a7ac7" },
  { text: "日惟东来，山海不阻，晴雨无伤。", note: "原创", source: "鹤空流乂", uuid: "c122d118-f2ea-4873-9920-278a8ab3a5c1" },
  { text: "不在乎世俗的眼光，去追求，自己的光芒。", note: "原创", source: "XIN", uuid: "0123b599-8267-4329-b752-8a0369e807ea" },
  { text: "打雷时你想到的是要下雨还是她害怕。", note: "原创", source: "签名", uuid: "601354c8-18f7-4da1-9d12-1974be406d7f" },
  { text: "懂得爱，拥有爱，追寻爱，感受爱，与爱相伴，被爱治愈。", note: "原创", source: "落雨", uuid: "547b9afc-7780-4b8b-9d85-45dcb79df1f5" },
  { text: "一见如故，生万千欢喜心。", note: "网络", source: "网络", uuid: "ecd33522-b001-44a2-97c2-8d010d47c79a" },
  { text: "雪落的时候，谁还会注意满是阴霾的天空呢？", note: "原创", source: "高消费给媳妇关心烦", uuid: "a56834e6-5748-4cf3-99c9-7d428fb7c02b" },
  { text: "那是成年人预谋的较量。", note: "网络", source: "道雀Bzz", uuid: "305e061c-e29e-4a30-9692-3e3e6ad2b970" },
  { text: "不管风吹浪打，胜似闲庭信步。", note: "哲学", source: "毛泽东", uuid: "529454f8-32b7-4074-ac21-48dd6d767945" },
  { text: "人何尝不像鳄鱼一样，留着眼泪做着违心的事。", note: "原创", source: "SquareBlock", uuid: "dab24f86-b963-4c5e-b7ca-d3f8983ed7e8" },
  { text: "大地母亲在忽悠着你。", note: "网络", source: "魔兽世界", uuid: "2f598faf-bc25-4578-8cd3-04e71a9f4cc6" },
  { text: "别在最疲惫的时候审视自己的人生，你只是今天有点累。", note: "网络", source: "网络", uuid: "d7191a8d-448a-4fa5-bd0f-f418afc0301b" },
  { text: "打到最后，应该就剩你自己，和，你为的人吧。", note: "原创", source: "聛", uuid: "057b08ca-5a21-47e0-8f49-f079224bc715" },
  { text: "東京又下雪了，我們似乎再也沒有相見。", note: "网络", source: "网络", uuid: "176d4145-b975-402c-a408-5d4c23fb6b3f" },
  { text: "说“我”的每个瞬间需要反省。", note: "原创", source: "好时光", uuid: "06164cc7-ed00-4aa3-aa7a-08136c270df9" },
  { text: "不从善恶意，只遵本心行。", note: "原创", source: "朴素", uuid: "5fa16e03-efe6-4513-854c-d794ef8a2a49" },
  { text: "哲学的基本问题是思维和存在的关系问题。", note: "哲学", source: "哲学的基本问题", uuid: "83e5245e-3802-42a7-8cc9-b2328cf805d3" },
  { text: "民主的最终目的应当是保护少数和个人的权利。", note: "哲学", source: "托克维尔", uuid: "21419228-0415-47dc-89b0-bd2165593679" },
  { text: "他能给的，你付不起！", note: "网络", source: "终极恶女", uuid: "f4058051-837e-499c-8153-a52c766f9a07" },
  { text: "你是清风上的明月，枫林间的鸟雀。", note: "原创", source: "白开", uuid: "115b8ef2-b2ae-4972-8803-bc788fc2eb1c" },
  { text: "山风山风等等我。", note: "网络", source: "万海东", uuid: "0169ce9f-70b9-45fc-8900-750e95265af4" },
  { text: "今日过后，所有晦暗都留给过往，凛冬散尽，星河长明。", note: "网络", source: "网络", uuid: "15b14ba9-2711-4414-8b20-88d0c453d432" },
  { text: "时间并不能冲淡一切，他只会在你心里留下更深刻的烙印。", note: "原创", source: "夜熏", uuid: "6a7c1abd-2690-4ac6-92a9-2afbe8cf1541" },
  { text: "生命在于折腾，长寿源于静止。", note: "网络", source: "佚名", uuid: "b6de4663-ac80-46fd-8dd3-d46941737f96" },
  { text: "窗寒嗟悔昔时勇，想当年、剑指白霜。", note: "原创", source: "碧水凌涛", uuid: "b36c3faa-f9fb-42bc-9896-e588d2ffcf02" },
  { text: "追忆总在不经意间将我裹进泛黄的纸页里。", note: "原创", source: "CCF", uuid: "5caeaa5f-857e-4fe9-b1b8-8220e484beec" },
  { text: "手边的枣花香。", note: "网络", source: "高贵鹏", uuid: "28098766-cea4-4181-bf99-843bcfd1d413" },
  { text: "你所厌烦的普通，也许是他生命中最珍贵的平凡。", note: "原创", source: "Human", uuid: "1ce3aeda-affb-4a7a-84fa-4c3bda195a91" },
  { text: "旧情黯淡痴心愁，执念且放手。", note: "网络", source: "郑明河", uuid: "ce332aca-8295-4221-b9f6-eba8fb655b65" },
  { text: "失败是成功之母，不失败怎么能成功？", note: "原创", source: "小林", uuid: "061fd0e2-5b66-461f-9dce-7d053b0f35f8" },
  { text: "你不努力听到的都是别人的好消息。", note: "原创", source: "我自己", uuid: "20d0fe7c-3540-4cff-9e74-b62bc386bb38" },
  { text: "读一本书，看一份风景，品一场兴衰，走一回人生。", note: "原创", source: "帆仔", uuid: "45ba2314-73d7-4ecc-9769-af1c9aaa7329" },
  { text: "梦里与现实的距离，仅仅是双眸的一合一闭。", note: "原创", source: "原创", uuid: "1107c654-1834-46ec-b002-7f1ea64b75c6" },
  { text: "最美不过你回眸，眸中带笑，笑似烟浓雾霭。", note: "网络", source: "佚名", uuid: "217c74d1-a87a-404c-bfc0-e8a4b6f8dd1f" },
  { text: "苦痛离去没有复苏的平常。", note: "原创", source: "James-Li", uuid: "b58f1217-0cb4-4a1a-819f-18a9bda83255" },
  { text: "毛虫破茧终成蝶，蛆虫破茧仍是蝇。", note: "原创", source: "RobinC", uuid: "0c05d9af-4587-46e6-98fa-e9a7f5d94c63" },
  { text: "你害怕黑夜吗？未知是人类恐惧的根本。", note: "网络", source: "石纪元", uuid: "0a7c3717-cfd8-4a3b-9384-8b347c36ba57" },
  { text: "做一个衣着华服时仍能做自己的人。", note: "原创", source: "抱月", uuid: "a345a606-7d4f-4f59-8a81-eb830cbafdcd" },
  { text: "死亡不属于工人阶级！", note: "哲学", source: "弗拉基米尔·伊里奇·列宁", uuid: "eeb122bf-69db-4e9e-b711-288c31f81296" },
  { text: "就算终有一散也别辜负相遇。", note: "网络", source: "网络", uuid: "ada40601-5a04-467a-8519-6a85a5e76c90" },
  { text: "不管对什么事情都不能有先入为主的观念。", note: "网络", source: "网络", uuid: "fd6d29a8-6f72-4004-bfc9-e990ff02c8fb" },
  { text: "团雀闹，好事近。", note: "网络", source: "kaibo yu.", uuid: "82b4054c-0636-4749-8f5d-47de53f213af" },
  { text: "饮疏狂之酿，品淡泊之茗。", note: "原创", source: "枍鹓", uuid: "d810ab71-3e44-45c7-a581-63c15fd62714" },
  { text: "众星因你，皆降为尘。", note: "网络", source: "五维介质", uuid: "adcc7cb2-9a83-45ad-b6a3-64a43b2b7dd9" },
  { text: "爱还会不会回来，这是我的独白。", note: "网络", source: "Fanko冯思源", uuid: "fb813674-a1b6-416d-9140-c879d6037a20" },
  { text: "灰烬与雪交织，刀锋轻颤如悲鸣。", note: "原创", source: "烬雪鸣", uuid: "ae39b737-2d91-412e-9640-569c87bc42fb" },
  { text: "我们各自努力，最高处见。", note: "网络", source: "知乎", uuid: "c7adcd60-71c0-4edd-a852-e13d0902a5cd" },
  { text: "天空一无所有，却拥有了一切。", note: "原创", source: "雨杨", uuid: "6b539dbf-bbf9-4f0d-9b6a-7315d3ebec97" },
  { text: "谎言重复一千遍就成了真理。", note: "哲学", source: "戈培尔", uuid: "ea89f6db-0849-48e1-812e-d66533d8be33" },
  { text: "非人之学能，非人之能学。", note: "原创", source: "朴素", uuid: "d52ed11f-7ba4-4c50-bfad-3ef1c0b549ac" },
  { text: "今天的早餐是：早苗的面包、秋子的果酱和观铃的果汁~", note: "原创", source: "Mion", uuid: "f9c47630-6c8e-47af-81bf-bb6c92f8d083" },
  { text: "这个社会一直在淘汰有学历的人，但是不会淘汰有学习力的人。", note: "网络", source: "Mr96", uuid: "e1da6cf2-0ad8-4ed7-848b-0138a25e3d45" },
  { text: "心比顽石，药师无益，心若水泊，浮萍无存。", note: "原创", source: "可", uuid: "32c6a220-8231-4a0b-ae3d-dcd65eb40051" },
  { text: "生活就是和过去再见，和未来遇见！", note: "原创", source: "柠檬茶", uuid: "0cfb3aa9-6812-4788-9d08-ef4a16e5753a" },
  { text: "追逐的过程，亦是失去的过程。", note: "原创", source: "皓沐", uuid: "f335f003-25c5-48a0-8c1c-9750b2cebd59" },
  { text: "想君眉眼起轻尘，流光驰骤追梦魂。", note: "网络", source: "楼玉明只是路过", uuid: "782d0b62-cabd-45a0-98e7-0f6c069331fc" },
  { text: "树是生活，埋的是我，看花就好，别看我落魄。", note: "网络", source: "MEliauk", uuid: "971cbd1e-ccb8-4dbf-b174-4b1ceb78f21f" },
  { text: "故人一迁，如梦万载。", note: "原创", source: "月雩", uuid: "8cb9a01a-f86d-4e19-a6b3-d302739a9bee" },
  { text: "这不是神经病，是理想", note: "网络", source: "大话西游之紫霞仙子", uuid: "05dd54e1-b907-42ed-ad91-5735c900855a" },
  { text: "哭也没关系的；说不出的话，由我来说就好。", note: "网络", source: "叶", uuid: "77ae36be-f597-4bfb-a53d-a8ef6959e491" },
  { text: "即使人生是一场悲剧，也应该笑着把人生演完。", note: "哲学", source: "尼采", uuid: "49eff9ca-7145-4c5f-8e62-d3dca63537fa" },
  { text: "吹过池塘边的晚风摇曳着莲蓬。", note: "网络", source: "我的纸飞机", uuid: "4c3b5785-1b69-47c4-be89-a85982c9f253" },
  { text: "我珍藏一路真挚的相逢。", note: "网络", source: "岁月如笔写春秋", uuid: "4adc31ba-5283-4072-ba76-0ca4c60a21c5" },
  { text: "百年长河，不过是你和我，在经历着的一刻。", note: "原创", source: "ZaZaZsu", uuid: "6cd5de08-9a3b-4e93-80fc-be8bd772bf9f" },
  { text: "所有的偶然，不过是想要遇见你。", note: "网络", source: "网络", uuid: "f2f69fd6-16fc-4e79-afc0-d317230e1852" },
  { text: "他甩不开他的身体。", note: "网络", source: "道雀Bzz", uuid: "70afd85b-bc73-4e2f-a268-91b1bbf15ac3" },
  { text: "和谐的生活离不开摸头和被摸头。", note: "网络", source: "豆瓣网友", uuid: "2c19c04c-9735-495b-af1d-f6258d68c977" },
  { text: "于风雨中，承载我们所有的回忆。", note: "原创", source: "Big_Cake", uuid: "101659f6-d775-4051-8fed-1410b386fd2e" },
  { text: "逃离这座城市一直都不是梦，缺少的是离开的勇气。", note: "原创", source: "鬼绿", uuid: "e5bb9bc9-8a47-47ca-9456-42ff7583ced8" },
  { text: "若有来世再见，续写未完情。", note: "网络", source: "岁月如笔写春秋", uuid: "0faf0a83-81cb-4567-ab92-dcae6c64775f" },
  { text: "与人和者，谓之人乐；与天和者，谓之天乐。", note: "哲学", source: "庄子", uuid: "d058af3e-dd1a-49b9-ae3e-9441ea99923f" },
  { text: "过俗世的生活，做通天的梦，手不能触及的，心可以直达。", note: "原创", source: "陈树凤", uuid: "36ddd370-aa9c-409c-badc-f8b10cf62ad5" },
  { text: "批判的武器当然不能代替武器的批判。", note: "哲学", source: "马克思", uuid: "12b0eff6-10d2-40de-b1b1-4df8a2fb9189" },
  { text: "XX什么的，最讨厌了！", note: "网络", source: "网络", uuid: "1c70b6ca-0545-4737-ba9f-da63460a3423" },
  { text: "与你的生命等价的东西，这个世界上根本没有。", note: "网络", source: "网络", uuid: "663210c4-b198-4da9-913b-791831f4a213" },
  { text: "什么是浪漫，你懂我其实很简单。", note: "网络", source: "徐重来", uuid: "17cab9a6-57c8-464f-9915-3a00ee1053e1" },
  { text: "如果有一天，你爱一个人像我爱你一样，你就知道我有多累了。", note: "原创", source: "雅", uuid: "724b4026-4fc9-4aee-8ebf-66a8b4fa9a2d" },
  { text: "宣纸泛黄，时间流逝，即使眨眼即过，也要抓住那瞬间的辉煌。", note: "原创", source: "原创", uuid: "8d117aee-15d8-4d52-99f5-4107fd3c24e3" },
  { text: "莲子这个东西，等的越久，它越苦涩啊。", note: "原创", source: "Yly", uuid: "2e9b5d0d-ca2b-4f50-b8ac-22ed48896764" },
  { text: "就算天塌下来变成一片废墟，他的脸色也不会有丝毫变化。", note: "哲学", source: "叔本华", uuid: "ed9119a0-0051-421a-8863-710e82edba79" },
  { text: "不定时更新，主要是因为我懒。", note: "原创", source: "侠盒", uuid: "9bdb66d0-c89e-4abf-94c1-a1525b64bddd" },
  { text: "如今的不务正业也许是在支援未来的自己。", note: "原创", source: "素色弧线", uuid: "539e4fd6-d922-4915-8db7-7d6b55bac77b" },
  { text: "幸运的人一生都在被童年治愈，不幸的人一生都在治愈童年。", note: "哲学", source: "阿尔弗雷德·阿德勒", uuid: "970693f2-d35f-4ab9-a980-0969698b3041" },
  { text: "命运负责洗牌和发牌，而我们只能出牌。", note: "哲学", source: "叔本华", uuid: "4d4e35ab-c360-402d-90e6-77e519a90a6d" },
  { text: "学习是条既定的轨道。它通向光明，而学无止境……", note: "原创", source: "恒毅学子", uuid: "58f97d14-d328-441e-98f8-aca80b37b1dc" },
  { text: "哪有什么岁月静好，不过是有人在替你负重前行。", note: "网络", source: "网络", uuid: "9da9d486-fe09-43f2-bd84-1b2be2d66921" },
  { text: "你Ping不通的她，却正在被别人DDoS。", note: "网络", source: "无", uuid: "ef1b64e7-04a6-49f3-9a50-6308aedf1a97" },
  { text: "一举一动牵吾魂，一言一语勾吾思。", note: "原创", source: "只是", uuid: "a2ea288b-0c66-41be-8172-e6c3c715b2b3" },
  { text: "历史的发展是不以人的意志为转移的。", note: "哲学", source: "毛泽东", uuid: "3664f3f9-f1d1-438b-a707-821f32a34ee2" },
  { text: "有生之年遇到你，竟花光我所有的运气。", note: "网络", source: "林夕", uuid: "36b6e175-8da2-42f6-96cf-1b9c1dc98ef6" },
  { text: "选择最难的路走暗夜里看成群的星星涌来。", note: "网络", source: "网络", uuid: "8ac3fca5-8d66-4635-a7ab-4c4b9c82d85d" },
  { text: "我没辜负你，你看到了吗？", note: "原创", source: "茉莉雨", uuid: "cbaa371b-5d8b-4e21-a1d0-8e3f1622cf6d" },
  { text: "笔锋所至群山动，剑气如虹贯日斜。", note: "原创", source: "妤枍", uuid: "5df77380-bff8-4d18-85fc-2cc0926cb2f9" },
  { text: "“对方正在输入中”，给了多少人希望，又让多少人绝望。", note: "网络", source: "网络", uuid: "760a4385-1586-4555-b4dc-7d7455c6f1d8" },
  { text: "神明将黑夜中亮着的灯称为月亮的心脏。", note: "原创", source: "鱼杉", uuid: "cf0e9b4c-6ca4-4a2c-85e4-3d705f1c1da2" },
  { text: "等待，不是为了你能回来，而是找个借口不离开。", note: "网络", source: "九ちのセカィ", uuid: "609c6789-fb47-4d7b-af34-1fcbe609b0dd" },
  { text: "我问风扇我丑吗，风扇摇了一晚上头。", note: "网络", source: "佚名", uuid: "8bd21ca0-da6a-42e0-a9fb-c36948de0791" },
  { text: "我只知道一件事，那就是我什么都不知道。", note: "哲学", source: "苏格拉底", uuid: "a485559b-d063-4f7d-a688-86cb0f32898a" },
  { text: "再也没有一个人和你睡前说晚安了。", note: "原创", source: "做魚玉子燒", uuid: "3b8e6c79-b15e-46bd-8ded-09cab699c021" },
  { text: "如果全世界都对你恶语相加，我愿对你说上一世情话。", note: "原创", source: "临沂冈田武", uuid: "b2aa6665-a3d9-4121-80cf-2ddab1cd42e6" },
  { text: "失去分享的欲望便是散场的开始。", note: "原创", source: "雅", uuid: "201a4915-f990-492d-9d24-7309e2d8e5ca" },
  { text: "别辜负眼前季节。", note: "网络", source: "花晶晶", uuid: "452bc252-fc32-4661-a124-11f989c32803" },
  { text: "我乃死，我乃生。我为暗，我亦为光。", note: "哲学", source: "脑叶公司", uuid: "762fde93-374b-4bb5-a29b-411e5b2e3a56" },
  { text: "应该在肩膀上长着自己的脑袋。", note: "哲学", source: "弗拉基米尔.伊里奇.列宁", uuid: "d5600970-45d8-4d66-b93b-c53ceaa06142" },
  { text: "本地人离开了农场，这是不光彩的栽跟头。", note: "网络", source: "道雀Bzz", uuid: "113b9416-62b3-4f6d-881f-781099751a2d" },
  { text: "提起满是遗憾，想起满是欢喜。", note: "网络", source: "网络", uuid: "c30c8c13-d47f-4d5b-9606-bd6f6eabb794" },
  { text: "荣格感到惊异，并向他指出有很多具骷髅，而不是只有一具。", note: "哲学", source: "德勒兹", uuid: "af3b12b6-aa95-4fd6-b199-0e992fe09a9f" },
  { text: "恰逢昨夜寒生树，一眼扫尽满窗花。", note: "原创", source: "佚名", uuid: "0f01e0bc-7b5d-4222-98ed-5b48200369d4" },
  { text: "那些听不见音乐的人以为跳舞的人疯了。", note: "哲学", source: "弗里德里希·威廉·尼采", uuid: "b45b4ace-c1f7-4feb-8ca2-7b2dc8c728e0" },
  { text: "没有调查，没有发言权。", note: "哲学", source: "毛泽东", uuid: "8f9c2e57-829c-4493-ac43-f4ad77796a37" },
  { text: "追逐了百年的太阳，却忘了月亮也是独一无二了的。", note: "网络", source: "网络", uuid: "19c5ffb7-1792-490e-a8ec-aa3d74ef388d" },
  { text: "人生真是讽刺，一个人竟然可以变成自己曾经最讨厌的样子。", note: "网络", source: "流浪记", uuid: "6aedd8a5-b749-43f1-a2c5-97e18a906aff" },
  { text: "人颜美祸，不过一场空悲。", note: "原创", source: "终究", uuid: "a7f3edc7-075b-42bb-8b31-201b8b40ac32" },
  { text: "诺你已经陷入黑暗，那你离死亡不远了！", note: "原创", source: "Mr_cgdn", uuid: "423a7413-59b7-4e46-a9ff-5894f6267cd0" },
  { text: "寻找比自己更没用的人，沉浸于这样的优越感中。", note: "网络", source: "雨き声残響", uuid: "96bd8d57-6d48-403b-ab4d-227fcb8eacd2" },
  { text: "一梦相思道不完，眉间的离愁。", note: "网络", source: "蓝乐", uuid: "a615f1bb-308f-40d3-94bc-c5b92c37210e" },
  { text: "没有音乐，生活是一种遗憾，没有爱心，生命是一种多余", note: "网络", source: "Qihoo360", uuid: "52cdb86f-23a5-4bb2-a6ad-6439fdf6a837" },
  { text: "拼尽全力，毫无意义。", note: "原创", source: "Roii", uuid: "8d12403c-cd1a-467d-b55e-7f79d3d9d5b1" },
  { text: "眺望高空，却无法上去！", note: "原创", source: "仙北默", uuid: "1d5e3297-c6ed-40d7-a140-c67bd2fb596c" },
  { text: "其实你不是真的很有趣，你只是太孤独。这个你，就是我。", note: "原创", source: "食不知味", uuid: "4e45a183-e440-4a14-88a2-a52fc0fb43b0" },
  { text: "当我眼中的月亮发光时，你身边的星光都暗淡了。", note: "原创", source: "林清凝", uuid: "70be8374-63cb-4b73-9b7c-acbe8556970a" },
  { text: "该如何描述光，不过是穿透于指尖的朦胧和希望。", note: "哲学", source: "佚名", uuid: "eb71dd8a-df88-4b8f-acd8-317c744e4804" },
  { text: "夏末随风至，秋高意难平。", note: "原创", source: "做魚玉子燒", uuid: "43c2809d-1841-4d2a-9bbf-b86711a674c1" },
  { text: "落尽红缨君不见，轻绘梨花泪沾衣。", note: "网络", source: "江南", uuid: "c201063f-753f-43ff-8cbf-c25f24ebf98b" },
  { text: "孤独を知って、愛を知る。", note: "网络", source: "大森元貴", uuid: "16bc544f-eb84-4771-8963-48432cd95a38" },
  { text: "生活中最重要的不是凯旋，而是奋斗。", note: "哲学", source: "人民日报", uuid: "7a75f461-aba6-4b13-8c1d-84fa3582cc6e" },
  { text: "我左手是修魔海短暂的因果，右手里百年一个漫长的孤陌。", note: "网络", source: "耳根", uuid: "3fea6809-516d-497f-9221-1b7d61f29e27" },
  { text: "你什么时候放下，什么时候就没有烦恼。", note: "网络", source: "网络", uuid: "eb5fa6bd-5711-4508-9d0d-811af6027990" },
  { text: "孙大圣，快收了神通吧！", note: "网络", source: "西游记", uuid: "9aa1f9c9-0f8c-4213-ad43-32b4cd562e2b" },
  { text: "坍塌的不只有波函数，还有观测者。", note: "原创", source: "做魚玉子燒", uuid: "c008e93b-f35c-46b1-bc93-a133087baa3b" },
  { text: "今夜皎月正当明，不念天涯但思卿。", note: "原创", source: "钟临天", uuid: "ab2935f7-42e9-4a31-9b9f-94f3c1123901" },
  { text: "我与残局皆遗憾，她与大狙皆如梦。", note: "原创", source: "Awoluua_", uuid: "e21c4cae-5494-4740-809d-427fe4700b91" },
  { text: "此时此刻一切都是静寂的，只剩下我与你的世界，这就是爱？", note: "原创", source: "DgBoo", uuid: "b09f553e-9178-43ef-8db5-4f95a825883f" },
  { text: "邀明月醉杯酒，随孤雁不回头。", note: "网络", source: "山风山风等等我", uuid: "6dc4731a-6228-4a54-8a58-c41835d0754f" },
  { text: "笔落难达晓，思及见别。", note: "原创", source: "storm1614", uuid: "73ac1b87-55ea-49a7-955e-9b08f224afd5" },
  { text: "梦终于醒了啊，期盼他日我们再萍水相逢吧。", note: "网络", source: "网络", uuid: "af07d133-7479-40a5-aa54-92ca70f9f3e4" },
  { text: "没有谈判，硝烟中，炮火轰鸣中，世界褪去了色彩。", note: "原创", source: "郑芳浩", uuid: "a2faf986-f5f9-4224-87cd-800046c61249" },
  { text: "我的梦想就是站在万人仰慕的高度，俯视曾经看低我的人。", note: "原创", source: "流年博客", uuid: "445c8c4b-535e-46a4-a6b3-d0677edef9f4" },
  { text: "学习让技束成为技术！", note: "原创", source: "道生", uuid: "911cb04d-4ae6-45f2-936c-0d5e4040a87a" },
  { text: "永远不要低估你的潜能，永远不要放弃你的梦想。", note: "原创", source: "Zeten", uuid: "b433fc29-39ec-49f8-a68d-f986a38755b5" },
  { text: "世间万般变化，都改变不了我的心。", note: "网络", source: "北", uuid: "6ad093ab-f582-4dbe-a8b5-07c914291017" },
  { text: "月亮明白我的深意，而我情寄予你。", note: "原创", source: "余几许糖啊", uuid: "1f7034a2-7f6b-437b-823f-b4faa59c1a7f" },
  { text: "可怜之人必有可恨之处，可恨之人必有可悲之苦。", note: "哲学", source: "民间俗语", uuid: "068260b2-3c3a-4cc5-bf1a-c6bb028d6d9b" },
  { text: "宇宙无穷，人生微渺，我从一无所有中来，自当归于虚无。", note: "网络", source: "止战之殇", uuid: "8211c847-fd06-431e-bc48-25bcb9cb569a" },
  { text: "当丁达尔效应出现时，光便有了形状。", note: "原创", source: "未知", uuid: "89d1a409-0496-4184-b95f-141abb432d82" },
  { text: "姑娘刺绣烛火残，风吹心事乱。", note: "网络", source: "郑明河", uuid: "086412a5-188c-42e1-ad8c-58affd5ca5ad" },
  { text: "任诗稿掩去你我蒙泪或蒙尘。", note: "网络", source: "楼玉明只是路过", uuid: "4b617743-694a-406c-9c30-3d749b914bff" },
  { text: "读书只盼天数，工作只盼月数。", note: "原创", source: "LD2045", uuid: "8fccf5cd-b453-4f2c-b006-7dbcd9f60452" },
  { text: "为毛我的眼里常含泪水，因为我老是躺着中枪。", note: "网络", source: "网络", uuid: "68d5a6f1-5ecb-4a04-9991-4fe0df535062" },
  { text: "家里的饭是生活，学校里的饭是生存。", note: "网络", source: "网络", uuid: "ec9ce2ae-1f18-4414-9a1d-2d86bebcc625" },
  { text: "我们感到不满的原因就在于我们试图不断地提高自己的要求。", note: "哲学", source: "叔本华", uuid: "3ce69902-689e-4956-b157-e398eea454ce" },
  { text: "无尽高的塔，永恒的猴子，无数首诗。", note: "原创", source: "auc", uuid: "71908cb4-cfe9-4398-8bde-e3ddbe8a7b5f" },
  { text: "寒风不曾心存偏私。", note: "原创", source: "圣聆初雪", uuid: "0c7e3741-2d2f-4fc8-93f7-3b45550145c7" },
  { text: "为了理想的实现，航行的孤独在所难免。", note: "网络", source: "佚名", uuid: "68031d9a-77e2-4c9f-b4a7-915762e51741" },
  { text: "燕飞阴雨暮，清风来去，初霁又斜阳。", note: "原创", source: "碧水凌涛", uuid: "7c60429c-e6f7-4f2a-b7e2-ab6bb3f39433" },
  { text: "我明白，我心中的海，填满不回来。", note: "网络", source: "30年前，50年后/烧灯续昼", uuid: "f28187b3-0d29-4c33-8adc-3489ee207065" },
  { text: "有实力的人不会相信奇迹，因为他们会创造奇迹。", note: "网络", source: "佚名", uuid: "999d80c1-e9b9-4b8f-9db2-df8ca79faf80" },
  { text: "再凶的男孩子，绑鞋带还不是要系蝴蝶结。", note: "网络", source: "签名", uuid: "5c883f65-a60b-4029-9274-7e2da8bea37c" },
  { text: "或许只有夜深人静之时，才能卸下面具，与星空共鸣。", note: "原创", source: "夜雨天梦", uuid: "5dbc41f1-5d0d-40db-bcf3-31e7e99ced16" },
  { text: "风筝的线你随时可以放开，只是别盼望我会回来。", note: "网络", source: "网络", uuid: "b0d15a52-3f1e-49fb-9e7a-8f36701d7a76" },
  { text: "如果人生结束，连遗言都没有，会不会太可惜。", note: "原创", source: "陈树凤", uuid: "3fe36a51-886e-40c2-8c42-9cdfe6d50748" },
  { text: "神明也畏惧完整的我。", note: "网络", source: "网络", uuid: "a23ea581-8b3b-43e3-9fdd-e58c38efa95f" },
  { text: "理性和感性，在我看来，是两种不同价值观的碰撞。", note: "原创", source: "Spectre™", uuid: "fdf0bab1-7bcd-4aea-8cba-606f42292c52" },
  { text: "别人说的记在脑袋里，而自己的，则放在心里。", note: "网络", source: "网络", uuid: "870857f7-663f-48aa-87aa-65bf26cd6907" },
  { text: "冬至子月，证启明兆。倚伏依之。", note: "原创", source: "朴素", uuid: "4ce255f7-7a6f-49fa-9615-b83518ea8632" },
  { text: "不肯迈出第一步的人永远学不会走路，也无法体会奔跑的喜悦！", note: "原创", source: "朴素", uuid: "1f635f9f-c398-4c20-a8b1-2713a8b20440" },
  { text: "这世界太大到处是人海与人山。", note: "网络", source: "徐重來", uuid: "74bee322-3ced-49f1-a403-a36f11e85125" },
  { text: "总是在失去后，才会想再拥有，总是在离别中，才想在回头。", note: "网络", source: "耳根", uuid: "0f212f09-9345-4b02-a7e9-7cc22c1684ae" },
  { text: "暴秦朘削民众，陈吴揭竿张楚。天家震以威怒，苍生馈之无穷。", note: "网络", source: "佚名", uuid: "f5fa56ea-0ea0-4181-945b-7c5467d3f946" },
  { text: "得之我幸，失之我命。", note: "原创", source: "徐志摩", uuid: "8b761a8c-3f82-4664-98ca-6afd8d76867a" },
  { text: "做最最真实的自己，无需隐藏，我是什么样子就是什么样子。", note: "原创", source: "刘璐瑶", uuid: "a720b01c-e71c-4332-b51d-deb1f511fd02" },
  { text: "一生清贫在世间，怎敢耽误天上仙！", note: "原创", source: "柒公主", uuid: "b8789e50-fe9f-41f4-a77e-3fa5abac164e" },
  { text: "每个人藏在影子里的，才是他真实的那面。", note: "原创", source: "老番茄", uuid: "77d7e02b-3f15-4ad1-bee7-68709e48a619" },
  { text: "站在黑暗里，连你的影子都会抛弃你。", note: "原创", source: "一茉", uuid: "4692f774-2ebb-410d-98ac-31de684302e9" },
  { text: "从来就没有什么失败的人，只有半途而废的人。", note: "网络", source: "罗永浩", uuid: "fb8d7e63-8bd3-4a67-8f5d-fa5c59945a5a" },
  { text: "我们都是不擅长生长的树，起码期盼会带来快乐。", note: "网络", source: "房东的猫", uuid: "b452a7db-0700-4f71-9fb4-2239593b281e" },
  { text: "那个夏天是个潮湿蒸笼。", note: "网络", source: "道雀Bzz", uuid: "e129e0d9-b1bc-4184-91ba-e845d1a2f0b4" },
  { text: "風可以決定樹的方向，而你可以決定自己的方向。", note: "原创", source: "Hasty", uuid: "0c51aaa1-32eb-4611-a199-cea54d75a1f9" },
  { text: "无论如何，我尽力，好吗？", note: "原创", source: "茉莉雨.", uuid: "2c7527b7-81bd-4f51-b1b6-8e62c5542e49" },
  { text: "没有光明是不幸的么？不，需要光明才是真正的不幸。", note: "网络", source: "来自网络", uuid: "4a328ee7-973e-44db-a2d9-a7a2fdd6b529" },
  { text: "世界上黑暗中发的光，这束光就是你内心真正想要的。", note: "原创", source: "萌城Nya", uuid: "85265ca2-7db2-4648-8786-b5f5a546beb8" },
  { text: "陌生的人，总要打起精神啊。", note: "网络", source: "佚名", uuid: "4e02cec8-f7ca-4930-96bb-da43047704dc" },
  { text: "我暗恋她，又和她有什么关系呢？", note: "网络", source: "网络", uuid: "b5474f6f-eaed-4660-b7c5-0641b3d88ef9" },
  { text: "想对你说一句你真厉害，现在竟会犹豫。", note: "原创", source: "茉莉雨", uuid: "02c1a689-bfe6-4779-96c6-2bcc77feaf6f" },
  { text: "没有行动的新的领悟，是转瞬即逝的。", note: "哲学", source: "心理课", uuid: "61af6bc5-7e38-494a-a185-fa142446a361" },
  { text: "愿你以渺小启程，以伟大结束。", note: "网络", source: "互联网", uuid: "865e6816-8969-40e4-a0c6-14993578fc87" },
  { text: "就此拂衣去，水覆旧荣径。", note: "网络", source: "槲安", uuid: "b777aa0f-3ac7-438f-86c7-787cc31acaaa" },
  { text: "我们还有可能吗？", note: "原创", source: "茉莉雨.", uuid: "04279d64-e576-46fe-a202-f64ee921e120" },
  { text: "阿德巴约腰斩自己83次。", note: "原创", source: "JJJ", uuid: "ac1cf35a-98b9-4f51-b62a-b8ddb5cd5caf" },
  { text: "夜深忽梦少年事，唯梦闲人不梦君。", note: "网络", source: "柒", uuid: "ee730907-2f19-4c4f-ba8c-d124e9bca6fb" },
  { text: "百废待兴长久事，千灯如逝长庚驰。", note: "原创", source: "一只叫一行的喵", uuid: "8465ec9e-5ee0-4505-b2f2-7e64e353bfe0" },
  { text: "生活中寻找文艺的过程也是一种文艺。", note: "网络", source: "网友", uuid: "b425ad6f-e30d-49d6-907f-44d6bd46d9d6" },
  { text: "像旧时候，像老朋友。", note: "网络", source: "网络", uuid: "e314bad5-7323-458a-8232-5b6d9ea60120" },
  { text: "再热情的心也经不起冷漠，再爱你的人也经不起冷落。", note: "原创", source: "雅", uuid: "cf2b73aa-9e8d-4b19-8823-2b345fad29ca" },
  { text: "愿留在Minecraft，也不愿回到现实。", note: "原创", source: "Lipww1234", uuid: "a24215e4-7861-4a46-86c6-ebe8b6aece62" },
  { text: "时间就是一个饥饿的怪物，稍有不慎便会被它吃掉。", note: "原创", source: "原创", uuid: "93587aca-1f85-4e37-8aaf-2505af82f221" },
  { text: "为什么要担心？如果努力了，担心不会让结果变得更好。", note: "哲学", source: "迪士尼", uuid: "6e8d5dca-6d65-479f-ba05-55db04987ae9" },
  { text: "大丈夫序以为：夫体而国，再而家，后立己。", note: "原创", source: "朴素", uuid: "37304ed3-da30-40a7-905d-415207a661db" },
  { text: "颦蹙矣，侧身独望南冈。", note: "原创", source: "碧水凌涛", uuid: "5734a85e-fcb1-4cc0-b24c-56f53abef6e7" },
  { text: "过去的不再回来，回来的不再美好。", note: "原创", source: "窃格瓦斯·凡", uuid: "ce4e077a-98bd-4fae-a0a6-76da5c60f3a6" },
  { text: "没有理所当然的帮忙，只有个人素养的体现。", note: "原创", source: "loki", uuid: "b8498051-18f4-4ab3-aae2-6f52fd339c99" },
  { text: "拼命奔跑，华丽跌倒。人山人海，边走边爱。", note: "网络", source: "佚名", uuid: "adaf28af-b7af-4fca-8b20-d1da77610703" },
  { text: "本来阴郁的一天，似乎看到一缕阳光破云而出。", note: "原创", source: "寂风", uuid: "7709f5ef-ddaf-4413-963e-2042280756d2" },
  { text: "没心没肺，活着不累。", note: "网络", source: "网络", uuid: "833a4fb8-73e7-473a-ac81-7d0398630dd6" },
  { text: "真相很糟糕？那就别知道真相。记忆很痛苦？那就不要去回忆。", note: "原创", source: "做魚玉子燒", uuid: "439e2a3a-8a14-4e30-8986-7182f91a98a5" },
  { text: "我穷尽了一生，也没能拯救世界。", note: "网络", source: "XesCoding", uuid: "88e20177-29bf-4aa3-8aed-0e4a8226740c" },
  { text: "十年过去了，时间没长大，我却变了。", note: "原创", source: "原创", uuid: "7cd41827-6a2d-476e-ac37-da894c71d513" },
  { text: "你没有舍不得，我也不好意思难过。", note: "网络", source: "网络", uuid: "2dcab3b6-3e87-452a-bbed-ab1dd8b04b52" },
  { text: "开心或者不开心，没人在乎过我。", note: "网络", source: "星云船长洛洛", uuid: "95a7c74c-c676-41df-9dcc-595cb44496dd" },
  { text: "你的温柔只为我一个，我的坚强只为你一人。", note: "原创", source: "忆", uuid: "96363bf6-a338-4982-b008-bdd740e0035a" },
  { text: "你逆光而来，配得上世间所有的美好。", note: "网络", source: "网络", uuid: "10482b23-bc16-4640-ac66-c6e94f666567" },
  { text: "命由己造，相由心生。", note: "网络", source: "佚名", uuid: "9f4f5ded-2d9a-45d0-8e2c-e9f5ffa42c5d" },
  { text: "也许应当是我要先离开，这样结局就不会再更改。", note: "网络", source: "三七", uuid: "291e1bf3-3418-4401-ac70-3de63a82de6d" },
  { text: "我不分白天或黑夜，因为我觉得我的人生就像在白夜中行走。", note: "原创", source: "不善", uuid: "a0cf5e67-ffd9-4b32-befd-8077b6eff198" },
  { text: "天涯咫尺或不及，江湖方寸在此间。", note: "原创", source: "解牵年", uuid: "5e8e3a73-7edc-429f-8bd8-a32496bb08f4" },
  { text: "旧日化白雪，新年踏雪来。", note: "原创", source: "一只生菜", uuid: "c1b29014-4872-4c70-9d7c-cae72581bd7b" },
  { text: "你是住月亮的英雄。", note: "原创", source: "茶褐", uuid: "97911e5a-1789-4a5d-ad7f-51da2575d4da" },
  { text: "真是的，明明第一次做人，却默契的装作了第二次的模样。", note: "原创", source: "寸惑", uuid: "00760622-14c8-4cdc-bbeb-4ce7ffa3fa81" },
  { text: "愿未来总有星火。", note: "原创", source: "菲.lin", uuid: "2364b5e2-0bc9-4a80-a2e3-98ad375743dc" },
  { text: "过去的事情可以不忘记，但一定要放下。", note: "网络", source: "网络", uuid: "18dd75a6-70b4-466f-b5a8-cd37ee5d56fe" },
  { text: "看惯了长夜，仍然要向往天明。", note: "原创", source: "保底全歪真君", uuid: "d35d9cd2-a128-4378-9d94-a117cf4077fb" },
  { text: "你的名字那么普通也就我听到会心头一怔。", note: "网络", source: "网络", uuid: "13ca5ca5-7f6b-49db-b2f3-ede98461bd12" },
  { text: "人若伤感潜回忆，花如红雨泛流年。", note: "原创", source: "做魚玉子燒", uuid: "733daf5c-7abd-4680-8cca-fe112b35dfb4" },
  { text: "既然不能让对手变弱，那就让自己变强！", note: "原创", source: "原创", uuid: "91f38f5e-3afd-4c78-9558-8e794119c796" },
  { text: "你必须先尊重自己，才会真的尊重时间。", note: "原创", source: "不重要", uuid: "438d9358-3ed1-4e2e-90ae-205d965269cd" },
  { text: "这条路会越来越简单，但总会有人成功。那就让这个人是你！", note: "原创", source: "Shawn", uuid: "0b344158-a4e7-4cf0-98a1-0667cd5e4112" },
  { text: "从不主动示弱。", note: "网络", source: "Fanko冯思源", uuid: "27e86927-0ead-405f-99d2-efd344adc9e2" },
  { text: "真可悲，你什么都不知道，在这个世界上没有什么是不重要的！", note: "原创", source: "克劳德", uuid: "ab341911-6b4d-46c1-b1e4-7b9b529a4466" },
  { text: "细节决成败，态度决未来。", note: "原创", source: "繁华", uuid: "9e1b3640-87be-4ed5-a46b-00a052038021" },
  { text: "所赴远山，其下皆川。", note: "原创", source: "鹤空流乂", uuid: "6ceec2ea-c64b-41f3-9dad-e45683e82fad" },
  { text: "天空偷喝了红酒，醉了臆想，红了脸颊，成了晚霞。", note: "网络", source: "佚名", uuid: "ae1eebf1-9352-439c-9a0b-15a98fc1bc61" },
  { text: "活着努力干，死了无遗憾！", note: "网络", source: "Holio", uuid: "29e28f16-f1cf-489c-9122-b9d0e2d07263" },
  { text: "当天空黑到一定程度时候，星星便熠熠生辉。", note: "网络", source: "网络", uuid: "8a589ba3-bcf2-4001-a412-cb88c6adc0fe" },
  { text: "我罚你，余生处处是我的影子。", note: "原创", source: "幕崽", uuid: "c56293c1-889d-46de-92cd-75f1a9b5091e" },
  { text: "人红是非多，人傻当枪使。人蠢猛跟风，人笨不自知。", note: "网络", source: "----来自网络", uuid: "0d309c76-9d77-4818-a3ea-b5e4f28f83d0" },
  { text: "今天没有月亮，月亮在我怀里。", note: "原创", source: "苏晏.", uuid: "a90d7580-7692-4131-b8bd-ae3b03252366" },
  { text: "人是悬挂在自己编织的意义之网上的动物。", note: "哲学", source: "克利福德·格尔茨", uuid: "ca898185-90c7-4a0e-a487-78ca7f205f83" },
  { text: "世界观的转变是一个根本的转变。", note: "哲学", source: "毛泽东", uuid: "7d19fee9-a081-4ad5-9e07-4be7a467c9a9" },
  { text: "我并没有找到真爱，但并不代表它不存在", note: "网络", source: "Qihoo360", uuid: "1b79218f-acc0-4f9e-8c9f-0a07242fb0c8" },
  { text: "允许自己脆弱，允许万物穿过，但不允许自己低落。", note: "网络", source: "轩", uuid: "7ee7fc7a-53bc-4484-b801-7217b4b9360f" },
  { text: "冢边枯萎之叶，何人知是蔷薇？长守孤冢之旁，芳华逝矣。", note: "原创", source: "骨戮八千咲", uuid: "45ede1cc-439c-42c3-9aa1-698288bf6b22" },
  { text: "无法忘却的，无法留念的，就让它随风去吧。", note: "原创", source: "GoodChing", uuid: "f19c5697-7994-424e-ab42-910bb68ae603" },
  { text: "可是啊，儿时坚定而稚嫩的梦，终究没能挺过青春的风。", note: "原创", source: "宽宽", uuid: "bd46d195-a253-4e69-ad09-1d66de96ae85" },
  { text: "胆小鬼连幸福都害怕，碰到棉花都会受伤", note: "网络", source: "网络", uuid: "de6f11a8-4581-4ed4-bf43-bee069cde340" },
  { text: "太多心酸和委屈堵在了心头。", note: "网络", source: "追着山风寻自由", uuid: "1291ae43-cf34-4bed-82ed-4be6c97bb6c6" },
  { text: "跑得快不一定赢，老跌跟头才是成功。", note: "网络", source: "8848", uuid: "793426e4-0418-4f3c-94ad-b0ed31a1dd97" },
  { text: "我看夕阳远走拥抱山野温柔。", note: "网络", source: "追着山风寻自由", uuid: "da748f49-2dfd-4dc6-8b3f-4d07c771def1" },
  { text: "看人情冷暖也尝尽世间烦忧。", note: "网络", source: "追着山风寻自由", uuid: "e7c38df6-c2c3-44ac-8c29-3bf82007b7e0" },
  { text: "落花终有意，流水却无情。", note: "原创", source: "琉璃", uuid: "0a1737e9-653b-4356-8e37-11e8b213258b" },
  { text: "需要的不外乎是“路程”，也许能一步到位。", note: "原创", source: "朴素", uuid: "132f7a23-5381-4a59-bf09-2e38c01ea4b5" },
  { text: "唯有时间的流逝，才能证明我们一直在前进。", note: "原创", source: "stone", uuid: "10694f2d-5d5d-4965-827b-5c7b861b120f" },
  { text: "此去几何，欲说还休。", note: "网络", source: "廖羽", uuid: "d5fbaf2f-f963-4aee-af31-b8a5f736bff2" },
  { text: "如果可以的话，我想从头来过。", note: "网络", source: "互联网", uuid: "240db6cc-9643-4ada-8643-f43d96a251e6" },
  { text: "心事诉与明月收，若问情根深几许，朝朝暮暮共白头。", note: "网络", source: "日月同辉", uuid: "51253fdc-9f1a-400c-8f6c-a57316c81527" },
  { text: "金子与钻石都不是唯一的，可你却是。", note: "原创", source: "Enthon", uuid: "33dd4c25-b432-4030-84c8-88d1c3edf1e2" },
  { text: "爱又像一场旅行，走走停停。", note: "网络", source: "刘嘉星", uuid: "d6b7effd-beed-434a-a2e3-afff6b10e156" },
  { text: "山外阁楼尘世离，落霞明，山无情。遍野蝉鸣，残月上三巡。", note: "原创", source: "黔中极客", uuid: "63f2cc4d-c76d-4a7c-8aa0-3c0f1bfc5c19" },
  { text: "一种事物，一种感情，一旦失衡，就会失去它原来该有的样子。", note: "网络", source: "乏味", uuid: "40347df1-b91b-4c34-b841-c359a2fd0441" },
  { text: "成熟不是人的心变老，是泪在打转还能微笑。", note: "网络", source: "网络", uuid: "22daf211-5921-47f6-82cf-771fe518ee73" },
  { text: "思路也仅仅是思路，不能赖于行走。况且也不止于一条。", note: "原创", source: "朴素", uuid: "a507e5dd-b8a7-4c40-abcd-7c8d213f447f" },
  { text: "那是年少时的我们夜晚下看星空。", note: "网络", source: "我的纸飞机", uuid: "d07c6ae6-cb59-4624-85b7-fed5516be8c6" },
  { text: "苍天璧络天一络，雅月鸿灵月正灵。", note: "网络", source: "佚名", uuid: "12716e33-b440-49f0-bcd0-647c4a970d23" },
  { text: "慢也好，步子小也好，往前走就好。", note: "网络", source: "网络", uuid: "584b77ed-0684-4b31-9eb8-4e21200c1483" },
  { text: "前进路上的阴影，来自身后的光明。", note: "原创", source: "无心却总伤心", uuid: "b043c902-6614-4a06-a608-463d971e58b0" },
  { text: "但总有人会在我终于奔赴向你时拦住我.", note: "原创", source: "茉莉雨", uuid: "cc87314e-a804-404b-8109-baa201349641" },
  { text: "最后一次听你的，尝试着不去想你。", note: "原创", source: "那个她", uuid: "5c390c87-79d1-43a3-a512-2140a4fc7a7e" },
  { text: "千山暮雪，耳畔层云。这段旅程，我们一起走过。", note: "原创", source: "李清照，千山暮雪", uuid: "00e63710-fe0f-4779-acec-2b1b3828b48b" },
  { text: "在我单枪匹马的背后，是爱我的千军万马。", note: "网络", source: "黛西", uuid: "4acd1f36-e6a6-40c4-920d-0fc99df6d8d2" },
  { text: "你流的汗还不及泪多。", note: "原创", source: "抱月", uuid: "9884ecc8-aa15-45cf-87a4-2534c748b4cc" },
  { text: "因为不可能，所以才值得相信。", note: "哲学", source: "歌德", uuid: "94804dc7-f661-4c14-a995-c44405fd671b" },
  { text: "重覓小徑人不在，忽見天青又紫霞。", note: "原创", source: "做魚玉子燒", uuid: "580317dd-a245-4152-a6f7-d82cd075bdcc" },
  { text: "人生没有白走的路，每走一步都算数。", note: "原创", source: "dthope", uuid: "e621cb7c-78e5-4520-b780-08be48bc4aad" },
  { text: "盐于律己，甜以待人。", note: "网络", source: "佚名", uuid: "7433279e-6797-4332-b1fd-f9ef38fbd6b1" },
  { text: "过去已成过去，将来还是将来，而我们能改变的只有现在。", note: "网络", source: "网友", uuid: "fc01370f-ef1c-45f5-ac74-efd84ab2e557" },
  { text: "死去的人不需要花。被花所拯救的是留下来的人。", note: "网络", source: "伪春菜", uuid: "8feabad3-35bc-4edc-8752-a35eae0617cd" },
  { text: "恋爱是为了开心，选择不爱也是。", note: "网络", source: "佚名", uuid: "ee292874-0df7-4e1e-8d30-9e86b105a5d8" },
  { text: "落日的余晖洒落在人间，抹去的是不知道属于谁的忧愁。", note: "原创", source: "yzuyuz", uuid: "a88a5656-0517-4249-8de4-325262b636b2" },
  { text: "你所做的一切，都是在重复昨天。", note: "原创", source: "LinF2333", uuid: "e4bfc2fe-9472-4e88-9cc0-45a30e51bdf0" },
  { text: "每天都是新的一天，有好运比什么都强。", note: "原创", source: "契约千魂", uuid: "02ebeee4-22be-4d78-a582-c68d9982a5e6" },
  { text: "我们不能成为贵族的后代，但我们可以变成贵族的祖先", note: "网络", source: "Qihoo360", uuid: "ce9e74bf-da86-43d0-84ec-c9900d227c49" },
  { text: "世界支离破碎，好在，有你相随。", note: "原创", source: "reikuu", uuid: "c9ccf176-4171-49bb-8e55-feb447e91e1d" },
  { text: "寻君不见西风夜，独立寒宵看地图。", note: "原创", source: "坤武帝", uuid: "b6961be4-742c-42cd-b9b6-cd69a8edc3f0" },
  { text: "枯星朽月误时辰，昏沉再拭酒痕。", note: "网络", source: "楼玉明只是路过", uuid: "c7b12605-5e38-401d-9c56-34c8298e1657" },
  { text: "理想三旬浓烟下，奔赴山海与荒野。", note: "原创", source: "浓烟下", uuid: "c815434e-2f69-401f-9338-ba297f36e550" },
  { text: "借岁月一瓢酒，潇洒饮春秋。", note: "网络", source: "王健美", uuid: "5e0e4b1f-527b-4835-a642-21ade5103343" },
  { text: "只愿求得块炽热的体腔，捍卫这殷情的衷肠。", note: "原创", source: "碧水凌涛", uuid: "512d813e-c3b7-4ca3-af6f-6bb334a1236b" },
  { text: "既然人的尽头是死去，那人活着的意义是什么。", note: "网络", source: "贴吧", uuid: "2ce497e5-d683-4d46-8e81-dc63badfd5b1" },
  { text: "时间是命运最无情的馈赠。", note: "原创", source: "LJS80", uuid: "53c2df26-341b-44f7-9a2d-b2b403ea9503" },
  { text: "自身拥有越丰富，他在别人身上所能发现得到的就越少。", note: "哲学", source: "亚瑟・叔本华", uuid: "5d054917-0f24-4df1-ac08-e819f5fbd9f0" },
  { text: "你明明没有任何实力，就不要再欺骗自己了。", note: "网络", source: "洛谷", uuid: "bceaf76f-5810-40b8-9db2-b8b2e1f86d4e" },
  { text: "不做无情的仙，只做有情的人！", note: "网络", source: "耳根", uuid: "e2fc1273-f677-4bd2-a4d1-f1805d1a4e0e" },
  { text: "可以嘲笑你的朋友，但不能嘲笑他喜欢的东西。", note: "原创", source: "茶", uuid: "14e98e54-dbfb-47f1-9ce0-9508fe8a1ea4" },
  { text: "穿川晓月皎明雾，烟起云涌润一花。", note: "原创", source: "Heriko Deltana", uuid: "e539fda5-654c-4b25-9de1-c4174ccd8a67" },
  { text: "心之所愿，无所不成。", note: "网络", source: "网络", uuid: "b5eb69b1-b565-46b4-b1b9-13e75ca70ab2" },
  { text: "小时候的记忆，好无价。", note: "网络", source: "小寒", uuid: "8f86b585-429b-4b2d-88de-0838a916e657" },
  { text: "从伟大崇高到荒谬可笑，其间只相差一步。", note: "哲学", source: "拿破仑", uuid: "512f8e2a-b30a-469d-a42f-343a44f59cdc" },
  { text: "所爱隔山海 山海亦可平", note: "网络", source: "来自网络", uuid: "15d10d5b-f7f2-481f-b177-7003898aca76" },
  { text: "我眼中的世界，你们看不到。", note: "网络", source: "耳根", uuid: "16c44d67-0350-4994-a57b-4151d31fff1c" },
  { text: "你不一定逆风翻盘，但请一定向阳而生。", note: "网络", source: "佚名", uuid: "9da80e53-ab81-41b8-b16d-c50eda830759" },
  { text: "你的回应是一直沉默。", note: "网络", source: "廖伟志", uuid: "5a9af68c-cd1a-46ef-984e-d8557b4b7c70" },
  { text: "趁天空不注意，劫持一点晚霞送给你。", note: "网络", source: "匿名", uuid: "bc31ca42-16d2-4dd5-bf74-8fb4f00eda61" },
  { text: "我们现在所做的，只是自认为是动态规划的贪心罢了。", note: "网络", source: "Varuxnn", uuid: "812f947b-29c9-4f58-b406-4fc2bb1b3bbd" },
  { text: "知君肝胆昭昭印刻前文。", note: "网络", source: "楼玉明只是路过", uuid: "b1a8a245-57f1-40c3-b089-9d3dedfde25a" },
  { text: "想丢掉回忆，却又牢牢握紧。", note: "原创", source: "做魚玉子燒", uuid: "ca9bb520-9959-4ae2-b4a3-04ab545bb3bc" },
  { text: "用什么来爱，用什么方式，用什么去对待。", note: "网络", source: "30年前，50年后/烧灯续昼", uuid: "d6824bd6-3be8-4da2-80bd-f18ca9ca0f58" },
  { text: "独属于盛夏的梦，跌宕了多少春秋。", note: "原创", source: "宽宽", uuid: "2c79a5fc-3ced-4b45-a1d4-a15bb640c546" },
  { text: "如果读书，世界就在你眼前；如果不读书，眼前就是世界！", note: "原创", source: "lyx12t5", uuid: "8947ae11-7dd8-434f-94d3-754e60103615" },
  { text: "我们通常把自己做的傻事称为“命运”。", note: "原创", source: "凡ICE", uuid: "4353d678-062b-4cac-8ee5-e00fadbbb079" },
  { text: "故事不长，也不难讲，脸红出场，眼红散场。", note: "原创", source: "深情的人", uuid: "2408483d-8e61-42dd-9fb0-b0b52543fd0b" },
  { text: "当你逃脱法律监管的同时，也失去了法律的保护。", note: "原创", source: "nDhnzr6r", uuid: "08e95cc9-6e00-435d-83bd-313eed263b13" },
  { text: "春天适合努力和拥抱。", note: "网络", source: "网络", uuid: "749f7393-79db-41d8-893c-cc8b8e66bacd" },
  { text: "乐正司百曲，绫动万年红。", note: "网络", source: "网络", uuid: "8b24283c-35aa-425c-a1d5-54155aabdb3a" },
  { text: "以爱回应忠诚，以荣誉回应英勇，以复仇回应背叛", note: "网络", source: "Qihoo360", uuid: "0f921ae1-6340-45d6-82b6-58b2f58e728e" },
  { text: "愿你历尽千帆，归来仍是少年.", note: "网络", source: "盛夏", uuid: "5f66b0b5-12e6-4673-b21e-cdb7537fd830" },
  { text: "我会把一切都献出，请和这样的我恋爱吧。", note: "网络", source: "我不吃饭", uuid: "faee41b1-61e5-44c4-b408-9fa9e0e8d896" },
  { text: "谁不和我们一起就是反对我们，中立的人最危险。", note: "哲学", source: "弗拉基米尔·伊里奇·列宁", uuid: "5113e95a-3ac7-4e8a-afb2-b0bb5e8aef23" },
  { text: "希望月光带你回到我身边。", note: "原创", source: "茶褐", uuid: "0ec208e4-9f0a-41ba-abe5-3a744e5ad584" },
  { text: "亲爱的，你当然有哭泣的权利。", note: "网络", source: "Color_洛洛洛", uuid: "71a0bcd1-44e7-4620-8c9a-04e1116b5c01" },
  { text: "总喜欢一人躲在暗夜听老歌，曲曲皆是回忆，句句皆是过往。", note: "原创", source: "漠子荀", uuid: "41d924d1-bf12-4c2e-89ea-7ee5719848b3" },
  { text: "天下没有不散的宴席，那就放下过去，憧憬未来！", note: "原创", source: "姜传江", uuid: "5bd117a9-2025-458a-aacc-371d32e9f406" },
  { text: "真正喜欢你的人你再蠢的套路她都愿意吃你的。", note: "网络", source: "佚名", uuid: "d480ba31-ee82-4803-80df-ef31ef1ea72a" },
  { text: "在隆冬，我终于明白，我身上有一个不可战胜的夏天。", note: "哲学", source: "加缪", uuid: "a4f72928-f9c4-4910-9940-2fbb6052c8a7" },
  { text: "往事匆匆，但愿你也能感动。", note: "原创", source: "又诗几行", uuid: "63b834bf-cb2e-4d4c-8a9e-2b4582b2a12a" },
  { text: "我欣赏无头苍蝇的勇敢——勇往直前。", note: "原创", source: "paper", uuid: "0c3dd7ee-a968-45bd-815e-d1e45c47de1f" },
  { text: "世界的本质是随机。", note: "原创", source: "auc", uuid: "90b653cf-40ed-4107-bdba-ad130ba64013" },
  { text: "从来处来，望尽岁月如歌，莫忘来时之路。", note: "原创", source: "Rene", uuid: "12fe3196-fa09-410f-9ba0-b5782b01a52f" },
  { text: "知识有两种，一种是你知道的，一种是你知道在哪里能找到的！", note: "哲学", source: "塞缪尔·约翰逊", uuid: "db2c4ea6-ce7d-4637-8aa8-456f2e4ec874" },
  { text: "缅世道之隽永兮，溘长虹之蜿蜒。", note: "原创", source: "一只叫一行的喵", uuid: "baa91fca-7606-47e3-9cf9-ffbcf69cb7b1" },
  { text: "灯火欲离失，轻影黯花湿。微浮半谋面，我与泪三痴！", note: "原创", source: "月雩", uuid: "f95d83d8-db94-45f7-b917-02edeb6ea954" },
  { text: "世界是一场空虚的宇宙，有时候仍像是一个梦。", note: "哲学", source: "小冰", uuid: "ea98f8bf-0394-4adb-929f-5fe45b633230" },
  { text: "嘴上说着考名校，手里打着游戏，你是在和谁开玩笑。", note: "原创", source: "边妤仙", uuid: "2c61063d-5f62-4a1e-8037-9115c0a5f05f" },
  { text: "希望只在一瞬之间，而黑暗，永恒。", note: "原创", source: "孤影墨香", uuid: "4a5d608e-aeb1-4f6f-bbbf-74d3ac0ea44e" },
  { text: "不知天高地厚，只知天长地久。", note: "原创", source: "璃黯", uuid: "95451737-19f3-4e6a-84bc-60856b39406d" },
  { text: "若有来世重逢，再续未了情。", note: "网络", source: "日月同辉", uuid: "e036990d-b61b-4e23-b29e-84f8175ac1d3" },
  { text: "我算不算你唯一寄托。", note: "网络", source: "你有没有真的爱过我", uuid: "20ad9b30-972d-49fa-9ac9-259f67c20d51" },
  { text: "每个人都是生命中的过路的人，而我也在路途中。", note: "原创", source: "非科学のカッパ", uuid: "6c32ec00-32a2-4c47-99ff-e43bc87dcda6" },
  { text: "自由意志问题也可以被区分为浅问题和深问题。", note: "哲学", source: "田平", uuid: "00e89a10-fc9a-4706-b48a-e7a32bcf13da" },
  { text: "我为碎银奔走更不敢停留。", note: "网络", source: "追着山风寻自由", uuid: "36ba461a-d086-4548-a9eb-144cb5bf7b3d" },
  { text: "生活中若没有朋友，就像生活中没有阳光一样。", note: "网络", source: "网络", uuid: "fb3302c7-d101-441b-96e0-48f3b80ccb5f" },
  { text: "自在从容，要走的不留。", note: "网络", source: "王健美", uuid: "0158a291-ae08-4d14-b303-3effad874842" },
  { text: "我疯狂对你执着，这般感情就如同坠入幻境。", note: "网络", source: "三七", uuid: "aa4284a9-0111-43b6-9eda-1f579a418df7" },
  { text: "还没来得及习惯独自入睡的不安。", note: "网络", source: "应晓璃", uuid: "db1e34a5-6d3a-419d-a886-34eca397ba65" },
  { text: "中天嚣嚣，尔行不止，求神易灵。", note: "原创", source: "朴素", uuid: "00db6f55-268f-4d69-a7c4-fe6f97d88aab" },
  { text: "伤痛，乃成长的捷径。", note: "原创", source: "Chengzhang", uuid: "cbdcbc60-e533-4f35-b26f-b0f02ce4e6e3" },
  { text: "可惜我败给了命运的浪潮，杜鹃啼血，月黑风高。", note: "原创", source: "鱼鱼喵", uuid: "f4531473-dc20-41c6-9a98-164661f4fa56" },
  { text: "你会梦游，我会磨牙，我们晚上一起去吓人吧！", note: "原创", source: "一萍敌敌畏", uuid: "57f7a4f2-24d7-4374-8a80-8a960a62e79f" },
  { text: "旅行的意义在于找到自己，而非浏览他人。", note: "网络", source: "网络", uuid: "80541a4b-0ef6-4a1a-9398-5e54d4562381" },
  { text: "两个世界的交界处，他们仿佛真的站在那里。", note: "原创", source: "CuSO4", uuid: "09e97cb2-2f55-4149-bfd7-fce9800ea804" },
  { text: "难过从来就不能解决任何问题", note: "网络", source: "网络", uuid: "93377dff-492f-45c6-ad4c-cad9488ebb67" },
  { text: "该来的回忆总令人回味。不该来的，迟早逝去。", note: "原创", source: "终究", uuid: "40d2e6f7-11c4-4e08-a317-8306dd570717" },
  { text: "平安喜乐，万事胜意。", note: "原创", source: "张喜乐", uuid: "a62f7655-39f6-4b4f-b292-4982d4d01c38" },
  { text: "世界总有缝隙，那是光照进来的地方。", note: "网络", source: "网络", uuid: "874d34a9-41df-4dee-af12-202af724f6cd" },
  { text: "世界从不过问我们的境遇，她只是把选择放在我们面前。", note: "网络", source: "未知", uuid: "ef3d242a-11fd-4af1-85b7-7d4497847fe8" },
  { text: "为错误停驻是件可悲的事。", note: "原创", source: "LastFairy", uuid: "a2f2a423-4d2e-4f44-878e-0a3c6fb79181" },
  { text: "求你别离开我，我拼了命的隐藏着痛。", note: "网络", source: "三七", uuid: "cdd439fa-7ca7-476b-8679-05345de441a3" },
  { text: "亲人的离去不是一场暴雨，而是此生漫长的潮湿。", note: "网络", source: "网络", uuid: "ead767fc-6342-4b1d-80da-47e72a2fcdca" },
  { text: "骨笛生了锈，想你我就能吹奏。", note: "网络", source: "二水/自游诗", uuid: "7d91c968-001d-493b-bb02-bd2a84f943ea" },
  { text: "你若回身看，长镜头越拉越缓慢。", note: "网络", source: "徐重来", uuid: "bf56ad31-f2e7-47a6-9c0c-34053be90450" },
  { text: "穿别人的鞋，走自己的路，让他们找去吧。", note: "原创", source: "原创", uuid: "8f69d1d8-ee66-47e9-abe6-a745a060a629" },
  { text: "报复的本质只是增加了邪恶。因剑得到的亦将因剑失去。", note: "哲学", source: "甘地", uuid: "9697f567-5b2a-4ab5-a72a-707db2d390fb" },
  { text: "一直往南走别太久，乖乖摸摸头。", note: "网络", source: "我的纸飞机", uuid: "cd2c094d-48d5-4413-a24e-ee072c3abe17" },
  { text: "只有懦弱和失败者才会四处寻找借口。", note: "网络", source: "网络", uuid: "ff67e1aa-583e-41e0-9584-0bbcf41fac3c" },
  { text: "把半生的将就，换成那自由。", note: "网络", source: "王健美", uuid: "104cc821-70dd-436f-848e-e73c097ce094" },
  { text: "不要为小事遮住视线，我们还有更大的世界", note: "网络", source: "Qihoo360", uuid: "941a0030-4cf3-4311-a510-3bb522a4b454" },
  { text: "如果圆规的两只脚都动，永远也画不出一个圆。", note: "网络", source: "网络", uuid: "629a0366-08cd-483b-bbb7-9a62e9fea820" },
  { text: "能保护好大哥，我已经很满足了。", note: "原创", source: "Mr.Chen", uuid: "fb673637-fc31-4ca4-a2a1-eacf51f69946" },
  { text: "每当故事结束的时候，人们总会想起故事的开始。", note: "原创", source: "郁离", uuid: "8ebf009d-d823-4f5f-bbd2-aa59315b1c8a" },
  { text: "幸福的轮廓，大概是圆形吧；那痛苦呢？", note: "原创", source: "linkey2011", uuid: "4890484c-7e38-4a26-a126-32c3e7a35cee" },
  { text: "逃避者不配拥有未来。", note: "原创", source: "10circle", uuid: "b3fe7a8e-6e8c-4a60-8a69-b28b454c276e" },
  { text: "向前看，不要胆怯，不要在原地停留。", note: "原创", source: "岁曳", uuid: "e3e093b8-9548-4334-ae08-7d7c8e8f3be0" },
  { text: "日高悬，风拂面，留下丝丝温暖。", note: "网络", source: "花晶晶", uuid: "769bc705-027d-410a-8313-dcef4051cb2f" },
  { text: "大抵是因为你没来找我吧。", note: "原创", source: "茉莉雨", uuid: "16a8cbaa-7251-44e6-905f-3ddbfc88a339" },
  { text: "团结，勇气和绝不动摇的忠诚是人类最大的优点！", note: "网络", source: "十六椰子", uuid: "f95af38f-2def-4109-8696-14596c19727b" },
  { text: "自由不是脱离现实的逃避，而是在现实中找到内心的平静。", note: "原创", source: "CuSO4", uuid: "baa241e8-52d6-408d-8743-a5963c3f4dd9" },
  { text: "可这世间疾苦，照样没放过我", note: "网络", source: "来自网络", uuid: "605577db-1217-4f11-bb3c-3dc614bf7517" },
  { text: "予力众生，成就不凡。", note: "网络", source: "Microsoft", uuid: "eb65cb76-b24c-4373-a366-2f4112a28318" },
  { text: "虽然已经不能见面了，虽然孤独，但是不要紧。", note: "原创", source: "一个无归期的人", uuid: "88b7d9a7-3e24-4000-9781-e59be3614e6c" },
  { text: "弹指间，恍如隔世，再回首，已陷踟蹰。", note: "原创", source: "宽宽", uuid: "865ac09f-95e5-4422-8ff2-7b1e12083789" },
  { text: "我在你看不见的地方，看了你无数次.", note: "网络", source: "佚名", uuid: "22ea6cd7-cdbc-48a5-b3c3-628f58fef4c5" },
  { text: "一路缓缓前行随云儿荡悠悠。", note: "网络", source: "追着山风寻自由", uuid: "c55f941d-b5d3-4e79-9f47-c85c9caf425d" },
  { text: "星星在枝头，云朵替我在挽留。", note: "网络", source: "二水/自游诗", uuid: "a2a1438f-80f3-41b9-a59a-a8fd88299df6" },
  { text: "盛夏里，溺于深绿。", note: "原创", source: "张小可", uuid: "3f822928-62ec-481a-99c2-2d3fff621f12" },
  { text: "相爱不需要技巧，但是相处需要。", note: "网络", source: "佚名", uuid: "25c6bc85-896e-4ef8-baa2-fc84b63a479c" },
  { text: "我从他的生命里消失，而他依然闪亮。", note: "网络", source: "网络", uuid: "5f6a0632-76b8-489e-b9c0-b34257842be2" },
  { text: "藏巧于拙，寓快于慢。", note: "网络", source: "陈亮舟", uuid: "7bd47ff3-adf0-468b-abd1-79e8dedfbc4d" },
  { text: "所谓有求而不得，人心欲壑，可填沧海。", note: "网络", source: "精卫（万物终归向海）", uuid: "660b50a7-fa2f-42f9-941e-2e9c01c49fc5" },
  { text: "别疑问，疑问就去找答案！", note: "原创", source: "Shawn", uuid: "f8259c64-add1-4ed6-b5ca-4c6349664f11" },
  { text: "感情里付出太多，放不下的人是我。", note: "网络", source: "三七", uuid: "33edb3ed-8616-4502-8ef5-247584eaa638" },
  { text: "有些规则是给需要规则的人准备的。", note: "哲学", source: "佚名", uuid: "458307d1-008b-495e-b228-d4fc88f61769" },
  { text: "如果相遇注定分离，我的爱只会走向极端。", note: "原创", source: "做魚玉子燒", uuid: "8963168a-634d-40e8-9c13-8e87a5bcf844" },
  { text: "本是无所谓输赢的，却在一时激发起了斗志。", note: "原创", source: "不善", uuid: "b9fe6313-029f-43da-b125-0eb7e7213c4a" },
  { text: "我已无心向明月，明月未尝照我心。", note: "原创", source: "pp", uuid: "ad0921bd-c4ce-4e95-a4bc-0e2674614ea6" },
  { text: "为了什么？人不就是为了创造这样的回忆才来到世界上的吗？", note: "原创", source: "CuSO4", uuid: "814aae08-276e-44e2-8e5a-151bebcc985c" },
  { text: "别人总是以为你什么都有，但你只剩自己了。", note: "原创", source: "意难藏", uuid: "32d489cf-be43-475f-b23c-a0abf5da1713" },
  { text: "成为神的代价是孤独。", note: "网络", source: "网络", uuid: "9001a59b-59ec-4c5e-b857-818de95cfc07" },
  { text: "分手了就是分手了好聚好散大家都各自安好就好了。", note: "网络", source: "童锦程", uuid: "19bbf60a-d8f0-4eb5-967a-05f4c4fe7ee5" },
  { text: "过去的都该过去，值得记忆的才要留到现在。", note: "原创", source: "Naya", uuid: "67a79341-50f4-4e6f-8f34-41a8c2ba8afa" },
  { text: "好日子在后头，但人要向前走。", note: "网络", source: "不详", uuid: "7e43ebdf-44e7-49db-b434-7bbbfa2de9be" },
  { text: "教我折飞机的他，好吗？", note: "网络", source: "小寒", uuid: "bddd5f8c-141e-4860-98fe-4d98cb583da7" },
  { text: "笑声让我想起童年暑假，那个他。", note: "网络", source: "小寒", uuid: "1923f8f1-405a-4fbc-830c-9fcb83d1553b" },
  { text: "千篇一律的面具背后尽是伪善的人心。", note: "原创", source: "夜杏", uuid: "37fa0c87-0b04-49aa-9509-c7f520f51d6f" },
  { text: "怕睡，把人变愁，怕醒，把梦击碎。", note: "原创", source: "做魚玉子燒", uuid: "a58d76e9-04e0-49ab-b6ba-57958f064bca" },
  { text: "时岁可忆流年，久别仍知归途。", note: "原创", source: "鹤空流乂", uuid: "802b3f74-f10e-4c16-9acb-c16eaf5f910b" },
  { text: "不下凡，不成仙；不疯魔，不成活。", note: "原创", source: "菲.lin", uuid: "c5e1009e-861b-4e46-b1b8-5cf6c7a834a4" },
  { text: "捻一缕秋水，行走在秋天的群山上。", note: "网络", source: "未知", uuid: "d1e146c9-a742-4d9f-80fc-e158356303d6" },
  { text: "是否平行时空交错，能遇见另个我。", note: "网络", source: "三七", uuid: "23e5c883-6902-48c2-8804-fe7b4b16cb95" },
  { text: "只想着相见时春风细雨甜，哪管他相思夜星前月下苦。", note: "原创", source: "日央", uuid: "950eb0a3-cc49-4824-bf75-5abee9ca8ed5" },
  { text: "黎明前的黑暗，是最深不见底的黑暗。", note: "原创", source: "彭小呆", uuid: "467eb993-72bd-4191-a558-0f2869607e5e" },
  { text: "真正无穷的自由，会包容你所有的思念", note: "原创", source: "原创", uuid: "b3065772-c92a-4782-9efd-fd941db743d0" },
  { text: "如果你是一匹千里马，那么请做自己的伯乐", note: "网络", source: "Qihoo360", uuid: "2f95e1e1-be7d-4e92-9de7-22bab9bcb9b5" },
  { text: "若你回头看我一眼，我此生不必再见春天。", note: "网络", source: "佚名", uuid: "243d9b8b-e6ac-4c4f-85a2-9f3809a089fc" },
  { text: "自立自主总胜过俯首为奴！", note: "网络", source: "网络", uuid: "ceedd4bc-7dc3-4c1f-8fd2-dc54ff5c7983" },
  { text: "定义虽然精确，现实极度模糊。", note: "网络", source: "网络", uuid: "b6b4bc61-1038-4b26-b3d0-11dfdb0eb7ba" },
  { text: "眼泪不能洗去痛苦，但岁月足以抹去一切。", note: "原创", source: "希铁石z", uuid: "1ce81a72-5917-4081-8c91-56e736cc1786" },
  { text: "远赴人间惊鸿宴 ，一睹人间盛世颜。", note: "网络", source: "佚名", uuid: "92ff8be0-41c2-45e5-8a2b-c5487dddace4" },
  { text: "你可不是什么普通女孩，你是我的女孩。", note: "网络", source: "贴吧", uuid: "410177d0-e4da-4753-8dea-c9336b69fb78" },
  { text: "无人与我立黄昏，无人问我粥可温。", note: "网络", source: "网络", uuid: "d8bfbf33-e04a-4f69-a2bf-bcce9bbf3c89" },
  { text: "时间是存在者的时间。", note: "哲学", source: "海德格尔", uuid: "550590e3-8595-452f-907b-db87f6e10780" },
  { text: "水的清澈，并非因为它不含杂质，而是在于懂得沉淀。", note: "网络", source: "网络", uuid: "f0421921-1294-4f8a-8eb7-8cbe8fc55360" },
  { text: "一个人在沙漠的机场，等一艘开往亚特兰蒂斯的船。", note: "网络", source: "佚名", uuid: "61e5bc93-375d-43e6-b21d-85fdb38cb219" },
  { text: "君子不重，则不威，学则不固。", note: "哲学", source: "孔子", uuid: "5cccbc66-6649-471a-8def-77b038a93729" },
  { text: "扬帆，启航，勇往直前！", note: "原创", source: "paper", uuid: "70718266-8583-4236-b860-611a629e1a65" },
  { text: "光，火交错，诞生了夕阳。", note: "原创", source: "GoodChing", uuid: "830b7fb7-49f8-4bda-b061-379223677d54" },
  { text: "知君肝胆昭昭刻前文。", note: "网络", source: "楼玉明只是路过", uuid: "6501f582-1df8-4dd4-9ad0-659ca3d43189" },
  { text: "保护蜥蜴，人人有责。", note: "原创", source: "蜥蜴", uuid: "336faf74-7696-4f2c-9d2c-bd3d4de72c87" },
  { text: "有的人沉迷过去，是因为他还不知道自己的未来是多么远大。", note: "原创", source: "Yek", uuid: "2c524d53-e3b2-4745-9d66-800d18262ace" },
  { text: "如果不被畏惧，神又何以为神。", note: "网络", source: "网易云音乐", uuid: "ae10a4aa-78d4-4ae1-b563-c1e97f425703" },
  { text: "聪明是一种天赋，而善良是一种选择。", note: "网络", source: "佚名", uuid: "a2c80496-68e9-4709-b27c-05cd40902cd0" },
  { text: "她拨弄琴弦，扬起潮汐。", note: "原创", source: "我", uuid: "0467d7cf-bca2-4cee-81ab-0b0640e51069" },
  { text: "不问山高路远放下了奢求。", note: "网络", source: "追着山风寻自由", uuid: "75c0f3be-a47e-4bc2-8c27-60171ffdd220" },
  { text: "穿山甲到底说了什么？", note: "网络", source: "暴走大事件", uuid: "a2c477a6-5097-4b25-8d37-fcef4b31620d" },
  { text: "当你理解人性，你就理解了历史的本质。", note: "原创", source: "大虫", uuid: "f49e9fe1-ec69-4b9a-9fb3-1456f18d4447" },
  { text: "一本书上每多一个公式，就会减少一半读者。", note: "哲学", source: "霍金", uuid: "0a97af92-1467-4fa5-897d-426fc94a7fcc" },
  { text: "每一天都可能会有刷新你世界观的事。", note: "原创", source: "原创", uuid: "83304462-2325-47cb-b36c-367bfefc7f08" },
  { text: "沙二的风吹不到小镇，炽热的心困在迷城。", note: "网络", source: "网友", uuid: "de9f8d43-2d38-410e-afa5-5a4d0426702e" },
  { text: "求你别离开我，因为我，欠你太多。", note: "网络", source: "三七", uuid: "20a70cd5-b5cd-43d3-bc29-4886e11bca62" },
  { text: "纵观世界无非就两件事最火：断章取义和美名其曰。", note: "原创", source: "无名氏", uuid: "e8421802-8dba-43d3-a4a4-842f5338f0c5" },
  { text: "如果能摸摸我的头的话，我会很高兴的！", note: "网络", source: "网络", uuid: "21491bfc-0d62-4c29-9193-95ab8ec4b9c4" },
  { text: "半墨荒唐留纸上，半梦清泪掩眸光。", note: "原创", source: "荒眸", uuid: "67a0a393-05ca-469d-852e-5358d34de87a" },
  { text: "亲爱的，你不是救世主。", note: "原创", source: "江池屿", uuid: "9408dd6d-69f7-4f8f-804d-921f09537fc9" },
  { text: "给你的努力一个交代，挥出已经紧握在双拳中的梦想。", note: "原创", source: "柠檬盐", uuid: "d04f0c6a-65bb-47b4-b279-f61ac4e63a92" },
  { text: "伟大的造物源于伟大的心灵。", note: "网络", source: "影视飓风", uuid: "b959f55a-35e9-4578-a98a-732d5c2437b9" },
  { text: "时光荏苒，也寻昨日回忆不断，哪怕留万般无奈，傲骨谁还在？", note: "原创", source: "林萧", uuid: "0bd9177a-190b-474c-b133-12a37e564ffa" },
  { text: "是怎样一个你闯进了我命运。", note: "网络", source: "路小可", uuid: "67a9b3d3-62be-4d62-9ef4-f2b64d2b05a0" },
  { text: "星星之火，可以燎原。", note: "哲学", source: "毛泽东", uuid: "72acf351-0a13-4601-a90f-04dbbfdc5468" },
  { text: "如果必须要失去，那么不如一开始就不曾拥有。", note: "网络", source: "知乎用户尚守晨", uuid: "8cff0c07-5b56-495d-b7e0-168abeb91a14" },
  { text: "生活先给予你希望，然后是绝望。", note: "网络", source: "清巳星嵐", uuid: "7dfe4e2d-3041-4594-a24c-347a130de4da" },
  { text: "失落至极致，是虚无。", note: "原创", source: "GoodChing", uuid: "85332196-c873-45ce-b23c-db2336ac8674" },
  { text: "将行之事，必将已行；已行之事，必将再行。", note: "哲学", source: "圣经", uuid: "7eb2b856-22c3-466f-93b9-2484179bc85a" },
  { text: "满堂花醉三千客，一剑霜寒十四州。", note: "网络", source: "奥藤蔓", uuid: "b5bef0ec-2be8-47b2-aee9-f6368d3f3ab9" },
  { text: "我想拥有温柔，不仅仅止于表面的伪装。", note: "原创", source: "原创", uuid: "7c7ea4d6-34e8-42e5-83be-2124c112de6d" },
  { text: "从今以后，你走你的路，我演我的戏。", note: "原创", source: "宋锦瑟", uuid: "226a5499-7ef4-44ea-9750-06c338d2faab" },
  { text: "十八成年亦乘风。", note: "网络", source: "佚名", uuid: "cc509461-7042-4bef-b5c9-ccd343f4adfc" },
  { text: "找不到路，就自己走一条出来。", note: "网络", source: "网络", uuid: "256c3fe2-5328-44c5-a7b2-cfed198112ef" },
  { text: "没有动漫的世界，就是没有的光明的大地！", note: "原创", source: "617969448", uuid: "c7a9597a-c681-4179-8c63-a8a2af1810fa" },
  { text: "半步又见梨花亭，残叶落无声。", note: "网络", source: "蓝乐", uuid: "76e1797e-1c31-42ee-9fc3-740fd995e63a" },
  { text: "你真的，不打算用自己喜欢的方式去过这一生吗？", note: "网络", source: "佚名", uuid: "88472b4b-17bc-41dd-9a6b-b8f839633c97" },
  { text: "是他们飞啊飞向了黑河。", note: "网络", source: "道雀Bzz", uuid: "39579ea5-e330-4b1f-9af4-2985a4fa265b" },
  { text: "要发光，而不是被照亮。", note: "网络", source: "抖音", uuid: "eaef9294-84cc-42b8-bcc2-9370a7091d96" },
  { text: "下凡历劫一场，所以万般皆苦。", note: "原创", source: "不知布偶", uuid: "f2826e46-6b37-4f21-815c-4a82bd391ac8" },
  { text: "梦醒人终散，缘尽情已空。", note: "原创", source: "幻梦琉影", uuid: "78a3bde8-582f-484c-bc0d-2b869cef5f56" },
  { text: "趁现在吧，一点一点，重新来过。", note: "原创", source: "边妤仙", uuid: "8a259e33-2069-4e1c-b056-f6d0d91dc163" },
  { text: "真正没有资格谈明天的人，是那个不懂得珍惜今天的人", note: "网络", source: "网络", uuid: "8e9cd8d5-bc73-4313-adbf-8698052e19c8" },
  { text: "希望你像晴天一样明媚，然后好好吃饭。", note: "原创", source: "墨韩", uuid: "278d550a-4dab-4bf4-ab6e-ad646c83cfc3" },
  { text: "数学和物理，就是把看不见的星星写在了纸上。", note: "网络", source: "网络", uuid: "99fced6b-65c5-4088-9859-67de2f925d58" },
  { text: "天下没有免费的午餐，努力创造奇迹吧少年！", note: "原创", source: "不朽千秋", uuid: "70b5301e-7240-4556-a305-f279fe94aac7" },
  { text: "没有逃不脱的厄难！如果有，那是因为还没找到那合理的理由！", note: "原创", source: "朴素", uuid: "86fe5b12-bc21-41e4-894b-d799a68b1d40" },
  { text: "给时代以图论，给人生以动规。给当下以分治，给未来以递推。", note: "原创", source: "Zirconium", uuid: "9f05e52c-4eb9-4919-9f2c-62c6b2aada80" },
  { text: "我们控制，我们收容，我们保护。", note: "网络", source: "scp基金会", uuid: "35effde8-b080-4d58-871e-6519be1d504d" },
  { text: "快乐是永不忘的，抛开烦恼自有解答。", note: "网络", source: "小寒", uuid: "7bdddbef-04ed-44cd-a22e-e02634c1206d" },
  { text: "画面只剩褪色的轮廓。", note: "网络", source: "你有没有真的爱过我", uuid: "fdcd277a-2147-4a03-99be-0b74f353eb78" },
  { text: "归期不定，但忘却、昼短情长。", note: "原创", source: "碧水凌涛", uuid: "def32ab6-69db-4868-94ae-70238591b391" },
  { text: "静静地，一切都过去了……", note: "原创", source: "顾小林", uuid: "f1203195-a838-4dbf-a51c-1c2645d5fc22" },
  { text: "辉煌一刻谁都有，别拿一刻当永久。", note: "网络", source: "杜海皇", uuid: "23f8a4cf-20c3-4a6d-b6fe-c23fce97bc2b" },
  { text: "我的纸飞机飞到了我的面前。", note: "网络", source: "good", uuid: "f6856c77-bef5-44f7-ba82-8279036a683f" },
  { text: "人生路上，岔路口。如何走？自己的路。", note: "原创", source: "GoodChing", uuid: "01a897ed-93fc-46f0-a34e-a60ef60ca26e" },
  { text: "雨水泛滥的年华，天晴的概率能有多大？", note: "原创", source: "鱼鱼喵", uuid: "5b1ba320-ae27-4fe6-a8d7-6a2950bcc8b7" },
  { text: "对于真挚的爱意，我将永不争辩。", note: "原创", source: "linkey2011", uuid: "71f6c256-e4cc-4134-a720-4d11d35108a3" },
  { text: "只要你想 你就是在天涯海角 我都会追去 。", note: "网络", source: "网络", uuid: "a3937652-240f-495a-a231-0a9496f24c0d" },
  { text: "妙语连珠是猎物，支支吾吾才是喜欢。", note: "网络", source: "佚名", uuid: "8d1c41f8-6ebd-4c53-91b6-088884256d03" },
  { text: "诸法因缘生，我说是因缘；因缘尽故灭，我作如是说。", note: "哲学", source: "释迦牟尼", uuid: "e7ff9aaa-2456-457e-a3a3-59a35b405441" },
  { text: "最后还是失眠。", note: "网络", source: "吴易纬", uuid: "bdbc27f4-89c7-4d9d-9134-2286170220b3" },
  { text: "我在掩饰我的执着，爱还会不会回来，这是我的独白。", note: "网络", source: "三七", uuid: "b03093fa-a5ca-40ed-ac84-6884b8e75a03" },
  { text: "有你在身边，我想我会一直勇敢。", note: "网络", source: "徐重来", uuid: "2bf5acde-a161-4a1f-80d3-9ae11de9ab54" },
  { text: "顺为凡，逆则仙，只在心中一念间……", note: "网络", source: "耳根", uuid: "2faec969-99be-4b41-ae4b-9d79b4ea44f1" },
  { text: "别让生活蹂躏了你眉间的温柔。", note: "原创", source: "结局", uuid: "e5e4666d-9a5e-4838-954e-2f01b1f34775" },
  { text: "眼睛是心灵的窗户。", note: "哲学", source: "达芬奇", uuid: "72fd3d40-7027-40a8-8c33-cbf4e2ee8002" },
  { text: "山风等等我，带我去山那头。", note: "网络", source: "王健美", uuid: "35ee15bd-642d-4308-8aad-0747d14bd597" },
  { text: "我们生活在大地上，但我们的梦想超越天空。", note: "网络", source: "谷歌翻译", uuid: "887b3751-aa36-4107-a5df-986c405c28a7" },
  { text: "此日漫挥天下泪,有公足壮海军威。", note: "原创", source: "Jvaaaa", uuid: "1edee551-46d9-4869-a70e-db79c9c3925e" },
  { text: "也罢（为什么不记得）。", note: "网络", source: "精卫（万物终归向海）", uuid: "79b23490-2173-4f65-8deb-866261ab7e4c" },
  { text: "想要让每一天重新来过，又不想让仔细回味每一天。", note: "网络", source: "佚名", uuid: "e5480716-3964-4afa-901b-fa6e5bc2daf0" },
  { text: "你在高楼与我天各一方 城归城 山归山 注定两两相望。", note: "网络", source: "自游诗/伊铱", uuid: "3a241f61-9ca7-4a33-b189-3c510d09ecec" },
  { text: "即便是青春的懵懂，但是我们渐行渐远。", note: "网络", source: "三七", uuid: "d5e4a5e6-b73c-4e01-9aba-41ac7f789d2b" },
  { text: "听听林间的鸟鸣，岁月多无忧。", note: "网络", source: "山风山风等等我", uuid: "4c012681-7c21-4455-a376-3c1d83de7fa5" },
  { text: "既然长相忘，谁知来时路。", note: "原创", source: "斫琴赴长顾", uuid: "8bba9c44-a11d-4d62-ba00-6425b61932d4" },
  { text: "不溯往事，不念将来，如此，安好。", note: "原创", source: "Rene", uuid: "390c2989-e8b0-4bed-b0c6-a1913774624c" },
  { text: "选择大于努力。", note: "网络", source: "B站某UP主", uuid: "367c92d6-552e-4901-ae8b-db22b81a5a46" },
  { text: "迎接你不仅有纳木错的泪，还有那拉萨河的水。", note: "网络", source: "二水/自游诗", uuid: "7205bb72-690e-4e7d-89e9-fc62030a0e59" },
  { text: "清晨、黄昏、天空 和飞鸟，代码、诗歌、活着 和爱你。", note: "原创", source: "一个程序员", uuid: "b1a3cf36-513a-4fdd-afaa-52df5f3b2069" },
  { text: "故乡的云。上古的玉。随手的诗。十九岁的你。", note: "网络", source: "可遇不可求的事", uuid: "afdbb84d-bed4-4e9a-8e95-51b6b0fe13d4" },
  { text: "我把这几个字写了又删，删了又写。", note: "原创", source: "叶子", uuid: "87ec3ae8-320a-4999-a248-b31e559a87d5" },
  { text: "没有了希求，不再有祈望。", note: "原创", source: "二兄", uuid: "2add783a-2b5e-46d6-9e88-4ddd7986cb72" },
  { text: "愿万般熙攘化为清风明月，四方梦想变成未来可期。", note: "网络", source: "佚名", uuid: "64b51e7b-b5a8-4596-aa59-830fb4ca963e" },
  { text: "星河浩瀚，万人争渡。", note: "原创", source: "流光印记", uuid: "6dcaffe9-6536-4c86-b5a8-20522d0d9c29" },
  { text: "花草落地生根，它有选择么？", note: "网络", source: "耳根", uuid: "7aa18f23-15c5-4bef-98b5-22cac575625f" },
  { text: "闲云野鹤，烦恼都不留。", note: "网络", source: "山风山风等等我", uuid: "943040f0-25c1-4950-9bc8-8f46c2a88e02" },
  { text: "如果遇到爱的人，请拉紧她的手。", note: "原创", source: "戆戆", uuid: "4e39de68-3538-4fbb-a11e-71a72f81f7c4" },
  { text: "云淡淡天很蓝思绪慢慢走远，春光细细流淌幸福漫过指尖。", note: "网络", source: "花晶晶", uuid: "0f9d92df-b857-4230-8b50-f275e52e65fb" },
  { text: "每一个不曾起舞的日子，都是对生命的辜负。", note: "哲学", source: "尼采", uuid: "9d4a12e4-8faa-45ad-9571-fff1d250b081" },
  { text: "再见到的我们会是怎样，我在老地方看云来云往。", note: "网络", source: "自游诗/伊铱", uuid: "4291aa64-e5fb-4c69-9530-7b38df2fdd82" },
  { text: "眼中若是倾城，便是一生中最爱。", note: "原创", source: "MegaSam", uuid: "9e524ea9-8980-46c7-899a-44850afce8b3" },
  { text: "天子奉上，八敬百人。", note: "原创", source: "朴素", uuid: "7b5f4d39-9c1c-41ca-bc91-118998427e9b" },
  { text: "愿你遍布祖国山河，觉得人生也值得。", note: "网络", source: "晓良", uuid: "56e2f3da-a909-47bb-85a8-09bcb9ec8495" },
  { text: "人类最大的潜力就是痛苦过后依然前行，向着心中的光。", note: "原创", source: "金yin", uuid: "65a75a80-1d58-4d9b-986f-723e1ac0c5ec" },
  { text: "天赋不能带来的东西，努力或许可以。", note: "网络", source: "佚名", uuid: "efa9a32c-4004-4ded-97e6-3b7213cab0af" },
  { text: "智者把放下当前进，愚者把放下当绝望。", note: "网络", source: "网络", uuid: "7c7a2d42-b96d-4c9f-999c-a8b5dfc751bf" },
  { text: "落子无悔，享受当下。", note: "原创", source: "HAKKA", uuid: "9932b129-aca5-4c6f-8fcd-21d619850a13" },
  { text: "俳句怎么写，三行字数五七五，就这么简单。", note: "原创", source: "雄龙ztz", uuid: "33f055c0-2d02-4370-a8a8-9c43366f0d57" },
  { text: "登云之上，方能望远。", note: "原创", source: "小玮", uuid: "4b457ddd-cd63-4952-b622-78e51c779937" },
  { text: "每一个人都应该明确自己的方向和位置。", note: "原创", source: "原创", uuid: "687adf63-2c1c-4bd9-a301-d15362de2083" },
  { text: "我们终究还是走散了。", note: "原创", source: "契约千魂", uuid: "f0834b74-ccb6-46b8-8dbc-4b922d892aa2" },
  { text: "别人看见的只有你的光鲜亮丽，他们永远不知道你失去了什么。", note: "原创", source: "意难藏", uuid: "277b7416-9cfc-489f-b18f-b8987ab7f339" },
  { text: "人生用特写镜头来看是悲剧，长镜头来看则是喜剧。", note: "哲学", source: "卓别林", uuid: "7ee06531-58a7-4e0b-89ad-923c871c2b90" },
  { text: "风吹一阵，雨落几场，草芽丛生，绿野芬芳。", note: "原创", source: "雨落凋殇", uuid: "92278cb0-3263-4c99-9cf7-543d644c58c1" },
  { text: "谁是我们的敌人，谁是我们的朋友，这是革命的首要问题。", note: "哲学", source: "毛泽东", uuid: "8c0fec71-c379-42ef-aff7-8b1806d90620" },
  { text: "诗人需自重，否则罪不可赦。", note: "原创", source: "哑木", uuid: "f1c76640-880d-40c1-8719-141810ba79d9" },
  { text: "山风啊请替我捎句话，让花香带你回家吧。", note: "网络", source: "二水/自游诗", uuid: "3e1ab7a3-7e55-4e2d-8ce1-b518126d175b" },
  { text: "童话只美在真实却从不续写。", note: "网络", source: "世界沉睡童话", uuid: "cbc82a97-d4ce-41af-af57-0f8a99acf5a6" },
  { text: "别丧了，说不定你也是别人心中偷偷藏起来的光。", note: "网络", source: "一个可爱的人吧", uuid: "701002a7-03bc-4b0b-ac62-4de37a3286de" },
  { text: "我承认我确实搞不定你，所以我要去搞定山河啦。", note: "原创", source: "茶褐", uuid: "cee10234-306c-4df6-a785-2c3a4adcb3fb" },
  { text: "人类侥幸拥有了智慧，就应该善用它。", note: "哲学", source: "王小波", uuid: "64559b13-fe87-44fd-a745-d48fb6c6895a" }
]

function pad(value) {
  return value < 10 ? '0' + value : String(value)
}

const WEEKDAYS = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六']
const ZODIACS = [
  { name: '白羊座', range: '03.21—04.19' },
  { name: '金牛座', range: '04.20—05.20' },
  { name: '双子座', range: '05.21—06.21' },
  { name: '巨蟹座', range: '06.22—07.22' },
  { name: '狮子座', range: '07.23—08.22' },
  { name: '处女座', range: '08.23—09.22' },
  { name: '天秤座', range: '09.23—10.23' },
  { name: '天蝎座', range: '10.24—11.22' },
  { name: '射手座', range: '11.23—12.21' },
  { name: '摩羯座', range: '12.22—01.19' },
  { name: '水瓶座', range: '01.20—02.18' },
  { name: '双鱼座', range: '02.19—03.20' }
]
const MOON_PHASES = ['新月', '眉月', '上弦月', '盈凸月', '满月', '亏凸月', '下弦月', '残月']
const ASTRO_ACTIONS = ['整理计划', '坦诚沟通', '完成小事', '适度休息', '专注学习', '清理杂念', '主动表达', '耐心观察', '重新取舍', '回顾总结', '尝试新路', '守住节奏']
const ASTRO_COLORS = ['朱砂红', '松石绿', '雾霾蓝', '月光白', '琥珀黄', '岩石灰']
const FORTUNES = [
  { level: '上上签', tip: '宜把握机会，心愿可期' },
  { level: '上签', tip: '宜稳步向前，静候佳音' },
  { level: '中签', tip: '宜守住节奏，顺其自然' },
  { level: '下签', tip: '宜慢行少决，留有余地' },
  { level: '下下签', tip: '宜休整避急，明日再行' }
]

function dayInfo(now) {
  const year = now.getFullYear()
  const month = now.getMonth() + 1
  const date = now.getDate()
  const firstDay = Math.floor(Date.UTC(year, 0, 1) / 86400000)
  const dayNumber = Math.floor(Date.UTC(year, month - 1, date) / 86400000)
  return {
    year,
    month,
    date,
    weekday: now.getDay(),
    dayOfYear: dayNumber - firstDay + 1,
    dayNumber,
    label: pad(month) + '月' + pad(date) + '日',
    key: year + '-' + pad(month) + '-' + pad(date)
  }
}

function quoteIndex(dayNumber) {
  const value = (dayNumber * 17 + 11) % QUOTES.length
  return value < 0 ? value + QUOTES.length : value
}

function zodiacForDate(month, date) {
  const value = month * 100 + date
  if (value >= 321 && value <= 419) return 0
  if (value >= 420 && value <= 520) return 1
  if (value >= 521 && value <= 621) return 2
  if (value >= 622 && value <= 722) return 3
  if (value >= 723 && value <= 822) return 4
  if (value >= 823 && value <= 922) return 5
  if (value >= 923 && value <= 1023) return 6
  if (value >= 1024 && value <= 1122) return 7
  if (value >= 1123 && value <= 1221) return 8
  if (value >= 120 && value <= 218) return 10
  if (value >= 219 && value <= 320) return 11
  return 9
}

function moonPhase(dayNumber) {
  const knownNewMoon = 10962.76
  const cycle = 29.53058867
  const age = ((dayNumber - knownNewMoon) % cycle + cycle) % cycle
  return MOON_PHASES[Math.floor((age + cycle / 16) / (cycle / 8)) % 8]
}

function fortuneForDay(dayNumber) {
  const value = ((dayNumber * 29 + 17) % 100 + 100) % 100
  if (value < 12) return FORTUNES[0]
  if (value < 37) return FORTUNES[1]
  if (value < 70) return FORTUNES[2]
  if (value < 91) return FORTUNES[3]
  return FORTUNES[4]
}

function mulberry32(seed) {
  let a = seed >>> 0
  return function () {
    a = (a + 0x6d2b79f5) | 0
    let t = Math.imul(a ^ (a >>> 15), 1 | a)
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
  }
}

function dailyRiddles(dayNumber) {
  const rand = mulberry32((dayNumber * 2654435761) >>> 0)
  function shuffle(items) {
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(rand() * (i + 1))
      const temp = items[i]; items[i] = items[j]; items[j] = temp
    }
    return items
  }
  const plan = [
    { category: '脑筋急转弯', count: 7 },
    { category: '十万个为什么', count: 6 },
    { category: '百科知识', count: 7 }
  ]
  const daily = []
  for (let i = 0; i < plan.length; i++) {
    const group = RIDDLES.filter(function (item) { return item.category === plan[i].category })
    const picked = shuffle(group).slice(0, plan[i].count)
    for (let j = 0; j < picked.length; j++) daily.push(picked[j])
  }
  return shuffle(daily)
}

function isCompleteReward(viewedCount, total, awardedDay, todayDay) {
  return viewedCount >= total && awardedDay !== todayDay
}

function shouldResetQuizProgress(savedDay, todayDay) {
  return savedDay !== todayDay
}

const today = dayInfo(new Date())
const todayIndex = quoteIndex(today.dayNumber)
const todayFortune = fortuneForDay(today.dayNumber)
const dailyRiddleList = dailyRiddles(today.dayNumber)
let currentIndex = todayIndex
let state = {
  lastDay: -1,
  streak: 0,
  stars: 0,
  awardedDay: -1,
  favorites: [],
  zodiacIndex: zodiacForDate(today.month, today.date),
  quizSchema: 170,
  quizDay: -1,
  quizIndex: 0,
  quizViewed: []
}

export default {
  private: {
    stateReady: false,
    calendarVisible: false,
    calendarYear: today.year,
    calendarMonth: today.month,
    calendarTitle: '', calendarInfo: '',
    calCell0: '', calToday0: false,
    calCell1: '', calToday1: false,
    calCell2: '', calToday2: false,
    calCell3: '', calToday3: false,
    calCell4: '', calToday4: false,
    calCell5: '', calToday5: false,
    calCell6: '', calToday6: false,
    calCell7: '', calToday7: false,
    calCell8: '', calToday8: false,
    calCell9: '', calToday9: false,
    calCell10: '', calToday10: false,
    calCell11: '', calToday11: false,
    calCell12: '', calToday12: false,
    calCell13: '', calToday13: false,
    calCell14: '', calToday14: false,
    calCell15: '', calToday15: false,
    calCell16: '', calToday16: false,
    calCell17: '', calToday17: false,
    calCell18: '', calToday18: false,
    calCell19: '', calToday19: false,
    calCell20: '', calToday20: false,
    calCell21: '', calToday21: false,
    calCell22: '', calToday22: false,
    calCell23: '', calToday23: false,
    calCell24: '', calToday24: false,
    calCell25: '', calToday25: false,
    calCell26: '', calToday26: false,
    calCell27: '', calToday27: false,
    calCell28: '', calToday28: false,
    calCell29: '', calToday29: false,
    calCell30: '', calToday30: false,
    calCell31: '', calToday31: false,
    calCell32: '', calToday32: false,
    calCell33: '', calToday33: false,
    calCell34: '', calToday34: false,
    calCell35: '', calToday35: false,
    calCell36: '', calToday36: false,
    calCell37: '', calToday37: false,
    calCell38: '', calToday38: false,
    calCell39: '', calToday39: false,
    calCell40: '', calToday40: false,
    calCell41: '', calToday41: false,

    streakText: '0',
    starsText: '0',
    dateText: today.label,
    monthYearText: today.year + '年 ' + pad(today.month) + '月',
    monthShortText: pad(today.month) + '月',
    dayText: pad(today.date),
    weekdayText: WEEKDAYS[today.weekday],
    yearDayText: '今年第 ' + today.dayOfYear + ' 天',
    coverVisible: true,
    quoteVisible: false,
    quizVisible: false,
    zodiacVisible: false,
    quoteText: QUOTES[todayIndex].text,
    quoteSource: '今日一言',
    quoteNote: QUOTES[todayIndex].note,
    fortuneLevel: todayFortune.level,
    fortuneTip: todayFortune.tip,
    zodiacName: ZODIACS[state.zodiacIndex].name,
    zodiacRange: ZODIACS[state.zodiacIndex].range,
    moonText: '月相 · ' + moonPhase(today.dayNumber),
    astroTip: '',
    favoriteText: '收藏',
    riddleQuestion: '',
    quizCategory: '',
    quizPos: 0,
    quizTotal: 0,
    riddleAnswer: '',
    riddleExplain: '',
    riddleKnowledge: '',
    detailIndex: 0,
    detailTotal: 1,
    detailLabel: '',
    answerVisible: false,
    prevDisabled: true,
    nextDisabled: true,
    prevLabel: '上一题',
    nextLabel: '下一题',
    rewardText: ''
  },

  onInit() {
    this.loadState()
    this.applyQuote(todayIndex, true)
    this.refreshAstro()
  },

  onShow() {
    this.setScreenAwake(true)
  },

  onHide() {
    this.setScreenAwake(false)
  },

  onDestroy() {
    this.setScreenAwake(false)
  },

  setScreenAwake(enabled) {
    try {
      brightness.setKeepScreenOn({
        keepScreenOn: enabled,
        success() { console.log('keepScreenOn=' + enabled) },
        fail(data, code) { console.log('keepScreenOn failed: ' + code) }
      })
    } catch (error) {
      console.log('keepScreenOn unavailable: ' + error)
    }
  },

  loadState() {
    const page = this
    const finishLoad = function () {
      page.stateReady = true
      page.refreshStats()
      page.refreshFavorite()
      page.refreshAstro()
    }
    try {
      storage.get({
        key: STORAGE_KEY,
        default: '',
        success(data) {
          if (data) try {
            const saved = JSON.parse(data)
            state.lastDay = Number(saved.lastDay) || -1
            state.streak = Number(saved.streak) || 0
            state.stars = Number(saved.stars) || 0
            state.awardedDay = Number(saved.awardedDay) || -1
            state.favorites = saved.favorites || []
            state.quizDay = Number(saved.quizDay)
            if (!Number.isFinite(state.quizDay)) state.quizDay = -1
            state.quizIndex = Number(saved.quizIndex) || 0
            state.quizViewed = Array.isArray(saved.quizViewed) ? saved.quizViewed : []
            if (saved.quizSchema !== 170 || shouldResetQuizProgress(state.quizDay, today.dayNumber)) {
              state.quizIndex = 0
              state.quizViewed = []
            }
            const savedZodiac = Number(saved.zodiacIndex)
            if (savedZodiac >= 0 && savedZodiac < ZODIACS.length) state.zodiacIndex = savedZodiac
          } catch (error) {
            console.log('每日一言存档解析失败: ' + error)
          }
          finishLoad()
        },
        fail(data, code) {
          console.log('每日一言存档读取失败: ' + code)
          finishLoad()
        }
      })
    } catch (error) {
      console.log('存储模块不可用: ' + error)
      finishLoad()
    }
  },

  saveState() {
    if (!this.stateReady) return
    try {
      storage.set({
        key: STORAGE_KEY,
        value: JSON.stringify(state),
        fail(data, code) { console.log('每日一言存档保存失败: ' + code) }
      })
    } catch (error) {
      console.log('存储模块不可用: ' + error)
    }
  },

  refreshStats() {
    this.streakText = String(state.streak)
    this.starsText = String(state.stars)
  },

  refreshAstro() {
    const zodiac = ZODIACS[state.zodiacIndex]
    const action = ASTRO_ACTIONS[(today.dayNumber + state.zodiacIndex * 7) % ASTRO_ACTIONS.length]
    const color = ASTRO_COLORS[(today.dayNumber * 3 + state.zodiacIndex) % ASTRO_COLORS.length]
    this.zodiacName = zodiac.name
    this.zodiacRange = zodiac.range
    this.astroTip = '宜 ' + action + ' · ' + color
  },

  previousZodiac() {
    state.zodiacIndex = (state.zodiacIndex + ZODIACS.length - 1) % ZODIACS.length
    this.refreshAstro()
    this.saveState()
    this.pulse('short')
  },

  nextZodiac() {
    state.zodiacIndex = (state.zodiacIndex + 1) % ZODIACS.length
    this.refreshAstro()
    this.saveState()
    this.pulse('short')
  },

  revealToday() {
    if (!this.stateReady) return
    this.recordToday()
    this.applyQuote(todayIndex, true)
    this.coverVisible = false
    this.quoteVisible = true
    this.pulse('short')
  },

  recordToday() {
    if (state.lastDay === today.dayNumber) return
    state.streak = state.lastDay === today.dayNumber - 1 ? state.streak + 1 : 1
    state.lastDay = today.dayNumber
    this.refreshStats()
    this.saveState()
  },

  applyQuote(index, isToday) {
    currentIndex = index
    const quote = QUOTES[index]
    this.quoteText = quote.text
    this.quoteNote = quote.note
    this.quoteSource = quote.source || (isToday ? '今日一言' : '随手一签')
    this.refreshFavorite()
  },

  drawAnother() {
    let next = (currentIndex + 7) % QUOTES.length
    if (next === todayIndex) next = (next + 1) % QUOTES.length
    this.applyQuote(next, false)
    this.pulse('short')
  },

  openCalendar() { this.calendarVisible = true; this.renderCalendar() },
  closeCalendar() { this.calendarVisible = false },
  openZodiac() { this.zodiacVisible = true },
  closeZodiac() { this.zodiacVisible = false },
  previousMonth() {
    this.calendarMonth -= 1
    if (this.calendarMonth < 1) { this.calendarMonth = 12; this.calendarYear -= 1 }
    this.renderCalendar()
  },
  nextMonth() {
    this.calendarMonth += 1
    if (this.calendarMonth > 12) { this.calendarMonth = 1; this.calendarYear += 1 }
    this.renderCalendar()
  },
  currentMonth() { this.calendarYear = today.year; this.calendarMonth = today.month; this.renderCalendar() },
  renderCalendar() {
    const y = this.calendarYear; const m = this.calendarMonth
    const first = new Date(y, m - 1, 1).getDay()
    const days = new Date(y, m, 0).getDate()
    this.calendarTitle = y + '年 ' + m + '月'
    this.calendarInfo = '本月 ' + days + ' 天 · 今日 ' + today.label
    for (let i = 0; i < 42; i++) {
      const d = i - first + 1
      this['calCell' + i] = d > 0 && d <= days ? String(d) : ''
      this['calToday' + i] = y === today.year && m === today.month && d === today.date
    }
  },

  startQuiz() {
    this.recordToday()
    if (state.quizDay !== today.dayNumber) {
      state.quizDay = today.dayNumber
      state.quizIndex = 0
      state.quizViewed = []
    }
    this.quizVisible = true
    this.renderQuiz()
    this.pulse('short')
  },

  renderQuiz() {
    const list = dailyRiddleList
    const idx = state.quizIndex
    const len = list.length
    const riddle = list[idx]
    this.quizPos = idx + 1
    this.quizTotal = len
    this.quizCategory = riddle.category
    this.riddleQuestion = riddle.question
    this.answerVisible = state.quizViewed.indexOf(idx) >= 0
    if (this.answerVisible) {
      this.riddleAnswer = riddle.answer
      this.riddleExplain = riddle.explain
      this.riddleKnowledge = riddle.knowledge || ''
    } else {
      this.riddleAnswer = ''
      this.riddleExplain = ''
      this.riddleKnowledge = ''
    }
    this.detailIndex = 0
    if (this.answerVisible) this.renderDetail()
    this.prevDisabled = idx <= 0
    this.nextDisabled = idx >= len - 1
    this.prevLabel = idx <= 0 ? '已是第一题' : '上一题'
    this.nextLabel = idx >= len - 1 ? '已是最后一题' : '下一题'
    this.rewardText = ''
  },

  revealAnswer() {
    if (this.answerVisible) return
    const idx = state.quizIndex
    const riddle = dailyRiddleList[idx]
    this.riddleAnswer = riddle.answer
    this.riddleExplain = riddle.explain
    this.riddleKnowledge = riddle.knowledge || ''
    this.answerVisible = true
    this.detailIndex = 0
    this.renderDetail()
    if (state.quizViewed.indexOf(idx) < 0) state.quizViewed.push(idx)
    this.pulse('short')
    const total = dailyRiddleList.length
    if (state.quizViewed.length >= total && isCompleteReward(state.quizViewed.length, total, state.awardedDay, today.dayNumber)) {
      state.stars += 1
      state.awardedDay = today.dayNumber
      this.refreshStats()
      this.rewardText = '今日 20 题已读完，获得 1 点灵光 ✦'
      this.pulse('long')
    }
    this.saveState()
  },

  renderDetail() {
    const r = dailyRiddleList[state.quizIndex]
    const text = r.explain + ' 来源：' + r.source
    const chunks = []
    const chars = Array.from(text)
    for (let i = 0; i < chars.length; i += 32) chunks.push(chars.slice(i, i + 32).join(''))
    this.detailTotal = chunks.length || 1
    this.riddleExplain = chunks[this.detailIndex] || ''
    this.detailLabel = '详解 ' + (this.detailIndex + 1) + '/' + this.detailTotal + ' · 翻页'
  },

  nextDetail() {
    this.detailIndex = (this.detailIndex + 1) % this.detailTotal
    this.renderDetail()
  },

  prevQuestion() {
    if (state.quizIndex <= 0) return
    state.quizIndex -= 1
    this.renderQuiz()
    this.saveState()
    this.pulse('short')
  },

  nextQuestion() {
    if (state.quizIndex >= dailyRiddleList.length - 1) return
    state.quizIndex += 1
    this.renderQuiz()
    this.saveState()
    this.pulse('short')
  },

  closeQuiz() {
    this.quizVisible = false
    this.saveState()
  },

  toggleFavorite() {
    const position = state.favorites.indexOf(currentIndex)
    if (position >= 0) {
      state.favorites.splice(position, 1)
    } else {
      state.favorites.push(currentIndex)
    }
    this.refreshFavorite()
    this.saveState()
    this.pulse('short')
  },

  refreshFavorite() {
    this.favoriteText = state.favorites.indexOf(currentIndex) >= 0 ? '已收藏' : '收藏'
  },

  handleSwipe(event) {
    if (event && event.direction === 'right') this.exitGame()
  },

  exitGame() {
    this.setScreenAwake(false)
    if (this.stateReady) this.saveState()
    try { this.$app.exit() } catch (error) { console.log('全局退出不可用: ' + error) }
    try { app.terminate() } catch (error) { console.log('系统退出不可用: ' + error) }
  },

  pulse(mode) {
    try { vibrator.vibrate({ mode: mode }) } catch (error) { console.log('振动不可用: ' + error) }
  }
}
</script>

<style>
.page { position: relative; width: 336px; height: 480px; background-color: #f2eee5; overflow: hidden; }
.brand { position: absolute; left: 16px; top: 9px; width: 200px; color: #27231f; font-size: 26px; font-weight: bold; letter-spacing: 2px; }
.exit-button { position: absolute; left: 271px; top: 10px; width: 52px; height: 30px; border-width: 1px; border-color: #cfc5b7; border-radius: 4px; background-color: #faf7f0; color: #756b60; font-size: 14px; z-index: 10; }

.stat-row { position: absolute; left: 15px; top: 48px; width: 306px; height: 19px; border-bottom-width: 1px; border-color: #d6cec1; }
