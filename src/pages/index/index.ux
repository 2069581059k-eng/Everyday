  { question: "为什么一架纸飞机，造价一亿台币？", category: "脑筋急转弯", answer: "那是用一张一亿台币的纸票折的", explain: "那是用一张一亿台币的纸票折的", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "有一天，小英看到小明随即惊叫，小明见状，也跟着惊叫，为什么？", category: "脑筋急转弯", answer: "他们正在玩游戏", explain: "因为他们正在玩游戏", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "为什么人们要到市场上去？", category: "脑筋急转弯", answer: "市场不能来", explain: "因为市场不能来", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "小张一直朝北走,走着走着他又没有转身可是却走到了正南方,为什么", category: "脑筋急转弯", answer: "他越过北极点在向前走就是南方", explain: "他越过北极点在向前走就是南方", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
