<template>
  <div class="page" onswipe="handleSwipe">
    <div class="header">
      <text class="brand">Daily Spark</text>
      <text class="brand-sub">DAILY NOTE · 日常一页</text>
      <text class="date-text">{{dateText}}</text>
      <text class="date-sub">{{weekdayText}} · 连续 {{streakText}} 天</text>
    </div>
    <div class="header-line"></div>

    <div class="quote-card" show="{{quoteVisible}}">
      <div class="quote-accent"></div>
      <text class="quote-kicker">{{quoteKicker}}</text>
      <image class="heart-img" show="{{!heartFilled}}" src="/common/assets/ic-heart-off.png" onclick="toggleFavorite" />
      <image class="heart-img" show="{{heartFilled}}" src="/common/assets/ic-heart-on.png" onclick="toggleFavorite" />
      <text class="quote-text">{{quoteText}}</text>
      <text class="quote-source">— {{quoteSource}}</text>
      <text class="fortune-stamp" show="{{fortuneDrawn}}">{{fortuneLevel}}</text>
      <text class="fortune-tip" show="{{fortuneDrawn}}">{{fortuneTip}}</text>
    </div>

    <div class="quote-actions" show="{{quoteVisible}}">
      <input class="action-button action-primary" type="button" value="换一句" onclick="changeQuote" />
      <input class="action-button action-secondary" type="button" value="抽签" onclick="drawFortune" />
    </div>

    <div class="feature-grid">
      <div class="feature-card" onclick="openCalendarPage">
        <image class="feature-icon" src="/common/assets/ic-nav-calendar.png" />
        <text class="feature-title">今日日历</text>
        <text class="feature-main">{{monthShortText}}{{dayText}}日</text>
        <text class="feature-sub">月历 · 进入 ›</text>
      </div>

      <div class="feature-card feature-card-r" onclick="openZodiac">
        <image class="feature-icon" src="/common/assets/ic-nav-zodiac.png" />
        <text class="feature-title">趣味星象</text>
        <text class="feature-main">{{zodiacName}}</text>
        <text class="feature-sub">月相 · 详情 ›</text>
      </div>

      <div class="feature-card feature-card-b" onclick="openKnowledgePage">
        <image class="feature-icon" src="/common/assets/ic-nav-knowledge.png" />
        <text class="feature-title">知识大全</text>
        <text class="feature-main">今日 50 题</text>
        <text class="feature-sub">五类 · 进入 ›</text>
      </div>

      <div class="feature-card feature-card-r feature-card-b" onclick="openFavoritesPage">
        <image class="feature-icon" src="/common/assets/ic-nav-favorites.png" />
        <text class="feature-title">收藏室</text>
        <text class="feature-main">{{favNumText}} 条</text>
        <text class="feature-sub">已收藏 · 进入 ›</text>
      </div>
    </div>

    <div class="zodiac-mask" show="{{zodiacVisible}}">
      <div class="zodiac-back-hit" onclick="closeZodiac"><text class="zodiac-back">‹</text></div>
      <text class="zodiac-title">趣味星象</text>
      <input class="zodiac-prev" type="button" value="‹" onclick="previousZodiac" />
      <input class="zodiac-next" type="button" value="›" onclick="nextZodiac" />
      <!-- 1.8.19：插图位直接显示当前星座对应素材（切换星座联动刷新） -->
      <image class="zodiac-ill" src="{{zodiacIll}}" />
      <text class="zodiac-name-big">{{zodiacName}}</text>
      <text class="zodiac-range-big">{{zodiacRange}}</text>
      <text class="zodiac-moon">{{moonText}}</text>
      <text class="zodiac-tip">{{astroTip}}</text>
      <input class="zodiac-analyze" type="button" value="星象分析 ›" onclick="startZodiacTest" />
      <input class="zodiac-close" type="button" value="返回主页" onclick="closeZodiac" />
    </div>

    <div class="exit-hint" show="{{exitHintVisible}}">
      <image class="exit-hint-icon" src="/common/assets/ic-t-info.png" />
      <text class="exit-hint-text">再次右滑退出应用</text>
    </div>
  </div>
</template>

<script>
import app from '@system.app'
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'
import router from '@system.router'

import { QUOTES } from '../../common/data/quotes.js'
import { pad, dayInfo } from '../../common/utils/date.js'
import { WEEKDAYS, moonPhase } from '../../common/utils/moon.js'
import { ZODIACS, zodiacForDate, zodiacImg } from '../../common/utils/zodiac.js'
import { ASTRO_ACTIONS, ASTRO_COLORS, FORTUNES } from '../../common/data/fortune_templates.js'
import { FAVORITES_KEY, makeQuoteFavorite, toggleFavorite, hasFavorite, migrateOldFavorites } from '../../common/utils/favorites.js'

const STORAGE_KEY = 'daily_quote_state_v1'

function quoteIndex(dayNumber) {
  const value = (dayNumber * 17 + 11) % QUOTES.length
  return value < 0 ? value + QUOTES.length : value
}

const today = dayInfo(new Date())
const todayIndex = quoteIndex(today.dayNumber)
let currentIndex = todayIndex
let state = {
  lastDay: -1,
  streak: 0,
  zodiacIndex: zodiacForDate(today.month, today.date),
  // 1.8.15：当日签运持久化（跨重启保留）与最近签运历史（最多 16 条，同日覆盖）
  fortune: null,
  fortuneHistory: []
}
let favoritesItems = []
let legacyMigrated = false
// 右滑退出二次确认提示的自动消失计时器（模块级，避免污染 private 渲染数据）
let exitHintTimer = null

export default {
  private: {
    stateReady: false,

    streakText: '0',
    dateText: today.label,
    monthShortText: pad(today.month) + '月',
    dayText: pad(today.date),
    weekdayText: WEEKDAYS[today.weekday],
    quoteVisible: true,
    zodiacVisible: false,
    fortuneDrawn: false,
    quoteKicker: 'Daily Spark',
    quoteText: '',
    quoteSource: '',
    fortuneLevel: '',
    fortuneTip: '',
    heartFilled: false,
    favNumText: '0',
    moonShortText: '',
    zodiacName: ZODIACS[state.zodiacIndex].name,
    zodiacRange: ZODIACS[state.zodiacIndex].range,
    zodiacIll: zodiacImg(ZODIACS[state.zodiacIndex].name),
    moonText: '月相 · ' + moonPhase(today.dayNumber),
    astroTip: '',
    exitHintVisible: false,
  },

  onInit() {
    this.moonShortText = '月相 · ' + moonPhase(today.dayNumber)
    this.loadState()
    this.refreshAstro()
  },

  onShow() {
    this.setScreenAwake(true)
  },

  onHide() {
    this.setScreenAwake(false)
  },

  onDestroy() {
    this.setScreenAwake(false)
  },

  setScreenAwake(enabled) {
    try {
      brightness.setKeepScreenOn({
        keepScreenOn: enabled,
        success() { console.log('keepScreenOn=' + enabled) },
        fail(data, code) { console.log('keepScreenOn failed: ' + code) }
      })
    } catch (error) {
      console.log('keepScreenOn unavailable: ' + error)
    }
  },

  loadState() {
    const page = this
    legacyMigrated = false
    const finishLoad = function () {
      page.stateReady = true
      page.refreshStats()
      page.recordToday()
      page.applyQuote(currentIndex)
      page.refreshAstro()
      if (legacyMigrated) {
        // 旧版收藏迁移完成后回写 v1 存档（state 不含 favorites 数组，覆盖即清除），
        // 否则用户在收藏室删除旧条目后，下次进入首页会再次迁移导致"删不掉的收藏"
        page.saveState()
      }
    }
    // 先读收藏室存档，再读签到/星座存档（含旧版收藏迁移），全部完成后放行交互
    try {
      storage.get({
        key: FAVORITES_KEY,
        default: '',
        success(favData) {
          if (favData) try {
            const savedFav = JSON.parse(favData)
            if (savedFav && Array.isArray(savedFav.items)) favoritesItems = savedFav.items
          } catch (error) {
            console.log('收藏室存档解析失败: ' + error)
          }
          page.loadDailyState(finishLoad)
        },
        fail() { page.loadDailyState(finishLoad) }
      })
    } catch (error) {
      console.log('存储模块不可用: ' + error)
      this.loadDailyState(finishLoad)
    }
  },

  loadDailyState(finishLoad) {
    const page = this
    try {
      storage.get({
        key: STORAGE_KEY,
        default: '',
        success(data) {
          if (data) try {
            const saved = JSON.parse(data)
            state.lastDay = Number(saved.lastDay) || -1
            state.streak = Number(saved.streak) || 0
            const savedZodiac = Number(saved.zodiacIndex)
            if (savedZodiac >= 0 && savedZodiac < ZODIACS.length) state.zodiacIndex = savedZodiac
            // 恢复签运持久化数据（当日签 + 历史）
            if (saved.fortune && saved.fortune.day === today.dayNumber) {
              state.fortune = saved.fortune
              page.fortuneDrawn = true
              page.fortuneLevel = saved.fortune.level
              page.fortuneTip = saved.fortune.tip
            }
            if (Array.isArray(saved.fortuneHistory)) state.fortuneHistory = saved.fortuneHistory
            // 旧版语录收藏（下标数组）迁移为收藏室 v2 快照条目
            if (Array.isArray(saved.favorites) && saved.favorites.length) {
              const migrated = migrateOldFavorites(saved.favorites, QUOTES)
              for (let i = 0; i < migrated.length; i++) {
                if (!hasFavorite(favoritesItems, migrated[i].id)) favoritesItems.push(migrated[i])
              }
              page.saveFavorites()
              legacyMigrated = true
            }
          } catch (error) {
            console.log('DAILY NOTE存档解析失败: ' + error)
          }
          finishLoad()
        },
        fail(data, code) {
          console.log('DAILY NOTE存档读取失败: ' + code)
          finishLoad()
        }
      })
    } catch (error) {
      console.log('存储模块不可用: ' + error)
      finishLoad()
    }
  },

  saveState() {
    if (!this.stateReady) return
    try {
      storage.set({
        key: STORAGE_KEY,
        value: JSON.stringify(state),
        fail(data, code) { console.log('DAILY NOTE存档保存失败: ' + code) }
      })
    } catch (error) {
      console.log('存储模块不可用: ' + error)
    }
  },

  saveFavorites() {
    try {
      storage.set({
        key: FAVORITES_KEY,
        value: JSON.stringify({ items: favoritesItems }),
        fail(data, code) { console.log('收藏室存档保存失败: ' + code) }
      })
    } catch (error) {
      console.log('存储模块不可用: ' + error)
    }
  },

  refreshStats() {
    this.streakText = String(state.streak)
    this.favNumText = String(favoritesItems.length)
  },

  refreshAstro() {
    const zodiac = ZODIACS[state.zodiacIndex]
    const action = ASTRO_ACTIONS[(today.dayNumber + state.zodiacIndex * 7) % ASTRO_ACTIONS.length]
    const color = ASTRO_COLORS[(today.dayNumber * 3 + state.zodiacIndex) % ASTRO_COLORS.length]
    this.zodiacName = zodiac.name
    this.zodiacRange = zodiac.range
    this.zodiacIll = zodiacImg(zodiac.name)
    this.astroTip = '宜 ' + action + ' · ' + color
  },

  previousZodiac() {
    state.zodiacIndex = (state.zodiacIndex + ZODIACS.length - 1) % ZODIACS.length
    this.refreshAstro()
    this.saveState()
    this.pulse('short')
  },

  nextZodiac() {
    state.zodiacIndex = (state.zodiacIndex + 1) % ZODIACS.length
    this.refreshAstro()
    this.saveState()
    this.pulse('short')
  },

  startZodiacTest() {
    router.replace({ uri: 'pages/zodiac-test' })
  },

  openKnowledgePage() {
    router.replace({ uri: 'pages/knowledge' })
  },

  openCalendarPage() {
    router.replace({ uri: 'pages/calendar' })
  },

  openFavoritesPage() {
    router.replace({ uri: 'pages/favorites' })
  },

  // 换一句：仅切换DAILY NOTE；今日签运独立持久化，不再随换句清空（1.8.15）
  changeQuote() {
    if (!this.stateReady) return
    let next = (currentIndex + 1 + Math.floor(Math.random() * (QUOTES.length - 1))) % QUOTES.length
    if (next === currentIndex) next = (next + 1) % QUOTES.length
    this.applyQuote(next)
    this.pulse('short')
  },

  // 抽签：为今日抽取签级与提示（可反复重抽，同日历史仅保留最新一条）
  drawFortune() {
    if (!this.stateReady) return
    this.recordToday()
    const fortune = FORTUNES[Math.floor(Math.random() * FORTUNES.length)]
    this.fortuneLevel = fortune.level
    this.fortuneTip = fortune.tip
    this.fortuneDrawn = true
    // 持久化：当日签 + 历史记录（同日覆盖最新，最多 16 条）
    state.fortune = { day: today.dayNumber, level: fortune.level, tip: fortune.tip }
    state.fortuneHistory = state.fortuneHistory.filter(function (item) { return item.day !== today.dayNumber })
    state.fortuneHistory.unshift({ day: today.dayNumber, level: fortune.level, tip: fortune.tip })
    if (state.fortuneHistory.length > 16) state.fortuneHistory.length = 16
    this.saveState()
    this.pulse('short')
  },

  recordToday() {
    if (state.lastDay === today.dayNumber) return
    state.streak = state.lastDay === today.dayNumber - 1 ? state.streak + 1 : 1
    state.lastDay = today.dayNumber
    this.refreshStats()
    this.saveState()
  },

  applyQuote(index) {
    currentIndex = index
    const quote = QUOTES[index]
    this.quoteText = quote.text
    this.quoteKicker = quote.note ? 'Daily Spark · ' + quote.note : 'Daily Spark'
    this.quoteSource = quote.source || 'Daily Spark'
    this.refreshFavorite()
  },

  openZodiac() { this.zodiacVisible = true },
  closeZodiac() { this.zodiacVisible = false },

  // 爱心收藏：纯语录快照（1.8.15 签运持久化后与签运解耦，恒为「DAILY NOTE」类型；
  // 旧版「抽签」类型条目收藏室仍兼容展示）
  toggleFavorite() {
    if (!this.stateReady) return
    const item = makeQuoteFavorite(currentIndex, QUOTES[currentIndex], '', '')
    toggleFavorite(favoritesItems, item)
    this.saveFavorites()
    this.refreshFavorite()
    this.refreshStats()
    this.pulse('short')
  },

  refreshFavorite() {
    this.heartFilled = hasFavorite(favoritesItems, 'q' + currentIndex)
  },

  // 1.8.17 右滑交互：遮罩打开时右滑=关闭遮罩（返回上一级）；
  // 首页右滑第一次弹出"再次右滑退出"提示，提示期内再次右滑才真正退出（防误触）
  handleSwipe(event) {
    if (!event || event.direction !== 'right') return
    if (this.zodiacVisible) { this.zodiacVisible = false; return }
    if (this.exitHintVisible) {
      this.exitHintVisible = false
      if (exitHintTimer) {
        try { clearTimeout(exitHintTimer) } catch (error) {}
        exitHintTimer = null
      }
      this.exitGame()
      return
    }
    this.exitHintVisible = true
    const page = this
    try {
      exitHintTimer = setTimeout(function () {
        page.exitHintVisible = false
        exitHintTimer = null
      }, 3000)
    } catch (error) {
      // 计时器不可用时提示常驻：不影响二次右滑退出，仅不会自动消失
      console.log('退出提示计时器不可用: ' + error)
    }
  },

  dismissExitHint() {
    this.exitHintVisible = false
    if (exitHintTimer) {
      try { clearTimeout(exitHintTimer) } catch (error) {}
      exitHintTimer = null
    }
  },

  exitGame() {
    // 1.8.17：在手势回调内同步 $app.exit() 会撕裂 Vela 应用表面（退出后重启左侧出现
    // 持续黑条，模拟器实测复现/修复），故延迟到手势与渲染周期结束后再退出；
    // keepScreenOn 不在此处释放，统一交给 onHide/onDestroy
    if (this.stateReady) this.saveState()
    const page = this
    try {
      setTimeout(function () {
        try { page.$app.exit() } catch (error) { try { app.terminate() } catch (error2) {} }
      }, 150)
    } catch (error) {
      try { app.terminate() } catch (error2) {}
    }
  },

  pulse(mode) {
    try { vibrator.vibrate({ mode: mode }) } catch (error) { console.log('振动不可用: ' + error) }
  }
}
</script>

<style>
/* 1.8.18 设计令牌：bg #f2eee5 / card #fffdf8 / 主文字 #2b2723 / 次要 #7b7268 / 提示 #9a9186 / 品牌红 #a83b2d / 分割线 #ece3d6 */
.page { position: relative; width: 336px; height: 480px; background-color: #f2eee5; overflow: hidden; }

/* 顶部品牌区（56px） */
.header { position: absolute; left: 16px; top: 12px; width: 304px; height: 40px; }
.brand { position: absolute; left: 0; top: 0; width: 190px; height: 22px; line-height: 22px; color: #2b2723; font-size: 18px; font-weight: bold; letter-spacing: 2px; }
.brand-sub { position: absolute; left: 0; top: 24px; width: 190px; height: 14px; line-height: 14px; color: #9a9186; font-size: 11px; letter-spacing: 1px; }
.date-text { position: absolute; left: 204px; top: 0; width: 100px; height: 20px; line-height: 20px; color: #2b2723; font-size: 16px; font-weight: bold; text-align: right; }
.date-sub { position: absolute; left: 184px; top: 23px; width: 120px; height: 14px; line-height: 14px; color: #7b7268; font-size: 11px; text-align: right; }
.header-line { position: absolute; left: 16px; top: 58px; width: 304px; height: 1px; background-color: #ece3d6; }

/* 语录卡片 */
.quote-card { position: absolute; left: 16px; top: 70px; width: 304px; height: 188px; border-width: 1px; border-color: #ece3d6; border-radius: 8px; background-color: #fffdf8; }
.quote-accent { position: absolute; left: 14px; top: 16px; width: 4px; height: 14px; border-radius: 2px; background-color: #a83b2d; }
.quote-kicker { position: absolute; left: 24px; top: 13px; width: 220px; height: 18px; line-height: 18px; color: #9a9186; font-size: 13px; letter-spacing: 1px; }
.heart-img { position: absolute; left: 256px; top: 8px; width: 34px; height: 34px; }
.quote-text { position: absolute; left: 22px; top: 44px; width: 264px; height: 76px; color: #2b2723; font-size: 20px; font-weight: bold; line-height: 26px; text-align: left; }
.quote-source { position: absolute; left: 22px; top: 126px; width: 264px; height: 18px; line-height: 18px; color: #7b7268; font-size: 13px; text-align: right; }
.fortune-stamp { position: absolute; left: 16px; top: 150px; width: 62px; height: 26px; border-width: 2px; border-color: #a83b2d; border-radius: 4px; color: #a83b2d; font-size: 14px; font-weight: bold; text-align: center; padding-top: 2px; }
.fortune-tip { position: absolute; left: 86px; top: 152px; width: 202px; height: 18px; line-height: 18px; color: #a83b2d; font-size: 13px; }

/* 操作按钮：48 规格按屏高压缩为 44 */
.quote-actions { position: absolute; left: 16px; top: 266px; width: 304px; height: 44px; }
.action-button { position: absolute; top: 0; height: 44px; border-radius: 6px; font-size: 17px; font-weight: bold; }
.action-primary { left: 0; width: 152px; background-color: #a83b2d; color: #fffaf2; }
.action-secondary { left: 164px; width: 140px; border-width: 1px; border-color: #a83b2d; background-color: #fffdf8; color: #a83b2d; }

/* 四宫格功能卡 */
.feature-grid { position: absolute; left: 16px; top: 322px; width: 304px; height: 140px; }
.feature-card { position: absolute; left: 0; top: 0; width: 148px; height: 66px; border-width: 1px; border-color: #ece3d6; border-radius: 8px; background-color: #fffdf8; }
.feature-card-r { left: 156px; }
.feature-card-b { top: 74px; }
.feature-icon { position: absolute; left: 10px; top: 17px; width: 32px; height: 32px; }
.feature-title { position: absolute; left: 50px; top: 9px; width: 94px; height: 13px; line-height: 13px; color: #9a9186; font-size: 11px; letter-spacing: 1px; }
.feature-main { position: absolute; left: 50px; top: 24px; width: 94px; height: 20px; line-height: 20px; color: #2b2723; font-size: 15px; font-weight: bold; }
.feature-sub { position: absolute; left: 50px; top: 47px; width: 94px; height: 13px; line-height: 13px; color: #7b7268; font-size: 10px; }

/* 趣味星象遮罩 */
.zodiac-mask { position: absolute; left: 0; top: 0; width: 336px; height: 480px; background-color: #f2eee5; }
/* 回退箭头透明命中层加宽至 64px（规避左缘触摸死区，视觉不变） */
.zodiac-back-hit { position: absolute; left: 16px; top: 14px; width: 64px; height: 40px; }
.zodiac-back { width: 40px; height: 40px; line-height: 40px; color: #574e45; font-size: 28px; text-align: center; }
.zodiac-title { position: absolute; left: 56px; top: 21px; width: 224px; height: 26px; line-height: 26px; font-size: 20px; font-weight: bold; color: #2b2723; text-align: center; }
.zodiac-prev, .zodiac-next { position: absolute; top: 140px; width: 40px; height: 40px; border-width: 1px; border-color: #ece3d6; border-radius: 6px; background-color: #fffdf8; color: #a83b2d; font-size: 22px; }
.zodiac-prev { left: 16px; } .zodiac-next { left: 280px; }
/* 1.8.19：星座素材为 96×96 方形，插图位改 110×110 居中避免拉伸 */
.zodiac-ill { position: absolute; left: 113px; top: 70px; width: 110px; height: 110px; }
.zodiac-name-big { position: absolute; left: 16px; top: 188px; width: 304px; height: 44px; line-height: 44px; color: #2b2723; font-size: 32px; font-weight: bold; text-align: center; }
