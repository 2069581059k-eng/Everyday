.star-text { position: absolute; left: 236px; top: 0; width: 70px; color: #a43c30; font-size: 14px; text-align: right; }

.cover-card { position: absolute; left: 29px; top: 82px; width: 278px; height: 330px; border-width: 1px; border-color: #d6cbbb; border-radius: 6px; background-color: #fffdf8; }
.cover-month-bar { position: absolute; left: 0; top: 0; width: 276px; height: 48px; background-color: #a83b2d; }
.cover-month { position: absolute; left: 28px; top: 14px; width: 220px; color: #fffaf2; font-size: 21px; font-weight: bold; letter-spacing: 2px; text-align: center; }
.cover-day { position: absolute; left: 50px; top: 62px; width: 178px; color: #24201c; font-size: 114px; font-weight: bold; text-align: center; }
.cover-weekday { position: absolute; left: 79px; top: 180px; width: 120px; color: #a83b2d; font-size: 21px; font-weight: bold; letter-spacing: 3px; text-align: center; }
.paper-line { position: absolute; left: 34px; top: 210px; width: 210px; height: 1px; background-color: #ddd4c7; }
.draw-button { position: absolute; left: 42px; top: 287px; width: 194px; height: 45px; border-radius: 4px; background-color: #a83b2d; color: #fffaf2; font-size: 19px; font-weight: bold; }

.quote-card { position: absolute; left: 14px; top: 76px; width: 308px; height: 181px; border-width: 1px; border-color: #d7cdbf; border-radius: 6px; background-color: #fffdf8; }
.quote-accent { position: absolute; left: 0; top: 0; width: 5px; height: 179px; background-color: #a83b2d; }
.quote-kicker { position: absolute; left: 16px; top: 11px; width: 200px; color: #8b8175; font-size: 14px; letter-spacing: 1px; }
.fortune-stamp { position: absolute; left: 16px; top: 37px; width: 58px; height: 29px; border-width: 2px; border-color: #a83b2d; border-radius: 3px; color: #a83b2d; font-size: 17px; font-weight: bold; text-align: center; padding-top: 4px; }
.favorite-button { position: absolute; left: 244px; top: 7px; width: 54px; height: 27px; border-width: 1px; border-color: #d4c9ba; border-radius: 3px; background-color: #f8f3e9; color: #766c61; font-size: 14px; }
.quote-text { position: absolute; left: 81px; top: 39px; width: 207px; height: 84px; color: #29241f; font-size: 23px; font-weight: bold; line-height: 25px; text-align: left; }
.quote-source { position: absolute; left: 84px; top: 127px; width: 206px; color: #85796c; font-size: 14px; text-align: right; }
.fortune-tip { position: absolute; left: 17px; top: 150px; width: 270px; color: #a83b2d; font-size: 14px; }

.feature-row { position: absolute; left: 14px; top: 266px; width: 308px; height: 116px; }
.calendar-card, .astro-card { position: absolute; top: 0; width: 148px; height: 116px; border-width: 1px; border-color: #d7cdbf; border-radius: 6px; background-color: #fffdf8; }
.calendar-card { left: 0; }
.astro-card { left: 160px; }
.feature-title { position: absolute; left: 10px; top: 6px; width: 128px; height: 16px; line-height: 16px; color: #786d62; font-size: 14px; letter-spacing: 1px; }
.calendar-day { position: absolute; left: 10px; top: 24px; width: 70px; height: 46px; line-height: 46px; color: #2c2722; font-size: 46px; font-weight: bold; }
.calendar-month { position: absolute; left: 10px; top: 74px; width: 128px; height: 17px; line-height: 17px; color: #a83b2d; font-size: 15px; font-weight: bold; }
.feature-go { position: absolute; left: 10px; top: 96px; width: 128px; height: 14px; line-height: 14px; color: #93877a; font-size: 13px; }
.zodiac-name-short { position: absolute; left: 10px; top: 32px; width: 128px; color: #2f2924; font-size: 22px; font-weight: bold; }

.quote-actions { position: absolute; left: 14px; top: 392px; width: 308px; height: 34px; }
.action-button { position: absolute; top: 0; width: 140px; height: 34px; border-radius: 4px; font-size: 17px; font-weight: bold; }
.action-primary { left: 0; background-color: #a83b2d; color: #fffaf2; }
.action-secondary { left: 168px; border-width: 1px; border-color: #cfc4b5; background-color: #fffdf8; color: #574e45; }

.quiz-mask { position: absolute; left: 0; top: 0; width: 336px; height: 480px; background-color: #f2eee5; }
.quiz-panel { position: absolute; left: 12px; top: 12px; width: 312px; height: 456px; border-width: 1px; border-color: #d2c7b8; border-radius: 6px; background-color: #fffdf8; }
.quiz-kicker { position: absolute; left: 12px; top: 18px; width: 288px; color: #a83b2d; font-size: 25px; font-weight: bold; letter-spacing: 2px; text-align: center; }
.quiz-count { position: absolute; left: 12px; top: 50px; width: 288px; color: #94887c; font-size: 14px; text-align: center; }
.quiz-question-box { position: absolute; left: 16px; top: 64px; width: 280px; height: 104px; border-width: 1px; border-color: #ece3d6; border-radius: 6px; background-color: #fbf7f0; }
.quiz-question { position: absolute; left: 8px; top: 10px; width: 264px; height: 84px; color: #2c2722; font-size: 23px; font-weight: bold; line-height: 28px; text-align: center; }
.quiz-reveal-btn { position: absolute; left: 36px; top: 178px; width: 240px; height: 46px; border-radius: 4px; background-color: #a83b2d; color: #fffaf2; font-size: 19px; font-weight: bold; }
.quiz-reward { position: absolute; left: 16px; top: 176px; width: 280px; height: 26px; color: #a43c30; font-size: 16px; font-weight: bold; line-height: 20px; text-align: center; }
.quiz-answer-box { position: absolute; left: 16px; top: 212px; width: 280px; height: 176px; border-width: 1px; border-color: #ece3d6; border-radius: 6px; background-color: #fffdf8; }
.quiz-answer-label { position: absolute; left: 8px; top: 8px; width: 60px; color: #a83b2d; font-size: 14px; font-weight: bold; }
.quiz-answer-text { position: absolute; left: 8px; top: 30px; width: 264px; height: 46px; color: #2c2722; font-size: 18px; font-weight: bold; line-height: 23px; }
.quiz-explain { position: absolute; left: 8px; top: 84px; width: 264px; height: 76px; color: #776c61; font-size: 17px; line-height: 21px; }
.detail-next { position: absolute; left: 40px; top: 142px; width: 200px; height: 28px; background-color: #f8f3e9; color: #574e45; font-size: 14px; }
.quiz-actionbar { position: absolute; left: 16px; top: 400px; width: 280px; height: 48px; }
.quiz-nav-btn { position: absolute; top: 0; width: 86px; height: 44px; border-width: 1px; border-color: #d4c9ba; border-radius: 4px; background-color: #f8f3e9; color: #574e45; font-size: 15px; font-weight: bold; }
.quiz-prev { left: 0; }
.quiz-cancel { left: 97px; background-color: #fffdf8; color: #918579; font-size: 14px; }
.quiz-next { left: 194px; }

.month-mask { position: absolute; left: 0; top: 0; width: 336px; height: 480px; background-color: #fffdf8; }
.month-title { position: absolute; left: 16px; top: 18px; width: 304px; font-size: 26px; color: #383029; text-align: center; }
.month-prev, .month-next { position: absolute; top: 60px; width: 90px; height: 36px; font-size: 18px; background-color: #eee5d8; color: #574e45; }
.month-prev { left: 16px; } .month-next { left: 230px; }
.month-week-cell { position: absolute; top: 103px; width: 42px; height: 20px; font-size: 16px; color: #776c61; text-align: center; }
.month-cell { position: absolute; width: 42px; height: 36px; font-size: 22px; text-align: center; }
.month-info { position: absolute; left: 12px; top: 372px; width: 312px; font-size: 16px; color: #776c61; text-align: center; }
.month-current, .month-close { position: absolute; top: 420px; width: 140px; height: 40px; font-size: 18px; background-color: #a83b2d; color: #fffdf8; }
.month-current { left: 18px; } .month-close { left: 178px; }

.zodiac-mask { position: absolute; left: 0; top: 0; width: 336px; height: 480px; background-color: #fffdf8; }
.zodiac-title { position: absolute; left: 16px; top: 18px; width: 304px; font-size: 26px; color: #383029; text-align: center; }
.zodiac-prev, .zodiac-next { position: absolute; top: 60px; width: 36px; height: 36px; border-width: 1px; border-color: #d8cec0; border-radius: 3px; background-color: #f8f3e9; color: #8a4138; font-size: 23px; }
.zodiac-prev { left: 16px; } .zodiac-next { left: 284px; }
.zodiac-name-big { position: absolute; left: 16px; top: 140px; width: 304px; color: #2f2924; font-size: 40px; font-weight: bold; text-align: center; }
.zodiac-range-big { position: absolute; left: 16px; top: 196px; width: 304px; color: #9a8e81; font-size: 18px; text-align: center; }
.zodiac-moon { position: absolute; left: 16px; top: 250px; width: 304px; color: #71665b; font-size: 16px; text-align: center; }
.zodiac-tip { position: absolute; left: 16px; top: 290px; width: 304px; color: #a83b2d; font-size: 16px; text-align: center; }
.zodiac-close { position: absolute; left: 98px; top: 420px; width: 140px; height: 40px; font-size: 18px; background-color: #a83b2d; color: #fffdf8; }
</style>
