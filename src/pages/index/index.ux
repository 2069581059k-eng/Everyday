<template>
  <div class="page" onswipe="handleSwipe">
    <text class="brand">每日一言</text>

    <div class="stat-row">
      <text class="stat-text">连续 {{streakText}} 天</text>
      <text class="date-text">{{dateText}}</text>
      <text class="star-text">灵光 {{starsText}}</text>
    </div>

    <div class="cover-card" show="{{coverVisible}}">
      <div class="cover-month-bar">
        <text class="cover-month">{{monthYearText}}</text>
      </div>
      <text class="cover-day">{{dayText}}</text>
      <text class="cover-weekday">{{weekdayText}}</text>
      <div class="paper-line"></div>
      <input class="draw-button" type="button" value="翻开今日一签" onclick="revealToday" disabled="{{!stateReady}}" />
    </div>

    <div class="quote-card" show="{{quoteVisible}}">
      <div class="quote-accent"></div>
      <text class="quote-kicker">每日一言 · {{quoteNote}}</text>
      <text class="fortune-stamp">{{fortuneLevel}}</text>
      <input class="favorite-button" type="button" value="{{favoriteText}}" onclick="toggleFavorite" />
      <text class="quote-text">{{quoteText}}</text>
      <text class="quote-source">— {{quoteSource}}</text>
      <text class="fortune-tip">{{fortuneTip}}</text>
    </div>

    <div class="feature-row" show="{{quoteVisible}}">
      <div class="calendar-card" onclick="openCalendar">
        <text class="feature-title">今日日历</text>
        <text class="calendar-day">{{dayText}}</text>
        <text class="calendar-month">{{monthShortText}} {{weekdayText}}</text>
        <text class="feature-go">月历 ›</text>
      </div>

      <div class="astro-card" onclick="openZodiac">
        <text class="feature-title">趣味星象</text>
        <text class="zodiac-name-short">{{zodiacName}}</text>
        <text class="feature-go">详情 ›</text>
      </div>
    </div>

    <div class="quote-actions" show="{{quoteVisible}}">
      <input class="action-button action-primary" type="button" value="知识大全" onclick="startQuiz" />
      <input class="action-button action-secondary" type="button" value="换一句" onclick="drawAnother" />
    </div>

    <div class="quiz-mask" show="{{quizVisible}}">
      <div class="quiz-panel">
        <text class="quiz-kicker">知识大全</text>
        <text class="quiz-count">{{quizCategory}} · {{quizPos}} / {{quizTotal}}</text>

        <div class="quiz-question-box">
          <text class="quiz-question">{{riddleQuestion}}</text>
        </div>

        <input class="quiz-reveal-btn" show="{{!answerVisible}}" type="button" value="查看答案" onclick="revealAnswer" />

        <text class="quiz-reward" show="{{!!rewardText}}">{{rewardText}}</text>

        <div class="quiz-answer-box" show="{{answerVisible}}">
          <text class="quiz-answer-label">答案</text>
          <text class="quiz-answer-text">{{riddleAnswer}}</text>
          <text class="quiz-explain">{{riddleExplain}}</text>
          <input class="detail-next" show="{{detailTotal > 1}}" type="button" value="{{detailLabel}}" onclick="nextDetail" />
        </div>

        <div class="quiz-actionbar">
          <input class="quiz-nav-btn quiz-prev" type="button" value="{{prevLabel}}" onclick="prevQuestion" disabled="{{prevDisabled}}" />
          <input class="quiz-nav-btn quiz-cancel" type="button" value="返回今日" onclick="closeQuiz" />
          <input class="quiz-nav-btn quiz-next" type="button" value="{{nextLabel}}" onclick="nextQuestion" disabled="{{nextDisabled}}" />
        </div>
      </div>
    </div>
    <div class="month-mask" show="{{calendarVisible}}">
      <text class="month-title">{{calendarTitle}}</text>
      <input class="month-prev" type="button" value="上月" onclick="previousMonth" />
      <input class="month-next" type="button" value="下月" onclick="nextMonth" />
      <text class="month-week-cell" style="left: 12px;">日</text>
      <text class="month-week-cell" style="left: 56px;">一</text>
      <text class="month-week-cell" style="left: 100px;">二</text>
      <text class="month-week-cell" style="left: 144px;">三</text>
      <text class="month-week-cell" style="left: 188px;">四</text>
      <text class="month-week-cell" style="left: 232px;">五</text>
      <text class="month-week-cell" style="left: 276px;">六</text>
      <text class="month-cell" style="left: 12px; top: 130px; color: {{calToday0 ? '#a83b2d' : '#383029'}};">{{calCell0}}</text>
<text class="month-cell" style="left: 56px; top: 130px; color: {{calToday1 ? '#a83b2d' : '#383029'}};">{{calCell1}}</text>
<text class="month-cell" style="left: 100px; top: 130px; color: {{calToday2 ? '#a83b2d' : '#383029'}};">{{calCell2}}</text>
<text class="month-cell" style="left: 144px; top: 130px; color: {{calToday3 ? '#a83b2d' : '#383029'}};">{{calCell3}}</text>
<text class="month-cell" style="left: 188px; top: 130px; color: {{calToday4 ? '#a83b2d' : '#383029'}};">{{calCell4}}</text>
<text class="month-cell" style="left: 232px; top: 130px; color: {{calToday5 ? '#a83b2d' : '#383029'}};">{{calCell5}}</text>
<text class="month-cell" style="left: 276px; top: 130px; color: {{calToday6 ? '#a83b2d' : '#383029'}};">{{calCell6}}</text>
<text class="month-cell" style="left: 12px; top: 169px; color: {{calToday7 ? '#a83b2d' : '#383029'}};">{{calCell7}}</text>
<text class="month-cell" style="left: 56px; top: 169px; color: {{calToday8 ? '#a83b2d' : '#383029'}};">{{calCell8}}</text>
<text class="month-cell" style="left: 100px; top: 169px; color: {{calToday9 ? '#a83b2d' : '#383029'}};">{{calCell9}}</text>
<text class="month-cell" style="left: 144px; top: 169px; color: {{calToday10 ? '#a83b2d' : '#383029'}};">{{calCell10}}</text>
<text class="month-cell" style="left: 188px; top: 169px; color: {{calToday11 ? '#a83b2d' : '#383029'}};">{{calCell11}}</text>
<text class="month-cell" style="left: 232px; top: 169px; color: {{calToday12 ? '#a83b2d' : '#383029'}};">{{calCell12}}</text>
<text class="month-cell" style="left: 276px; top: 169px; color: {{calToday13 ? '#a83b2d' : '#383029'}};">{{calCell13}}</text>
<text class="month-cell" style="left: 12px; top: 208px; color: {{calToday14 ? '#a83b2d' : '#383029'}};">{{calCell14}}</text>
<text class="month-cell" style="left: 56px; top: 208px; color: {{calToday15 ? '#a83b2d' : '#383029'}};">{{calCell15}}</text>
<text class="month-cell" style="left: 100px; top: 208px; color: {{calToday16 ? '#a83b2d' : '#383029'}};">{{calCell16}}</text>
<text class="month-cell" style="left: 144px; top: 208px; color: {{calToday17 ? '#a83b2d' : '#383029'}};">{{calCell17}}</text>
<text class="month-cell" style="left: 188px; top: 208px; color: {{calToday18 ? '#a83b2d' : '#383029'}};">{{calCell18}}</text>
<text class="month-cell" style="left: 232px; top: 208px; color: {{calToday19 ? '#a83b2d' : '#383029'}};">{{calCell19}}</text>
<text class="month-cell" style="left: 276px; top: 208px; color: {{calToday20 ? '#a83b2d' : '#383029'}};">{{calCell20}}</text>
<text class="month-cell" style="left: 12px; top: 247px; color: {{calToday21 ? '#a83b2d' : '#383029'}};">{{calCell21}}</text>
<text class="month-cell" style="left: 56px; top: 247px; color: {{calToday22 ? '#a83b2d' : '#383029'}};">{{calCell22}}</text>
<text class="month-cell" style="left: 100px; top: 247px; color: {{calToday23 ? '#a83b2d' : '#383029'}};">{{calCell23}}</text>
<text class="month-cell" style="left: 144px; top: 247px; color: {{calToday24 ? '#a83b2d' : '#383029'}};">{{calCell24}}</text>
<text class="month-cell" style="left: 188px; top: 247px; color: {{calToday25 ? '#a83b2d' : '#383029'}};">{{calCell25}}</text>
<text class="month-cell" style="left: 232px; top: 247px; color: {{calToday26 ? '#a83b2d' : '#383029'}};">{{calCell26}}</text>
<text class="month-cell" style="left: 276px; top: 247px; color: {{calToday27 ? '#a83b2d' : '#383029'}};">{{calCell27}}</text>
<text class="month-cell" style="left: 12px; top: 286px; color: {{calToday28 ? '#a83b2d' : '#383029'}};">{{calCell28}}</text>
<text class="month-cell" style="left: 56px; top: 286px; color: {{calToday29 ? '#a83b2d' : '#383029'}};">{{calCell29}}</text>
<text class="month-cell" style="left: 100px; top: 286px; color: {{calToday30 ? '#a83b2d' : '#383029'}};">{{calCell30}}</text>
<text class="month-cell" style="left: 144px; top: 286px; color: {{calToday31 ? '#a83b2d' : '#383029'}};">{{calCell31}}</text>
<text class="month-cell" style="left: 188px; top: 286px; color: {{calToday32 ? '#a83b2d' : '#383029'}};">{{calCell32}}</text>
<text class="month-cell" style="left: 232px; top: 286px; color: {{calToday33 ? '#a83b2d' : '#383029'}};">{{calCell33}}</text>
<text class="month-cell" style="left: 276px; top: 286px; color: {{calToday34 ? '#a83b2d' : '#383029'}};">{{calCell34}}</text>
<text class="month-cell" style="left: 12px; top: 325px; color: {{calToday35 ? '#a83b2d' : '#383029'}};">{{calCell35}}</text>
<text class="month-cell" style="left: 56px; top: 325px; color: {{calToday36 ? '#a83b2d' : '#383029'}};">{{calCell36}}</text>
<text class="month-cell" style="left: 100px; top: 325px; color: {{calToday37 ? '#a83b2d' : '#383029'}};">{{calCell37}}</text>
<text class="month-cell" style="left: 144px; top: 325px; color: {{calToday38 ? '#a83b2d' : '#383029'}};">{{calCell38}}</text>
<text class="month-cell" style="left: 188px; top: 325px; color: {{calToday39 ? '#a83b2d' : '#383029'}};">{{calCell39}}</text>
<text class="month-cell" style="left: 232px; top: 325px; color: {{calToday40 ? '#a83b2d' : '#383029'}};">{{calCell40}}</text>
<text class="month-cell" style="left: 276px; top: 325px; color: {{calToday41 ? '#a83b2d' : '#383029'}};">{{calCell41}}</text>

      <text class="month-info">{{calendarInfo}}</text>
      <input class="month-current" type="button" value="回到本月" onclick="currentMonth" />
      <input class="month-close" type="button" value="返回主页" onclick="closeCalendar" />
    </div>

    <div class="zodiac-mask" show="{{zodiacVisible}}">
      <text class="zodiac-title">趣味星象</text>
      <input class="zodiac-prev" type="button" value="‹" onclick="previousZodiac" />
      <input class="zodiac-next" type="button" value="›" onclick="nextZodiac" />
      <text class="zodiac-name-big">{{zodiacName}}</text>
      <text class="zodiac-range-big">{{zodiacRange}}</text>
      <text class="zodiac-moon">{{moonText}}</text>
      <text class="zodiac-tip">{{astroTip}}</text>
      <input class="zodiac-close" type="button" value="返回主页" onclick="closeZodiac" />
    </div>

    <input class="exit-button" type="button" value="退出" onclick="exitGame" />
  </div>
</template>

<script>
import app from '@system.app'
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'

const STORAGE_KEY = 'daily_quote_state_v1'

const RIDDLES = [
  { question: "老詹养了一只狗，并且从來不帮狗洗澡，为什么狗不会生跳蚤呢？", category: "脑筋急转弯", answer: "狗只会生小狗", explain: "因为狗只会生小狗", source: "ChineseDatasets / brainteasers" },
  { question: "为什么两个孩子恰恰好？", category: "脑筋急转弯", answer: "不孝有三", explain: "因为不孝有三", source: "ChineseDatasets / brainteasers" },
  { question: "为什么婴儿一出生就大哭？", category: "脑筋急转弯", answer: "他看到护士阿姨太漂亮", explain: "因为他看到护士阿姨太漂亮.自己又太...小", source: "ChineseDatasets / brainteasers" },
  { question: "年年有余，为什么钱还是存不起來？", category: "脑筋急转弯", answer: "年年都被炒鱿鱼", explain: "因为年年都被炒鱿鱼", source: "ChineseDatasets / brainteasers" },
  { question: "为什么DrJ做完10下伏地挺身后，地上多了个凹洞？", category: "脑筋急转弯", answer: "他单手做伏地挺身", explain: "因为他单手做伏地挺身", source: "ChineseDatasets / brainteasers" },
  { question: "为什么大家都喜欢坐着看电影？", category: "脑筋急转弯", answer: "站着看脚会酸", explain: "因为站着看脚会酸", source: "ChineseDatasets / brainteasers" },
  { question: "鸭蛋一打有多少个？", category: "脑筋急转弯", answer: "全没有了碎了", explain: "全没有了碎了", source: "ChineseDatasets / brainteasers" },
  { question: "什么时候最好还是要高高举起你的双手好些", category: "脑筋急转弯", answer: "当人用手枪指着你的头的时候", explain: "当人用手枪指着你的头的时候", source: "ChineseDatasets / brainteasers" },
  { question: "猴子每分钟能掰一个玉米，在果园里，一只猴子５分钟能掰几个玉米", category: "脑筋急转弯", answer: "一个也没有掰到", explain: "一个也没有掰到", source: "ChineseDatasets / brainteasers" },
  { question: "小云和阿花已经结婚了，为什么他们还偷偷摸摸的约会呢？", category: "脑筋急转弯", answer: "他们分别是和别人约会", explain: "他们分别是和别人约会", source: "ChineseDatasets / brainteasers" },
  { question: "小王跑步为什么总是保持一个姿势不变？", category: "脑筋急转弯", answer: "他在照片中", explain: "因为他在照片中", source: "ChineseDatasets / brainteasers" },
  { question: "哪种人希望孩子越多越好？", category: "脑筋急转弯", answer: "儿童用品制造高", explain: "儿童用品制造高", source: "ChineseDatasets / brainteasers" },
  { question: "为什么刘备三顾茅庐，诸葛亮才肯见他？", category: "脑筋急转弯", answer: "前两次没带礼", explain: "因为前两次没带礼", source: "ChineseDatasets / brainteasers" },
  { question: "老张是出了名的拳手，为什么一戴上拳击手套反而让对手三下两下打下台去了？", category: "脑筋急转弯", answer: "他是划酒拳的高手", explain: "他是划酒拳的高手", source: "ChineseDatasets / brainteasers" },
  { question: "远东百货遭小偷，警察立刻封锁住所有出口，但为什么小偷仍逃了出去，为什么？", category: "脑筋急转弯", answer: "小偷可以从入口逃走呀", explain: "小偷可以从入口逃走呀", source: "ChineseDatasets / brainteasers" },
  { question: "为什么只看过“小说”，没看过“大说”？", category: "脑筋急转弯", answer: "大说已逝世", explain: "因为大说已逝世", source: "ChineseDatasets / brainteasers" },
  { question: "为什么罗丹雕塑的作品“沉思者”没有穿衣服？", category: "脑筋急转弯", answer: "他正在想穿那件衣服好看", explain: "他正在想穿那件衣服好看", source: "ChineseDatasets / brainteasers" },
  { question: "阿里巴巴和四十大盗的故事是东方夜谭还是西方夜谭", category: "脑筋急转弯", answer: "都不是天方夜谭", explain: "都不是天方夜谭", source: "ChineseDatasets / brainteasers" },
  { question: "为什么老王家的马能吃掉老张家的象", category: "脑筋急转弯", answer: "他们正在下象棋", explain: "因为他们正在下象棋", source: "ChineseDatasets / brainteasers" },
  { question: "为什么女人穿高跟鞋后，就代表她快结婚了", category: "脑筋急转弯", answer: "穿高跟鞋慢很容易被男人追上", explain: "因为穿高跟鞋慢很容易被男人追上", source: "ChineseDatasets / brainteasers" },
  { question: "为什么冲天炮射不到星星？", category: "脑筋急转弯", answer: "星星会闪呀", explain: "因为星星会闪呀", source: "ChineseDatasets / brainteasers" },
  { question: "蓝色的笔能写出红字吗？", category: "脑筋急转弯", answer: "写个红字当然可以", explain: "写个红字当然可以", source: "ChineseDatasets / brainteasers" },
  { question: "请问英语有多少个字母？", category: "脑筋急转弯", answer: "没有字母是中文", explain: "没有字母是中文", source: "ChineseDatasets / brainteasers" },
  { question: "为什么离婚的人越来越多？", category: "脑筋急转弯", answer: "结婚的越来越多", explain: "因为结婚的越来越多", source: "ChineseDatasets / brainteasers" },
  { question: "为什么有人说：世界上分配得最公平的东西是“良心”？", category: "脑筋急转弯", answer: "你说过有人说自己没有良心了吗", explain: "你说过有人说自己没有良心了吗", source: "ChineseDatasets / brainteasers" },
  { question: "你有一艘船，船上有十五位船员，六十位乘客，三百吨货物。你能根据上面的提示，算出船主的年龄吗", category: "脑筋急转弯", answer: "你就是船主年龄还需要算吗?", explain: "你就是船主年龄还需要算吗?", source: "ChineseDatasets / brainteasers" },
  { question: "爸爸要小明背论语，他一分钟就背了整本书，难道小明是天才吗？", category: "脑筋急转弯", answer: "不因为他只背了论语.", explain: "不因为他只背了论语.", source: "ChineseDatasets / brainteasers" },
  { question: "艳阳高照，为什么只有小可全身湿淋淋的？", category: "脑筋急转弯", answer: "他正在游泳呀", explain: "因为他正在游泳呀", source: "ChineseDatasets / brainteasers" },
  { question: "中国人为什么人口这么多？", category: "脑筋急转弯", answer: "汉(和)人在一起.", explain: "因为汉(和)人在一起.", source: "ChineseDatasets / brainteasers" },
  { question: "为什么小明拒绝用“一边„„一边„„”这个词来造句？", category: "脑筋急转弯", answer: "老师不是说\"一心不能二用\"嘛", explain: "老师不是说\"一心不能二用\"嘛.", source: "ChineseDatasets / brainteasers" },
  { question: "一只田鼠在挖洞时并没有在洞口四周留下泥堆，为什么？", category: "脑筋急转弯", answer: "他先挖出口", explain: "因为他先挖出口", source: "ChineseDatasets / brainteasers" },
  { question: "森林里有一条眼镜蛇，可是它从来不咬人，你知道为什么吗？", category: "脑筋急转弯", answer: "那森林里没有人", explain: "因为那森林里没有人", source: "ChineseDatasets / brainteasers" },
  { question: "为什么老李喜欢和自己的老婆和孩子一起打麻将？", category: "脑筋急转弯", answer: "只有这样才能回收一部分薪水", explain: "只有这样才能回收一部分薪水", source: "ChineseDatasets / brainteasers" },
  { question: "如果你生出来的儿子只有一只右手你会怎么办？", category: "脑筋急转弯", answer: "怕什么他不是还有一只左手嘛", explain: "怕什么他不是还有一只左手嘛", source: "ChineseDatasets / brainteasers" },
  { question: "三个人一起下田，但其中一个人却老站在那里不动手，为什么？", category: "脑筋急转弯", answer: "那是个稻草人", explain: "那是个稻草人", source: "ChineseDatasets / brainteasers" },
  { question: "外国人问路，小明拼命有英语对他说，他却一点也听不懂，这是为什么？", category: "脑筋急转弯", answer: "他是法国人", explain: "因为他是法国人", source: "ChineseDatasets / brainteasers" },
  { question: "福尔摩斯花了半天时间，却查不出命案现场有任何线索及目击者，但他随即就宣布破案了，为什么？", category: "脑筋急转弯", answer: "凶手自首了", explain: "因为凶手自首了", source: "ChineseDatasets / brainteasers" },
  { question: "小杰最爱吹牛，但是为什么他说大家都说他讲话很实在？", category: "脑筋急转弯", answer: "那是他自己说的", explain: "那是他自己说的", source: "ChineseDatasets / brainteasers" },
  { question: "考一个亲戚称呼问题，如果你曾祖父的儿子，就是娶了你妈妈的那个人，你应该叫他什么？", category: "脑筋急转弯", answer: "喂乘儿子吃了没有", explain: "喂乘儿子吃了没有", source: "ChineseDatasets / brainteasers" },
  { question: "嫦娥为什么后悔上广寒宫？", category: "脑筋急转弯", answer: "月亮上没有赛月饼", explain: "因为月亮上没有赛月饼", source: "ChineseDatasets / brainteasers" },
  { question: "在机场办出境手续时，才想起忘了拿护照，怎么样才能在最短的时间里拿到护照呢？", category: "脑筋急转弯", answer: "打开皮包就可以拿到了", explain: "打开皮包就可以拿到了", source: "ChineseDatasets / brainteasers" },
  { question: "为什么有人说：“情人眼里出西施”？", category: "脑筋急转弯", answer: "爱情使人盲目", explain: "因为爱情使人盲目", source: "ChineseDatasets / brainteasers" },
  { question: "车子应该靠右行使才对，为什么杨先生靠左行使却没事？", category: "脑筋急转弯", answer: "他正行驶在靠左行驶的国家", explain: "因为他正行驶在靠左行驶的国家", source: "ChineseDatasets / brainteasers" },
  { question: "安妮的医师男友到外地出差一年，每两天会写一封情书给安妮，请问两个月之后，安妮会收到几封情书？", category: "脑筋急转弯", answer: "一封也没有", explain: "一封也没有,有,但他太懒了,一封也没有寄.", source: "ChineseDatasets / brainteasers" },
  { question: "阿三死了，为什么大毛理直气壮的说：“凶手不是我，绝对另有其人！”", category: "脑筋急转弯", answer: "阿三是电视推理剧场中的", explain: "因为阿三是电视推理剧场中的", source: "ChineseDatasets / brainteasers" },
  { question: "三国美男子周瑜，为什么会感慨的说：“既生瑜，何生亮”呢？", category: "脑筋急转弯", answer: "诸葛亮长的比周瑜帅", explain: "因为诸葛亮长的比周瑜帅", source: "ChineseDatasets / brainteasers" },
  { question: "一向最爱吃蛋糕的大宝，今天为什么连面前那14小块蛋糕都吃不下呢？", category: "脑筋急转弯", answer: "他刚刚吃完那3/4", explain: "因为他刚刚吃完那3/4", source: "ChineseDatasets / brainteasers" },
  { question: "为什么阿发悄悄对臭皮说他裤子的拉链忘了拉，臭皮却不以为意？", category: "脑筋急转弯", answer: "阿发说的是自己", explain: "因为阿发说的是自己", source: "ChineseDatasets / brainteasers" },
  { question: "一个失恋的年轻男子从两层楼高的天桥往下跳，结果却毫发无伤，这是怎么回事？", category: "脑筋急转弯", answer: "他是演员正在拍电影", explain: "因为他是演员正在拍电影", source: "ChineseDatasets / brainteasers" },
  { question: "一头牛一年吃三公顷的牧草，现有面积三十公顷的牧场养了五头牛，请问需要多久才能全部吃完？", category: "脑筋急转弯", answer: "春风吹又生他们一辈子也吃不完", explain: "春风吹又生他们一辈子也吃不完", source: "ChineseDatasets / brainteasers" },
  { question: "明明是一个晴朗出太阳的好日子，却有人说：“等一下就要刮台风了！”为什么他会这么说？", category: "脑筋急转弯", answer: "现在正在台风眼里", explain: "因为现在正在台风眼里", source: "ChineseDatasets / brainteasers" },
  { question: "阿发仔的长相和家人很相象，但大家都说阿发仔不是他们的孩子，为什么？", category: "脑筋急转弯", answer: "他是爸爸", explain: "因为他是爸爸", source: "ChineseDatasets / brainteasers" },
  { question: "曹兰在马路边拦下一辆计程车，当她坐进车中后立刻被司机赶出来，为什么？", category: "脑筋急转弯", answer: "司机问他去那儿她说不告诉你.", explain: "因为司机问他去那儿她说不告诉你.", source: "ChineseDatasets / brainteasers" },
  { question: "小陈半夜吃泡面，为什么一面吃，一面眼盯着表？", category: "脑筋急转弯", answer: "那包面的食用期到今天", explain: "那包面的食用期到今天", source: "ChineseDatasets / brainteasers" },
  { question: "为什么老陈会说他少了女人一天也活不下去？", category: "脑筋急转弯", answer: "他是化妆品制造商", explain: "他是化妆品制造商", source: "ChineseDatasets / brainteasers" },
  { question: "报纸新闻和电视新闻最大的不同在哪里？", category: "脑筋急转弯", answer: "报纸看完了可以保存.", explain: "报纸看完了可以保存.", source: "ChineseDatasets / brainteasers" },
  { question: "有架飞机失事，现场支离破碎，令人惊讶的是找不到任何伤着，为什么？", category: "脑筋急转弯", answer: "那是一架遥控飞机", explain: "那是一架遥控飞机", source: "ChineseDatasets / brainteasers" },
  { question: "老张不小心吞了一枚金币，为什么到十年后才去手术取出来呢？", category: "脑筋急转弯", answer: "当时不急着用钱", explain: "因为当时不急着用钱", source: "ChineseDatasets / brainteasers" },
  { question: "怀孕的母狗怕人踢它，可是有个家伙踢它，它既不躲避也不生气，为什么？", category: "脑筋急转弯", answer: "那家伙在他的肚子里踢", explain: "因为那家伙在他的肚子里踢", source: "ChineseDatasets / brainteasers" },
  { question: "一只羊碰到一头老虎，非但不怕，而且还把那头老虎给吃了，这是怎么回事？", category: "脑筋急转弯", answer: "那是只纸考虎", explain: "那是只纸考虎", source: "ChineseDatasets / brainteasers" },
  { question: "一个人请人画十二生肖像最后只剩下蛇没画是，画师怎么也不肯画了，为什么？", category: "脑筋急转弯", answer: "他怕画蛇添足", explain: "因为他怕画蛇添足", source: "ChineseDatasets / brainteasers" },
  { question: "墙壁上爬着三只壁虎，一只壁虎掉下后没多久，另外两只也跟着掉下来，到底发生什么事情？", category: "脑筋急转弯", answer: "一只在打瞌睡", explain: "因为一只在打瞌睡,另两只拍手叫好,也掉下来了,", source: "ChineseDatasets / brainteasers" },
  { question: "武士刀和日本人有什么关系？", category: "脑筋急转弯", answer: "他们是剖腹之交", explain: "他们是剖腹之交", source: "ChineseDatasets / brainteasers" },
  { question: "走进一家店，看见老板和客人正在议价，老板拼命杀价，而顾客却一直抬高价钱，为什么？", category: "脑筋急转弯", answer: "客人来卖车", explain: "因为客人来卖车", source: "ChineseDatasets / brainteasers" },
  { question: "小陈礼拜天早上赶到西门町去看早场电影，到了西门町，却看不到半个人，为什么", category: "脑筋急转弯", answer: "人有好多个就是没有半个.", explain: "人有好多个就是没有半个.", source: "ChineseDatasets / brainteasers" },
  { question: "恐龙为什么会灭亡？", category: "脑筋急转弯", answer: "那个时候没有动物保护协会", explain: "那个时候没有动物保护协会", source: "ChineseDatasets / brainteasers" },
  { question: "为什么会有悲伤茱丽叶？", category: "脑筋急转弯", answer: "有爱的罗密欧", explain: "因为有爱的罗密欧", source: "ChineseDatasets / brainteasers" },
  { question: "为什么大多数的人都不喜欢过32岁的生日？", category: "脑筋急转弯", answer: "没有人会在蛋糕上插上三长两短", explain: "没有人会在蛋糕上插上三长两短.", source: "ChineseDatasets / brainteasers" },
  { question: "刚念幼儿园的皮皮才学英文一个月却能毫无困难地和外国人交谈，为什么？", category: "脑筋急转弯", answer: "外国人用国语与他交谈", explain: "外国人用国语与他交谈", source: "ChineseDatasets / brainteasers" },
  { question: "小龙的爸爸看到小龙书包里塞满了钞票，却视若无睹，为什么？", category: "脑筋急转弯", answer: "那是儿童玩具", explain: "那是儿童玩具", source: "ChineseDatasets / brainteasers" },
  { question: "有一天，小英看到小明随即惊叫，小明见状，也跟着惊叫，为什么？", category: "脑筋急转弯", answer: "他们正在玩游戏", explain: "因为他们正在玩游戏", source: "ChineseDatasets / brainteasers" },
  { question: "小王开医院，生意一直不是很如意，一天他的医院突然车水马龙排了一大堆人，为什么？", category: "脑筋急转弯", answer: "他在医院门口贴了今日住院3折", explain: "因为他在医院门口贴了今日住院3折", source: "ChineseDatasets / brainteasers" },
  { question: "身高168公分的小华，有一天去看棒球赛回来却变成170公分，为什么？", category: "脑筋急转弯", answer: "他被击中长出了一个两公分的包", explain: "因为他被击中长出了一个两公分的包", source: "ChineseDatasets / brainteasers" },
  { question: "在赛车比赛中，有辆车撞上大树，车子完全撞烂，开车者却毫发无伤，为什么？", category: "脑筋急转弯", answer: "那是遥控车比赛", explain: "那是遥控车比赛", source: "ChineseDatasets / brainteasers" },
  { question: "政府在去年的中秋节提倡“不要让嫦娥笑我们脏”，今年却没有，为什么？", category: "脑筋急转弯", answer: "嫦娥去年就笑死了", explain: "因为嫦娥去年就笑死了", source: "ChineseDatasets / brainteasers" },
  { question: "为什么夏天才有台风？", category: "脑筋急转弯", answer: "他要冬眠", explain: "因为他要冬眠", source: "ChineseDatasets / brainteasers" },
  { question: "为什么闪电总是比雷快？", category: "脑筋急转弯", answer: "雷公说女士优先", explain: "因为雷公说女士优先", source: "ChineseDatasets / brainteasers" },
  { question: "什么时候是老二最爽的时候？", category: "脑筋急转弯", answer: "当老大不在不能欺负老二时", explain: "当老大不在不能欺负老二时", source: "ChineseDatasets / brainteasers" },
  { question: "小陈有一天不小心撞到电线杆，为什么连手也会痛？", category: "脑筋急转弯", answer: "小陈狠狠地揍了电线杆一顿", explain: "因为小陈狠狠地揍了电线杆一顿", source: "ChineseDatasets / brainteasers" },
  { question: "著名歌手罗大佑有一天出现在热闹的西门町街头，为什么却没有半个人认出他来？", category: "脑筋急转弯", answer: "他忘了带墨镜", explain: "因为他忘了带墨镜", source: "ChineseDatasets / brainteasers" },
  { question: "为什么爱斯基摩人是唯一住在北极的人呢", category: "脑筋急转弯", answer: "他们是爱死寂寞的人", explain: "因为他们是爱死寂寞的人", source: "ChineseDatasets / brainteasers" },
  { question: "超人和女超人做完俯地挺身后，地上各有一个洞及二个洞，是怎么回事？", category: "脑筋急转弯", answer: "超人用单手女超人用双手", explain: "超人用单手女超人用双手", source: "ChineseDatasets / brainteasers" },
  { question: "为什么一架纸飞机，造价一亿台币？", category: "脑筋急转弯", answer: "那是用一张一亿台币的纸票折的", explain: "那是用一张一亿台币的纸票折的", source: "ChineseDatasets / brainteasers" },
  { question: "有一位老奶奶在看报，一只蚊子正想要叮她，老奶奶手和脚都没动，为什么蚊子会突然死掉了？", category: "脑筋急转弯", answer: "他被老奶奶的皱纹夹死了", explain: "因为他被老奶奶的皱纹夹死了", source: "ChineseDatasets / brainteasers" },
  { question: "有一段100公尺长的铁轨上面每隔1公分放一条横木，请问共有几条横木？", category: "脑筋急转弯", answer: "0,因为钢轨上不放横木", explain: "0,因为钢轨上不放横木", source: "ChineseDatasets / brainteasers" },
  { question: "有一天，有一班学生正在小考，有一个学生，他答出来之后，为什么老师还打了他一顿？", category: "脑筋急转弯", answer: "他把答案念给同学听", explain: "因为他把答案念给同学听", source: "ChineseDatasets / brainteasers" },
  { question: "小男孩和小女孩在一起不能玩什么游戏？", category: "脑筋急转弯", answer: "不能玩猜拳(两小无猜0", explain: "不能玩猜拳(两小无猜0", source: "ChineseDatasets / brainteasers" },
  { question: "一家洗衣店招牌写着“二十四小时交货”，今天小高拿去洗，为何老板说要三天后才能拿到？", category: "脑筋急转弯", answer: "他是抓黑枪不是抓白枪", explain: "因为他是抓黑枪不是抓白枪", source: "ChineseDatasets / brainteasers" },
  { question: "小明每天都和妈妈上街买菜，每次都捉着妈妈的裙子，但这次却迷路了，为什么？", category: "脑筋急转弯", answer: "那天妈妈穿着迷你裙", explain: "因为那天妈妈穿着迷你裙", source: "ChineseDatasets / brainteasers" },
  { question: "为什么食人族只有在烹煮女明星时要放入一大堆牛粪来调味？", category: "脑筋急转弯", answer: "香水味太浓他们吃不消", explain: "香水味太浓他们吃不消", source: "ChineseDatasets / brainteasers" },
  { question: "走夜路犯了烟瘾，有烟无火时该怎么办？", category: "脑筋急转弯", answer: "看看有没有鬼火可以点", explain: "看看有没有鬼火可以点", source: "ChineseDatasets / brainteasers" },
  { question: "月圆之夜，全世界的鬼魂都聚集在一起开狂欢大会，偏偏只有狼人没有到，为什么？", category: "脑筋急转弯", answer: "狼人是妖怪不是鬼", explain: "狼人是妖怪不是鬼", source: "ChineseDatasets / brainteasers" },
  { question: "据说前一阵子“ET”离开地球以后，英文字母只剩24个字，但是最新消息听是15个字，为什么？", category: "脑筋急转弯", answer: "UFO飞走了", explain: "因为UFO飞走了,WC臭死了AIDS生病住院", source: "ChineseDatasets / brainteasers" },
  { question: "华盛顿小时候砍倒他父亲的樱桃树时，他父亲为什么不马上处罚他？", category: "脑筋急转弯", answer: "他手头上还有斧头", explain: "因为他手头上还有斧头", source: "ChineseDatasets / brainteasers" },
  { question: "麦可杰克森的儿子是幸福的，为什么？", category: "脑筋急转弯", answer: "他可以把他爸爸的鼻子拿下来玩", explain: "他可以把他爸爸的鼻子拿下来玩", source: "ChineseDatasets / brainteasers" },
  { question: "释迦牟尼是男人还是女人？", category: "脑筋急转弯", answer: "都不是他是神", explain: "都不是他是神", source: "ChineseDatasets / brainteasers" },
  { question: "唐老鸭最怕什么事？", category: "脑筋急转弯", answer: "发现原来自己是白天鹅", explain: "发现原来自己是白天鹅", source: "ChineseDatasets / brainteasers" },
  { question: "超人走到电话亭前突然哭了起来为什么？", category: "脑筋急转弯", answer: "他严重发福所以进不去了", explain: "他严重发福所以进不去了", source: "ChineseDatasets / brainteasers" },
  { question: "两岁的叮当为什么看到隔壁的欧巴桑都叫她“伯伯”，而对方却一点也不生气？", category: "脑筋急转弯", answer: "他是阿拉伯\"人", explain: "因为他是阿拉伯\"人", source: "ChineseDatasets / brainteasers" },
  { question: "许仙遇见白蛇后，发生了什么事？", category: "脑筋急转弯", answer: "不知道因为他被白蛇吓倒了", explain: "不知道因为他被白蛇吓倒了", source: "ChineseDatasets / brainteasers" },
  { question: "孔子为什么要周游列国？", category: "脑筋急转弯", answer: "飞机没有发明", explain: "因为飞机没有发明", source: "ChineseDatasets / brainteasers" },
  { question: "在火车站绝不可能发生什么事？", category: "脑筋急转弯", answer: "既然不可能发生当然不能发生", explain: "既然不可能发生当然不能发生", source: "ChineseDatasets / brainteasers" },
  { question: "如何保持青春永驻？", category: "脑筋急转弯", answer: "用奇笔写它不要擦去", explain: "用奇笔写它不要擦去", source: "ChineseDatasets / brainteasers" },
  { question: "一艘正在水中航行的船为什么会突然消失得无影无综", category: "脑筋急转弯", answer: "小宝已经洗完澡把它拿走了", explain: "因为小宝已经洗完澡把它拿走了", source: "ChineseDatasets / brainteasers" },
  { question: "大华坐公车为什么不用付钱？", category: "脑筋急转弯", answer: "公车还停在站上", explain: "因为公车还停在站上", source: "ChineseDatasets / brainteasers" },
  { question: "不会讲外语的大明和不会讲中文的外国人有说有笑，他是怎么办到的？", category: "脑筋急转弯", answer: "他们两讲哑语呀", explain: "他们两讲哑语呀", source: "ChineseDatasets / brainteasers" },
