<text class="month-cell" style="left: 188px; top: 325px; color: {{calColor39}};">{{calCell39}}</text>
<text class="month-cell" style="left: 232px; top: 325px; color: {{calColor40}};">{{calCell40}}</text>
<text class="month-cell" style="left: 276px; top: 325px; color: {{calColor41}};">{{calCell41}}</text>

      <text class="month-info">{{calendarInfo}}</text>
      <input class="month-current" type="button" value="回到本月" onclick="currentMonth" />
      <input class="month-close" type="button" value="返回主页" onclick="closeCalendar" />
    </div>

    <div class="zodiac-mask" show="{{zodiacVisible}}">
      <text class="zodiac-title">趣味星象</text>
      <input class="zodiac-prev" type="button" value="‹" onclick="previousZodiac" />
      <input class="zodiac-next" type="button" value="›" onclick="nextZodiac" />
      <text class="zodiac-name-big">{{zodiacName}}</text>
      <text class="zodiac-range-big">{{zodiacRange}}</text>
      <text class="zodiac-moon">{{moonText}}</text>
      <text class="zodiac-tip">{{astroTip}}</text>
      <input class="zodiac-analyze" type="button" value="形象分析 ›" onclick="startZodiacTest" />
      <input class="zodiac-close" type="button" value="返回主页" onclick="closeZodiac" />
    </div>
  </div>
</template>

<script>
import app from '@system.app'
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'
import router from '@system.router'

import { RIDDLES } from '../../common/data/knowledge.js'
import { QUOTES } from '../../common/data/quotes.js'
import { pad, WEEKDAYS, dayInfo, moonPhase, isLegalHoliday, monthHolidayText } from '../../common/utils/date.js'
import { ZODIACS, ASTRO_ACTIONS, ASTRO_COLORS, FORTUNES, zodiacForDate } from '../../common/utils/zodiac.js'
import { mulberry32 } from '../../common/utils/random.js'

const STORAGE_KEY = 'daily_quote_state_v1'

function knowledgeDetail(record) {
  let text = record.explain
  if (isQaMode(record) && !text.includes(record.answer)) text = record.answer + '。' + text
  return text
}

function isQaMode(record) {
  return record.displayMode === 'qa' || record.category === '脑筋急转弯' || record.category === '十万个为什么'
}

function knowledgeAnswer(record) {
  if (!isQaMode(record)) return ''
  return Array.from(record.answer).length <= 14 ? record.answer : '完整答案见下方详解'
}

function dailyRiddles(dayNumber) {
  const rand = mulberry32((dayNumber * 2654435761) >>> 0)
  function shuffle(items) {
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(rand() * (i + 1))
      const temp = items[i]; items[i] = items[j]; items[j] = temp
    }
    return items
  }
  const plan = [
    { category: '脑筋急转弯', count: 10 },
    { category: '十万个为什么', count: 10 },
    { category: '百科全书', count: 10 },
    { category: '冷笑话', count: 10 },
    { category: '鬼故事', count: 10 }
  ]
  const daily = []
  for (let i = 0; i < plan.length; i++) {
    const group = RIDDLES.filter(function (item) { return item.category === plan[i].category })
    const picked = shuffle(group).slice(0, plan[i].count)
    for (let j = 0; j < picked.length; j++) daily.push(picked[j])
  }
  return shuffle(daily)
}

function shouldResetQuizProgress(savedDay, todayDay) {
  return savedDay !== todayDay
}

const today = dayInfo(new Date())
const todayIndex = quoteIndex(today.dayNumber)
const dailyRiddleList = dailyRiddles(today.dayNumber)
let currentIndex = todayIndex
let state = {
  lastDay: -1,
  streak: 0,
  stars: 0,
  awardedDay: -1,
  favorites: [],
  zodiacIndex: zodiacForDate(today.month, today.date),
  quizSchema: 180,
  quizDay: -1,
  quizIndex: 0,
  quizViewed: []
}

export default {
  private: {
    stateReady: false,
    calendarVisible: false,
    calendarYear: today.year,
    calendarMonth: today.month,
    calendarTitle: '', calendarInfo: '',
    calCell0: '', calToday0: false,
    calCell1: '', calToday1: false,
    calCell2: '', calToday2: false,
    calCell3: '', calToday3: false,
    calCell4: '', calToday4: false,
    calCell5: '', calToday5: false,
    calCell6: '', calToday6: false,
    calCell7: '', calToday7: false,
    calCell8: '', calToday8: false,
    calCell9: '', calToday9: false,
    calCell10: '', calToday10: false,
    calCell11: '', calToday11: false,
    calCell12: '', calToday12: false,
    calCell13: '', calToday13: false,
    calCell14: '', calToday14: false,
    calCell15: '', calToday15: false,
    calCell16: '', calToday16: false,
    calCell17: '', calToday17: false,
    calCell18: '', calToday18: false,
    calCell19: '', calToday19: false,
    calCell20: '', calToday20: false,
    calCell21: '', calToday21: false,
    calCell22: '', calToday22: false,
    calCell23: '', calToday23: false,
    calCell24: '', calToday24: false,
    calCell25: '', calToday25: false,
    calCell26: '', calToday26: false,
    calCell27: '', calToday27: false,
    calCell28: '', calToday28: false,
    calCell29: '', calToday29: false,
    calCell30: '', calToday30: false,
    calCell31: '', calToday31: false,
    calCell32: '', calToday32: false,
    calCell33: '', calToday33: false,
    calCell34: '', calToday34: false,
    calCell35: '', calToday35: false,
    calCell36: '', calToday36: false,
    calCell37: '', calToday37: false,
    calCell38: '', calToday38: false,
    calCell39: '', calToday39: false,
    calCell40: '', calToday40: false,
    calCell41: '', calToday41: false,
    calColor0: "#383029",
    calColor1: "#383029",
    calColor2: "#383029",
    calColor3: "#383029",
    calColor4: "#383029",
    calColor5: "#383029",
    calColor6: "#383029",
    calColor7: "#383029",
    calColor8: "#383029",
    calColor9: "#383029",
    calColor10: "#383029",
    calColor11: "#383029",
    calColor12: "#383029",
    calColor13: "#383029",
    calColor14: "#383029",
    calColor15: "#383029",
    calColor16: "#383029",
    calColor17: "#383029",
    calColor18: "#383029",
    calColor19: "#383029",
    calColor20: "#383029",
    calColor21: "#383029",
    calColor22: "#383029",
    calColor23: "#383029",
    calColor24: "#383029",
    calColor25: "#383029",
    calColor26: "#383029",
    calColor27: "#383029",
    calColor28: "#383029",
    calColor29: "#383029",
    calColor30: "#383029",
    calColor31: "#383029",
    calColor32: "#383029",
    calColor33: "#383029",
    calColor34: "#383029",
    calColor35: "#383029",
    calColor36: "#383029",
    calColor37: "#383029",
    calColor38: "#383029",
    calColor39: "#383029",
    calColor40: "#383029",
    calColor41: "#383029",

    streakText: '0',
    starsText: '0',
    dateText: today.label,
    monthYearText: today.year + '年 ' + pad(today.month) + '月',
    monthShortText: pad(today.month) + '月',
    dayText: pad(today.date),
    weekdayText: WEEKDAYS[today.weekday],
    yearDayText: '今年第 ' + today.dayOfYear + ' 天',
    quoteVisible: true,
    quizVisible: false,
    zodiacVisible: false,
    quoteDrawn: false,
    quoteKicker: 'Daily Spark',
    quoteText: '轻触下方「抽一签」，看看今天与哪句话有缘。',
    quoteSource: '',
    quoteNote: '',
    fortuneLevel: '',
    fortuneTip: '',
    zodiacName: ZODIACS[state.zodiacIndex].name,
    zodiacRange: ZODIACS[state.zodiacIndex].range,
    moonText: '月相 · ' + moonPhase(today.dayNumber),
    astroTip: '',
    favoriteText: '收藏',
    calendarHolidayText: '',
    riddleQuestion: '',
    quizCategory: '',
    quizPos: 0,
    quizTotal: 0,
    riddleAnswer: '',
    revealLabel: '查看答案',
    answerLabel: '答案',
    riddleExplain: '',
    riddleKnowledge: '',
    isQaItem: false,
    detailIndex: 0,
    detailTotal: 1,
    detailLabel: '',
    answerVisible: false,
    prevDisabled: true,
    nextDisabled: true,
    prevLabel: '上一题',
    nextLabel: '下一题',
  },

  onInit() {
    this.loadState()
    this.refreshAstro()
  },

  onShow() {
    this.setScreenAwake(true)
  },

  onHide() {
    this.setScreenAwake(false)
  },

  onDestroy() {
    this.setScreenAwake(false)
  },

  setScreenAwake(enabled) {
    try {
      brightness.setKeepScreenOn({
        keepScreenOn: enabled,
        success() { console.log('keepScreenOn=' + enabled) },
        fail(data, code) { console.log('keepScreenOn failed: ' + code) }
      })
    } catch (error) {
      console.log('keepScreenOn unavailable: ' + error)
    }
  },

  loadState() {
    const page = this
    const finishLoad = function () {
      page.stateReady = true
      page.refreshStats()
      page.refreshFavorite()
      page.refreshAstro()
      page.recordToday()
    }
    try {
      storage.get({
        key: STORAGE_KEY,
        default: '',
        success(data) {
          if (data) try {
            const saved = JSON.parse(data)
            state.lastDay = Number(saved.lastDay) || -1
            state.streak = Number(saved.streak) || 0
            state.stars = Number(saved.stars) || 0
            state.awardedDay = Number(saved.awardedDay) || -1
            state.favorites = saved.favorites || []
            state.quizDay = Number(saved.quizDay)
            if (!Number.isFinite(state.quizDay)) state.quizDay = -1
            state.quizIndex = Number(saved.quizIndex) || 0
            state.quizViewed = Array.isArray(saved.quizViewed) ? saved.quizViewed : []
            if (saved.quizSchema !== 180 || shouldResetQuizProgress(state.quizDay, today.dayNumber)) {
              state.quizIndex = 0
              state.quizViewed = []
            }
            const savedZodiac = Number(saved.zodiacIndex)
            if (savedZodiac >= 0 && savedZodiac < ZODIACS.length) state.zodiacIndex = savedZodiac
          } catch (error) {
            console.log('每日一言存档解析失败: ' + error)
          }
          finishLoad()
        },
        fail(data, code) {
          console.log('每日一言存档读取失败: ' + code)
          finishLoad()
        }
      })
    } catch (error) {
      console.log('存储模块不可用: ' + error)
      finishLoad()
    }
  },

  saveState() {
    if (!this.stateReady) return
    try {
      storage.set({
        key: STORAGE_KEY,
        value: JSON.stringify(state),
        fail(data, code) { console.log('每日一言存档保存失败: ' + code) }
      })
    } catch (error) {
      console.log('存储模块不可用: ' + error)
    }
  },

  refreshStats() {
    this.streakText = String(state.streak)
    this.starsText = String(state.stars)
  },

  refreshAstro() {
    const zodiac = ZODIACS[state.zodiacIndex]
    const action = ASTRO_ACTIONS[(today.dayNumber + state.zodiacIndex * 7) % ASTRO_ACTIONS.length]
    const color = ASTRO_COLORS[(today.dayNumber * 3 + state.zodiacIndex) % ASTRO_COLORS.length]
    this.zodiacName = zodiac.name
    this.zodiacRange = zodiac.range
    this.astroTip = '宜 ' + action + ' · ' + color
  },

  previousZodiac() {
    state.zodiacIndex = (state.zodiacIndex + ZODIACS.length - 1) % ZODIACS.length
    this.refreshAstro()
    this.saveState()
    this.pulse('short')
  },

  nextZodiac() {
    state.zodiacIndex = (state.zodiacIndex + 1) % ZODIACS.length
    this.refreshAstro()
    this.saveState()
    this.pulse('short')
  },

  startZodiacTest() {
    router.replace({ uri: 'pages/zodiac-test/zodiac-test' })
  },

  openKnowledgePage() {
    router.replace({ uri: 'pages/knowledge/knowledge' })
  },

  openCalendarPage() {
    router.replace({ uri: 'pages/calendar/calendar' })
  },

  drawFortune() {
    if (!this.stateReady) return
    this.recordToday()
    let next = (currentIndex + 1 + Math.floor(Math.random() * (QUOTES.length - 1))) % QUOTES.length
    if (next === currentIndex) next = (next + 1) % QUOTES.length
    this.applyQuote(next, false)
    const fortune = FORTUNES[Math.floor(Math.random() * FORTUNES.length)]
    this.fortuneLevel = fortune.level
    this.fortuneTip = fortune.tip
    this.quoteDrawn = true
    this.pulse('short')
  },

  recordToday() {
    if (state.lastDay === today.dayNumber) return
    state.streak = state.lastDay === today.dayNumber - 1 ? state.streak + 1 : 1
    state.lastDay = today.dayNumber
    this.refreshStats()
    this.saveState()
  },

  applyQuote(index, isToday) {
    currentIndex = index
    const quote = QUOTES[index]
    this.quoteText = quote.text
    this.quoteNote = quote.note
    this.quoteKicker = quote.note ? 'Daily Spark · ' + quote.note : 'Daily Spark'
    this.quoteSource = quote.source || 'Daily Spark'
    this.refreshFavorite()
  },

  openCalendar() { this.calendarVisible = true; this.renderCalendar() },
  closeCalendar() { this.calendarVisible = false },
  openZodiac() { this.zodiacVisible = true },
  closeZodiac() { this.zodiacVisible = false },
  previousMonth() {
    this.calendarMonth -= 1
    if (this.calendarMonth < 1) { this.calendarMonth = 12; this.calendarYear -= 1 }
    this.renderCalendar()
  },
  nextMonth() {
    this.calendarMonth += 1
    if (this.calendarMonth > 12) { this.calendarMonth = 1; this.calendarYear += 1 }
    this.renderCalendar()
  },
  currentMonth() { this.calendarYear = today.year; this.calendarMonth = today.month; this.renderCalendar() },
  renderCalendar() {
    const y = this.calendarYear; const m = this.calendarMonth
    const first = new Date(y, m - 1, 1).getDay()
    const days = new Date(y, m, 0).getDate()
    this.calendarTitle = y + '年 ' + m + '月'
    this.calendarInfo = '本月 ' + days + ' 天 · 今日 ' + today.label
    const holidayText = monthHolidayText(y, m)
    if (holidayText) this.calendarInfo = '本月 ' + days + ' 天 · ' + holidayText
    for (let i = 0; i < 42; i++) {
      const d = i - first + 1
      const inMonth = d > 0 && d <= days
      this['calCell' + i] = inMonth ? String(d) : ''
      this['calToday' + i] = y === today.year && m === today.month && d === today.date
      let color = '#d8d2c6'
      if (inMonth) {
        const dow = (i % 7)
        const isWeekend = dow === 0 || dow === 6
        const holiday = isLegalHoliday(y, m, d)
        if (this['calToday' + i]) color = '#a83b2d'
        else if (holiday) color = '#c0392b'
        else if (isWeekend) color = '#3f7d46'
        else color = '#383029'
      }
      this['calColor' + i] = color
    }
  },

  startQuiz() {
    this.recordToday()
    if (state.quizDay !== today.dayNumber) {
      state.quizDay = today.dayNumber
      state.quizIndex = 0
      state.quizViewed = []
    }
    this.quizVisible = true
    this.renderQuiz()
    this.pulse('short')
  },

  renderQuiz() {
    const list = dailyRiddleList
    const idx = state.quizIndex
    const len = list.length
    const riddle = list[idx]
    this.quizPos = idx + 1
    this.quizTotal = len
    this.quizCategory = riddle.category
    this.riddleQuestion = riddle.question
    this.isQaItem = isQaMode(riddle)
    this.revealLabel = this.isQaItem ? '查看答案' : '展开正文'
    this.answerLabel = this.isQaItem ? '答案' : riddle.category
    this.answerVisible = !this.isQaItem
    if (this.answerVisible) {
      this.riddleAnswer = this.isQaItem ? knowledgeAnswer(riddle) : riddle.question
      this.riddleExplain = riddle.explain
      this.riddleKnowledge = riddle.knowledge || ''
    } else {
      this.riddleAnswer = ''
      this.riddleExplain = ''
      this.riddleKnowledge = ''
      this.detailTotal = 1
      this.detailLabel = ''
    }
    this.detailIndex = 0
    if (this.answerVisible) this.renderDetail()
    this.prevDisabled = idx <= 0
    this.nextDisabled = idx >= len - 1
    this.prevLabel = idx <= 0 ? '已是第一题' : '上一题'
    this.nextLabel = idx >= len - 1 ? '已是最后一题' : '下一题'
  },

  revealAnswer() {
    if (this.answerVisible) return
    const idx = state.quizIndex
    const riddle = dailyRiddleList[idx]
    this.riddleAnswer = knowledgeAnswer(riddle)
    this.riddleExplain = riddle.explain
    this.riddleKnowledge = riddle.knowledge || ''
    this.answerVisible = true
    this.detailIndex = 0
    this.renderDetail()
    if (state.quizViewed.indexOf(idx) < 0) state.quizViewed.push(idx)
    this.pulse('short')
    this.saveState()
  },

  renderDetail() {
    const r = dailyRiddleList[state.quizIndex]
    const text = knowledgeDetail(r)
    const step = isQaMode(r) ? 32 : 84
    const chunks = []
    const chars = Array.from(text)
    for (let i = 0; i < chars.length; i += step) chunks.push(chars.slice(i, i + step).join(''))
    this.detailTotal = chunks.length || 1
    this.riddleExplain = chunks[this.detailIndex] || ''
    this.detailLabel = '继续 ' + (this.detailIndex + 1) + '/' + this.detailTotal
  },

  nextDetail() {
    this.detailIndex = (this.detailIndex + 1) % this.detailTotal
    this.renderDetail()
  },

  prevQuestion() {
    if (state.quizIndex <= 0) return
    state.quizIndex -= 1
    this.renderQuiz()
    this.saveState()
    this.pulse('short')
  },

  nextQuestion() {
    if (state.quizIndex >= dailyRiddleList.length - 1) return
    state.quizIndex += 1
    this.renderQuiz()
    this.saveState()
    this.pulse('short')
  },

  closeQuiz() {
    this.quizVisible = false
    this.saveState()
  },

  toggleFavorite() {
    const position = state.favorites.indexOf(currentIndex)
    if (position >= 0) {
      state.favorites.splice(position, 1)
    } else {
      state.favorites.push(currentIndex)
    }
    this.refreshFavorite()
    this.saveState()
    this.pulse('short')
  },

  refreshFavorite() {
    this.favoriteText = state.favorites.indexOf(currentIndex) >= 0 ? '已收藏' : '收藏'
  },

  handleSwipe(event) {
    if (event && event.direction === 'right') this.exitGame()
  },

  exitGame() {
    this.setScreenAwake(false)
    if (this.stateReady) this.saveState()
    try { this.$app.exit() } catch (error) { console.log('全局退出不可用: ' + error) }
    try { app.terminate() } catch (error) { console.log('系统退出不可用: ' + error) }
  },

  pulse(mode) {
    try { vibrator.vibrate({ mode: mode }) } catch (error) { console.log('振动不可用: ' + error) }
  }
}
</script>

