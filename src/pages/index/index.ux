<text class="month-cell" style="left: 12px; top: 247px; color: {{calColor21}};">{{calCell21}}</text>
<text class="month-cell" style="left: 56px; top: 247px; color: {{calColor22}};">{{calCell22}}</text>
<text class="month-cell" style="left: 100px; top: 247px; color: {{calColor23}};">{{calCell23}}</text>
<text class="month-cell" style="left: 144px; top: 247px; color: {{calColor24}};">{{calCell24}}</text>
<text class="month-cell" style="left: 188px; top: 247px; color: {{calColor25}};">{{calCell25}}</text>
<text class="month-cell" style="left: 232px; top: 247px; color: {{calColor26}};">{{calCell26}}</text>
