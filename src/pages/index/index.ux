<template>
  <div class="page" onswipe="handleSwipe">
    <text class="brand">Daily Spark</text>

    <div class="stat-row">
      <text class="stat-text">连续 {{streakText}} 天</text>
      <text class="date-text">{{dateText}}</text>
      <text class="star-text">灵光 {{starsText}}</text>
    </div>

    <div class="quote-card" show="{{quoteVisible}}">
      <div class="quote-accent"></div>
      <text class="quote-kicker">{{quoteKicker}}</text>
      <text class="fortune-stamp" show="{{quoteDrawn}}">{{fortuneLevel}}</text>
      <input class="favorite-button" type="button" value="{{favoriteText}}" onclick="toggleFavorite" disabled="{{!quoteDrawn}}" />
      <text class="quote-text">{{quoteText}}</text>
      <text class="quote-source" show="{{quoteDrawn}}">— {{quoteSource}}</text>
      <text class="fortune-tip" show="{{quoteDrawn}}">{{fortuneTip}}</text>
    </div>

    <div class="feature-row" show="{{quoteVisible}}">
      <div class="calendar-card" onclick="openCalendarPage">
        <text class="feature-title">今日日历</text>
        <text class="calendar-day">{{dayText}}</text>
        <text class="calendar-month">{{monthShortText}} {{weekdayText}}</text>
        <text class="feature-go">月历 ›</text>
      </div>

      <div class="astro-card" onclick="openZodiac">
        <text class="feature-title">趣味星象</text>
        <text class="zodiac-name-short">{{zodiacName}}</text>
        <text class="feature-go">详情 ›</text>
      </div>
    </div>

    <div class="quote-actions" show="{{quoteVisible}}">
      <input class="action-button action-primary" type="button" value="知识大全" onclick="openKnowledgePage" />
      <input class="action-button action-secondary" type="button" value="抽一签" onclick="drawFortune" />
    </div>

    <div class="zodiac-mask" show="{{zodiacVisible}}">
      <text class="zodiac-title">趣味星象</text>
      <input class="zodiac-prev" type="button" value="‹" onclick="previousZodiac" />
      <input class="zodiac-next" type="button" value="›" onclick="nextZodiac" />
      <text class="zodiac-name-big">{{zodiacName}}</text>
      <text class="zodiac-range-big">{{zodiacRange}}</text>
      <text class="zodiac-moon">{{moonText}}</text>
      <text class="zodiac-tip">{{astroTip}}</text>
      <input class="zodiac-analyze" type="button" value="形象分析 ›" onclick="startZodiacTest" />
      <input class="zodiac-close" type="button" value="返回主页" onclick="closeZodiac" />
    </div>
  </div>
</template>
<script>
import app from '@system.app'
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'
import router from '@system.router'
import { QUOTES } from '../../common/data/quotes.js'
import { pad, WEEKDAYS, dayInfo, moonPhase } from '../../common/utils/date.js'
import { ZODIACS, ASTRO_ACTIONS, ASTRO_COLORS, FORTUNES, zodiacForDate } from '../../common/utils/zodiac.js'

const STORAGE_KEY = 'daily_quote_state_v1'

function quoteIndex(dayNumber) {
  const value = (dayNumber * 17 + 11) % QUOTES.length
  return value < 0 ? value + QUOTES.length : value
}

const today = dayInfo(new Date())
const todayIndex = quoteIndex(today.dayNumber)
let currentIndex = todayIndex
let state = {
  lastDay: -1,
  streak: 0,
  stars: 0,
  awardedDay: -1,
  favorites: [],
  zodiacIndex: zodiacForDate(today.month, today.date)
}

export default {
  private: {
    stateReady: false,
    zodiacVisible: false,
    quoteVisible: true,
    zodiacName: ZODIACS[state.zodiacIndex].name,
    zodiacRange: ZODIACS[state.zodiacIndex].range,
    astroTip: '',
    dateText: today.label,
    monthShortText: pad(today.month) + '月',
    dayText: pad(today.date),
    weekdayText: WEEKDAYS[today.weekday],
    yearDayText: '今年第 ' + today.dayOfYear + ' 天',
    streakText: '0',
    starsText: '0',
    moonText: '月相 · ' + moonPhase(today.dayNumber),
    quoteDrawn: false,
    quoteKicker: 'Daily Spark',
    quoteText: '轻触下方「抽一签」，看看今天与哪句话有缘。',
    quoteSource: '',
    quoteNote: '',
    fortuneLevel: '',
    fortuneTip: '',
    favoriteText: '收藏'
  },

  onInit() {
    this.loadState()
    this.refreshAstro()
  },

  onShow() {
    this.setScreenAwake(true)
  },

  onHide() {
    this.setScreenAwake(false)
  },

  onDestroy() {
    this.setScreenAwake(false)
  },

  setScreenAwake(enabled) {
    try {
      brightness.setKeepScreenOn({
        keepScreenOn: enabled,
        success() { console.log('keepScreenOn=' + enabled) },
        fail(data, code) { console.log('keepScreenOn failed: ' + code) }
      })
    } catch (error) {
      console.log('keepScreenOn unavailable: ' + error)
    }
  },

  loadState() {
    const page = this
    const finishLoad = function () {
      page.stateReady = true
      page.refreshStats()
      page.refreshFavorite()
      page.refreshAstro()
      page.recordToday()
    }
    try {
      storage.get({
        key: STORAGE_KEY,
        default: '',
        success(data) {
          if (data) try {
            const saved = JSON.parse(data)
            state.lastDay = Number(saved.lastDay) || -1
            state.streak = Number(saved.streak) || 0
            state.stars = Number(saved.stars) || 0
            state.awardedDay = Number(saved.awardedDay) || -1
            state.favorites = saved.favorites || []
            const savedZodiac = Number(saved.zodiacIndex)
            if (savedZodiac >= 0 && savedZodiac < ZODIACS.length) state.zodiacIndex = savedZodiac
          } catch (error) {
            console.log('首页存档解析失败: ' + error)
          }
          finishLoad()
        },
        fail(data, code) {
          console.log('首页存档读取失败: ' + code)
          finishLoad()
        }
      })
    } catch (error) {
      console.log('存储模块不可用: ' + error)
      finishLoad()
    }
  },

  saveState() {
    if (!this.stateReady) return
    try {
      storage.set({
        key: STORAGE_KEY,
        value: JSON.stringify(state),
        fail(data, code) { console.log('首页存档保存失败: ' + code) }
      })
    } catch (error) {
      console.log('存储模块不可用: ' + error)
    }
  },

  refreshStats() {
    this.streakText = String(state.streak)
    this.starsText = String(state.stars)
  },

  refreshAstro() {
    const zodiac = ZODIACS[state.zodiacIndex]
    const action = ASTRO_ACTIONS[(today.dayNumber + state.zodiacIndex * 7) % ASTRO_ACTIONS.length]
    const color = ASTRO_COLORS[(today.dayNumber * 3 + state.zodiacIndex) % ASTRO_COLORS.length]
    this.zodiacName = zodiac.name
    this.zodiacRange = zodiac.range
    this.astroTip = '宜 ' + action + ' · ' + color
  },

  previousZodiac() {
    state.zodiacIndex = (state.zodiacIndex + ZODIACS.length - 1) % ZODIACS.length
    this.refreshAstro()
    this.saveState()
    this.pulse('short')
  },

  nextZodiac() {
    state.zodiacIndex = (state.zodiacIndex + 1) % ZODIACS.length
    this.refreshAstro()
    this.saveState()
    this.pulse('short')
  },

  openZodiac() { this.zodiacVisible = true },
  closeZodiac() { this.zodiacVisible = false },

  startZodiacTest() {
    router.replace({ uri: 'pages/zodiac-test/zodiac-test' })
  },

  openCalendarPage() {
    router.replace({ uri: 'pages/calendar/calendar' })
  },

  openKnowledgePage() {
    router.replace({ uri: 'pages/knowledge/knowledge' })
  },

  drawFortune() {
    if (!this.stateReady) return
    this.recordToday()
    let next = (currentIndex + 1 + Math.floor(Math.random() * (QUOTES.length - 1))) % QUOTES.length
    if (next === currentIndex) next = (next + 1) % QUOTES.length
    this.applyQuote(next)
    const fortune = FORTUNES[Math.floor(Math.random() * FORTUNES.length)]
    this.fortuneLevel = fortune.level
    this.fortuneTip = fortune.tip
    this.quoteDrawn = true
    this.pulse('short')
  },

  recordToday() {
    if (state.lastDay === today.dayNumber) return
    state.streak = state.lastDay === today.dayNumber - 1 ? state.streak + 1 : 1
    state.lastDay = today.dayNumber
    this.refreshStats()
    this.saveState()
  },

  applyQuote(index) {
    currentIndex = index
    const quote = QUOTES[index]
    this.quoteText = quote.text
    this.quoteNote = quote.note
    this.quoteKicker = quote.note ? 'Daily Spark · ' + quote.note : 'Daily Spark'
    this.quoteSource = quote.source || 'Daily Spark'
    this.refreshFavorite()
  },

  toggleFavorite() {
    const position = state.favorites.indexOf(currentIndex)
    if (position >= 0) {
      state.favorites.splice(position, 1)
    } else {
      state.favorites.push(currentIndex)
    }
    this.refreshFavorite()
    this.saveState()
    this.pulse('short')
  },

  refreshFavorite() {
    this.favoriteText = state.favorites.indexOf(currentIndex) >= 0 ? '已收藏' : '收藏'
  },

  handleSwipe(event) {
    if (event && event.direction === 'right') this.exitGame()
  },

  exitGame() {
    this.setScreenAwake(false)
    if (this.stateReady) this.saveState()
    try { this.$app.exit() } catch (error) { console.log('全局退出不可用: ' + error) }
    try { app.terminate() } catch (error) { console.log('系统退出不可用: ' + error) }
  },

  pulse(mode) {
    try { vibrator.vibrate({ mode: mode }) } catch (error) { console.log('振动不可用: ' + error) }
  }
}
</script>

<style>
.page { position: relative; width: 336px; height: 480px; background-color: #f2eee5; overflow: hidden; }
.brand { position: absolute; left: 0; top: 8px; width: 336px; color: #6f655a; font-size: 15px; font-weight: bold; letter-spacing: 2px; text-align: center; }

.stat-row { position: absolute; left: 15px; top: 44px; width: 306px; height: 19px; border-bottom-width: 1px; border-color: #d6cec1; }
.stat-text { position: absolute; left: 0; top: 0; width: 100px; color: #786e63; font-size: 14px; }
.date-text { position: absolute; left: 113px; top: 0; width: 100px; color: #473f37; font-size: 14px; text-align: center; }
.star-text { position: absolute; left: 236px; top: 0; width: 70px; color: #a43c30; font-size: 14px; text-align: right; }

.quote-card { position: absolute; left: 14px; top: 76px; width: 308px; height: 181px; border-width: 1px; border-color: #d7cdbf; border-radius: 6px; background-color: #fffdf8; }
.quote-accent { position: absolute; left: 0; top: 0; width: 5px; height: 179px; background-color: #a83b2d; }
.quote-kicker { position: absolute; left: 16px; top: 11px; width: 200px; color: #8b8175; font-size: 14px; letter-spacing: 1px; }
.fortune-stamp { position: absolute; left: 16px; top: 37px; width: 58px; height: 29px; border-width: 2px; border-color: #a83b2d; border-radius: 3px; color: #a83b2d; font-size: 17px; font-weight: bold; text-align: center; padding-top: 4px; }
.favorite-button { position: absolute; left: 244px; top: 7px; width: 54px; height: 27px; border-width: 1px; border-color: #d4c9ba; border-radius: 3px; background-color: #f8f3e9; color: #766c61; font-size: 14px; }
.quote-text { position: absolute; left: 81px; top: 39px; width: 207px; height: 84px; color: #29241f; font-size: 23px; font-weight: bold; line-height: 25px; text-align: left; }
.quote-source { position: absolute; left: 84px; top: 127px; width: 206px; color: #85796c; font-size: 14px; text-align: right; }
.fortune-tip { position: absolute; left: 17px; top: 150px; width: 270px; color: #a83b2d; font-size: 14px; }

.feature-row { position: absolute; left: 14px; top: 266px; width: 308px; height: 116px; }
.calendar-card, .astro-card { position: absolute; top: 0; width: 148px; height: 116px; border-width: 1px; border-color: #d7cdbf; border-radius: 6px; background-color: #fffdf8; }
.calendar-card { left: 0; }
.astro-card { left: 160px; }
.feature-title { position: absolute; left: 10px; top: 6px; width: 128px; height: 16px; line-height: 16px; color: #786d62; font-size: 14px; letter-spacing: 1px; }
.calendar-day { position: absolute; left: 10px; top: 24px; width: 70px; height: 46px; line-height: 46px; color: #2c2722; font-size: 46px; font-weight: bold; }
.calendar-month { position: absolute; left: 10px; top: 74px; width: 128px; height: 17px; line-height: 17px; color: #a83b2d; font-size: 15px; font-weight: bold; }
.feature-go { position: absolute; left: 10px; top: 96px; width: 128px; height: 14px; line-height: 14px; color: #93877a; font-size: 13px; }
.zodiac-name-short { position: absolute; left: 10px; top: 32px; width: 128px; color: #2f2924; font-size: 22px; font-weight: bold; }

.quote-actions { position: absolute; left: 14px; top: 392px; width: 308px; height: 34px; }
.action-button { position: absolute; top: 0; width: 140px; height: 34px; border-radius: 4px; font-size: 17px; font-weight: bold; }
.action-primary { left: 0; background-color: #a83b2d; color: #fffaf2; }
.action-secondary { left: 168px; border-width: 1px; border-color: #cfc4b5; background-color: #fffdf8; color: #574e45; }

.zodiac-mask { position: absolute; left: 0; top: 0; width: 336px; height: 480px; background-color: #fffdf8; }
.zodiac-title { position: absolute; left: 16px; top: 18px; width: 304px; font-size: 26px; color: #383029; text-align: center; }
.zodiac-prev, .zodiac-next { position: absolute; top: 60px; width: 36px; height: 36px; border-width: 1px; border-color: #d8cec0; border-radius: 3px; background-color: #f8f3e9; color: #8a4138; font-size: 23px; }
.zodiac-prev { left: 16px; } .zodiac-next { left: 284px; }
.zodiac-name-big { position: absolute; left: 16px; top: 140px; width: 304px; color: #2f2924; font-size: 40px; font-weight: bold; text-align: center; }
.zodiac-range-big { position: absolute; left: 16px; top: 196px; width: 304px; color: #9a8e81; font-size: 18px; text-align: center; }
.zodiac-moon { position: absolute; left: 16px; top: 250px; width: 304px; color: #71665b; font-size: 16px; text-align: center; }
.zodiac-tip { position: absolute; left: 16px; top: 290px; width: 304px; color: #a83b2d; font-size: 16px; text-align: center; }
.zodiac-analyze { position: absolute; left: 98px; top: 368px; width: 140px; height: 40px; border-width: 1px; border-color: #a83b2d; border-radius: 4px; background-color: #fffdf8; color: #a83b2d; font-size: 18px; font-weight: bold; }
.zodiac-close { position: absolute; left: 98px; top: 420px; width: 140px; height: 40px; font-size: 18px; background-color: #a83b2d; color: #fffdf8; }
</style>
