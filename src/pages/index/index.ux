  { question: "小胖上完厕所为什么不洗手？", category: "脑筋急转弯", answer: "没有人规定上完厕所要洗手.", explain: "因为没有人规定上完厕所要洗手.", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "某人用面条上吊，结果真的死了。为什么？", category: "脑筋急转弯", answer: "他是掉下来摔死的。", explain: "他是掉下来摔死的。", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
  { question: "请你把九匹马平均放到十个马圈里，并让每个马圈里的马的数目都相同，怎么分？", category: "脑筋急转弯", answer: "把九匹马放到一个马圈里", explain: "把九匹马放到一个马圈里，然后在这个马圈外再套九个马", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
