  { question: "为什么两只老虎打架,非要拼个你死我活绝不罢休？", category: "脑筋急转弯", answer: "没有人敢去劝架", explain: "没有人敢去劝架", source: "ChineseDatasets / brainteasers", displayMode: "qa" },
