<template>
  <div class="quiz-mask" onswipe="handleSwipe">
    <div class="quiz-panel">
      <div class="qa-mode" show="{{isQaItem}}">
        <text class="quiz-kicker">{{quizCategory}}</text>
        <div class="quiz-question-box">
          <text class="quiz-question">{{riddleQuestion}}</text>
        </div>
        <image class="quiz-ill" show="{{!answerVisible}}" src="/common/assets/ill-mountain.png" />
        <input class="quiz-reveal-btn" show="{{!answerVisible}}" type="button" value="{{revealLabel}}" onclick="revealAnswer" />

        <div class="quiz-answer-box" show="{{answerVisible}}">
          <text class="quiz-answer-label">答案</text>
          <text class="quiz-explain" onclick="nextDetail">{{riddleExplain}}</text>
          <text class="detail-page" show="{{detailTotal > 1}}">{{detailLabel}}</text>
        </div>
      </div>

      <div class="read-mode" show="{{!isQaItem}}">
        <text class="read-kicker">{{quizCategory}}</text>
        <text class="read-title">{{riddleQuestion}}</text>
        <text class="read-text" onclick="nextDetail">{{riddleExplain}}</text>
        <text class="read-page" show="{{detailTotal > 1}}">{{detailLabel}}</text>
      </div>

      <div class="quiz-actionbar">
        <input class="quiz-nav-btn quiz-prev" type="button" value="{{prevLabel}}" onclick="prevQuestion" disabled="{{prevDisabled}}" />
        <text class="quiz-mid">{{quizPos}} / {{quizTotal}}</text>
        <input class="quiz-nav-btn quiz-next" type="button" value="{{nextLabel}}" onclick="nextQuestion" disabled="{{nextDisabled}}" />
      </div>
    </div>

    <div class="kn-back-hit" onclick="goHome"><text class="kn-back">‹</text></div>
    <image class="kn-heart-img" show="{{!heartFilled}}" src="/common/assets/ic-heart-off.png" onclick="toggleFavorite" />
    <image class="kn-heart-img" show="{{heartFilled}}" src="/common/assets/ic-heart-on.png" onclick="toggleFavorite" />
    <div class="header-line"></div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'
import { RIDDLES } from '../../common/data/knowledge.js'
import { dayInfo } from '../../common/utils/date.js'
import { isQaMode, knowledgeDetail, knowledgeAnswer, dailyRiddles, shouldResetQuizProgress } from '../../common/utils/knowledge.js'
import { FAVORITES_KEY, makeKnowledgeFavorite, toggleFavorite, hasFavorite } from '../../common/utils/favorites.js'

const STORAGE_KEY = 'daily_quote_knowledge_v1'
const today = dayInfo(new Date())
const dailyRiddleList = dailyRiddles(RIDDLES, today.dayNumber)
let quizState = { quizDay: -1, quizIndex: 0, quizViewed: [] }
let favoritesItems = []

export default {
  // AIoT/Vela 页面数据必须放在 private 中，顶层属性不会被当作模板数据源
  private: {
    stateReady: false,
    heartFilled: false,
    quizCategory: '',
    quizPos: 0,
    quizTotal: 0,
    riddleQuestion: '',
    riddleExplain: '',
    riddleAnswer: '',
    isQaItem: false,
    revealLabel: '查看答案',
    answerLabel: '答案',
    answerVisible: false,
    detailIndex: 0,
    detailTotal: 1,
    detailLabel: '',
    prevDisabled: true,
    nextDisabled: true,
    prevLabel: '已是第一题',
    nextLabel: '下一题',
  },


  onInit() {
    this.setAwake(true)
    const page = this
    const finishLoad = function () {
      page.stateReady = true
      page.renderQuiz()
    }
    // 收藏室存档（爱心状态用）
    try {
      storage.get({
        key: FAVORITES_KEY,
        default: '',
        success(favData) {
          if (favData) try {
            const savedFav = JSON.parse(favData)
            if (savedFav && Array.isArray(savedFav.items)) favoritesItems = savedFav.items
          } catch (error) {
            console.log('收藏室存档解析失败: ' + error)
          }
          page.loadQuizState(finishLoad)
        },
        fail() { page.loadQuizState(finishLoad) }
      })
    } catch (error) { this.loadQuizState(finishLoad) }
  },

  loadQuizState(finishLoad) {
    const page = this
    try {
      storage.get({
        key: STORAGE_KEY,
        default: '',
        success(data) {
          if (data) try {
            const saved = JSON.parse(data)
            quizState.quizDay = Number(saved.quizDay)
            if (!Number.isFinite(quizState.quizDay)) quizState.quizDay = -1
            quizState.quizIndex = Number(saved.quizIndex) || 0
            quizState.quizViewed = Array.isArray(saved.quizViewed) ? saved.quizViewed : []
            // 1.8.15：quizSchema 181 = 脑筋急转弯每日 10 题含 ≥6 条 v2 优化条目（qualityScore 优先选题）
            if (saved.quizSchema !== 181 || shouldResetQuizProgress(quizState.quizDay, today.dayNumber)) {
              quizState.quizDay = today.dayNumber
              quizState.quizIndex = 0
              quizState.quizViewed = []
            }
          } catch (error) {
            console.log('知识页存档解析失败: ' + error)
          }
          finishLoad()
        },
        fail() { finishLoad() }
      })
    } catch (error) { finishLoad() }
  },

  onShow() { this.setAwake(true) },
  onHide() { this.setAwake(false) },
  onDestroy() { this.setAwake(false) },

  setAwake(enabled) {
    try {
      brightness.setKeepScreenOn({
        keepScreenOn: enabled,
        success() {},
        fail(data, code) { console.log('keepScreenOn failed: ' + code) }
      })
    } catch (error) {}
  },

  saveState() {
    if (!this.stateReady) return
    try {
      storage.set({
        key: STORAGE_KEY,
        value: JSON.stringify({ quizSchema: 181, quizDay: quizState.quizDay, quizIndex: quizState.quizIndex, quizViewed: quizState.quizViewed }),
        fail(data, code) { console.log('知识进度保存失败: ' + code) }
      })
    } catch (error) { console.log('知识进度保存不可用: ' + error) }
  },

  saveFavorites() {
    try {
      storage.set({
        key: FAVORITES_KEY,
        value: JSON.stringify({ items: favoritesItems }),
        fail(data, code) { console.log('收藏室存档保存失败: ' + code) }
      })
    } catch (error) { console.log('存储模块不可用: ' + error) }
  },

  // 爱心收藏当前题目（快照式：题干/答案/解析，收藏室无需再导题库）
  toggleFavorite() {
    if (!this.stateReady) return
    const riddle = dailyRiddleList[quizState.quizIndex]
    if (!riddle) return
    toggleFavorite(favoritesItems, makeKnowledgeFavorite(riddle))
    this.saveFavorites()
    this.refreshHeart()
    this.pulse('short')
  },

  refreshHeart() {
    const riddle = dailyRiddleList[quizState.quizIndex]
    this.heartFilled = riddle ? hasFavorite(favoritesItems, 'k' + riddle.question) : false
  },

  renderQuiz() {
    const list = dailyRiddleList
    const idx = Math.max(0, Math.min(quizState.quizIndex, list.length - 1))
    quizState.quizIndex = idx
    const riddle = list[idx]
    this.quizPos = idx + 1
    this.quizTotal = list.length
    this.quizCategory = riddle.category
    this.riddleQuestion = riddle.question
    this.isQaItem = isQaMode(riddle)
    this.revealLabel = this.isQaItem ? '查看答案' : '展开正文'
    this.answerLabel = this.isQaItem ? '答案' : riddle.category
    this.answerVisible = !this.isQaItem
    this.detailIndex = 0
    if (this.answerVisible) {
      this.riddleExplain = riddle.explain
      this.renderDetail()
    } else {
      this.riddleExplain = ''
      this.detailTotal = 1
      this.detailLabel = ''
    }
    this.prevDisabled = idx <= 0
    this.nextDisabled = idx >= list.length - 1
    this.prevLabel = idx <= 0 ? '已是第一题' : '上一题'
    this.nextLabel = idx >= list.length - 1 ? '已是最后一题' : '下一题'
    this.refreshHeart()
  },

  revealAnswer() {
    if (this.answerVisible) return
    const idx = quizState.quizIndex
    const riddle = dailyRiddleList[idx]
    this.riddleAnswer = knowledgeAnswer(riddle)
    this.riddleExplain = riddle.explain
    this.answerVisible = true
    this.detailIndex = 0
    this.renderDetail()
    if (quizState.quizViewed.indexOf(idx) < 0) quizState.quizViewed.push(idx)
    this.pulse('short')
    this.saveState()
  },

  renderDetail() {
    const r = dailyRiddleList[quizState.quizIndex]
    const text = knowledgeDetail(r)
    const step = isQaMode(r) ? 32 : 84
    const chunks = []
    const chars = Array.from(text)
    for (let i = 0; i < chars.length; i += step) chunks.push(chars.slice(i, i + step).join(''))
    this.detailTotal = chunks.length || 1
    this.riddleExplain = chunks[this.detailIndex] || ''
    // 1.8.17：「继续」按钮移除，正文点击翻页；仅保留纯页码指示
    this.detailLabel = (this.detailIndex + 1) + ' / ' + this.detailTotal
  },

  nextDetail() {
    this.detailIndex = (this.detailIndex + 1) % this.detailTotal
    this.renderDetail()
  },

  prevQuestion() {
    if (quizState.quizIndex <= 0) return
    quizState.quizIndex -= 1
    this.renderQuiz()
    this.saveState()
    this.pulse('short')
  },

  nextQuestion() {
    if (quizState.quizIndex >= dailyRiddleList.length - 1) return
    quizState.quizIndex += 1
    this.renderQuiz()
    this.saveState()
    this.pulse('short')
  },

  goHome() {
    this.saveState()
    router.replace({ uri: 'pages/index' })
  },

  // 1.8.17：右滑返回上一级（知识页上一级为主页）
  handleSwipe(event) {
    if (event && event.direction === 'right') this.goHome()
  },

  pulse(mode) {
    try { vibrator.vibrate({ mode: mode }) } catch (error) {}
  }
}
</script>

<style>
/* 1.8.18 设计令牌：bg #f2eee5 / card #fffdf8 / 主文字 #2b2723 / 次要 #7b7268 / 提示 #9a9186 / 品牌红 #a83b2d / 分割线 #ece3d6 */
.quiz-mask { position: absolute; left: 0; top: 0; width: 336px; height: 480px; background-color: #f2eee5; }
/* 回退箭头透明命中层加宽至 64px（规避左缘触摸死区，视觉不变） */
.kn-back-hit { position: absolute; left: 10px; top: 10px; width: 64px; height: 40px; }
.kn-back { width: 40px; height: 40px; line-height: 40px; color: #2b2723; font-size: 26px; text-align: center; }
.kn-heart-img { position: absolute; left: 286px; top: 12px; width: 36px; height: 36px; }
.header-line { position: absolute; left: 16px; top: 56px; width: 304px; height: 1px; background-color: #ece3d6; }

/* 固定尺寸父容器（312×456，验收断言约束），透明底仅作布局锚点 */
.quiz-panel { position: absolute; left: 12px; top: 12px; width: 312px; height: 456px; }

/* 答题模式（脑筋急转弯/十万个为什么） */
.qa-mode { position: absolute; left: 0; top: 0; width: 312px; height: 456px; }
.quiz-kicker { position: absolute; left: 8px; top: 52px; width: 200px; height: 18px; line-height: 18px; color: #a83b2d; font-size: 13px; font-weight: bold; letter-spacing: 2px; }
.quiz-question-box { position: absolute; left: 0; top: 78px; width: 312px; height: 128px; border-width: 1px; border-color: #ece3d6; border-radius: 8px; background-color: #fffdf8; }
.quiz-question { position: absolute; left: 14px; top: 14px; width: 284px; height: 100px; color: #2b2723; font-size: 20px; font-weight: bold; line-height: 27px; text-align: center; }
.quiz-ill { position: absolute; left: 96px; top: 216px; width: 120px; height: 110px; }
.quiz-reveal-btn { position: absolute; left: 36px; top: 340px; width: 240px; height: 44px; border-radius: 6px; background-color: #a83b2d; color: #fffaf2; font-size: 17px; font-weight: bold; }
.quiz-answer-box { position: absolute; left: 0; top: 216px; width: 312px; height: 180px; border-width: 1px; border-color: #ece3d6; border-radius: 8px; background-color: #fffdf8; }
.quiz-answer-label { position: absolute; left: 14px; top: 10px; width: 100px; height: 18px; line-height: 18px; color: #a83b2d; font-size: 14px; font-weight: bold; letter-spacing: 1px; }
.quiz-explain { position: absolute; left: 14px; top: 34px; width: 284px; height: 108px; color: #2b2723; font-size: 17px; font-weight: bold; line-height: 24px; }
.detail-page { position: absolute; left: 198px; top: 150px; width: 100px; height: 16px; line-height: 16px; color: #9a9186; font-size: 12px; text-align: right; }

/* 阅读模式（百科全书/冷笑话/鬼故事） */
.read-mode { position: absolute; left: 0; top: 0; width: 312px; height: 456px; }
.read-kicker { position: absolute; left: 8px; top: 52px; width: 200px; height: 18px; line-height: 18px; color: #a83b2d; font-size: 13px; font-weight: bold; letter-spacing: 2px; }
.read-title { position: absolute; left: 8px; top: 78px; width: 296px; height: 52px; color: #2b2723; font-size: 19px; font-weight: bold; line-height: 26px; text-align: center; }
.read-text { position: absolute; left: 8px; top: 138px; width: 296px; height: 226px; color: #2b2723; font-size: 18px; line-height: 27px; text-align: left; }
.read-page { position: absolute; left: 204px; top: 372px; width: 100px; height: 16px; line-height: 16px; color: #9a9186; font-size: 12px; text-align: right; }

/* 底部固定操作栏：上一题 / 页码 / 下一题 */
.quiz-actionbar { position: absolute; left: 16px; top: 400px; width: 280px; height: 44px; }
.quiz-nav-btn { position: absolute; top: 0; width: 86px; height: 44px; border-width: 1px; border-color: #ece3d6; border-radius: 6px; background-color: #fffdf8; color: #574e45; font-size: 14px; font-weight: bold; }
.quiz-prev { left: 0; }
.quiz-next { left: 194px; }
.quiz-mid { position: absolute; left: 86px; top: 0; width: 108px; height: 44px; line-height: 44px; color: #9a9186; font-size: 13px; text-align: center; }
</style>
