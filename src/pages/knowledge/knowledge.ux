<template>
  <div class="quiz-mask">
    <div class="quiz-panel">
      <div class="qa-mode" show="{{isQaItem}}">
        <text class="quiz-kicker">{{quizCategory}}</text>
        <text class="quiz-count">{{quizPos}} / {{quizTotal}}</text>
        <input class="kn-heart" show="{{!heartFilled}}" type="button" value="♡" onclick="toggleFavorite" />
        <input class="kn-heart kn-heart-on" show="{{heartFilled}}" type="button" value="♥" onclick="toggleFavorite" />
        <input class="kn-home" type="button" value="返回主页" onclick="goHome" />

        <div class="quiz-question-box">
          <text class="quiz-question">{{riddleQuestion}}</text>
        </div>

        <input class="quiz-reveal-btn" show="{{!answerVisible}}" type="button" value="{{revealLabel}}" onclick="revealAnswer" />

        <div class="quiz-answer-box" show="{{answerVisible}}">
          <text class="quiz-answer-label">答案</text>
          <text class="quiz-explain">{{riddleExplain}}</text>
          <input class="detail-next" show="{{detailTotal > 1}}" type="button" value="{{detailLabel}}" onclick="nextDetail" />
        </div>
      </div>

      <div class="read-mode" show="{{!isQaItem}}">
        <text class="read-kicker">{{quizCategory}}</text>
        <text class="read-count">{{quizPos}} / {{quizTotal}}</text>
        <input class="kn-heart" show="{{!heartFilled}}" type="button" value="♡" onclick="toggleFavorite" />
        <input class="kn-heart kn-heart-on" show="{{heartFilled}}" type="button" value="♥" onclick="toggleFavorite" />
        <input class="kn-home kn-home-read" type="button" value="返回主页" onclick="goHome" />
        <text class="read-title">{{riddleQuestion}}</text>
        <text class="read-text">{{riddleExplain}}</text>
        <input class="read-next" show="{{detailTotal > 1}}" type="button" value="{{detailLabel}}" onclick="nextDetail" />
      </div>

      <div class="quiz-actionbar">
        <input class="quiz-nav-btn quiz-prev" type="button" value="{{prevLabel}}" onclick="prevQuestion" disabled="{{prevDisabled}}" />
        <input class="quiz-nav-btn quiz-cancel" type="button" value="返回主页" onclick="goHome" />
        <input class="quiz-nav-btn quiz-next" type="button" value="{{nextLabel}}" onclick="nextQuestion" disabled="{{nextDisabled}}" />
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'
import { RIDDLES } from '../../common/data/knowledge.js'
import { dayInfo } from '../../common/utils/date.js'
import { isQaMode, knowledgeDetail, knowledgeAnswer, dailyRiddles, shouldResetQuizProgress } from '../../common/utils/knowledge.js'
import { FAVORITES_KEY, makeKnowledgeFavorite, toggleFavorite, hasFavorite } from '../../common/utils/favorites.js'

const STORAGE_KEY = 'daily_quote_knowledge_v1'
const today = dayInfo(new Date())
const dailyRiddleList = dailyRiddles(RIDDLES, today.dayNumber)
let quizState = { quizDay: -1, quizIndex: 0, quizViewed: [] }
let favoritesItems = []

export default {
  // AIoT/Vela 页面数据必须放在 private 中，顶层属性不会被当作模板数据源
  private: {
    stateReady: false,
    heartFilled: false,
    quizCategory: '',
    quizPos: 0,
    quizTotal: 0,
    riddleQuestion: '',
    riddleExplain: '',
    riddleAnswer: '',
    isQaItem: false,
    revealLabel: '查看答案',
    answerLabel: '答案',
    answerVisible: false,
    detailIndex: 0,
    detailTotal: 1,
    detailLabel: '',
    prevDisabled: true,
    nextDisabled: true,
    prevLabel: '已是第一题',
    nextLabel: '下一题',
  },


  onInit() {
    this.setAwake(true)
    const page = this
    const finishLoad = function () {
      page.stateReady = true
      page.renderQuiz()
    }
    // 收藏室存档（爱心状态用）
    try {
      storage.get({
        key: FAVORITES_KEY,
        default: '',
        success(favData) {
          if (favData) try {
            const savedFav = JSON.parse(favData)
            if (savedFav && Array.isArray(savedFav.items)) favoritesItems = savedFav.items
          } catch (error) {
            console.log('收藏室存档解析失败: ' + error)
          }
          page.loadQuizState(finishLoad)
        },
        fail() { page.loadQuizState(finishLoad) }
      })
    } catch (error) { this.loadQuizState(finishLoad) }
  },

  loadQuizState(finishLoad) {
    const page = this
    try {
      storage.get({
        key: STORAGE_KEY,
        default: '',
        success(data) {
          if (data) try {
            const saved = JSON.parse(data)
            quizState.quizDay = Number(saved.quizDay)
            if (!Number.isFinite(quizState.quizDay)) quizState.quizDay = -1
            quizState.quizIndex = Number(saved.quizIndex) || 0
            quizState.quizViewed = Array.isArray(saved.quizViewed) ? saved.quizViewed : []
            // 1.8.15：quizSchema 181 = 脑筋急转弯每日 10 题含 ≥6 条 v2 优化条目（qualityScore 优先选题）
            if (saved.quizSchema !== 181 || shouldResetQuizProgress(quizState.quizDay, today.dayNumber)) {
              quizState.quizDay = today.dayNumber
              quizState.quizIndex = 0
              quizState.quizViewed = []
            }
          } catch (error) {
            console.log('知识页存档解析失败: ' + error)
          }
          finishLoad()
        },
        fail() { finishLoad() }
      })
    } catch (error) { finishLoad() }
  },

  onShow() { this.setAwake(true) },
  onHide() { this.setAwake(false) },
  onDestroy() { this.setAwake(false) },

  setAwake(enabled) {
    try {
      brightness.setKeepScreenOn({
        keepScreenOn: enabled,
        success() {},
        fail(data, code) { console.log('keepScreenOn failed: ' + code) }
      })
    } catch (error) {}
  },

  saveState() {
    if (!this.stateReady) return
    try {
      storage.set({
        key: STORAGE_KEY,
        value: JSON.stringify({ quizSchema: 181, quizDay: quizState.quizDay, quizIndex: quizState.quizIndex, quizViewed: quizState.quizViewed }),
        fail(data, code) { console.log('知识进度保存失败: ' + code) }
      })
    } catch (error) { console.log('知识进度保存不可用: ' + error) }
  },

  saveFavorites() {
    try {
      storage.set({
        key: FAVORITES_KEY,
        value: JSON.stringify({ items: favoritesItems }),
        fail(data, code) { console.log('收藏室存档保存失败: ' + code) }
      })
    } catch (error) { console.log('存储模块不可用: ' + error) }
  },

  // 爱心收藏当前题目（快照式：题干/答案/解析，收藏室无需再导题库）
  toggleFavorite() {
    if (!this.stateReady) return
    const riddle = dailyRiddleList[quizState.quizIndex]
    if (!riddle) return
    toggleFavorite(favoritesItems, makeKnowledgeFavorite(riddle))
    this.saveFavorites()
    this.refreshHeart()
    this.pulse('short')
  },

  refreshHeart() {
    const riddle = dailyRiddleList[quizState.quizIndex]
    this.heartFilled = riddle ? hasFavorite(favoritesItems, 'k' + riddle.question) : false
  },

  renderQuiz() {
    const list = dailyRiddleList
    const idx = Math.max(0, Math.min(quizState.quizIndex, list.length - 1))
    quizState.quizIndex = idx
    const riddle = list[idx]
    this.quizPos = idx + 1
    this.quizTotal = list.length
    this.quizCategory = riddle.category
    this.riddleQuestion = riddle.question
    this.isQaItem = isQaMode(riddle)
    this.revealLabel = this.isQaItem ? '查看答案' : '展开正文'
    this.answerLabel = this.isQaItem ? '答案' : riddle.category
    this.answerVisible = !this.isQaItem
    this.detailIndex = 0
    if (this.answerVisible) {
      this.riddleExplain = riddle.explain
      this.renderDetail()
    } else {
      this.riddleExplain = ''
      this.detailTotal = 1
      this.detailLabel = ''
    }
    this.prevDisabled = idx <= 0
    this.nextDisabled = idx >= list.length - 1
    this.prevLabel = idx <= 0 ? '已是第一题' : '上一题'
    this.nextLabel = idx >= list.length - 1 ? '已是最后一题' : '下一题'
    this.refreshHeart()
  },

  revealAnswer() {
    if (this.answerVisible) return
    const idx = quizState.quizIndex
    const riddle = dailyRiddleList[idx]
    this.riddleAnswer = knowledgeAnswer(riddle)
    this.riddleExplain = riddle.explain
    this.answerVisible = true
    this.detailIndex = 0
    this.renderDetail()
    if (quizState.quizViewed.indexOf(idx) < 0) quizState.quizViewed.push(idx)
    this.pulse('short')
    this.saveState()
  },

  renderDetail() {
    const r = dailyRiddleList[quizState.quizIndex]
    const text = knowledgeDetail(r)
    const step = isQaMode(r) ? 32 : 84
    const chunks = []
    const chars = Array.from(text)
    for (let i = 0; i < chars.length; i += step) chunks.push(chars.slice(i, i + step).join(''))
    this.detailTotal = chunks.length || 1
    this.riddleExplain = chunks[this.detailIndex] || ''
    this.detailLabel = '继续 ' + (this.detailIndex + 1) + '/' + this.detailTotal
  },

  nextDetail() {
    this.detailIndex = (this.detailIndex + 1) % this.detailTotal
    this.renderDetail()
  },

  prevQuestion() {
    if (quizState.quizIndex <= 0) return
    quizState.quizIndex -= 1
    this.renderQuiz()
    this.saveState()
    this.pulse('short')
  },

  nextQuestion() {
    if (quizState.quizIndex >= dailyRiddleList.length - 1) return
    quizState.quizIndex += 1
    this.renderQuiz()
    this.saveState()
    this.pulse('short')
  },

  goHome() {
    this.saveState()
    router.replace({ uri: 'pages/index' })
  },

  pulse(mode) {
    try { vibrator.vibrate({ mode: mode }) } catch (error) {}
  }
}
</script>

<style>
.kn-heart { position: absolute; left: 186px; top: 7px; width: 38px; height: 30px; border-width: 1px; border-color: #d4c9ba; border-radius: 4px; background-color: #f8f3e9; color: #9a8e81; font-size: 17px; }
.kn-heart-on { border-color: #a83b2d; background-color: #fdf0ec; color: #a83b2d; font-weight: bold; }
.kn-home { position: absolute; left: 232px; top: 7px; width: 70px; height: 30px; border-width: 1px; border-color: #cfc4b5; border-radius: 4px; background-color: #f8f3e9; color: #766c61; font-size: 14px; }
.kn-home-read { left: 232px; top: 7px; }
.quiz-mask { position: absolute; left: 0; top: 0; width: 336px; height: 480px; background-color: #f2eee5; }
.quiz-panel { position: absolute; left: 12px; top: 12px; width: 312px; height: 456px; border-width: 1px; border-color: #d2c7b8; border-radius: 6px; background-color: #fffdf8; }
.qa-mode { position: absolute; left: 0; top: 0; width: 312px; height: 456px; }
.quiz-kicker { position: absolute; left: 16px; top: 10px; width: 110px; height: 20px; line-height: 20px; color: #a83b2d; font-size: 14px; font-weight: bold; letter-spacing: 1px; }
.quiz-count { position: absolute; left: 130px; top: 13px; width: 52px; height: 16px; line-height: 16px; color: #94887c; font-size: 11px; text-align: right; }
.quiz-question-box { position: absolute; left: 16px; top: 48px; width: 280px; height: 130px; border-width: 1px; border-color: #ece3d6; border-radius: 6px; background-color: #fbf7f0; }
.quiz-question { position: absolute; left: 10px; top: 8px; width: 260px; height: 114px; color: #2c2722; font-size: 23px; font-weight: bold; line-height: 29px; text-align: center; }
.quiz-reveal-btn { position: absolute; left: 36px; top: 198px; width: 240px; height: 44px; border-radius: 4px; background-color: #a83b2d; color: #fffaf2; font-size: 18px; font-weight: bold; }
.quiz-answer-box { position: absolute; left: 16px; top: 190px; width: 280px; height: 204px; border-width: 1px; border-color: #ece3d6; border-radius: 6px; background-color: #fffdf8; }
.quiz-answer-label { position: absolute; left: 10px; top: 8px; width: 60px; color: #a83b2d; font-size: 15px; font-weight: bold; }
.quiz-explain { position: absolute; left: 10px; top: 34px; width: 260px; height: 130px; color: #29241f; font-size: 18px; font-weight: bold; line-height: 24px; }
.detail-next { position: absolute; left: 50px; top: 168px; width: 180px; height: 30px; background-color: #f8f3e9; color: #574e45; font-size: 14px; }
.read-mode { position: absolute; left: 0; top: 0; width: 312px; height: 456px; }
.read-kicker { position: absolute; left: 16px; top: 10px; width: 110px; height: 20px; line-height: 20px; color: #a83b2d; font-size: 14px; font-weight: bold; letter-spacing: 1px; }
.read-count { position: absolute; left: 130px; top: 13px; width: 52px; height: 16px; line-height: 16px; color: #94887c; font-size: 11px; text-align: right; }
.read-title { position: absolute; left: 18px; top: 46px; width: 276px; height: 58px; color: #2c2722; font-size: 19px; font-weight: bold; line-height: 24px; text-align: center; }
.read-text { position: absolute; left: 18px; top: 112px; width: 276px; height: 248px; color: #29241f; font-size: 20px; font-weight: bold; line-height: 28px; text-align: left; }
.read-next { position: absolute; left: 56px; top: 372px; width: 200px; height: 30px; background-color: #f8f3e9; color: #574e45; font-size: 14px; }
.quiz-actionbar { position: absolute; left: 16px; top: 400px; width: 280px; height: 48px; }
.quiz-nav-btn { position: absolute; top: 0; width: 86px; height: 44px; border-width: 1px; border-color: #d4c9ba; border-radius: 4px; background-color: #f8f3e9; color: #574e45; font-size: 14px; font-weight: bold; }
.quiz-prev { left: 0; }
.quiz-cancel { left: 97px; background-color: #fffdf8; color: #918579; font-size: 13px; }
.quiz-next { left: 194px; }
</style>
