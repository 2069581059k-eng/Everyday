<template>
  <div class="zr-page" onswipe="handleSwipe">
    <div class="zr-back-hit" onclick="goHome"><text class="zr-back">‹</text></div>
    <text class="zr-title">你的气质画像</text>
    <div class="header-line"></div>

    <div class="zr-top3">
      <div class="zr-zodiac zr-primary">
        <image class="zr-z-img" src="{{primaryImg}}" />
        <text class="zr-z-name">{{primaryName}}</text>
        <text class="zr-z-match">匹配 {{primaryMatch}}%</text>
      </div>
      <text class="zr-vs">次</text>
      <div class="zr-zodiac">
        <image class="zr-z-img" src="{{secondaryImg}}" />
        <text class="zr-z-name">{{secondaryName}}</text>
        <text class="zr-z-match">{{secondaryMatch}}%</text>
      </div>
      <text class="zr-vs">三</text>
      <div class="zr-zodiac">
        <image class="zr-z-img" src="{{thirdImg}}" />
        <text class="zr-z-name">{{thirdName}}</text>
        <text class="zr-z-match">{{thirdMatch}}%</text>
      </div>
    </div>

    <!-- 固定 3 个内容槽位，翻页时由脚本整体替换文案（不用 show/for，避免渲染风险） -->
    <text class="zr-sec zr-secA">{{slotTitleA}}</text>    <text class="zr-body zr-bodyA">{{slotBodyA}}</text>
    <text class="zr-sec zr-secB">{{slotTitleB}}</text>
    <text class="zr-body zr-bodyB">{{slotBodyB}}</text>
    <text class="zr-sec zr-secC">{{slotTitleC}}</text>
    <text class="zr-body zr-bodyC">{{slotBodyC}}</text>

    <text class="zr-page-ind">{{pageText}}</text>

    <div class="zr-actions">
      <input class="zr-btn zr-home" type="button" value="返回主页" onclick="goHome" />
      <input class="zr-btn zr-page-btn" type="button" value="{{pageLabel}}" onclick="nextPage" />
      <input class="zr-btn zr-retest" type="button" value="再测一次" onclick="retest" />
    </div>
  </div>
</template>

<style>
/* 1.8.18 设计令牌：bg #f2eee5 / card #fffdf8 / 主文字 #2b2723 / 次要 #7b7268 / 提示 #9a9186 / 品牌红 #a83b2d / 分割线 #ece3d6 */
/* 全部绝对定位：Vela 中 div 默认横向 flex，用 margin 堆叠会挤成一行 */
.zr-page { position: relative; width: 336px; height: 480px; background-color: #f2eee5; }
/* 回退箭头透明命中层加宽至 64px（规避左缘触摸死区，视觉不变） */
.zr-back-hit { position: absolute; left: 10px; top: 10px; width: 64px; height: 40px; }
.zr-back { width: 40px; height: 40px; line-height: 40px; color: #2b2723; font-size: 26px; text-align: center; }
.zr-title { position: absolute; left: 56px; top: 17px; width: 220px; height: 22px; line-height: 22px; color: #2b2723; font-size: 18px; font-weight: bold; }
.header-line { position: absolute; left: 16px; top: 56px; width: 304px; height: 1px; background-color: #ece3d6; }
.zr-top3 { position: absolute; left: 16px; top: 62px; width: 304px; height: 88px; flex-direction: row; }
.zr-zodiac { flex-direction: column; justify-content: center; align-items: center; width: 96px; height: 86px; border-width: 1px; border-color: #ece3d6; border-radius: 8px; background-color: #fffdf8; }
.zr-primary { border-color: #a83b2d; background-color: #fdf0ec; }
.zr-z-img { width: 44px; height: 44px; }
.zr-z-name { width: 96px; height: 18px; line-height: 18px; color: #2b2723; font-size: 14px; font-weight: bold; text-align: center; }
.zr-z-match { width: 96px; height: 14px; line-height: 14px; color: #a83b2d; font-size: 11px; text-align: center; }
.zr-vs { width: 8px; height: 86px; line-height: 86px; color: #9a9186; font-size: 11px; text-align: center; }
.zr-sec { position: absolute; left: 26px; width: 284px; height: 16px; line-height: 16px; color: #a83b2d; font-size: 13px; font-weight: bold; letter-spacing: 1px; }
.zr-body { position: absolute; left: 26px; width: 284px; height: 66px; color: #2b2723; font-size: 13px; line-height: 22px; }
.zr-secA { top: 152px; }
.zr-bodyA { top: 170px; }
.zr-secB { top: 240px; }
.zr-bodyB { top: 258px; }
.zr-secC { top: 328px; }
.zr-bodyC { top: 346px; }
.zr-page-ind { position: absolute; left: 26px; top: 414px; width: 284px; height: 14px; line-height: 14px; color: #9a9186; font-size: 11px; text-align: right; }
.zr-actions { position: absolute; left: 16px; top: 434px; width: 304px; height: 32px; flex-direction: row; }
.zr-btn { width: 96px; height: 32px; border-radius: 6px; font-size: 13px; font-weight: bold; }
.zr-home { background-color: #a83b2d; color: #fffaf2; }
.zr-page-btn { margin-left: 8px; border-width: 1px; border-color: #ece3d6; background-color: #fffdf8; color: #574e45; }
.zr-retest { margin-left: 8px; border-width: 1px; border-color: #ece3d6; background-color: #fffdf8; color: #574e45; }
</style>

<script>
import router from '@system.router'
import storage from '@system.storage'
// 1.8.19：星座插画映射收敛至共享模块（与首页星象遮罩共用）
import { zodiacImg } from '../../common/utils/zodiac.js'

const STORAGE_KEY = 'zodiac_profile_result_v1'
const PER_PAGE = 3

function dimName(key) {
  const map = {
    action: '行动力', social: '社交性', rational: '理性', emotional: '感性', stability: '稳定性',
    curiosity: '好奇心', independence: '独立性', empathy: '共情力', competitiveness: '竞争性', adaptability: '适应性'
  }
  return map[key] || key
}

// 手表屏幕有限，长文裁剪并加省略号
function clip(text, max) {
  const s = String(text || '')
  return s.length > max ? s.slice(0, max - 1) + '…' : s
}

export default {
  // AIoT/Vela 页面数据必须放在 private 中，顶层属性不会被当作模板数据源
  private: {
    primaryName: '',
    primaryMatch: '',
    primaryImg: '',
    secondaryName: '',
    secondaryMatch: '',
    secondaryImg: '',
    thirdName: '',
    thirdMatch: '',
    thirdImg: '',
    slotTitleA: '',
    slotBodyA: '',
    slotTitleB: '',
    slotBodyB: '',
    slotTitleC: '',
    slotBodyC: '',
    pageText: '1 / 1',
    pageLabel: '下一页 ›',
    pageIndex: 0,
    blocks: []
  },

  nextPage() {
    if (!this.blocks.length) return
    const total = Math.ceil(this.blocks.length / PER_PAGE)
    this.pageIndex = (this.pageIndex + 1) % total
    this.fillPage()
  },

  fillPage() {
    const total = Math.max(1, Math.ceil(this.blocks.length / PER_PAGE))
    const base = this.pageIndex * PER_PAGE
    const pick = (i) => this.blocks[base + i] || { t: '', b: '' }
    const a = pick(0), b = pick(1), c = pick(2)
    this.slotTitleA = a.t; this.slotBodyA = a.b
    this.slotTitleB = b.t; this.slotBodyB = b.b
    this.slotTitleC = c.t; this.slotBodyC = c.b
    this.pageText = (this.pageIndex + 1) + ' / ' + total
    this.pageLabel = this.pageIndex >= total - 1 ? '回到第1页' : '下一页 ›'
  },

  onInit() {
    const page = this
    try {
      storage.get({
        key: STORAGE_KEY,
        default: '',
        success(data) { page.renderResult(data) },
        fail() { page.noResult() }
      })
    } catch (error) {
      page.noResult()
    }
  },

  renderResult(data) {
    if (!data) return this.noResult()
    let parsed = null
    try { parsed = JSON.parse(data) } catch (error) { parsed = null }
    if (!parsed || !parsed.analysis) return this.noResult()

    const a = parsed.analysis
    this.primaryName = a.primary.name
    this.primaryMatch = a.primary.match
    this.primaryImg = zodiacImg(a.primary.name)
    this.secondaryName = a.secondary.name
    this.secondaryMatch = a.secondary.match
    this.secondaryImg = zodiacImg(a.secondary.name)
    this.thirdName = a.third.name
    this.thirdMatch = a.third.match
    this.thirdImg = zodiacImg(a.third.name)

    const dims = a.topDimensions || []
    const dimLine = dims.slice(0, 3).map(function (d) { return dimName(d.key) + ' ' + d.value }).join(' / ')
    const dts = a.dimensionTexts || []
    const scenes = a.scenes || []
    const adv = a.advice || []

    const blocks = [
      { t: '核心分析 · ' + a.style, b: clip(a.main ? a.main.text : '', 90) },
      { t: '组合色彩', b: clip(a.pair ? a.pair.text : '', 90) },
      { t: '三个突出维度', b: dimLine },
      { t: '维度解读 1', b: clip(dts[0] ? dts[0].text : '', 90) },
      { t: '维度解读 2', b: clip(dts[1] ? dts[1].text : '', 90) },
      { t: '维度解读 3', b: clip(dts[2] ? dts[2].text : '', 90) },
      { t: '一句话总结', b: clip(a.summary ? a.summary.text : '', 90) },
      { t: '场景中的你 1', b: clip(scenes[0] ? scenes[0].text : '', 90) },
      { t: '场景中的你 2', b: clip(scenes[1] ? scenes[1].text : '', 90) },
      { t: '场景中的你 3', b: clip(scenes[2] ? scenes[2].text : '', 90) },
      { t: '矛盾与平衡', b: clip(a.contrast ? a.contrast.text : '', 90) },
      { t: '给你的建议 1', b: clip(adv[0] ? adv[0].text : '', 90) },
      { t: '给你的建议 2', b: clip(adv[1] ? adv[1].text : '', 90) },
      { t: '给你的建议 3', b: clip(adv[2] ? adv[2].text : '', 90) },
      { t: '关于本测试', b: '结果仅用于娱乐与自我探索，不属于心理诊断、人格测评或科学占星结论。' }
    ]
    // 去掉没有内容的块（如无矛盾项）
    this.blocks = blocks.filter(function (x) { return x.b })
    this.pageIndex = 0
    this.fillPage()
  },

  noResult() {
    this.primaryName = '—'
    this.primaryMatch = '--'
    this.primaryImg = ''
    this.secondaryName = '—'
    this.secondaryMatch = '--'
    this.secondaryImg = ''
    this.thirdName = '—'
    this.thirdMatch = '--'
    this.thirdImg = ''
    this.blocks = [{ t: '提示', b: '还没有测试记录，先去做一次星象分析吧。' }]
    this.pageIndex = 0
    this.fillPage()
  },

  goHome() {
    router.replace({ uri: 'pages/index' })
  },

  retest() {
    router.replace({ uri: 'pages/zodiac-test' })
  },

  // 1.8.17：右滑返回上一级（结果页上一级为主页，与「返回主页」一致；测试已完成不回答题页）
  handleSwipe(event) {
    if (event && event.direction === 'right') this.goHome()
  }
}
</script>
