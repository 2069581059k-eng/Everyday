<template>
  <div class="zr-page">
    <text class="zr-title">你的气质画像</text>

    <div class="zr-top3">
      <div class="zr-zodiac zr-primary">
        <text class="zr-z-name">{{primaryName}}</text>
        <text class="zr-z-match">匹配 {{primaryMatch}}%</text>
      </div>
      <text class="zr-vs">次</text>
      <div class="zr-zodiac">
        <text class="zr-z-name">{{secondaryName}}</text>
        <text class="zr-z-match">{{secondaryMatch}}%</text>
      </div>
      <text class="zr-vs">三</text>
      <div class="zr-zodiac">
        <text class="zr-z-name">{{thirdName}}</text>
        <text class="zr-z-match">{{thirdMatch}}%</text>
      </div>
    </div>

    <div class="zr-scroll">
      <text for="{{currentUnits}}" class="{{$item.cls}}">{{$item.text}}</text>
    </div>
    <input class="zr-next" show="{{totalPages > 1}}" type="button" value="{{pageLabel}}" onclick="nextPage" />

    <div class="zr-actions">
      <input class="zr-btn zr-home" type="button" value="返回主页" onclick="goHome" />
      <input class="zr-btn zr-retest" type="button" value="再测一次" onclick="retest" />
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'

const STORAGE_KEY = 'zodiac_profile_result_v1'

function dimName(key) {
  const map = {
    action: '行动力', social: '社交性', rational: '理性', emotional: '感性', stability: '稳定性',
    curiosity: '好奇心', independence: '独立性', empathy: '共情力', competitiveness: '竞争性', adaptability: '适应性'
  }
  return map[key] || key
}

// 米环 480 屏一次显示不完完整报告，按估算行高把内容单元切为多页循环浏览
function paginate(units, pageHeight) {
  const pages = []
  let current = []
  let used = 0
  for (let i = 0; i < units.length; i++) {
    const u = units[i]
    let height = 26
    if (u.cls === 'zr-dim') height = 21
    else if (u.cls === 'zr-text') height = Math.ceil(Array.from(u.text).length / 18) * 21 + 4
    else if (u.cls === 'zr-disclaimer') height = Math.ceil(Array.from(u.text).length / 23) * 17 + 8
    if (used + height > pageHeight && current.length > 0) {
      pages.push(current)
      current = []
      used = 0
    }
    current.push(u)
    used += height
  }
  if (current.length > 0) pages.push(current)
  return pages
}

export default {
  private: {
    primaryName: '',
    primaryMatch: '',
    secondaryName: '',
    secondaryMatch: '',
    thirdName: '',
    thirdMatch: '',
    styleText: '',
    mainText: '',
    pairText: '',
    dimRows: [],
    dimTexts: [],
    hasContrast: false,
    contrastText: '',
    sceneTexts: [],
    summaryText: '',
    adviceTexts: [],
    ready: false,
    currentPage: 0,
    paginated: [],
    totalPages: 0,
    currentUnits: [],
    pageLabel: ''
  },

  onInit() {
    const page = this
    try {
      storage.get({
        key: STORAGE_KEY,
        default: '',
        success(data) { page.renderResult(data) },
        fail() { page.noResult() }
      })
    } catch (error) {
      page.noResult()
    }
  },

  renderResult(data) {
    if (!data) return this.noResult()
    let parsed = null
    try { parsed = JSON.parse(data) } catch (error) { parsed = null }
    if (!parsed || !parsed.analysis) return this.noResult()

    const a = parsed.analysis
    this.primaryName = a.primary.name
    this.primaryMatch = a.primary.match
    this.secondaryName = a.secondary.name
    this.secondaryMatch = a.secondary.match
    this.thirdName = a.third.name
    this.thirdMatch = a.third.match
    this.styleText = a.style
    this.mainText = a.main ? a.main.text : ''
    this.pairText = a.pair ? a.pair.text : ''
    this.dimRows = (a.topDimensions || []).map(function (d) { return { name: dimName(d.key), value: d.value } })
    this.dimTexts = a.dimensionTexts || []
    this.hasContrast = !!(a.contrast && a.contrast.text)
    this.contrastText = this.hasContrast ? a.contrast.text : ''
    this.sceneTexts = a.scenes || []
    this.summaryText = a.summary ? a.summary.text : ''
    this.adviceTexts = a.advice || []
    // 把整份报告切成内容单元，再按 480 屏内容区高度分页循环浏览
    const units = []
    units.push({ cls: 'zr-section-title', text: '核心分析 · ' + this.styleText })
    if (this.mainText) units.push({ cls: 'zr-text', text: this.mainText })
    units.push({ cls: 'zr-section-title', text: '组合色彩' })
    if (this.pairText) units.push({ cls: 'zr-text', text: this.pairText })
    units.push({ cls: 'zr-section-title', text: '三个突出维度' })
    for (let i = 0; i < this.dimRows.length; i++) {
      units.push({ cls: 'zr-dim', text: this.dimRows[i].name + ' ' + this.dimRows[i].value + '%' })
    }
    for (let j = 0; j < this.dimTexts.length; j++) {
      units.push({ cls: 'zr-text', text: this.dimTexts[j].text })
    }
    if (this.hasContrast) {
      units.push({ cls: 'zr-section-title', text: '你的矛盾与平衡' })
      units.push({ cls: 'zr-text', text: this.contrastText })
    }
    units.push({ cls: 'zr-section-title', text: '场景中的你' })
    for (let k = 0; k < this.sceneTexts.length; k++) {
      units.push({ cls: 'zr-text', text: this.sceneTexts[k].text })
    }
    units.push({ cls: 'zr-section-title', text: '一句话总结' })
    if (this.summaryText) units.push({ cls: 'zr-text', text: this.summaryText })
    units.push({ cls: 'zr-section-title', text: '给你的建议' })
    for (let m = 0; m < this.adviceTexts.length; m++) {
      units.push({ cls: 'zr-text', text: this.adviceTexts[m].text })
    }
    units.push({ cls: 'zr-disclaimer', text: '本测试仅用于娱乐与自我探索，不属于心理诊断、人格测评或科学占星结论。' })
    this.paginated = paginate(units, 280)
    this.totalPages = this.paginated.length
    this.currentPage = 0
    this.currentUnits = this.paginated[0] || []
    this.pageLabel = '下一页 · 1/' + this.totalPages
    this.ready = true
  },

  nextPage() {
    if (this.totalPages < 1) return
    this.currentPage = (this.currentPage + 1) % this.totalPages
    this.currentUnits = this.paginated[this.currentPage] || []
    this.pageLabel = '下一页 · ' + (this.currentPage + 1) + '/' + this.totalPages
  },

  noResult() {
    this.currentUnits = [{ cls: 'zr-text', text: '还没有测试记录，先去做一次形象分析吧。' }]
    this.totalPages = 0
    this.ready = true
  },

  goHome() {
    router.replace({
      uri: '/pages/index',
      fail(error) { console.log('index route fail: ' + JSON.stringify(error)) }
    })
  },

  retest() {
    router.replace({
      uri: '/pages/zodiactest',
      fail(error) { console.log('zodiactest route fail: ' + JSON.stringify(error)) }
    })
  }
}
</script>

<style>
.zr-page { flex-direction: column; width: 336px; height: 480px; background-color: #f2eee5; }
.zr-title { margin-top: 10px; width: 336px; height: 24px; line-height: 24px; color: #2c2722; font-size: 19px; font-weight: bold; text-align: center; }
.zr-top3 { flex-direction: row; margin-top: 6px; margin-left: 16px; width: 304px; height: 64px; }
.zr-zodiac { flex-direction: column; justify-content: center; width: 96px; height: 62px; border-width: 1px; border-color: #d7cdbf; border-radius: 6px; background-color: #fffdf8; }
.zr-primary { border-color: #a83b2d; }
.zr-z-name { width: 96px; height: 22px; line-height: 22px; color: #2c2722; font-size: 16px; font-weight: bold; text-align: center; }
.zr-z-match { width: 96px; height: 16px; line-height: 16px; color: #a83b2d; font-size: 12px; text-align: center; }
.zr-vs { width: 8px; height: 62px; line-height: 62px; color: #94887c; font-size: 11px; text-align: center; }
.zr-scroll { flex-direction: column; margin-top: 6px; margin-left: 16px; width: 304px; height: 280px; border-width: 1px; border-color: #d7cdbf; border-radius: 6px; background-color: #fffdf8; }
.zr-section-title { flex-shrink: 0; margin-top: 8px; margin-left: 10px; width: 284px; height: 18px; line-height: 18px; color: #a83b2d; font-size: 14px; font-weight: bold; }
.zr-text { flex-shrink: 0; margin-top: 4px; margin-left: 10px; width: 284px; color: #29241f; font-size: 15px; line-height: 21px; }
.zr-dim { flex-shrink: 0; margin-top: 3px; margin-left: 10px; width: 284px; height: 18px; line-height: 18px; color: #574e45; font-size: 14px; font-weight: bold; }
.zr-disclaimer { flex-shrink: 0; margin-top: 8px; margin-left: 10px; width: 284px; color: #94887c; font-size: 12px; line-height: 17px; }
.zr-next { flex-shrink: 0; margin-top: 6px; margin-left: 103px; width: 130px; height: 30px; border-width: 1px; border-color: #cfc5b7; border-radius: 4px; background-color: #f8f3e9; color: #574e45; font-size: 14px; }
.zr-actions { flex-direction: row; margin-top: 6px; margin-left: 16px; width: 304px; height: 40px; }
.zr-btn { width: 146px; height: 38px; border-radius: 4px; font-size: 16px; font-weight: bold; }
.zr-home { background-color: #a83b2d; color: #fffaf2; }
.zr-retest { margin-left: 12px; border-width: 1px; border-color: #cfc4b5; background-color: #fffdf8; color: #574e45; }
</style>
